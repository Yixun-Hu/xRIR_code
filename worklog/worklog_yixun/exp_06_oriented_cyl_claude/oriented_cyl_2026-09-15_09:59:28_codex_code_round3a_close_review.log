def ast_module(name, filename, only=None, drop=()):
    tree = ast.parse((repo / filename).read_text(), filename=filename)
    if only is not None:
        tree.body = [n for n in tree.body if isinstance(n, (ast.FunctionDef,ast.ClassDef)) and n.name in only]
    else:
        tree.body = [n for n in tree.body if not (isinstance(n, ast.Import) and any(a.name in drop for a in n.names))]
    m = types.ModuleType(name); m.__file__ = str(repo / filename)
    m.__dict__.update(torch=torch, np=np)
    sys.modules[name] = m
    exec(compile(tree, str(repo / filename), 'exec'), m.__dict__)
    return m
