ADAPTER = '''EXP06_PIPELINE_LIB=1 source tools/exp06_haa_pipeline.sh
DRY=0; STAMP=faults; GPU=7; RECORD="$WORK/record"; OUT="$WORK/out"
mkdir -p -- "$RECORD" "$OUT"
