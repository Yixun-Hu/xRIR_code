RealPath = pathlib.Path
class VPath(pathlib.PurePosixPath):
    def read_bytes(self):
        if str(self).startswith('/MEM'):
            if str(self) not in FS: raise FileNotFoundError(str(self))
            return FS[str(self)]
        return RealPath(str(self)).read_bytes()
    def read_text(self, *a, **k): return self.read_bytes().decode()
    def write_bytes(self, data):
        assert str(self).startswith('/MEM'), 'forbidden write ' + str(self)
        FS[str(self)] = bytes(data); return len(data)
    def write_text(self, data, *a, **k): return self.write_bytes(data.encode())
    def mkdir(self, parents=False, exist_ok=False):
        assert str(self).startswith('/MEM')
        if self.exists() and not exist_ok: raise FileExistsError(str(self))
        if parents:
            DIRS.update(str(x) for x in self.parents if str(x).startswith('/MEM'))
        DIRS.add(str(self))
    def exists(self):
        return str(self) in FS or str(self) in DIRS if str(self).startswith('/MEM') else RealPath(str(self)).exists()
    def is_dir(self): return str(self) in DIRS
    def unlink(self): del FS[str(self)]
    def resolve(self): return self if self.is_absolute() else VPath(repo / str(self))
    def absolute(self): return self.resolve()
    def iterdir(self):
        return iter(sorted({VPath(x) for x in set(FS) | DIRS if VPath(x).parent == self and x "'!= str(self)}))
def sha(path):
    return hashlib.sha256(VPath(path).read_bytes()).hexdigest()
def copytree(src, dest):
    src, dest = str(src), str(dest)
    assert src.startswith('"'/MEM') and dest.startswith('/MEM')
    for name, data in list(FS.items()):
        if name.startswith(src + '/'): FS[dest + name[len(src):]] = data
    for name in list(DIRS):
        if name == src or name.startswith(src + '/'): DIRS.add(dest + name[len(src):])
    return dest
def write_manifest(path, record):
    path = VPath(path)
