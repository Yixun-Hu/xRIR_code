   145	        mkdir -p -- "$(dirname -- "$root")" \
   146	            && "$PYTHON" -c "$PREPARE_FAILURE_PY" "$target" "$reason" "$root" "" 0 \
   147	            || say "UNRECORDED preparation failure $root"
   148	        say "UNOWNED $root"
   149	    fi
   150	    return 1
   151	}
