   124	# prepare_failed <root> <reason>: round-3a finding 3. A refused preparation reports itself
   125	# where it is entitled to write. Only an attempt that created the root itself (OWNED_ROOT)
   126	# may put its receipt inside and rename it _ABORTED_; a root that pre-existed or was never
   127	# acquired may belong to another or a finished job, so its failure is recorded beside it
   128	# and nothing in it is touched. Always returns 1.
   129	prepare_failed() {
   130	    local root="$1" reason="$2" target
   131	    say "REFUSED $reason $root"
   132	    [ "$DRY" -eq 0 ] || return 1
   133	    if [ "$OWNED_ROOT" -eq 1 ]; then
   134	        target="${root}_ABORTED_prepare_${reason}"
   135	        [ ! -e "$target" ] || target="${target}_$$"
   136	        mkdir -p -- "$root" \
   137	            && "$PYTHON" -c "$PREPARE_FAILURE_PY" "$root/preparation_failure.json" \
   138	                 "$reason" "$root" "$target" 1 \
   139	            || say "UNRECORDED preparation failure $root"
   140	        if [ -e "$root" ] && mv -- "$root" "$target"; then say "ABORT $target"
   141	        else say "UNABORTED $root"; fi
   142	    else
   143	        target="${root}_PREPARE_FAILED_$(date -u +%Y%m%dT%H%M%S).json"
