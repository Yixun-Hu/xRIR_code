    result = run('7', 'cyl_or:0', '--dry-run')
    assert result.returncode == 0, result.stderr
    assert result.stdout.splitlines() == (header('7', ['cyl_or:0'])
                                          + finetune_job('cyl_or', 0) + ['QUEUE_DONE gpu=7'])


