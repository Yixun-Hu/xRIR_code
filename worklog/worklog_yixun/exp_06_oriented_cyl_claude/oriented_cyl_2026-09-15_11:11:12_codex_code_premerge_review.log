  1644	def launch_roots(attempt_root):
  1645	    """Every location this launcher writes pid files into, attempts and smokes alike."""
     1	#!/usr/bin/env bash
     2	# exp_06 HAA pipeline (plan v4 sections 6.2 and 6.4): one queue of jobs on one GPU.
     3	#   tools/exp06_haa_pipeline.sh <gpu> <job>... [--dry-run]
     4	#     job = <init>:<seed>  with init in {cyl_or, control_hf, cyl_hf},  or  zeroshot
     5	# Every child runs in its own exclusive directory under
     6	#   ckpt/exp06/sim2real/<init>/{seed<s>/{stage1,stage2_<room>,eval/<room>}, zeroshot/eval/<room>}
     7	# and is finalized by tools/exp06_finalize.py as soon as it has exited; the job itself is
     8	# finalized once every child of it is complete, from the --job-spec written before the
     9	# first child starts. The live launcher's pid lives ONLY at the job root
    10	# (seed<s>/launch.pid, zeroshot/launch.pid): the finalizer's verify_child refuses any live
    11	# pid inside a child directory, and its --owner-pid exception covers only the directory
    12	# being finalized. Each child gets child.pid, written by run_child.
    13	#
    14	# Round 2b finding 1: preparing a job is a gate, not an announcement. prepare_job opens the
    15	# job root, verifies all four rooms' headings (decided, confirmatory and still hashing the
    16	# selected HAA cache) while writing the declaration, and validates the written declaration
    17	# with the finalizer's own load_job_spec. Every status is checked explicitly, because these
    18	# functions are called through `||` from the queue, where bash suppresses errexit: no child
    19	# of a job starts unless its whole preparation succeeded, and the queue counts failures and
    20	# reports QUEUE_FAILED instead of QUEUE_DONE if any job failed.
    21	#
    22	# The child lifecycle -- exclusive directory, drained pipe, end marker, child_exit.json --
    23	# is tools/exp06_launch.sh's, sourced here as a library; only the job-level finalization
    24	# (--children/--expect/--job-spec) has no helper there and is defined below. A job is not a
    25	# child of anything: it closes no log and writes no receipt (plan amendment A3).
    26	# EXP06_PIPELINE_LIB=1 source tools/exp06_haa_pipeline.sh defines the functions and
    27	# returns, so job_spec, child, run_finetune and run_queue can be exercised without a queue.
    28	# --dry-run prints every command and path (timestamps as <UTC>) and executes nothing.
    29	set -euo pipefail
    30	EXP06_LAUNCH_LIB=1 source "$(dirname -- "${BASH_SOURCE[0]}")/exp06_launch.sh"
    31	
    32	OUT=ckpt/exp06/sim2real
    33	ROOMS="class_room dampened_room hallway complex_room"
    34	S1_ROOMS="class_room hallway complex_room"   # dampened excluded from stage 1, as in exp_02
    35	S1="--epochs 1000 --val-every 10 --tf32"
    36	S2="--epochs 200 --val-every 2 --tf32"
    37	HEADING_DIR="${EXP06_HEADING_DIR:-ckpt/exp06/heading}"
    38	HAA_ROOT="${HAA_XRIR_ROOT:-$HOME/data_cache/HAA_xrir}"
    39	FRAME=heading                       # every exp_06 HAA arm runs in the heading frame
    40	OWNER=""                            # set to this launcher's pid only at the job root
    41	DRY=0
    42	INIT_BACKBONE=""                    # set by init_of; never word-split out of one string
    43	INIT_CKPT=""
    44	
    45	usage() {
    46	    echo "usage: $0 <gpu> <job>... [--dry-run]   job = <init>:<seed> | zeroshot" >&2
    47	    echo "       init in cyl_or | control_hf | cyl_hf" >&2
    48	    exit 2
