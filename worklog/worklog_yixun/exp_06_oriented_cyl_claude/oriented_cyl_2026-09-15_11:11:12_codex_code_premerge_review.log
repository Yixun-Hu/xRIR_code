    51	# init_of <name>: the backbone and checkpoint of one initialisation, as two variables.
    52	# Nit 5: a checkpoint path may contain spaces, so it is never carried through word splitting.
    53	init_of() { case "$1" in
    54	  cyl_or) INIT_BACKBONE=cylindrical_oriented
