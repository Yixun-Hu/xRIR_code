  1547	def haa_job_completion(run_dir, children, expect, repo, job_spec, log, child_exit, owner_pid):
  1548	    """One pipeline job: no child of its own, hence no exit receipt and no closed log (A3).
  1549	
  1550	    The orchestrating shell is the process that finalizes the job, so the only execution
  1551	    evidence a job root can hold is its own still-live ``launch.pid``; a receipt there could
  1552	    only name that same shell. What binds a job is the job spec, that declared owner, and
  1553	    every expected child's completion, each re-validated by ``haa_job_evidence``.
  1554	    """
  1555	    _require(not (run_dir / 'child_exit.json').exists(),
  1556	             'job roots carry no child exit receipt (A3)')
  1557	    owner = refuse_live_launch(run_dir, owner_pid)
  1558	    _require(owner_pid is None or owner == owner_pid,
  1559	             'the job root holds launch.pid {}, not the declared owner {}'.format(
  1560	                 owner, owner_pid))
  1561	    _require(child_exit == 0, 'the job was declared with child status {}'.format(child_exit))
  1562	    fields = dict(schema_version=1, run_type='haa_job', run_dir=str(run_dir.resolve()),
  1563	                  repo=str(Path(repo).resolve()), child_exit=child_exit, log=job_log(log),
  1564	                  owner_pid=owner, diagnostic=False, admissible_arm=True)
  1565	    fields.update(haa_job_evidence(run_dir, children, expect, repo, job_spec))
  1566	    return write_completion(run_dir / 'completion.json', fields)
  1567	
  1568	
  1569	def finalize(run_dir, run_type, log, child_exit, repo=REPO, receipt=None,
  1570	             children=(), expect=None, owner_pid=None, job_spec=None):
  1571	    """Verify one child's evidence for its run type and write completion.json."""
  1572	    run_dir = Path(run_dir)
  1573	    _require(run_type in RUN_TYPES, 'unknown run type: {!r}'.format(run_type))
  1574	    _require(run_dir.is_dir(), 'run directory does not exist: {}'.format(run_dir))
  1575	    _require(type(child_exit) is int, 'child status must be an integer')
  1576	    if run_type == 'haa_job':  # A3: a job orchestrates children and is none itself
  1577	        return haa_job_completion(run_dir, children, expect, repo, job_spec, log, child_exit,
  1578	                                  owner_pid)
  1579	    refuse_live_launch(run_dir, owner_pid)
  1580	    log_record, child_exit_time, log_digest = closed_log(log, child_exit)
  1581	    receipt_record = child_exit_receipt(run_dir, child_exit, log_digest, child_exit_time)
  1582	    diagnostic = run_type in DIAGNOSTIC
  1583	    if not diagnostic:
  1584	        _require(child_exit == 0, 'child exited with status {}'.format(child_exit))
  1585	    fields = dict(schema_version=1, run_type=run_type, run_dir=str(run_dir.resolve()),
  1586	                  repo=str(Path(repo).resolve()), child_exit=child_exit,
  1587	                  child_exit_time=child_exit_time, log=log_record,
  1588	                  child_exit_receipt=receipt_record,
  1589	                  diagnostic=diagnostic, admissible_arm=not diagnostic)
  1590	    fields.update(diagnostic_evidence(run_dir, receipt, child_exit, run_type, repo,
  1591	                                      receipt_record) if diagnostic
  1592	                  else full_evidence(run_dir, repo) if run_type == 'full'
  1593	                  else haa_train_evidence(run_dir, repo) if run_type == 'haa_train'
  1594	                  else haa_eval_evidence(run_dir, repo))
  1595	    _require(provenance.sha256_file(log) == log_digest,
  1596	             'stale log: {} changed while its completion was being validated'.format(log))
  1597	    return write_completion(run_dir / 'completion.json', fields)
