    93	    exp06_finalize.load_job_spec(sys.argv[1], sys.argv[2])
    94	except (OSError, ValueError) as error:
    95	    raise SystemExit("refusing: " + str(error))
    96	'
    97	
    98	job_spec() {  # job_spec <path> <init> <checkpoint> <seed> <expect> <backbone>
    99	    say "JOBSPEC $1 init=$2 checkpoint=$3 seed=$4 expect=$5 backbone=$6 frame=$FRAME heading=$HEADING_DIR"
   100	    [ "$DRY" -eq 1 ] || "$PYTHON" -c "$JOB_SPEC_PY" "$1" "$2" "$3" "$4" "$5" "$6" \
   101	        "$FRAME" "$HEADING_DIR" "$HAA_ROOT"
   102	}
   103	
   104	check_spec() {  # check_spec <path> <expect>
   105	    say "CHECKSPEC $1 expect=$2"
   106	    [ "$DRY" -eq 1 ] || "$PYTHON" -c "$CHECK_SPEC_PY" "$1" "$2"
   107	}
