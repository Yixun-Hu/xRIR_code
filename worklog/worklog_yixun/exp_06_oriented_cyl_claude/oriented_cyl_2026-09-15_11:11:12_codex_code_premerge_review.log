   231	            continue
   232	        fi
   233	        run_finetune "${job%%:*}" "${job#*:}" \
   234	            || { echo "FAILED job $job" >&2; failed=$((failed + 1)); }
   235	    done
   236	    if [ "$failed" -ne 0 ]; then
   237	        say "QUEUE_FAILED $failed"
   238	        return 1
   239	    fi
   240	    say "QUEUE_DONE gpu=$GPU"
   241	}
