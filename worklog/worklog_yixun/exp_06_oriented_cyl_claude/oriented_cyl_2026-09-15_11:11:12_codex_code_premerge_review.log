    if slice_till_direct_signal:
        if direct_signal_len_in_ms == 50:
            if (sr == 16000) and (hop_length == 62) and (win_length == 248):
                # (62 * 11 + 248 / 2) / 16000 = 0.050375 (50 ms)
                # so has to use the 12th window (idx = 11).. so slice idx should be 12
                slice_idx = 12
            else:
