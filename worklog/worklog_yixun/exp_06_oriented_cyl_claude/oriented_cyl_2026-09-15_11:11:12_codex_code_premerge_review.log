    assert command[:2] == [sys.executable, str(ROOT / 'tools/exp06_eval.py')]
    assert command[2:] == [
        '--backbone', 'cylindrical_oriented', '--checkpoint', args.checkpoint,
        '--manifest', args.manifest, '--manifest-hash', args.manifest_hash,
