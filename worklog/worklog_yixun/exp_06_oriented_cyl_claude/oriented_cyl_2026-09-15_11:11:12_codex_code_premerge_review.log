@contextlib.contextmanager
def overlay(files=None, absent=()):
    files={Path(k): v.encode() if isinstance(v,str) else v for k,v in (files or {}).items()}
    absent=set(map(Path,absent))-set(files)
    def _open(path, mode='r', *args, **kw):
        try: p=Path(path)
        except TypeError: return original_open(path,mode,*args,**kw)
        if p in absent: raise FileNotFoundError(str(p))
        if p in files:
            assert not any(x in mode for x in 'wax+')
            return io.BytesIO(files[p]) if 'b' in mode else io.StringIO(files[p].decode(kw.get('encoding') or 'utf-8'))
        return original_open(path,mode,*args,**kw)
    with contextlib.ExitStack() as stack:
        stack.enter_context(patch('builtins.open',_open))
        stack.enter_context(patch.object(Path,'open',lambda p,*a,**kw:_open(p,*a,**kw)))
        stack.enter_context(patch.object(Path,'exists',lambda p: p in files or (p not in absent and path_exists(p))))
        stack.enter_context(patch.object(Path,'is_file',lambda p: p in files or (p not in absent and path_is_file(p))))
        yield
