  1600	def child_exit_main(argv):
  1601	    """Close one child's log: append the end marker, then bind those bytes in a receipt."""
  1602	    parser = argparse.ArgumentParser(description='Close an exp_06 child log.')
  1603	    parser.add_argument('--run-dir', required=True)
  1604	    parser.add_argument('--log', required=True)
  1605	    parser.add_argument('--child-pid', type=int, required=True)
  1606	    parser.add_argument('--status', type=int, required=True)
  1607	    parser.add_argument('--started-at', required=True, help='ISO-8601 instant of the spawn')
  1608	    args = parser.parse_args(argv)
  1609	    path = Path(args.run_dir) / 'child_exit.json'
  1610	    try:
  1611	        _require(not path.exists(), 'child_exit.json already exists at {}'.format(path))
  1612	        _require(args.child_pid > 0, 'child_pid {} is not a pid'.format(args.child_pid))
  1613	        started = _timestamp(args.started_at, 'started_at')
  1614	        stamp = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()
  1615	        _require(datetime.datetime.fromisoformat(stamp) >= started,
  1616	                 'the clock moved backwards: {} precedes started_at {}'.format(stamp, args.started_at))
  1617	        with open(args.log, 'a') as stream:
  1618	            stream.write('{} {} {}\n'.format(MARKER, args.status, stamp))
  1619	            stream.flush()
  1620	            os.fsync(stream.fileno())
  1621	        provenance.write_manifest(path, dict(
  1622	            schema_version=1, child_pid=args.child_pid, status=args.status,
  1623	            started_at=args.started_at, ended_at=stamp,
  1624	            log=str(Path(args.log).resolve()),
  1625	            log_sha256_after_marker=provenance.sha256_file(args.log)))
  1626	    except (OSError, ValueError) as error:
  1627	        print('EXP06_CHILD_EXIT_REFUSED ' + str(error), file=sys.stderr, flush=True)
  1628	        return 2
  1629	    print('EXP06_CHILD_EXIT_OK ' + str(path), flush=True)
  1630	    return 0
  1631	
