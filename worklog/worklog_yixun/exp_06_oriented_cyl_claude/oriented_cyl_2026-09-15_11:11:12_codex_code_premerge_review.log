  1014	def open_job(job, log, text='pipeline output\n'):
  1015	    """What the pipeline leaves at a job root: a queue log, and no receipt of its own.
  1016	
  1017	    Plan amendment A3: the shell that orchestrates a job is still alive when it finalizes
  1018	    it, so a job closes no log and writes no ``child_exit.json``; the queue log is
  1019	    informational and the owner is the job root's ``launch.pid``.
  1020	    """
  1021	    Path(job).mkdir(parents=True, exist_ok=True)
  1022	    Path(log).write_text(text)
  1023	    return log
