    67	JOB_SPEC_PY='
    68	import json, sys
    69	from pathlib import Path
    70	from tools import exp06_haa_finetune as entry
    71	from tools import provenance
    72	path, init, checkpoint, seed, expect, backbone, frame, heading_dir, root = sys.argv[1:10]
