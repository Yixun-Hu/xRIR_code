    56	  control_hf) INIT_BACKBONE=simple; INIT_CKPT=ckpt/xRIR_simple_8_shot/epoch_12.pth;;
    57	  cyl_hf) INIT_BACKBONE=cylindrical; INIT_CKPT=ckpt/xRIR_cyl_8_shot/epoch_12.pth;;
