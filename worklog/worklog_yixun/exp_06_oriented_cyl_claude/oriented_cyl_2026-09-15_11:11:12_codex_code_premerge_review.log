   118	# child <run-type> <dir> <log> <command...>: the launcher's lifecycle for one child.
   119	# A completed child is skipped; a failed or refused one leaves _ABORTED_<reason> behind
   120	# and never a completion.
   121	child() {
   122	    # A child directory never holds a live launcher pid, so it never claims the owner
   123	    # exception: OWNER is shadowed here and the finalizer sees no --owner-pid.
   124	    local kind="$1" dir="$2" log="$3" OWNER=""
   125	    shift 3
   126	    if [ -f "$dir/completion.json" ]; then say "SKIP $dir"; return 0; fi
   127	    say "MKDIR $dir"
   128	    say "SINK cat >> $log"
