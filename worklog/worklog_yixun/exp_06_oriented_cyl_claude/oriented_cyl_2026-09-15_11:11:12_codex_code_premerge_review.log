                                          'checkpoint_epoch', 'heading', 'frame']))
def test_each_metadata_mismatch_is_refused(exp06_run, field):
    args, fields, path = exp06_run
    path.write_text(json.dumps(dict(fields, **{field: 'wrong'})))
