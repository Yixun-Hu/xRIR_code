   109	# prepare_job <root> <init> <checkpoint> <seed> <expect> <backbone>: every gate that must
   110	# pass before the first child of this job starts. A failure here is named and propagated.
   111	prepare_job() {
   112	    open_job "$1" || { say "REFUSED open_job $1"; return 1; }
   113	    job_spec "$1/job_spec.json" "$2" "$3" "$4" "$5" "$6" \
   114	        || { say "REFUSED job_spec $1"; return 1; }
