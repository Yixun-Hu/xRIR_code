  1633	def gpu_compute_apps(gpu):
  1634	    """The pids nvidia-smi reports on one card; an unqueryable card is refused."""
  1635	    try:
  1636	        output = subprocess.check_output(
  1637	            ['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader', '-i', str(gpu)],
  1638	            text=True, stderr=subprocess.STDOUT)
  1639	    except (OSError, subprocess.CalledProcessError) as error:
  1640	        raise ValueError('cannot query GPU {}: {}'.format(gpu, error)) from error
  1641	    return [line.strip() for line in output.splitlines() if line.strip()]
