+#!/bin/bash
+# exp_06 launch day (GPU 1, after the peer's hand-over). Run step by step; every step logs to the record folder via the launcher.
+set -uo pipefail
+R=/home/yixunhu/codespace/xRIR_code; cd $R
+export PYTHONPATH=$R XRIR_DATA_PATH=/home/yixunhu/data_cache/AcousticRooms PYTHONDONTWRITEBYTECODE=1
+PY=/home/yixunhu/miniconda3/envs/xRIR/bin/python; SHA=$(git rev-parse --short HEAD); GPU=${GPU:-1}
+E=$R/worklog/worklog_yixun/exp_06_oriented_cyl_claude; APPROVED=worklog/worklog_yixun/exp_06_oriented_cyl_claude/oriented_cyl_results_assets/approved_digests.json
+step=${1:-help}
+case $step in
+  gate)      # HEAD clean outside worklog, approvals bound, GPU free
+    git status --porcelain | grep -v '^.. worklog/' && echo "STOP: dirty outside worklog" || echo "tree OK"
+    CUDA_VISIBLE_DEVICES='' $PY -c "
+import subprocess; from tools import exp06_profiles as ap
+repo='$R'; head=subprocess.check_output(['git','rev-parse','HEAD'],cwd=repo,text=True).strip()
+a,i=ap.load_approved_digests('$R/$APPROVED', repo, head); f=ap.compute_code_digests(repo, head)
+print('approvals bound at', i['committed_at'][:7], '| TRAINING_KEYS mismatches', [k for k in ap.TRAINING_KEYS if a['code'][k]!=f[k]], '| require', ap.require(a, ap.TRAINING_KEYS))"
+    nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader -i $GPU; nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader -i $GPU ;;
+  smoke)     # rung 4 (a)(b) + fixture via the launcher (each ≤ 3 GB / 300 s, finalised)
+    bash tools/exp06_launch.sh smoke --gpu $GPU --reviewed-commit $SHA ;;
+  haa-smoke) # rung 4 (c)(d) with the CPU fixture; diagnostics, --exploratory not needed (approvals filled)
+    FX=ckpt/exp06/_smoke/fixture_cylor.pth; [ -f $FX ] || $PY tools/exp06_smoke.py --make-fixture $FX
+    mkdir -p ckpt/exp06/_smoke/h1
+    CUDA_VISIBLE_DEVICES=$GPU OMP_NUM_THREADS=8 $PY tools/exp06_smoke.py --entry exp06_haa_finetune --receipt ckpt/exp06/_smoke/receipt_haa_finetune.json --run-type smoke --provenance-out ckpt/exp06/_smoke/h1/provenance.json --approved $APPROVED --reviewed-commit $SHA --alarm-seconds 300 --max-gb 3 -- --backbone cylindrical_oriented --init $FX --rooms class_room --heading-json-dir ckpt/exp06/heading --save-dir ckpt/exp06/_smoke/h1/run --epochs 2 --val-every 1 --batch-size 4 --val-batch-size 4 --seed 0 2>&1 | tee -a $E/oriented_cyl_$(date -u +%Y%m%dT%H%M%S)_smoke_haa_finetune.log | tail -5
+    mkdir -p ckpt/exp06/_smoke/e1
+    CUDA_VISIBLE_DEVICES=$GPU OMP_NUM_THREADS=8 $PY tools/exp06_smoke.py --entry exp06_haa_eval --receipt ckpt/exp06/_smoke/receipt_haa_eval.json --run-type smoke --provenance-out ckpt/exp06/_smoke/e1/provenance.json --approved $APPROVED --reviewed-commit $SHA --alarm-seconds 300 --max-gb 3 -- --backbone cylindrical_oriented --checkpoint ckpt/exp06/_smoke/h1/run/best.pth --heading-json-dir ckpt/exp06/heading --rooms hallway --max-samples 4 --save-dir ckpt/exp06/_smoke/e1/run --seed 0 2>&1 | tee -a $E/oriented_cyl_$(date -u +%Y%m%dT%H%M%S)_smoke_haa_eval.log | tail -5 ;;
+  probe)     # rung 5: 200 batches at 32x2, TF32, no-save; receipt under the attempt root
+    bash tools/exp06_launch.sh probe --gpu $GPU --reviewed-commit $SHA ;;
+  full)      # rung 7: the confirmatory pretraining (detached by the launcher; ≈ 31 h)
+    bash tools/exp06_launch.sh full --gpu $GPU --reviewed-commit $SHA ;;
+  *) echo "steps: gate | smoke | haa-smoke | probe | full";;
+esac

