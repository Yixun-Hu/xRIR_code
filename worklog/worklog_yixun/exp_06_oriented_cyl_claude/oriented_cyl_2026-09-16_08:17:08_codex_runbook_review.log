"""exp_06 HAA entry points: fail-closed headings, pinned-path parity and the records."""
import hashlib
import json
import sys
from pathlib import Path

import numpy as np
import pytest
import torch

from sim_to_real import finetune_haa
from sim_to_real.haa_dataset import ROOMS, HAADataset
