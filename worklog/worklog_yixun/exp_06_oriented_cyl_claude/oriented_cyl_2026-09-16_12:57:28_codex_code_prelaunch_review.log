print('exp03 pin:',computed['evaluator_exp03'],len(memberships['evaluator_exp03']),'files')
assert computed['evaluator_exp03']==p.EVALUATOR_EXP03
trainer=closure('train_xRIR_backbone')
print('pinned trainer:',provenance.closure_record(trainer,head,repo)[1],len(trainer),'files')
pinned=set(trainer+memberships['evaluator_exp03'])
