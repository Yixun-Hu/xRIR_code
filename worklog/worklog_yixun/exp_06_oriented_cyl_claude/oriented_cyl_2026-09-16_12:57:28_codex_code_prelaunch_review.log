import ast,hashlib,json,subprocess
from pathlib import Path
from tools import exp06_profiles as p,provenance
repo=Path.cwd();head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
def module_file(name):
    stem=repo/name.replace('.','/')
    for candidate in (stem.with_suffix('.py'),stem/'__init__.py'):
        if candidate.is_file():return candidate
    return None
def imports(nodes):
    for node in nodes:
        if isinstance(node,(ast.Import,ast.ImportFrom)):yield node
        elif isinstance(node,(ast.If,ast.Try,ast.With)):
            for name in ('body','orelse','finalbody'):
                yield from imports(getattr(node,name,[]))
            for handler in getattr(node,'handlers',[]):yield from imports(handler.body)
def closure(module):
    seen=set()
    def visit(name):
        path=module_file(name)
        if path is None or str(path.relative_to(repo)) in seen:return
        seen.add(str(path.relative_to(repo)))
        for node in imports(ast.parse(path.read_bytes()).body):
            if isinstance(node,ast.Import):
                for a in node.names:visit(a.name)
            elif node.level==0:
                base=node.module or ''
                visit(base)
                for a in node.names:visit(base+'.'+a.name)
    visit(module)
    return sorted(seen)
computed={}; memberships={}
for name,(module,extra) in p.CODE_SPECS.items():
    files=sorted(set((closure(module) if module else [])+list(extra)))
    memberships[name]=files
    records,digest=provenance.closure_record(files,head,repo)
    assert all(r['reviewed_blob_sha256']==r['working_tree_sha256'] for r in records)
    computed[name]=digest
approved=json.loads(p.APPROVED_DIGESTS_PATH.read_text())['code']
changed=sorted(k for k in computed if computed[k]"'!=approved[k])
