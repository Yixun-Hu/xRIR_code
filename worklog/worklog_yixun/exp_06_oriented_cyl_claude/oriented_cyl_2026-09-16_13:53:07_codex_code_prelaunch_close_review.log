   617	                        'provenance.json orchestration_closures')
   618	    _require(set(closures) == {'launcher', 'finalizer'},
   619	             'provenance.json orchestration_closures must bind the launcher and the finalizer')
   620	    for role, key in (('launcher', 'launch_sh'), ('finalizer', 'finalize')):
   621	        closure = _mapping(closures[role], 'orchestration_closures.' + role)
   622	        files = _closure_files(closure.get('files'), role)
   623	        _require(closure.get('sha256') == closure_digest(files),
   624	                 'recorded {} digest does not match its own file list'.format(role))
   625	        _require(closure['sha256'] == recorded_digests.get(key),
   626	                 'recorded {} digest is not the code_digests {}'.format(role, key))
   627	        fresh, _ = exp06_profiles.closure_of(key, str(Path(repo).resolve()), commit)
   628	        now = {item['path']: item for item in fresh}
   629	        _require(sorted(now) == sorted(item['path'] for item in files),
   630	                 '{} closure membership changed: {}'.format(role, ', '.join(sorted(
   631	                     set(now) ^ {item['path'] for item in files}))))
   632	        for item in files:
