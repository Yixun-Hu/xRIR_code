  1021	def _isfinite(label, value):
  1022	    """Nit 3: an integer too wide to become a float is a named refusal, not an OverflowError
  1023	    escaping the numeric check."""
  1024	    try:
  1025	        return math.isfinite(value)
  1026	    except OverflowError:
  1027	        raise ValueError('{} is an integer of {} digits, too large for a finite number'.format(
  1028	            label, len(str(abs(value)))))
