  1031	def _positive(label, value):
  1032	    """A budget of zero disables the thing it bounds, so it is never evidence."""
  1033	    _require(_finite(label, value) > 0, '{} is {!r}, not a positive budget'.format(label, value))
  1034	    return float(value)
  1035	
  1036	
  1037	def _finite(label, value):
  1038	    _require(type(value) in (int, float) and not isinstance(value, bool)
  1039	             and _isfinite(label, value), '{} is {!r}, not a finite number'.format(label, value))
  1040	    return value
