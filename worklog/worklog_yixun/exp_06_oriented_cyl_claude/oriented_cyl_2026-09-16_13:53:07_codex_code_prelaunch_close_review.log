   863	def confined(path, root, label):
   864	    """Codex pre-launch finding 1: a registered artefact is of the tree, not a link out of it.
   865	
   866	    ``artifacts()`` hashes whatever a symlink leads to, so an allow-listed *name* pointing
   867	    outside ``_smoke`` -- an external ``best.pth``, an external ``per_sample_<room>.json`` --
   868	    would otherwise be hashed and finalised as passed, and a passing training diagnostic
   869	    could hand the next rung a checkpoint nobody in this experiment produced. Every
   870	    component below the already resolved ``root`` must therefore be a real directory or
   871	    file (``lstat``, not ``stat``), which also leaves the path resolving inside ``root``.
   872	    """
   873	    path = Path(path)
   874	    _require(root in path.parents, '{} is not inside {}'.format(path, root))
   875	    walked = root
   876	    for part in path.relative_to(root).parts:
   877	        walked = walked / part
   878	        _require(not walked.is_symlink(),
   879	                 'the {} {} is a symlink, not a real entry of {}'.format(label, walked, root))
   880	    _require(path.resolve() == path,
   881	             'the {} {} resolves to {}, outside {}'.format(label, path, path.resolve(), root))
   882	    return path
