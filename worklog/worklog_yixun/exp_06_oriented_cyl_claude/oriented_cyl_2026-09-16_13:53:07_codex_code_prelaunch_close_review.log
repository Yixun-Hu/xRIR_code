   906	def haa_smoke_artifacts(run_dir, run_type, repo):
   907	    """A4: the HAA wrappers have no ``--no-save``, so their output is enumerated instead.
   908	
   909	    Fine-tuning must keep ``best.pth`` for the evaluation smoke that consumes it, so the
   910	    diagnostic contract replaces the argv guard with this allow-list: exactly the files the
   911	    wrapper writes, in the directory its own ``save_dir`` names, inside the disposable
   912	    smoke tree, each hashed into the completion. Anything else there is an unregistered
   913	    write and refuses, and an allow-listed name is accepted only as a regular file of that
   914	    tree (``confined``), never as a link to one outside it.
   915	    """
   916	    root = smoke_run_dir(run_dir, repo)
   917	    directory = confined(root / ARTIFACT_DIR, root, 'artefact directory')
   918	    _require(directory.is_dir(), 'missing artefact directory {}'.format(directory))
   919	    confined(directory / 'args.json', root, 'artefact')  # read only once confined
   920	    args = _read_json(directory / 'args.json', 'args.json')
   921	    _require(_resolve(args.get('save_dir') or '', repo).resolve() == directory,
   922	             'args.json records the save_dir {!r}, not the {} being finalized'.format(
   923	                 args.get('save_dir'), directory))
   924	    names = haa_smoke_files(run_type, args)
   925	    unregistered = sorted(set(item.name for item in directory.iterdir()) - set(names))
   926	    _require(not unregistered, '{} holds unregistered artefacts: {}'.format(
   927	        directory, ', '.join(unregistered)))
   928	    return artifacts(directory, sorted(names), root=root)
