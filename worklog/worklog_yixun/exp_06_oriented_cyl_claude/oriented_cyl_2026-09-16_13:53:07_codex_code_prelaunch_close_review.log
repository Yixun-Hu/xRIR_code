   885	def haa_smoke_files(run_type, args):
   886	    """The names the wrapper writes, derived from its own arguments -- never guessed.
   887	
   888	    ``tools/exp06_haa_eval.py`` writes one ``metrics_``/``per_sample_`` pair per room plus
   889	    the ``metrics_all`` roll-up, each suffixed with ``--tag``; the fine-tuning wrapper's
   890	    output does not depend on its arguments.
   891	    """
   892	    names = list(HAA_SMOKE_ARTIFACTS[run_type])
   893	    if run_type != 'haa_smoke_eval':
   894	        return names
   895	    rooms, tag = args.get('rooms'), args.get('tag', '')
   896	    _require(isinstance(rooms, list) and rooms and all(room in ROOMS for room in rooms),
   897	             'args.json records the rooms {!r}, not a list of HAA rooms'.format(rooms))
   898	    _require(isinstance(tag, str), 'args.json records the tag {!r}'.format(tag))
   899	    names.append('metrics_all{}.json'.format(tag))
   900	    for room in rooms:
   901	        names += ['metrics_{}{}.json'.format(room, tag),
   902	                  'per_sample_{}{}.json'.format(room, tag)]
