   609	def verify_orchestration(record, repo, commit, recorded_digests):
   610	    """Finding 1: the launcher shell and the finalizer that decide this run, bound as files.
   611	
   612	    A later round may edit either while a 31-hour training run is going, so their bytes are
   613	    compared three ways -- the working tree now, what was recorded at spawn, and the
   614	    reviewed blobs -- exactly as the training closure is.
   615	    """
