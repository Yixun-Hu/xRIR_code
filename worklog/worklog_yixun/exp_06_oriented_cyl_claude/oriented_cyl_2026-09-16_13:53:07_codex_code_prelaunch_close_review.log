   652	    _require(not exploratory or run_type in DIAGNOSTIC,
   653	             'an exploratory run is never admissible as an arm')
   654	    recorded = record.get('code_digests')
   655	    _require(isinstance(recorded, dict)
   656	             and set(recorded) == set(exp06_profiles.TRAINING_KEYS),
   657	             'provenance.json records no code_digests for the training-critical keys')
   658	    commit = record['reviewed_commit']
   659	    current = exp06_profiles.compute_code_digests(repo, commit,
   660	                                                  keys=exp06_profiles.TRAINING_KEYS)
   661	    drift = sorted(key for key in exp06_profiles.TRAINING_KEYS
   662	                   if current.get(key) != recorded.get(key))
   663	    _require(not drift, 'code drift since the run started: ' + ', '.join(drift))
   664	    orchestration = verify_orchestration(record, repo, commit, recorded)
   665	    approvals = record.get('approvals')
