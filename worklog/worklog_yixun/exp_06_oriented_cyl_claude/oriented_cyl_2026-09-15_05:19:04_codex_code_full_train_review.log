    root, _, names = data
    for category in ['Bathrooms', 'Cafe', 'LivingRoomsWithHallway', 'Office',
                     'Auditorium', 'Bedrooms', 'ListeningRoom', 'MeetingRoom', 'Restaurants']:
        (root / 'single_channel_ir' / category).mkdir()
