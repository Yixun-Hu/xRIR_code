+            if any(type(value) not in (int, float) or not math.isfinite(value) for value in values):
+                raise ValueError('descriptive fields must be finite numbers')
+            if (not {'phi_deg', 'a', 'b', 'mse'} <= fit.keys() or fit['b'] < 0 or fit['mse'] < 0
