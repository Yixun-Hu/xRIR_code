                       'best.pth', 'last.pth')
HAA_SUMMARY = ('best_val_loss', 'best_epoch', 'init_val_loss', 'epochs')
METRIC_SOURCE = {'edt_error_s': 'edt', 'c50_error_db': 'c50', 't60_error_pct': 't60',
                 'env_error': 'env', 'stft_log_mse': 'stft_mse', 'test_loss': 'loss'}
