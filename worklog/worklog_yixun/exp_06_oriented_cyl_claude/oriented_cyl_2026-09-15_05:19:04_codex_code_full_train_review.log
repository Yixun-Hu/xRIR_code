   115	        say "SINK_FAILED status=$sink_status log=$log"
   116	        abort "$attempt" "$log" sink_failed
   117	        exit 3
   118	    fi
   119	}
   120	
   121	# close_child <attempt> <log>: append the end marker and bind exactly those bytes.
   122	close_child() {
   123	    say "MARKER EXP06_CHILD_EXIT $CHILD_STATUS <iso> >> $2"
   124	    "$PYTHON" tools/exp06_finalize.py child-exit --run-dir "$1" --log "$2" \
   125	        --child-pid "$CHILD_PID" --status "$CHILD_STATUS" --started-at "$CHILD_STARTED_AT"
   126	}
   127	
   128	if [ "${EXP06_LAUNCH_LIB:-0}" = 1 ]; then return 0; fi
   129	
   130	MODE="${1:-}"
   131	shift || true
   132	case "$MODE" in smoke|probe|full|finalize) ;; *) usage ;; esac
   133	GPU=""; COMMIT=""; ATTEMPT_ROOT=ckpt/exp06/pretrain/xRIR_cylor_8_shot
   134	ATTEMPT=""; LOG=""; CHILD_EXIT=""; DRY=0
   135	while [ $# -gt 0 ]; do
   136	    case "$1" in
   137	        --gpu) GPU="${2:-}"; shift 2 ;;
   138	        --reviewed-commit) COMMIT="${2:-}"; shift 2 ;;
   139	        --attempt-root) ATTEMPT_ROOT="${2:-}"; shift 2 ;;
   140	        --attempt) ATTEMPT="${2:-}"; shift 2 ;;
   141	        --log) LOG="${2:-}"; shift 2 ;;
   142	        --child-exit) CHILD_EXIT="${2:-}"; shift 2 ;;
   143	        --dry-run) DRY=1; shift ;;
   144	        *) usage ;;
   145	    esac
   146	done
   147	[ -n "$GPU" ] && [ -n "$COMMIT" ] || usage
   148	[ "$MODE" != finalize ] || { [ -n "$ATTEMPT" ] && [ -n "$LOG" ] && [ -n "$CHILD_EXIT" ]; } || usage
   149	
   150	if [ "$DRY" -eq 1 ]; then STAMP='<UTC>'; else STAMP="$(date -u +%Y%m%dT%H%M%S)"; fi
   151	# Recovery finalizes an attempt whose launcher is gone, so it owns no live launch.pid.
   152	if [ "$MODE" = finalize ]; then OWNER=""
   153	elif [ "$DRY" -eq 1 ]; then OWNER='<pid>'
   154	else OWNER="$$"; fi
   155	
   156	say "EXP06_LAUNCH mode=$MODE gpu=$GPU commit=$COMMIT root=$ATTEMPT_ROOT stamp=$STAMP dry_run=$DRY"
   157	say "ENV CUDA_VISIBLE_DEVICES=$GPU PYTHONHASHSEED=0 OMP_NUM_THREADS=8 XRIR_DATA_PATH=$DATA_ROOT"
   158	if [ "$DRY" -eq 0 ] && [ ! -d "$DATA_ROOT" ]; then
   159	    echo "refusing: XRIR_DATA_PATH $DATA_ROOT is not a directory" >&2
   160	    exit 2
   161	fi
   162	export XRIR_DATA_PATH="$DATA_ROOT"
   163	
   164	case "$MODE" in
   165	full)
   166	    preflight
   167	    attempt="$ATTEMPT_ROOT/attempt_$STAMP"
   168	    log="$RECORD/oriented_cyl_${STAMP}_train_full.log"
   169	    say "MKDIR $attempt"
   170	    say "SINK cat >> $log"
   171	    say "PIDFILE $attempt/launch.pid"
   172	    child=("$PYTHON" tools/exp06_train.py --backbone cylindrical_oriented --save-dir "$attempt"
   173	           --num-shot 8 --max-len 9600 --lr 1e-3 --weight-decay 1e-4 --decay-epochs 3
   174	           --lr-gamma 0.1 --epochs 12 --batch-size 32 --accum-steps 2 --num-workers 12
   175	           --seed 0 --tf32 --log-interval 50 --save-every 500 --epoch-ckpt-every 1
   176	           --run-type full)
   177	    say "RUN nohup setsid ${child[*]}"
   178	    if [ "$DRY" -eq 1 ]; then
   179	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   180	        abort "$attempt" "$log" 'child_exit_<code>'
   181	        finalize "$attempt" "$log" '<code>' full
   182	        promote "attempt_$STAMP"
   183	        exit 0
   184	    fi
   185	    mkdir -p -- "$ATTEMPT_ROOT"
   186	    mkdir -- "$attempt"  # exclusive: a repeated stamp must not reuse an attempt
   187	    own_launch "$attempt"
   188	    mkdir -p -- "$RECORD"
   189	    : > "$log"
   190	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   191	    run_child "$attempt" "$log" "${child[@]}"
   192	    close_child "$attempt" "$log"
   193	    status="$CHILD_STATUS"
