   275	def closed_log(log, child_exit):
   276	    """Require the launcher's end marker as the log's last line, agreeing on the status.
   277	
   278	    The bytes are read once and hashed here, so the receipt comparison and the recorded
   279	    digest describe exactly the content that was validated.
   280	    """
   281	    try:
   282	        data = Path(log).read_bytes()
   283	    except OSError as error:
   284	        raise ValueError('unreadable log: {}'.format(error)) from error
   285	    digest = hashlib.sha256(data).hexdigest()
   286	    lines = data.decode('utf-8', 'replace').splitlines()
   287	    _require(lines and lines[-1].startswith(MARKER + ' '),
   288	             'log does not end with the ' + MARKER + ' marker (child still writing?)')
   289	    parts = lines[-1].split()
   290	    _require(len(parts) == 3, 'malformed ' + MARKER + ' marker: ' + lines[-1])
   291	    try:
   292	        code, stamp = int(parts[1]), datetime.datetime.fromisoformat(parts[2])
   293	    except ValueError as error:
   294	        raise ValueError('malformed ' + MARKER + ' marker: {}'.format(error)) from error
   295	    _require(stamp.tzinfo is not None, MARKER + ' marker needs a timezone-aware timestamp')
   296	    _require(code == child_exit,
   297	             'log marker status {} differs from the reported child status {}'.format(code, child_exit))
   298	    return {'path': str(Path(log).resolve()), 'sha256': digest}, parts[2], digest
