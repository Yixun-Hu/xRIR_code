   151	G1_THRESHOLDS = {'cyl_cosine_min': 0.90, 'control_cosine_max': 0.60,
   152	                 'cyl_share_min': 0.70, 'control_share_max': 0.35,
   153	                 'cylor_cosine_max': 0.80, 'cylor_share_max': 0.50}
   154	G1_MODELS = ('cyl', 'control', 'cyl_or')
