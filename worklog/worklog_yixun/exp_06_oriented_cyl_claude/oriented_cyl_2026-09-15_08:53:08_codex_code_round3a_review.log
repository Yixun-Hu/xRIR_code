   156	
   157	def _value(stats, model, key):
   158	    try:
   159	        value = float(stats[model][key])
   160	    except (KeyError, TypeError, ValueError):
   161	        raise ValueError('G1 needs {} of {}'.format(key, model))
   162	    if not np.isfinite(value):
   163	        raise ValueError('{} of {} is not finite'.format(key, model))
   164	    return value
