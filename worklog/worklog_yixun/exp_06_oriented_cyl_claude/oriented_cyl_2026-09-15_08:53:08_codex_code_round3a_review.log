   509	                       'full': (gate or {}).get('cohort')},
   510	            'anchors': ANCHORS_LEGACY, 'anchor_tolerance': ANCHOR_TOLERANCE,
   511	            'legacy_reproduction': legacy, 'stats': (gate or {}).get('stats'),
   512	            'decision': decision, 'source_closure': _source_record(),
   513	            'environment': environment(),
   514	            'timestamp': datetime.datetime.now(datetime.timezone.utc).isoformat()}
   515	
   516	
   517	def main(argv=None):
   518	    """0 when G1 passes, 3 when it fails, 4 when it is inconclusive, 2 for input errors."""
   519	    args = parse_args(argv)
   520	    record = build_record(args)
   521	    out = Path(args.out)
   522	    out.parent.mkdir(parents=True, exist_ok=True)
   523	    digest = write_manifest(out, record)          # exclusive create: never an overwrite
   524	    outcome = record['decision']['outcome']
   525	    print(json.dumps({'outcome': outcome, 'out': str(out), 'sha256': digest,
   526	                      'legacy_reproduced': record['legacy_reproduction']['reproduced'],
   527	                      'reasons': record['decision']['reasons']}))
   528	    return {'pass': EXIT_PASS, 'fail': EXIT_FAIL}.get(outcome, EXIT_INCONCLUSIVE)
   529	
