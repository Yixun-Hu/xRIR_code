   125	def legacy_cohort(test_indices, y_room_frame, n=24):
   126	    """The 2026-09-14 selection: sort one side by room-frame y, take n evenly spaced ranks."""
   127	    if isinstance(n, bool) or not isinstance(n, numbers.Integral) or n < 1:
   128	        raise ValueError('n must be a positive integer')
   129	    indices = np.asarray(test_indices)
   130	    y = np.asarray(y_room_frame)
   131	    if indices.ndim != 1 or y.shape != indices.shape:
   132	        raise ValueError('test_indices and y_room_frame must be one aligned 1-D array')
   133	    if not np.isfinite(y).all():
   134	        raise ValueError('room-frame y must be finite')
   135	    cohort = {}
   136	    for label, mask in (('+y', y > 0), ('-y', y < 0)):
   137	        ranked = np.where(mask)[0]
   138	        ranked = ranked[np.argsort(y[ranked])]
   139	        if ranked.size == 0:
   140	            cohort[label] = {'positions': [], 'mic_ids': []}
   141	            continue
   142	        if ranked.size < n:
   143	            raise ValueError('side {} has {} microphones, fewer than the {} the cohort '
   144	                             'rule selects'.format(label, ranked.size, n))
   145	        chosen = ranked[np.linspace(0, ranked.size - 1, n).round().astype(int)]
   146	        cohort[label] = {'positions': [int(i) for i in chosen],
   147	                         'mic_ids': [int(indices[i]) for i in chosen]}
   148	    return cohort
