   412	        model = _load(model_factory, BACKBONE_OF[name], num_shot, paths[name], device)
   413	        with torch.no_grad():
   414	            stats[name] = mirror_stats(model, frames[frame], room, positions,
   415	                                       int(heading_k) if frame == 'heading' else 0,
   416	                                       side_of_query, device=device, batch=batch)
   417	        stats[name].update(backbone=BACKBONE_OF[name], frame=frame,
   418	                           checkpoint=str(paths[name]))
   419	        del model
