    67	def geometry_feature(model, src_locs, depth_coord):
    68	    """The pooled source branch for N positions against one panorama -> [N, C]."""
    69	    if depth_coord.dim() != 3 or src_locs.dim() != 2 or src_locs.shape[1] != 3:
    70	        raise ValueError('src_locs must be [N, 3] and depth_coord [3, H, W]')
    71	    encoded = (src_locs[:, :, None, None] - depth_coord[None]) / COORD_SCALE
    72	    pooled = model.lin_proj_0(model.src_proj(model.source_network(encoded)).permute(0, 2, 1))
    73	    return pooled.squeeze(-1)
