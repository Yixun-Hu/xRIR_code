    58	    out = []
    59	    for b in range(energy.shape[0]):
    60	        start = int(onset[b])
    61	        early = energy[b, start:start + C50_FRAMES].sum()
    62	        late = energy[b, start + C50_FRAMES:].sum()
    63	        out.append(10 * torch.log10(early / (late + LATE_EPS)))
    64	    return torch.stack(out)
