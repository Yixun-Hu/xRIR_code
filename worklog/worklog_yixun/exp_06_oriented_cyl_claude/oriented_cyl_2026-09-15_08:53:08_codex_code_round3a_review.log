   495	            ['the legacy reproduction did not match the 2026-09-14 anchors']
   496	            + list(legacy['deviations']) + list(decision['reasons'])))
   497	    return {'schema_version': 1, 'room': args.room, 'haa_root': str(args.haa_root),
