    75	
    76	def composed_forward(model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav,
    77	                     align=shift_and_align_device):
    78	    """`xRIR.forward`, line for line, also returning the mixing weights and pooled source.
    79	
    80	    The only departures are the device-preserving alignment (the pinned one allocates on
    81	    the default GPU) and the extra return values. `model.times` is a plain CPU tensor, not
    82	    a buffer, so it is transferred exactly as the pinned forward transfers it.
    83	    """
    84	    x = align(model, ref_irs, src_loc, ref_locs)
    85	    times = model.times
    86	    time_embed = model.time_embedder(times.unsqueeze(0).to(ref_locs.device)).repeat(
    87	        ref_locs.shape[0], 1, 1)
    88	    time_out = model.time_proj(time_embed)
    89	
    90	    source_out = model.lin_proj_0(model.src_proj(model.source_network(
    91	        (src_loc[:, :, None, None] - depth_coord) / COORD_SCALE)).permute(0, 2, 1)
    92	        ).squeeze(-1).unsqueeze(1)
    93	    receiver_out = model.lin_proj_0(model.src_proj(model.source_network(
    94	        (-depth_coord) / COORD_SCALE)).permute(0, 2, 1)).squeeze(-1).unsqueeze(1)
    95	    ref_geo = torch.cat([model.lin_proj_0(model.src_proj(model.source_network(
    96	        (ref_locs[:, i, :, None, None] - depth_coord) / COORD_SCALE)).permute(0, 2, 1)
    97	        ).squeeze(-1).unsqueeze(1) for i in range(ref_locs.shape[1])], dim=1)
    98	
    99	    fuse_geo = torch.cat([receiver_out, source_out], dim=-1)
   100	    fuse_ref_geo = torch.cat([receiver_out.repeat(1, ref_geo.shape[1], 1), ref_geo], dim=-1)
   101	    ref_src = torch.cat([model.src_coord_proj(model.dist_embedder(
   102	        ref_locs[:, i:(i + 1)] / COORD_SCALE).view(ref_locs.shape[0], -1)).unsqueeze(1)
   103	        for i in range(ref_locs.shape[1])], dim=1)
   104	    src_feats = model.src_coord_proj(model.dist_embedder(
   105	        src_loc.unsqueeze(1) / COORD_SCALE).view(src_loc.shape[0], -1)).unsqueeze(1)
   106	    fuse_geo = torch.cat([src_feats, fuse_geo], dim=-1)
   107	    fuse_ref_geo = torch.cat([ref_src, fuse_ref_geo], dim=-1)
   108	
   109	    logs, audio = [], []
   110	    for i in range(x.shape[1]):
   111	        spec_i = model.convert_ir_to_spec(x[:, i:(i + 1)])
   112	        logs.append(torch.log(spec_i + LOG_SPEC_EPS))
   113	        audio.append(model.audio_enc(spec_i).unsqueeze(1))
   114	    logs = torch.cat(logs, dim=1)
   115	    audio = torch.cat(audio, dim=1)
   116	
   117	    fuse_ref = model.lin_proj_2(torch.cat((fuse_ref_geo, audio), dim=-1))
   118	    fuse_tgt = model.lin_proj_1(fuse_geo)
   119	    fuse = F.softmax(fuse_ref @ fuse_tgt.permute(0, 2, 1) / fuse_tgt.shape[-1], dim=1) * fuse_ref
   120	    weights = fuse @ time_out.permute(0, 2, 1) / fuse.shape[-1]
   121	    out_log_spec = torch.sum(logs * weights.unsqueeze(2), dim=1)
   122	    return out_log_spec, model.convert_ir_to_spec(tgt_wav)[:, 0], weights, source_out.squeeze(1)
