   247	def mirror_stats(model, dataset, room, query_ids, frame_k, side_of_query,
   248	                 device='cpu', batch=8):
   249	    """Mirror cosine, opposite-side weight share and signed spectral-C50 error of one arm.
   250	
   251	    Sides are room-frame facts: the label of a query and of a reference is the sign of its
   252	    y before any heading roll, taken from the dataset's own room-frame coordinates. The
   253	    geometry is expressed in the frame the dataset itself serves, so ``frame_k`` must be
   254	    exactly the roll that dataset applies to this room.
   255	    """
   256	    if side_of_query not in (1, -1):
   257	        raise ValueError('side_of_query must be +1 or -1')
   258	    if getattr(dataset, 'eval_seed', None) is None:
   259	        raise ValueError('the probe needs a dataset with a fixed eval_seed')
   260	    if room not in getattr(dataset, 'data', {}):
   261	        raise ValueError('the dataset holds no room ' + str(room))
   262	    if int(frame_k) != _declared_frame_k(dataset, room):
   263	        raise ValueError('frame_k {} is not the roll the dataset applies to {}'.format(
   264	            frame_k, room))
   265	    query_ids = [int(i) for i in query_ids]
   266	    if not query_ids:
   267	        raise ValueError('at least one query is required')
   268	    if any(not 0 <= i < len(dataset) or dataset.items[i][0] != room for i in query_ids):
   269	        raise ValueError('every query id must index an item of room ' + str(room))
   270	
   271	    data = dataset.data[room]
   272	    room_y = data['src_local'][:, 1]
   273	    mic_ids = [int(dataset.items[i][1]) for i in query_ids]
   274	    if any(int(torch.sign(room_y[mic]).item()) != side_of_query for mic in mic_ids):
