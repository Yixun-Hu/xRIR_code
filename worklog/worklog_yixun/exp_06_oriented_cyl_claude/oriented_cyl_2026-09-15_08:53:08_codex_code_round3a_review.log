   167	def g1_decision(stats, thresholds=G1_THRESHOLDS):
   168	    """pass / fail / inconclusive under 6.1: the bracket first, the oriented model second.
   169	
   170	    Every comparison is strict, so a statistic exactly on a threshold never satisfies it:
   171	    an anchor exactly at its bound leaves G1 inconclusive, and an oriented model exactly at
   172	    its bound fails.
   173	    """
   174	    values = {model: {key: _value(stats, model, key) for key in
   175	                      ('mirror_cosine', 'opposite_side_weight_share')} for model in G1_MODELS}
   176	    cosine = {model: values[model]['mirror_cosine'] for model in G1_MODELS}
   177	    share = {model: values[model]['opposite_side_weight_share'] for model in G1_MODELS}
   178	    unbracketed = []
   179	    if not cosine['cyl'] > thresholds['cyl_cosine_min']:
   180	        unbracketed.append('cyl mirror cosine {:.4f} is not above {}'.format(
   181	            cosine['cyl'], thresholds['cyl_cosine_min']))
   182	    if not cosine['control'] < thresholds['control_cosine_max']:
   183	        unbracketed.append('control mirror cosine {:.4f} is not below {}'.format(
   184	            cosine['control'], thresholds['control_cosine_max']))
   185	    if not share['cyl'] > thresholds['cyl_share_min']:
   186	        unbracketed.append('cyl weight share {:.4f} is not above {}'.format(
   187	            share['cyl'], thresholds['cyl_share_min']))
   188	    if not share['control'] < thresholds['control_share_max']:
   189	        unbracketed.append('control weight share {:.4f} is not below {}'.format(
   190	            share['control'], thresholds['control_share_max']))
   191	    if unbracketed:
   192	        return {'outcome': 'inconclusive', 'reasons': unbracketed,
   193	                'thresholds': dict(thresholds), 'values': values}
   194	    failures = []
   195	    if not cosine['cyl_or'] < thresholds['cylor_cosine_max']:
   196	        failures.append('cyl_or mirror cosine {:.4f} is not below {}'.format(
   197	            cosine['cyl_or'], thresholds['cylor_cosine_max']))
   198	    if not share['cyl_or'] < thresholds['cylor_share_max']:
   199	        failures.append('cyl_or weight share {:.4f} is not below {}'.format(
   200	            share['cyl_or'], thresholds['cylor_share_max']))
   201	    return {'outcome': 'fail' if failures else 'pass', 'reasons': failures,
   202	            'thresholds': dict(thresholds), 'values': values}
