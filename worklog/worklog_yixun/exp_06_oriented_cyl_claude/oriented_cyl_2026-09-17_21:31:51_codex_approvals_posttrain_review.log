        self.train_indices = [#[0, 23, 46, 69, 92+12, 115, 138, 161, 184, 207, 230, 253],
          [5,  47, 82, 117, 145, 187, 220, 255, 290, 330+12, 360+12, 404],
          list(np.arange(12)*(57)),
          [5, 58, 99, 148, 203, 241, 296, 342, 384, 441, 482, 535]
          ]
        self.train_tgt_indices = [ list(np.arange(408)*2), list(np.arange(0, 315) * 2), list(np.arange(288)*2)]
        to_exclude = [list(self.train_indices[k]) + list(self.train_tgt_indices[k]) for k in range(3)]
