   136	             'the producer closure differs from HEAD: ' + ', '.join(drift))
   137	    return {'entry_module': ENTRY_MODULE, 'commit': head, 'sha256': digest,
   138	            'files': records, 'drift': drift, 'strict': bool(strict)}
