    broken=copy.deepcopy(record); broken['source_closure']={'strict':True}
    virtual_files[str(receipt_path)]=json.dumps(broken).encode()
    args=launch.parse_args(integration.argv_for('B',checkpoints,base/'B'))
    fields=launch.build_fields(args,launch.child_command(args,repo),repo,approvals={'deviations':[],'admissibility':'confirmatory'})
    directory=f.write_run(base/'B'/'empty_receipt_closure','B',42,checkpoints,f.SPLIT,route='exp06',launched=fields)
    run=c.admit_run(directory,'B',approved,f.SPLIT)
    print('R3_STRICT_ONLY_THROUGH_LAUNCHER_AND_COMPARER',run['role'],run['checkpoint']['sha256'],flush=True)
print('ALL_OUTPUTS_IN_MEMORY',len(virtual_files),flush=True)

