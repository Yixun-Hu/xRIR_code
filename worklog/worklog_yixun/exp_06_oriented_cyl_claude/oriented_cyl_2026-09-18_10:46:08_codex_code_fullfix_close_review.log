   103	def receipt_names(train_dir, checkpoints=None):
   104	    """The membership rule: which artefacts of a training directory a receipt enumerates.
   105	
   106	    One rule, written once and applied twice -- by the writer, to enumerate, and by
   107	    :func:`verify`, to require that a receipt enumerates all of them (R3: a receipt cut
   108	    down to two files and re-hashed is self-consistent, and is not complete evidence).
   109	    """
   110	    train_dir = Path(train_dir)
   111	    _require(train_dir.is_dir(), 'no training directory at {}'.format(train_dir))
   112	    names = list(REQUIRED_FILES)
   113	    for name in names:
   114	        _require((train_dir / name).is_file(),
   115	                 'the training directory {} has no {}'.format(train_dir, name))
   116	    names += list(epoch_checkpoints(train_dir) if checkpoints is None else checkpoints)
   117	    names += [name for name in OPTIONAL_FILES if (train_dir / name).is_file()]
   118	    return names
