import sys,json,copy,hashlib
sys.path.insert(0,str(__import__('pathlib').Path.cwd()/'tests'))
import test_exp06_compare as f
import test_exp06_sim_evidence as integration
from tools import exp06_legacy_train_receipt as r, exp06_eval_launch as launch, exp06_compare as c, exp06_approvals_api as api, provenance as p

import io, os, builtins, stat
from pathlib import Path
from unittest.mock import patch
from contextlib import ExitStack
from types import SimpleNamespace
virtual_root='/__exp06_readonly_review__'
virtual_files={}; virtual_dirs={virtual_root}
def vkey(path):
    if isinstance(path,int): return None
    value=os.path.abspath(os.fspath(path))
    return value if value==virtual_root or value.startswith(virtual_root+'/') else None
class VBuffer(io.BytesIO):
    def __init__(self,key,data,save):
        super().__init__(data); self.key=key; self.save=save
    def close(self):
        if not self.closed and self.save:
            virtual_files[self.key]=self.getvalue()
        super().close()
real_open=builtins.open; real_io_open=io.open
def vopen(path,mode='r',buffering=-1,encoding=None,errors=None,newline=None,closefd=True,opener=None):
    key=vkey(path)
    if key is None:
        assert not any(x in mode for x in 'wax+'),('attempt to write disk',path,mode)
        return real_open(path,mode,buffering,encoding,errors,newline,closefd,opener)
    write=any(x in mode for x in 'wax+')
    if 'x' in mode and key in virtual_files: raise FileExistsError(key)
    if not write and key not in virtual_files: raise FileNotFoundError(key)
    raw=VBuffer(key,b'' if any(x in mode for x in 'wx') else virtual_files.get(key,b''),write)
    if 'a' in mode: raw.seek(0,2)
    return raw if 'b' in mode else io.TextIOWrapper(raw,encoding=encoding or 'utf-8',errors=errors,newline=newline)
real_mkdir=Path.mkdir; real_iter=Path.iterdir; real_stat=Path.stat
def vmkdir(path,mode=0o777,parents=False,exist_ok=False):
    key=vkey(path)
    assert key is not None,('attempt to mkdir disk',path)
    if key in virtual_dirs and not exist_ok: raise FileExistsError(key)
    virtual_dirs.add(key)
    if parents:
        virtual_dirs.update(str(p) for p in Path(key).parents if vkey(p))
def viter(path):
    key=vkey(path)
    if key is None: return real_iter(path)
    if key not in virtual_dirs: raise FileNotFoundError(key)
    return iter(Path(x) for x in sorted(set(virtual_files)|virtual_dirs) if str(Path(x).parent)==key)
def vstat(path,*a,**k):
    key=vkey(path)
    if key is None: return real_stat(path,*a,**k)
    if key not in virtual_files and key not in virtual_dirs: raise FileNotFoundError(key)
    return SimpleNamespace(st_dev=0,st_ino=abs(hash(key)),st_size=len(virtual_files.get(key,b'')),
        st_mtime_ns=1,st_ctime_ns=1,st_mtime=1,st_ctime=1,
        st_mode=(stat.S_IFREG|0o644) if key in virtual_files else (stat.S_IFDIR|0o755))
def overlay(stack):
    stack.enter_context(patch('builtins.open',vopen))
    stack.enter_context(patch('io.open',vopen))
    stack.enter_context(patch.object(Path,'mkdir',vmkdir))
    stack.enter_context(patch.object(Path,'iterdir',viter))
    stack.enter_context(patch.object(Path,'stat',vstat))

repo=Path.cwd(); head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
trainB=(repo/'ckpt/xRIR_cyl_8_shot').resolve()
trainC=(repo/'ckpt/exp06/pretrain/xRIR_cylor_8_shot/attempt_20260916T161415').resolve()
base=Path(virtual_root)
receipt_path=base/'receipt.json'
record=r.build_receipt(trainB,trainB/'epoch_12.pth')
virtual_files[str(receipt_path)]=json.dumps(record).encode()
checkpoints={'repo':base,'B':trainB/'epoch_12.pth','C':trainC/'epoch_012.pth','train_B':(trainB,receipt_path),'train_C':trainC}
for name,content in f.DATA.items(): virtual_files[str(base/'data'/name)]=content
approved,_=api.load_approved_digests(api.approved_path_default(),repo=str(repo),commit=head)
with ExitStack() as stack:
    overlay(stack)
    stack.enter_context(patch.object(p,'data_identity',lambda path,root:f.data_identity(base,path,json.loads(Path(path).read_text()),p.sha256_file(path))))
    stack.enter_context(patch.object(launch.launcher,'_capture_environment',lambda *a:{'python':'3.8'}))
    for role in ('C','B'):
        work=base/role; work.mkdir(parents=True)
        args=launch.parse_args(integration.argv_for(role,checkpoints,work))
