def vstat(path,*a,**k):
    key=vkey(path)
    if key is None: return real_stat(path,*a,**k)
    if key not in virtual_files and key not in virtual_dirs: raise FileNotFoundError(2,'no virtual file',key)
    return SimpleNamespace(st_dev=0,st_ino=abs(hash(key)),st_size=len(virtual_files.get(key,b'')),
