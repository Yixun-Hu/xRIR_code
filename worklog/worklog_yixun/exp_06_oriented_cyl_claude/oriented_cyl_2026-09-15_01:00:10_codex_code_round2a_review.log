+    assert exp06_smoke.main(['--make-fixture', str(tmp_path / 'f.pth')]) == 0
+    assert (tmp_path / 'f.pth').is_file() and (tmp_path / 'f.pth.json').is_file()
+    with pytest.raises(SystemExit):
+        exp06_smoke.main(['--', '--rooms', 'hallway'])

