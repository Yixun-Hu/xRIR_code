    assert (tmp_path / 'done.json').stat().st_mode & 0o777 == 0o640


@pytest.mark.parametrize('key', ['checkpoint_sha256', 'data_identity', 'source_closures'])
def test_required_inputs_cannot_be_omitted(key):
