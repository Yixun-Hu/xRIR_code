    57	def _publish(result, started, receipt):
    58	    """One JSON line and, if asked, the receipt; both carry the same record."""
    59	    result['wall_s'] = time.monotonic() - started
    60	    result['peak_bytes'] = peak_bytes()
    61	    if result['exit_status'] == 'ok' and result['peak_bytes'] > result['max_gb'] * GIB:
    62	        result['exit_status'] = 'memory'
    63	    print('EXP06_SMOKE ' + json.dumps(result, sort_keys=True, allow_nan=False), flush=True)
    64	    if receipt is not None:
    65	        provenance.write_completion(Path(receipt), result)
