   235	def haa_job_evidence(run_dir, children, expect):
   236	    """Bind one seed's children: every expected directory, each with its own completion."""
   237	    expected, job = set(expected_children(expect)), Path(run_dir).resolve()
   238	    seen = {}
   239	    for child in children:
   240	        path = Path(child).resolve()
   241	        try:
   242	            name = path.relative_to(job).as_posix()
   243	        except ValueError as error:
   244	            raise ValueError('child {} lies outside the job directory'.format(child)) from error
   245	        completion = path / 'completion.json'
   246	        _require(completion.is_file(), 'child {} has no completion.json'.format(name))
   247	        record = _read_json(completion, name + '/completion.json')
   248	        _require(record.get('run_type') in ('haa_train', 'haa_eval'),
   249	                 'child {} has run type {!r}'.format(name, record.get('run_type')))
   250	        _require(record.get('admissible_arm') is True, 'child {} is not admissible'.format(name))
   251	        seen[name] = provenance.sha256_file(completion)
   252	    missing = sorted(expected - set(seen))
   253	    _require(not missing, 'job is missing children: ' + ', '.join(missing))
   254	    unexpected = sorted(set(seen) - expected)
   255	    _require(not unexpected, 'unexpected children: ' + ', '.join(unexpected))
   256	    return dict(artifacts={}, children=seen, expect=expect)
