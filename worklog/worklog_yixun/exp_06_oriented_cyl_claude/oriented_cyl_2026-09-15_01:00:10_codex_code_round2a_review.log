    69	def run_entry(entry, argv, receipt=None, alarm_seconds=300, max_gb=3.0):
    70	    """Run one entry in-process; abort with status 3 on the alarm or the memory budget."""
    71	    if entry not in ENTRIES:
    72	        raise ValueError('unknown smoke entry {!r}; choose from {}'.format(entry, sorted(ENTRIES)))
    73	    module = importlib.import_module(ENTRIES[entry])
    74	    if torch.cuda.is_available():
    75	        torch.cuda.reset_peak_memory_stats()
    76	    result = dict(schema_version=1, diagnostic=True, entry=entry, module=ENTRIES[entry],
    77	                  argv=list(argv), alarm_seconds=alarm_seconds, max_gb=max_gb,
    78	                  git_head=provenance.git_state(REPO)['HEAD'],
    79	                  timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())
    80	    started = time.monotonic()
    81	    previous = signal.signal(signal.SIGALRM, _alarm)
    82	    signal.setitimer(signal.ITIMER_REAL, alarm_seconds)  # alarm(), with sub-second resolution
    83	    try:
    84	        _invoke(module, entry, argv)
    85	        result['exit_status'] = 'ok'
    86	    except _Timeout:
    87	        result['exit_status'] = 'alarm'
    88	    except BaseException as error:
    89	        result['exit_status'] = 'error: ' + type(error).__name__
    90	        _publish(result, started, receipt)
    91	        raise
    92	    finally:
    93	        signal.setitimer(signal.ITIMER_REAL, 0)
    94	        signal.signal(signal.SIGALRM, previous)
    95	    _publish(result, started, receipt)
    96	    if result['exit_status'] != 'ok':
    97	        raise SystemExit(3)
    98	    return result
