+"""Bounded in-process smoke runner: alarm, peak memory, receipts and the CPU fixture."""
+import json
+import sys
+import time
+import types
+from pathlib import Path
+
+import pytest
+import torch
+
+from model.xRIR_cyl_oriented import build_xrir_exp06
