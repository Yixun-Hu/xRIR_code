    diagnostic probe "$ATTEMPT_ROOT/probe_$STAMP" "$RECORD/oriented_cyl_${STAMP}_probe.log" \
        "$ATTEMPT_ROOT/probe_$STAMP.json" \
        --entry exp06_train --receipt "$ATTEMPT_ROOT/probe_$STAMP.json" \
        --alarm-seconds 2400 --max-gb 46 -- \
