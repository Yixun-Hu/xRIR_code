_to = torch.Tensor.to
def _to_cpu(self, *a, **k):
    a = tuple(x for x in a if not (isinstance(x, (str, torch.device)) and 'cuda' in str(x)))
    k = {kk: v for kk, v in k.items() if not (kk == 'device' and 'cuda' in str(v))}
    return _to(self, *a, **k)
