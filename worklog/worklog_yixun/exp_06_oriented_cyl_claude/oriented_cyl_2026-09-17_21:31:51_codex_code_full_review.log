   518	def arm_checkpoints(groups):
   519	    """One checkpoint identity per arm: every seed of an arm evaluated the same weights."""
   520	    identities = {}
   521	    for role in sorted(groups):
   522	        recorded = [run['checkpoint'] for run in groups[role]]
   523	        if not recorded:
   524	            continue
   525	        if any(_equal(item, recorded[0]) is False for item in recorded):
   526	            raise ValueError('arm {} evaluated more than one checkpoint'.format(role))
   527	        identities[role] = dict(recorded[0])
   528	    return identities
