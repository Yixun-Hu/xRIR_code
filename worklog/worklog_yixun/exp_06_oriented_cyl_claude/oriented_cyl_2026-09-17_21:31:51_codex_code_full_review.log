   531	def analyse(admitted, margin=MARGIN, n_boot=N_BOOT, exploratory=False):
   532	    """H3 is C vs B; C vs A is the same machinery, reported descriptively.
   533	
   534	    Finding 9: a decision-bearing verdict needs the complete A/B/C run set and an
   535	    admission with no deviations. A partial analysis names H3 `unavailable` and an
   536	    exploratory or unapproved one names it `exploratory`; in both cases every verdict is
   537	    suppressed, so a report can never carry a decision its evidence does not support.
   538	    """
   539	    groups = admitted['groups']
   540	    complete = all(role in groups and len(groups[role]) == len(SEEDS) for role in ROLES)
   541	    drafted = bool(exploratory or admitted['deviations'])
   542	    status = 'unavailable' if not complete else ('exploratory' if drafted else 'available')
   543	    result = {'schema_version': 1, 'exploratory': bool(exploratory), 'margin': margin,
   544	              'seeds': list(SEEDS), 'metrics': list(METRICS), 'split': dict(SPLIT),
   545	              'deviations': list(admitted['deviations']), 'inputs': admitted['inputs'],
   546	              'cells': [], 'verdicts': {}, 'H3': status, 'complete_arms': complete,
   547	              'checkpoints': arm_checkpoints(groups)}
   548	    for x, y in CONTRASTS:
   549	        if x not in groups or y not in groups:
   550	            continue
   551	        cells = [contrast_cell(groups, x, y, metric, n_boot) for metric in METRICS]
   552	        result['cells'].extend(cells)
