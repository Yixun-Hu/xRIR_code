    52	def parse_args(argv=None):
    53	    """The exp_06 evaluator's flags plus the launcher's own, resolved to absolute paths."""
    54	    parser = evaluator.build_parser(require_eval_manifest=False)
    55	    for name in ('run-label', 'reviewed-commit', 'data-root', 'log-dir'):
    56	        parser.add_argument('--' + name, required=True)
    57	    parser.add_argument('--num-shot', type=int, required=True)
    58	    parser.add_argument('--gpu', default='1')
    59	    parser.add_argument('--allow-dirty', action='store_true')
    60	    parser.add_argument('--bind-input', action='append', default=[], metavar='NAME=PATH')
    61	    args = parser.parse_args(argv)
    62	    if args.eval_manifest is not None:
    63	        parser.error('eval-manifest is created by the launcher')
    64	    for key in ('out_dir', 'checkpoint', 'manifest', 'data_root', 'log_dir'):
    65	        setattr(args, key, str(Path(getattr(args, key)).resolve()))
    66	    args.eval_manifest = str(Path(args.out_dir) / 'eval_manifest.json')
    67	    return args
