   499	    draws[BOOT_SEEDS[1]] = compute(BOOT_SEEDS[1])['samples']
   500	    cluster = compute(BOOT_SEEDS[0], rooms)
   501	    convergence = paired_compare.convergence(
   502	        lambda seed: paired_compare.two_sided_interval(draws[seed], COMPANION_ALPHA),
   503	        BOOT_SEEDS[0], BOOT_SEEDS[1], CONVERGENCE_TOL)
   504	    return {'contrast': '{} - {}'.format(x, y), 'metric': metric, 'rho': result['rho'],
   505	            'upper': paired_compare.one_sided_upper(draws[BOOT_SEEDS[0]], SUPERIORITY_ALPHA),
   506	            'alpha': SUPERIORITY_ALPHA, 'companion_alpha': COMPANION_ALPHA,
   507	            'companion_interval': list(paired_compare.two_sided_interval(
