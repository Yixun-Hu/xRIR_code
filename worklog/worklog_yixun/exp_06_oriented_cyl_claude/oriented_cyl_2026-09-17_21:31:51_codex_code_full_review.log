    98	def child_command(args, repo):
    99	    """Serialize only evaluator arguments, retaining empty grids and bool flags."""
   100	    command = [sys.executable, str(Path(repo) / (evaluator.__name__.replace('.', '/') + '.py'))]
   101	    for action in evaluator.build_parser()._actions:
   102	        if action.dest == 'help':
   103	            continue
   104	        value = getattr(args, action.dest)
   105	        if isinstance(value, bool):
   106	            if value:
   107	                command.append(action.option_strings[0])
   108	        else:
   109	            command.append(action.option_strings[0])
   110	            command.extend(str(item) for item in (value if isinstance(value, list) else [value]))
   111	    return command
