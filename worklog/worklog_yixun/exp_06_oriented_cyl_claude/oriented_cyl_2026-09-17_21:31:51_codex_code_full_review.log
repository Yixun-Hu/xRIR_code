   531	def revalidate_inputs(captured):
   532	    """Re-hash every captured identity; publication is refused if one of them moved.
   533	
   534	    The source closure is re-checked by re-hashing the files it names and re-reading the
   535	    git identity - exactly what `_source_record` binds, without a second hermetic import.
   536	    """
