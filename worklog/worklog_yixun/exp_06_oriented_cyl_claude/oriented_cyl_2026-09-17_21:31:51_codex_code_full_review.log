   127	def build_fields(args, command, repo):
   128	    """exp_04's fields, plus this launcher's closure and the exp_06 bindings."""
   129	    inherited, own = split_bindings(args)
   130	    delegate = copy.copy(args)
   131	    delegate.bind_input = inherited
   132	    fields = evaluator.build_fields(delegate, command, repo)
   133	    records, digest = p.closure_record(p.source_closure(WRITER, repo),
   134	                                       fields['reviewed_commit'], repo)
   135	    if not records or any(record['reviewed_blob_sha256'] is None
   136	                          or record['reviewed_blob_sha256'] != record['working_tree_sha256']
   137	                          or record['commits_after_reviewed'] for record in records):
   138	        raise ValueError('writer_exp06 closure differs from reviewed_commit')
   139	    fields['source_closures']['writer_exp06'] = {'files': records, 'sha256': digest}
   140	    for name, binding in sorted(own.items()):
   141	        if name in fields['mutable_inputs']:
   142	            raise ValueError('duplicate mutable input: ' + name)
   143	        fields['mutable_inputs'][name] = binding
   144	    return check_fields(args, fields)
