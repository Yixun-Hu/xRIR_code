   509	            'room_cluster_interval': list(paired_compare.two_sided_interval(
   510	                cluster['samples'], COMPANION_ALPHA)),
   511	            'n_rooms_retained': int(len(set(rooms))), 'n': int(mask.sum()),
   512	            'exclusions': exclusions, 'n_boot': n_boot,
   513	            'bootstrap_seeds': list(BOOT_SEEDS), 'convergence': convergence,
