        cur_delayed_x = apply_delay_device(x[:, i, :], delay_unit[:, i]).unsqueeze(1)
        channel_outputs.append(cur_delayed_x * direct_energy_ratio[:, i:(i + 1)].unsqueeze(2))
    return torch.cat(channel_outputs, dim=1)
