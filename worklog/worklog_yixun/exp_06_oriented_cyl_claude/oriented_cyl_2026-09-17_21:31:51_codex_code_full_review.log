    70	def split_bindings(args):
    71	    """Separate exp_06's bindings from exp_04's, validating and hashing our own.
    72	
    73	    A heading binding must be a record ``tools.exp06_heading`` still validates and whose
    74	    decision is usable; a refused, missing or malformed record is refused here, before
    75	    any directory is created.
    76	    """
    77	    inherited, own, seen = [], {}, set()
    78	    for binding in args.bind_input:
    79	        name, separator, path = binding.partition('=')
    80	        if name not in MUTABLE_INPUTS or not separator or not path or name in seen:
    81	            raise ValueError('invalid or duplicate --bind-input: ' + binding)
    82	        seen.add(name)
    83	        if name not in EXP06_INPUTS:
    84	            inherited.append(binding)
    85	            continue
    86	        resolved = Path(path).resolve()
    87	        try:
    88	            record = exp06_heading.read_heading_json(str(resolved))
    89	        except (OSError, ValueError) as error:
    90	            raise ValueError('unusable heading binding {}: {}'.format(path, error)) from error
    91	        if record['decision'] not in USABLE_HEADINGS:
    92	            raise ValueError('heading binding {} records the decision {!r}'.format(
    93	                path, record['decision']))
    94	        own[name] = {'path': str(resolved), 'sha256': p.sha256_file(resolved)}
    95	    return inherited, own
