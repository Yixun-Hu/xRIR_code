   251	def main(argv=None):
   252	    args = parse_args(argv)
   253	    repo = Path(__file__).resolve().parents[1]
   254	    command = child_command(args, repo)
   255	    completion = launcher.execute_run(args, command, lambda: build_fields(args, command, repo),
