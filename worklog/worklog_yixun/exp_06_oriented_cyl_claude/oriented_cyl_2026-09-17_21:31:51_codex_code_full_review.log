   114	def check_fields(args, fields):
   115	    """The child's own manifest handshake, re-run before execute_run writes the manifest."""
   116	    expected = evaluator.exp06_metadata(args)
   117	    mismatches = [key for key, value in sorted(expected.items())
   118	                  if key not in fields or json.dumps(fields[key], sort_keys=True)
   119	                  != json.dumps(value, sort_keys=True)]
   120	    mismatches += ['source_closures.' + name for name in CLOSURES
   121	                   if name not in fields.get('source_closures', {})]
   122	    if mismatches:
   123	        raise ValueError('inconsistent evaluation fields: ' + ', '.join(sorted(mismatches)))
   124	    return fields
