   485	def contrast_cell(groups, x, y, metric, n_boot=N_BOOT):
   486	    """rho = (mean(x) - mean(y)) / mean(y) on the five-seed means of the shared cohort."""
   487	    a, b = _arrays(groups[x], metric), _arrays(groups[y], metric)
   488	    mask, exclusions = paired_compare.cell_mask(a, e0_b=b, seeds=SEEDS)
   489	    mean_a = paired_compare.five_seed_mean(a)[mask]
   490	    mean_b = paired_compare.five_seed_mean(b)[mask]
   491	    rooms = rooms_from_paths(groups[x][0]['query'])[mask]
   492	
   493	    def compute(seed, clusters=None):
   494	        return paired_compare.rho_bootstrap(mean_a, mean_b, n_boot=n_boot, seed=seed,
   495	                                            clusters=clusters)
   496	
   497	    result = compute(BOOT_SEEDS[0])
