rload=np.load
def nload(path,*a,**kw):
    if isinstance(path,(str,Path)) and virtual(path):
        kw.pop('mmap_mode',None)
        return rload(io.BytesIO(Path(path).read_bytes()),*a,**kw)
    return rload(path,*a,**kw)
np.load=nload
rsave=torch.save
def tsave(obj,path,*a,**kw):
    if isinstance(path,(str,Path)) and virtual(path):
        b=io.BytesIO();rsave(obj,b,*a,**kw);Path(path).write_bytes(b.getvalue());return
    return rsave(obj,path,*a,**kw)
torch.save=tsave
omkdir=os.mkdir
ram_path_mkdir=mkdir
def ram_os_mkdir(path,mode=0o777,*,dir_fd=None):
    if virtual(path):return ram_path_mkdir(Path(path))
    raise PermissionError('review disallows disk mkdir: '+str(path))
os.mkdir=ram_os_mkdir
