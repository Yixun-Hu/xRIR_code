    return root/'job_spec.json'
tp.write_job_spec=job_spec

def guarded_kill(pid,sig):
    if sig!=0: raise AssertionError('signals forbidden')
    if not Path('/proc/'+str(pid)).exists():raise ProcessLookupError(pid)
os.kill=guarded_kill


