    assert exp06_train.parse_args(RECIPE).backbone == 'cylindrical_oriented'
    for argv in (MINIMAL + ['--yaw-aug', '1'], MINIMAL[:1] + ['invented'] + MINIMAL[2:],
                 ['--save-dir', 'd'], MINIMAL + ['--run-type', 'invented']):
