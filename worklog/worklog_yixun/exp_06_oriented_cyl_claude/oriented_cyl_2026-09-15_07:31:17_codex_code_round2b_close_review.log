    95	def job_binding(path):
    96	    """The pre-launch declaration this child runs under (round 2b finding 3).
    97	
    98	    The pipeline writes one job spec per seed before its first child starts and passes it
    99	    to every child, which records its digest and the initialisation it declares. The job
   100	    finalizer then admits only children that recorded the declaration it is given, so an
   101	    arm cannot be assembled from children of another job or another initialisation. A
   102	    child launched by hand records no job identity and is never admissible as part of a job.
   103	    """
   104	    if path is None:
   105	        return {'job_spec_sha256': None, 'job_init': None, 'job_init_sha256': None}
   106	    try:
   107	        spec = json.loads(Path(path).read_text())
   108	    except (OSError, ValueError) as error:
   109	        raise ValueError('unusable job spec {}: {}'.format(path, error)) from error
   110	    if not isinstance(spec, dict):
   111	        raise ValueError('job spec {} is not a record'.format(path))
   112	    init, digest = spec.get('init'), spec.get('init_sha256')
   113	    if not isinstance(init, str) or not init:
   114	        raise ValueError('job spec {} declares no initialisation name'.format(path))
