ROOT = RealPath('/home/yixunhu/codespace/xRIR_code_wt2b')
class MPath(PurePosixPath):
    files = {}
    dirs = {'/', '/mem'}
    def read_bytes(self):
        if str(self) not in self.files: raise FileNotFoundError(str(self))
        return self.files[str(self)]
    def read_text(self, *a, **k): return self.read_bytes().decode()
    def write_bytes(self, b):
        assert str(self.parent) in self.dirs, self.parent
        self.files[str(self)] = bytes(b)
        return len(b)
    def write_text(self, s, *a, **k): return self.write_bytes(s.encode())
    def is_file(self): return str(self) in self.files
    def is_dir(self): return str(self) in self.dirs
    def exists(self): return self.is_file() or self.is_dir()
    def mkdir(self, parents=False, exist_ok=False):
        if self.exists() and not exist_ok: raise FileExistsError(str(self))
        if parents:
            self.dirs.update(str(p) for p in self.parents)
        assert str(self.parent) in self.dirs
        self.dirs.add(str(self))
    def unlink(self, missing_ok=False):
        if not missing_ok and not self.is_file(): raise FileNotFoundError(str(self))
        self.files.pop(str(self), None)
    def resolve(self): return self
    def absolute(self): return self
    def rename(self, target):
        target = MPath(target)
        assert not target.exists(), 'unexpected destination collision: ' + str(target)
        old, new = str(self), str(target)
        for key in list(self.files):
            if key == old or key.startswith(old + '/'): self.files[new + key[len(old):]] = self.files.pop(key)
        for key in list(self.dirs):
            if key == old or key.startswith(old + '/'):
                self.dirs.add(new + key[len(old):]); self.dirs.remove(key)
        return target
    def glob(self, pattern):
        return (MPath(k) for k in sorted(set(self.files) | self.dirs)
                if MPath(k).parent == self and fnmatch.fnmatch(MPath(k).name, pattern))
    def iterdir(self): return self.glob('*')
def reset():
    MPath.files.clear(); MPath.dirs = {'/', '/mem'}
def sha(path): return hashlib.sha256(MPath(path).read_bytes()).hexdigest()
def write_manifest(path, fields):
    path = MPath(path)
    assert not path.exists()
    path.write_text(json.dumps(fields, sort_keys=True, indent=2, allow_nan=False) + '\\n')
    return sha(path)
def write_completion(path, fields):
    MPath(path).write_text(json.dumps(fields, sort_keys=True, indent=2, allow_nan=False) + '\\n')
p = types.SimpleNamespace(sha256_file=sha, write_manifest=write_manifest, write_completion=write_completion)
def load_parts(path, names, ns=None, rev=None, undecorate=False):
    source = (subprocess.check_output(['git','show',rev + ':' + path],cwd=str(ROOT),text=True)
              if rev else (ROOT/path).read_text())
    nodes = [n for n in ast.parse(source).body if isinstance(n,(ast.FunctionDef,ast.ClassDef)) and n.name in names]
    assert {n.name for n in nodes} == set(names), set(names) - {n.name for n in nodes}
    if undecorate:
        for n in nodes: n.decorator_list = []
    ns = {} if ns is None else ns
    exec(compile(ast.Module(body=nodes,type_ignores=[]),str(ROOT/path),'exec'),ns)
    return ns

