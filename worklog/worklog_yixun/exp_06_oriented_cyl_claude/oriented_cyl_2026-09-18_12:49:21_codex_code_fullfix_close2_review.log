@torch.no_grad()
def evaluate(model, loader):
    model.eval()
    tot, n = 0.0, 0
    for batch in loader:
        loss, _, _ = compute_loss(model, batch)
        b = batch[1].shape[0]
        tot += loss.item() * b
        n += b
    model.train()
    return tot / max(n, 1)


