import builtins, io, stat, time, hashlib, json, copy
from unittest.mock import patch
from types import SimpleNamespace
from pathlib import Path
MEM_ROOT='/__exp06_review_memory__'
memory={}
dirs={MEM_ROOT}
orig_open=builtins.open
orig_path_open=Path.open
orig_stat=Path.stat
orig_exists=Path.exists
orig_isfile=Path.is_file
orig_isdir=Path.is_dir
orig_iterdir=Path.iterdir
orig_mkdir=Path.mkdir
orig_unlink=Path.unlink
orig_resolve=Path.resolve
orig_os_exists=os.path.exists
orig_os_isfile=os.path.isfile
orig_os_isdir=os.path.isdir
def norm(p): return os.path.normpath(os.path.abspath(os.fspath(p)))
def virtual(p): return not isinstance(p, int) and norm(p).startswith(MEM_ROOT)
def mkdir_mem(p,*a,**k):
    if not virtual(p): return orig_mkdir(p,*a,**k)
    name=norm(p)
    dirs.update(str(x) for x in [Path(name)]+list(Path(name).parents) if str(x).startswith(MEM_ROOT))
def put(p, raw):
    name=norm(p); mkdir_mem(Path(name).parent); memory[name]=raw
class MemBytes(io.BytesIO):
    def __init__(self,p,data,writable):
        super().__init__(data); self.p=p; self.persist=writable
    def close(self):
        if not self.closed and self.persist: put(self.p,self.getvalue())
        super().close()
    def fileno(self): return -987654
def open_mem(p,mode='r',buffering=-1,encoding=None,errors=None,newline=None,**kw):
    if not virtual(p):
        if any(x in mode for x in 'wax+'): raise AssertionError('disk write prohibited '+str(p))
        return orig_open(p,mode,buffering,encoding,errors,newline,**kw)
    name=norm(p); writable=any(x in mode for x in 'wax+')
    if 'x' in mode and name in memory: raise FileExistsError(name)
    if 'r' in mode and name not in memory: raise FileNotFoundError(name)
    data=memory.get(name,b'') if ('r' in mode or 'a' in mode) else b''
    raw=MemBytes(name,data,writable)
    if 'a' in mode: raw.seek(0,2)
    if 'b' in mode: return raw
    return io.TextIOWrapper(raw,encoding=encoding or 'utf-8',errors=errors,newline=newline)
def stat_mem(p,*a,**k):
    if not virtual(p): return orig_stat(p,*a,**k)
    name=norm(p)
    if name not in memory and name not in dirs: raise FileNotFoundError(name)
    return SimpleNamespace(st_mode=(stat.S_IFREG|0o644) if name in memory else (stat.S_IFDIR|0o755),
          st_size=len(memory.get(name,b'')),st_mtime=1000000000.,st_mtime_ns=1000000000000000000,
          st_ino=abs(hash(name)),st_dev=55,st_ctime_ns=1000000000000000000)
def iterdir_mem(p):
    if not virtual(p): return orig_iterdir(p)
    name=norm(p)
    return iter(Path(x) for x in sorted(set(memory)|dirs) if x "'!=name and str(Path(x).parent)==name)
def unlink_mem(p,*a,**k):
    if not virtual(p): raise AssertionError('"'disk unlink prohibited')
    del memory[norm(p)]
_original_fsync=os.fsync
patches=[
patch('builtins.open',open_mem),
patch('os.path.exists',lambda p: norm(p) in memory or norm(p) in dirs if virtual(p) else orig_os_exists(p)),
patch('os.path.isfile',lambda p: norm(p) in memory if virtual(p) else orig_os_isfile(p)),
patch('os.path.isdir',lambda p: norm(p) in dirs if virtual(p) else orig_os_isdir(p)),
patch.object(Path,'open',open_mem),
patch.object(Path,'mkdir',mkdir_mem),
patch.object(Path,'stat',stat_mem),
patch.object(Path,'exists',lambda p: norm(p) in memory or norm(p) in dirs if virtual(p) else orig_exists(p)),
patch.object(Path,'is_file',lambda p: norm(p) in memory if virtual(p) else orig_isfile(p)),
patch.object(Path,'is_dir',lambda p: norm(p) in dirs if virtual(p) else orig_isdir(p)),
patch.object(Path,'iterdir',iterdir_mem),
patch.object(Path,'unlink',unlink_mem),
patch.object(Path,'resolve',lambda p,*a,**k: Path(norm(p)) if virtual(p) else orig_resolve(p,*a,**k)),
patch('os.fsync',lambda fd: None if fd==-987654 else _original_fsync(fd)),
]
for item in patches: item.start()
base=Path(MEM_ROOT)
def jput(path,value): put(path,json.dumps(value,sort_keys=True).encode())
def refuse(label, fn, substring=None):
    try: fn()
    except ValueError as exc:
        if substring is not None: assert substring in str(exc), (label,str(exc))
        print('REFUSED',label,':',str(exc)[:550],flush=True)
        return str(exc)
    raise AssertionError('ACCEPTED: '+label)

