   591	def load_new_arm(root, arm, init_sha256=None, repo=REPO, approved=None,
   592	                 sensitivity=False):
   593	    """One exp_06 arm: four verified jobs, one closure per role, one heading per room."""
   594	    base = Path(root) / Path(ARMS[arm]['root']).name
   595	    _require(base.is_dir(), 'missing arm directory {}'.format(base))
   596	    jobs, records, children, inputs, recipe = {}, {}, {}, {}, []
