def mkstemp(suffix='',prefix='tmp',dir=None,text=False):
    if not virtual(dir or '/tmp'):raise PermissionError('review disallows disk tempfile')
    path=str(Path(dir)/(prefix+str(next(CLOCK))+suffix))
    MEM[path]=b'';changed(path)
