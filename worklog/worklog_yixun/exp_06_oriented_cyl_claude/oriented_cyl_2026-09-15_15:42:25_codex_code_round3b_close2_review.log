   329	def job_owner(job_dir, record, inputs=None):
   330	    """Finding 6: amendment A3 binds the launcher that owned the job, so the job root's
   331	    own ``launch.pid`` is read and required to be the ``owner_pid`` the completion
   332	    recorded. Liveness is deliberately not checked: a retrospective analysis runs long
   333	    after the launcher exited and a reused pid would prove nothing either way.
   334	    """
   335	    path = Path(job_dir) / 'launch.pid'
   336	    _require(path.is_file(), 'job {} has no launch.pid: amendment A3 binds the launcher '
   337	             'that owned it'.format(job_dir))
   338	    try:
   339	        pid = int(path.read_text().split()[0])
   340	    except (IndexError, ValueError) as error:
   341	        raise ValueError('job {} has an unreadable launch.pid: {}'.format(job_dir, error))
   342	    _require(pid == record['owner_pid'], 'job {} holds launch.pid {}, not the owner_pid {} '
   343	             'its completion bound'.format(job_dir, pid, record['owner_pid']))
   344	    digest = provenance.sha256_file(path)
   345	    if inputs is not None:
   346	        bind(inputs, path, digest)
   347	    return {'path': str(path.resolve()), 'pid': pid, 'sha256': digest}
