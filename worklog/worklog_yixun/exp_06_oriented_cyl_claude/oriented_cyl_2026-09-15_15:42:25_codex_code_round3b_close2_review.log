   292	    _require(path.is_file(), 'job {} has no completion.json'.format(job_dir))
   293	    _require(not (job_dir / 'child_exit.json').exists(),
   294	             'amendment A3: the job root {} carries a child_exit.json'.format(job_dir))
   295	    record = _read_json(path, 'job completion.json', inputs)
   296	    present = [key for key in FORBIDDEN_JOB_FIELDS if key in record]
   297	    _require(not present,
   298	             'amendment A3: a job completion carries no ' + ', '.join(present))
   299	    missing = [key for key in JOB_FIELDS if key not in record]
   300	    _require(not missing, 'job {} completion is incomplete: missing {}'.format(
   301	        job_dir, ', '.join(missing)))
   302	    _require(record['schema_version'] == 1 and record['run_type'] == 'haa_job',
   303	             'job {} records {!r}/{!r}'.format(job_dir, record['schema_version'],
   304	                                               record['run_type']))
   305	    _require(Path(record['run_dir']).resolve() == job_dir.resolve(),
   306	             'job {} claims the run_dir {}'.format(job_dir, record['run_dir']))
   307	    _require(record['expect'] == expect,
   308	             'job {} expects {!r}, not {!r}'.format(job_dir, record['expect'], expect))
   309	    _require(record['diagnostic'] is False and record['admissible_arm'] is True,
   310	             'job {} is not an admissible arm'.format(job_dir))
   311	    _require(record['child_exit'] == 0,
   312	             'job {} was declared with child status {!r}'.format(job_dir, record['child_exit']))
   313	    _require(type(record['owner_pid']) is int and record['owner_pid'] > 0,
   314	             'job {} records no owning launch.pid'.format(job_dir))
