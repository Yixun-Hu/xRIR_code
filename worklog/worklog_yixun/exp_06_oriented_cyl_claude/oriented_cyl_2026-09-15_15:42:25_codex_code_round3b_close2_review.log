   546	    _require(provenance.sha256_file(spec_path) == record['job_spec']['sha256'],
   547	             'the job spec {} is not the bytes job {} bound'.format(spec_path, job_dir))
   548	    spec = finalizer.load_job_spec(str(spec_path), expect)
   549	    if inputs is not None:      # re-hashed, so a spec edited during the load contradicts
   550	        bind(inputs, spec_path)
