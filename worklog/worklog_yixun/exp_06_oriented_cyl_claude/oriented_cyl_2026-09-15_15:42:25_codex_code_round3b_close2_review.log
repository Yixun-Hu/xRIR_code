                epoch, batch_idx * len(data), len(train_loader.dataset),
                100. * batch_idx / len(train_loader), loss.item()))
        total_train_loss += loss.item()
        count_batch += 1
    lr_scheduler.step()
    print("Train Epoch: {}, Avg Train Loss: {}".format(epoch, total_train_loss / count_batch))


