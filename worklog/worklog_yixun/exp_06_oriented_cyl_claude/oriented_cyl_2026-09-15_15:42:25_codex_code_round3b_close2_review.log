   528	def verify_job(job_dir, job, arm, repo=REPO, sensitivity=False, inputs=None):
   529	    """Finding 2: the finalizer's own verifiers, re-run over every child of one job.
   530	
   531	    Nothing here is taken from the completion: the job specification it bound is re-read
