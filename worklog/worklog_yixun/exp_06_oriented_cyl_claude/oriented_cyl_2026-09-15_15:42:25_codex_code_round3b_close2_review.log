    parser.add_argument('--gate-g1')
    parser.add_argument('--json')
    parser.add_argument('--summary')
    parser.add_argument('--n-boot', type=int, default=N_BOOT)
    parser.add_argument('--n-boot-adjusted', type=int, default=N_BOOT_ADJUSTED)
