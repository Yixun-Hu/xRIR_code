    parser = argparse.ArgumentParser(description='exp_06 H3: simulated parity at k = 0.')
    for role in sorted(ROLES):
        parser.add_argument('--runs-' + role.lower(), nargs='+', required=(role != 'B'),
                            help='the five evaluation runs of arm ' + role)

