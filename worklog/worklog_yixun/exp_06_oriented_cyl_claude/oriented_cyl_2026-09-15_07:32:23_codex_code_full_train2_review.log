        --reviewed-commit) COMMIT="${2:-}"; shift 2 ;;
        --attempt-root) ATTEMPT_ROOT="${2:-}"; shift 2 ;;
        --attempt) ATTEMPT="${2:-}"; shift 2 ;;
        --log) LOG="${2:-}"; shift 2 ;;
        --child-exit) CHILD_EXIT="${2:-}"; shift 2 ;;
        --approved) APPROVED="${2:-}"; shift 2 ;;
