GPU=""; COMMIT=""; ATTEMPT_ROOT=ckpt/exp06/pretrain/xRIR_cylor_8_shot
ATTEMPT=""; LOG=""; CHILD_EXIT=""; DRY=0
while [ $# -gt 0 ]; do
    case "$1" in
