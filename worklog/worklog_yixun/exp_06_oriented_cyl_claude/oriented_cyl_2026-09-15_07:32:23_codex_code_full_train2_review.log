    return RUN(command,*a,**kw)
class Scratch:
    def __enter__(self):
        self.path='/__exp06_review_memory__/inventory'; DIRS.add(self.path); return self.path
    def __exit__(self,*args):
        for k in list(OVERLAY):
            if k.startswith(self.path+'/'): del OVERLAY[k]
def reset(changes=None):
    OVERLAY.clear();DIRS.clear()
    for path in (FR,HR,ER,JR): OVERLAY[key(path/'completion.json')]=None
    OVERLAY.update({key(k):v for k,v in (changes or {}).items()})
@contextlib.contextmanager
def overlay():
    with contextlib.ExitStack() as s:
        for c in [patch.object(builtins,'open',op),patch.object(io,'open',op),
                  patch.object(Path,'exists',ex),patch.object(Path,'is_file',isfile),
                  patch.object(Path,'is_dir',isdir),patch.object(Path,'mkdir',mkdir),
                  patch.object(Path,'unlink',unlink),patch.object(Path,'stat',stat),
                  patch.object(torch,'save',save),patch.object(torch,'load',load),
                  patch.object(p,'write_completion',publish),
                  patch.object(p,'write_manifest',lambda path,fields:(publish(path,fields),p.sha256_file(path))[1]),
                  patch.object(tempfile,'TemporaryDirectory',Scratch),
                  patch.object(subprocess,'run',safe_run),patch.object(os,'kill',no_signal)]:
            s.enter_context(c)
        yield
def run(label,kind='full',changes=None,more=None):
    reset(changes)
    d,l,r={'full':(FR,FL,CLONE),'haa_train':(HR,HL,HREPO),'haa_eval':(ER,EL,HREPO),'haa_job':(JR,JL,HREPO)}[kind]
    kw=dict(children=[str(JR/n) for n in f.expected_children('finetune')],expect='finetune',job_spec=JR/'job_spec.json') if kind=='haa_job' else {}
    kw.update(more or {})
    try:
        out=f.finalize(d,kind,l,0,repo=r,**kw)
        print(label,'ACCEPT',out.get('admissible_arm'),flush=True); return out
    except Exception as e:
        print(label,type(e).__name__,str(e)[:240],flush=True); return None





