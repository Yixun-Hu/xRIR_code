def test_invalid_measurements_may_be_fewer_than_the_nonfinite_observations(tmp_path, haa_repo,
                                                                          heading_jsons,
                                                                          data_root):
    """Close-3 finding 2: a NaN the writer did not count is a real measurement it read as
