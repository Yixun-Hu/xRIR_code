    value={name:getattr(base,name) for name in dir(base) if name.startswith('st_')}
    value.update(st_size=len(OVERLAY[k]),st_mtime_ns=int(hashlib.sha256(OVERLAY[k]).hexdigest()[:15],16))
    return types.SimpleNamespace(**value)
