OPEN=builtins.open; IOOPEN=io.open; EXISTS=Path.exists; ISFILE=Path.is_file; ISDIR=Path.is_dir
STAT=Path.stat; TORCH_SAVE=torch.save; TORCH_LOAD=torch.load; RUN=subprocess.run
OVERLAY={}; DIRS=set()
def key(path): return os.path.abspath(path)
class Writer(io.BytesIO):
    def __init__(self,k,data):
        super().__init__(data); self.k=k
    def flush(self): OVERLAY[self.k]=self.getvalue()
    def close(self):
        if not self.closed: self.flush()
        super().close()
def op(path,mode='r',*a,**kw):
    if not isinstance(path,(str,bytes,os.PathLike)):
        return OPEN(path,mode,*a,**kw)
    k=key(path)
    if any(c in mode for c in 'wax+'):
        if 'x' in mode and ex(Path(k)): raise FileExistsError(k)
        data=(OVERLAY[k] if k in OVERLAY else Path(k).read_bytes()) if 'a' in mode and ex(Path(k)) else b''
        raw=Writer(k,data)
        if 'a' in mode: raw.seek(0,2)
        if 'b' in mode: return raw
        return io.TextIOWrapper(raw,encoding=kw.get('encoding') or 'utf-8')
    if k in OVERLAY:
        if OVERLAY[k] is None: raise FileNotFoundError(k)
        return io.BytesIO(OVERLAY[k]) if 'b' in mode else io.StringIO(OVERLAY[k].decode(kw.get('encoding') or 'utf-8'))
    return OPEN(path,mode,*a,**kw)
def ex(path):
    k=key(path)
    return OVERLAY[k] is not None if k in OVERLAY else k in DIRS or EXISTS(path)
def isfile(path):
    k=key(path)
    return OVERLAY[k] is not None if k in OVERLAY else ISFILE(path)
def isdir(path):
    return key(path) in DIRS or ISDIR(path)
def mkdir(path,*a,**kw):
    DIRS.update(key(p) for p in [Path(path),*Path(path).parents])
def unlink(path,*a,**kw): OVERLAY[key(path)]=None
def stat(path,*a,**kw):
    k=key(path)
    if k not in OVERLAY: return STAT(path,*a,**kw)
    if OVERLAY[k] is None: raise FileNotFoundError(k)
    import types
    try: base=STAT(path,*a,**kw)
    except FileNotFoundError: base=os.stat_result((0o100644,0,0,1,0,0,0,0,0,0))
    value={name:getattr(base,name) for name in dir(base) if name.startswith('st_')}
    value.update(st_size=len(OVERLAY[k]),st_mtime_ns=int(hashlib.sha256(OVERLAY[k]).hexdigest()[:15],16))
    return types.SimpleNamespace(**value)
def save(obj,dest,*a,**kw):
    if isinstance(dest,(str,bytes,os.PathLike)):
        b=io.BytesIO(); TORCH_SAVE(obj,b,*a,**kw); OVERLAY[key(dest)]=b.getvalue()
    else: TORCH_SAVE(obj,dest,*a,**kw)
def load(src,*a,**kw):
    if isinstance(src,(str,bytes,os.PathLike)) and key(src) in OVERLAY:
        with op(src,'rb') as b: return TORCH_LOAD(b,*a,**kw)
    return TORCH_LOAD(src,*a,**kw)
def publish(path,fields):
    with op(path,'wb') as out: out.write(json.dumps(fields,sort_keys=True,indent=2,allow_nan=False).encode()+b'\\n')
def no_signal(pid,sig):
    assert sig==0
    if pid<=0: raise AssertionError('invalid pid would address a process group')
    if not EXISTS(Path('/proc')/str(pid)): raise ProcessLookupError()
def safe_run(command,*a,**kw):
    if command[:3]==['git','checkout','--']:
        for rel in command[3:]: OVERLAY.pop(key(Path(kw.get('cwd','.'))/rel),None)
        return subprocess.CompletedProcess(command,0)
    if command and command[0]=='git' and any(c in command for c in ('clone','add','commit','init','reset')):
        raise AssertionError('mutating git command refused')
    return RUN(command,*a,**kw)
class Scratch:
    def __enter__(self):
        self.path='/__exp06_review_memory__/inventory'; DIRS.add(self.path); return self.path
    def __exit__(self,*args):
        for k in list(OVERLAY):
            if k.startswith(self.path+'/'): del OVERLAY[k]
def reset(changes=None):
    OVERLAY.clear();DIRS.clear()
    for path in (FR,HR,ER,JR): OVERLAY[key(path/'completion.json')]=None
    OVERLAY.update({key(k):v for k,v in (changes or {}).items()})
@contextlib.contextmanager
def overlay():
    with contextlib.ExitStack() as s:
        for c in [patch.object(builtins,'open',op),patch.object(io,'open',op),
                  patch.object(Path,'exists',ex),patch.object(Path,'is_file',isfile),
                  patch.object(Path,'is_dir',isdir),patch.object(Path,'mkdir',mkdir),
                  patch.object(Path,'unlink',unlink),patch.object(Path,'stat',stat),
                  patch.object(torch,'save',save),patch.object(torch,'load',load),
                  patch.object(p,'write_completion',publish),
                  patch.object(p,'write_manifest',lambda path,fields:(publish(path,fields),p.sha256_file(path))[1]),
                  patch.object(tempfile,'TemporaryDirectory',Scratch),
                  patch.object(subprocess,'run',safe_run),patch.object(os,'kill',no_signal)]:
            s.enter_context(c)
        yield
def run(label,kind='full',changes=None,more=None):
