          "per_sample_sha256": c.bp.sha(str(run / "per_sample_yaw.json")), "metrics_sha256": c.bp.sha(str(run / "metrics_yaw.json")), "checkpoint": str(ck), "checkpoint_sha256": c.bp.sha(str(ck)),
