            tgt_wav = tgt_wav[:, :self.max_len]
        
        num_ref_sources = self.num_shot
        sel_other_src_indices = np.random.choice([i for i in list(self.train_indices[file_idx]) if i != src_index], num_ref_sources, replace=False)
