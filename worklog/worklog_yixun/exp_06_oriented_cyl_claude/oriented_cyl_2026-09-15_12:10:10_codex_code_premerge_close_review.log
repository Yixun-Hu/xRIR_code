                            np.array([i for i in range(0, 630) if i not in set(to_exclude[1])]),
                            np.array([i for i in range(0, 576) if i not in set(to_exclude[2])])]


        self.source_locs = [np.load(self.metadata_path[k]) for k in range(0, 3)]
        self.rec_locs = [#np.array([2.4542, 2.4981, 1.2654]),
                        np.array([ 2.8377, 10.1228,  1.1539]),
                        np.array([3.5838, 5.7230, 1.2294]),
                        np.array([ 0.6870, 10.2452,  0.5367])]


        self.pano_depth = [np.load(k_pano_depth_path) for k_pano_depth_path in self.pano_depth_paths]
        self.depth_coord = [convert_equirect_to_camera_coord(torch.from_numpy(self.pano_depth[k]), 256, 512) for k in range(3)]
        self.file_list = [glob(self.ir_path[k] + "*.wav") for k in range(3)]
        if self.split == "test":
            self.file_list = [[fp for fp in self.file_list[k] if int(os.path.basename(fp)[:-4]) in set(list(self.test_indices[k]))] for k in range(3)]
        else:
            self.file_list = [[fp for fp in self.file_list[k] if int(os.path.basename(fp)[:-4]) in set(list(self.train_indices[k]))] for k in range(3)]

        self.index_map = []
        for j, li in enumerate(self.file_list):
            cnt = 0
            for ele in li:
                self.index_map.append((ele, j, cnt))
                cnt += 1
        
    def __len__(self):
        return len(self.index_map)
    
    def __getitem__(self, idx):
        file_idx = self.index_map[idx][1]
        sel_ir_idx = self.index_map[idx][2]
        ir_file_path = self.index_map[idx][0]
        src_index = int(os.path.basename(ir_file_path)[:-4])
        listener_pos = self.rec_locs[file_idx].copy()
        source_pos = self.source_locs[file_idx][src_index].copy()
        rand_rotation = 0.
        proj_source_pos = get_3d_point_camera_coord(rand_rotation, listener_pos, source_pos)
        proj_listener_pos = np.array([0., 0., 0.])
        
        depth_coord = self.depth_coord[file_idx]
        
        tgt_wav, rate = torchaudio.load(ir_file_path)
