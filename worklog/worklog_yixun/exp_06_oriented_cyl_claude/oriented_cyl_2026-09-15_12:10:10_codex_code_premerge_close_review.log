        child haa_train "$stage2" "$(child_log "$name" "$tag" "stage2_$room")" \
            "$PYTHON" tools/exp06_haa_finetune.py --backbone "$bb" --init "$root/stage1/best.pth" \
            --rooms "$room" --heading-json-dir "$HEADING_DIR" --save-dir "$stage2" \
