          ]
        self.train_tgt_indices = [ list(np.arange(408)*2), list(np.arange(0, 315) * 2), list(np.arange(288)*2)]
        to_exclude = [list(self.train_indices[k]) + list(self.train_tgt_indices[k]) for k in range(3)]
        self.test_indices = [#np.array([i for i in range(0, 276) if i not in set(to_exclude[0])]),
