"""CPU checks for the exp_06 composed trainer and its execution record."""
import argparse
import hashlib
import json
import sys
from pathlib import Path

import pytest
import torch

import train_xRIR_backbone as trainer
from tools import exp06_train as train


def parsed(*extra):
    return train.build_parser().parse_args(['--backbone', 'simple', '--save-dir', '/unused', *extra])


def test_shared_parser_defaults(monkeypatch):
    parsers = []
    original = argparse.ArgumentParser.parse_args
    def capture(parser, *args, **kwargs):
        parsers.append(parser)
        return original(parser, *args, **kwargs)
    monkeypatch.setattr(argparse.ArgumentParser, 'parse_args', capture)
    monkeypatch.setattr(sys, 'argv', ['trainer', '--backbone', 'simple', '--save-dir', '/unused'])
    trainer.parse_args()
    ours = {a.dest: a for a in train.build_parser()._actions}
    for action in parsers[0]._actions:
        other = ours[action.dest]
        assert (other.default, other.type, other.required, other.option_strings) == (
            action.default, action.type, action.required, action.option_strings)


@pytest.mark.parametrize('argv', [('--yaw-aug', '1'), ('--backbone', 'missing')])
def test_parser_refusals(argv):
    with pytest.raises(SystemExit) as error:
        parsed(*argv)
    assert error.value.code == 2


def test_simple_state_is_bit_identical():
    args = parsed()
    torch.manual_seed(60)
    baseline = trainer.build_model(args).state_dict()
    torch.manual_seed(60)
    actual = train.build_model_exp06(args).state_dict()
    assert actual.keys() == baseline.keys()
    assert all(torch.equal(actual[k], baseline[k]) for k in actual)


def test_non_m_tier_refused():
    with pytest.raises(ValueError, match='vit_'):
        train.build_model_exp06(parsed('--vit-depth', '6'))


def test_registry_digest():
    mapping = {k: v.__module__ + '.' + v.__qualname__ for k, v in train.BACKBONES_EXP06.items()}
    assert train.registry_sha256() == hashlib.sha256(json.dumps(mapping, sort_keys=True).encode()).hexdigest()


