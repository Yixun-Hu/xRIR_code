+def test_heading_git_identity_and_diagnostic(heading_cache, monkeypatch):
+    import tools.exp06_heading as heading
+    from tools.provenance import closure_record, git_state
+    repo = Path(__file__).resolve().parents[1]
+    state = git_state(repo)
+    record = estimate_room_heading(heading_cache)
+    source = record['source_closure']
+    assert source['git'] == state
+    assert source['head_sha256'] == closure_record(source_closure('tools.exp06_heading', repo),
+                                                  state['HEAD'], repo)[1]
+    monkeypatch.setattr(heading, 'git_state', lambda repo: dict(state, dirty=True))
+    dirty = estimate_room_heading(heading_cache)
+    assert dirty['diagnostic'] is True
+    dirty['diagnostic'] = False
+    with pytest.raises(ValueError, match='diagnostic'):
+        write_heading_json(heading_cache / 'bad.json', dirty)
+    for field in ['git', 'head_sha256']:
+        broken = copy.deepcopy(record)
+        del broken['source_closure'][field]
+        with pytest.raises(ValueError):
+            write_heading_json(heading_cache / 'bad.json', broken)
+
+
+@pytest.mark.parametrize('name', ['meta.json', 'xyzs.npy', 'speaker_xyz.npy', 'rirs.npy'])
+def test_heading_input_revalidation(heading_cache, name):
+    from tools.exp06_heading import verify_heading_inputs
+    record = estimate_room_heading(heading_cache)
+    path = heading_cache / 'heading.json'
+    write_heading_json(path, record)
+    assert read_heading_json(path, room_dir=heading_cache) == record
+    with (heading_cache / name).open('ab') as stream:
+        stream.write(b'changed')
+    with pytest.raises(ValueError, match=name):
+        verify_heading_inputs(record, heading_cache)
+    with pytest.raises(ValueError, match=name):
+        read_heading_json(path, room_dir=heading_cache)
+
+
+def test_heading_cli_input_error_writes_nothing(tmp_path):
+    from tools.exp06_heading import main
+    out = tmp_path / 'absent.json'
+    with pytest.raises(SystemExit) as error:
+        main(['--room-dir', str(tmp_path / 'missing'), '--out', str(out)])
+    assert error.value.code == 2 and not out.exists()
