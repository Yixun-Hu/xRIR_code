"""In-process diagnostic runner; usage errors exit 2, exceeded bounds exit 3."""
import argparse
from datetime import datetime, timezone
import importlib
import json
import math
from pathlib import Path
import signal
import sys
import time

import torch

from tools.provenance import git_state, write_manifest

ENTRIES = {'trainer': 'train_xRIR_backbone', 'exp06_train': 'tools.exp06_train',
           'exp06_haa_finetune': 'tools.exp06_haa_finetune',
           'exp06_haa_eval': 'tools.exp06_haa_eval'}
REPO = Path(__file__).resolve().parents[1]


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--entry', choices=sorted(ENTRIES), required=True)
    parser.add_argument('--receipt', type=Path)
    parser.add_argument('--alarm-seconds', type=int, default=300)
    parser.add_argument('--max-gb', type=float, default=3)
    parser.add_argument('argv', nargs=argparse.REMAINDER)
    return parser


def _alarm(signum, frame):
    raise TimeoutError('alarm_seconds exceeded')


def run(entry, argv, alarm_seconds=300, max_gb=3):
    """Restore argv/handler on every exit and retain failure evidence."""
    state, started = git_state(REPO), time.monotonic()
    cuda = torch.cuda.is_available()
    old_argv, previous = sys.argv, signal.signal(signal.SIGALRM, _alarm)
    status, error = 0, None
    try:
        signal.alarm(alarm_seconds)
        if cuda:
            torch.cuda.reset_peak_memory_stats()
        module = importlib.import_module(ENTRIES[entry])
        if entry == 'trainer':
            sys.argv = [module.__name__ if hasattr(module, '__name__') else ENTRIES[entry]] + argv
            result = module.main()
        else:
            result = module.main(argv)
        if isinstance(result, int):
            status = result
        if cuda:
            torch.cuda.synchronize()
    except SystemExit as exc:
        status = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
        error = str(exc)
    except Exception as exc:
        status, error = (3 if isinstance(exc, TimeoutError) else 1), str(exc)
    finally:
        signal.alarm(0)
        signal.signal(signal.SIGALRM, previous)
        sys.argv = old_argv
    peak = torch.cuda.max_memory_allocated() if cuda else 0
    if peak > max_gb * 1024**3:
        status, error = 3, 'max_gb exceeded'
    record = dict(diagnostic=True, entry=entry, argv=argv, wall_s=time.monotonic() - started,
                  peak_bytes=peak, exit_status=status, git_head=state['HEAD'],
                  timestamp=datetime.now(timezone.utc).isoformat())
    if error is not None:
        record['error'] = error
    return record


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.alarm_seconds <= 0 or not math.isfinite(args.max_gb) or args.max_gb <= 0:
        parser.error('alarm_seconds and max_gb must be positive and finite')
    child_argv = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
    record = run(args.entry, child_argv, args.alarm_seconds, args.max_gb)
    print('EXP06_SMOKE ' + json.dumps(record, sort_keys=True, allow_nan=False), flush=True)
    if args.receipt:
        args.receipt.parent.mkdir(parents=True, exist_ok=True)
        write_manifest(args.receipt, record)
    if record['exit_status']:
        raise SystemExit(record['exit_status'])
    return 0


if __name__ == '__main__':
    sys.exit(main())
"""Validate completed exp_06 children; refusals raise ValueError (CLI exit 2)."""
import datetime
import json
import os
from pathlib import Path
import re
import tempfile

from tools import provenance as p

REPO = Path(__file__).resolve().parents[1]
RUN_TYPES = ('full', 'smoke', 'probe', 'haa_train', 'haa_eval', 'haa_job')


def _require(condition, cause):
    if not condition:
        raise ValueError(cause)


def _json(path):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError) as error:
        raise ValueError('{}: {}'.format(path, error)) from error


def _binding(path):
    try:
        path = Path(path).resolve()
        return {'path': str(path), 'sha256': p.sha256_file(path)}
    except (OSError, TypeError) as error:
        raise ValueError('artifact {}: {}'.format(path, error)) from error


def _closed_log(log, child_exit):
    _require(type(child_exit) is int and child_exit == 0, 'child_exit must be 0')
    try:
        lines = Path(log).read_text().splitlines()
        match = re.fullmatch(r'EXP06_CHILD_EXIT (-?\d+) (\S+)', lines[-1] if lines else '')
        _require(match is not None and int(match[1]) == child_exit, 'log marker mismatch')
        datetime.datetime.fromisoformat(match[2].replace('Z', '+00:00'))
    except (OSError, TypeError, ValueError) as error:
        raise ValueError('log marker: {}'.format(error)) from error
    return {'child_exit': child_exit, 'closed_at': match[2], 'log': _binding(log)}


def _publish(path, record):
    payload = json.dumps(record, sort_keys=True, indent=2, allow_nan=False).encode() + b'\n'
    # Hard-link the completed temporary record exclusively; never replace a peer's result.
    with tempfile.TemporaryDirectory(prefix='.exp06-completion-', dir=str(path.parent)) as directory:
        temporary = Path(directory) / 'completion.json'
        p.write_completion(temporary, record)
        try:
            os.link(str(temporary), str(path))
        except FileExistsError:
            _require(path.read_bytes() == payload, 'existing completion differs')


def finalize(run_dir, run_type, log, child_exit, repo=None, receipt=None, children=None, expect=None):
    """Write one deterministic completion only after all required evidence passes."""
    _require(run_type in RUN_TYPES, 'run_type is unknown')
    directory = Path(run_dir).resolve()
    _require(directory.is_dir(), 'run_dir is missing')
    record = {'schema_version': 1, 'run_type': run_type, 'child_exit': child_exit}
    if run_type in ('smoke', 'probe'):
        record.update(diagnostic=True, admissible_arm=False)
        if receipt is not None:
            record['receipt'] = _binding(receipt)
    else:
        record.update(_closed_log(log, child_exit))
        raise ValueError('run_type implementation pending: ' + run_type)
    _publish(directory / 'completion.json', record)
    return record
"""Exp_06 training entry point composing the pinned trainer's numerical helpers.

Shared defaults match train_xRIR_backbone; the launch script supplies the exp_01
recipe. Only the external finalizer may publish completion.json.
"""
import argparse

import train_xRIR_backbone as trainer
from model.xRIR_cyl_oriented import BACKBONES_EXP06, build_xrir_exp06
from tools.exp05_params import TIERS, count_parameters


def build_parser():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--backbone', choices=sorted(BACKBONES_EXP06), required=True)
    parser.add_argument('--save-dir', required=True)
    for name, default in dict(num_shot=8, max_len=9600, decay_epochs=50, epochs=200,
                              batch_size=64, accum_steps=1, num_workers=16, seed=0,
                              yaw_aug_width=512, log_interval=20, save_every=500,
                              epoch_ckpt_every=5, max_train_batches=0,
                              max_test_batches=0, test_subset=0).items():
        parser.add_argument('--' + name.replace('_', '-'), type=int, default=default)
    for name, default in TIERS['M'].items():
        parser.add_argument('--vit-' + name.replace('_', '-'), type=int, default=default)
    for name, default in dict(lr=1e-3, weight_decay=1e-4, lr_gamma=0.1).items():
        parser.add_argument('--' + name.replace('_', '-'), type=float, default=default)
    parser.add_argument('--yaw-aug', type=int, choices=(0,), default=0)
    parser.add_argument('--yaw-aug-seed', type=int, default=None)
    parser.add_argument('--no-save', action='store_true')
    parser.add_argument('--tf32', action='store_true')
    parser.add_argument('--resume', default=None)
    parser.add_argument('--run-type', choices=('full', 'smoke', 'probe'), default='full')
    parser.add_argument('--provenance-out', default=None)
    return parser


def build_model_exp06(args):
    config = {key: getattr(args, 'vit_' + key) for key in TIERS['M']}
    if any(type(config[key]) is not int or config[key] != value for key, value in TIERS['M'].items()):
        raise ValueError('vit_* must match tier M')
    return build_xrir_exp06(args.backbone, args.num_shot, **config)

