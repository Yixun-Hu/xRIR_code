+def test_heading_git_identity_and_diagnostic(heading_cache, monkeypatch):
+    import tools.exp06_heading as heading
+    from tools.provenance import closure_record, git_state
+    repo = Path(__file__).resolve().parents[1]
+    state = git_state(repo)
+    record = estimate_room_heading(heading_cache)
+    source = record['source_closure']
