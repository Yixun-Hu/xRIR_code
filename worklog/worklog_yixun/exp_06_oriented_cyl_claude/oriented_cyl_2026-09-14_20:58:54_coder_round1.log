+
+
+def test_refusal_record_and_override_rescue(heading_cache, tmp_path):
+    # Equal compensated energies erase directional evidence in both windows.
+    rirs = np.load(heading_cache / 'rirs.npy')
+    rirs[:4] /= 10 ** (9 / 20)
