   521	def write_outputs(result, json_path, summary_path, stats=None):
   522	    """Staged publication (finding 12), after a final input recheck (finding 10)."""
   523	    paths = [Path(summary_path), Path(json_path)]
   524	    if len({path.resolve() for path in paths}) != 2 or any(
   525	            os.path.lexists(str(path)) for path in paths):
   526	        raise FileExistsError('output paths must be distinct and absent')
   527	    text = render(result)
   528	    record = dict(result, summary_path=str(paths[0].resolve()),
   529	                  summary_sha256=hashlib.sha256(text.encode()).hexdigest())
   530	    data = (json.dumps(_safe(record), sort_keys=True, indent=2,
   531	                       allow_nan=False) + '\n').encode()
   532	    recheck_inputs(result.get('inputs') or {}, stats)
   533	    created = []
   534	    try:
   535	        for path, payload in zip(paths, (text.encode(), data)):
   536	            path.parent.mkdir(parents=True, exist_ok=True)
   537	            handle, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=str(path.parent))
   538	            try:
   539	                with os.fdopen(handle, 'wb') as stream:
   540	                    provenance.apply_umask(stream.fileno())
   541	                    stream.write(payload)
   542	                    stream.flush()
   543	                    os.fsync(stream.fileno())
   544	                os.link(temporary, str(path))
   545	                created.append(path)
   546	            finally:
   547	                os.unlink(temporary)
   548	    except BaseException:
   549	        for path in created:
   550	            path.unlink()
   551	        raise
   552	    return record, hashlib.sha256(data).hexdigest(), text
