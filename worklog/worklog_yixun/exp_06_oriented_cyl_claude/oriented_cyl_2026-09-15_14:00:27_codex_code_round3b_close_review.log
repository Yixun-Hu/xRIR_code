   178	def verify_legacy_receipt(path, root, approved=None):
   179	    """The receipt is the approved bytes, and every artifact still hashes as enumerated."""
   180	    path = Path(path)
   181	    _require(path.is_file(), 'missing legacy receipt: {}'.format(path))
   182	    digest = provenance.sha256_file(path)
   183	    if approved is not None:
   184	        _require(approved.get('sha256') == digest, 'the legacy receipt {} hashes to {}, not '
   185	                 'the approved {}'.format(path, digest, approved.get('sha256')))
   186	        _require(approved.get('path') and Path(approved['path']).name == path.name,
   187	                 'the legacy receipt path {} is not the approved {}'.format(
   188	                     path, approved.get('path')))
   189	    record = _read_json(path, 'legacy receipt')
   190	    _require(record.get('label') == 'reconstructed',
   191	             'the legacy receipt is labelled {!r}'.format(record.get('label')))
   192	    _require(record.get('schema_version') == 1, 'unknown legacy receipt schema')
   193	    files = record.get('files')
   194	    _require(isinstance(files, list) and files, 'the legacy receipt enumerates nothing')
   195	    _require(_digest(files) == record.get('files_sha256'),
   196	             'the legacy receipt enumeration does not hash to its own files_sha256')
   197	    _require(record.get('arms') == list(LEGACY_ARMS),
   198	             'the legacy receipt declares the arms {!r}, not the registered {}'.format(
   199	                 record.get('arms'), list(LEGACY_ARMS)))
   200	    expected = [item['path'] for item in legacy_receipt_files(root, LEGACY_ARMS)]
   201	    _require([item['path'] for item in files] == expected,
   202	             'the legacy receipt does not enumerate exactly the retained artifacts')
   203	    inputs = {str(path.resolve()): digest}
   204	    for item in files:
   205	        file = Path(root) / item['path']
   206	        actual = provenance.sha256_file(file)
   207	        _require(actual == item['sha256'],
   208	                 'legacy artifact changed since the receipt: ' + item['path'])
   209	        inputs[str(file.resolve())] = actual   # finding 10: hashed as it was consumed
   210	    return dict(record, sha256=digest, inputs=inputs)
