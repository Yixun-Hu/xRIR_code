   547	def void_reasons(rows, treatment, comparator):
   548	    """Section 7's invalidity policy; a void verdict is never replaced by a subset."""
   549	    excess = rows['excluded'][treatment]['queries'] - rows['excluded'][comparator]['queries']
   550	    reasons = []
   551	    if not rows['cohort']:
   552	        reasons.append('no query of the {} test split is finite in every compared '
   553	                       'run'.format(rows['n_test']))
   554	    if excess > VOID_EXCESS_FRACTION * rows['n_test']:
   555	        reasons.append('{} has {} more invalid queries than {}, above the {:.0%} of {} the '
   556	                       'policy allows'.format(treatment, excess, comparator,
   557	                                              VOID_EXCESS_FRACTION, rows['n_test']))
   558	    if rows['cohort'] < VOID_COHORT_FRACTION * rows['n_test']:
   559	        reasons.append('the cohort of {} queries is below {:.0%} of the {} in the test '
   560	                       'split'.format(rows['cohort'], VOID_COHORT_FRACTION, rows['n_test']))
   561	    return reasons
