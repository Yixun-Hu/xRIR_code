   164	    return {'schema_version': 1, 'label': 'reconstructed', 'arms': list(LEGACY_ARMS),
   165	            'root': str(Path(root).resolve()), 'files': files, 'files_sha256': _digest(files),
   166	            'source_closure': source_identity(repo, strict)
