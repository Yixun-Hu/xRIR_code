   417	def verify_job(job_dir, job, arm, repo=REPO):
   418	    """Finding 2: the finalizer's own verifiers, re-run over every child of one job.
   419	
   420	    Nothing here is taken from the completion: the job specification it bound is re-read
   421	    and rehashed, ``verify_child`` re-runs each child's role validator over the directory
   422	    and compares every field of its record with that result, ``job_lineage`` re-derives
   423	    the init -> stage1 -> stage2 -> evaluation chain, and the job's own lineage fields
   424	    must equal what the re-run derived. The frozen protocol and the DiffRIR indices are
   425	    checked on top, because the finalizer knows nothing about exp_02's protocol.
   426	    """
   427	    job_dir, expect = Path(job_dir), EXPECT_OF[job]
   428	    record = job_completion(job_dir, expect, arm)
   429	    spec_path = Path(record['job_spec']['path'])
   430	    _require(spec_path.is_file(), 'missing job spec {}'.format(spec_path))
   431	    _require(provenance.sha256_file(spec_path) == record['job_spec']['sha256'],
   432	             'the job spec {} is not the bytes job {} bound'.format(spec_path, job_dir))
   433	    spec = finalizer.load_job_spec(str(spec_path), expect)
   434	    children, rooms = {}, {}
   435	    for name in sorted(finalizer.expected_children(expect)):
   436	        path, role = job_dir / name, finalizer.child_role(name)
   437	        completion = path / 'completion.json'
   438	        _require(completion.is_file(),
   439	                 'job {} child {} has no completion.json'.format(job_dir, name))
   440	        _require(provenance.sha256_file(completion) == record['children'][name],
   441	                 'job {} child {} is not the completion it bound'.format(job_dir, name))
   442	        evidence = dict(finalizer.verify_child(path, name, repo, spec), role=role)
   443	        bound = _read_json(completion, name + '/completion.json')
   444	        _require(bound.get('admissible_arm') is True,
   445	                 'child {} is not an admissible arm'.format(name))
   446	        args = _read_json(path / 'args.json', name + '/args.json')
   447	        child_protocol(args, name, role)
   448	        if role == 'haa_eval':
   449	            per = child_per_sample(job_dir, name, bound, arm)
   450	            check_test_indices(name, evidence['room'], per['index'])
   451	            _require(finalizer.exp06_recipe.strict_equal(per['meta'].get('heading'),
