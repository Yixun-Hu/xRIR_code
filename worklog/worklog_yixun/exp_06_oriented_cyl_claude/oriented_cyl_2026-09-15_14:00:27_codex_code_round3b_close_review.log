   567	def intervals(rows, alpha, n_boot, seed=BOOT_SEEDS[0]):
   568	    """The paired intervals, or ``None`` when the cohort the policy voided is empty."""
   569	    if not rows['cohort']:
   570	        return None
   571	    return bootstrap.paired_intervals(rows['a'], rows['b'], rows['clusters'], rows['seeds'],
   572	                                      alpha=alpha, n_boot=n_boot, seed=seed)
