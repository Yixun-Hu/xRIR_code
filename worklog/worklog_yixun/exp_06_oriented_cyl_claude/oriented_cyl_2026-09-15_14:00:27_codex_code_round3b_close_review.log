   575	def converged_two_way(rows, alpha, n_boot):
   576	    """The verdict-bearing interval, checked and quadrupled once by exp_06's bootstrap."""
   577	    def factory(size):
   578	        def interval(seed):
   579	            return intervals(rows, alpha, size, seed)['two_way']
   580	        return interval
   581	    return bootstrap.converged_interval(factory, n_boot=n_boot, seed_a=BOOT_SEEDS[0],
   582	                                        seed_b=BOOT_SEEDS[1], tol=CONVERGENCE_TOL)
