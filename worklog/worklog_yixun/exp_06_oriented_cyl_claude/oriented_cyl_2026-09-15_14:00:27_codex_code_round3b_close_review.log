   595	    """A screen, never a parity claim: harm, improvement, or no detected difference."""
   596	    low, high = interval
   597	    if low > 0:
   598	        return 'detected harm'
   599	    if high < 0:
   600	        return 'detected improvement'
   601	    return 'no detected difference'
