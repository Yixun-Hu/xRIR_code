+    assert fields['test_wav_files'] == 1 and fields['test_wav_bytes'] > 0
+    assert fields['test_wav_sha256'] == exp06_finalize.inventory_digest(
+        json.loads((run / 'provenance.json').read_text())['test_wav_identity']['inventory'])
