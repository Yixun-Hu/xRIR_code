   407	def analyse(admitted, margin=MARGIN, n_boot=N_BOOT, exploratory=False):
   408	    """H3 is C vs B; C vs A is the same machinery, reported descriptively.
   409	
   410	    Finding 9: a decision-bearing verdict needs the complete A/B/C run set and an
   411	    admission with no deviations. A partial analysis names H3 `unavailable` and an
   412	    exploratory or unapproved one names it `exploratory`; in both cases every verdict is
   413	    suppressed, so a report can never carry a decision its evidence does not support.
   414	    """
   415	    groups = admitted['groups']
   416	    complete = all(role in groups and len(groups[role]) == len(SEEDS) for role in ROLES)
   417	    drafted = bool(exploratory or admitted['deviations'])
   418	    status = 'unavailable' if not complete else ('exploratory' if drafted else 'available')
   419	    result = {'schema_version': 1, 'exploratory': bool(exploratory), 'margin': margin,
   420	              'seeds': list(SEEDS), 'metrics': list(METRICS), 'split': dict(SPLIT),
   421	              'deviations': list(admitted['deviations']), 'inputs': admitted['inputs'],
   422	              'cells': [], 'verdicts': {}, 'H3': status, 'complete_arms': complete,
   423	              'checkpoints': arm_checkpoints(groups)}
   424	    for x, y in CONTRASTS:
   425	        if x not in groups or y not in groups:
   426	            continue
   427	        cells = [contrast_cell(groups, x, y, metric, n_boot) for metric in METRICS]
   428	        result['cells'].extend(cells)
   429	        bounds = {cell['metric']: cell['upper'] for cell in cells}
   430	        verdict = paired_compare.h1_verdict(bounds['EDT'], bounds['C50'], margin)
   431	        failed = [cell['metric'] for cell in cells if not cell['convergence']['passed']]
   432	        if failed:
   433	            verdict = 'not converged'
   434	        if status != 'available':
   435	            verdict = ('suppressed (draft)' if drafted
   436	                       else 'suppressed (no H3 comparator)')
   437	        result['verdicts']['{} - {}'.format(x, y)] = {
   438	            'verdict': verdict, 'descriptive': (x, y) != CONTRASTS[0],
   439	            'not_converged': failed, 'upper': bounds}
   440	    if not exploratory:
   441	        failed = ['{} {}'.format(cell['contrast'], cell['metric']) for cell in result['cells']
   442	                  if not cell['convergence']['passed']]
   443	        if failed:
   444	            result['deviations'].append('convergence gate failed: ' + ', '.join(failed))
   445	    return result
