   141	def source_identity(repo=REPO, strict=True):
   142	    """This producer's own closure, bound to HEAD; strict refuses an edited working tree."""
   143	    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=str(repo),
   144	                                   text=True).strip()
   145	    records, digest = provenance.closure_record(
   146	        provenance.source_closure(ENTRY_MODULE, repo), head, repo)
   147	    drift = [record['path'] for record in records
   148	             if record['reviewed_blob_sha256'] is None
   149	             or record['reviewed_blob_sha256'] != record['working_tree_sha256']]
   150	    _require(not (strict and drift), 'the producer closure differs from HEAD: '
   151	             + ', '.join(sorted(drift)))
   152	    return {'entry_module': ENTRY_MODULE, 'commit': head, 'sha256': digest,
   153	            'files': records, 'drift': sorted(drift)}
