+    _, receipt = diagnostic_run(run, 'smoke', clone, approvals)
+    record = json.loads(Path(receipt).read_text())
+    if damage == 'runner':
+        record['runner'] = 'tools.exp06_train'
+    elif damage == 'closure':
+        record['runner_closure_sha256'] = 'e' * 64
+    elif damage == 'head':
