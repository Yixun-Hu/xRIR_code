+    outside = tmp_path / 'approved_digests.json'
+    outside.write_bytes(Path(approvals).read_bytes())
+    record = exp06_smoke.diagnostic_provenance(
+        'exp06_train', ['--backbone', 'simple', '--no-save'], 'smoke', Path(clone),
