   585	def verdict_of(convergence, void, margin):
   586	    """pass / fail / void / not_converged, in that order of precedence."""
   587	    if void:
   588	        return 'void'
   589	    if convergence['status'] != 'converged':
   590	        return 'not_converged'
   591	    return 'pass' if convergence['interval'][1] < margin else 'fail'
