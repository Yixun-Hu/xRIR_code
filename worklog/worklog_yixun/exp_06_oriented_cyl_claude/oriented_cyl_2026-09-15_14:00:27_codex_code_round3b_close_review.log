   216	def load_legacy(root, receipt_path=None, approved=None):
   217	    """exp_02's loader and completeness run unchanged over the COMPLETE historical root.
   218	
   219	    The inherited checker expects exp_02's full run set (``released``,
   220	    ``released_repomaps``, ``control``, ``cyl``), so it is given the whole root before
   221	    arms A and B are extracted from it. The root is given exactly as exp_02 gave it --
   222	    repo-relative ``ckpt/sim2real`` -- because that checker compares each stage-2 ``init``
   223	    string against ``<root>/stage1/best.pth``.
   224	    """
   225	    runs = legacy.load_runs(str(root))
   226	    complete, problems = legacy.completeness(runs)
   227	    _require(complete, 'the historical exp_02 root is incomplete: ' + '; '.join(problems))
   228	    receipt = None if receipt_path is None else verify_legacy_receipt(
   229	        receipt_path, root, approved)
   230	    data = {}
   231	    for arm in LEGACY_ARMS:
   232	        init, jobs = ARMS[arm]['legacy_init'], {}
   233	        for kind in ('fine-tuned', 'zero-shot'):
   234	            for run in runs.get((init, kind), []):
   235	                jobs[Path(run['dir']).name] = run['per']
   236	        _require(set(jobs) == set(JOBS), 'the legacy arm {} has the jobs {}, not {}'.format(
   237	            arm, sorted(jobs), sorted(JOBS)))
   238	        for job, rooms in sorted(jobs.items()):
   239	            _require(set(rooms) == set(ROOMS),
   240	                     'the legacy arm {} job {} has the rooms {}'.format(arm, job, sorted(rooms)))
   241	        data[arm] = {'arm': arm, 'branch': 'legacy', 'per': jobs, 'closure': None,
   242	                     'root': str(Path(root) / Path(ARMS[arm]['root']).name)}
   243	    return data, receipt
