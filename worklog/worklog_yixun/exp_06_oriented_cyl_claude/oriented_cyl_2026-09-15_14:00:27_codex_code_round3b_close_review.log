   500	
   501	def assert_pairing(a, b, label):
   502	    """exp_02's own pairing assertions: the same queries, measured the same way."""
   503	    _require(a['index'] == b['index'], 'pair {}: the query indices differ'.format(label))
   504	    _require(a['ir_path'] == b['ir_path'], 'pair {}: the ir_path entries differ'.format(label))
   505	    for key in PAIR_META:
   506	        _require(a['meta'].get(key) == b['meta'].get(key) is not None,
   507	                 'pair {}: {} {!r} != {!r}'.format(label, key, a['meta'].get(key),
