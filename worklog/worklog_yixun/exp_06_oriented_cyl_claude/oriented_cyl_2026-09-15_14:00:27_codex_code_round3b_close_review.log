   847	def _safe(value):
   848	    if isinstance(value, float) and not math.isfinite(value):
   849	        return None
   850	    if isinstance(value, dict):
   851	        return {key: _safe(item) for key, item in value.items()}
   852	    if isinstance(value, (list, tuple)):
   853	        return [_safe(item) for item in value]
   854	    if isinstance(value, (np.integer, np.floating)):
   855	        return _safe(value.item())
   856	    return value
