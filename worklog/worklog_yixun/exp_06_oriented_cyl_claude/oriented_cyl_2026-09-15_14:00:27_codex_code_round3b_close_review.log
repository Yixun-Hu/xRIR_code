   511	def cell_rows(arms, x, y, room, metric):
   512	    """Paired rows pooled over the three fine-tuning seeds, on the shared finite cohort."""
   513	    columns, index = {x: [], y: []}, None
   514	    for seed in SEEDS:
   515	        for arm in (x, y):
   516	            _require(seed in arms[arm]['per'] and room in arms[arm]['per'][seed],
   517	                     'arm {} has no {} of {}'.format(arm, room, seed))
   518	        a, b = arms[x]['per'][seed][room], arms[y]['per'][seed][room]
   519	        assert_pairing(a, b, '{}-{} {} {}'.format(x, y, room, seed))
   520	        index = list(a['index']) if index is None else index
   521	        _require(list(a['index']) == index,
   522	                 'the seeds of {}/{} do not share one query order'.format(room, metric))
   523	        for arm, per in ((x, a), (y, b)):
   524	            columns[arm].append(np.asarray(per[metric], dtype=float))
   525	    stacked = {arm: np.stack(columns[arm]) for arm in (x, y)}
   526	    finite = {arm: np.isfinite(stacked[arm]).all(axis=0) for arm in (x, y)}
   527	    cohort = finite[x] & finite[y]
   528	    # Finding 8: an empty cohort is a diagnosis, not an exception -- the void rule below
   529	    # needs the exclusion counts it would otherwise never reach.
   530	    rows = {arm: np.concatenate([stacked[arm][i][cohort] for i in range(len(SEEDS))])
   531	            for arm in (x, y)}
   532	    queries = np.asarray(index)[cohort]
   533	    return {'a': rows[x], 'b': rows[y],
   534	            'clusters': np.concatenate([queries] * len(SEEDS)),
   535	            'seeds': np.concatenate([np.full(int(cohort.sum()), seed) for seed in SEEDS]),
   536	            'cohort': int(cohort.sum()), 'n_test': len(index),
   537	            'per_seed_diff': {seed: (float((stacked[x][i][cohort]
   538	                                            - stacked[y][i][cohort]).mean())
   539	                                     if cohort.any() else None)
   540	                              for i, seed in enumerate(SEEDS)},
   541	            'excluded': {arm: {'queries': int((~finite[arm]).sum()),
   542	                               'seeds': {seed: int((~np.isfinite(stacked[arm][i])).sum())
   543	                                         for i, seed in enumerate(SEEDS)}}
   544	                         for arm in (x, y)}}
   545	
