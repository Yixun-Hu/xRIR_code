import builtins, io, stat, types, tempfile, itertools
from pathlib import Path
_REAL_OPEN=builtins.open
_MEM={}, {}
MEM, DIRS = _MEM[0], set(['/__review__'])
CLOCK=itertools.count(1)
STAMPS={}
FDS={}
def key(path):
    return os.path.abspath(os.fspath(path))
def virtual(path):
    return not isinstance(path,int) and key(path).startswith('/__review__')
def changed(path):
    STAMPS[path]=next(CLOCK)
def mkdir(path,mode=0o777,parents=False,exist_ok=False):
    p=key(path)
    if p in DIRS:
        if not exist_ok: raise FileExistsError(p)
        return
    parent=os.path.dirname(p)
    if parent not in DIRS:
        if not parents: raise FileNotFoundError(2,'No such RAM path',parent)
        mkdir(parent,parents=True,exist_ok=True)
    DIRS.add(p); changed(p)
class MemBinary(io.BytesIO):
    def __init__(self,path,mode):
        self.path,self.mode=path,mode
        if 'x' in mode and path in MEM: raise FileExistsError(path)
        if not any(c in mode for c in 'wax') and path not in MEM: raise FileNotFoundError(2,'No such RAM path',path)
        self.writes=any(c in mode for c in 'wax+')
        super().__init__(b'' if any(c in mode for c in 'wx') else MEM.get(path,b''))
        if self.writes: MEM[path]=self.getvalue(); changed(path)
        if 'a' in mode:self.seek(0,2)
        self.name=path
    def fileno(self):return -1000
    def write(self,b):
        n=super().write(b)
        MEM[self.path]=self.getvalue(); changed(self.path)
        return n
def opened(path,mode='r',buffering=-1,encoding=None,errors=None,newline=None,**kwargs):
    if str(path)=='/dev/null' and any(c in mode for c in 'wax+'):
        return io.BytesIO() if 'b' in mode else io.StringIO()
    if not virtual(path):
        if any(c in mode for c in 'wax+'):raise PermissionError('review disallows disk writes: '+str(path))
        return _REAL_OPEN(path,mode,buffering,encoding,errors,newline,**kwargs)
    p=key(path)
    if os.path.dirname(p) not in DIRS:raise FileNotFoundError(2,'No such RAM path',os.path.dirname(p))
    b=MemBinary(p,mode)
    return b if 'b' in mode else io.TextIOWrapper(b,encoding=encoding or 'utf-8',errors=errors,newline=newline)
builtins.open=opened;io.open=opened
_orig_stat=Path.stat
def pathstat(path,*a,**kw):
    if not virtual(path):return _orig_stat(path,*a,**kw)
    p=key(path)
    if p not in MEM and p not in DIRS:raise FileNotFoundError(2,'No such RAM path',p)
    stamp=STAMPS.get(p,1)
    return types.SimpleNamespace(st_dev=987,st_ino=hash(p),st_size=len(MEM.get(p,b'')),
            st_mtime_ns=stamp,st_ctime_ns=stamp,st_mtime=float(stamp),st_ctime=float(stamp),
            st_mode=(stat.S_IFDIR if p in DIRS else stat.S_IFREG)|0o644)
Path.stat=pathstat
_orig_mkdir=Path.mkdir
Path.mkdir=lambda self,*a,**kw: mkdir(self,*a,**kw) if virtual(self) else _orig_mkdir(self,*a,**kw)
_orig_iterdir=Path.iterdir
def iterdir(path):
    if not virtual(path):return _orig_iterdir(path)
    p=key(path)
    return iter([Path(n) for n in sorted(set(MEM)|DIRS) if os.path.dirname(n)==p])
Path.iterdir=iterdir
_orig_unlink=os.unlink
def unlink(path,*a,**kw):
    if not virtual(path):raise PermissionError('review disallows unlink: '+str(path))
    p=key(path)
    if p not in MEM:raise FileNotFoundError(2,'No such RAM path',p)
    del MEM[p];changed(p)
os.unlink=unlink
Path.unlink=lambda self,missing_ok=False: None if missing_ok and key(self) not in MEM else unlink(self)
_orig_lexists=os.path.lexists
os.path.lexists=lambda path: (key(path) in MEM or key(path) in DIRS) if virtual(path) else _orig_lexists(path)
def link(src,dst,*a,**kw):
    if not virtual(src) or not virtual(dst):raise PermissionError('review disallows disk link')
    if key(dst) in MEM:raise FileExistsError(key(dst))
    MEM[key(dst)]=MEM[key(src)];changed(key(dst))
os.link=link
def replace(src,dst,*a,**kw):
    if not virtual(src) or not virtual(dst):raise PermissionError('review disallows disk replace')
    MEM[key(dst)]=MEM.pop(key(src));changed(key(dst))
os.replace=replace
_orig_mkstemp=tempfile.mkstemp
def mkstemp(suffix='',prefix='tmp',dir=None,text=False):
    if not virtual(dir or '/tmp'):raise PermissionError('review disallows disk tempfile')
    path=str(Path(dir)/(prefix+str(next(CLOCK))+suffix))
    MEM[path]=b'';changed(path)
    fd=-10000-next(CLOCK);FDS[fd]=path
    return fd,path
tempfile.mkstemp=mkstemp
_orig_fdopen=os.fdopen
os.fdopen=lambda fd,*a,**kw: opened(FDS[fd],*a,**kw) if fd in FDS else _orig_fdopen(fd,*a,**kw)
_orig_fsync=os.fsync
os.fsync=lambda fd: None if fd<0 else _orig_fsync(fd)
_orig_fchmod=os.fchmod
os.fchmod=lambda fd,mode: None if fd<0 else _orig_fchmod(fd,mode)
class RamFactory:
    def mktemp(self,name,numbered=True):
        p=Path('/__review__')/(name+str(next(CLOCK)))
        p.mkdir();return p
RAM=RamFactory()

_orig_osstat=os.stat
os.stat=lambda path,*a,**kw: pathstat(Path(path),*a,**kw) if virtual(path) else _orig_osstat(path,*a,**kw)
_orig_listdir=os.listdir
os.listdir=lambda path: [p.name for p in iterdir(Path(path))] if virtual(path) else _orig_listdir(path)
_orig_scandir=os.scandir
class RamEntry:
    def __init__(self,p):self.path,self.name=str(p),p.name
    def is_dir(self,**kw):return key(self.path) in DIRS
    def is_file(self,**kw):return key(self.path) in MEM
    def is_symlink(self):return False
    def stat(self,**kw):return pathstat(Path(self.path))
    def __fspath__(self):return self.path
class RamScan:
    def __init__(self,p):self.it=iter([RamEntry(n) for n in iterdir(Path(p))])
    def __iter__(self):return self
    def __next__(self):return next(self.it)
    def __enter__(self):return self
    def __exit__(self,*a):pass
    def close(self):pass
os.scandir=lambda path: RamScan(path) if virtual(path) else _orig_scandir(path)


