        return _REAL_OPEN(path,mode,buffering,encoding,errors,newline,**kwargs)
    p=key(path)
    if os.path.dirname(p) not in DIRS:raise FileNotFoundError(2,'No such RAM path',os.path.dirname(p))
    b=MemBinary(p,mode)
    return b if 'b' in mode else io.TextIOWrapper(b,encoding=encoding or 'utf-8',errors=errors,newline=newline)
