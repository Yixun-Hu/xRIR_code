   702	def side_split(arms, cache_root=None, job=ZEROSHOT, inputs=None):
   703	    """Section 7's descriptive table: -y and +y mean error per arm, room and metric."""
   704	    table = {}
   705	    for arm in sorted(arms):
   706	        for room, metric in CELLS:
   707	            per = arms[arm]['per'][job][room]
   708	            labels = np.asarray(side_labels(per, room, cache_root, inputs))
   709	            values = np.asarray(per[metric], dtype=float)
   710	            entry = {}
   711	            for name, sign in (('minus_y', -1), ('plus_y', 1)):
   712	                selected = values[(labels == sign) & np.isfinite(values)]
   713	                entry[name] = float(selected.mean()) if selected.size else None
   714	                entry['n_' + name] = int(selected.size)
   715	            table['{}|{}|{}'.format(arm, room, metric)] = entry
   716	    return {'job': job, 'cells': table}
