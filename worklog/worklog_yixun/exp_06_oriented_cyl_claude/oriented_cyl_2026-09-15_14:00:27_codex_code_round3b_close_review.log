   489	def _safe(value):
   490	    if isinstance(value, float) and not math.isfinite(value):
   491	        return None
   492	    if isinstance(value, dict):
   493	        return {key: _safe(item) for key, item in value.items()}
   494	    if isinstance(value, (list, tuple)):
   495	        return [_safe(item) for item in value]
   496	    if isinstance(value, (np.integer, np.floating, np.bool_)):
   497	        return _safe(value.item())
   498	    return value
