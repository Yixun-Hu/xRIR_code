   210	def load_approved_digests(path=None, module=None, **kwargs):
   211	    """Delegate to the approvals module, then apply round 3b's own schema."""
   212	    module = approvals_module() if module is None else module
   213	    approved, receipt = module.load_approved_digests(path, **kwargs)
   214	    return validate(detach(approved)), receipt
