   175	def validate(value):
   176	    """Return the canonical mapping; unknown keys and malformed leaves are refused."""
   177	    if type(value) is not dict or set(value) != set(SECTIONS) | {'schema_version'}:
   178	        raise ValueError('approved digests: expected schema_version and '
   179	                         + ', '.join(SECTIONS))
   180	    if value['schema_version'] != SCHEMA_VERSION:
   181	        raise ValueError('approved digests: schema_version {!r}'.format(value['schema_version']))
   182	    code = _section(value['code'], 'code', CODE_KEYS, {}, OPTIONAL_CODE_KEYS)
   183	    for key, item in sorted(code.items()):
   184	        if not _hex_or_null(item):
   185	            raise ValueError('approved digests: code.{} is {!r}'.format(key, item))
   186	    reused = _section(value['reused'], 'reused', REUSED_KEYS, REUSED_ALIASES)
   187	    for key in REUSED_DIGESTS:
   188	        if not _hex_or_null(reused[key]):
   189	            raise ValueError('approved digests: reused.{} is {!r}'.format(key, reused[key]))
   190	    reused['legacy_receipt'] = _record(reused['legacy_receipt'], 'reused.legacy_receipt',
   191	                                      {'path': _path_or_null, 'sha256': _hex_or_null})
   192	    artifacts = _section(value['artifacts'], 'artifacts', ARTIFACT_KEYS, ARTIFACT_ALIASES)
   193	    if not _hex_or_null(artifacts['gate_g1_sha256']):
   194	        raise ValueError('approved digests: artifacts.gate_g1_sha256 is {!r}'.format(
   195	            artifacts['gate_g1_sha256']))
   196	    artifacts['epoch_012'] = _record(artifacts['epoch_012'], 'artifacts.epoch_012', LEAF_RULES)
   197	    artifacts['heading'] = _record(artifacts['heading'], 'artifacts.heading',
   198	                                  {room: _hex_or_null for room in ROOMS})
   199	    return {'schema_version': SCHEMA_VERSION, 'code': code, 'reused': reused,
   200	            'artifacts': artifacts}
