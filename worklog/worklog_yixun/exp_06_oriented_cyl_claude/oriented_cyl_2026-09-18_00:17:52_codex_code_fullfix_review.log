   274	def quarantine(run, error):
   275	    """Rename the run aside with the reason it was refused; nothing is ever deleted."""
   276	    run = Path(run)
   277	    target = run.with_name(run.name + '_QUARANTINED_' + error.reason)
   278	    if target.exists():
   279	        target = target.with_name(target.name + '_' + uuid.uuid4().hex)
   280	    run.rename(target)
   281	    p.write_completion(target / 'quarantine.json', {
   282	        'schema_version': 1, 'reason': error.reason, 'detail': error.detail,
   283	        'run_dir': str(run), 'quarantined_dir': str(target),
   284	        'quarantined_at': datetime.datetime.now().astimezone().isoformat()})
   285	    return target
