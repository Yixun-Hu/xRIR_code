     1	"""exp_06's historical-evidence branch for arm B's exp_01 training (plan 6.4, full review F2).
     2	
     3	Arm C's simulated evaluation binds the finalised pretraining attempt -- its
     4	``provenance.json`` and the ``completion.json`` that certified the twelve epochs. Arm B
     5	evaluates the **exp_01** cylindrical checkpoint, whose training predates the exp_06
     6	lifecycle entirely: no ``completion.json`` was ever written for it, and none can be
     7	without rerunning a 31-hour job. Section 6.4 registers one answer for exactly this case --
     8	a ``reconstructed`` receipt, written once, enumerating the retained artefacts byte for
     9	byte -- which is what the historical HAA arms already get from
    10	``tools.exp06_summarize_haa --write-legacy-receipt``. This module is that receipt for a
    11	*training* directory.
    12	
    13	    python tools/exp06_legacy_train_receipt.py --train-dir ckpt/xRIR_cyl_8_shot \
    14	        --checkpoint ckpt/xRIR_cyl_8_shot/epoch_12.pth \
    15	        --out ckpt/exp06/train_receipt_cyl.json
    16	
    17	The writer is gated, not descriptive: the evaluated weights must hash to one of the
    18	**registered** exp_01 arms of ``tools.exp04_profiles`` (so a receipt can never be written
    19	for weights no experiment registered), the checkpoint must be a per-epoch file of the
    20	enumerated directory, ``history.jsonl`` must record exactly the epochs ``args.json``
    21	declares, and the checkpoint's own file name must name the last of them. The receipt is
    22	created exclusively and never replaced.
    23	
    24	``verify`` re-reads it and re-hashes every file it enumerates, so it is evidence only
    25	while those artefacts are unchanged; ``tools.exp06_train_evidence`` is the caller that
    26	binds it to an evaluation.
    27	"""
    28	import argparse
    29	import datetime
    30	import hashlib
    31	import json
    32	import re
    33	from pathlib import Path
    34	
    35	from tools import exp04_profiles
    36	from tools import provenance
    37	
    38	ENTRY_MODULE = 'tools.exp06_legacy_train_receipt'
    39	REPO = Path(__file__).resolve().parents[1]
    40	SCHEMA_VERSION = 1
    41	LABEL = 'reconstructed'
    42	EXPERIMENT = 'exp_01'
    43	# The retained record of an exp_01 training run: the arguments it ran with, the per-epoch
    44	# history the budget is read from, and the run log. All three are required.
    45	REQUIRED_FILES = ('args.json', 'history.jsonl', 'train.log')
    46	# Enumerated when present; exp_01 kept both, but neither is evidence on its own.
    47	OPTIONAL_FILES = ('best.pth', 'last.pth')
    48	EPOCH_FILE = re.compile(r'epoch_(\d+)\.pth\Z')
    49	# The arms exp_04 registers by hash; a receipt is written only for weights among them.
    50	REGISTERED = (exp04_profiles.CONTROL, exp04_profiles.CYL)
    51	
    52	
    53	def _require(ok, cause):
    54	    if not ok:
    55	        raise ValueError(cause)
    56	
    57	
    58	def _digest(value):
    59	    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':'),
    60	                                     allow_nan=False).encode()).hexdigest()
    61	
    62	
    63	def _read_json(path, label):
    64	    try:
    65	        return json.loads(Path(path).read_text())
    66	    except (OSError, ValueError) as error:
    67	        raise ValueError('unreadable {} ({}): {}'.format(label, path, error))
    68	
    69	
    70	def epoch_checkpoints(train_dir):
    71	    """Every ``epoch_NN.pth`` of the directory, ordered by the epoch it records."""
    72	    found = {}
    73	    for path in sorted(Path(train_dir).iterdir()):
    74	        match = EPOCH_FILE.match(path.name)
    75	        if match and path.is_file():
    76	            found.setdefault(int(match.group(1)), []).append(path.name)
    77	    return [name for epoch in sorted(found) for name in sorted(found[epoch])]
    78	
    79	
    80	def history_epochs(path):
    81	    """The epochs ``history.jsonl`` records: exactly ``1..N``, once each, in order."""
    82	    rows = []
    83	    for number, line in enumerate(Path(path).read_text().splitlines(), start=1):
    84	        if not line.strip():
    85	            continue
    86	        try:
    87	            row = json.loads(line)
    88	        except ValueError as error:
    89	            raise ValueError('history.jsonl line {} is not JSON: {}'.format(number, error))
    90	        _require(isinstance(row, dict) and type(row.get('epoch')) is int
    91	                 and not isinstance(row.get('epoch'), bool),
    92	                 'history.jsonl line {} records no integer epoch'.format(number))
    93	        rows.append(row['epoch'])
    94	    _require(rows == list(range(1, len(rows) + 1)),
    95	             'history.jsonl records the epochs {}, not 1..{}'.format(rows, len(rows)))
    96	    return len(rows)
    97	
    98	
    99	def receipt_files(train_dir, checkpoints=None):
   100	    """The receipt's ordered enumeration, relative to the training directory."""
   101	    train_dir = Path(train_dir)
   102	    _require(train_dir.is_dir(), 'no training directory at {}'.format(train_dir))
   103	    names = list(REQUIRED_FILES)
   104	    for name in names:
   105	        _require((train_dir / name).is_file(),
   106	                 'the training directory {} has no {}'.format(train_dir, name))
   107	    names += list(epoch_checkpoints(train_dir) if checkpoints is None else checkpoints)
   108	    names += [name for name in OPTIONAL_FILES if (train_dir / name).is_file()]
   109	    return [{'path': name, 'sha256': provenance.sha256_file(train_dir / name)}
   110	            for name in names]
   111	
   112	
   113	def source_identity(repo=REPO, strict=True):
   114	    """This tool's own closure, bound to HEAD; strict refuses an edited working tree."""
   115	    head = provenance.git_state(repo)['HEAD']
   116	    records, digest = provenance.closure_record(
   117	        provenance.source_closure(ENTRY_MODULE, repo), head, repo)
   118	    drift = sorted(record['path'] for record in records
   119	                   if record['reviewed_blob_sha256'] is None
   120	                   or record['reviewed_blob_sha256'] != record['working_tree_sha256'])
   121	    _require(not (strict and drift),
   122	             'the producer closure differs from HEAD: ' + ', '.join(drift))
   123	    return {'entry_module': ENTRY_MODULE, 'commit': head, 'sha256': digest,
   124	            'files': records, 'drift': drift}
   125	
   126	
   127	def registered_arm(digest, registry=None):
   128	    """The exp_01 arm these weights are, or a refusal naming what was offered."""
   129	    registry = REGISTERED if registry is None else registry
   130	    for arm in registry:
   131	        if arm['sha256'] == digest:
   132	            return {'role': arm['role'], 'backbone': arm['backbone'],
   133	                    'checkpoint': arm['checkpoint'], 'epoch': arm['epoch'],
   134	                    'sha256': arm['sha256']}
   135	    raise ValueError('the checkpoint hashes to {}, which is not a registered exp_01 arm '
   136	                     '({})'.format(digest, ', '.join(sorted(arm['role'] for arm in registry))))
   137	
   138	
   139	def build_receipt(train_dir, checkpoint, repo=REPO, strict=True, registry=None,
   140	                  identity=None):
   141	    """The reconstructed receipt: what the exp_01 training left behind, byte for byte."""
   142	    train_dir = Path(train_dir).resolve()
   143	    checkpoint = Path(checkpoint).resolve()
   144	    _require(checkpoint.is_file(), 'no checkpoint at {}'.format(checkpoint))
   145	    _require(checkpoint.parent == train_dir, 'the checkpoint {} is not in the enumerated '
   146	             'training directory {}'.format(checkpoint, train_dir))
   147	    match = EPOCH_FILE.match(checkpoint.name)
   148	    _require(match is not None, 'the evaluated checkpoint {} is not an epoch_NN.pth of the '
   149	             'training run'.format(checkpoint.name))
   150	    files = receipt_files(train_dir)
   151	    enumerated = {item['path']: item['sha256'] for item in files}
   152	    _require(checkpoint.name in enumerated,
   153	             'the checkpoint {} is not enumerated'.format(checkpoint.name))
   154	    args = _read_json(train_dir / 'args.json', 'args.json')
   155	    _require(isinstance(args, dict), 'args.json is not a record')
   156	    declared = args.get('epochs')
   157	    _require(type(declared) is int and not isinstance(declared, bool) and declared > 0,
   158	             'args.json records no positive integer epochs')
   159	    epochs = history_epochs(train_dir / 'history.jsonl')
   160	    _require(epochs == declared, 'history.jsonl records {} epochs, not the {} of args.json'
   161	             .format(epochs, declared))
   162	    _require(int(match.group(1)) == epochs, 'the evaluated {} is not the last of the {} '
   163	             'epochs the history records'.format(checkpoint.name, epochs))
   164	    arm = registered_arm(enumerated[checkpoint.name], registry)
   165	    _require(args.get('backbone') == arm['backbone'],
   166	             'args.json records the backbone {!r}, not the {!r} of the registered {}'.format(
   167	                 args.get('backbone'), arm['backbone'], arm['role']))
   168	    _require(int(arm['epoch']) == epochs, 'the registered {} is epoch {}, not the {} this '
   169	             'directory trained'.format(arm['role'], arm['epoch'], epochs))
   170	    return {'schema_version': SCHEMA_VERSION, 'label': LABEL, 'experiment': EXPERIMENT,
   171	            'arm': arm['role'], 'backbone': arm['backbone'], 'registered': arm,
   172	            'train_dir': str(train_dir), 'repo': str(Path(repo).resolve()),
   173	            'epochs': epochs,
   174	            'checkpoint': {'path': checkpoint.name, 'epoch': epochs,
   175	                           'sha256': enumerated[checkpoint.name]},
   176	            'args': {'path': 'args.json', 'sha256': enumerated['args.json'],
   177	                     'epochs': declared, 'backbone': args.get('backbone')},
   178	            'files': files, 'files_sha256': _digest(files),
   179	            'git': provenance.git_state(repo),
   180	            'source_closure': source_identity(repo, strict) if identity is None else identity,
   181	            'timestamp': datetime.datetime.now(datetime.timezone.utc).isoformat()}
   182	
   183	
   184	def write_receipt(path, train_dir, checkpoint, repo=REPO, strict=True, registry=None,
   185	                  identity=None):
   186	    """Write once; a receipt is never silently replaced (``write_manifest`` is O_EXCL)."""
   187	    record = build_receipt(train_dir, checkpoint, repo, strict, registry, identity)
   188	    Path(path).parent.mkdir(parents=True, exist_ok=True)
   189	    return record, provenance.write_manifest(path, record)
   190	
   191	
   192	def verify(path, checkpoint_sha256=None, registered_sha256=None, epochs=None,
   193	           hasher=provenance.sha256_file):
   194	    """Re-read the receipt and re-hash every artefact it enumerates.
   195	
   196	    ``hasher(path)`` lets a caller route the reads through its own input binding, so the
   197	    same artefact hashed for several runs is read once and a contradictory second read is
   198	    refused where every other input is.
   199	    """
   200	    path = Path(path)
   201	    _require(path.is_file(), 'missing training receipt: {}'.format(path))
   202	    digest = provenance.sha256_file(path)
   203	    record = _read_json(path, 'training receipt')
   204	    _require(isinstance(record, dict), 'the training receipt is not a record')
   205	    _require(record.get('label') == LABEL,
   206	             'the training receipt is labelled {!r}'.format(record.get('label')))
   207	    _require(record.get('schema_version') == SCHEMA_VERSION,
   208	             'unknown training receipt schema {!r}'.format(record.get('schema_version')))
   209	    _require(record.get('experiment') == EXPERIMENT,
   210	             'the training receipt is not {}\'s'.format(EXPERIMENT))
   211	    files = record.get('files')
   212	    _require(isinstance(files, list) and files, 'the training receipt enumerates nothing')
   213	    _require(_digest(files) == record.get('files_sha256'),
   214	             'the training receipt enumeration does not hash to its own files_sha256')
   215	    checkpoint = record.get('checkpoint')
   216	    _require(isinstance(checkpoint, dict) and isinstance(checkpoint.get('path'), str),
   217	             'the training receipt names no checkpoint')
   218	    root = Path(record.get('train_dir') or '')
   219	    _require(root.is_dir(), 'the receipt\'s training directory {} is gone'.format(root))
   220	    inputs = {str(path.resolve()): digest}
   221	    for item in files:
   222	        _require(isinstance(item, dict) and isinstance(item.get('path'), str),
   223	                 'the training receipt enumerates a malformed entry')
   224	        artefact = root / item['path']
   225	        actual = hasher(str(artefact))
   226	        _require(actual == item['sha256'],
   227	                 'training artefact changed since the receipt: ' + item['path'])
   228	        inputs[str(artefact.resolve())] = actual
   229	    enumerated = {item['path']: item['sha256'] for item in files}
   230	    _require(enumerated.get(checkpoint['path']) == checkpoint.get('sha256'),
   231	             'the receipt checkpoint {} is not the enumerated artefact'.format(
   232	                 checkpoint['path']))
   233	    _require(record.get('epochs') == checkpoint.get('epoch'),
   234	             'the receipt checkpoint is epoch {!r} of a {!r}-epoch run'.format(
   235	                 checkpoint.get('epoch'), record.get('epochs')))
   236	    _require(enumerated.get('args.json') == (record.get('args') or {}).get('sha256'),
   237	             'the receipt args.json is not the enumerated artefact')
   238	    if checkpoint_sha256 is not None:
   239	        _require(checkpoint['sha256'] == checkpoint_sha256, 'the training receipt certifies '
   240	                 '{}, not the evaluated {}'.format(checkpoint['sha256'], checkpoint_sha256))
   241	    if registered_sha256 is not None:
   242	        _require(checkpoint['sha256'] == registered_sha256, 'the training receipt certifies '
   243	                 '{}, not the registered exp_01 {}'.format(checkpoint['sha256'],
   244	                                                           registered_sha256))
   245	    if epochs is not None:
   246	        _require(record['epochs'] == epochs,
   247	                 'the training receipt records {} epochs, not {}'.format(record['epochs'],
   248	                                                                         epochs))
   249	    return dict(record, sha256=digest, path=str(path.resolve()), inputs=inputs)
   250	
   251	
   252	def build_parser():
   253	    parser = argparse.ArgumentParser(
   254	        description='Write the reconstructed training receipt of an exp_01 arm.')
   255	    parser.add_argument('--train-dir', required=True)
   256	    parser.add_argument('--checkpoint', required=True)
   257	    parser.add_argument('--out', required=True)
   258	    parser.add_argument('--allow-dirty', action='store_true',
   259	                        help='record a closure that differs from HEAD (never confirmatory)')
   260	    return parser
   261	
   262	
   263	def main(argv=None):
   264	    args = build_parser().parse_args(argv)
   265	    record, digest = write_receipt(args.out, args.train_dir, args.checkpoint,
   266	                                   strict=not args.allow_dirty)
   267	    print(json.dumps({'receipt': str(Path(args.out).resolve()), 'sha256': digest,
   268	                      'arm': record['arm'], 'epochs': record['epochs'],
   269	                      'checkpoint': record['checkpoint'], 'files': len(record['files'])},
   270	                     sort_keys=True))
   271	    return 0
   272	
   273	
   274	if __name__ == '__main__':
   275	    try:
   276	        raise SystemExit(main())
   277	    except (ValueError, OSError) as error:
   278	        raise SystemExit('refusing: ' + str(error))

