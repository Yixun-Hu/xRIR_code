   255	            payload = json.loads((run / name).read_text())
   256	        except (OSError, ValueError) as error:
   257	            raise OutputMismatch('output_unreadable', '{}: {}'.format(name, error))
   258	        meta = payload.get('meta') if isinstance(payload, dict) else None
   259	        if not isinstance(meta, dict):
