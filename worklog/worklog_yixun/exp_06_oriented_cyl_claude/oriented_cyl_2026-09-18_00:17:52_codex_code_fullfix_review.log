   235	    except (OSError, ValueError) as error:
   236	        raise OutputMismatch('completion_unreadable', 'completion.json: {}'.format(error))
   237	    try:
   238	        matches = isinstance(record, dict) and _same(record, dict(completion))
   239	    except (TypeError, ValueError):
