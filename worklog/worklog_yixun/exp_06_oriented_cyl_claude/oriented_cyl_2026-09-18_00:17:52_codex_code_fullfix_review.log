   213	def _declared(run, completion):
   214	    """The manifest this run was certified against, still the bytes completion bound."""
   215	    path = Path(run) / 'eval_manifest.json'
   216	    try:
   217	        digest = p.sha256_file(path)
   218	        fields = json.loads(path.read_text())
   219	    except (OSError, ValueError) as error:
   220	        raise OutputMismatch('manifest_unreadable', 'eval_manifest.json: {}'.format(error))
   221	    if digest != completion.get('eval_manifest_sha256'):
   222	        raise OutputMismatch('manifest_changed', 'eval_manifest.json hashes to {}, not the {} '
   223	                             'of completion.json'.format(digest, completion.get('eval_manifest_sha256')))
   224	    missing = [key for key in BOUND_META if key not in fields]
   225	    if missing:
   226	        raise OutputMismatch('manifest_incomplete',
   227	                             'eval_manifest.json records no ' + ', '.join(missing))
   228	    return dict({key: fields[key] for key in BOUND_META}, eval_manifest_sha256=digest)
