   261	        for key, value in sorted(expected.items()):
   262	            if key not in meta:
   263	                raise OutputMismatch('output_field_missing',
   264	                                     '{} meta records no {}'.format(name, key))
   265	            if not _same(meta[key], value):
   266	                raise OutputMismatch('output_field_mismatch', '{} meta {} {!r} is not the {!r} '
   267	                                     'of the evaluation manifest'.format(name, key, meta[key], value))
   268	        if p.sha256_file(run / name) != bound.get(name):
   269	            raise OutputMismatch('output_changed',
