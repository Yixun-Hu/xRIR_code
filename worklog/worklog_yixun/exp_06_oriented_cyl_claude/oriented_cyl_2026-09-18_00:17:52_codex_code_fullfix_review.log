   217	def leaf_paths(sections):
   218	    """Expand section names, section.key names and leaf paths into dotted leaf paths."""
   219	    leaves = {'code': ['code.' + key for key in CODE_KEYS],
   220	              'reused': ['reused.' + key for key in REUSED_DIGESTS]
   221	                        + ['reused.legacy_receipt.path', 'reused.legacy_receipt.sha256'],
   222	              'artifacts': ['artifacts.gate_g1_sha256']
   223	                           + ['artifacts.epoch_012.' + key for key in sorted(LEAF_RULES)]
   224	                           + ['artifacts.heading.' + room for room in ROOMS]}
   225	    known = {name: list(items) for name, items in leaves.items()}
   226	    for name, items in leaves.items():
   227	        for item in items:
   228	            known.setdefault(item.rsplit('.', 1)[0], []).append(item)
   229	            known.setdefault(item, [item])
   230	    resolved = []
   231	    for name in sections:
   232	        if name not in known:
   233	            raise ValueError('unknown approvals section: ' + name)
   234	        resolved.extend(item for item in known[name] if item not in resolved)
   235	    return sorted(resolved)
