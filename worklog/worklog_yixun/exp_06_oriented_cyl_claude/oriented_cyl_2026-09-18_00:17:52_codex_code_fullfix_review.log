     1	"""The training run behind an evaluated checkpoint (plan 6.3/6.4, Codex full review F2).
     2	
     3	``tools.exp06_compare`` requires every exp_06-route evaluation to bind ``train_manifest``
     4	and ``train_completion``, and 6.3 promises the launcher validates them. It did not: exp_04's
     5	launcher merely hashes whatever file a ``--bind-input`` names, so any file at all satisfied
     6	the names, and the comparer's own fixture bound an evaluation log to them.
     7	
     8	This module is the semantics, shared by the launcher (before the child runs) and the
     9	comparer (at admission), so one rule decides both:
    10	
    11	* ``arm`` -- the exp_06 pretraining. ``train_completion`` is the finalizer's
    12	  ``completion.json``: ``run_type == 'full'``, ``admissible_arm``, not diagnostic or
    13	  exploratory, twelve epochs, and an ``epoch_012.pth`` artifact whose hash **is** the
    14	  evaluated checkpoint. ``train_manifest`` is that run's ``provenance.json``, the bytes the
    15	  completion bound, recording the same ``run_type`` and the reviewed commit the completion
    16	  was approved at. A ``best.pth`` or any other epoch offered as the checkpoint fails on the
    17	  artifact hash.
    18	* ``baseline`` -- the exp_01 checkpoint. ``train_completion`` is the ``reconstructed``
    19	  receipt of ``tools.exp06_legacy_train_receipt`` and ``train_manifest`` the ``args.json``
    20	  that receipt enumerates: the historical run's own startup record, so the two names keep
    21	  the meaning they have for arm C (what the run declared, and what certified it).
    22	* ``diagnostic`` -- never admissible as an arm, and binds nothing.
    23	"""
    24	import json
    25	from pathlib import Path
    26	
    27	from tools import exp06_legacy_train_receipt as receipt_tool
    28	from tools import provenance
    29	
    30	TRAINING_BINDINGS = ('train_manifest', 'train_completion')
    31	EPOCHS = 12                        # section 5's twelve-epoch contract, shared by both arms
    32	EPOCH_ARTIFACT = 'epoch_012.pth'
    33	FULL_RUN_TYPE = 'full'
    34	ARM_ROUTE, BASELINE_ROUTE = 'exp06_full', 'reconstructed'
    35	ROLES = ('arm', 'baseline', 'diagnostic')
    36	
    37	
    38	def _require(ok, cause):
    39	    if not ok:
    40	        raise ValueError(cause)
    41	
    42	
    43	def _read_json(path, label):
    44	    try:
    45	        value = json.loads(Path(path).read_text())
    46	    except (OSError, ValueError) as error:
    47	        raise ValueError('unreadable {} ({}): {}'.format(label, path, error))
    48	    _require(isinstance(value, dict), '{} ({}) is not a record'.format(label, path))
    49	    return value
    50	
    51	
    52	def _bound(bindings, role):
    53	    """Both names are required, and each must name a readable file."""
    54	    missing = [name for name in TRAINING_BINDINGS if not (bindings or {}).get(name)]
    55	    _require(not missing, 'the {} checkpoint binds its training run: --bind-input {}'.format(
    56	        role, ', '.join('{}=<path>'.format(name) for name in missing)))
    57	    resolved = {}
    58	    for name in TRAINING_BINDINGS:
    59	        path = Path(bindings[name]).resolve()
    60	        _require(path.is_file(), 'the {} binding names no file: {}'.format(name, path))
    61	        resolved[name] = path
    62	    return resolved
    63	
    64	
    65	def check_arm(bindings, checkpoint_sha256, epoch_sha256=None, epochs=EPOCHS,
    66	              hasher=provenance.sha256_file):
    67	    """Arm C: the finalised full pretraining attempt whose twelfth epoch is these weights."""
    68	    paths = _bound(bindings, 'arm')
    69	    completion = _read_json(paths['train_completion'], 'train_completion')
    70	    _require(completion.get('run_type') == FULL_RUN_TYPE,
    71	             'train_completion records run_type {!r}, not {!r}'.format(
    72	                 completion.get('run_type'), FULL_RUN_TYPE))
    73	    _require(completion.get('admissible_arm') is True,
    74	             'train_completion is not admissible as an arm')
    75	    _require(completion.get('diagnostic') is False and completion.get('exploratory') is False,
    76	             'train_completion is a diagnostic or exploratory run')
    77	    _require(completion.get('epochs') == epochs,
    78	             'train_completion records {!r} epochs, not the registered {}'.format(
    79	                 completion.get('epochs'), epochs))
    80	    artifacts = completion.get('artifacts')
    81	    _require(isinstance(artifacts, dict) and EPOCH_ARTIFACT in artifacts,
    82	             'train_completion binds no ' + EPOCH_ARTIFACT)
    83	    _require(artifacts[EPOCH_ARTIFACT] == checkpoint_sha256,
    84	             'the evaluated checkpoint hashes to {}, not the {} of the training run\'s '
    85	             '{}'.format(checkpoint_sha256, artifacts[EPOCH_ARTIFACT], EPOCH_ARTIFACT))
    86	    checkpoint = completion.get('checkpoint')
    87	    _require(isinstance(checkpoint, dict) and checkpoint.get('sha256') == checkpoint_sha256
    88	             and checkpoint.get('path') == EPOCH_ARTIFACT
    89	             and checkpoint.get('epoch') == epochs,
    90	             'train_completion certifies the checkpoint {!r}, not the twelfth epoch these '
    91	             'weights are'.format(checkpoint))
    92	    if epoch_sha256 is not None:
    93	        _require(checkpoint_sha256 == epoch_sha256, 'the evaluated checkpoint is not the '
    94	                 'approved artifacts.epoch_012 {}'.format(epoch_sha256))
    95	    run_dir = Path(completion.get('run_dir') or '')
    96	    _require(paths['train_completion'].parent == run_dir.resolve(),
    97	             'train_completion {} is not the completion of the run directory it names '
    98	             '({})'.format(paths['train_completion'], run_dir))
    99	    _require(paths['train_manifest'] == (run_dir / 'provenance.json').resolve(),
   100	             'train_manifest {} is not the provenance.json of the training run {}'.format(
   101	                 paths['train_manifest'], run_dir))
   102	    digest = hasher(str(paths['train_manifest']))
   103	    _require(digest == artifacts.get('provenance.json'),
   104	             'train_manifest hashes to {}, not the {} the completion bound'.format(
   105	                 digest, artifacts.get('provenance.json')))
   106	    record = _read_json(paths['train_manifest'], 'train_manifest')
   107	    _require(record.get('run_type') == completion['run_type'],
   108	             'train_manifest records run_type {!r}, not the {!r} of the completion'.format(
   109	                 record.get('run_type'), completion['run_type']))
   110	    reviewed = (completion.get('approvals') or {}).get('committed_at')
   111	    _require(isinstance(reviewed, str) and reviewed,
   112	             'train_completion records no approvals commit the training was reviewed at')
   113	    _require(record.get('reviewed_commit') == reviewed,
   114	             'train_manifest was reviewed at {!r}, not the {!r} of the completion'.format(
   115	                 record.get('reviewed_commit'), reviewed))
   116	    return {'route': ARM_ROUTE, 'role': 'arm', 'epochs': epochs, 'run_dir': str(run_dir),
   117	            'reviewed_commit': reviewed, 'checkpoint_sha256': checkpoint_sha256,
   118	            'train_manifest': {'path': str(paths['train_manifest']), 'sha256': digest},
   119	            'train_completion': {'path': str(paths['train_completion']),
   120	                                 'sha256': hasher(str(paths['train_completion']))}}
   121	
   122	
   123	def check_baseline(bindings, checkpoint_sha256, registered_sha256=None, epochs=EPOCHS,
   124	                   hasher=provenance.sha256_file):
   125	    """Arm B: the reconstructed receipt of the exp_01 training, and its own args.json."""
   126	    paths = _bound(bindings, 'baseline')
   127	    record = receipt_tool.verify(paths['train_completion'],
   128	                                 checkpoint_sha256=checkpoint_sha256,
   129	                                 registered_sha256=registered_sha256, epochs=epochs,
   130	                                 hasher=hasher)
   131	    train_dir = Path(record['train_dir'])
   132	    _require(paths['train_manifest'] == (train_dir / 'args.json').resolve(),
   133	             'train_manifest {} is not the args.json the receipt enumerates ({})'.format(
   134	                 paths['train_manifest'], train_dir / 'args.json'))
   135	    digest = hasher(str(paths['train_manifest']))
   136	    _require(digest == record['args']['sha256'],
   137	             'train_manifest hashes to {}, not the {} the receipt enumerates'.format(
   138	                 digest, record['args']['sha256']))
   139	    return {'route': BASELINE_ROUTE, 'role': 'baseline', 'epochs': record['epochs'],
   140	            'run_dir': str(train_dir), 'arm': record['arm'],
   141	            'checkpoint_sha256': record['checkpoint']['sha256'],
   142	            'train_manifest': {'path': str(paths['train_manifest']), 'sha256': digest},
   143	            'train_completion': {'path': record['path'], 'sha256': record['sha256']},
   144	            'inputs': record['inputs']}
