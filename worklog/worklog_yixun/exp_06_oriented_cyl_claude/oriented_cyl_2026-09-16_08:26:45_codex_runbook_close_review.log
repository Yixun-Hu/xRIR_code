   116	    pipe="$attempt/child.pipe"
   117	    rm -f -- "$pipe"
   118	    mkfifo -m 600 -- "$pipe"
   119	    cat >> "$log" < "$pipe" &
   120	    sink=$!
   121	    CHILD_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%S+00:00)"
   122	    nohup setsid "$@" > "$pipe" 2>&1 &
   123	    pid=$!
   124	    printf '%s\n' "$pid" > "$attempt/child.pid"
   125	    wait "$pid" || status=$?
   126	    wait "$sink" || sink_status=$?  # EOF: the child and every descendant closed the write end
   127	    rm -f -- "$pipe"
   128	    CHILD_PID="$pid"
   129	    CHILD_STATUS="$status"
   130	    # Blocker 4: a sink that died on a write error left an incomplete log. Nothing may be
   131	    # published from it -- no end marker, no receipt, no completion.
   132	    if [ "$sink_status" -ne 0 ]; then
   133	        say "SINK_FAILED status=$sink_status log=$log"
   134	        abort "$attempt" "$log" sink_failed
   135	        exit 3
   136	    fi
   137	}
   138	
   139	# close_child <attempt> <log>: append the end marker and bind exactly those bytes.
   140	close_child() {
   141	    say "MARKER EXP06_CHILD_EXIT $CHILD_STATUS <iso> >> $2"
   142	    "$PYTHON" tools/exp06_finalize.py child-exit --run-dir "$1" --log "$2" \
   143	        --child-pid "$CHILD_PID" --status "$CHILD_STATUS" --started-at "$CHILD_STARTED_AT"
   144	}
   145	
   146	# Defaults, so the sourced library (EXP06_LAUNCH_LIB=1) is complete under `set -u`; the
   147	# argument parser below overwrites them for a real launch.
   148	APPROVED="${APPROVED:-$APPROVED_DEFAULT}"
   149	COMMIT="${COMMIT:-}"
   150	EXPLORATORY="${EXPLORATORY:-0}"
   151	
   152	if [ "${EXP06_LAUNCH_LIB:-0}" = 1 ]; then return 0; fi
   153	
   154	MODE="${1:-}"
   155	shift || true
   156	case "$MODE" in smoke|probe|full|finalize) ;; *) usage ;; esac
   157	GPU=""; COMMIT=""; ATTEMPT_ROOT=ckpt/exp06/pretrain/xRIR_cylor_8_shot
   158	ATTEMPT=""; LOG=""; CHILD_EXIT=""; DRY=0
   159	while [ $# -gt 0 ]; do
   160	    case "$1" in
   161	        --gpu) GPU="${2:-}"; shift 2 ;;
   162	        --reviewed-commit) COMMIT="${2:-}"; shift 2 ;;
   163	        --attempt-root) ATTEMPT_ROOT="${2:-}"; shift 2 ;;
   164	        --attempt) ATTEMPT="${2:-}"; shift 2 ;;
   165	        --log) LOG="${2:-}"; shift 2 ;;
   166	        --child-exit) CHILD_EXIT="${2:-}"; shift 2 ;;
   167	        --approved) APPROVED="${2:-}"; shift 2 ;;
   168	        --exploratory) EXPLORATORY=1; shift ;;
   169	        --dry-run) DRY=1; shift ;;
   170	        *) usage ;;
   171	    esac
   172	done
   173	[ -n "$GPU" ] && [ -n "$COMMIT" ] || usage
   174	[ "$MODE" != finalize ] || { [ -n "$ATTEMPT" ] && [ -n "$LOG" ] && [ -n "$CHILD_EXIT" ]; } || usage
   175	
   176	if [ "$DRY" -eq 1 ]; then STAMP='<UTC>'; else STAMP="$(date -u +%Y%m%dT%H%M%S)"; fi
   177	# Recovery finalizes an attempt whose launcher is gone, so it owns no live launch.pid.
   178	if [ "$MODE" = finalize ]; then OWNER=""
   179	elif [ "$DRY" -eq 1 ]; then OWNER='<pid>'
   180	else OWNER="$$"; fi
   181	
   182	say "EXP06_LAUNCH mode=$MODE gpu=$GPU commit=$COMMIT root=$ATTEMPT_ROOT stamp=$STAMP dry_run=$DRY"
   183	say "ENV CUDA_VISIBLE_DEVICES=$GPU PYTHONHASHSEED=0 OMP_NUM_THREADS=8 XRIR_DATA_PATH=$DATA_ROOT"
   184	if [ "$DRY" -eq 0 ] && [ ! -d "$DATA_ROOT" ]; then
   185	    echo "refusing: XRIR_DATA_PATH $DATA_ROOT is not a directory" >&2
   186	    exit 2
   187	fi
   188	export XRIR_DATA_PATH="$DATA_ROOT"
   189	# Review 2 finding 1: --run-type and --exploratory are the wrapper's flags; the exp_06
   190	# child keeps its own copies and defaults to `full`, so a diagnostic must be told what it
   191	# is or its admission guard refuses it at startup. The pinned trainer takes neither, and
   192	# its argv stays exactly what plan section 9 registers.
   193	CHILD_EXPLORATORY=()
   194	[ "$EXPLORATORY" -eq 0 ] || CHILD_EXPLORATORY=(--exploratory)
   195	
   196	case "$MODE" in
   197	full)
   198	    preflight
   199	    attempt="$ATTEMPT_ROOT/attempt_$STAMP"
   200	    log="$RECORD/oriented_cyl_${STAMP}_train_full.log"
   201	    say "MKDIR $attempt"
   202	    say "SINK cat >> $log"
   203	    say "PIDFILE $attempt/launch.pid"
   204	    child=("$PYTHON" tools/exp06_train.py --backbone cylindrical_oriented --save-dir "$attempt"
   205	           --num-shot 8 --max-len 9600 --lr 1e-3 --weight-decay 1e-4 --decay-epochs 3
   206	           --lr-gamma 0.1 --epochs 12 --batch-size 32 --accum-steps 2 --num-workers 12
   207	           --seed 0 --tf32 --log-interval 50 --save-every 500 --epoch-ckpt-every 1
   208	           --run-type full --approved "$APPROVED" --reviewed-commit "$COMMIT")
   209	    say "RUN nohup setsid ${child[*]}"
   210	    if [ "$DRY" -eq 1 ]; then
   211	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   212	        abort "$attempt" "$log" 'child_exit_<code>'
   213	        finalize "$attempt" "$log" '<code>' full
   214	        promote "attempt_$STAMP"
   215	        exit 0
   216	    fi
   217	    mkdir -p -- "$ATTEMPT_ROOT"
   218	    mkdir -- "$attempt"  # exclusive: a repeated stamp must not reuse an attempt
   219	    own_launch "$attempt"
   220	    mkdir -p -- "$RECORD"
   221	    : > "$log"
   222	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   223	    run_child "$attempt" "$log" "${child[@]}"
   224	    close_child "$attempt" "$log"
   225	    status="$CHILD_STATUS"
   226	    if [ "$status" -ne 0 ]; then
   227	        abort "$attempt" "$log" "child_exit_$status"
   228	        exit "$status"
   229	    fi
   230	    if ! finalize "$attempt" "$log" "$status" full; then
   231	        abort "$attempt" "$log" finalize_refused
   232	        exit 2
   233	    fi
   234	    promote "attempt_$STAMP"
   235	    ;;
   236	probe)
   237	    preflight
   238	    # Bounded fit/timing probe (ladder rung 5): the full recipe for 200 batches, nothing saved.
   239	    # The rung-4 ceilings (3 GB / 300 s) do not apply here -- this probe measures the real
   240	    # 32 x 2 footprint on a card the preflight has just found empty.
   241	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   242	    diagnostic probe "$ATTEMPT_ROOT/probe_$STAMP" "$RECORD/oriented_cyl_${STAMP}_probe.log" \
   243	        "$ATTEMPT_ROOT/probe_$STAMP.json" \
   244	        --entry exp06_train --alarm-seconds 2400 --max-gb 46 -- \
   245	        --backbone cylindrical_oriented --save-dir "$ATTEMPT_ROOT/probe_$STAMP" \
   246	        --epochs 1 --max-train-batches 200 --max-test-batches 20 --no-save --run-type probe \
   247	        --batch-size 32 --accum-steps 2 --tf32 --num-workers 12 --decay-epochs 3 \
   248	        --log-interval 50 ${CHILD_EXPLORATORY[@]+"${CHILD_EXPLORATORY[@]}"}
   249	    ;;
   250	smoke)
   251	    preflight
   252	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   253	    # Plan section 9 (a): the trainer and the exp_06 entry on the same bounded argv, TF32 off.
   254	    child=()  # the pinned trainer knows no --run-type; the exp_06 entry must be told
   255	    for entry in trainer exp06_train; do
   256	        name="$entry"
   257	        if [ "$entry" = exp06_train ]; then
   258	            name=exp06_train_t0
   259	            child=(--run-type smoke ${CHILD_EXPLORATORY[@]+"${CHILD_EXPLORATORY[@]}"})
   260	        fi
   261	        diagnostic smoke "$SMOKE_DIR/${name}_$STAMP" \
   262	            "$RECORD/oriented_cyl_${STAMP}_smoke_${name}.log" \
   263	            "$SMOKE_DIR/receipt_${name}_$STAMP.json" \
   264	            --entry "$entry" --alarm-seconds 300 --max-gb 3 -- \
   265	            --backbone simple --save-dir "$SMOKE_DIR/t0" $SMOKE_FLAGS \
   266	            ${child[@]+"${child[@]}"}
   267	    done
   268	    # (b) the oriented backbone on the same budget.
   269	    diagnostic smoke "$SMOKE_DIR/exp06_train_t1_$STAMP" \
   270	        "$RECORD/oriented_cyl_${STAMP}_smoke_exp06_train_t1.log" \
   271	        "$SMOKE_DIR/receipt_exp06_train_t1_$STAMP.json" \
   272	        --entry exp06_train --alarm-seconds 300 --max-gb 3 -- \
   273	        --backbone cylindrical_oriented --save-dir "$SMOKE_DIR/t1" $SMOKE_FLAGS \
   274	        --run-type smoke ${CHILD_EXPLORATORY[@]+"${CHILD_EXPLORATORY[@]}"}
   275	    # (c) the CPU fixture the round-2b HAA smokes load (no child, no log, no completion).
   276	    run "$PYTHON" tools/exp06_smoke.py --make-fixture "$SMOKE_DIR/fixture_cylor.pth"
   277	    ;;
   278	finalize)
   279	    preflight  # recovery is gated by the same reviewed commit, clean tree and live-pid checks
   280	    [ "$DRY" -eq 0 ] || abort "$ATTEMPT" "$LOG" finalize_refused
   281	    if ! finalize "$ATTEMPT" "$LOG" "$CHILD_EXIT" full; then
   282	        abort "$ATTEMPT" "$LOG" finalize_refused
   283	        exit 2
   284	    fi
   285	    promote "$(basename -- "$ATTEMPT")"
   286	    ;;
   287	esac
     1	"""Bounded in-process runner for the GPU smokes of plan v4 section 9 (rung 4, R3.3).
     2	
     3	Runs one named entry point in this process under a wall-clock alarm, reports the peak
     4	CUDA allocation and the wall time on a single ``EXP06_SMOKE`` line, and writes a
     5	``diagnostic`` receipt. The alarm and the memory budget abort with status 3, so a smoke
     6	can never quietly grow past the co-tenant budget agreed with the peer session.
     7	
     8	Budgets are checked before the entry is imported (finite and strictly positive), the
     9	status an entry returns is recorded, and the memory ceiling is enforced *during*
    10	execution by a one-second watchdog as well as retrospectively.
    11	
    12	``--make-fixture`` writes a CPU-initialised ``cylindrical_oriented`` state dict (plus a
    13	sidecar with its hash and the registry digest) for the HAA smokes: the exp_01
    14	checkpoints cannot load into the five-channel patch embedding.
    15	
    16	    python tools/exp06_smoke.py --entry exp06_train -- --backbone simple --no-save ...
    17	    python tools/exp06_smoke.py --make-fixture ckpt/exp06/_smoke/fixture_cylor.pth
    18	
    19	The receipt records a numeric ``exit_status`` (0, the integer an entry returned, 3 for an
    20	alarm or memory abort, 1 for an exception), the reason in ``outcome`` (``ok``, ``failed``,
    21	``aborted_alarm`` or ``aborted_memory``, with the exception type in ``outcome_detail``), and
    22	``aborted_memory`` when the ceiling fired while the entry was still running. It also names
    23	its runner and that runner's closure digest, the run type, the budgets, the wall-clock
    24	window and the peak allocation, so the finalizer can require timing and memory evidence
    25	rather than a bare ``exit_status`` (finding 6). With ``--provenance-out`` the runner writes
    26	a ``provenance.json`` of its own -- closure, orchestration, code digests and approvals --
    27	which the finalizer binds as it binds a full run's, minus the training artefacts.
    28	"""
    29	import argparse
    30	import datetime
    31	import importlib
    32	import json
    33	import math
    34	from pathlib import Path
    35	import signal
    36	import sys
    37	import time
    38	
    39	import torch
    40	
    41	from model.xRIR_cyl_oriented import build_xrir_exp06
    42	from tools import exp06_profiles, exp06_train, provenance
    43	
    44	REPO = Path(__file__).resolve().parents[1]
    45	ENTRIES = {'trainer': 'train_xRIR_backbone', 'exp06_train': 'tools.exp06_train',
    46	           'exp06_haa_finetune': 'tools.exp06_haa_finetune',
    47	           'exp06_haa_eval': 'tools.exp06_haa_eval'}
    48	GIB = 1024 ** 3
    49	RUNNER = 'tools.exp06_smoke'
    50	RUN_TYPES = ('smoke', 'probe')
    51	OUTCOMES = ('ok', 'failed', 'aborted_alarm', 'aborted_memory')
    52	
    53	
    54	class _Timeout(BaseException):
    55	    """Raised inside the entry by SIGALRM; a BaseException so entries cannot swallow it."""
    56	
    57	
    58	class _MemoryExceeded(BaseException):
    59	    """Raised by the watchdog when the peak allocation passes the agreed ceiling."""
    60	
    61	
    62	def check_budget(label, value):
    63	    """Refuse a budget that is not a finite positive number (a 0 alarm disabled the timer)."""
    64	    if isinstance(value, bool) or type(value) not in (int, float) or not math.isfinite(value) or value <= 0:
    65	        raise ValueError('{} must be a finite positive number, not {!r}'.format(label, value))
    66	    return float(value)
    67	
    68	
    69	def peak_bytes():
    70	    """Peak CUDA allocation of this process; 0 where CUDA is unavailable."""
    71	    return int(torch.cuda.max_memory_allocated()) if torch.cuda.is_available() else 0
    72	
    73	
    74	def _invoke(module, entry, argv):
    75	    """The trainer's main takes no arguments; every exp_06 entry takes argv."""
    76	    if entry != 'trainer':
    77	        return module.main(list(argv))
    78	    saved = list(sys.argv)
    79	    sys.argv = [getattr(module, '__file__', 'train_xRIR_backbone.py')] + list(argv)
    80	    try:
    81	        return module.main()
    82	    finally:
    83	        sys.argv = saved
    84	
    85	
    86	def _now():
    87	    return datetime.datetime.now(datetime.timezone.utc).isoformat()
    88	
    89	
    90	def diagnostic_provenance(entry, argv, run_type, repo=REPO, approved=None,
    91	                          reviewed_commit=None, exploratory=False):
    92	    """Finding 6: a diagnostic binds its code the way a full run does, minus the training.
    93	
    94	    The runner, not the entry, is the identity that matters here: ``trainer`` is the
    95	    pinned script, which knows nothing about exp_06 provenance.
    96	    """
    97	    state = provenance.git_state(repo)
    98	    commit = state['HEAD'] if reviewed_commit is None else reviewed_commit
    99	    files, digest = exp06_profiles.closure_of('smoke', repo, commit)
   100	    return dict(repo=str(repo), reviewed_commit=commit, run_type=run_type, entry=entry,
   101	                source_closures={'diagnostic': {'entry_module': RUNNER, 'files': files,
   102	                                                'sha256': digest}},
   103	                orchestration_closures=exp06_train.orchestration_closures(repo, commit),
   104	                code_digests=exp06_profiles.compute_code_digests(
   105	                    repo, commit, keys=exp06_profiles.TRAINING_KEYS),
   106	                approvals=exp06_train.approvals_binding(approved),
   107	                exploratory=bool(exploratory), registry_sha256=exp06_train.registry_sha256(),
   108	                git_state=state, environment=provenance.environment(),
   109	                command=[entry] + list(argv))
   110	
   111	
   112	def _publish(result, started, receipt):
   113	    """One JSON line and, if asked, the receipt; both carry the same record."""
   114	    result['wall_s'] = time.monotonic() - started
   115	    result['peak_bytes'] = peak_bytes()
   116	    result['ended_at'] = _now()
   117	    if result['exit_status'] == 0 and result['peak_bytes'] > result['max_gb'] * GIB:
   118	        result['exit_status'], result['outcome'] = 3, 'aborted_memory'  # retrospective peak
   119	    elif result['exit_status'] == 0 and result['wall_s'] > result['alarm_seconds']:
   120	        # The watchdog ticks once a second, so an entry can return just past the deadline
   121	        # without it firing. Finalisation refuses an `ok` receipt that is over its budget.
   122	        result['exit_status'], result['outcome'] = 3, 'aborted_alarm'
   123	    print('EXP06_SMOKE ' + json.dumps(result, sort_keys=True, allow_nan=False), flush=True)
   124	    if receipt is not None:
   125	        provenance.write_completion(Path(receipt), result)
   126	    return result
   127	
   128	
   129	def run_entry(entry, argv, receipt=None, alarm_seconds=300, max_gb=3.0, run_type='smoke',
   130	              provenance_out=None, approved=None, reviewed_commit=None, exploratory=False):
   131	    """Run one entry in-process; abort with status 3 on the alarm or the memory ceiling.
   132	
   133	    ``exit_status`` is numeric: 0 for a completed entry, the integer an entry returns,
   134	    3 for an alarm or memory abort and 1 for an exception. ``outcome`` names the reason.
   135	    """
   136	    if entry not in ENTRIES:
   137	        raise ValueError('unknown smoke entry {!r}; choose from {}'.format(entry, sorted(ENTRIES)))
   138	    if run_type not in RUN_TYPES:
   139	        raise ValueError('a diagnostic run_type is smoke or probe, not {!r}'.format(run_type))
   140	    alarm_seconds = check_budget('alarm_seconds', alarm_seconds)
   141	    max_gb = check_budget('max_gb', max_gb)
   142	    module = importlib.import_module(ENTRIES[entry])
   143	    record = None
   144	    if provenance_out is not None:
   145	        record = diagnostic_provenance(entry, argv, run_type, REPO, approved,
   146	                                       reviewed_commit, exploratory)
   147	        provenance.write_manifest(Path(provenance_out), record)
   148	    if torch.cuda.is_available():
   149	        torch.cuda.reset_peak_memory_stats()
   150	    result = dict(schema_version=1, diagnostic=True, runner=RUNNER, entry=entry,
   151	                  module=ENTRIES[entry], run_type=run_type, exploratory=bool(exploratory),
   152	                  argv=list(argv), alarm_seconds=alarm_seconds, max_gb=max_gb,
   153	                  entry_status=None, aborted_memory=False, outcome_detail=None,
   154	                  runner_closure_sha256=exp06_profiles.code_digest(
   155	                      'smoke', REPO, provenance.git_state(REPO)['HEAD']
   156	                      if reviewed_commit is None else reviewed_commit),
   157	                  provenance=None if record is None else {
   158	                      'path': str(Path(provenance_out).resolve()),
   159	                      'sha256': provenance.sha256_file(provenance_out)},
   160	                  git_head=provenance.git_state(REPO)['HEAD'],
   161	                  started_at=_now(), ended_at=None,
   162	                  timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())
   163	    started, ceiling = time.monotonic(), max_gb * GIB
   164	    deadline = started + alarm_seconds
   165	
   166	    def watchdog(signum, frame):
   167	        """Enforce the ceiling while the entry runs, then the wall-clock deadline."""
   168	        if peak_bytes() > ceiling:
   169	            raise _MemoryExceeded('smoke exceeded its allocation ceiling')
   170	        if time.monotonic() >= deadline:
   171	            raise _Timeout('smoke exceeded its wall-clock budget')
   172	
   173	    previous = signal.signal(signal.SIGALRM, watchdog)
   174	    tick = min(1.0, alarm_seconds)  # periodic: sub-second alarms still fire on their deadline
   175	    signal.setitimer(signal.ITIMER_REAL, tick, tick)
   176	    try:
   177	        try:
   178	            status = _invoke(module, entry, argv)
   179	            result['entry_status'] = status if type(status) is int else None
   180	            result['exit_status'] = status if type(status) is int else 0
   181	            result['outcome'] = 'failed' if result['exit_status'] else 'ok'
   182	        finally:  # disarm before any handler runs, so nothing fires during publication
   183	            signal.setitimer(signal.ITIMER_REAL, 0)
   184	            signal.signal(signal.SIGALRM, previous)
   185	    except _Timeout:
   186	        result['exit_status'], result['outcome'] = 3, 'aborted_alarm'
   187	    except _MemoryExceeded:
   188	        result['exit_status'], result['outcome'] = 3, 'aborted_memory'
   189	        result['aborted_memory'] = True
   190	    except BaseException as error:
   191	        result['exit_status'], result['outcome'] = 1, 'failed'
   192	        result['outcome_detail'] = 'error: ' + type(error).__name__
   193	        _publish(result, started, receipt)
   194	        raise
   195	    _publish(result, started, receipt)
   196	    if result['exit_status'] != 0:
   197	        raise SystemExit(3)
   198	    return result
   199	
   200	
   201	def make_fixture(path, seed=0):
   202	    """Seeded CPU initialisation of the oriented model, with a hash/registry sidecar."""
   203	    path = Path(path)
   204	    path.parent.mkdir(parents=True, exist_ok=True)
   205	    torch.manual_seed(seed)
   206	    torch.save(build_xrir_exp06('cylindrical_oriented', 8).state_dict(), str(path))
   207	    record = dict(schema_version=1, diagnostic=True, path=str(path.resolve()), seed=seed,
   208	                  backbone='cylindrical_oriented', num_shot=8,
   209	                  sha256=provenance.sha256_file(path),
   210	                  registry_sha256=exp06_train.registry_sha256(),
   211	                  git_head=provenance.git_state(REPO)['HEAD'],
   212	                  timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())
   213	    provenance.write_completion(Path(str(path) + '.json'), record)
   214	    return record
   215	
   216	
   217	def build_parser():
   218	    parser = argparse.ArgumentParser(description='Run one bounded exp_06 smoke in-process.')
   219	    parser.add_argument('--entry', choices=sorted(ENTRIES))
   220	    parser.add_argument('--receipt')
   221	    parser.add_argument('--alarm-seconds', type=float, default=300)
   222	    parser.add_argument('--max-gb', type=float, default=3.0)
   223	    parser.add_argument('--run-type', choices=RUN_TYPES, default='smoke',
   224	                        help='recorded in the receipt and in provenance.json')
   225	    parser.add_argument('--provenance-out', help='where this diagnostic records its bindings')
   226	    parser.add_argument('--approved', help='approved_digests.json the bindings are checked against')
   227	    parser.add_argument('--reviewed-commit', help='the commit the launcher verified HEAD against')
   228	    parser.add_argument('--exploratory', action='store_true',
   229	                        help='the approvals need not admit this diagnostic; recorded as such')
   230	    parser.add_argument('--make-fixture', help='write a seeded CPU fixture instead of running')
   231	    parser.add_argument('--seed', type=int, default=0)
   232	    parser.add_argument('argv', nargs=argparse.REMAINDER, help='after --, the entry\'s own argv')
   233	    return parser
   234	
   235	
   236	def main(argv=None):
   237	    """Exit 0 on a completed smoke; the runner itself raises SystemExit(3) on an abort."""
   238	    parser = build_parser()
   239	    args = parser.parse_args(sys.argv[1:] if argv is None else list(argv))
   240	    child = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
   241	    if args.make_fixture:
   242	        make_fixture(args.make_fixture, args.seed)
   243	        return 0
   244	    if not args.entry:
   245	        parser.error('--entry or --make-fixture is required')
   246	    run_entry(args.entry, child, receipt=args.receipt, alarm_seconds=args.alarm_seconds,
   247	              max_gb=args.max_gb, run_type=args.run_type, provenance_out=args.provenance_out,
   248	              approved=args.approved, reviewed_commit=args.reviewed_commit,
   249	              exploratory=args.exploratory)
   250	    return 0
   251	
   252	
   253	if __name__ == '__main__':
