    reviewed commit is byte-identical to the file read, and publishes that identity.
    """
    binding = {}
    if not exploratory:
        binding = {'repo': str(repo),
                   'commit': provenance.git_state(repo)['HEAD'] if commit is None
                   else commit}
    try:
