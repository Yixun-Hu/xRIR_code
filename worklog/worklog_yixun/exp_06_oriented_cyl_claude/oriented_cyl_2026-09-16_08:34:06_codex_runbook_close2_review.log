    71	# diagnostic <run-type> <run dir> <log> <receipt> <smoke argv...>: a smoke or probe runs
    72	# through the same lifecycle as the confirmatory child -- pid file, drained pipe, end
    73	# marker, child_exit.json -- and is finalized as a never-admissible diagnostic. Review
    74	# finding 5: a failed child or a refused finalisation renames the run and its log
    75	# _ABORTED_<reason> and exits with the child's status, so smoke stops at the first failed
    76	# rung; the completion recording `passed: false` is written first and moves with the run.
    77	diagnostic() {
    78	    local kind="$1" dir="$2" log="$3" receipt="$4"
    79	    shift 4
    80	    local flags=(--receipt "$receipt" --run-type "$kind" --provenance-out "$dir/provenance.json"
    81	                 --approved "$APPROVED" --reviewed-commit "$COMMIT")
    82	    [ "${EXPLORATORY:-0}" -eq 0 ] || flags+=(--exploratory)
    83	    local cmd=("$PYTHON" tools/exp06_smoke.py "${flags[@]}" "$@")
    84	    say "MKDIR $dir"
    85	    say "SINK cat >> $log"
    86	    say "PIDFILE $dir/launch.pid"
    87	    say "RUN nohup setsid ${cmd[*]}"
    88	    if [ "$DRY" -eq 1 ]; then
    89	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
    90	        finalize "$dir" "$log" '<code>' "$kind" "$receipt"
    91	        return 0
    92	    fi
    93	    mkdir -p -- "$(dirname -- "$dir")" "$RECORD"
    94	    mkdir -- "$dir"  # exclusive: a repeated stamp must not reuse a diagnostic run
    95	    own_launch "$dir"
    96	    : > "$log"
    97	    run_child "$dir" "$log" "${cmd[@]}"
    98	    close_child "$dir" "$log"
    99	    if ! finalize "$dir" "$log" "$CHILD_STATUS" "$kind" "$receipt"; then
   100	        abort "$dir" "$log" finalize_refused
   101	        exit 2
   102	    fi
   103	    if [ "$CHILD_STATUS" -ne 0 ]; then
   104	        abort "$dir" "$log" "child_failed_$CHILD_STATUS"
   105	        exit "$CHILD_STATUS"
   106	    fi
   107	}
   108	
   109	# run_child <attempt> <log> <command...>: every byte the child or any descendant writes
   110	# goes through one pipe whose sink appends to the log. Waiting for the sink waits for EOF,
   111	# which arrives only after every process holding the write end has exited -- so nothing can
   112	# append after the end marker. Sets CHILD_PID and CHILD_STATUS.
   113	run_child() {
   114	    local attempt="$1" log="$2" pipe sink pid status=0 sink_status=0
   115	    shift 2
   116	    pipe="$attempt/child.pipe"
   117	    rm -f -- "$pipe"
   118	    mkfifo -m 600 -- "$pipe"
   119	    cat >> "$log" < "$pipe" &
   120	    sink=$!
   121	    CHILD_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%S+00:00)"
   122	    nohup setsid "$@" > "$pipe" 2>&1 &
   123	    pid=$!
   124	    printf '%s\n' "$pid" > "$attempt/child.pid"
   125	    wait "$pid" || status=$?
   126	    wait "$sink" || sink_status=$?  # EOF: the child and every descendant closed the write end
   127	    rm -f -- "$pipe"
   128	    CHILD_PID="$pid"
   129	    CHILD_STATUS="$status"
   130	    # Blocker 4: a sink that died on a write error left an incomplete log. Nothing may be
   131	    # published from it -- no end marker, no receipt, no completion.
   132	    if [ "$sink_status" -ne 0 ]; then
   133	        say "SINK_FAILED status=$sink_status log=$log"
   134	        abort "$attempt" "$log" sink_failed
   135	        exit 3
   136	    fi
   137	}
   138	
   139	# close_child <attempt> <log>: append the end marker and bind exactly those bytes.
   140	close_child() {
   141	    say "MARKER EXP06_CHILD_EXIT $CHILD_STATUS <iso> >> $2"
   142	    "$PYTHON" tools/exp06_finalize.py child-exit --run-dir "$1" --log "$2" \
   143	        --child-pid "$CHILD_PID" --status "$CHILD_STATUS" --started-at "$CHILD_STARTED_AT"
   144	}
