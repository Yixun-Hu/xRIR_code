     1	#!/usr/bin/env bash
     2	# exp_06 launcher (plan v4 sections 5 and 9). Certified invocation for the confirmatory run:
     3	#   nohup setsid tools/exp06_launch.sh full --gpu 1 --reviewed-commit <sha> > <launcher.log> 2>&1 &
     4	# Recovery after a crashed launcher (the child already exited):
     5	#   tools/exp06_launch.sh finalize --gpu 1 --reviewed-commit <sha> \
     6	#       --attempt <dir> --log <child.log> --child-exit <code>
     7	# --dry-run prints every command and path (timestamps as <UTC>) and executes nothing.
     8	# EXP06_LAUNCH_LIB=1 source tools/exp06_launch.sh defines the functions and returns, so the
     9	# child lifecycle (own_launch / run_child / close_child) is exercised by tests without a
    10	# mode. The launcher owns <run dir>/launch.pid and stays alive through draining and
    11	# finalisation; the child gets child.pid. A failed log sink aborts the launch (status 3)
    12	# before any end marker, receipt or completion can exist.
    13	set -euo pipefail
