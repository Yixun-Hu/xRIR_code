import hashlib, json, subprocess
from pathlib import Path
from tools import exp06_profiles as p, provenance as v
repo=Path.cwd()
head=subprocess.check_output(['git','rev-parse','HEAD'], text=True).strip()
approved, identity=p.load_approved_digests(p.APPROVED_DIGESTS_PATH,repo,head)
template,_=p.load_approved_digests(p.TEMPLATE_PATH)
def shape(x):
    return {k: shape(v) for k,v in x.items()} if hasattr(x,'items') else None
assert shape(approved)==shape(template)
print('HEAD',head,'IDENTITY',json.dumps(identity),'SCHEMA_MATCH',True,flush=True)
notes=[]
computed=p.compute_code_digests(repo,head,notes=notes)
assert not notes and set(computed)==set(approved['code'])
assert computed==dict(approved['code'])
print('COMPUTE_CODE_DIGESTS',len(computed),'matched',flush=True)
old=json.loads(subprocess.check_output(['git','show','53307b6:'+p.APPROVED_RELATIVE]))
all_paths=set()
for key,(module,extra) in p.CODE_SPECS.items():
    files=(v.source_closure(module,repo) if module else [])+list(extra)
    rows,digest=v.closure_record(files,head,repo)
    assert digest==computed[key]
    assert all(r['working_tree_sha256']==r['reviewed_blob_sha256'] and not r['commits_after_reviewed'] for r in rows)
    all_paths.update(files)
    prev=old['code'].get(key)
    deltas=[]
    if prev is not None:
        old_rows,old_digest=v.closure_record(files,'53307b6',repo)
        assert old_digest==prev, (key,old_digest,prev)
        deltas=[r['path'] for r in old_rows if r['working_tree_sha256']"'!=r['"'reviewed_blob_sha256']]
    print(json.dumps({'key':key,'sha256':digest,'files':len(rows),'previous':prev,'changed_members':deltas}),flush=True)
print('ALL_UNIQUE_FILES',len(all_paths),'WORKING_EQUALS_HEAD',True,flush=True)
assert p.require(approved,p.TRAINING_KEYS,repo,head)==[]
print('REQUIRE_TRAINING_KEYS',[],flush=True)
def leaves(x):
    if hasattr(x,'values'):
        for y in x.values(): yield from leaves(y)
    else: yield x
assert all(x is None for x in leaves(approved['reused']))
assert all(x is None for x in leaves(approved['artifacts']['epoch_012']))
assert approved['artifacts']['gate_g1'] is None
print('DEFERRED_APPROVALS_ALL_NULL',True,flush=True)
from tools.exp06_heading import read_heading_json, DEFAULT_ROOT
heading_files=v.source_closure('tools.exp06_heading',repo)
old_rows,old_heading=v.closure_record(heading_files,'53307b6',repo)
new_rows,new_heading=v.closure_record(heading_files,head,repo)
assert old_heading==new_heading==approved['code']['heading']
print('HEADING_CLOSURE_UNCHANGED',new_heading,'FILES',heading_files,flush=True)
for room in p.HEADING_ROOMS:
    path=repo/'ckpt/exp06/heading'/(room+'.json')
    record=read_heading_json(path,Path(DEFAULT_ROOT)/room)
    digest=v.sha256_file(path)
    assert digest==approved['artifacts']['heading'][room]
    assert record['admissibility']=='confirmatory'
    assert record['source_closure']['sha256']==record['source_closure']['head_sha256']==new_heading
    assert [(r['path'],r['sha256']) for r in record['source_closure']['files']]==[(r['path'],r['reviewed_blob_sha256']) for r in new_rows]
    print('HEADING',room,json.dumps({'sha256':digest,'phi_deg':record['phi_deg'],'k':record['k'],'decision':record['decision'],'admissibility':record['admissibility'],'git':record['source_closure']['git']}),flush=True)
for module in ('eval_yaw_rotation','train_xRIR_backbone'):
    files=v.source_closure(module,repo)
    current=v.closure_record(files,head,repo)[1]
    older=v.closure_record(files,'53307b6',repo)[1]
    base=v.closure_record(files,'77ef292',repo)[1]
    assert current==older==base
    print('PIN',module,len(files),current,'UNCHANGED_SINCE_77ef292',flush=True)
print('SUCCESS',flush=True)
