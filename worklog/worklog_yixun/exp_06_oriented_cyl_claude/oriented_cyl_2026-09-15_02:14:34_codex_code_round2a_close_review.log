            gts_fullBandAmpEnv = torch.sum(gts[:slice_idx], dim=-3)
    else:
        if dont_collapse_across_freq_dim:
            gts_fullBandAmpEnv = gts
        else:
            gts_fullBandAmpEnv = torch.sum(gts**2, dim=-3)
    power_gts_fullBandAmpEnv = gts_fullBandAmpEnv #** 2
