   818	def main(argv=None):
   819	    """Exit 0 after writing completion.json, 2 on any refusal (nothing written)."""
   820	    argv = list(sys.argv[1:] if argv is None else argv)
   821	    if argv[:1] == ['preflight']:
   822	        return preflight_main(argv[1:])
   823	    if argv[:1] == ['child-exit']:
   824	        return child_exit_main(argv[1:])
   825	    if argv[:1] == ['finalize']:
