   674	def write_completion(path, fields):
   675	    """Publish once; a re-run must produce the same bytes, a different result is refused."""
   676	    payload = json.dumps(fields, sort_keys=True, indent=2, allow_nan=False).encode() + b'\n'
   677	    if Path(path).exists():
   678	        _require(Path(path).read_bytes() == payload,
   679	                 'completion.json already exists and differs from this result')
   680	        return fields
   681	    provenance.write_completion(path, fields)
   682	    return fields
