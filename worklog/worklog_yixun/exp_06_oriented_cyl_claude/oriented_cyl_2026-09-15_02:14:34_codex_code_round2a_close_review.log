    68	    say "PIDFILE $dir/launch.pid"
    69	    say "RUN nohup setsid ${cmd[*]}"
    70	    if [ "$DRY" -eq 1 ]; then
    71	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
    72	        finalize "$dir" "$log" '<code>' "$kind" "$receipt"
