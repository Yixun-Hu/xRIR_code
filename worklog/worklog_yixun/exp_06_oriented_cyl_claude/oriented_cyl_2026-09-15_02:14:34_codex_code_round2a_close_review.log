   415	def _heading_binding(args, rooms, frame, repo):
   416	    """Every room's binding names a heading JSON, and must agree with it in full."""
   417	    if frame != 'heading':
   418	        _require(not args.get('heading'), 'the room frame must not record a heading')
   419	        return None
   420	    heading = args.get('heading')
   421	    _require(isinstance(heading, dict) and set(rooms) <= set(heading),
   422	             'the heading frame requires a heading record for every room')
   423	    bound = {}
   424	    for room in rooms:
   425	        entry = heading[room]
   426	        _require(isinstance(entry, dict), 'heading binding for {} is not a record'.format(room))
   427	        phi = _finite('heading binding for {}: phi_deg'.format(room), entry.get('phi_deg'))
   428	        k = entry.get('k')
   429	        _require(type(k) is int and 0 <= k < WIDTH,
   430	                 'heading binding for {}: k {!r} is not a column in [0, {})'.format(room, k, WIDTH))
   431	        _require(k == exp06_heading.heading_roll_k(phi),
   432	                 'heading binding for {}: k {} is not the roll of {} degrees'.format(room, k, phi))
   433	        _require(entry.get('decision') in HEADING_DECISIONS,
   434	                 'heading binding for {} must be estimated or override, not {!r}'.format(
   435	                     room, entry.get('decision')))
   436	        _require(_is_sha256(entry.get('sha256')),
   437	                 'heading binding for {} records no sha256'.format(room))
   438	        path = entry.get('path')
   439	        _require(isinstance(path, str) and path,
   440	                 'heading binding for {} records no json path'.format(room))
   441	        resolved = _resolve(path, repo)
   442	        _require(resolved.is_file(), 'missing heading json for {}: {}'.format(room, resolved))
   443	        _require(provenance.sha256_file(resolved) == entry['sha256'],
   444	                 'heading json for {} does not hash to the recorded sha256'.format(room))
   445	        try:
   446	            record = exp06_heading.read_heading_json(str(resolved))
   447	        except (OSError, ValueError) as error:
   448	            raise ValueError('invalid heading json for {}: {}'.format(room, error)) from error
   449	        _require(record['room'] == room and record['k'] == k and record['phi_deg'] == phi
   450	                 and record['decision'] == entry['decision'],
   451	                 'heading json for {} disagrees with the recorded binding'.format(room))
   452	        bound[room] = dict(entry)
   453	    return bound
