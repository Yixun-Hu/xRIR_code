   770	def preflight(mode, gpu, reviewed_commit, attempt_root=None, repo=REPO):
   771	    """Gate a launch: reviewed commit, clean tree, no live launch, and a free card."""
   772	    _require(mode in LAUNCH_MODES, 'unknown launch mode: {!r}'.format(mode))
   773	    state = provenance.checked_git_state(repo, confirmatory=True)
   774	    _require(state['HEAD'] == reviewed_commit,
   775	             'HEAD {} is not the reviewed commit {!r} (full 40-hex sha required)'.format(
   776	                 state['HEAD'], reviewed_commit))
   777	    running = live_launches(attempt_root) if attempt_root and Path(attempt_root).is_dir() else []
   778	    _require(not running, 'another exp_06 launch is alive: {}'.format(running))
   779	    apps = gpu_compute_apps(gpu) if mode in EXCLUSIVE_GPU_MODES else None
   780	    _require(not apps, 'GPU {} is busy with compute apps {}'.format(gpu, apps))
   781	    return dict(mode=mode, gpu=gpu, reviewed_commit=reviewed_commit, git_state=state,
   782	                attempt_root=str(attempt_root) if attempt_root else None,
   783	                gpu_compute_apps=apps, live_launches=running)
