   351	def diagnostic_evidence(run_dir, receipt, child_exit):
   352	    """A smoke or probe proves nothing about an arm, but must produce a valid receipt.
   353	
   354	    Validity is the receipt's own shape (diagnostic, an integer status, a ``--no-save``
   355	    argv); ``passed`` then reports whether that diagnostic actually succeeded. A failed
   356	    diagnostic is still recorded -- it is simply never ``admissible_arm``.
   357	    """
   358	    _require(receipt is not None, 'a diagnostic run needs its --receipt')
   359	    path = Path(receipt)
   360	    _require(path.is_file(), 'missing smoke receipt: {}'.format(receipt))
   361	    record = _read_json(path, 'smoke receipt')
   362	    _require(record.get('diagnostic') is True, 'the smoke receipt is not marked diagnostic')
   363	    argv = record.get('argv')
   364	    _require(isinstance(argv, list) and '--no-save' in argv,
   365	             'a diagnostic must run with --no-save; its receipt records argv {!r}'.format(argv))
   366	    status = record.get('exit_status')
   367	    _require(type(status) is int, 'the smoke receipt records exit_status {!r}'.format(status))
   368	    return dict(artifacts={}, passed=status == 0 and child_exit == 0,
   369	                receipt={'path': str(path.resolve()), 'sha256': provenance.sha256_file(path),
   370	                         'entry': record.get('entry'), 'exit_status': status,
   371	                         'outcome': record.get('outcome')})
