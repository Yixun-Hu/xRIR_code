   740	def gpu_compute_apps(gpu):
   741	    """The pids nvidia-smi reports on one card; an unqueryable card is refused."""
   742	    try:
   743	        output = subprocess.check_output(
   744	            ['nvidia-smi', '--query-compute-apps=pid', '--format=csv,noheader', '-i', str(gpu)],
   745	            text=True, stderr=subprocess.STDOUT)
   746	    except (OSError, subprocess.CalledProcessError) as error:
   747	        raise ValueError('cannot query GPU {}: {}'.format(gpu, error)) from error
   748	    return [line.strip() for line in output.splitlines() if line.strip()]
