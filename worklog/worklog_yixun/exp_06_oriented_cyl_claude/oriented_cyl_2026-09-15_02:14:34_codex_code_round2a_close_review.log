   751	def live_launches(attempt_root):
   752	    """Refuse a second launch while any attempt's launch.pid still names a live process."""
   753	    live = []
   754	    for pid_file in sorted(Path(attempt_root).glob('*/launch.pid')):
   755	        text = pid_file.read_text().split()
   756	        try:
   757	            pid = int(text[0])
   758	        except (IndexError, ValueError) as error:
   759	            raise ValueError('unreadable launch.pid at {}: {}'.format(pid_file, error)) from error
   760	        try:
   761	            os.kill(pid, 0)
   762	        except ProcessLookupError:
   763	            continue
   764	        except PermissionError:
   765	            pass  # A live process owned by somebody else is still a live process.
   766	        live.append({'path': str(pid_file), 'pid': pid})
   767	    return live
