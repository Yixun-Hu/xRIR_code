   685	def finalize(run_dir, run_type, log, child_exit, repo=REPO, receipt=None,
   686	             children=(), expect=None):
   687	    """Verify one child's evidence for its run type and write completion.json."""
   688	    run_dir = Path(run_dir)
   689	    _require(run_type in RUN_TYPES, 'unknown run type: {!r}'.format(run_type))
   690	    _require(run_dir.is_dir(), 'run directory does not exist: {}'.format(run_dir))
   691	    _require(type(child_exit) is int, 'child status must be an integer')
   692	    refuse_live_launch(run_dir)
   693	    log_record, child_exit_time, log_digest = closed_log(log, child_exit)
   694	    receipt_record = child_exit_receipt(run_dir, child_exit, log_digest)
   695	    diagnostic = run_type in DIAGNOSTIC
   696	    if not diagnostic:
   697	        _require(child_exit == 0, 'child exited with status {}'.format(child_exit))
   698	    fields = dict(schema_version=1, run_type=run_type, run_dir=str(run_dir.resolve()),
   699	                  repo=str(Path(repo).resolve()), child_exit=child_exit,
   700	                  child_exit_time=child_exit_time, log=log_record,
   701	                  child_exit_receipt=receipt_record,
   702	                  diagnostic=diagnostic, admissible_arm=not diagnostic)
   703	    fields.update(diagnostic_evidence(run_dir, receipt, child_exit) if diagnostic
   704	                  else full_evidence(run_dir, repo) if run_type == 'full'
   705	                  else haa_train_evidence(run_dir, repo) if run_type == 'haa_train'
   706	                  else haa_eval_evidence(run_dir, repo) if run_type == 'haa_eval'
   707	                  else haa_job_evidence(run_dir, children, expect))
   708	    _require(provenance.sha256_file(log) == log_digest,
   709	             'stale log: {} changed while its completion was being validated'.format(log))
   710	    return write_completion(run_dir / 'completion.json', fields)
