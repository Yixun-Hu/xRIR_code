    59	# diagnostic <run-type> <run dir> <log> <receipt> <smoke argv...>: a smoke or probe runs
    60	# through the same lifecycle as the confirmatory child -- pid file, drained pipe, end
    61	# marker, child_exit.json -- and is finalized as a never-admissible diagnostic.
    62	diagnostic() {
    63	    local kind="$1" dir="$2" log="$3" receipt="$4"
    64	    shift 4
    65	    local cmd=("$PYTHON" tools/exp06_smoke.py "$@")
    66	    say "MKDIR $dir"
