   338	    state = _state_dict(_load_torch(run_dir / EPOCH_CHECKPOINT, EPOCH_CHECKPOINT), EPOCH_CHECKPOINT)
   339	    model = _state_dict(last['model'], 'last.pth["model"]')
   340	    _require(set(state) == set(model), EPOCH_CHECKPOINT + ' has a different parameter set than last.pth')
   341	    _require(all(torch.equal(state[key], model[key]) for key in state),
   342	             EPOCH_CHECKPOINT + ' differs tensor-wise from last.pth["model"]')
   343	    return dict(artifacts=hashes, epochs=len(rows),
   344	                backbone=args['backbone'], source_closure_sha256=closure['sha256'],
   345	                registry_sha256=record.get('registry_sha256'),
   346	                git_head=record.get('git_state', {}).get('HEAD'),
   347	                checkpoint={'path': EPOCH_CHECKPOINT, 'sha256': hashes[EPOCH_CHECKPOINT],
