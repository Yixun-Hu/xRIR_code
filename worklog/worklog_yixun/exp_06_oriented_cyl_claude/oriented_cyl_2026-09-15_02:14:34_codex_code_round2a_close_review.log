   575	                    'log', 'child_exit_receipt', 'diagnostic', 'admissible_arm', 'artifacts',
   576	                    'backbone', 'frame', 'heading')
   577	CHILD_EXTRA = {'haa_train': ('rooms', 'init_sha256', 'best_epoch'),
   578	               'haa_eval': ('room', 'checkpoint_sha256', 'samples')}
