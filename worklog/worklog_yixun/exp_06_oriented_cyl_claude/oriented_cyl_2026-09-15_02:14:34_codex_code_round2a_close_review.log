   713	def child_exit_main(argv):
   714	    """Close one child's log: append the end marker, then bind those bytes in a receipt."""
   715	    parser = argparse.ArgumentParser(description='Close an exp_06 child log.')
   716	    parser.add_argument('--run-dir', required=True)
   717	    parser.add_argument('--log', required=True)
   718	    parser.add_argument('--child-pid', type=int, required=True)
   719	    parser.add_argument('--status', type=int, required=True)
   720	    args = parser.parse_args(argv)
   721	    path = Path(args.run_dir) / 'child_exit.json'
   722	    try:
   723	        _require(not path.exists(), 'child_exit.json already exists at {}'.format(path))
   724	        stamp = datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()
   725	        with open(args.log, 'a') as stream:
   726	            stream.write('{} {} {}\n'.format(MARKER, args.status, stamp))
   727	            stream.flush()
   728	            os.fsync(stream.fileno())
   729	        provenance.write_manifest(path, dict(
   730	            schema_version=1, child_pid=args.child_pid, status=args.status, ended_at=stamp,
   731	            log=str(Path(args.log).resolve()),
   732	            log_sha256_after_marker=provenance.sha256_file(args.log)))
   733	    except (OSError, ValueError) as error:
   734	        print('EXP06_CHILD_EXIT_REFUSED ' + str(error), file=sys.stderr, flush=True)
   735	        return 2
   736	    print('EXP06_CHILD_EXIT_OK ' + str(path), flush=True)
   737	    return 0
