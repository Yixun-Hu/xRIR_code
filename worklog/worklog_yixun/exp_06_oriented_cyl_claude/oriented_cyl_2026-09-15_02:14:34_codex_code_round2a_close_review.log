    76	    : > "$log"
    77	    run_child "$dir" "$log" "${cmd[@]}"
    78	    close_child "$dir" "$log"
    79	    finalize "$dir" "$log" "$CHILD_STATUS" "$kind" "$receipt"
    80	}
    81	
    82	# run_child <attempt> <log> <command...>: every byte the child or any descendant writes
    83	# goes through one pipe whose sink appends to the log. Waiting for the sink waits for EOF,
    84	# which arrives only after every process holding the write end has exited -- so nothing can
    85	# append after the end marker. Sets CHILD_PID and CHILD_STATUS.
    86	run_child() {
    87	    local attempt="$1" log="$2" pipe sink pid status=0
    88	    shift 2
    89	    pipe="$attempt/child.pipe"
    90	    rm -f -- "$pipe"
