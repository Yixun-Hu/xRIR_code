    95	    pid=$!
    96	    printf '%s\n' "$pid" > "$attempt/launch.pid"
    97	    wait "$pid" || status=$?
    98	    wait "$sink" || true   # EOF: the child and every descendant have closed the write end
    99	    rm -f -- "$pipe"
   100	    CHILD_PID="$pid"
   101	    CHILD_STATUS="$status"
   102	}
   103	
   104	# close_child <attempt> <log>: append the end marker and bind exactly those bytes.
   105	close_child() {
   106	    say "MARKER EXP06_CHILD_EXIT $CHILD_STATUS <iso> >> $2"
   107	    "$PYTHON" tools/exp06_finalize.py child-exit --run-dir "$1" --log "$2" \
