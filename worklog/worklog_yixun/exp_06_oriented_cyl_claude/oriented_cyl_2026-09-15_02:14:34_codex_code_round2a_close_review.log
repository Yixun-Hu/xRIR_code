   593	def child_completion(path, name):
   594	    """Schema, role and artefact hashes of one child, never its own admission claim."""
   595	    completion = Path(path) / 'completion.json'
   596	    _require(completion.is_file(), 'child {} has no completion.json'.format(name))
   597	    record = _read_json(completion, name + '/completion.json')
   598	    role = child_role(name)
   599	    missing = [key for key in CHILD_COMPLETION + CHILD_EXTRA[role] if key not in record]
   600	    _require(not missing, 'child {} completion is incomplete: missing {}'.format(
   601	        name, ', '.join(missing)))
   602	    _require(record['run_type'] == role,
   603	             'child {} has run type {!r}, not the {!r} its path requires'.format(
   604	                 name, record['run_type'], role))
   605	    _require(record['diagnostic'] is False, 'child {} is a diagnostic run'.format(name))
   606	    _require(type(record['child_exit']) is int and record['child_exit'] == 0,
   607	             'child {} records child_exit {!r}'.format(name, record['child_exit']))
   608	    hashes = record['artifacts']
   609	    _require(isinstance(hashes, dict) and hashes, 'child {} records no artefacts'.format(name))
   610	    absent = [artefact for artefact in CHILD_ARTIFACTS[role] if artefact not in hashes]
   611	    _require(not absent, 'child {} records no artefact {}'.format(name, ', '.join(absent)))
   612	    for artefact, digest in sorted(hashes.items()):
   613	        file = Path(path) / artefact
   614	        _require(file.is_file(), 'child {} artefact {} is gone'.format(name, artefact))
   615	        _require(provenance.sha256_file(file) == digest,
   616	                 'child {} artefact {} no longer hashes to its recorded digest'.format(
   617	                     name, artefact))
   618	    return record
