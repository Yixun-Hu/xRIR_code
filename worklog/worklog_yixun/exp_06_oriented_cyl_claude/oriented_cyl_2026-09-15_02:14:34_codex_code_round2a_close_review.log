   653	def haa_job_evidence(run_dir, children, expect):
   654	    """Bind one seed's children: every expected directory, each with its own completion."""
   655	    expected, job = set(expected_children(expect)), Path(run_dir).resolve()
   656	    seen, records = {}, {}
   657	    for child in children:
   658	        path = Path(child).resolve()
   659	        try:
   660	            name = path.relative_to(job).as_posix()
   661	        except ValueError as error:
   662	            raise ValueError('child {} lies outside the job directory'.format(child)) from error
   663	        if expect == 'zeroshot' and name.startswith('zeroshot/'):
   664	            name = name[len('zeroshot/'):]  # <init>/zeroshot/eval/<room> and <init>/zeroshot alike
   665	        records[name] = child_completion(path, name)
   666	        seen[name] = provenance.sha256_file(path / 'completion.json')
   667	    missing = sorted(expected - set(seen))
   668	    _require(not missing, 'job is missing children: ' + ', '.join(missing))
   669	    unexpected = sorted(set(seen) - expected)
   670	    _require(not unexpected, 'unexpected children: ' + ', '.join(unexpected))
   671	    return dict(job_identity(records, expect), artifacts={}, children=seen, expect=expect)
