   583	def child_role(name):
   584	    """The run type this finalizer requires at one child path of a pipeline seed."""
   585	    if name == 'stage1' or (name.startswith('stage2_') and name[len('stage2_'):] in ROOMS):
   586	        return 'haa_train'
   587	    for prefix in ('eval/', 'zeroshot/eval/'):
   588	        if name.startswith(prefix) and name[len(prefix):] in ROOMS:
   589	            return 'haa_eval'
   590	    raise ValueError('unexpected child path: ' + name)
