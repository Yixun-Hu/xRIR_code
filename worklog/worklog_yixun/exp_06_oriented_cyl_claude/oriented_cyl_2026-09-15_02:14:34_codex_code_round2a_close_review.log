   621	def job_identity(records, expect):
   622	    """Backbone, frame, heading rolls and the init/checkpoint lineage across one seed."""
   623	    backbones = {record['backbone'] for record in records.values()}
   624	    _require(len(backbones) == 1, 'children disagree on the backbone: ' + repr(sorted(backbones)))
   625	    frames = {record['frame'] for record in records.values()}
   626	    _require(len(frames) == 1, 'children disagree on the frame: ' + repr(sorted(frames)))
   627	    heading = {}
   628	    for name, record in sorted(records.items()):
   629	        for room, binding in (record['heading'] or {}).items():
   630	            previous = heading.setdefault(room, binding)
   631	            _require(previous.get('k') == binding.get('k'),
   632	                     'children disagree on the heading roll of {}: {} at {}'.format(
   633	                         room, binding.get('k'), name))
   634	    fields = dict(backbone=sorted(backbones)[0], frame=sorted(frames)[0], heading=heading or None)
   635	    if expect == 'zeroshot':
   636	        digests = {record['checkpoint_sha256'] for record in records.values()}
   637	        _require(len(digests) == 1,
   638	                 'zero-shot lineage: the evaluations used {} different checkpoints'.format(
   639	                     len(digests)))
   640	        return dict(fields, checkpoint_sha256=sorted(digests)[0])
   641	    stage1 = records['stage1']['artifacts']['best.pth']
   642	    for name, record in sorted(records.items()):
   643	        if name.startswith('stage2_'):
   644	            _require(record['init_sha256'] == stage1,
   645	                     'lineage: {} did not start from stage1/best.pth'.format(name))
   646	        elif name.startswith('eval/'):
   647	            room = name[len('eval/'):]
   648	            _require(record['checkpoint_sha256'] == records['stage2_' + room]['artifacts']['best.pth'],
   649	                     'lineage: {} did not evaluate stage2_{}/best.pth'.format(name, room))
   650	    return dict(fields, init_sha256=records['stage1']['init_sha256'])
