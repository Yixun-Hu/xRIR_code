def test_completion_respects_umask(tmp_path):
    previous = os.umask(0o027)
    try:
        p.write_completion(tmp_path / 'done.json', {})
    finally:
        os.umask(previous)
    assert (tmp_path / 'done.json').stat().st_mode & 0o777 == 0o640


