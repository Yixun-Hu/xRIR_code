    ('L_cyl', 'L', 'cylindrical', 768, 12, 12, 43780608, 56218813, 'ckpt/exp05/L_cylindrical/final/epoch_012.pth', None)))
COHORTS = MP({'arm': 'finite for every evaluation seed of this arm and metric',
