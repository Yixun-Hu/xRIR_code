CURVE_K8, CURVE_K1 = (MP({**H1, 'num_shot': k}) for k in (8, 1))
TARGETS_K8, TARGETS_K1 = (MP({**H2, 'num_shot': k}) for k in (8, 1))
YAW_K8_SEED42 = MP({**BASE, 'mode': 'yaw', 'num_shot': 8, 'family': 0,
