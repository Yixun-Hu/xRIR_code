   506	    return {'contrast': '{} - {}'.format(treatment, comparator), 'room': room,
   507	            'metric': metric, 'margin': margin, 'alpha': alpha,
   508	            'diff': nominal['diff'], 'query': nominal['query'], 'two_way': nominal['two_way'],
   509	            'cohort': rows['cohort'], 'n_test': rows['n_test'], 'excluded': rows['excluded'],
   510	            'per_seed_diff': rows['per_seed_diff'], 'void_reasons': void,
   511	            'convergence': convergence, 'bootstrap_seeds': list(BOOT_SEEDS),
   512	            'verdict': verdict_of(convergence, void, margin)}
   513	
   514	
   515	def screen_cells(arms, pair, n_boot=N_BOOT, adjusted_n_boot=N_BOOT_ADJUSTED, alpha=ALPHA):
   516	    """H2: the eleven room x metric cells, nominal and Bonferroni adjusted."""
   517	    treatment, comparator = pair
   518	    adjusted_alpha = bootstrap.bonferroni_alpha(alpha, H2_FAMILY)
