   194	def leaf_paths(sections):
   195	    """Expand section names, section.key names and leaf paths into dotted leaf paths."""
   196	    leaves = {'code': ['code.' + key for key in CODE_KEYS],
   197	              'reused': ['reused.' + key for key in REUSED_DIGESTS]
   198	                        + ['reused.legacy_receipt.path', 'reused.legacy_receipt.sha256'],
   199	              'artifacts': ['artifacts.gate_g1_sha256']
   200	                           + ['artifacts.epoch_012.' + key for key in sorted(LEAF_RULES)]
   201	                           + ['artifacts.heading.' + room for room in ROOMS]}
   202	    known = {name: list(items) for name, items in leaves.items()}
   203	    for name, items in leaves.items():
   204	        for item in items:
   205	            known.setdefault(item.rsplit('.', 1)[0], []).append(item)
   206	            known.setdefault(item, [item])
   207	    resolved = []
   208	    for name in sections:
   209	        if name not in known:
   210	            raise ValueError('unknown approvals section: ' + name)
   211	        resolved.extend(item for item in known[name] if item not in resolved)
   212	    return sorted(resolved)
