   522	        nominal = intervals(rows, alpha, n_boot)
   523	        convergence = converged_two_way(rows, adjusted_alpha, adjusted_n_boot)
   524	        interval = convergence['interval']
   525	        cells.append({'contrast': '{} - {}'.format(treatment, comparator), 'room': room,
   526	                      'metric': metric, 'diff': nominal['diff'], 'alpha': alpha,
   527	                      'adjusted_alpha': adjusted_alpha, 'family': H2_FAMILY,
   528	                      'nominal_two_way': nominal['two_way'], 'query': nominal['query'],
   529	                      'adjusted_two_way': interval, 'convergence': convergence,
   530	                      'cohort': rows['cohort'], 'n_test': rows['n_test'],
   531	                      'excluded': rows['excluded'], 'per_seed_diff': rows['per_seed_diff'],
