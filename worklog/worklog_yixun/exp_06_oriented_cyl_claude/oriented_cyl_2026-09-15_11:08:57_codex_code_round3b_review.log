   129	def _section(value, name, keys, aliases, optional=()):
   130	    """One normalised section: known keys only, aliases resolved, nothing dropped."""
   131	    if type(value) is not dict:
   132	        raise ValueError('approved digests: section {} is not a record'.format(name))
   133	    resolved = {}
   134	    for key, item in sorted(value.items()):
   135	        canonical = aliases.get(key, key)
   136	        if canonical not in keys and canonical not in optional:
   137	            raise ValueError('approved digests: unknown key {}.{}'.format(name, key))
   138	        if canonical in resolved:
   139	            raise ValueError('approved digests: {}.{} is given twice'.format(name, canonical))
   140	        resolved[canonical] = item
   141	    missing = [key for key in keys if key not in resolved]
   142	    if missing:
   143	        raise ValueError('approved digests: {} is missing {}'.format(name, ', '.join(missing)))
   144	    return resolved
