   553	# --- the room-frame side split -----------------------------------------------------------
   554	
   555	
   556	def cache_side_labels(room, cache_root=None):
   557	    """The room-frame sign of every test microphone's y, from the cache's own geometry."""
   558	    root = Path(cache_root or legacy.HAA_ROOT) / room
   559	    meta = _read_json(root / 'meta.json', '{}/meta.json'.format(room))
   560	    xyz = np.load(str(root / 'xyzs.npy')).astype(float)
