   399	
   400	# --- pairing, the finite cohort and the invalidity policy of section 7 -------------------
   401	
   402	PAIR_META = ('eval_seed', 'num_shot')
   403	
   404	
   405	def assert_pairing(a, b, label):
   406	    """exp_02's own pairing assertions: the same queries, measured the same way."""
   407	    _require(a['index'] == b['index'], 'pair {}: the query indices differ'.format(label))
   408	    _require(a['ir_path'] == b['ir_path'], 'pair {}: the ir_path entries differ'.format(label))
   409	    for key in PAIR_META:
   410	        _require(a['meta'].get(key) == b['meta'].get(key) is not None,
   411	                 'pair {}: {} {!r} != {!r}'.format(label, key, a['meta'].get(key),
   412	                                                   b['meta'].get(key)))
   413	
   414	
   415	def cell_rows(arms, x, y, room, metric):
   416	    """Paired rows pooled over the three fine-tuning seeds, on the shared finite cohort."""
   417	    columns, index = {x: [], y: []}, None
   418	    for seed in SEEDS:
   419	        for arm in (x, y):
   420	            _require(seed in arms[arm]['per'] and room in arms[arm]['per'][seed],
   421	                     'arm {} has no {} of {}'.format(arm, room, seed))
   422	        a, b = arms[x]['per'][seed][room], arms[y]['per'][seed][room]
   423	        assert_pairing(a, b, '{}-{} {} {}'.format(x, y, room, seed))
   424	        index = list(a['index']) if index is None else index
   425	        _require(list(a['index']) == index,
   426	                 'the seeds of {}/{} do not share one query order'.format(room, metric))
   427	        for arm, per in ((x, a), (y, b)):
   428	            columns[arm].append(np.asarray(per[metric], dtype=float))
   429	    stacked = {arm: np.stack(columns[arm]) for arm in (x, y)}
   430	    finite = {arm: np.isfinite(stacked[arm]).all(axis=0) for arm in (x, y)}
   431	    cohort = finite[x] & finite[y]
   432	    _require(cohort.any(), 'the cohort of {}/{} for {} - {} is empty'.format(room, metric, x, y))
   433	    rows = {arm: np.concatenate([stacked[arm][i][cohort] for i in range(len(SEEDS))])
   434	            for arm in (x, y)}
   435	    queries = np.asarray(index)[cohort]
   436	    return {'a': rows[x], 'b': rows[y],
   437	            'clusters': np.concatenate([queries] * len(SEEDS)),
   438	            'seeds': np.concatenate([np.full(int(cohort.sum()), seed) for seed in SEEDS]),
   439	            'cohort': int(cohort.sum()), 'n_test': len(index),
   440	            'per_seed_diff': {seed: float((stacked[x][i][cohort] - stacked[y][i][cohort]).mean())
   441	                              for i, seed in enumerate(SEEDS)},
   442	            'excluded': {arm: {'queries': int((~finite[arm]).sum()),
   443	                               'seeds': {seed: int((~np.isfinite(stacked[arm][i])).sum())
   444	                                         for i, seed in enumerate(SEEDS)}}
   445	                         for arm in (x, y)}}
