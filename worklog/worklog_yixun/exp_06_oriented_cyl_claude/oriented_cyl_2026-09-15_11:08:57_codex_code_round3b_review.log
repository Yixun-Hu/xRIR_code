   372	    """One exp_06 arm: four complete jobs, one execution closure, every room evaluated."""
   373	    base = Path(root) / Path(ARMS[arm]['root']).name
   374	    _require(base.is_dir(), 'missing arm directory {}'.format(base))
   375	    jobs, closures, job_records = {}, set(), {}
   376	    for job in JOBS:
   377	        job_dir = base / job
   378	        _require(job_dir.is_dir(), 'the arm {} has no job {}'.format(arm, job))
   379	        expect = EXPECT_OF[job]
   380	        job_records[job] = job_completion(job_dir, expect, arm)
   381	        _require(init_sha256 is None
   382	                 or job_records[job]['init_sha256'] == init_sha256,
   383	                 'the arm {} job {} did not start from the registered initialisation '
   384	                 '{}'.format(arm, job, init_sha256))
   385	        rooms = {}
   386	        for name in finalizer.expected_children(expect):
   387	            record, role = child_record(job_dir, name, arm, job)
   388	            closures.add(record['source_closure_sha256'])
   389	            if role == 'haa_eval':
   390	                rooms[record['room']] = child_per_sample(job_dir, name, record, arm)
   391	        _require(set(rooms) == set(ROOMS), 'the arm {} job {} evaluated {}'.format(
   392	            arm, job, sorted(rooms)))
   393	        jobs[job] = rooms
   394	    _require(len(closures) == 1, 'the children of {} do not share one execution closure: '
   395	             '{}'.format(arm, sorted(closures)))
   396	    return {'arm': arm, 'branch': 'new', 'per': jobs, 'closure': closures.pop(),
   397	            'root': str(base), 'jobs': job_records}
