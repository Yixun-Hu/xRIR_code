  1035	def verify_child(path, name, repo, spec):
  1036	    """Blocker 3c: re-run the child's own validator and bind its record to that result.
  1037	
  1038	    Nothing here trusts the child: its role validator runs again over the directory, and
  1039	    every field of its completion -- artefact hashes, identity, lineage -- must equal what
  1040	    the re-run produced. The log and receipt it bound are rehashed, and the whole child is
  1041	    then checked against the job the pipeline declared.
  1042	
  1043	    Finding 1: the liveness contract holds for every child as well. A live ``child.pid``
  1044	    or ``launch.pid`` under a child directory is never admissible -- the owner exception
  1045	    of ``--owner-pid`` covers the job's own launcher only, so a job can be certified only
  1046	    once every one of its children has exited.
  1047	    """
  1048	    refuse_live_launch(path)
  1049	    role = child_role(name)
  1050	    evidence = (haa_train_evidence(path, repo) if role == 'haa_train'
  1051	                else haa_eval_evidence(path, repo))
  1052	    record = child_completion(path, name, role)
  1053	    recorded = _mapping(record['artifacts'], 'child {} artifacts'.format(name))
  1054	    fresh = evidence['artifacts']
  1055	    # Close-3 finding 1: compare the whole mappings, never through .get() -- an absent key and
  1056	    # a recorded null agree there, so an invented 'nonexistent.pth': null would pass.
  1057	    _require(set(recorded) == set(fresh), 'child {} records the artefacts {}, not the {} the '
  1058	             're-run hashed'.format(name, sorted(recorded), sorted(fresh)))
  1059	    for artefact in sorted(fresh):
  1060	        _require(exp06_recipe.strict_equal(recorded[artefact], fresh[artefact]),
  1061	                 'child {} artefact {} is not the one the re-run hashed'.format(name, artefact))
  1062	    for field in sorted(set(evidence) - {'artifacts'}):
  1063	        _require(field in record, 'child {} completion records no {}'.format(name, field))
  1064	        _require(exp06_recipe.strict_equal(record[field], evidence[field]),
  1065	                 'child {} completion {} {!r} is not the {!r} of the re-run'.format(
  1066	                     name, field, record[field], evidence[field]))
  1067	    rehash_bound_evidence(record, name, path, repo)
  1068	    check_job_spec(name, role, evidence, spec,
  1069	                   _read_json(Path(path) / 'args.json', 'args.json'))
  1070	    return evidence
