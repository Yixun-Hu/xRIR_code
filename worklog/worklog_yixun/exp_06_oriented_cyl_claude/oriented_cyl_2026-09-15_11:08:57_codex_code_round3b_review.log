   999	def rehash_bound_evidence(record, name, path, repo):
  1000	    """Re-validate and rehash the log and receipt the child bound to its completion.
  1001	
  1002	    The digests must still be those bytes, and the bytes must still satisfy the closed-log
  1003	    contract: the job never takes a child's word that its writers had gone. Finding 2: the
  1004	    receipt whose bytes are hashed must be the canonical ``<child>/child_exit.json`` that is
  1005	    validated, and the pid, timestamps and ``child_exit_time`` the completion recorded must
  1006	    be the ones that validation produced.
  1007	    """
  1008	    for key in ('log', 'child_exit_receipt'):
  1009	        bound = record[key]
  1010	        _require(isinstance(bound, dict) and isinstance(bound.get('path'), str)
  1011	                 and _is_sha256(bound.get('sha256')),
  1012	                 'child {} records no {} evidence: {!r}'.format(name, key, bound))
  1013	        file = _resolve(bound['path'], repo)
  1014	        _require(file.is_file(), 'child {} {} {} is gone'.format(name, key, bound['path']))
  1015	        _require(provenance.sha256_file(file) == bound['sha256'],
  1016	                 'child {} {} no longer hashes to its recorded digest'.format(name, key))
  1017	    log_record, marker_time, digest = closed_log(_resolve(record['log']['path'], repo),
  1018	                                                 record['child_exit'])
  1019	    _require(log_record['sha256'] == record['log']['sha256'],
  1020	             'child {} log is not the {} it bound'.format(name, record['log']['sha256']))
  1021	    receipt = child_exit_receipt(path, record['child_exit'], digest, marker_time)
  1022	    bound = record['child_exit_receipt']
  1023	    _require(_resolve(bound['path'], repo).resolve() == Path(receipt['path']),
  1024	             'child {} child_exit_receipt binds {}, not its own {}'.format(
  1025	                 name, bound['path'], receipt['path']))
  1026	    for field in ('sha256', 'child_pid', 'started_at', 'ended_at'):
  1027	        _require(exp06_recipe.strict_equal(bound.get(field), receipt[field]),
  1028	                 'child {} child_exit_receipt {} {!r} is not the {!r} of the canonical '
  1029	                 'receipt'.format(name, field, bound.get(field), receipt[field]))
  1030	    _require(record['child_exit_time'] == marker_time == receipt['ended_at'],
  1031	             'child {} records child_exit_time {!r}, not the {!r} of its validated log marker '
  1032	             'and receipt'.format(name, record['child_exit_time'], marker_time))
