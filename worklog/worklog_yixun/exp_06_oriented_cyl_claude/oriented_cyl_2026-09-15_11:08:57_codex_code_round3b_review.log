   447	
   448	def void_reasons(rows, treatment, comparator):
   449	    """Section 7's invalidity policy; a void verdict is never replaced by a subset."""
   450	    excess = rows['excluded'][treatment]['queries'] - rows['excluded'][comparator]['queries']
   451	    reasons = []
   452	    if excess > VOID_EXCESS_FRACTION * rows['n_test']:
   453	        reasons.append('{} has {} more invalid queries than {}, above the {:.0%} of {} the '
   454	                       'policy allows'.format(treatment, excess, comparator,
   455	                                              VOID_EXCESS_FRACTION, rows['n_test']))
   456	    if rows['cohort'] < VOID_COHORT_FRACTION * rows['n_test']:
   457	        reasons.append('the cohort of {} queries is below {:.0%} of the {} in the test '
   458	                       'split'.format(rows['cohort'], VOID_COHORT_FRACTION, rows['n_test']))
   459	    return reasons
