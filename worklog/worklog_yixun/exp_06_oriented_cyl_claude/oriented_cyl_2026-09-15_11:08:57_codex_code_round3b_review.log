   488	
   489	def h2_label(interval):
   490	    """A screen, never a parity claim: harm, improvement, or no detected difference."""
   491	    low, high = interval
   492	    if low > 0:
   493	        return 'detected harm'
   494	    if high < 0:
   495	        return 'detected improvement'
   496	    return 'no detected difference'
