   464	
   465	def intervals(rows, alpha, n_boot, seed=BOOT_SEEDS[0]):
   466	    return bootstrap.paired_intervals(rows['a'], rows['b'], rows['clusters'], rows['seeds'],
   467	                                      alpha=alpha, n_boot=n_boot, seed=seed)
