   480	def verdict_of(convergence, void, margin):
   481	    """pass / fail / void / not_converged, in that order of precedence."""
   482	    if void:
   483	        return 'void'
   484	    if convergence['status'] != 'converged':
   485	        return 'not_converged'
   486	    return 'pass' if convergence['interval'][1] < margin else 'fail'
