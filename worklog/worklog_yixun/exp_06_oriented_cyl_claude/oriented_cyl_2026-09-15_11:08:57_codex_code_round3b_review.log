   474	            return intervals(rows, alpha, size, seed)['two_way']
   475	        return interval
   476	    return bootstrap.converged_interval(factory, n_boot=n_boot, seed_a=BOOT_SEEDS[0],
   477	                                        seed_b=BOOT_SEEDS[1], tol=CONVERGENCE_TOL)
