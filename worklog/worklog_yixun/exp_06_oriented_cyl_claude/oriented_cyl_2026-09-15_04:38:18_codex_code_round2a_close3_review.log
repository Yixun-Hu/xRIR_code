15: def stft(x, fft_size, hop_size, win_length, window):
16:     """Perform STFT and convert to magnitude spectrogram.
17:     Args:
18:         x (Tensor): Input signal tensor (B, T).
19:         fft_size (int): FFT size.
20:         hop_size (int): Hop size.
21:         win_length (int): Window length.
22:         window (Tensor): Window function type.
23:     Returns:
24:         Tensor: Magnitude spectrogram (B, #frames, fft_size // 2 + 1).
25:     """
26:     window = window.to(x.device)
27:     x_stft = torch.stft(x, fft_size, hop_size, win_length, window, return_complex=False, pad_mode='constant')
28:     real = x_stft[..., 0]
29:     imag = x_stft[..., 1]
32:     return torch.sqrt(torch.clamp(real ** 2 + imag ** 2, min=1e-7)).transpose(2, 1)
35: def normalize(audio, norm='peak'):
36:     """
37:     normalize IR
38:     :param audio: IR
39:     :param norm: normalization mode
40:     :return: normalized IR
41:     """
42:     if norm == 'peak':
43:         peak = abs(audio).max()
44:         if peak != 0:
45:             return audio / peak
46:         else:
47:             return audio
48:     elif norm == 'rms':
49:         if torch.is_tensor(audio):
50:             audio = audio.numpy()
51:         audio_without_padding = np.trim_zeros(audio, trim='b')
52:         rms = np.sqrt(np.mean(np.square(audio_without_padding))) * 100
53:         if rms != 0:
54:             return audio / rms
55:         else:
56:             return audio
57:     else:
58:         raise NotImplementedError
61: def measure_drr_energy_ratio(y, cutoff_time=0.003, fs=22050):
62:     """
63:     get direct to reverberant energy ratio (DRR)
64:     :param y: IR
65:     :param cutoff_time: cutoff time to compute DRR
66:     :param fs: sampling frequency
67:     :return: DRR
68:     """
69:     direct_sound_idx = int(cutoff_time * fs)
72:     y = normalize(y)
73:     y = np.trim_zeros(y, trim='fb')
76:     y = np.power(y, 2)
77:     direct = sum(y[:direct_sound_idx + 1])
78:     reverberant = sum(y[direct_sound_idx + 1:])
79:     if direct == 0 or reverberant == 0:
80:         drr = 1
82:     else:
83:         drr = 10 * np.log10(direct / reverberant)
85:     return drr
88: def calculate_drr_diff(gt, est, cutoff_time=0.003, fs=22050, compute_relative_diff=False, get_diff_val=True,
89:                        get_gt_val=False, get_pred_val=False,):
90:     """
91:     get difference in DRR, DRR for gt or DRR for estimated IR
92:     :param gt: gt IR
93:     :param est: estimated IR
94:     :param cutoff_time: cutoff time to compute DRR
95:     :param fs: sampling frequency
96:     :param compute_relative_diff: flag to compute relative difference
97:     :param get_diff_val: flag to get difference in DRR
98:     :param get_gt_val: flag to get DRR of gt IR
99:     :param get_pred_val: flag to get DRR of estimated IR
100:     :return: difference in DRR, DRR of gt IR or DRR of estimated IR
101:     """
102:     drr_gt = measure_drr_energy_ratio(gt, cutoff_time=cutoff_time, fs=fs)
103:     drr_est = measure_drr_energy_ratio(est, cutoff_time=cutoff_time, fs=fs)
104:     diff = abs(drr_gt - drr_est)
105:     if compute_relative_diff:
106:         diff = abs(diff / drr_gt)
108:     if get_diff_val:
109:         return diff
110:     elif get_gt_val:
111:         return drr_gt
112:     elif get_pred_val:
113:         return drr_est
