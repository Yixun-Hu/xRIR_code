              for cls in (CylindricalViT, CylindricalViTOriented)]
    p1, p2 = kwargs.get('patch_size', (16, 32))
    delta = 2 * p1 * p2 * kwargs.get('dim', 512) + 2 * (5 - 3) * p1 * p2
    assert counts[1] - counts[0] == delta
    if not kwargs:
