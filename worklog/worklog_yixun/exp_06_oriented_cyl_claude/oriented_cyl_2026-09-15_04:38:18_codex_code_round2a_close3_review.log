    elif damage == 'not_json':
        Path(spec).write_text('{ truncated')
    else:
        if damage == 'no_field':
            record.pop('init')
        elif damage == 'expect':
            record['expect'] = 'zeroshot'
        elif damage == 'backbone':
            record['backbone'] = 'invented'
        elif damage == 'frame':
            record['frame'] = 'world'
        elif damage == 'init_sha256':
            record['init_sha256'] = 'zz'
        elif damage == 'seed':
            record['seed'] = '0'
