        t60s = f"{summary['t60_error_pct']['mean']:.2f}%" if summary["t60_error_pct"] else "-"
        print(f"{room:14s} n={len(items):4d}  EDT {summary['edt_error_s']['mean']:.4f}s  C50 {summary['c50_error_db']['mean']:.3f}dB  "
