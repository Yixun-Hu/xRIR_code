192: class Criterion(torch.nn.Module):
193:     def __init__(self):
194:         super(Criterion, self).__init__()
196:     def forward(self, h, target_h):
197:         h = h.squeeze(1)
198:         target_h = target_h.squeeze(1)
200:         power = h ** 2
201:         energy = torch.cumsum(power.flip(dims=[-1]), dim=-1).flip(dims=[-1])
204:         non_zero_mask = (energy > 0)
205:         energy_db_list = []
206:         for i in range(energy.size(0)):
207:             i_nz = non_zero_mask[i].nonzero(as_tuple=True)[0].max().item() if non_zero_mask[i].any() else energy.size(-1) - 1
208:             energy_trimmed = energy[i, :i_nz+1]
209:             energy_db = 10 * torch.log10(energy_trimmed + 1e-10)
210:             energy_db = energy_db.clone() - energy_db[0]  # Normalize to start at 0 dB
211:             energy_db_list.append(energy_db)
214:         energy_db = torch.nn.utils.rnn.pad_sequence(energy_db_list, batch_first=True)
215:         energy_db = energy_db[...,:8000]
217:         target_power = target_h ** 2
218:         target_energy = torch.cumsum(target_power.flip(dims=[-1]), dim=-1).flip(dims=[-1])
221:         target_non_zero_mask = (target_energy > 0)
222:         target_energy_db_list = []
223:         for i in range(target_energy.size(0)):
224:             target_i_nz = target_non_zero_mask[i].nonzero(as_tuple=True)[0].max().item() if target_non_zero_mask[i].any() else target_energy.size(-1) - 1
225:             target_energy_trimmed = target_energy[i, :target_i_nz+1]
226:             target_energy_db = 10 * torch.log10(target_energy_trimmed + 1e-10)
227:             target_energy_db = target_energy_db.clone() - target_energy_db[0]  # Normalize to start at 0 dB
228:             target_energy_db_list.append(target_energy_db)
230:         target_energy_db = torch.nn.utils.rnn.pad_sequence(target_energy_db_list, batch_first=True)
231:         target_energy_db = target_energy_db[...,:8000]
233:         loss = torch.nn.functional.l1_loss(energy_db, target_energy_db)
234:         print("HHH", torch.nn.functional.l1_loss(energy_db[0], target_energy_db[0]))
235:         return loss
