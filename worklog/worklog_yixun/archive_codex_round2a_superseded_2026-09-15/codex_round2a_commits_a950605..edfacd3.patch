@@ -0,0 +1,102 @@
+"""Recipe and production admission, including read-only historical records."""
+import json
+from pathlib import Path
+
+import pytest
+
+from tools import exp06_recipe as r
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+def test_real_trainer_fields_are_classified():
+    path = REPO / 'ckpt/exp05/S_simple/attempt_20260913T123905/args.json'
+    if not path.exists():
+        pytest.skip('exp05 args absent')
+    args = json.loads(path.read_text())
+    classes = r.classify(args)
+    assert len(classes) == len(args) == 33
+    assert set(classes.values()) == {'RECIPE', 'PRODUCTION', 'OPERATIONAL', 'DERIVED'}
+
+
+@pytest.mark.parametrize('backbone', ['simple', 'cyl'])
+def test_historical_recipe(backbone):
+    path = REPO / ('ckpt/xRIR_' + backbone + '_8_shot/args.json')
+    if not path.exists():
+        pytest.skip('exp01 args absent')
+    original = json.loads(path.read_text())
+    normalized, report = r.normalize_historical(original)
+    assert r.check_recipe(normalized) == []
+    assert report['vit_dim'] == report['yaw_aug_width'] == 'normalized'
+    assert report['param_counts'] == report['env'] == 'not_recorded'
+    assert 'param_counts' not in normalized and 'vit_dim' not in original
+
+
+@pytest.mark.parametrize('field,value', [('tf32', 1), ('batch_size', True), ('lr', 1),
+                                         ('vit_dim', 256)])
+def test_recipe_strict_types(field, value):
+    assert any(field in d for d in r.check_recipe(dict(r.EXP01_RECIPE, **{field: value})))
+
+
+@pytest.mark.parametrize('field,value', [('max_train_batches', 3), ('max_test_batches', 1),
+    ('resume', 'x'), ('no_save', True), ('test_subset', 100), ('yaw_aug', True)])
+def test_production_refusals(field, value):
+    args = dict(r.PRODUCTION, yaw_aug_seed=0, yaw_aug_width=512)
+    assert r.check_production(args) == []
+    args[field] = value
+    assert any(field in d for d in r.check_production(args))
+
+
+def test_unknown_and_missing_fields():
+    with pytest.raises(ValueError, match='typo'):
+        r.classify({'typo': 0})
+    assert 'lr: missing' in r.check_recipe({})
+    assert r.classify({'exp06_git_head': 'a' * 40}) == {'exp06_git_head': 'EXP06'}
+
+
+def complete_args():
+    return dict(r.EXP01_RECIPE, **r.PRODUCTION, yaw_aug_seed=0, yaw_aug_width=512,
+        backbone='simple', save_dir='/tmp/exp06', num_workers=12, log_interval=50,
+        save_every=500, epoch_ckpt_every=1, env={}, train_batches_per_epoch=9261,
+        tier='M', param_counts=r.expected_param_counts('simple'))
+
+
+def history():
+    return [dict(epoch=e, train_loss=1., test_loss=2., epoch_minutes=3.) for e in range(1, 13)]
+
+
+def test_complete_and_truncated_run():
+    args, rows, last = complete_args(), history(), dict(epoch=12, batch_idx=0)
+    assert r.check_all(args, history_rows=rows, last_meta=last) == []
+    args['max_train_batches'] = 3
+    assert any('max_train_batches' in d for d in r.check_all(args, history_rows=rows, last_meta=last))
+
+
+@pytest.mark.parametrize('change,cause', [
+    (lambda rows: rows.pop(6), 'epoch 7'), (lambda rows: rows.insert(3, rows[2]), 'epoch 3'),
+    (lambda rows: rows.reverse(), 'order'),
+    (lambda rows: rows[0].update(train_loss=float('nan')), 'train_loss'),
+    (lambda rows: rows[0].update(test_loss=float('inf')), 'test_loss'),
+    (lambda rows: rows[0].update(epoch_minutes=None), 'epoch_minutes'),
+    (lambda rows: rows[0].update(epoch=True), 'epoch')])
+def test_budget_refusals(change, cause):
+    rows = history()
+    change(rows)
+    assert any(cause in d for d in r.check_budget(rows, dict(epoch=12, batch_idx=0)))
+
+
+@pytest.mark.parametrize('field,value', [('train_batches_per_epoch', 9260), ('tier', 'S'),
+    ('param_counts', {}), ('param_counts', {'encoder': True}), ('backbone', 'typo')])
+def test_derived_refusals(field, value):
+    args = complete_args()
+    args[field] = value
+    assert any(field in d for d in r.check_derived(args, args['backbone']))
+
+
+def test_check_all_named_schema_and_metadata_deviations():
+    args = complete_args()
+    assert any('typo' in d for d in r.check_all(dict(args, typo=3)))
+    assert any('epoch' in d for d in r.check_budget(history(), dict(epoch=11, batch_idx=0)))
+    assert any('batch_idx' in d for d in r.check_budget(history(), dict(epoch=12, batch_idx=1)))
+    del args['env']
+    assert any('env' in d for d in r.check_all(args))
