+"""Type-strict exp_01 recipe and exp_06 completion admission.
+
+Historical normalization returns (copied arguments, per-field recording status).
+It supplies only the frozen implicit ViT/yaw defaults, never derived evidence.
+Checks return named deviations; classify raises on any unregistered field.
+"""
+import math
+from functools import lru_cache
+
+import torch
+from model.xRIR_cyl_oriented import BACKBONES_EXP06, build_xrir_exp06
+from tools.exp05_params import count_parameters
+
+EXP01_RECIPE = dict(num_shot=8, max_len=9600, lr=1e-3, weight_decay=1e-4,
+    decay_epochs=3, lr_gamma=0.1, epochs=12, batch_size=32, accum_steps=2, seed=0,
+    tf32=True, vit_dim=512, vit_depth=12, vit_heads=8, vit_mlp_dim=512)
+PRODUCTION = dict(max_train_batches=0, max_test_batches=0, test_subset=0,
+                  resume=None, no_save=False, yaw_aug=0)
+OPERATIONAL = {'backbone', 'save_dir', 'num_workers', 'log_interval', 'save_every',
+               'epoch_ckpt_every', 'env'}
+DERIVED = {'train_batches_per_epoch', 'tier', 'param_counts'}
+EXP06 = {'exp06_run_type', 'exp06_registry_sha256', 'exp06_source_closure_sha256',
+         'exp06_git_head', 'exp06_provenance_path'}
+FIELD_CLASSES = {field: label for label, fields in (
+    ('RECIPE', EXP01_RECIPE), ('PRODUCTION', set(PRODUCTION) | {'yaw_aug_seed', 'yaw_aug_width'}),
+    ('OPERATIONAL', OPERATIONAL), ('DERIVED', DERIVED), ('EXP06', EXP06)) for field in fields}
+
+
+def classify(args_dict):
+    for field in args_dict:
+        if field not in FIELD_CLASSES:
+            raise ValueError('unknown field: ' + str(field))
+    return {field: FIELD_CLASSES[field] for field in args_dict}
+
+
+def normalize_historical(args_dict):
+    classify(args_dict)
+    result = dict(args_dict)
+    defaults = {k: v for k, v in EXP01_RECIPE.items() if k.startswith('vit_')}
+    defaults.update(yaw_aug=0, yaw_aug_seed=0, yaw_aug_width=512)
+    report = {k: 'recorded' if k in result else 'not_recorded'
+              for k in FIELD_CLASSES if k not in EXP06}
+    for key, value in defaults.items():
+        if key not in result:
+            result[key], report[key] = value, 'normalized'
+    return result, report
+
+
+def _expected(args, expected):
+    deviations = []
+    for key, value in expected.items():
+        if key not in args:
+            deviations.append(key + ': missing')
+        elif type(args[key]) is not type(value) or args[key] != value:
+            deviations.append('{}: expected {!r} ({}), got {!r}'.format(
+                key, value, type(value).__name__, args[key]))
+    return deviations
+
+
+def check_recipe(args_dict, expected=EXP01_RECIPE):
+    classify(args_dict)
+    return _expected(args_dict, expected)
+
+
+def check_production(args_dict):
+    classify(args_dict)
+    deviations = _expected(args_dict, PRODUCTION)
+    for key in ('yaw_aug_seed', 'yaw_aug_width'):
+        if type(args_dict.get(key)) is not int:
+            deviations.append(key + ': missing or not an integer (recorded inert field)')
+    return deviations
+
+
+@lru_cache(maxsize=None)
+def expected_param_counts(backbone):
+    """Construct the registered M model without advancing the caller's CPU RNG."""
+    with torch.random.fork_rng(devices=[]):
+        return count_parameters(build_xrir_exp06(backbone, 8))
+
+
+def check_derived(args_dict, backbone):
+    deviations = _expected(args_dict, dict(train_batches_per_epoch=9261, tier='M', backbone=backbone))
+    if backbone not in BACKBONES_EXP06:
+        return deviations + ['backbone: unknown ' + str(backbone)]
+    expected, actual = expected_param_counts(backbone), args_dict.get('param_counts')
+    if not isinstance(actual, dict) or set(actual) != set(expected):
+        deviations.append('param_counts: missing or incorrect keys')
+    else:
+        deviations += ['param_counts.' + d for d in _expected(actual, expected)]
+    return deviations
+
+
+def check_budget(history_rows, last_meta):
+    deviations, epochs = [], []
+    if not isinstance(history_rows, list):
+        return ['history: expected parsed rows']
+    for index, row in enumerate(history_rows):
+        if not isinstance(row, dict):
+            deviations.append('history row {}: expected object'.format(index))
+            continue
+        epoch = row.get('epoch')
+        if type(epoch) is not int or epoch not in range(1, 13):
+            deviations.append('history epoch: invalid {!r}'.format(epoch))
+        else:
+            epochs.append(epoch)
+        for key in ('train_loss', 'test_loss', 'epoch_minutes'):
+            value = row.get(key)
+            if type(value) not in (int, float) or not math.isfinite(value):
+                deviations.append('epoch {!r} {}: missing or non-finite'.format(epoch, key))
+    for epoch in range(1, 13):
+        if epochs.count(epoch) != 1:
+            deviations.append('epoch {}: expected once, found {}'.format(epoch, epochs.count(epoch)))
+    if epochs != sorted(epochs):
+        deviations.append('history epoch order: not monotone')
+    if not isinstance(last_meta, dict):
+        deviations.append('last_meta: missing')
+    else:
+        deviations += ['last_meta.' + d for d in _expected(last_meta, dict(epoch=12, batch_idx=0))]
+    return deviations
+
+
+def check_all(args_dict, backbone=None, history_rows=None, last_meta=None):
+    """Validate all recorded fields; validate budget when either evidence item is supplied."""
+    try:
+        classify(args_dict)
+    except ValueError as error:
+        return [str(error)]
+    deviations = check_recipe(args_dict) + check_production(args_dict)
+    deviations += check_derived(args_dict, backbone or args_dict.get('backbone'))
+    for key in sorted(OPERATIONAL):
+        if key not in args_dict:
+            deviations.append(key + ': missing')
+    if EXP06.intersection(args_dict):
+        for key in sorted(EXP06):
+            value = args_dict.get(key)
+            if not isinstance(value, str) or not value:
+                deviations.append(key + ': missing or invalid')
+            elif key.endswith('sha256') or key == 'exp06_git_head':
+                length = 40 if key == 'exp06_git_head' else 64
+                if len(value) != length or any(c not in '0123456789abcdef' for c in value):
+                    deviations.append(key + ': invalid digest')
+        if args_dict.get('exp06_run_type') != 'full':
+            deviations.append('exp06_run_type: diagnostic run is not an arm')
+    if history_rows is not None or last_meta is not None:
+        deviations += check_budget(history_rows, last_meta)
+    return deviations
