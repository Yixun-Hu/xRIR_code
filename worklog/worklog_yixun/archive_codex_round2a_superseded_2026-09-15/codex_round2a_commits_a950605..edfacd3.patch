@@ -0,0 +1,169 @@
+"""Validate completed exp_06 children; refusals raise ValueError (CLI exit 2)."""
+import argparse
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+from tools import provenance as p
+
+REPO = Path(__file__).resolve().parents[1]
+RUN_TYPES = ('full', 'smoke', 'probe', 'haa_train', 'haa_eval', 'haa_job')
+
+
+def launch_lock_paths(repo):
+    """Shared lock/PID names outside the repository; callers hold the flock."""
+    key = hashlib.sha256(str(Path(repo).resolve()).encode()).hexdigest()[:16]
+    stem = Path(tempfile.gettempdir()) / ('exp06_launch_' + key)
+    return Path(str(stem) + '.lock'), Path(str(stem) + '.pid')
+
+
+def preflight(repo, reviewed_commit, gpu, run_type, attempt_root):
+    """Read-only launch checks. PID liveness uses /proc, never a signal."""
+    _require(run_type in ('full', 'probe', 'smoke', 'finalize'), 'run_type is unknown')
+    try:
+        state = p.checked_git_state(repo, confirmatory=True)
+        _require(state['HEAD'] == reviewed_commit, 'HEAD differs from reviewed_commit')
+        paths = [launch_lock_paths(repo)[1]] + list(Path(attempt_root).rglob('launch.pid'))
+        for path in paths:
+            if not path.exists():
+                continue
+            raw = path.read_text().strip()
+            _require(raw.isdigit() and int(raw) > 0, 'invalid launch pid: ' + str(path))
+            _require(not (Path('/proc') / raw).exists(), 'exp06 launch pid alive: ' + raw)
+        if run_type in ('full', 'probe'):
+            result = subprocess.run(['nvidia-smi', '--query-compute-apps=pid',
+                '--format=csv,noheader', '-i', str(gpu)], capture_output=True, text=True)
+            _require(result.returncode == 0, 'GPU query failed: ' + result.stderr.strip())
+            _require(not result.stdout.strip(), 'GPU busy: ' + result.stdout.strip())
+        return state
+    except (OSError, subprocess.SubprocessError) as error:
+        raise ValueError('preflight: {}'.format(error)) from error
+
+
+def _require(condition, cause):
+    if not condition:
+        raise ValueError(cause)
+
+
+def _json(path):
+    try:
+        return json.loads(Path(path).read_text())
+    except (OSError, ValueError) as error:
+        raise ValueError('{}: {}'.format(path, error)) from error
+
+
+def _binding(path):
+    try:
+        path = Path(path).resolve()
+        return {'path': str(path), 'sha256': p.sha256_file(path)}
+    except (OSError, TypeError) as error:
+        raise ValueError('artifact {}: {}'.format(path, error)) from error
+
+
+def _verify_manifest(manifest, repo, run_type):
+    """Rehash reviewed source bytes and every declared input, including training data."""
+    try:
+        _require(manifest['run_type'] == run_type, 'provenance run_type mismatch')
+        commit = manifest['reviewed_commit']
+        _require(manifest['git_state']['HEAD'] == commit, 'provenance HEAD mismatch')
+        _require(not manifest['git_state'].get('dirty_outside_worklog', True),
+                 'provenance dirty_outside_worklog')
+        closure = manifest['source_closure']
+        stored = closure['files']
+        names = [record['path'] for record in stored]
+        _require(names and len(set(names)) == len(names), 'source_closure empty/duplicate files')
+        current, digest = p.closure_record(names, commit, repo)
+        _require(digest == closure['sha256'] == manifest['source_closure_sha256'],
+                 'source_closure digest mismatch')
+        by_path = {record['path']: record for record in current}
+        for record in stored:
+            now = by_path[record['path']]
+            blob = now['reviewed_blob_sha256']
+            _require(blob is not None and not now['commits_after_reviewed'] and
+                     all(record[key] == now[key] == blob for key in
+                         ('reviewed_blob_sha256', 'working_tree_sha256')),
+                     'source_closure drift: ' + record['path'])
+        fields = dict(manifest, repo=str(repo), source_closures={'training': closure})
+        required = ('train_data_identity',) if run_type == 'full' else ()
+        deviations = p.revalidate(fields, required=required)
+        _require(not deviations, 'input revalidation: ' + ', '.join(deviations))
+    except (OSError, KeyError, TypeError, subprocess.SubprocessError) as error:
+        raise ValueError('provenance/source_closure: {}'.format(error)) from error
+
+
+def _closed_log(log, child_exit):
+    _require(type(child_exit) is int and child_exit == 0, 'child_exit must be 0')
+    try:
+        lines = Path(log).read_text().splitlines()
+        match = re.fullmatch(r'EXP06_CHILD_EXIT (-?\d+) (\S+)', lines[-1] if lines else '')
+        _require(match is not None and int(match[1]) == child_exit, 'log marker mismatch')
+        datetime.datetime.fromisoformat(match[2].replace('Z', '+00:00'))
+    except (OSError, TypeError, ValueError) as error:
+        raise ValueError('log marker: {}'.format(error)) from error
+    return {'child_exit': child_exit, 'closed_at': match[2], 'log': _binding(log)}
+
+
+def _publish(path, record):
+    payload = json.dumps(record, sort_keys=True, indent=2, allow_nan=False).encode() + b'\n'
+    # Hard-link the completed temporary record exclusively; never replace a peer's result.
+    with tempfile.TemporaryDirectory(prefix='.exp06-completion-', dir=str(path.parent)) as directory:
+        temporary = Path(directory) / 'completion.json'
+        p.write_completion(temporary, record)
+        try:
+            os.link(str(temporary), str(path))
+        except FileExistsError:
+            _require(path.read_bytes() == payload, 'existing completion differs')
+
+
+def finalize(run_dir, run_type, log, child_exit, repo=None, receipt=None, children=None, expect=None):
+    """Write one deterministic completion only after all required evidence passes."""
+    _require(run_type in RUN_TYPES, 'run_type is unknown')
+    directory = Path(run_dir).resolve()
+    _require(directory.is_dir(), 'run_dir is missing')
+    record = {'schema_version': 1, 'run_type': run_type, 'child_exit': child_exit}
+    if run_type in ('smoke', 'probe'):
+        record.update(diagnostic=True, admissible_arm=False)
+        if receipt is not None:
+            record['receipt'] = _binding(receipt)
+    else:
+        record.update(_closed_log(log, child_exit))
+        raise ValueError('run_type implementation pending: ' + run_type)
+    _publish(directory / 'completion.json', record)
+    return record
+
+
+def main(argv=None):
+    argv = list(sys.argv[1:] if argv is None else argv)
+    is_preflight = argv[:1] == ['preflight']
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--repo', type=Path, default=REPO)
+    if is_preflight:
+        parser.add_argument('--reviewed-commit', required=True)
+        parser.add_argument('--gpu', required=True)
+        parser.add_argument('--run-type', choices=('smoke', 'probe', 'full', 'finalize'), required=True)
+        parser.add_argument('--attempt-root', type=Path, required=True)
+    else:
+        parser.add_argument('--run-dir', type=Path, required=True)
+        parser.add_argument('--run-type', choices=RUN_TYPES, required=True)
+        parser.add_argument('--log', type=Path, required=True)
+        parser.add_argument('--child-exit', type=int, required=True)
+        parser.add_argument('--receipt', type=Path)
+        parser.add_argument('--children', nargs='+', type=Path)
+        parser.add_argument('--expect', choices=('finetune', 'zeroshot'))
+    args = parser.parse_args(argv[1:] if is_preflight else argv)
+    try:
+        record = (preflight if is_preflight else finalize)(**vars(args))
+    except ValueError as error:
+        parser.exit(2, 'REFUSED: {}\n'.format(error))
+    print(json.dumps(record, sort_keys=True))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
