@@ -0,0 +1,112 @@
+"""Bounded smoke dispatch is tested without sending any process a signal."""
+import json
+import sys
+import types
+
+import pytest
+
+from tools import exp06_smoke as smoke
+
+
+@pytest.fixture(autouse=True)
+def isolated_runtime(monkeypatch):
+    handlers, alarms = {'initial': object()}, []
+    handlers['current'] = handlers['initial']
+    def install(sig, handler):
+        previous, handlers['current'] = handlers['current'], handler
+        handlers.setdefault('run', handler)
+        return previous
+    monkeypatch.setattr(smoke.signal, 'signal', install)
+    monkeypatch.setattr(smoke.signal, 'alarm', lambda seconds: alarms.append(seconds))
+    monkeypatch.setattr(smoke.torch.cuda, 'is_available', lambda: False)
+    monkeypatch.setattr(smoke, 'git_state', lambda repo: {'HEAD': 'a' * 40})
+    return handlers, alarms
+
+
+@pytest.mark.parametrize('entry', ['trainer', 'exp06_train', 'exp06_haa_finetune', 'exp06_haa_eval'])
+def test_entry_dispatch_receipt_and_argv(entry, monkeypatch, tmp_path, capsys, isolated_runtime):
+    seen, original = [], sys.argv
+    main = (lambda: seen.extend(sys.argv[1:])) if entry == 'trainer' else seen.extend
+    monkeypatch.setitem(sys.modules, smoke.ENTRIES[entry], types.SimpleNamespace(main=main))
+    receipt = tmp_path / 'receipt.json'
+    assert smoke.main(['--entry', entry, '--receipt', str(receipt), '--', '--hello', 'world']) == 0
+    record = json.loads(receipt.read_text())
+    assert seen == record['argv'] == ['--hello', 'world'] and sys.argv is original
+    assert record['diagnostic'] is True and record['entry'] == entry
+    assert record['exit_status'] == record['peak_bytes'] == 0
+    assert record['wall_s'] >= 0 and record['git_head'] == 'a' * 40 and record['timestamp']
+    assert json.loads(capsys.readouterr().out.split('EXP06_SMOKE ')[1]) == record
+    assert isolated_runtime[1] == [300, 0]
+    assert isolated_runtime[0]['current'] is isolated_runtime[0]['initial']
+
+
+@pytest.mark.parametrize('failure,status', [('alarm', 3), ('exception', 1), ('exit', 2), ('memory', 3)])
+def test_failure_receipts(failure, status, monkeypatch, tmp_path, isolated_runtime):
+    def entry(argv):
+        if failure == 'alarm':
+            isolated_runtime[0]['run'](smoke.signal.SIGALRM, None)
+        if failure == 'exception':
+            raise RuntimeError('entry broke')
+        if failure == 'exit':
+            raise SystemExit(2)
+    if failure == 'memory':
+        monkeypatch.setattr(smoke.torch.cuda, 'is_available', lambda: True)
+        monkeypatch.setattr(smoke.torch.cuda, 'reset_peak_memory_stats', lambda: None)
+        monkeypatch.setattr(smoke.torch.cuda, 'synchronize', lambda: None)
+        monkeypatch.setattr(smoke.torch.cuda, 'max_memory_allocated', lambda: 4 * 1024**3)
+    monkeypatch.setitem(sys.modules, smoke.ENTRIES['exp06_train'], types.SimpleNamespace(main=entry))
+    receipt = tmp_path / 'receipt.json'
+    with pytest.raises(SystemExit) as caught:
+        smoke.main(['--entry', 'exp06_train', '--receipt', str(receipt)])
+    assert caught.value.code == status
+    assert json.loads(receipt.read_text())['exit_status'] == status
+    assert isolated_runtime[1][-1] == 0
+    assert isolated_runtime[0]['current'] is isolated_runtime[0]['initial']
+
+
+@pytest.mark.parametrize('argv', [['--entry', 'unknown'], ['--entry', 'trainer', '--max-gb', 'nan'],
+                                ['--entry', 'trainer', '--alarm-seconds', '0']])
+def test_invalid_cli(argv):
+    with pytest.raises(SystemExit) as caught:
+        smoke.main(argv)
+    assert caught.value.code == 2
+
+
+def test_cpu_fixture_strict_load_and_identity(tmp_path):
+    from model.xRIR_cyl_oriented import build_xrir_exp06
+    from tools.exp06_train import registry_sha256
+    from tools.provenance import sha256_file
+
+    target = tmp_path / 'fixture.pth'
+    assert smoke.main(['--make-fixture', str(target), '--seed', '5']) == 0
+    state = smoke.torch.load(target, map_location='cpu', weights_only=True)
+    model = build_xrir_exp06('cylindrical_oriented', 8)
+    model.load_state_dict(state, strict=True)
+    assert all(t.device.type == 'cpu' for t in state.values())
+    assert json.loads(target.with_suffix('.pth.json').read_text()) == {
+        'diagnostic': True, 'seed': 5, 'sha256': sha256_file(target),
+        'registry_sha256': registry_sha256()}
+
+
+def test_fixture_seed_and_exclusive_files(tmp_path, monkeypatch):
+    from model import xRIR_cyl_oriented as models
+    monkeypatch.setattr(models, 'build_xrir_exp06',
+                        lambda *a: smoke.torch.nn.Linear(2, 2))
+    first, second = tmp_path / 'first.pth', tmp_path / 'second.pth'
+    before = smoke.torch.get_rng_state()
+    smoke.main(['--make-fixture', str(first)])
+    smoke.main(['--make-fixture', str(second), '--seed', '0'])
+    assert smoke.torch.equal(before, smoke.torch.get_rng_state())
+    left, right = [smoke.torch.load(p, weights_only=True) for p in (first, second)]
+    assert all(smoke.torch.equal(left[k], right[k]) for k in left)
+    with pytest.raises(SystemExit) as caught:
+        smoke.main(['--make-fixture', str(first)])
+    assert caught.value.code == 2
+
+
+@pytest.mark.parametrize('argv', [[], ['--entry', 'trainer', '--make-fixture', 'x'],
+                                ['--make-fixture', 'x', '--', '--child-flag']])
+def test_fixture_cli_refusals(argv):
+    with pytest.raises(SystemExit) as caught:
+        smoke.main(argv)
+    assert caught.value.code == 2
