@@ -0,0 +1,184 @@
+import json
+import os
+from pathlib import Path
+import subprocess
+
+import pytest
+
+from tools import exp06_finalize as f
+
+
+def write_json(path, value):
+    path.write_text(json.dumps(value))
+
+
+def closed_log(tmp_path, code=0):
+    path = tmp_path / 'child.log'
+    path.write_text('training done\nEXP06_CHILD_EXIT {} 2026-09-15T00:00:00+00:00\n'.format(code))
+    return path
+
+
+@pytest.mark.parametrize('kind', ['smoke', 'probe'])
+def test_diagnostic_without_artifacts(tmp_path, kind):
+    result = f.finalize(tmp_path, kind, tmp_path / 'absent.log', 3)
+    assert result['diagnostic'] is True
+    assert result['admissible_arm'] is False
+    assert result['child_exit'] == 3
+    before = (tmp_path / 'completion.json').read_bytes()
+    assert f.finalize(tmp_path, kind, tmp_path / 'absent.log', 3) == result
+    assert (tmp_path / 'completion.json').read_bytes() == before
+
+
+def test_receipt_binding_and_existing_refusal(tmp_path):
+    receipt = tmp_path / 'receipt.json'
+    write_json(receipt, {'diagnostic': True})
+    result = f.finalize(tmp_path, 'smoke', None, 0, receipt=receipt)
+    assert result['receipt'] == {'path': str(receipt), 'sha256': f.p.sha256_file(receipt)}
+    before = (tmp_path / 'completion.json').read_bytes()
+    with pytest.raises(ValueError, match='existing completion'):
+        f.finalize(tmp_path, 'probe', None, 0, receipt=receipt)
+    assert (tmp_path / 'completion.json').read_bytes() == before
+
+
+@pytest.mark.parametrize('text,code,cause', [
+    ('', 0, 'log marker'), ('running\n', 0, 'log marker'),
+    ('EXP06_CHILD_EXIT 1 2026-09-15T00:00:00+00:00\n', 0, 'log marker'),
+    ('EXP06_CHILD_EXIT 0 invalid\n', 0, 'log marker'),
+    ('EXP06_CHILD_EXIT 0 2026-09-15T00:00:00+00:00\n\n', 0, 'log marker'),
+    ('', 1, 'child_exit'),
+])
+def test_closed_log_refusals(tmp_path, text, code, cause):
+    log = tmp_path / 'child.log'
+    log.write_text(text)
+    with pytest.raises(ValueError, match=cause):
+        f._closed_log(log, code)
+    assert not (tmp_path / 'completion.json').exists()
+
+
+def test_closed_log_and_unknown_run(tmp_path):
+    assert f._closed_log(closed_log(tmp_path), 0)['child_exit'] == 0
+    with pytest.raises(ValueError, match='log'):
+        f._closed_log(tmp_path / 'missing', 0)
+    with pytest.raises(ValueError, match='run_type'):
+        f.finalize(tmp_path, 'unknown', None, 0)
+
+
+@pytest.fixture
+def repository(tmp_path):
+    repo = tmp_path / 'repo'
+    repo.mkdir()
+    subprocess.run(['git', 'init', '-q', str(repo)], check=True)
+    (repo / 'source.py').write_text('VALUE = 1\n')
+    subprocess.run(['git', 'add', 'source.py'], cwd=repo, check=True)
+    subprocess.run(['git', '-c', 'user.name=Test', '-c', 'user.email=test@example.com',
+                    'commit', '-qm', 'fixture'], cwd=repo, check=True)
+    return repo, f.p.git_state(repo)['HEAD']
+
+
+def test_preflight_head_dirty_and_worklog(repository, tmp_path):
+    repo, head = repository
+    kwargs = dict(repo=repo, reviewed_commit=head, gpu='0', run_type='smoke',
+                  attempt_root=tmp_path / 'attempts')
+    assert f.preflight(**kwargs)['HEAD'] == head
+    with pytest.raises(ValueError, match='HEAD'):
+        f.preflight(**dict(kwargs, reviewed_commit='0' * 40))
+    (repo / 'worklog').mkdir()
+    (repo / 'worklog/note.md').write_text('allowed')
+    assert f.preflight(**kwargs)['dirty'] is True
+    (repo / 'source.py').write_text('VALUE = 2\n')
+    with pytest.raises(ValueError, match='dirty_outside_worklog'):
+        f.preflight(**kwargs)
+
+
+@pytest.mark.parametrize('global_pid', [False, True])
+def test_preflight_live_pid(repository, tmp_path, global_pid):
+    repo, head = repository
+    root = tmp_path / 'attempts'
+    root.mkdir()
+    path = f.launch_lock_paths(repo)[1] if global_pid else root / 'launch.pid'
+    path.write_text(str(os.getpid()))
+    try:
+        with pytest.raises(ValueError, match='pid alive'):
+            f.preflight(repo, head, '0', 'smoke', root)
+    finally:
+        path.unlink()
+
+
+@pytest.mark.parametrize('mode', ['full', 'probe'])
+def test_preflight_gpu_fake(repository, tmp_path, monkeypatch, mode):
+    repo, head = repository
+    binary = tmp_path / 'nvidia-smi'
+    binary.write_text('#!/bin/sh\nprintf "%s\\n" "$FAKE_GPU_PID"\n')
+    binary.chmod(0o755)
+    monkeypatch.setenv('PATH', str(tmp_path) + os.pathsep + os.environ['PATH'])
+    monkeypatch.setenv('FAKE_GPU_PID', '')
+    assert f.preflight(repo, head, '1', mode, tmp_path / 'attempts')['HEAD'] == head
+    monkeypatch.setenv('FAKE_GPU_PID', '12345')
+    with pytest.raises(ValueError, match='GPU busy'):
+        f.preflight(repo, head, '1', mode, tmp_path / 'attempts')
+
+
+def manifest_for(repo, head, kind='full'):
+    files, digest = f.p.closure_record(['source.py'], head, repo)
+    inventory = [{'path': 'source.py', 'sha256': f.p.sha256_file(repo / 'source.py')}]
+    identity = dict(data_root=str(repo), inventory=inventory,
+                    inventory_sha256=f.p._inventory_digest(inventory))
+    return dict(repo=str(repo), reviewed_commit=head, run_type=kind,
+                source_closure={'files': files, 'sha256': digest},
+                source_closure_sha256=digest, git_state=f.p.git_state(repo),
+                train_data_identity=identity)
+
+
+def test_manifest_revalidation_and_clone_drift(repository, tmp_path):
+    repo, head = repository
+    manifest = manifest_for(repo, head)
+    f._verify_manifest(manifest, repo, 'full')
+    clone = tmp_path / 'clone'
+    subprocess.run(['git', 'clone', '-q', str(repo), str(clone)], check=True)
+    manifest['repo'] = str(clone)
+    f._verify_manifest(manifest, clone, 'full')
+    (clone / 'source.py').write_text('VALUE = 2\n')
+    with pytest.raises(ValueError, match='source_closure.*source.py'):
+        f._verify_manifest(manifest, clone, 'full')
+
+
+@pytest.mark.parametrize('change,cause', [
+    ('run_type', 'run_type'), ('digest', 'source_closure'), ('empty', 'source_closure'),
+    ('head', 'HEAD'), ('data', 'train_data_identity'), ('blob', 'source_closure'),
+])
+def test_manifest_refusals(repository, change, cause):
+    repo, head = repository
+    manifest = manifest_for(repo, head)
+    if change == 'run_type':
+        manifest['run_type'] = 'probe'
+    elif change == 'digest':
+        manifest['source_closure']['sha256'] = '0' * 64
+    elif change == 'empty':
+        manifest['source_closure']['files'] = []
+    elif change == 'head':
+        manifest['git_state']['HEAD'] = '0' * 40
+    elif change == 'data':
+        manifest['train_data_identity']['inventory'][0]['sha256'] = '0' * 64
+    else:
+        manifest['source_closure']['files'][0]['reviewed_blob_sha256'] = '0' * 64
+    with pytest.raises(ValueError, match=cause):
+        f._verify_manifest(manifest, repo, 'full')
+
+
+def test_cli_diagnostic_and_preflight(repository, tmp_path, capsys):
+    repo, head = repository
+    assert f.main(['preflight', '--repo', str(repo), '--reviewed-commit', head,
+                   '--gpu', '0', '--run-type', 'smoke', '--attempt-root', str(tmp_path)]) == 0
+    assert head in capsys.readouterr().out
+    assert f.main(['--run-dir', str(tmp_path), '--run-type', 'smoke',
+                   '--log', str(tmp_path / 'absent.log'), '--child-exit', '0']) == 0
+    assert json.loads(capsys.readouterr().out)['diagnostic'] is True
+
+
+def test_cli_refuses_before_writing(tmp_path, capsys):
+    with pytest.raises(SystemExit) as caught:
+        f.main(['--run-dir', str(tmp_path), '--run-type', 'full',
+                '--log', str(tmp_path / 'absent.log'), '--child-exit', '1'])
+    assert caught.value.code == 2
+    assert 'child_exit' in capsys.readouterr().err
+    assert not (tmp_path / 'completion.json').exists()
