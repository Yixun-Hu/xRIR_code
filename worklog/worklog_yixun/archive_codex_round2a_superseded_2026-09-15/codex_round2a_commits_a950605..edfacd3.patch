+"""In-process diagnostic runner; usage errors exit 2, exceeded bounds exit 3."""
+import argparse
+from datetime import datetime, timezone
+import importlib
+import json
+import math
+from pathlib import Path
+import signal
+import sys
+import time
+
+import torch
+
+from tools.provenance import git_state, sha256_file, write_manifest
+
+ENTRIES = {'trainer': 'train_xRIR_backbone', 'exp06_train': 'tools.exp06_train',
+           'exp06_haa_finetune': 'tools.exp06_haa_finetune',
+           'exp06_haa_eval': 'tools.exp06_haa_eval'}
+REPO = Path(__file__).resolve().parents[1]
+
+
+def build_parser():
+    parser = argparse.ArgumentParser(description=__doc__)
+    mode = parser.add_mutually_exclusive_group(required=True)
+    mode.add_argument('--entry', choices=sorted(ENTRIES))
+    mode.add_argument('--make-fixture', type=Path)
+    parser.add_argument('--seed', type=int, default=0)
+    parser.add_argument('--receipt', type=Path)
+    parser.add_argument('--alarm-seconds', type=int, default=300)
+    parser.add_argument('--max-gb', type=float, default=3)
+    parser.add_argument('argv', nargs=argparse.REMAINDER)
+    return parser
+
+
+def _alarm(signum, frame):
+    raise TimeoutError('alarm_seconds exceeded')
+
+
+def run(entry, argv, alarm_seconds=300, max_gb=3):
+    """Restore argv/handler on every exit and retain failure evidence."""
+    state, started = git_state(REPO), time.monotonic()
+    cuda = torch.cuda.is_available()
+    old_argv, previous = sys.argv, signal.signal(signal.SIGALRM, _alarm)
+    status, error = 0, None
+    try:
+        signal.alarm(alarm_seconds)
+        if cuda:
+            torch.cuda.reset_peak_memory_stats()
+        module = importlib.import_module(ENTRIES[entry])
+        if entry == 'trainer':
+            sys.argv = [module.__name__ if hasattr(module, '__name__') else ENTRIES[entry]] + argv
+            result = module.main()
+        else:
+            result = module.main(argv)
+        if isinstance(result, int):
+            status = result
+        if cuda:
+            torch.cuda.synchronize()
+    except SystemExit as exc:
+        status = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
+        error = str(exc)
+    except Exception as exc:
+        status, error = (3 if isinstance(exc, TimeoutError) else 1), str(exc)
+    finally:
+        signal.alarm(0)
+        signal.signal(signal.SIGALRM, previous)
+        sys.argv = old_argv
+    peak = torch.cuda.max_memory_allocated() if cuda else 0
+    if peak > max_gb * 1024**3:
+        status, error = 3, 'max_gb exceeded'
+    record = dict(diagnostic=True, entry=entry, argv=argv, wall_s=time.monotonic() - started,
+                  peak_bytes=peak, exit_status=status, git_head=state['HEAD'],
+                  timestamp=datetime.now(timezone.utc).isoformat())
+    if error is not None:
+        record['error'] = error
+    return record
+
+
+def make_fixture(path, seed=0):
+    """Write an exclusively created CPU state dict and its diagnostic identity."""
+    from model.xRIR_cyl_oriented import build_xrir_exp06
+    from tools.exp06_train import registry_sha256
+
+    path, sidecar = Path(path), Path(str(path) + '.json')
+    if path.exists() or sidecar.exists():
+        raise ValueError('fixture or sidecar already exists')
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with torch.random.fork_rng(devices=[]):
+        torch.manual_seed(seed)
+        model = build_xrir_exp06('cylindrical_oriented', 8).cpu()
+        with path.open('xb') as stream:
+            torch.save(model.state_dict(), stream)
+    record = dict(diagnostic=True, seed=seed, sha256=sha256_file(path),
+                  registry_sha256=registry_sha256())
+    write_manifest(sidecar, record)
+    return record
+
+
+def main(argv=None):
+    parser = build_parser()
+    args = parser.parse_args(argv)
+    if args.alarm_seconds <= 0 or not math.isfinite(args.max_gb) or args.max_gb <= 0:
+        parser.error('alarm_seconds and max_gb must be positive and finite')
+    if args.make_fixture:
+        if args.argv or args.receipt:
+            parser.error('make_fixture does not accept child argv or receipt')
+        try:
+            make_fixture(args.make_fixture, args.seed)
+        except (OSError, ValueError) as exc:
+            parser.error(str(exc))
+        return 0
+    child_argv = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
+    record = run(args.entry, child_argv, args.alarm_seconds, args.max_gb)
+    print('EXP06_SMOKE ' + json.dumps(record, sort_keys=True, allow_nan=False), flush=True)
+    if args.receipt:
+        args.receipt.parent.mkdir(parents=True, exist_ok=True)
+        write_manifest(args.receipt, record)
+    if record['exit_status']:
+        raise SystemExit(record['exit_status'])
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
