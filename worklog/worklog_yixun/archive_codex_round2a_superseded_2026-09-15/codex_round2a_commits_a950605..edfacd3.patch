@@ -0,0 +1,106 @@
+"""Exp_06 training entry point composing the pinned trainer's numerical helpers.
+
+Shared defaults match train_xRIR_backbone; the launch script supplies the exp_01
+recipe. Only the external finalizer may publish completion.json.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+
+import train_xRIR_backbone as trainer
+from model.xRIR_cyl_oriented import BACKBONES_EXP06, build_xrir_exp06
+from tools import provenance
+from tools.exp05_params import TIERS, count_parameters
+
+REPO = Path(__file__).resolve().parents[1]
+
+
+def build_parser():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--backbone', choices=sorted(BACKBONES_EXP06), required=True)
+    parser.add_argument('--save-dir', required=True)
+    for name, default in dict(num_shot=8, max_len=9600, decay_epochs=50, epochs=200,
+                              batch_size=64, accum_steps=1, num_workers=16, seed=0,
+                              yaw_aug_width=512, log_interval=20, save_every=500,
+                              epoch_ckpt_every=5, max_train_batches=0,
+                              max_test_batches=0, test_subset=0).items():
+        parser.add_argument('--' + name.replace('_', '-'), type=int, default=default)
+    for name, default in TIERS['M'].items():
+        parser.add_argument('--vit-' + name.replace('_', '-'), type=int, default=default)
+    for name, default in dict(lr=1e-3, weight_decay=1e-4, lr_gamma=0.1).items():
+        parser.add_argument('--' + name.replace('_', '-'), type=float, default=default)
+    parser.add_argument('--yaw-aug', type=int, choices=(0,), default=0)
+    parser.add_argument('--yaw-aug-seed', type=int, default=None)
+    parser.add_argument('--no-save', action='store_true')
+    parser.add_argument('--tf32', action='store_true')
+    parser.add_argument('--resume', default=None)
+    parser.add_argument('--run-type', choices=('full', 'smoke', 'probe'), default='full')
+    parser.add_argument('--provenance-out', default=None)
+    return parser
+
+
+def build_model_exp06(args):
+    config = {key: getattr(args, 'vit_' + key) for key in TIERS['M']}
+    if any(type(config[key]) is not int or config[key] != value for key, value in TIERS['M'].items()):
+        raise ValueError('vit_* must match tier M')
+    return build_xrir_exp06(args.backbone, args.num_shot, **config)
+
+
+def registry_sha256():
+    mapping = {name: cls.__module__ + '.' + cls.__qualname__ for name, cls in BACKBONES_EXP06.items()}
+    return hashlib.sha256(json.dumps(mapping, sort_keys=True).encode()).hexdigest()
+
+
+def _source_identity(repo):
+    state = provenance.git_state(repo)
+    files = provenance.source_closure('tools.exp06_train', repo) + ['tools/exp06_launch.sh']
+    records, digest = provenance.closure_record(files, state['HEAD'], repo)
+    return state, records, digest
+
+
+def prepare_args(args, model=None, repo=None):
+    """Add runtime identity; train_batches_per_epoch must come from the loader."""
+    repo = Path(repo or REPO).resolve()
+    if any(type(getattr(args, 'vit_' + key)) is not int or getattr(args, 'vit_' + key) != value
+           for key, value in TIERS['M'].items()):
+        raise ValueError('vit_* must match tier M')
+    model = build_model_exp06(args) if model is None else model
+    args.tier, args.param_counts = 'M', count_parameters(model)
+    args.yaw_aug_seed = args.seed if args.yaw_aug_seed is None else args.yaw_aug_seed
+    args.env = {key: os.environ.get(key) for key in
+                ('PYTHONHASHSEED', 'XRIR_DATA_PATH', 'OMP_NUM_THREADS', 'CUDA_VISIBLE_DEVICES')}
+    args.exp06_run_type = vars(args).pop('run_type', getattr(args, 'exp06_run_type', 'full'))
+    output = vars(args).pop('provenance_out', getattr(args, 'exp06_provenance_path', None))
+    output = output if args.no_save else Path(args.save_dir) / 'provenance.json'
+    args.exp06_provenance_path = str(Path(output).resolve()) if output else None
+    state, _, digest = _source_identity(repo)
+    args.exp06_git_head, args.exp06_source_closure_sha256 = state['HEAD'], digest
+    args.exp06_registry_sha256 = registry_sha256()
+    return args
+
+
+def train_data_identity(data_root, cache_path):
+    """Reuse the pinned cache read-only, or hash without creating any cache."""
+    if Path(cache_path).exists():
+        return provenance.train_data_identity(data_root, cache_path=cache_path, workers=1)
+    root = Path(data_root).resolve()
+    dataset = trainer.xRIR_Dataset(split='train', ir_path=str(root / 'single_channel_ir'))
+    files = sorted(str(Path(name).resolve().relative_to(root)) for name in dataset.file_list)
+    key = hashlib.sha256(json.dumps([str(root), len(files)]).encode()).hexdigest()
+    return dict(provenance._inventory(files, root, workers=1), split='train', cache_key=key)
+
+
+def build_provenance(args, repo=None, argv=None):
+    repo = Path(repo or REPO).resolve()
+    state, records, digest = _source_identity(repo)
+    if state['HEAD'] != args.exp06_git_head or digest != args.exp06_source_closure_sha256:
+        raise ValueError('source_closure changed while preparing provenance')
+    return dict(repo=str(repo), reviewed_commit=state['HEAD'], run_type=args.exp06_run_type,
+                source_closure=dict(files=records, sha256=digest), source_closure_sha256=digest,
+                registry_sha256=args.exp06_registry_sha256, git_state=state,
+                environment=provenance.environment(), train_data_identity=train_data_identity(
+                    os.environ['XRIR_DATA_PATH'], cache_path=repo / 'ckpt/yaw_aug/train_inventory.json'),
+                argv=list(sys.argv[1:] if argv is None else argv), runtime_args=dict(vars(args)))
