+@pytest.mark.parametrize('field,value', [('exp06_run_type', 'probe'),
+    ('exp06_git_head', 'bad'), ('exp06_registry_sha256', 'X' * 64),
+    ('exp06_source_closure_sha256', None), ('exp06_provenance_path', None)])
+def test_provenance_fields(field, value):
+    args = dict(complete_args(), exp06_run_type='full', exp06_git_head='a' * 40,
+                exp06_registry_sha256='b' * 64, exp06_source_closure_sha256='c' * 64,
+                exp06_provenance_path='/tmp/provenance.json')
+    assert r.check_all(args) == []
+    args[field] = value
+    assert any(field in d for d in r.check_all(args))
