+@pytest.mark.parametrize('no_save,explicit', [(False, False), (True, False), (True, True)])
+def test_main_artifacts_and_no_save(simulated_training, tmp_path, no_save, explicit):
+    destination, output = tmp_path / 'run', tmp_path / 'diagnostic.json'
+    argv = ['--backbone', 'simple', '--save-dir', str(destination), '--epochs', '2',
+            '--batch-size', '2', '--num-workers', '0', '--test-subset', '2', '--epoch-ckpt-every', '1']
+    argv += ['--no-save'] if no_save else []
+    argv += ['--provenance-out', str(output)] if explicit else []
+    train.main(argv)
+    assert simulated_training == [(1, 3, 3), (2, 3, 3)]
+    assert output.exists() == explicit
+    if no_save:
+        assert not destination.exists()
+        return
+    assert sorted(p.name for p in destination.iterdir()) == [
+        'args.json', 'best.pth', 'epoch_001.pth', 'epoch_002.pth', 'history.jsonl', 'last.pth', 'provenance.json']
+    args = json.loads((destination / 'args.json').read_text())
+    last = torch.load(destination / 'last.pth', map_location='cpu')
+    state = torch.load(destination / 'epoch_002.pth', map_location='cpu')
+    assert last['epoch'] == 2 and last['batch_idx'] == 0 and last['args'] == args
+    assert all(torch.equal(state[k], last['model'][k]) for k in state)
+    assert json.loads((destination / 'provenance.json').read_text())['runtime_args'] == args
+    assert [json.loads(line)['epoch'] for line in (destination / 'history.jsonl').read_text().splitlines()] == [1, 2]
+
+
+@pytest.mark.parametrize('batch_idx,epochs', [(0, [3]), (1, [2, 3])])
+def test_main_resume_epoch_rule(simulated_training, tmp_path, batch_idx, epochs):
+    argv = ['--backbone', 'simple', '--save-dir', str(tmp_path / 'first'), '--epochs', '2', '--num-workers', '0']
+    train.main(argv)
+    path = tmp_path / 'first' / 'last.pth'
+    checkpoint = torch.load(path, map_location='cpu')
+    checkpoint['batch_idx'] = batch_idx
+    resume = tmp_path / 'resume.pth'
+    torch.save(checkpoint, resume)
+    simulated_training.clear()
+    train.main(argv + ['--save-dir', str(tmp_path / 'second'), '--epochs', '3', '--resume', str(resume)])
+    assert [item[0] for item in simulated_training] == epochs
