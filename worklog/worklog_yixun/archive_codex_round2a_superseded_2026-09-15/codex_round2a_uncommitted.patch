+def test_parameter_reference_is_isolated_and_preserves_rng():
+    import torch
+    before = torch.random.get_rng_state()
+    counts = r.expected_param_counts('cylindrical_oriented')
+    assert torch.equal(before, torch.random.get_rng_state())
+    expected = counts['encoder']
+    counts['encoder'] = 0
+    assert r.expected_param_counts('cylindrical_oriented')['encoder'] == expected
+
