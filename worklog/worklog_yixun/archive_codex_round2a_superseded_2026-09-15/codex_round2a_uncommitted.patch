+@pytest.fixture
+def simulated_training(monkeypatch):
+    class Tiny(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.source_network = torch.nn.Linear(1, 1)
+        def cuda(self):
+            return self
+    events = []
+    def epoch(model, loader, optimizer, scheduler, epoch, args, best):
+        events.append((epoch, len(loader), args.train_batches_per_epoch))
+        optimizer.step()
+        scheduler.step()
+        return float(epoch)
+    monkeypatch.setattr(train, 'build_model_exp06', lambda args: Tiny())
+    monkeypatch.setattr(train, '_source_identity', lambda repo: ({'HEAD': 'a' * 40}, [], 'b' * 64))
+    monkeypatch.setattr(train.trainer, 'xRIR_Dataset', lambda split, **kwargs: list(range(5 if split == 'train' else 4)))
+    monkeypatch.setattr(train.trainer, 'train_epoch', epoch)
+    monkeypatch.setattr(train.trainer, 'test_epoch', lambda model, loader, epoch, args: 10.0 / epoch)
+    monkeypatch.setattr(train, 'build_provenance', lambda args, **kwargs: {'runtime_args': dict(vars(args))})
+    return events
