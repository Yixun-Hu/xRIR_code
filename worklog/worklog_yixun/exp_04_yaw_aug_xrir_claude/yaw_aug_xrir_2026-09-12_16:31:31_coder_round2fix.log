"""Re-run Fable round-2 mutants in a minimal source copy, never in the repository."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import time

REPO = Path('/home/yixunhu/codespace/xRIR_code')
ROOT = Path(__file__).resolve().parent
COPY = ROOT / 'copy'
PYTHON = '/home/yixunhu/miniconda3/envs/xRIR/bin/python'
FILES = ['train_xRIR_backbone.py', 'tools/yaw_aug.py', 'tools/yaw_rotation.py',
         'model/xRIR_cyl.py', 'model/xRIR.py', 'model/cylindrical_vit.py', 'model/simple_vit.py',
         'utils/spec_utils.py', 'utils/lr_scheduler.py',
         'treble_multi_room_dataset/treble_xRIR_dataset.py',
         'tests/test_train_yaw_aug.py', 'tests/test_yaw_aug.py', 'tests/conftest.py']


def prepare():
    COPY.mkdir(exist_ok=True)
    for relative in FILES:
        dst = COPY / relative
        dst.parent.mkdir(exist_ok=True)
        shutil.copyfile(str(REPO / relative), str(dst))
    for pycache in COPY.rglob('__pycache__'):
        shutil.rmtree(str(pycache))
    with (COPY / 'tests/conftest.py').open('a') as handle:
        handle.write('''\n\ndef pytest_sessionstart(session):
    import importlib
    from pathlib import Path
    expected = Path(__file__).resolve().parents[1]
    names = ('train_xRIR_backbone', 'tools.yaw_aug', 'tools.yaw_rotation',
             'model.xRIR_cyl', 'model.xRIR', 'model.cylindrical_vit', 'model.simple_vit',
             'utils.spec_utils', 'utils.lr_scheduler',
             'treble_multi_room_dataset.treble_xRIR_dataset')
    for name in names:
        module = importlib.import_module(name)
        assert expected in Path(module.__file__).resolve().parents, (name, module.__file__)
''')
    return {relative: (COPY / relative).read_text() for relative in FILES[:2]}


def run_pytest(name, target):
    env = dict(os.environ, PYTHONPATH=str(COPY), PYTHONDONTWRITEBYTECODE='1',
               CUDA_VISIBLE_DEVICES='1', XRIR_DATA_PATH='/home/yixunhu/data_cache/AcousticRooms',
               NUMBA_CACHE_DIR='/tmp/xrir_numba_cache', OMP_NUM_THREADS='2', PYTHONHASHSEED='0')
    command = [PYTHON, '-B', '-m', 'pytest', target, '-x', '-q', '-p', 'no:cacheprovider']
    started = time.time()
    completed = subprocess.run(command, cwd=str(COPY), env=env, text=True,
                               stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    (ROOT / (name + '.log')).write_text(completed.stdout)
    lines = completed.stdout.splitlines()
    failures = [line for line in lines if line.startswith('FAILED ')]
    result = dict(name=name, returncode=completed.returncode,
                  status='PASSED' if completed.returncode == 0 else 'KILLED' if failures else 'ERROR',
                  seconds=round(time.time() - started, 2),
                  summary=lines[-1] if lines else '', failure=failures[0] if failures else '')
    print(json.dumps(result), flush=True)
    return result


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--prepare-only', action='store_true')
    args = parser.parse_args()
    originals = prepare()
    if args.prepare_only:
        print('Prepared copy at ' + str(COPY))
        return
    results = [run_pytest('baseline', 'tests')]
    assert results[-1]['returncode'] == 0, results[-1]
    trainer = originals['train_xRIR_backbone.py']
    start = trainer.index('    print(f"yaw_aug ENABLED')
    end = trainer.index('\n', trainer.index('flush=True)', start)) + 1
    banner = trainer[start:end]
    indented_banner = ''.join('    ' + line for line in banner.splitlines(keepends=True))
    loop = '    for epoch in range(start_epoch, args.epochs + 1):\n        t0 = time.time()\n'
    train_line = '        train_loss = train_epoch(model, train_loader, optimizer, scheduler, epoch, args, best_test_loss)\n'
    tr, au = 'train_xRIR_backbone.py', 'tools/yaw_aug.py'
    mutants = [
        ('T1_sign_flip', tr, [('ks.to(depth_coord.device), W=yaw.W)', '(-ks).to(depth_coord.device), W=yaw.W)')]),
        ('T2_depth_only', tr, [('        depth_coord, src_loc, ref_locs = apply_yaw_aug(', '        depth_coord, _u1, _u2 = apply_yaw_aug(')]),
        ('T3_coords_only', tr, [('        depth_coord, src_loc, ref_locs = apply_yaw_aug(', '        _u0, src_loc, ref_locs = apply_yaw_aug(')]),
        ('T6_banner_inside_loop', tr, [(banner + loop, loop + indented_banner)]),
        ('T7_banner_after_training', tr, [(banner, ''), (train_line, train_line + indented_banner)]),
        ('A3_unrotated_refs', au, [('after = integer_delays(rotated_src, rotated_refs, sr=sr, c=c)', 'after = integer_delays(rotated_src, refs, sr=sr, c=c)')]),
    ]
    for name, relative, replacements in mutants:
        original = originals[relative]
        mutated = original
        for before, after in replacements:
            assert mutated.count(before) == 1, (name, before, mutated.count(before))
            mutated = mutated.replace(before, after)
        path = COPY / relative
        path.write_text(mutated)
        try:
            target = 'tests/test_train_yaw_aug.py' if relative == tr else 'tests/test_yaw_aug.py'
            results.append(run_pytest(name, target))
        finally:
            path.write_text(original)
    results.append(run_pytest('restored', 'tests'))
    (ROOT / 'results.json').write_text(json.dumps(results, indent=2) + '\n')
    assert results[-1]['returncode'] == 0, results[-1]
    assert all(result['status'] == 'KILLED' for result in results[1:-1]), results


if __name__ == '__main__':
    main()

