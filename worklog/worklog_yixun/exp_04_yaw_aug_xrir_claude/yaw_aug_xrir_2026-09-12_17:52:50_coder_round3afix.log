                       env=env, check=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        for name in ("per_sample_yaw.json", "metrics_yaw.json"):
            actual, expected = json.loads((output / name).read_text()), json.loads((baseline / name).read_text())
