+    bindings = [item for name in ('control_args', 'train_manifest', 'train_completion')
+                for item in ('--bind-input', name + '=' + str(paths['data']))]
+    parsed = launcher.parse_args(cli + ['--log-dir', args.log_dir, '--data-root', args.data_root,
