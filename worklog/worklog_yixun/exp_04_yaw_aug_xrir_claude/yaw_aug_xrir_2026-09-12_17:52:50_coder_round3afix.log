+    foreign = tmp_path / 'foreign.py'
+    foreign.write_text('VALUE = 3\n')
+    if symlink:
+        (root / 'helper.py').unlink()
+        (root / 'helper.py').symlink_to(foreign)
+    else:
+        (root / 'entry.py').write_text('import sys\nsys.path.append(%r)\nimport foreign\n' % str(tmp_path))
