            assert actual["meta"].pop("reviewed_commit") == commit
            actual["meta"].pop("elapsed_min")
            expected["meta"].pop("elapsed_min")
            if condition == "P":
                assert "E" not in actual
                expected.pop("E")
                expected["meta"]["e_acoustic_cols"] = []
            assert actual == expected

