+import hashlib
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from tools import provenance as p
+
+
+@pytest.fixture
+def repo(tmp_path):
+    root = tmp_path / 'repo'
+    root.mkdir()
+    def git(*args):
+        return subprocess.check_output(['git', *args], cwd=root).decode().strip()
