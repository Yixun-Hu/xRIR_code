        pytest.skip("AcousticRooms not available at XRIR_DATA_PATH={}".format(BASE_DATA_PATH))
    if not os.path.exists(PINNED_MANIFEST):
        pytest.skip("pinned manifest not found at {}".format(PINNED_MANIFEST))
