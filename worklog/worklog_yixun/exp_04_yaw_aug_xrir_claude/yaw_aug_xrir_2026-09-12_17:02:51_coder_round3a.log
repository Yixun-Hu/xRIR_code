+    try:
+        driver = subprocess.check_output(['nvidia-smi', '--query-gpu=driver_version',
+            '--format=csv,noheader'], stderr=subprocess.DEVNULL, text=True).splitlines()
+    except (OSError, subprocess.CalledProcessError):
