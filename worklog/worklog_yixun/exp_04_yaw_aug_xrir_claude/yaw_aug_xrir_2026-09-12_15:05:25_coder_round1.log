+@pytest.mark.parametrize("kwargs", [{"enabled": 1}, {"enabled": None}, {"W": 0}, {"W": -1},
+    {"W": True}, {"W": 1.0}, {"seed": 1.0}, {"seed": True}])
+def test_config_rejects_invalid_types(kwargs):
+    with pytest.raises(ValueError):
+        YawAug(**kwargs)
