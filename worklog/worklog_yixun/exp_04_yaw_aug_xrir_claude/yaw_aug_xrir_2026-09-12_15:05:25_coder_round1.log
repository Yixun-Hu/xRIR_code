+    # Evaluate trig in double precision like the scalar helper's Python math.
+    angles = 2.0 * math.pi * ks.to(torch.float64) / W
+    cos_a, sin_a = angles.cos().to(depth_coord.dtype), angles.sin().to(depth_coord.dtype)
+
+    def rotate(v):
