+"""Counter-seeded yaw augmentation: FLAC goldens and isolated geometry draws."""
+import random
+
+import numpy as np
+import pytest
+import torch
+
+from tools.yaw_aug import YawAug, apply_yaw_aug, counter, draw_offsets, fmix32, splitmix64, step_seed
+from tools.yaw_rotation import rotate_scene_yaw_batch
