+        profile = json_value(get_profile(name))
+        profile['n_boot'] = 2000
+        groups = [group for row, group in zip(table['rows'], admitted['groups'])
+                  if row['num_shot'] == profile['num_shot'] and row['role'] in ('aug', 'control')]
+        groups.reverse()  # TABLE_V1 is control, cyl, aug; paired analyses are aug, control.
+        for group in groups:
+            for run in group:
+                run['P'] = {str(k): run['P']['0'] for k in (0, 32, 64, 128, 256, 384, 448, 480)}
+        selected = dict(admitted, groups=groups[:1] if name == 'TOST_K8' else groups)
+        result = dict(pc.analyze(profile, selected), profile_name=name)
+        paths[name] = tmp_path / (name + '.json')
+        pc.write_outputs(result, selected, paths[name], tmp_path / (name + '.txt'))
+    paths['TABLE_V1'] = table_path
+    return paths
