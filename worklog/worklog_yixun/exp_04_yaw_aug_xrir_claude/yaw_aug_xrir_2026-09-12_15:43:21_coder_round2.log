+        _, rotated_src, rotated_refs = apply_yaw_aug(depth, src, refs, offsets, W=W)
+        before = integer_delays(src, refs, sr=sr, c=c)
+        after = integer_delays(rotated_src, rotated_refs, sr=sr, c=c)
