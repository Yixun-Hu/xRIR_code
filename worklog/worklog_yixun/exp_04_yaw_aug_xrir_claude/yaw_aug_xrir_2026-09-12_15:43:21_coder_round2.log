+class AuditBatch(tuple):
+    """Trainer's six tensors plus query paths, attached after loader collation."""
+    def __new__(cls, batch, query_paths):
+        instance = super().__new__(cls, batch)
+        instance.query_paths = query_paths
+        return instance
+
