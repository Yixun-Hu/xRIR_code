+        effective['path'] = str(attempt / 'effective_args.json')
+        guard = LogGuard(fields['effective_args'], fields['mode'], attempt)
+        guard.poll(log_path)
+        hours = (datetime.datetime.fromisoformat(execution['ended_at']) -
