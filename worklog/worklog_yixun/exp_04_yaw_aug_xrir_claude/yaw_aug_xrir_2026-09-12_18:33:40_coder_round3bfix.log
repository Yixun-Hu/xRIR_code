+            guard.feed('epoch 1 done')
+        elif failure == 'deadline':
+            path.unlink()
+            launch.run_child([launch.PYTHON, '-c', 'import time; time.sleep(60)'], path, gpu, guard, 0)
+        elif failure == 'nan':
