+        return {}
+    monkeypatch.setattr(launch, 'execute_attempt', execute)
+    argv = ['full', '--gpu', 'GPU-free', '--reviewed-commit', 'HEAD', '--probe-json', str(path), '--log-dir', str(tmp_path)]
+    if mutation:
+        with pytest.raises(ValueError, match='probe'):
+            launch.main(argv)
+    else:
+        launch.main(argv)
