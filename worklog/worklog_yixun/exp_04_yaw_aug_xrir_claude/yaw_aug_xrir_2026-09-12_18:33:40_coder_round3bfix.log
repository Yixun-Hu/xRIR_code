+            time.sleep(0.02)
+        assert pidfile.exists() and ready.exists()
+        child_pid = int(pidfile.read_text())
+        process.send_signal(signum)
+        process.wait(timeout=10)
+        aborted, = tmp_path.glob('attempt_t_ABORTED_*')
