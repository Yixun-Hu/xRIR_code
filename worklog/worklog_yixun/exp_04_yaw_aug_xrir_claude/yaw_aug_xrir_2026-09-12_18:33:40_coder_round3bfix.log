@pytest.mark.parametrize('mode,allow', [('full', False), ('full', True), ('smoke', False), ('probe', False)])
def test_dirty_training_gate(fake_manifest_inputs, tmp_path, monkeypatch, capsys, mode, allow):
    state = {'dirty_outside_worklog': True}
