+    receipt = dict(reviewed_commit='a' * 40, before={'gpu': 'GPU-free'}, after={'gpu': 'GPU-free'},
+        yaw_off={'mean_iteration_seconds': 1}, yaw_on={'mean_iteration_seconds': 1.05},
+        overhead_ratio=1.05, passed=True, PROBE_NOT_CLEAN=False)
