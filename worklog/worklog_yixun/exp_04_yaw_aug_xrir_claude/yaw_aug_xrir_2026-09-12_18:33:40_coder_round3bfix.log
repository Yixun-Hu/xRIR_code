+def abort_log(log_path, reason, created):
+    if not created:
+        return None
+    destination = log_path.with_name(log_path.stem + '_ABORTED_' + reason + '.log')
+    if destination.exists():
+        destination = destination.with_name(destination.stem + '_' + uuid.uuid4().hex + '.log')
+    try:
