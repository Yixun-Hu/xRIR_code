+        (root / 'helper.py').unlink()
+    else:
+        (root / 'helper.py').write_text('VALUE = 2\n')
+    if change == 'forged_blob':
+        records[0]['reviewed_blob_sha256'] = 'forged'
+    elif change == 'forged_digest':
