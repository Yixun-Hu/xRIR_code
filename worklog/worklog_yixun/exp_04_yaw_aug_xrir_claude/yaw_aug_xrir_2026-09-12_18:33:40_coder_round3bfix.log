+    expected.update(yaw_aug_seed=7, yaw_aug_width=256)
+    (attempt / 'args.json').write_text(json.dumps(expected))
+    (attempt / 'history.jsonl').write_text(json.dumps({'epoch_minutes': 120}))
+    guard = launch.LogGuard(expected, 'full')
