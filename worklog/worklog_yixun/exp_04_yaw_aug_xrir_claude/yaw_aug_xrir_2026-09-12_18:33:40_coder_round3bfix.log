+            'l.resource_gate=lambda *a: {}; '
+            'poll=l.LogGuard.poll; l.LogGuard.poll=lambda self, path: '
+            '(poll(self, path), Path(%r).touch() if self.steps else None); ' % str(ready) +
+            'l.execute_attempt(%r, %r, "1", %r, lambda: %r)' %
