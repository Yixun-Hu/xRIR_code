+    digest = p.write_manifest(sidecar, {'inventory': identity.pop('inventory')})
+    identity['inventory_file'] = {'path': str(sidecar), 'sha256': digest}
+    if mutation:
+        (sidecar if mutation == 'sidecar' else data).write_bytes(b'changed')
