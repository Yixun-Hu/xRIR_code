+        return {k: diagnostic_value(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [diagnostic_value(v) for v in value]
+    if isinstance(value, Path) or isinstance(value, float) and not math.isfinite(value):
