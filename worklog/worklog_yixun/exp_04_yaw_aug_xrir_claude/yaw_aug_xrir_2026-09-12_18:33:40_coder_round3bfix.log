+    except (KeyError, TypeError, ValueError):
+        valid = False
+    if not valid or p.sha256_file(path) != digest:
+        raise ValueError('full requires a clean passing probe bound to reviewed commit and GPU')
+    return {'path': str(path), 'sha256': digest}
