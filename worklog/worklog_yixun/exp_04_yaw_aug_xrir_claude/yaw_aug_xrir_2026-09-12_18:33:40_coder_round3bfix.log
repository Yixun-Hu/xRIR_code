+class LauncherTerminated(BaseException):
+    def __init__(self, signum):
+        self.signum = signum
+        super().__init__(signal.Signals(signum).name)
+
+
+class LauncherFailure(ValueError):
+    def __init__(self, reason, message):
+        self.reason = reason
+        super().__init__(message)
