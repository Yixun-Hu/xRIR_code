+@pytest.mark.parametrize('failure,reason', [('args', 'guard_runtime_args'), ('banner', 'guard_banner'),
+    ('epoch', 'guard_epoch_one'), ('deadline', 'deadline_43h'), ('exit', 'child_exit_3'),
+    ('nan', 'child_failed'), ('runtime_json', 'guard_runtime_args'),
