    if mode == 'smoke':
        assert calls[0][0].name == '_smoke_test'
    else:
        assert result['PROBE_NOT_CLEAN'] is True and result['overhead_ratio'] == 1
        assert result['before']['compute_apps'] and result['after']['utilization_gpu'] == 90
