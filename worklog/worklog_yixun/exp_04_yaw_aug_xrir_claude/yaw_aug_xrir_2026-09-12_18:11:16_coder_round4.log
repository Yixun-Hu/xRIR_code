+                                      'launcher': None, 'producer': None}),
+             'max_samples': 0, 'batch_size': 16, 'tf32': False})
+H1 = MP({**COMMON, 'mode': 'two_arm', 'arms': (AUG, CONTROL), 'grid': (0,),
