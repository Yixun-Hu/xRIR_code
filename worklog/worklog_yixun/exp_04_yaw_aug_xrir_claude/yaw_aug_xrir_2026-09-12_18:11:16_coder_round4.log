+              'sha256': '651e3a377e110022fbd89332ff1f1c2648ef398bd83840bf369b05eb5decbedf'})
+CYL = MP({'label': 'CylindricalViT', 'backbone': 'cylindrical', 'role': 'cyl', 'epoch': 12,
