+
+@pytest.mark.parametrize('name,count,word', [('H1_K1', 3, 'non-inferior'),
+    ('H2_K8', 12, 'not supported'), ('TOST_K8', 21, 'equivalent')])
+def test_other_profiles_use_block_baselines_and_families(admission_fixture, name, count, word):
