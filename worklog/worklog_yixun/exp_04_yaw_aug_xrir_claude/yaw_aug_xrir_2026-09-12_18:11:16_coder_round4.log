+    calls = []
+    def unstable(samples, alpha):
+        calls.append(alpha)
+        # compute(seed0), cluster, then convergence evaluates seed0 and seed1.
+        if alpha == target and calls.count(alpha) % (4 if target == .05 else 3) == 0:
+            return (0, 100)
+        return original(samples, alpha)
