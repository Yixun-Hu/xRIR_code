+    queries = [row['query'] for row in reference['entries']]
+    digest = hashlib.sha256(json.dumps(queries, separators=(',', ':')).encode()).hexdigest()
+    dataset = profiles.COMMON['dataset']
+    assert digest == dataset['query_sha256']
