+BLOCKS = MP({'aug': (0, 32, 64, 128, 256, 384, 448, 480),
+             'control': (0, 32, 64, 448, 480)})
+PROFILES = MP({
+    'H1_K8': MP({**H1, 'num_shot': 8}),
