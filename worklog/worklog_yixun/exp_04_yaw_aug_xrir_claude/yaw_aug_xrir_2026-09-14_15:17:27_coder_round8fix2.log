}


def pytest_collection_modifyitems(config, items):
    added = 0
    for item in items:
        filename = Path(str(item.fspath)).name
        name = getattr(item, 'originalname', item.name.split('[')[0])
        params = getattr(getattr(item, 'callspec', None), 'params', {})
        key = (filename, name)
        selected = (
            name in _ALWAYS.get(filename, ()) or
            key == ('test_exp04_launcher.py', 'test_completion_transaction_and_failed_promotion')
            and params.get('boundary') is not None or
            key == ('test_exp04_launcher.py', 'test_abort_diagnostics_and_owned_log')
            and params.get('failure') == 'deadline' or
            key == ('test_exp04_eval_launch.py', 'test_foreign_log_is_preserved')
            and params.get('collision') == 'aborted' or
            key == ('test_exp05_eval_launch.py', 'test_tier_binding_and_completion')
            and params.get('fault') != 'args_mismatch')
        if selected:
            reason = ('user forbids signalling any process; DataLoader worker cleanup may terminate workers'
                      if filename == 'test_reference_manifest.py' else
                      'user forbids signalling any process; test or launcher cleanup sends signals')
            item.add_marker(pytest.mark.skip(reason=reason))
            added += 1
    config._xrir_no_signals_added_skips = added


def pytest_terminal_summary(terminalreporter, exitstatus, config):
    terminalreporter.write_sep('-', 'no-process-signals policy: {} added skips'.format(
        getattr(config, '_xrir_no_signals_added_skips', 0)))
