import sys


def _refuse_process_signals(event, args):
    if event in ('os.kill', 'os.killpg') and args[1] != 0:
        raise RuntimeError('user forbids signalling any process: {} signal {}'.format(event, args[1]))


sys.addaudithook(_refuse_process_signals)

