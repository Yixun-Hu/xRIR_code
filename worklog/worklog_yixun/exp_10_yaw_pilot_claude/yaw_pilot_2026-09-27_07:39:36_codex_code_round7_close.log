     3	# evidence, canonical summary (4 arms), CPU-protocol summary, backend-sensitivity table, results
     4	# Markdown + HTML, then an explicitly listed asset set with SHA256SUMS published atomically.
     5	#
     6	# Two blockers from the Codex tooling review shape this script:
     7	#   finding 1 — the preflight now *validates and binds* the prescribed evidence for every arm
     8	#     (validate_runs.py: full + probe meta, check_online bound and ok, probe controls ok, probe
     9	#     and full parity for the K = 8 arms, the CPU record with its documented parity failure).
    10	#     Its report is published as `validation.json`.
    11	#   finding 2 — the asset set is built in a fresh staging directory from an EXPLICIT list (no
    12	#     globs of neighbouring files), every expected file is verified present, nothing unexpected
    13	#     is allowed in, SHA256SUMS is written and `sha256sum -c`-verified there, and only then does
    14	#     `generated/` get replaced by a rename. Any error at any point leaves `generated/` and the
    15	#     published Markdown / HTML exactly as they were — the rollback copies of all three are
    16	#     kept until every one of the three publications has succeeded (round-4 review, finding 2),
    17	#     and a *signal* rolls them back just like an error does (round-5 review, finding 1: SIGTERM
    18	#     immediately before the final rename left new assets + new HTML + the old Markdown, and
    19	#     the EXIT cleanup deleted both backups because the destinations existed).
    20	#   round-6 review — every rollback copy is now completed and verified *while nothing has been
    21	#     published yet* and marked complete only then, because `started` used to precede the
    22	#     report copies: a `cp` that failed half-way left a truncated backup whose existence
    23	#     restore() took for proof of completeness, so it deleted the intact published report and
    24	#     installed the truncation (finding 1). And a rollback, once entered, always deals with
    25	#     all three artefacts, with TERM / INT / HUP ignored for its whole duration, because
    26	#     SIGTERM inside an explicit rollback used to leave old assets + new HTML + old Markdown
    27	#     (finding 2).
    28	#
    29	# Every validation report is bound by the run directory it names, with no exception: the
    30	# relocation alias this script used to pass for the CPU record accepted the GPU arm's
    31	# reports (same basename, another execution) as the CPU protocol's evidence and reached
    32	# `FINISH DONE` with them (round-4 review, finding 1). The CPU record's reports were
    33	# regenerated in place and name `ckpt/exp10/cpu_protocol/released_k8_all` themselves.
    34	#
    35	# usage: exp10_finish.sh          (no arguments)
    36	# env:   EXP10_REPO_ROOT, EXP10_EXPECT_N — overrides for the tests; the production defaults are
    37	#        the repository path and 6337 queries, and both are logged.
    38	set -euo pipefail
    39	REPO=${EXP10_REPO_ROOT:-/home/yixunhu/codespace/xRIR_code}
    40	EXPECT_N=${EXP10_EXPECT_N:-6337}
    41	cd "$REPO"
    42	source ~/miniconda3/etc/profile.d/conda.sh; conda activate xRIR
    43	export PYTHONPATH=${PYTHONPATH:-}:$(pwd); export CUDA_VISIBLE_DEVICES=""
    44	E=worklog/worklog_yixun/exp_10_yaw_pilot_claude; A=$E/yaw_pilot_results_assets; G=$A/generated
    45	LOG=$E/yaw_pilot_$(date +%Y-%m-%d_%H:%M:%S)_finish.log
    46	say() { echo "[$(date +%H:%M:%S)] $*" | tee -a "$LOG"; }
    47	ARMS="released_k8 released_k1 control_k8 cyl_k8"
    48	CPU=ckpt/exp10/cpu_protocol
    49	STAGE=$A/generated.staging.$$
    50	TMPOUT=$A/.finish_tmp.$$
    51	PREV=$A/generated.previous.$$          # the verified copy of the asset set this run replaces
    52	PREVT=$A/.finish_prev_assets.$$        # ... where that copy is made and verified first
    53	PREVR=$A/.finish_prev.$$               # the verified copies of the Markdown / HTML it replaces
    54	PREVRT=$PREVR.tmp                      # ... where those copies are made and verified first
    55	DONE=.backup_complete                  # the marker that says one backup copy is whole
    56	REPORTS="yaw_pilot_01_results.html yaw_pilot_results.md"
    57	
    58	# ---- publication state, the rollback, and the traps that use them (round-5, finding 1) ------
    59	# Publishing replaces three artefacts and cannot be one atomic step, so the state is tracked
    60	# explicitly: `started` means the three may be a mixed generation and the backups are the only
    61	# copies of the previous publication; `committed` means all three are published and the backups
    62	# may go; `rolled_back` means restore() has already dealt with them. EVERY exit path — an
    63	# unguarded error, a failed rename, SIGTERM / SIGINT / SIGHUP — rolls all three back while the
    64	# state is `started`, and only `committed` — or `idle`, where nothing has been touched at all —
    65	# lets the EXIT cleanup delete a backup that still holds bytes. What was there *before* this
    66	# run is recorded before the first mutation, so the rollback can preserve original absence too
    67	# (an artefact this run created is removed, not "restored" from a backup that never existed).
    68	#
    69	# A backup is restored from only when it is *known whole*: it is copied under a temporary name
    70	# while the state is still `idle`, verified against the original (`cmp` for a report, a
    71	# recursive `diff` for the asset directory), renamed into its backup slot and only then marked
    72	# complete. restore() installs nothing that carries no marker, so a copy that failed half-way
    73	# can never overwrite the intact artefact it was copied from (round-6 review, finding 1: the
    74	# state went to `started` first, and the mere existence of a truncated backup was taken for
    75	# proof of completeness). The markers are files under `$PREVR`, never inside `$PREV`, whose
    76	# contents become the published asset set again the moment it is restored.
    77	#
    78	# And a rollback, once entered, runs to its end: TERM / INT / HUP are ignored for its whole
    79	# duration — on every entry path, the explicit restore() after a failed publication as much as
    80	# the trap-driven one — and the state becomes `rolled_back` only after the last of the three
    81	# artefacts (round-6 review, finding 2: an explicit rollback marked itself done first and kept
    82	# the handlers armed, so SIGTERM during it left three generations mixed). A signal delivered
    83	# inside a rollback is therefore discarded, not queued, and the status reports what actually
    84	# triggered the rollback: the failure's own code, or 128 + the signal that arrived first.
    85	PUB_STATE=idle                         # idle | started | committed | rolled_back
    86	PRE_G=0                                # did the asset directory exist before this run?
    87	declare -A PRE_REPORT=()               # ... and each of the two reports?
    88	KEEP_BACKUPS=0                         # restoration failed: the backups are the last copies
    89	restore() {   # <what failed> — put all three artefacts back exactly as they were
    90	  # Nothing here hides why an operation failed: whatever `rm` / `mv` print is the diagnosis
    91	  # for the KEPT list below, so it is left on stderr rather than discarded.
    92	  local what=$1 restored="" kept="" pre f
    93	  trap '' HUP INT TERM                           # a rollback is never cut in half (finding 2)
    94	  if [ -d "$PREV" ] && [ -f "$PREVR/generated$DONE" ]; then   # a whole copy of the old set
    95	    rm -rf "$G" || true
    96	    if [ ! -e "$G" ] && mv "$PREV" "$G"; then restored="$restored $G"
    97	    else kept="$kept $PREV (the asset set this run replaced)"; fi
    98	  elif [ -d "$PREV" ]; then                      # ... an unverified one is never installed
    99	    kept="$kept $PREV (an INCOMPLETE copy of the asset set; $G was left exactly as it is)"
   100	  elif [ "$PRE_G" = 0 ] && [ -d "$G" ]; then     # there was none: this run created it
   101	    rm -rf "$G" || true
   102	    if [ ! -e "$G" ]; then restored="$restored $G (removed: this run created it)"
   103	    else kept="$kept $G (this run created it and it could not be removed)"; fi
   104	  fi
   105	  for f in $REPORTS; do
   106	    pre=${PRE_REPORT[$f]:-0}
   107	    if [ -f "$PREVR/$f" ] && [ -f "$PREVR/$f$DONE" ]; then   # a whole copy: put it back
   108	      rm -f "$E/$f" || true
   109	      if [ ! -e "$E/$f" ] && mv "$PREVR/$f" "$E/$f"; then restored="$restored $E/$f"
   110	      else kept="$kept $PREVR/$f (the $f this run replaced)"; fi
   111	    elif [ -f "$PREVR/$f" ]; then                # ... an unverified one is never installed
   112	      kept="$kept $PREVR/$f (an INCOMPLETE copy of $f; $E/$f was left exactly as it is)"
   113	    elif [ "$pre" = 0 ] && [ -f "$E/$f" ]; then  # absent before this run: absent after it
   114	      rm -f "$E/$f" || true
   115	      if [ ! -e "$E/$f" ]; then restored="$restored $E/$f (removed: this run created it)"
   116	      else kept="$kept $E/$f (this run created it and it could not be removed)"; fi
   117	    fi
   118	  done
   119	  PUB_STATE=rolled_back                          # all three are dealt with (finding 2)
   120	  if [ -z "$kept" ]; then
   121	    rm -rf "$PREVR" || true
   122	    say "REFUSED: publishing $what failed; restored:$restored"
   123	  else
   124	    KEEP_BACKUPS=1
   125	    say "REFUSED: publishing $what failed; restored:$restored; NOT RESTORED — these are KEPT for inspection by hand, each with what it holds:$kept"
   126	  fi
   127	}
   128	cleanup() {
   129	  rc=$?
   130	  local left d
   131	  trap - EXIT; trap '' HUP INT TERM              # no re-entry while things are put back
   132	  if [ -d "$STAGE" ]; then rm -rf "$STAGE" || true; fi
   133	  if [ -d "$TMPOUT" ]; then rm -rf "$TMPOUT" || true; fi
   134	  # An unverified copy is never restored from, so it is never kept either (finding 1).
   135	  rm -rf "$PREVT" "$PREVRT" 2>/dev/null || true
   136	  # A death between the three publications (an unguarded error, a signal) must roll all three
   137	  # back, and must never leave a backup behind as the only copy of the previous publication.
   138	  if [ "$PUB_STATE" = started ]; then restore "the publication (it was interrupted)"; fi
   139	  if [ "$PUB_STATE" = idle ] || [ "$PUB_STATE" = committed ]; then
   140	    # `idle`: nothing was published, so every backup is a copy of an untouched artefact.
   141	    # `committed`: all three are published. Either way the copies may go.
   142	    rm -rf "$PREV" "$PREVR" 2>/dev/null || true
   143	  elif [ "$KEEP_BACKUPS" = 1 ]; then
   144	    left=""
   145	    for d in "$PREV" "$PREVR"; do if [ -e "$d" ]; then left="$left $d"; fi; done
   146	    if [ -n "$left" ]; then
   147	      say "KEPT:$left — the rollback could not put everything back; the REFUSED line above says what each of these holds, so do not delete them by hand"
   148	    else
   149	      say "NOT RESTORED: the publication could not be put back; the REFUSED line above says what is where"
   150	    fi
   151	  else
   152	    for d in "$PREV" "$PREVR"; do                # a successful rollback consumed these; only
   153	      if [ -d "$d" ]; then                       # an empty staging directory may be deleted
   154	        if [ -n "$(find "$d" -type f -print -quit 2>/dev/null)" ]; then
   155	          KEEP_BACKUPS=1
   156	          say "KEPT: $d still holds files, so it is not deleted"
   157	        else rm -rf "$d" 2>/dev/null || true; fi
   158	      fi
   159	    done
   160	  fi
   161	  # The closing line may only claim the previous publication is back when it *is* back: the
   162	  # round-4 review's finding 2 was a cleanup that said nothing had changed while three
   163	  # generations were mixed, and a failed rollback is that same claim.
   164	  if [ "$rc" -ne 0 ] && [ "$KEEP_BACKUPS" = 1 ]; then
   165	    say "FINISH FAILED rc=$rc — the publication could NOT be put back in full; the KEPT paths above hold what was there before"
   166	  elif [ "$rc" -ne 0 ]; then
   167	    say "FINISH FAILED rc=$rc — $G, the Markdown report and the HTML page are the publication that was there before"
   168	  fi
   169	}
   170	on_signal() {   # <name> <number> — roll back through the EXIT trap; never re-raise the signal
   171	  trap '' HUP INT TERM
   172	  case $PUB_STATE in                             # the message may only claim what is true
   173	    started) say "FINISH INTERRUPTED: SIG$1 received; rolling the publication back" ;;
   174	    committed) say "FINISH INTERRUPTED: SIG$1 received after the publication was complete" ;;
   175	    rolled_back) say "FINISH INTERRUPTED: SIG$1 received; the rollback has already run" ;;
   176	    *) say "FINISH INTERRUPTED: SIG$1 received; nothing has been published, so there is nothing to roll back" ;;
   177	  esac
   178	  exit $((128 + $2))
   179	}
   180	trap cleanup EXIT
   181	trap 'on_signal TERM 15' TERM
   182	trap 'on_signal INT 2' INT
   183	trap 'on_signal HUP 1' HUP
   184	mkdir -p "$STAGE" "$TMPOUT"
   185	say "HEAD $(git rev-parse HEAD 2>/dev/null || echo unknown); repo $REPO; expect n=$EXPECT_N"
   186	
   187	# ---- preflight: the evidence, validated and bound (finding 1) -------------------------------
   188	python "$A/validate_runs.py" --root ckpt/exp10 --arms $ARMS --expect-n "$EXPECT_N" \
   189	  --device cuda --cpu-run "$CPU/released_k8_all" \
   190	  --json "$STAGE/validation.json" 2>&1 | tee -a "$LOG"
   191	say "preflight passed: four GPU arms + the CPU record validated and bound"
   192	
   193	# ---- canonical summaries, then the backend table -------------------------------------------
   194	python tools/exp10_summarize.py --runs ckpt/exp10/released_k8_all ckpt/exp10/released_k1_all \
   195	  ckpt/exp10/control_k8_all ckpt/exp10/cyl_k8_all --out ckpt/exp10/summary 2>&1 | tee -a "$LOG"
   196	python tools/exp10_summarize.py --runs "$CPU/released_k8_all" --out "$CPU/summary" 2>&1 | tee -a "$LOG"
   197	python "$A/make_backend_table.py" --gpu ckpt/exp10/summary/yaw_pilot_summary.json \
   198	  --cpu "$CPU/summary/yaw_pilot_summary.json" --arm released_k8 \
   199	  --out-md "$STAGE/backend_sensitivity_released_k8.md" \
   200	  --out-json "$STAGE/backend_sensitivity_released_k8.json" 2>&1 | tee -a "$LOG"
   201	
   202	# ---- the asset set, copied file by file (finding 2) ----------------------------------------
   203	EXPECTED="validation.json backend_sensitivity_released_k8.md backend_sensitivity_released_k8.json"
   204	PAR=""; ONL=""; PRB=""
   205	for a in $ARMS; do
   206	  mkdir -p "$STAGE/runs/$a"
   207	  cp "ckpt/exp10/${a}_all/meta.json"                          "$STAGE/runs/$a/meta_all.json"
   208	  cp "ckpt/exp10/${a}_all/check_online.json"                  "$STAGE/runs/$a/check_online_all.json"
   209	  cp "ckpt/exp10/${a}_probe/meta.json"                        "$STAGE/runs/$a/meta_probe.json"
   210	  cp "ckpt/exp10/${a}_probe/summary/yaw_pilot_summary.json"   "$STAGE/runs/$a/probe_summary.json"
   211	  EXPECTED="$EXPECTED runs/$a/meta_all.json runs/$a/check_online_all.json runs/$a/meta_probe.json runs/$a/probe_summary.json"
   212	  ONL="$ONL $a=ckpt/exp10/${a}_all/check_online.json"
   213	  PRB="$PRB $a=ckpt/exp10/${a}_probe/summary/yaw_pilot_summary.json"
   214	  if [ -f "ckpt/exp10/${a}_all/parity_exp03.json" ]; then   # released_k1 has no predecessor
   215	    cp "ckpt/exp10/${a}_all/parity_exp03.json"    "$STAGE/runs/$a/parity_exp03_all.json"
   216	    cp "ckpt/exp10/${a}_probe/parity_exp03.json"  "$STAGE/runs/$a/parity_exp03_probe.json"
   217	    EXPECTED="$EXPECTED runs/$a/parity_exp03_all.json runs/$a/parity_exp03_probe.json"
   218	    PAR="$PAR $a=ckpt/exp10/${a}_all/parity_exp03.json"
   219	  fi
   220	done
   221	mkdir -p "$STAGE/cpu_protocol"
   222	cp "$CPU/released_k8_all/meta.json"          "$STAGE/cpu_protocol/meta_all.json"
   223	cp "$CPU/released_k8_all/check_online.json"  "$STAGE/cpu_protocol/check_online_all.json"
   224	cp "$CPU/released_k8_all/parity_exp03.json"  "$STAGE/cpu_protocol/parity_exp03_all.json"
   225	cp "$CPU/summary/yaw_pilot_summary.json"     "$STAGE/cpu_protocol/yaw_pilot_summary.json"
   226	cp "$CPU/summary/yaw_pilot_tables.md"        "$STAGE/cpu_protocol/yaw_pilot_tables.md"
   227	cp "$CPU/summary/yaw_pilot_gaps.csv"         "$STAGE/cpu_protocol/yaw_pilot_gaps.csv"
   228	cp "$CPU/summary/yaw_pilot_gaps_released_k8.png" "$STAGE/cpu_protocol/yaw_pilot_gaps_released_k8_cpu.png"
   229	cp "$CPU/summary/yaw_pilot_gaps_released_k8.pdf" "$STAGE/cpu_protocol/yaw_pilot_gaps_released_k8_cpu.pdf"
   230	EXPECTED="$EXPECTED cpu_protocol/meta_all.json cpu_protocol/check_online_all.json cpu_protocol/parity_exp03_all.json"
   231	EXPECTED="$EXPECTED cpu_protocol/yaw_pilot_summary.json cpu_protocol/yaw_pilot_tables.md cpu_protocol/yaw_pilot_gaps.csv"
   232	EXPECTED="$EXPECTED cpu_protocol/yaw_pilot_gaps_released_k8_cpu.png cpu_protocol/yaw_pilot_gaps_released_k8_cpu.pdf"
   233	
   234	# ---- the report: HTML first (it copies this summary's own outputs into the staging set) -----
   235	HREF=$(python -c "import os,sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))" "$G" "$E")
   236	BACKEND="$STAGE/backend_sensitivity_released_k8.md"
   237	CPUREC="$STAGE/cpu_protocol/yaw_pilot_tables.md"
   238	python "$A/make_results_html.py" --summary ckpt/exp10/summary/yaw_pilot_summary.json \
   239	  --out "$TMPOUT/yaw_pilot_01_results.html" --assets "$STAGE" --assets-href "$HREF" \
   240	  --backend-table "$BACKEND" --cpu-record "$CPUREC" \
   241	  --parity $PAR --check-online $ONL --probe $PRB 2>&1 | tee -a "$LOG"
   242	python "$A/make_results_md.py" --summary ckpt/exp10/summary/yaw_pilot_summary.json \
   243	  --out "$TMPOUT/yaw_pilot_results.md" --assets "$STAGE" --assets-href "$HREF" \
   244	  --backend-table "$BACKEND" --cpu-record "$CPUREC" \
   245	  --parity $PAR --check-online $ONL --probe $PRB 2>&1 | tee -a "$LOG"
   246	EXPECTED="$EXPECTED yaw_pilot_summary.json yaw_pilot_tables.md yaw_pilot_gaps.csv"
   247	EXPECTED="$EXPECTED yaw_pilot_gaps_all_arms.png yaw_pilot_gaps_all_arms.pdf"
   248	for a in $ARMS; do EXPECTED="$EXPECTED yaw_pilot_gaps_${a}.png yaw_pilot_gaps_${a}.pdf"; done
   249	
   250	# ---- the staged set is exactly the expected set, and it verifies --------------------------
   251	MISSING=""
   252	for f in $EXPECTED; do
   253	  if [ ! -f "$STAGE/$f" ]; then MISSING="$MISSING $f"; fi
   254	done
   255	if [ -n "$MISSING" ]; then say "REFUSED: the staged asset set is incomplete:$MISSING"; exit 8; fi
   256	EXTRA=""
   257	while IFS= read -r f; do
   258	  case " $EXPECTED " in
   259	    *" $f "*) ;;
   260	    *) EXTRA="$EXTRA $f" ;;
   261	  esac
   262	done < <(cd "$STAGE" && find . -type f ! -name SHA256SUMS -printf '%P\n' | sort)
   263	if [ -n "$EXTRA" ]; then say "REFUSED: unexpected files in the staged asset set:$EXTRA"; exit 8; fi
   264	( cd "$STAGE" && find . -type f ! -name SHA256SUMS -printf '%P\0' | sort -z | xargs -0 sha256sum > SHA256SUMS )
   265	( cd "$STAGE" && sha256sum -c --quiet SHA256SUMS ) 2>&1 | tee -a "$LOG"
   266	say "staged $(wc -l < "$STAGE/SHA256SUMS") assets; SHA256SUMS verifies"
   267	
   268	# ---- publish: all three artefacts, or none of them (finding 2) ----------------------------
   269	# The previous assets used to be deleted as soon as the new ones were in place, before either
   270	# report was published, so a failing final rename left new assets + new HTML + old Markdown
   271	# (three generations mixed) while the cleanup claimed nothing had changed. Every backup is
   272	# now kept until all three publications have succeeded — and the same rollback runs when the
   273	# script is *terminated* here (round-5 review, finding 1), which is why the pre-run state is
   274	# recorded before the first mutation: restore() must be able to tell an artefact it has to put
   275	# back from one this run created, which has to be removed again.
   276	if [ -d "$G" ]; then PRE_G=1; fi
   277	for f in $REPORTS; do
   278	  PRE_REPORT[$f]=0
   279	  if [ -f "$E/$f" ]; then PRE_REPORT[$f]=1; fi
   280	done
   281	# The rollback copies, made and verified while the publication is still untouched (round-6
   282	# review, finding 1). Each is copied under a temporary name, compared with the original it was
   283	# copied from, renamed into its backup slot and only then marked complete — so a copy that
   284	# failed or was interrupted half-way is never a backup restore() can find, and the artefact it
   285	# was copied from has not been touched at all. Nothing below `PUB_STATE=started` has mutated
   286	# the publication, which is why an `idle` exit may simply drop every copy.
   287	mkdir -p "$PREVR" "$PREVRT"
   288	for f in $REPORTS; do
   289	  if [ "${PRE_REPORT[$f]}" = 0 ]; then continue; fi
   290	  if ! cp -p "$E/$f" "$PREVRT/$f"; then
   291	    say "REFUSED: the rollback copy of $f could not be made; nothing has been published"
   292	    exit 12
   293	  fi
   294	  if ! cmp "$E/$f" "$PREVRT/$f" > "$TMPOUT/backup_check.txt" 2>&1; then
   295	    say "REFUSED: the rollback copy of $f is not byte-identical to $E/$f ($(tr '\n' ' ' < "$TMPOUT/backup_check.txt")); nothing has been published"
   296	    exit 12
   297	  fi
   298	  mv "$PREVRT/$f" "$PREVR/$f"
   299	  : > "$PREVR/$f$DONE"
   300	done
   301	if [ "$PRE_G" = 1 ]; then
   302	  rm -rf "$PREVT"
   303	  if ! cp -a "$G" "$PREVT"; then
   304	    say "REFUSED: the rollback copy of $G could not be made; nothing has been published"
   305	    exit 12
   306	  fi
   307	  if ! diff -rq "$G" "$PREVT" > "$TMPOUT/backup_check.txt" 2>&1; then
   308	    say "REFUSED: the rollback copy of $G does not match it file for file; nothing has been published"
   309	    sed -n '1,10p' "$TMPOUT/backup_check.txt" | tee -a "$LOG"
   310	    exit 12
   311	  fi
   312	  mv "$PREVT" "$PREV"
   313	  : > "$PREVR/generated$DONE"
   314	fi
   315	rm -rf "$PREVRT"
   316	say "rollback copies of what this run replaces: complete, verified and marked; publishing now"
   317	PUB_STATE=started                       # from here on, any death rolls all three back
   318	# `$G` is removed rather than renamed aside: a rename would itself be this run's first mutation
   319	# of the publication, and every backup has to be complete before that happens. What restore()
   320	# puts back is the verified copy in `$PREV`.
   321	if [ -d "$G" ] && ! rm -rf "$G"; then restore "the asset set"; exit 9; fi
   322	if ! mv "$STAGE" "$G"; then restore "the asset set"; exit 9; fi
   323	if ! mv "$TMPOUT/yaw_pilot_01_results.html" "$E/yaw_pilot_01_results.html"; then
   324	  restore "the HTML page"; exit 9
   325	fi
   326	if ! mv "$TMPOUT/yaw_pilot_results.md" "$E/yaw_pilot_results.md"; then
   327	  restore "the Markdown report"; exit 9
   328	fi
   329	# All three are published: only now may the rollback copies go.
   330	PUB_STATE=committed
   331	rm -rf "$PREV" "$PREVR"
   332	say "FINISH DONE: $(wc -l < "$G/SHA256SUMS") assets published in $G; report in $E"

