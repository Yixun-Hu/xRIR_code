}import os, sys, json, subprocess, hashlib, shutil, shlex, signal
from pathlib import Path
ROOT = Path('/home/yixunhu/codespace/xRIR_code_wt10')
BASE = ROOT / '.review-round7/finish'
sys.path.insert(0, str(ROOT / 'tests'))
import exp10_record_fixture as fx
ASSETS = ROOT / 'worklog/worklog_yixun/exp_10_yaw_pilot_claude/yaw_pilot_results_assets'

def snap(path):
    p = Path(path)
    if not p.exists(): return None
    if p.is_file(): return {'kind': 'file', 'sha256': hashlib.sha256(p.read_bytes()).hexdigest(), 'bytes': p.stat().st_size}
    return {'kind': 'dir', 'files': {str(f.relative_to(p)): {'sha256': hashlib.sha256(f.read_bytes()).hexdigest(), 'bytes': f.stat().st_size} for f in sorted(p.rglob('*')) if f.is_file()}, 'dirs': sorted(str(f.relative_to(p)) for f in p.rglob('*') if f.is_dir())}

def setup(name):
    dest = BASE / name; dest.mkdir()
    b = fx.make_scratch_repo(str(dest / 'repo'), str(ASSETS), n_queries=6337)
    g = Path(b['assets']) / 'generated'; g.mkdir()
    (g / 'stale_summary_interim.json').write_text('OLD STALE ASSET\n')
    (g / 'nested').mkdir(); (g / 'nested/old.bin').write_bytes(bytes(range(256)))
    (g / 'empty').mkdir()
    (Path(b['record']) / 'yaw_pilot_results.md').write_text('OLD MARKDOWN\n')
    (Path(b['record']) / 'yaw_pilot_01_results.html').write_text('OLD HTML\n')
    b['generated'] = str(g)
    return b

def wrapper(b, e, command, body):
    d = Path(b['root']) / 'review_bin'; d.mkdir(exist_ok=True)
    p = d / command; p.write_text('#!/bin/bash\n' + body + '\n'); p.chmod(0o755)
    e['PATH'] = str(d) + os.pathsep + e['PATH']

def signal_code(sig):
    return 'echo "INJECTED '+sig+' parent=$PPID" >&2\n/usr/bin/awk \'/^SigIgn:/{print "PARENT " $0}\' /proc/$PPID/status >&2\nkill -'+sig+' "$PPID"\necho "SIGNAL SENT rc=$?" >&2\n'

def final_signal(sig='TERM', absent=(), after=False, unwritable=False):
    def mutate(b, e):
        for key in absent:
            p = Path(b['generated']) if key == 'generated' else Path(b['record']) / key
            if p.is_dir(): shutil.rmtree(str(p))
            elif p.exists(): p.unlink()
        body = 'case "$1" in */.finish_tmp.*/yaw_pilot_results.md)\n'
        if unwritable: body += 'chmod a-w ' + shlex.quote(b['record']) + '\n'
        body += signal_code(sig)
        body += ('exec /usr/bin/mv "$@"' if after else 'exit 43') + '\n;;esac\nexec /usr/bin/mv "$@"'
        wrapper(b, e, 'mv', body)
    return mutate

def final_failure(b, e):
    wrapper(b, e, 'mv', 'case "$1" in */.finish_tmp.*/yaw_pilot_results.md) echo "INJECTED final mv failure" >&2; exit 43;;esac\nexec /usr/bin/mv "$@"')

def gpu_reports(b, e):
    gpu = Path(b['tree']['released_k8']['all'][0]); cpu = Path(b['tree']['cpu']['all'][0])
    for name in ('check_online.json','parity_exp03.json'): shutil.copy2(str(gpu/name),str(cpu/name))

def backup_copy(term=False, success=False, assets=False, complete=False):
    def mutate(b,e):
        pattern = '*/.finish_prev_assets.*' if assets else '*/.finish_prev.*/yaw_pilot_01_results.html'
        body = 'case "${@: -1}" in '+pattern+')\necho "INJECTED backup copy" >&2\n'
        if not complete:
            if assets:
                body += 'mkdir -p "${@: -1}"\n/usr/bin/head -c 4 "${@: -2:1}/stale_summary_interim.json" > "${@: -1}/stale_summary_interim.json"\n'
            else: body += '/usr/bin/head -c 4 "${@: -2:1}" > "${@: -1}"\n'
        if term: body += signal_code('TERM')
        body += ('exec /usr/bin/cp "$@"' if complete else ('exit 0' if success else 'exit 44')) + '\n;;esac\nexec /usr/bin/cp "$@"'
        wrapper(b,e,'cp',body)
    return mutate

def during_restore(sig):
    def mutate(b,e):
        body = 'case "$1" in\n*/.finish_tmp.*/yaw_pilot_results.md) echo "INJECTED final mv failure" >&2;exit 43;;\n*/generated.previous.*)\n' + signal_code(sig) + ';;esac\nexec /usr/bin/mv "$@"'
        wrapper(b,e,'mv',body)
    return mutate

def missing_arm(arm):
    def mutate(b,e): shutil.rmtree(b['tree'][arm]['all'][0])
    return mutate

def incomplete_arm(arm):
    def mutate(b,e):
        p,m = b['tree'][arm]['all']; m['complete']=False; fx.write_json(str(Path(p)/'meta.json'),m)
    return mutate

def failed_controls(b,e):
    p,m=b['tree']['cyl_k8']['probe'];fx.write_summary_dir(str(Path(p)/'summary'),[(p,m)],controls_ok=False)

def signal_defaults():
    for sig in (signal.SIGTERM,signal.SIGINT,signal.SIGHUP): signal.signal(sig,signal.SIG_DFL)

def run(name,mutate=None,expected=0,more_env=None,unwritable=False):
    b=setup(name)
    e=dict(os.environ,EXP10_REPO_ROOT=b['root'],EXP10_FIXTURE_DIR=str(ROOT/'tests'),PYTHONDONTWRITEBYTECODE='1',CUDA_VISIBLE_DEVICES='',MPLCONFIGDIR=str(BASE/name/'mplconfig'),XDG_CACHE_HOME=str(BASE/name/'cache'),TMPDIR=str(BASE/name),OMP_NUM_THREADS='1',OPENBLAS_NUM_THREADS='1',MKL_NUM_THREADS='1')
    e.pop('EXP10_EXPECT_N',None)
    if mutate: mutate(b,e)
    if more_env: e.update(more_env)
    paths={'generated':Path(b['generated']),'html':Path(b['record'])/'yaw_pilot_01_results.html','md':Path(b['record'])/'yaw_pilot_results.md'}
    before={k:snap(p) for k,p in paths.items()}
    try:
        p=subprocess.run(['bash',str(ASSETS/'scripts/exp10_finish.sh')],cwd=b['root'],env=e,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=180,preexec_fn=signal_defaults)
    finally: os.chmod(b['record'],0o755)
    (BASE/name/'finish.log').write_bytes(p.stdout)
    after={k:snap(pth) for k,pth in paths.items()}
    leftovers=[q for q in Path(b['assets']).iterdir() if q.name.startswith(('generated.previous','generated.staging','.finish_tmp','.finish_prev'))]
    lines=p.stdout.decode().splitlines()
    result={'name':name,'exit':p.returncode,'expected_exit':expected,'all_unchanged':before==after,'artifacts_unchanged':{k:before[k]==after[k] for k in before},'before':before,'after':after,'finish_done':b'FINISH DONE' in p.stdout,'leftovers':[q.name for q in leftovers],'backup_contents':{q.name:snap(q) for q in leftovers},'closing_lines':[line for line in lines if any(w in line for w in ('FINISH FAILED','FINISH INTERRUPTED','NOT RESTORED','KEPT:','REFUSED:','INJECTED','SIGNAL SENT','PARENT SigIgn:'))]}
    checks={'exit':p.returncode==expected}
    if expected==0:
        sums=Path(b['generated'])/'SHA256SUMS'
        c=subprocess.run(['sha256sum','-c','--quiet','SHA256SUMS'],cwd=b['generated'],stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
        result['checksums_exit']=c.returncode;result['asset_count']=len(sums.read_text().splitlines())
        val=json.loads((Path(b['generated'])/'validation.json').read_text());result['cpu_parity_ok']=val['cpu']['parity_all']['ok'];result['expect_n']=val['expect_n']
        checks.update(checksums=c.returncode==0,asset_count=result['asset_count']==46,cpu_parity_false=result['cpu_parity_ok'] is False,n_queries=result['expect_n']==6337,done=result['finish_done'],stale_removed=not (Path(b['generated'])/'stale_summary_interim.json').exists(),no_leftovers=not leftovers)
        if more_env: checks['foreign_png_removed']=all(b'FOREIGN_PNG_BYTES' not in f.read_bytes() for f in Path(b['generated']).rglob('*.png'))
    elif unwritable:
        backups=[q for q in leftovers if q.name.startswith('.finish_prev.') and not q.name.endswith('.tmp')]
        checks.update(failure_truthful=b'could NOT be put back in full' in p.stdout,assets_restored=before['generated']==after['generated'],backups_named=all(q.name.encode() in p.stdout for q in backups),backups_kept=bool(backups),no_done=not result['finish_done'])
        for k,f in [('html','yaw_pilot_01_results.html'),('md','yaw_pilot_results.md')]: checks[k+'_original_backup']=any(snap(q/f)==before[k] for q in backups)
    else:
        checks.update(unchanged=before==after,no_leftovers=not leftovers,no_done=not result['finish_done'],no_false_restore_failure=b'could NOT be put back' not in p.stdout)
    if any(token in name for token in ('sigterm','sigint','sighup')):
        checks['signal_sent']='SIGNAL SENT rc=0' in p.stdout.decode()
    if 'during_restore' in name:
        mask=int(next(line.split()[-1] for line in lines if line.startswith('PARENT SigIgn:')),16)
        checks['all_rollback_signals_ignored']=all(mask & (1<<(s-1)) for s in (signal.SIGTERM,signal.SIGINT,signal.SIGHUP))
    result['checks']=checks;result['passed']=all(checks.values())
    (BASE/name/'result.json').write_text(json.dumps(result,indent=2))
    print(json.dumps({k:v for k,v in result.items() if k not in ('before','after','backup_contents')}),flush=True)
    return result

