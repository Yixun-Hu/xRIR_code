say "QUEUE DONE (arms attempted $ATTEMPTED, failures $FAILED)"
if [ "$FAILED" -ne 0 ]; then say "QUEUE EXIT 1: $FAILED of $ATTEMPTED arms failed"; exit 1; fi
exit 0
