   919	def _panel(ax, rows, metric, band, annotate_n=True, band_label=BAND_LABEL):
   920	    """One panel: signed change and shift per angle, with CIs and the context band.
   921	
   922	    A missing estimate is *missing*: it is never coerced to zero, because a zero-height
   923	    bar is a measurement ("the prediction did not move") and an unavailable cell is not
   924	    one.  Such an angle gets no bar and an "unavailable" annotation with its count
   925	    instead; a bar whose interval alone is unavailable is drawn without error bars; and an
   926	    estimate that genuinely is zero is drawn as a zero-height bar.
   927	
   928	    The same rule applies to the interval itself: the error bars are a separate artist
   929	    drawn only over the bars that have **both** bounds, so a bar with a missing (or
   930	    half-missing) interval carries no error-bar artist at all.  A zero-length cap at the
   931	    point estimate would read as "the interval is this point", which is the one thing that
   932	    cell does not say.
   933	    """
   934	    selected = [row for row in rows if row["metric"] == metric]
   935	    positions = list(range(len(selected)))
   936	    width = 0.38
   937	    handles = []
   938	
   939	    def _bars(offset, value_key, color, label):
   940	        drawn, values = [], []
   941	        error_x, error_y, lo, hi = [], [], [], []
   942	        for position, row in zip(positions, selected):
   943	            value = row[value_key]
   944	            if value is None:
   945	                continue                      # omitted, not plotted as zero
   946	            x = position + offset
   947	            drawn.append(x)
   948	            values.append(float(value))
   949	            low, high = row[value_key + "_lo"], row[value_key + "_hi"]
   950	            if low is None or high is None:
   951	                continue                      # no interval: draw no interval
   952	            error_x.append(x)
   953	            error_y.append(float(value))
   954	            lo.append(max(0.0, float(value) - float(low)))
   955	            hi.append(max(0.0, float(high) - float(value)))
   956	        if not values:
   957	            return None
   958	        container = ax.bar(drawn, values, width, color=color, label=label)
   959	        if error_x:
   960	            ax.errorbar(error_x, error_y, yerr=[lo, hi], fmt="none", capsize=2,
   961	                        elinewidth=0.8, ecolor="#3a3a3a", label="_nolegend_", zorder=3)
   962	        return container
   963	
   964	    paired = any(row["degradation"] is not None for row in selected)
   965	    series = [("degradation", -width / 2, COLOR_DEGRADATION, "accuracy change (vs GT)"),
   966	              ("shift", width / 2, COLOR_SHIFT, r"prediction shift (vs $P_0$)")]
   967	    if not paired:
   968	        series = [("shift", 0.0, COLOR_SHIFT, r"prediction shift (vs $P_0$)")]
   969	    for value_key, offset, color, label in series:
   970	        handle = _bars(offset, value_key, color, label)

