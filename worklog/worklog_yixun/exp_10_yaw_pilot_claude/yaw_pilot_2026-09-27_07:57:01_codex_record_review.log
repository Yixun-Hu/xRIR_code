    81	def _measure_rt60_torch(h, fs=1, decay_db=60, energy_thres=1.0):
    82	    """
    83	    Torch implementation of T60 computation. Allows batch processing.
    84	    """
    85	    power = h ** 2  # Compute power
    86	    energy = torch.flip(torch.cumsum(torch.flip(power, dims=[-1]), dim=-1), dims=[-1])  # Schroeder integration
    87	    
    88	    if energy_thres < 1.0:
    89	        assert 0.0 < energy_thres < 1.0
    90	        energy = energy - energy[..., :1] * (1.0 - energy_thres)
    91	        energy = torch.clamp(energy, min=0.0)
    92	    
    93	    # Find the last non-zero index
    94	    mask = energy > 0
    95	    i_nz = torch.max(mask * torch.arange(energy.shape[-1], device=h.device), dim=-1).values
    96	    energy_db = 10 * torch.log10(energy + 1e-10)
    97	    energy_db = energy_db - energy_db[..., :1]
    98	    
    99	    min_energy_db = -torch.min(energy_db, dim=-1).values
   100	    decay_db = torch.minimum(decay_db * torch.ones_like(min_energy_db), min_energy_db - 5)
   101	    
   102	    # Find index where energy drops below -5 dB
   103	    mask_5db = energy_db < -5
   104	    i_5db = torch.where(mask_5db, torch.arange(energy.shape[-1], device=h.device), energy.shape[-1]).min(dim=-1).values
   105	    t_5db = i_5db / fs
   106	    
   107	    # Find index where energy drops below -5 - decay_db
   108	    mask_decay = energy_db < (-5 - decay_db.unsqueeze(-1))
   109	    i_decay = torch.where(mask_decay, torch.arange(energy.shape[-1], device=h.device), energy.shape[-1]).min(dim=-1).values
   110	    t_decay = i_decay / fs
   111	    
   112	    # Compute T60
   113	    decay_time = t_decay - t_5db
   114	    est_rt60 = (60.0 / decay_db) * decay_time
   115	    return est_rt60
     1	import torch
     2	import numpy as np
     3	from torchmetrics import Metric
     4	
     5	class C50(Metric):
     6	    def __init__(self, 
     7	                 fs=22050,
     8	                 n_audio_ch=1, 
     9	                 name="C50", 
    10	                 **kwargs):
    11	        super().__init__(**kwargs)
    12	
    13	        self.add_state("c50", default=[], dist_reduce_fx="cat")
    14	        self.fs = fs    
    15	        self.n_audio_ch = n_audio_ch
    16	    
    17	    def compute_c50(self, wav_prd, wav_gt_ff):
    18	        c50_gt = _measure_clarity(wav_gt_ff, fs=self.fs)
    19	        c50_prd = _measure_clarity(wav_prd, fs=self.fs)
    20	        return c50_gt, c50_prd
    21	
    22	    def compute(self):
    23	        mean_c50 = torch.mean(torch.cat(self.c50)) if isinstance(self.c50, list) else torch.mean(self.c50)
    24	        mean_c50 = round(mean_c50.item(), 4)
    25	        return mean_c50
    26	
    27	    def reset(self):
    28	        self.c50 = []
    29	        
    30	    def update(self, wav_prd, wav_gt_ff):
    31	        c50_gt, c50_prd = self.compute_c50(wav_prd, wav_gt_ff)
    32	        c50_instance = torch.abs(c50_prd - c50_gt)  # Shape [B, n_ch])
    33	        mean_c50 = torch.mean(c50_instance, dim=1)  # Shape [B]
    34	        self.c50.append(mean_c50)
    35	
    36	def _measure_clarity(h, time=50, fs=22050):
    37	    device = h.device
    38	    B, C, T = h.shape
    39	    if B > 1:
    40	        raise ValueError("Only one channel is supported, use torch version for batch processing.")
    41	    signal = h.squeeze(0).cpu().numpy()
    42	    C50s = []
    43	    for c in range(C):
    44	        C50 = _c50(signal[c], time=time, fs=fs)
    45	        C50s.append(C50)
    46	    C50s = torch.tensor(C50s, device=device).unsqueeze(0)
    47	    return C50s
    48	
    49	def _c50(signal, time=50, fs=22050):
    50	    h2 = signal**2
    51	    t = int((time/1000)*fs + 1) 
    52	    c50 = 10*np.log10((np.sum(h2[:t])/np.sum(h2[t:])) + 1e-10)
    53	    return c50
    54	
    55	def measure_clarity_torch(signal, time=50, fs=22050):
    56	    """
    57	    C50 calculation with torch that supports batch processing.
    58	    """
    59	    h2 = signal ** 2  # Shape [B, n_ch, n_time]
    60	    t = int((time / 1000) * fs)  
    61	
    62	    early_energy = torch.sum(h2[..., :t], dim=-1)  
    63	    late_energy = torch.sum(h2[..., t:], dim=-1)  
    64	
    65	    c50 = 10 * torch.log10(torch.clamp(early_energy / late_energy, min=1e-10))
    66	    return c50 

