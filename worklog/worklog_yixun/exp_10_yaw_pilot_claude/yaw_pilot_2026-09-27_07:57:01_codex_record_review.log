     3	from torchmetrics import Metric
     4	
     5	class RT60Error(Metric):
     6	    def __init__(self, 
     7	                 fs=22050,
     8	                 n_audio_ch=1, 
     9	                 dataset_name='AcousticRooms',
    10	                 name="RT60Error", 
    11	                 **kwargs):
    12	        super().__init__(**kwargs)
    13	
    14	        self.add_state("t60_error", default=[], dist_reduce_fx="cat")
    15	        self.add_state("total_invalids", default=[], dist_reduce_fx="cat")
    16	        self.fs = fs    
    17	        self.n_audio_ch = n_audio_ch
    18	        
    19	        self.dataset = dataset_name
    20	
    21	        # Following xRIR code 
    22	        if self.dataset == 'AcousticRooms':
    23	            self.decay_db = 20
    24	        elif self.dataset == 'HAA': 
    25	            self.decay_db = 30
    26	        else:
    27	            raise NotImplementedError(f"Dataset {self.dataset} not recognized for RT60 computation.")
    28	
    29	    def compute_t60(self, wav_gt_ff, wav_prd):
    30	        t60s_gt = _mesure_rt60_pyroomacoustics(wav_gt_ff, fs=self.fs, decay_db=self.decay_db)
    31	        t60s_prd = _mesure_rt60_pyroomacoustics(wav_prd, fs=self.fs, decay_db=self.decay_db)
    32	        return t60s_gt, t60s_prd
    33	
    34	    def compute(self):
    35	        mean_t60error = torch.mean(torch.cat(self.t60_error)) if isinstance(self.t60_error, list) else torch.mean(self.t60_error)
    36	        mean_invalids = torch.mean(torch.cat(self.total_invalids)) if isinstance(self.total_invalids, list) else torch.mean(self.total_invalids)
    37	        mean_t60error = round(mean_t60error.item(), 4)
    38	        return mean_t60error, mean_invalids.item()
    39	    
    40	    def reset(self):
    41	        self.t60_error = []
    42	        self.total_invalids = []
    43	        
    44	    def update(self, wav_prd, wav_gt_ff):
    45	        t60s_gt, t60s_prd = self.compute_t60(wav_gt_ff, wav_prd)
    46	        t60s = torch.cat((t60s_gt, t60s_prd), dim=-1)  # Shape [B, 2 * n_ch]
    47	
    48	        # Diff Rel 
    49	        diff = torch.abs(t60s[...,self.n_audio_ch:] - t60s[...,:self.n_audio_ch]) / torch.abs(t60s[...,:self.n_audio_ch])
    50	
    51	        if self.dataset == 'AcousticRooms':
    52	            diff = diff.mean(dim=1) * 100
    53	            self.t60_error.append(diff)
    54	            device = t60s_gt.device
    55	            self.total_invalids.append(torch.tensor([0.0], device=device))
    56	        else:
    57	            mask = (t60s < -0.5).any(dim=1)
    58	            diff_mean = diff.mean(dim=1)  # Mean error per audio 
    59	            diff_mean[mask] = 1.0  # Assign max error to invalid samples
    60	            mean_t60error = diff_mean * 100  # Convert to percentage
    61	            invalid = mask.sum().expand_as(mean_t60error).float()  # Count invalid samples
    62	            self.t60_error.append(mean_t60error)
    63	            self.total_invalids.append(invalid)
