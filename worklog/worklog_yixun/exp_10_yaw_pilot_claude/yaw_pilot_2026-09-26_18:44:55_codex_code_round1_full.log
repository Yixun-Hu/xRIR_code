CSV_COLUMNS = ("arm", "k", "angle_deg", "metric", "unit", "degradation",
               "degradation_lo", "degradation_hi", "shift", "shift_lo", "shift_hi",
               "n_mask", "ratio_status", "ratio_status_room", "ratio_point", "ratio_lo",
