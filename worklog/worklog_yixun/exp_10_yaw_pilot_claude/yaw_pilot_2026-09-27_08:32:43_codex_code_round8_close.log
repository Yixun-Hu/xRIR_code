results['exp03_source_pins'] = {p['path']:hashlib.sha256((root/p['path']).read_bytes()).hexdigest()==p['reviewed_blob_sha256'] for p in binding['source_closure']}
assert all(results['exp03_source_pins'].values())
clone = scratch/'merge-clone'
try:
    assert not clone.exists()
    run(['git','-c','core.hooksPath=/dev/null','clone','--no-checkout','--no-hardlinks','--no-local',str(root),str(clone)])
    run(['git','-c','core.hooksPath=/dev/null','checkout','--detach',results['main_head']],clone)
    run(['git','-c','core.hooksPath=/dev/null','merge','--no-ff','--no-commit',results['branch_head']],clone)
    results['merge_changed'] = run(['git','diff','--cached','--name-only'],clone).splitlines()
    assert set(results['merge_changed']) == allowed
    run(['git','diff','--cached','--check'],clone)
    run(['git','diff','--check'],clone)
    results['merge_tree'] = run(['git','write-tree'],clone).strip()
    results['merge_status'] = run(['git','status','--porcelain=v1','--untracked-files=no'],clone)
    results['merge_passed'] = True
finally:
    if clone.exists(): shutil.rmtree(str(clone))
    results['clone_deleted'] = not clone.exists()
    (scratch/'static_merge.json').write_text(json.dumps(results,indent=2)+'\n')
print('Static/merge checks passed; clone deleted; main '+results['main_head'],flush=True)

def tests(name,files):
    cmd = [sys.executable,'-m','pytest','-q','-ra','-p','no:cacheprovider','--basetemp='+str(scratch/(name+'-pytest'))]+files
    started = time.time()
    with (scratch/(name+'-tests.log')).open('w') as log:
        p = subprocess.run(cmd,cwd=str(root),env=dict(env,MPLCONFIGDIR=str(scratch/('mpl-'+name))),stdout=log,stderr=subprocess.STDOUT)
    lines = (scratch/(name+'-tests.log')).read_text().splitlines()
    return name,{'command':cmd,'exit_code':p.returncode,'summary':lines[-1] if lines else '', 'seconds':time.time()-started}
with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
    jobs = [pool.submit(tests,'record',['tests/test_exp10_record_tools.py']), pool.submit(tests,'regression',['tests/test_exp10_yaw_pilot.py','tests/test_exp10_compare.py','tests/test_exp10_summarize.py','tests/test_exp03_record_tools.py'])]
    for job in concurrent.futures.as_completed(jobs):
        name,result = job.result(); results[name] = result
        (scratch/'test_results.json').write_text(json.dumps(results,indent=2)+'\n')
        print(name+': '+result['summary'],flush=True)
results['tracked_after'] = run(['git','status','--porcelain=v1','--untracked-files=no'])
results['tracked_hash_after'] = {p:hashlib.sha256((root/p).read_bytes()).hexdigest() for p in sorted(allowed)}
(scratch/'test_results.json').write_text(json.dumps(results,indent=2)+'\n')
assert not results['tracked_after']
assert results['tracked_hash_before'] == results['tracked_hash_after']
assert results['record']['exit_code']==results['regression']['exit_code']==0
