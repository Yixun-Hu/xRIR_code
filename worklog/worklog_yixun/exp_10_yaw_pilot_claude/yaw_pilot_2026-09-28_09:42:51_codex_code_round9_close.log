              "EXP10_FIXTURE_DIR": os.path.join(REPO, "tests")})
    e.update(env or {})
    return subprocess.run(["bash", os.path.join(scratch["scripts"], "exp10_finish.sh")],
                          stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=e,
                          cwd=scratch["root"])


