   156	    nan = float("nan")
   157	    edt = c50 = t60 = nan
   158	    with np.errstate(divide="ignore", invalid="ignore"):
   159	        try:
   160	            edt = abs(evaluator.measure_edt(gt_ir) - evaluator.measure_edt(pred_ir))
   161	        except (ValueError, IndexError):
   162	            edt = nan
   163	        clarity = abs(evaluator.measure_clarity(gt_ir) - evaluator.measure_clarity(pred_ir))
   164	        c50 = float(clarity) if np.isfinite(clarity) else nan
   165	        if want_t60:
   166	            try:
   167	                gt_t60 = evaluator.measure_rt60(gt_ir)
   168	                t60 = abs(gt_t60 - evaluator.measure_rt60(pred_ir)) / gt_t60 * 100.0
   169	            except (ValueError, IndexError, ZeroDivisionError):
   170	                t60 = nan
   171	    return {key: (float(value) if np.isfinite(value) else nan)
   172	            for key, value in (("edt", edt), ("c50", c50), ("t60", t60))}
     1	"""Active yaw rotation of an xRIR scene about the receiver's vertical axis.
     2	
     3	Experiment exp_03 (``yaw_rotation_degradation``) asks whether jointly rotating the
     4	receiver-centred depth panorama and the source / reference-source coordinates in yaw
     5	degrades RIR synthesis.  For an omnidirectional source and a monaural receiver this
     6	rotation is a symmetry of the acoustics, so the ground-truth RIR is unchanged and any
     7	change in the prediction is model sensitivity.
     8	
     9	Convention
    10	----------
    11	An **active** yaw of the whole scene by ``+Delta`` about the receiver's ``z`` axis,
    12	right-handed (counter-clockwise seen from ``+z``: ``+x -> +y``), with
    13	
    14	    Delta = 2*pi*k / W
    15	
    16	for an integer roll of ``k`` panorama columns (``W`` columns in total).  The panorama
    17	convention is the dataset's ``convert_equirect_to_camera_coord``: column ``c`` looks
    18	along ``theta_c = (c + 0.5) * 2*pi/W - pi`` with ``x = d cos(phi) cos(theta)``,
    19	``y = d cos(phi) sin(theta)``, ``z = -d sin(phi)``.  Because ``theta_c - theta_{c-k} =
    20	2*pi*k/W = Delta``, rolling the panorama by ``+k`` columns and then rotating the xyz
    21	channel vectors by ``Rz(Delta)`` is exactly the same scene as re-projecting the rolled
    22	depth map, i.e. ``Rz(Delta) . roll(convert(D), k) == convert(roll(D, k))``.
    23	
    24	All functions are pure (no in-place modification of their arguments) and work on CPU
    25	and CUDA tensors.
    26	"""
    27	from __future__ import annotations
    28	
    29	import contextlib
    30	import math
    31	import numbers
    32	import types
    33	from typing import Tuple
    34	
    35	import torch
    36	
    37	
    38	def _check_k_and_width(k, W) -> None:
    39	    """Validate a column roll ``k`` and a panorama width ``W``.
    40	
    41	    Raises:
    42	        TypeError: if ``k`` or ``W`` is not an integer (floats are rejected rather than
    43	            silently truncated, since a fractional roll has no meaning here).
    44	        ValueError: if ``W <= 0``.
    45	    """
    46	    if isinstance(k, bool) or not isinstance(k, numbers.Integral):
    47	        raise TypeError("k must be an integer number of panorama columns, got {!r}".format(k))
    48	    if isinstance(W, bool) or not isinstance(W, numbers.Integral):
    49	        raise TypeError("W must be an integer panorama width, got {!r}".format(W))
    50	    if int(W) <= 0:
    51	        raise ValueError("W must be positive, got {}".format(W))
    52	
    53	
    54	def _require_float(t: torch.Tensor, name: str) -> None:
    55	    """Raise ``TypeError`` unless ``t`` is a floating-point tensor."""
    56	    if not torch.is_floating_point(t):
    57	        raise TypeError("{} must be a floating-point tensor, got dtype {}".format(name, t.dtype))
    58	
    59	
    60	def yaw_angle_rad(k: int, W: int = 512) -> float:
    61	    """Yaw angle in radians corresponding to a roll of ``k`` panorama columns.
    62	
    63	    Args:
    64	        k: integer number of panorama columns; may be negative or ``>= W`` (not reduced
    65	            here).  Non-integer values raise ``TypeError``.
    66	        W: integer panorama width in columns; must be positive.
    67	
    68	    Returns:
    69	        ``2 * pi * k / W`` as a Python float.
    70	    """
    71	    _check_k_and_width(k, W)
    72	    return 2.0 * math.pi * float(k) / float(W)
    73	
    74	
    75	def rotate_vectors_z(v: torch.Tensor, angle: float) -> torch.Tensor:
    76	    """Actively rotate 3-D vectors about the ``z`` axis by ``angle`` radians.
    77	
    78	    ``x' = x cos(a) - y sin(a)``, ``y' = x sin(a) + y cos(a)``, ``z' = z``.
    79	
    80	    Args:
    81	        v: floating-point tensor of shape ``[..., 3]``; the last axis holds ``(x, y, z)``.
    82	            Integer tensors are rejected (the rotation is not closed over the integers).
    83	        angle: rotation angle in radians (right-handed about ``+z``).
    84	
    85	    Returns:
    86	        A new tensor of the same shape, dtype and device as ``v``.
    87	
    88	    Raises:
    89	        TypeError: if ``v`` is not floating point.
    90	        ValueError: if the last axis of ``v`` is not of size 3.
    91	    """
    92	    if v.shape[-1] != 3:
    93	        raise ValueError("rotate_vectors_z expects the last axis to be xyz (size 3), "
    94	                         "got shape {}".format(tuple(v.shape)))
    95	    _require_float(v, "v")
    96	    cos_a = math.cos(angle)
    97	    sin_a = math.sin(angle)
    98	    x, y, z = v[..., 0], v[..., 1], v[..., 2]
    99	    return torch.stack([x * cos_a - y * sin_a, x * sin_a + y * cos_a, z], dim=-1)
   100	
   101	
   102	def rotate_scene_yaw(
   103	    depth_coord: torch.Tensor,
   104	    src_loc: torch.Tensor,
   105	    ref_locs: torch.Tensor,
   106	    k: int,
   107	    W: int = 512,
   108	) -> Tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
   109	    """Apply the active ``+2*pi*k/W`` yaw to a whole xRIR scene.
   110	
   111	    ``depth_coord' = Rz(Delta) . roll(depth_coord, k, dim=-1)``,
   112	    ``src_loc' = Rz(Delta) src_loc``, ``ref_locs' = Rz(Delta) ref_locs``.
   113	
   114	    Args:
   115	        depth_coord: receiver-frame panorama coordinates ``[B, 3, H, W]``, floating point.
   116	        src_loc: receiver-frame query-source position ``[B, 3]``, floating point.
   117	        ref_locs: receiver-frame reference-source positions ``[B, K, 3]``, floating point.
   118	        k: integer column roll; negative values and values ``>= W`` are reduced modulo
   119	            ``W``.  Non-integer values raise ``TypeError``.
   120	        W: integer panorama width in columns (must match ``depth_coord.shape[-1]``).
   121	
   122	    Returns:
   123	        ``(depth_coord', src_loc', ref_locs')`` -- new tensors; the inputs are untouched.
   124	
   125	    Raises:
   126	        TypeError: if ``k``/``W`` are not integers or any tensor is not floating point.
   127	        ValueError: if ``W <= 0`` or the shapes do not match the contract.
   128	    """
   129	    _check_k_and_width(k, W)
   130	    _require_float(depth_coord, "depth_coord")
   131	    _require_float(src_loc, "src_loc")
   132	    _require_float(ref_locs, "ref_locs")
   133	    if depth_coord.dim() != 4 or depth_coord.shape[1] != 3:
   134	        raise ValueError("depth_coord must have shape [B, 3, H, W], got {}".format(
   135	            tuple(depth_coord.shape)))
   136	    if depth_coord.shape[-1] != W:
   137	        raise ValueError("depth_coord has {} columns but W={}".format(
   138	            depth_coord.shape[-1], W))
   139	
   140	    k = int(k) % int(W)
   141	    angle = yaw_angle_rad(k, W)
   142	
   143	    rolled = torch.roll(depth_coord, shifts=k, dims=-1)          # [B, 3, H, W]
   144	    depth_rot = rotate_vectors_z(rolled.permute(0, 2, 3, 1), angle).permute(0, 3, 1, 2)
   145	    return depth_rot.contiguous(), rotate_vectors_z(src_loc, angle), rotate_vectors_z(ref_locs, angle)
   146	
   147	
   148	def integer_delays(
   149	    src_loc: torch.Tensor,
   150	    ref_locs: torch.Tensor,
   151	    sr: int = 22050,
   152	    c: float = 343.0,
   153	) -> torch.Tensor:
   154	    """Integer direct-path delays exactly as ``model.xRIR.xRIR.shift_and_align`` computes them.
   155	
   156	    The op sequence and dtypes mirror the model line for line
   157	    (``torch.linalg.norm`` -> ``torch.round(...).int()``), so both the values and the
   158	    dtype agree bit for bit with the model's ``delay_unit`` on the same inputs.
   159	
   160	    Args:
   161	        src_loc: receiver-frame query-source position ``[B, 3]``.
   162	        ref_locs: receiver-frame reference-source positions ``[B, K, 3]``.
   163	        sr: sample rate in Hz (the model hard-codes 22050).
   164	        c: speed of sound in m/s (the model hard-codes 343).
   165	
   166	    Returns:
   167	        ``[B, K]`` **int32** tensor of sample delays -- the dtype the model itself produces
   168	        (positive = reference arrives earlier than the query source and is therefore
   169	        shifted right).
   170	    """
   171	    dist_src = torch.linalg.norm(src_loc, dim=1).unsqueeze(1)          # [B, 1]
   172	    dist_ref = torch.linalg.norm(ref_locs, dim=-1)                     # [B, K]
   173	    return torch.round((dist_src - dist_ref) / c * sr).int()           # as in shift_and_align
   174	
   175	
   176	@contextlib.contextmanager
   177	def fixed_alignment(model, aligned_refs: torch.Tensor):
   178	    """Temporarily pin ``model.shift_and_align`` to a pre-computed alignment.
   179	
   180	    ``xRIR.shift_and_align`` is algebraically yaw-invariant but not numerically: float32
   181	    norms plus ``round()`` can flip a delay by one sample under rotation.  The primary
   182	    experimental condition therefore holds the direct-path alignment at the ``k = 0``
   183	    coordinates so that only the geometry branches see the rotation::
   184	
   185	        aligned = model.shift_and_align(refs, src0, ref_locs0)
   186	        with fixed_alignment(model, aligned):
   187	            out, tgt = model(depth_k, refs, src_k, ref_locs_k, tgt)
   188	
   189	    The replacement is installed as a *bound method* of ``model`` (so ``model``'s own
   190	    ``forward`` sees the usual ``self.shift_and_align(x, src, ref)`` call signature), and
   191	    the original bound method is restored on exit, including when the block raises.
   192	
   193	    This mutates ``model`` for the duration of the block: it is for **serial, eager**
   194	    evaluation only and is **not thread-safe** -- do not share ``model`` across threads,
   195	    and do not let a lazily evaluated forward escape the block.
   196	
   197	    Args:
   198	        model: an ``xRIR`` (or subclass) instance.
   199	        aligned_refs: the cached ``[B, K, T]`` aligned reference audio to return instead.
   200	
   201	    Yields:
   202	        ``model``, with its ``shift_and_align`` replaced.
   203	    """
   204	    had_own = "shift_and_align" in vars(model)
   205	    original = vars(model).get("shift_and_align", None)
   206	
   207	    model.shift_and_align = types.MethodType(
   208	        lambda self, x, src_loc, ref_ir_locs: aligned_refs, model)
   209	    try:
   210	        yield model
   211	    finally:
   212	        if had_own:
   213	            model.shift_and_align = original
   214	        elif "shift_and_align" in vars(model):
   215	            # Guarded so a raise inside the block is never masked by an AttributeError here.
   216	            del model.shift_and_align

