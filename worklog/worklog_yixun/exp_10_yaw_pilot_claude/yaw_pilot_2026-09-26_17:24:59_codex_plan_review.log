    78	def griffin_lim_seeded(mag_spec, seed):
    79	    """``eval_unseen.griffin_lim`` with its random phase initialisation pinned.
    80	
    81	    Griffin-Lim starts from a random phase drawn from the global torch RNG, so an
    82	    unseeded inversion makes two evaluations of the *same* magnitudes differ -- noise
    83	    that would be indistinguishable from a rotation effect in a paired comparison.
    84	    Seeding immediately before the call makes the inversion a pure function of
    85	    ``(mag_spec, seed)``.
    86	
    87	    Note: this reseeds the global torch RNG as a side effect (that is the point); it is
    88	    for evaluation, never inside training.
    89	
    90	    Args:
    91	        mag_spec: magnitude spectrogram ``[F, T]`` or ``[1, F, T]`` (the model's
    92	            ``exp(out_spec) - 1e-8``).
    93	        seed: the per-sample seed, e.g. from :func:`sample_seed`.
    94	
    95	    Returns:
    96	        The inverted waveform as ``[1, T]`` -- the batch dimension is kept, so callers
    97	        index it exactly like ``eval_xRIR_backbone.py`` does (``wav[0, :8000]``).
    98	
    99	    Raises:
   100	        ValueError: if ``mag_spec`` is not ``[F, T]`` or ``[1, F, T]``.
   101	    """
   102	    mag = mag_spec
   103	    if mag.dim() == 2:
   104	        mag = mag.unsqueeze(0)
   105	    if mag.dim() != 3 or mag.shape[0] != 1:
   106	        raise ValueError("mag_spec must be [F, T] or [1, F, T], got shape {}".format(
   107	            tuple(mag_spec.shape)))
   108	    torch.manual_seed(int(seed))
   109	    return griffin_lim(mag)
