   512	def _json_values(values):
   513	    """One per-sample array as strict JSON: every non-finite value becomes ``null``.
   514	
   515	    NaN marks a sample the angle invalidated, and it has to survive the round trip: the
   516	    JSON ``NaN`` literal is not valid JSON (browsers and strict parsers reject it), so
   517	    the files are written with ``allow_nan=False`` and invalid samples are ``null``.
   518	    ``tools/summarize_yaw.py`` reads ``null`` back as NaN.
   519	    """
   520	    return [None if not np.isfinite(value) else float(value) for value in values]
