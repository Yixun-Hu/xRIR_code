   175	def delay_flip_counts(src_loc, ref_locs, cols):
   176	    """Count the integer direct-path delays a rotation moves, per angle.
   177	
   178	    ``xRIR.shift_and_align`` is algebraically yaw-invariant, but its float32 norms and
   179	    ``torch.round`` are not: a delay sitting on a rounding tie can move by one sample
   180	    under an exactly norm-preserving rotation.  This audit quantifies that noise floor
   181	    over the real geometry -- it is what condition P exists to exclude.
   182	
   183	    Args:
   184	        src_loc: query-source positions ``[B, 3]``.
   185	        ref_locs: reference-source positions ``[B, K, 3]``.
   186	        cols: iterable of integer column rolls.
   187	
   188	    Returns:
   189	        ``{k: count}`` -- the number of ``(sample, reference)`` pairs (out of ``B * K``)
   190	        whose integer delay differs between the rotated and the unrotated coordinates.
   191	        ``k = 0`` is always ``0``.
   192	    """
   193	    baseline = integer_delays(src_loc, ref_locs)
   194	    counts = {}
   195	    for k in cols:
   196	        angle = yaw_angle_rad(k)
   197	        rotated = integer_delays(rotate_vectors_z(src_loc, angle),
   198	                                 rotate_vectors_z(ref_locs, angle))
   199	        counts[int(k)] = int((rotated != baseline).sum())
   200	    return counts
