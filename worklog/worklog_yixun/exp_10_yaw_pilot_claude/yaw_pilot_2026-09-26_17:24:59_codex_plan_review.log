   329	def pad_batch(batch, batch_size):
   330	    """Repeat a short batch's rows so it is computed at exactly ``batch_size`` samples.
   331	
   332	    cuBLAS and cuDNN pick their algorithm -- and therefore their reduction order -- from
   333	    the *shape*, so a query's prediction depends on how many samples share its batch:
   334	    measured on a trained checkpoint, the same query evaluated alone and inside a batch
   335	    of 16 differs by 4.8e-5 in the log-spectrogram.  The split is 6337 = 396 * 16 + 1, so
   336	    without padding the last query would be the only one computed at a different shape.
   337	    Repeating rows (wrap-around) keeps the shape canonical; the padded rows are dropped
   338	    before anything is recorded, and because every op here is row-independent the kept
   339	    rows are bit-identical to their values in a full batch.
   340	
   341	    Args:
   342	        batch: the ``ManifestDataset`` seven-tuple, collated (six tensors + the key list).
   343	        batch_size: the canonical number of rows, or ``None`` to leave the batch alone.
   344	
   345	    Returns:
   346	        ``(padded_batch, n_real)``; the input object itself when no padding is needed.
   347	
   348	    Raises:
   349	        ValueError: if the batch already has more rows than ``batch_size``.
   350	    """
   351	    n_real = len(batch[-1])
   352	    if batch_size is None or n_real == int(batch_size):
   353	        return batch, n_real
   354	    if n_real > int(batch_size):
   355	        raise ValueError("batch of {} rows exceeds the canonical size {}".format(
   356	            n_real, batch_size))
   357	    order = [i % n_real for i in range(int(batch_size))]
   358	    index = torch.as_tensor(order, dtype=torch.long)
   359	    padded = tuple(item[index] if torch.is_tensor(item) else [item[i] for i in order]
   360	                   for item in batch)
   361	    return padded, n_real
   362	
