   273	class SubsetManifestDataset(torch.utils.data.Dataset):
   274	    """The first ``n`` entries of an already validated :class:`ManifestDataset`.
   275	
   276	    ``ManifestDataset`` checks the manifest's query *set* against the whole split, which
   277	    a truncated manifest cannot satisfy.  Rather than weaken that check (round-1 code is
   278	    frozen), the full manifest is validated first and the resulting dataset is wrapped
   279	    here, so a ``--max-samples`` smoke run still proves the manifest describes the real
   280	    split.  Exposes ``dataset`` / ``manifest`` / ``entries`` like the wrapped object.
   281	
   282	    Args:
   283	        base: a fully validated ``ManifestDataset``.
   284	        n: how many leading entries (in the manifest's canonical order) to keep.
   285	
   286	    Raises:
   287	        ValueError: if ``n`` is outside ``1 .. len(base)``.
   288	    """
   289	
   290	    def __init__(self, base, n):
   291	        if not 1 <= int(n) <= len(base):
   292	            raise ValueError("cannot take the first {} of {} entries".format(n, len(base)))
   293	        self.base = base
   294	        self.dataset = base.dataset
   295	        self.manifest = base.manifest
   296	        self.entries = base.entries[:int(n)]
   297	
   298	    def __len__(self):
   299	        return len(self.entries)
   300	
   301	    def __getitem__(self, idx):
   302	        if not 0 <= int(idx) < len(self.entries):
   303	            raise IndexError("index {} is outside the truncated manifest".format(idx))
   304	        return self.base[int(idx)]
   305	
