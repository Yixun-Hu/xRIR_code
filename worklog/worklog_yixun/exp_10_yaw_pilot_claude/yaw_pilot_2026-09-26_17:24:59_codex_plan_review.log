   364	def evaluate_batch(model, batch, evaluator, cols, acoustic_cols=(), e_acoustic_cols=(),
   365	                   gl_seed=0, batch_size=None):
   366	    """Every per-sample metric of one collated batch, at every angle in ``cols``.
   367	
   368	    The whole batch is moved to the GPU once and the ``k = 0`` alignment and prediction
   369	    are computed once, so the angles share exactly one paired reference.  Nothing in the
   370	    loop depends on the order of ``cols`` or on which angles came before: the Griffin-Lim
   371	    phase is seeded per query, so the result is a pure function of
   372	    ``(model, batch, cols, gl_seed)``.
   373	
   374	    Args:
   375	        model: an ``xRIR`` on CUDA in ``eval()`` mode.
   376	        batch: the ``ManifestDataset`` seven-tuple, collated.
   377	        evaluator: an ``eval_unseen.Evaluator``.
   378	        cols: integer column rolls to evaluate (spectral metrics at every one).
   379	        acoustic_cols: the subset of ``cols`` that also gets EDT / C50 / T60 under
   380	            condition P; ``e_acoustic_cols`` is the same for condition E.  At ``k = 0``
   381	            the two conditions are the same prediction, so the acoustic metrics are
   382	            computed once and stored under both.
   383	        gl_seed: run-level Griffin-Lim seed.
   384	        batch_size: the canonical compute shape (see :func:`pad_batch`).  A short batch
   385	            is padded to it for the forward passes and the padded rows are dropped before
   386	            any metric is computed, so the recorded values do not depend on how many
   387	            queries happened to share the batch.
   388	
   389	    Returns:
   390	        ``(query_keys, results, delay_flips)`` where ``results[(condition, k)]`` maps a
   391	        metric name to a float64 ``np.ndarray`` of shape ``[n_real]``, and ``delay_flips``
   392	        maps each ``k`` to the number of flipped ``(sample, reference)`` delays.
   393	    """
   394	    batch, n_real = pad_batch(batch, batch_size)
   395	    _, src_loc, depth_coord, tgt_wav, ref_irs, ref_locs, keys = batch
   396	    src_loc, depth_coord = src_loc.cuda(), depth_coord.cuda()
   397	    tgt_wav, ref_irs, ref_locs = tgt_wav.cuda(), ref_irs.cuda(), ref_locs.cuda()
   398	    keys = list(keys)[:n_real]
   399	    acoustic_at = {"P": set(int(k) for k in acoustic_cols),
   400	                   "E": set(int(k) for k in e_acoustic_cols)}
   401	    zero_wanted = bool(acoustic_at["P"] | acoustic_at["E"]) and 0 in (
   402	        acoustic_at["P"] | acoustic_at["E"])
   403	
   404	    with torch.no_grad():
   405	        aligned0 = model.shift_and_align(ref_irs, src_loc, ref_locs)
   406	        out_0, _ = model(depth_coord, ref_irs, src_loc, ref_locs, tgt_wav)
   407	    # Everything below is per-sample, so dropping the padded rows here is exact and
   408	    # keeps the (CPU-bound) Griffin-Lim off rows that would be discarded anyway.
   409	    out_0, tgt_real = out_0[:n_real], tgt_wav[:n_real]
   410	
   411	    results = {}
   412	    acoustic_0 = None
   413	    for k in cols:
   414	        out_p, out_e, tgt_spec = forward_conditions(
   415	            model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, k, aligned0)
   416	        out_p, out_e, tgt_spec = out_p[:n_real], out_e[:n_real], tgt_spec[:n_real]
   417	        for condition, pred in (("P", out_p), ("E", out_e)):
   418	            cell = {name: value.double().numpy()
   419	                    for name, value in spectral_metrics(pred, out_0, tgt_spec).items()}
   420	            if int(k) == 0 and zero_wanted:
   421	                if acoustic_0 is None:
   422	                    acoustic_0 = acoustic_metrics_batch(pred, tgt_real, keys, evaluator,
   423	                                                        gl_seed)
   424	                cell.update({name: value.copy() for name, value in acoustic_0.items()})
   425	            elif int(k) in acoustic_at[condition]:
   426	                cell.update(acoustic_metrics_batch(pred, tgt_real, keys, evaluator, gl_seed))
   427	            results[(condition, int(k))] = cell
   428	    return keys, results, delay_flip_counts(src_loc[:n_real], ref_locs[:n_real], cols)
