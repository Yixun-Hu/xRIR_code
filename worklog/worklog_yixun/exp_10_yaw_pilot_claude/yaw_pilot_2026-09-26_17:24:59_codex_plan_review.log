    29	def per_sample_losses(out_spec, tgt_spec):
    30	    """Per-sample test loss, split into its STFT-L1 and energy-decay halves.
    31	
    32	    Calls the two loss functions on 1-sample slices, in the same layout as
    33	    ``train_xRIR_backbone.compute_loss`` (which reduces with ``mean``), so the mean of
    34	    the returned per-sample values is the batch loss and no batch-size effect can leak
    35	    into a paired comparison.  ``compute_spect_energy_decay_losses`` prints its input
    36	    shapes on every call, so stdout is redirected exactly as the training script does.
    37	
    38	    Args:
    39	        out_spec: predicted log-magnitude spectrograms ``[B, F, T, 1]`` (model output).
    40	        tgt_spec: target magnitude spectrograms ``[B, 1, F, T]`` (model output).
    41	
    42	    Returns:
    43	        ``(loss, stft, decay)``: three detached CPU float32 tensors of shape ``[B]``,
    44	        with ``loss = stft + decay``.
    45	    """
    46	    stft_terms = []
    47	    decay_terms = []
    48	    with torch.no_grad():
    49	        for i in range(out_spec.shape[0]):
    50	            gt = tgt_spec[i:i + 1].permute(0, 2, 3, 1)
    51	            pred = out_spec[i:i + 1]
    52	            with contextlib.redirect_stdout(io.StringIO()):
    53	                decay_terms.append(compute_spect_energy_decay_losses(
    54	                    gts=gt, preds=torch.exp(pred) - 1e-8))
    55	            stft_terms.append(stft_l1_loss(pred_spect=pred, gt_spect=gt))
    56	    stft = torch.stack(stft_terms).detach().cpu().float()
    57	    decay = torch.stack(decay_terms).detach().cpu().float()
    58	    return stft + decay, stft, decay
    59	
