   475	def _check_cols(yaw_cols, acoustic_cols, e_acoustic_cols):
   476	    """Reduce the three angle grids and reject a grid the paired design cannot use."""
   477	    cols = [int(k) for k in yaw_cols]
   478	    if 0 not in cols:
   479	        raise ValueError("k = 0 is the paired reference of every metric; --yaw-cols must "
   480	                         "contain it, got {}".format(cols))
   481	    if len(set(cols)) != len(cols):
   482	        raise ValueError("--yaw-cols contains a repeated angle: {}".format(cols))
   483	    acoustic = [int(k) for k in acoustic_cols]
   484	    e_acoustic = [int(k) for k in e_acoustic_cols]
   485	    for name, subset in (("--acoustic-cols", acoustic), ("--e-acoustic-cols", e_acoustic)):
   486	        extra = sorted(set(subset) - set(cols))
   487	        if extra:
   488	            raise ValueError("{} {} are not in --yaw-cols".format(name, extra))
   489	    return cols, acoustic, e_acoustic
