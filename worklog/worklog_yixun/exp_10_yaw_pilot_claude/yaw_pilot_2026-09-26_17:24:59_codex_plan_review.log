   523	def _summarize(values):
   524	    """``{"mean", "n_valid", "n_nan"}`` of one per-sample array (mean over finite values)."""
   525	    array = np.asarray(values, dtype=np.float64)
   526	    finite = np.isfinite(array)
   527	    return {"mean": float(array[finite].mean()) if finite.any() else None,
   528	            "n_valid": int(finite.sum()), "n_nan": int((~finite).sum())}
