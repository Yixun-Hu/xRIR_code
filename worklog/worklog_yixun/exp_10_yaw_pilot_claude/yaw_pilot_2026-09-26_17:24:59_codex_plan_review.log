    61	def sample_seed(base_seed, query_key):
    62	    """A stable 63-bit per-sample seed derived from ``(base_seed, query_key)``.
    63	
    64	    Keyed by the query path rather than by a running counter, so the same query gets
    65	    the same seed at every angle, in every model, whatever order the runs happen in.
    66	
    67	    Args:
    68	        base_seed: run-level seed (in exp_03, the manifest seed).
    69	        query_key: the query's path relative to the IR root.
    70	
    71	    Returns:
    72	        A Python ``int`` in ``[0, 2**63)``.
    73	    """
    74	    digest = hashlib.sha256("{}:{}".format(base_seed, query_key).encode()).digest()[:8]
    75	    return int.from_bytes(digest, "little") & ((1 << 63) - 1)
