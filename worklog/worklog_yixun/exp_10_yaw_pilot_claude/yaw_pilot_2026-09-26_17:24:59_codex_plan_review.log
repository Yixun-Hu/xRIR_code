    33	def select_references(candidates, num_shot, seed, query_key):
    34	    """Deterministically pick ``num_shot`` references for one query.
    35	
    36	    The candidates are sorted first, so the result depends only on the *set* of
    37	    candidate paths, never on the order ``os.listdir`` happened to return them in.
    38	    Sampling is without replacement when there are enough candidates and with
    39	    replacement otherwise -- the same fallback ``xRIR_Dataset`` takes.
    40	
    41	    Args:
    42	        candidates: candidate reference paths (any iterable of str); not modified.
    43	        num_shot: number of references to draw.
    44	        seed: manifest seed (an int; combined with ``query_key`` into the rng seed).
    45	        query_key: per-query string, normally the query path relative to the IR root.
    46	
    47	    Returns:
    48	        A ``list`` of ``num_shot`` paths taken from ``candidates`` (repeats only in the
    49	        with-replacement case).
    50	
    51	    Raises:
    52	        ValueError: if ``candidates`` is empty (propagated from ``numpy``).
    53	    """
    54	    ordered = sorted(candidates)
    55	    digest = hashlib.sha256("{}:{}".format(seed, query_key).encode()).digest()[:8]
    56	    rng = np.random.default_rng(int.from_bytes(digest, "little"))
    57	    idx = rng.choice(len(ordered), size=num_shot, replace=len(ordered) < num_shot)
    58	    return [ordered[int(i)] for i in idx]
    59	
    60	
    61	def candidate_references(ir_path, listdir_cache=None):
    62	    """The candidate reference paths ``xRIR_Dataset`` would consider for one query.
    63	
    64	    Reproduces ``xRIR_Dataset.get_ir_and_location_for_other_sources``: every *other*
    65	    source node that appears in the query's room directory, kept when the file
    66	    ``S00<node>_<receiver token>_hybrid_IR.wav`` (the query's own receiver) exists on
    67	    disk.  The naming logic is re-implemented rather than borrowed so building a
    68	    manifest needs no dataset instance and reads no audio.
    69	
    70	    Args:
    71	        ir_path: path of the query RIR (``.../<Category>/<Room>/S00i_R00j_hybrid_IR.wav``).
    72	        listdir_cache: optional ``dict`` reused across calls to keep one ``os.listdir``
    73	            per room directory (``build_manifest`` passes one); it is filled in place.
    74	
    75	    Returns:
    76	        Sorted list of absolute candidate paths (possibly empty).
    77	    """
    78	    dir_name = os.path.abspath(os.path.dirname(ir_path))
    79	    ir_file_name = os.path.basename(ir_path)
    80	    src_node = int(ir_file_name.split("_")[0][1:])
    81	    rec_token = ir_file_name.split("_")[1]
    82	
    83	    if listdir_cache is None:
    84	        listing = os.listdir(dir_name)
    85	    else:
    86	        if dir_name not in listdir_cache:
    87	            listdir_cache[dir_name] = os.listdir(dir_name)
    88	        listing = listdir_cache[dir_name]
    89	
    90	    all_src_node = set(int(fn.split("_")[0][1:]) for fn in listing)
    91	    paths = []
    92	    for node in all_src_node.difference({src_node}):
    93	        candidate = os.path.join(dir_name, "S00{}_{}_hybrid_IR.wav".format(node, rec_token))
    94	        if os.path.exists(candidate):
    95	            paths.append(candidate)
    96	    return sorted(paths)
    97	
    98	
    99	def build_manifest(dataset, seed, num_shot=8):
   100	    """Build the reference manifest for every query of ``dataset``.
   101	
   102	    Reads directory listings only (no audio, no metadata, no depth maps), caching one
   103	    ``os.listdir`` per room directory, so the full 6337-query test split takes a couple
   104	    of seconds.
   105	
   106	    Args:
   107	        dataset: an ``xRIR_Dataset`` (only ``file_list`` and ``ir_path`` are used).
   108	        seed: manifest seed; part of every per-query rng seed.
   109	        num_shot: references per query.
   110	
   111	    Returns:
   112	        ``{"seed", "num_shot", "ir_root", "entries"}`` where ``entries`` is one dict per
   113	        query -- ``{"index", "query", "refs"}`` -- sorted by ``query`` with ``index``
   114	        the position in that canonical order, and ``query`` / ``refs`` relative to
   115	        ``ir_root``.  ``query`` is also the key the reference draw is seeded with.
   116	
   117	        Canonical ordering matters: ``dataset.file_list`` comes from ``os.listdir``, so
   118	        a re-copied cache would otherwise reorder the entries and change
   119	        :func:`manifest_hash` for an identical selection.
   120	    """
   121	    ir_root = dataset.ir_path
   122	    listdir_cache = {}
   123	    entries = []
   124	    for ir_path in sorted(dataset.file_list, key=lambda p: os.path.relpath(p, ir_root)):
   125	        query = os.path.relpath(ir_path, ir_root)
   126	        refs = select_references(
   127	            candidate_references(ir_path, listdir_cache=listdir_cache), num_shot, seed, query)
   128	        entries.append({"index": len(entries), "query": query,
   129	                        "refs": [os.path.relpath(ref, ir_root) for ref in refs]})
   130	    return {"seed": seed, "num_shot": num_shot, "ir_root": ir_root, "entries": entries}
   131	
   132	
   133	def manifest_hash(manifest):
   134	    """Hex sha256 of the manifest's *content* -- seed, num_shot and entries.
   135	
   136	    ``ir_root`` is deliberately excluded so the same selection hashes identically no
   137	    matter where the dataset is mounted.
   138	    """
   139	    payload = {"seed": manifest["seed"], "num_shot": manifest["num_shot"],
   140	               "entries": manifest["entries"]}
   141	    return hashlib.sha256(
   142	        json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
   143	
   144	
   145	def save_manifest(manifest, path):
   146	    """Write ``manifest`` to ``path`` as JSON, creating the parent directory."""
   147	    parent = os.path.dirname(os.path.abspath(path))
   148	    if parent:
   149	        os.makedirs(parent, exist_ok=True)
   150	    with open(path, "w") as fout:
   151	        json.dump(manifest, fout)
   152	    return path
   153	
   154	
   155	def load_manifest(path):
   156	    """Read a manifest written by :func:`save_manifest`."""
   157	    with open(path, "r") as fin:
   158	        return json.load(fin)
   159	
   160	
   161	class ManifestDataset(torch.utils.data.Dataset):
   162	    """``xRIR_Dataset`` with its reference draw replaced by a manifest.
   163	
   164	    Iteration follows the **manifest's** order (canonical, sorted by query path), not
   165	    ``dataset.file_list``'s, so the sample at index ``i`` is the same query whatever
   166	    order the cache happens to list its files in.
   167	
   168	    Yields the exp_01 six-tuple -- ``(listener_pos[3], src_local[3],
   169	    depth_coord[3, 256, 512], tgt_wav[1, L], ref_irs[K, L], ref_src_local[K, 3])`` --
   170	    built exactly like ``xRIR_Dataset.__getitem__``, plus a seventh element: the query
   171	    path relative to the IR root, which is the key every per-sample metric is stored
   172	    under (and the key the Griffin-Lim phase seed is derived from).
   173	
   174	    Paths are resolved against ``dataset.ir_path``, not against the manifest's recorded
   175	    ``ir_root``, so a manifest stays usable when the cache is mounted elsewhere.
   176	
   177	    Args:
   178	        dataset: the ``xRIR_Dataset`` the manifest was built from.
   179	        manifest: the manifest dict; validated structurally (see :meth:`_validate`).
   180	
   181	    Raises:
   182	        ValueError: if the manifest does not describe this dataset/split, or breaks one
   183	            of the dataset's own reference rules.
   184	    """
   185	
   186	    def __init__(self, dataset, manifest):
   187	        self._validate(dataset, manifest)
   188	        self.dataset = dataset
   189	        self.manifest = manifest
   190	        self.entries = manifest["entries"]
   191	
   192	    @staticmethod
   193	    def _validate(dataset, manifest):
   194	        """Check the manifest against the dataset and against the dataset's own rules.
   195	
   196	        Order-independent by design (the queries are compared as a set), so a cache that
   197	        lists its files differently still validates; everything that would change *which
   198	        audio is served* is rejected.
   199	        """
   200	        entries = manifest["entries"]
   201	        if manifest["num_shot"] != dataset.num_shot:
   202	            raise ValueError("manifest num_shot {} != dataset num_shot {}".format(
   203	                manifest["num_shot"], dataset.num_shot))
   204	
   205	        queries = [entry["query"] for entry in entries]
   206	        expected = [os.path.relpath(path, dataset.ir_path) for path in dataset.file_list]
   207	        if sorted(queries) != sorted(expected):
   208	            missing = sorted(set(expected) - set(queries))[:3]
   209	            extra = sorted(set(queries) - set(expected))[:3]
   210	            raise ValueError(
   211	                "manifest queries do not match dataset.file_list ({} vs {} entries; "
   212	                "missing e.g. {}, unexpected e.g. {})".format(
   213	                    len(queries), len(expected), missing, extra))
   214	
   215	        for position, entry in enumerate(entries):
   216	            query = entry["query"]
   217	            if entry["index"] != position:
   218	                raise ValueError("entry {} carries index {} (the manifest is not in its "
   219	                                 "canonical order)".format(query, entry["index"]))
   220	            if len(entry["refs"]) != manifest["num_shot"]:
   221	                raise ValueError("{} has {} references, expected {}".format(
   222	                    query, len(entry["refs"]), manifest["num_shot"]))
   223	            room = os.path.dirname(query)
   224	            receiver = os.path.basename(query).split("_")[1]
   225	            for ref in entry["refs"]:
   226	                if ref == query:
   227	                    raise ValueError("{} is used as its own reference".format(query))
   228	                if os.path.dirname(ref) != room:
   229	                    raise ValueError("reference {} of {} is outside the room".format(
   230	                        ref, query))
   231	                if os.path.basename(ref).split("_")[1] != receiver:
   232	                    raise ValueError("reference {} of {} has receiver {}, expected {}".format(
   233	                        ref, query, os.path.basename(ref).split("_")[1], receiver))
   234	
   235	    def __len__(self):
   236	        return len(self.entries)
   237	
   238	    def _load_ir(self, ir_file_path):
   239	        """Load one RIR and zero-pad / truncate it to ``max_len``, as the dataset does."""
   240	        wav, rate = torchaudio.load(ir_file_path)
   241	        assert rate == 22050, "IR sampling rate must be 22050!"
   242	        max_len = self.dataset.max_len
   243	        if wav.shape[1] < max_len:
   244	            wav = torch.cat([wav, torch.zeros(wav.shape[0], max_len - wav.shape[1])], dim=1)
   245	        else:
   246	            wav = wav[:, :max_len]
   247	        return wav
   248	
   249	    def __getitem__(self, idx):
   250	        entry = self.entries[idx]
   251	        dataset = self.dataset
   252	        ir_file_path = os.path.join(dataset.ir_path, entry["query"])
   253	        ir_file_name = os.path.basename(ir_file_path).split("_hybrid_IR")[0]
   254	        scene_name = ir_file_path.split("/")[-3]
   255	        scene_id = ir_file_path.split("/")[-2]
   256	        receiver_idx = int(ir_file_name.split("_")[1][1:])
   257	
   258	        source_pos, listener_pos = dataset.get_receiver_source_location(ir_file_path)
   259	        proj_source_pos = get_3d_point_camera_coord(0, listener_pos, source_pos)
   260	        proj_listener_pos = np.array([0., 0., 0.])
   261	
   262	        pano_depth = np.load(os.path.join(dataset.pano_depth_path, scene_name, scene_id,
   263	                                          "{}.npy".format(receiver_idx)))
   264	        depth_coord = convert_equirect_to_camera_coord(torch.from_numpy(pano_depth), 256, 512)
   265	        tgt_wav = self._load_ir(ir_file_path)
   266	
   267	        all_ref_irs = []
   268	        all_ref_src_pos = []
   269	        for ref in entry["refs"]:
   270	            ref_file_path = os.path.join(dataset.ir_path, ref)
   271	            all_ref_irs.append(self._load_ir(ref_file_path))
   272	            src_loc, rec_loc = dataset.get_receiver_source_location(ref_file_path)
   273	            all_ref_src_pos.append(
   274	                torch.Tensor(get_3d_point_camera_coord(0, rec_loc, src_loc)).float())
   275	
   276	        return (torch.Tensor(proj_listener_pos).float(),
   277	                torch.Tensor(proj_source_pos).float(),
   278	                torch.Tensor(depth_coord).permute(2, 0, 1).float(),
   279	                tgt_wav,
   280	                torch.cat(all_ref_irs, dim=0),
   281	                torch.vstack(all_ref_src_pos),
   282	                entry["query"])

