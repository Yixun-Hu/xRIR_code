   209	def decomposition_at(model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, aligned0, k=32):
   210	    """Where a patch-aligned yaw enters an ``xRIR_Cyl`` forward pass (diagnostic).
   211	
   212	    CylindricalViT's tokens are equivariant to patch-aligned azimuth rolls, but ``xRIR``
   213	    pools them with ``lin_proj_0`` -- a learned linear map over the 256 token *positions*
   214	    -- and separately embeds the raw source xyz.  Neither is shift-invariant, so this
   215	    reports the relative change of each stage for the receiver view, all under the
   216	    pinned ``k = 0`` alignment (condition P):
   217	
   218	    * ``tokens_rel_change`` -- ViT tokens after rolling the rotated ones back by
   219	      ``k / patch_width`` azimuth patches (``~0`` iff the encoder is equivariant);
   220	    * ``pooled_rel_change`` -- the pooled receiver feature ``lin_proj_0(src_proj(tokens))``,
   221	      exactly as ``xRIR.forward`` computes ``receiver_out``;
   222	    * ``coord_rel_change`` -- the sinusoidal source-coordinate embedding;
   223	    * ``logspec_rel_change`` -- the final log-magnitude spectrogram.
   224	
   225	    Args (beyond :func:`forward_conditions`'s):
   226	        k: the patch-aligned angle to decompose (the plan's diagnostic angle is 32).
   227	
   228	    Returns:
   229	        ``{"k", "tokens_rel_change", "pooled_rel_change", "coord_rel_change",
   230	        "logspec_rel_change"}`` -- one int and four floats.
   231	
   232	    Raises:
   233	        TypeError: if ``model.source_network`` is not tokenised on an explicit
   234	            elevation x azimuth grid (i.e. is not a ``CylindricalViT``), so "roll the
   235	            tokens back" would be undefined.
   236	    """
   237	    network = model.source_network
   238	    if not (hasattr(network, "h_tok") and hasattr(network, "w_tok")):
   239	        raise TypeError("decomposition_at needs a CylindricalViT source_network (an "
   240	                        "explicit elevation x azimuth token grid), got {}".format(
   241	                            type(network).__name__))
   242	    h_tok, w_tok = int(network.h_tok), int(network.w_tok)
   243	    width = depth_coord.shape[-1]
   244	    shift = (int(k) % width) // (width // w_tok)
   245	
   246	    depth_k, src_k, _ = rotated_views(depth_coord, src_loc, ref_locs, k)
   247	    batch = depth_coord.shape[0]
   248	    with torch.no_grad():
   249	        tokens_0 = network((-depth_coord) / 5.)
   250	        tokens_k = network((-depth_k) / 5.)
   251	        grid_0 = tokens_0.view(batch, h_tok, w_tok, -1)
   252	        grid_k = torch.roll(tokens_k.view(batch, h_tok, w_tok, -1), shifts=-shift, dims=2)
   253	
   254	        pooled_0 = model.lin_proj_0(model.src_proj(tokens_0).permute(0, 2, 1))
   255	        pooled_k = model.lin_proj_0(model.src_proj(tokens_k).permute(0, 2, 1))
   256	
   257	        coord_0 = model.src_coord_proj(
   258	            model.dist_embedder(src_loc.unsqueeze(1) / 5.).view(batch, -1))
   259	        coord_k = model.src_coord_proj(
   260	            model.dist_embedder(src_k.unsqueeze(1) / 5.).view(batch, -1))

