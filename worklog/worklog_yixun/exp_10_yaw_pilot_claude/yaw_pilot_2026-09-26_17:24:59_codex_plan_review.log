   138	def acoustic_metrics_batch(out_k, tgt_wav, query_keys, evaluator, gl_seed):
   139	    """EDT / C50 / T60 errors of one batch, sample by sample.
   140	
   141	    The magnitude spectrogram is rebuilt exactly as ``eval_xRIR_backbone.py`` does
   142	    (``(exp(out) - 1e-8)[..., 0]``) and inverted with a Griffin-Lim whose random phase
   143	    is seeded from ``(gl_seed, query key)``, so the same query inverts the same
   144	    magnitudes to the same waveform at every angle, in every model and in any angle
   145	    order.  The 8000-sample metric window is applied inside
   146	    ``tools.per_sample_metrics.acoustic_metrics``.
   147	
   148	    Args:
   149	        out_k: predicted log-magnitude spectrograms ``[B, F, T, 1]`` (CPU or CUDA).
   150	        tgt_wav: target RIRs ``[B, 1, L]``.
   151	        query_keys: the ``B`` query paths, in batch order.
   152	        evaluator: an ``eval_unseen.Evaluator``.
   153	        gl_seed: run-level Griffin-Lim seed.
   154	
   155	    Returns:
   156	        ``{"edt", "c50", "t60"}``, each a float64 ``np.ndarray`` of shape ``[B]`` with
   157	        NaN where the sample is invalid at this angle.
   158	
   159	    Raises:
   160	        ValueError: if ``query_keys`` does not have one key per row of ``out_k``.
   161	    """
   162	    if len(query_keys) != out_k.shape[0]:
   163	        raise ValueError("got {} query keys for a batch of {}".format(
   164	            len(query_keys), out_k.shape[0]))
   165	    values = {"edt": [], "c50": [], "t60": []}
   166	    for i in range(out_k.shape[0]):
   167	        mag = (torch.exp(out_k[i:i + 1]) - 1e-8)[..., 0].cpu()
   168	        wav = griffin_lim_seeded(mag, sample_seed(gl_seed, query_keys[i]))
   169	        sample = acoustic_metrics(wav[0].numpy(), tgt_wav[i, 0].cpu().numpy(), evaluator)
   170	        for name in values:
   171	            values[name].append(sample[name])
   172	    return {name: np.asarray(vals, dtype=np.float64) for name, vals in values.items()}
