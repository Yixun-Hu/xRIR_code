   431	def set_precision(tf32):
   432	    """Pin the TF32 policy of both cuBLAS and cuDNN for the whole run.
   433	
   434	    cuDNN's ``allow_tf32`` defaults to ``True``, and the reference-RIR encoder is a
   435	    ResNet-18, so leaving it on makes the forward pass depend on the batch size at the
   436	    1e-4 (relative) level -- measured on 8 real queries: max ``|d|`` 2.3e-4 with TF32 on
   437	    versus 2.4e-7 with it off.  That is far above the effects this experiment measures,
   438	    so TF32 is off by default and the choice is recorded in the run's meta block.
   439	
   440	    Args:
   441	        tf32: whether to allow TF32 for matmuls and convolutions.
   442	    """
   443	    torch.backends.cuda.matmul.allow_tf32 = bool(tf32)
   444	    torch.backends.cudnn.allow_tf32 = bool(tf32)
