   148	def integer_delays(
   149	    src_loc: torch.Tensor,
   150	    ref_locs: torch.Tensor,
   151	    sr: int = 22050,
   152	    c: float = 343.0,
   153	) -> torch.Tensor:
   154	    """Integer direct-path delays exactly as ``model.xRIR.xRIR.shift_and_align`` computes them.
   155	
   156	    The op sequence and dtypes mirror the model line for line
   157	    (``torch.linalg.norm`` -> ``torch.round(...).int()``), so both the values and the
   158	    dtype agree bit for bit with the model's ``delay_unit`` on the same inputs.
   159	
   160	    Args:
   161	        src_loc: receiver-frame query-source position ``[B, 3]``.
   162	        ref_locs: receiver-frame reference-source positions ``[B, K, 3]``.
   163	        sr: sample rate in Hz (the model hard-codes 22050).
   164	        c: speed of sound in m/s (the model hard-codes 343).
   165	
   166	    Returns:
   167	        ``[B, K]`` **int32** tensor of sample delays -- the dtype the model itself produces
   168	        (positive = reference arrives earlier than the query source and is therefore
   169	        shifted right).
   170	    """
   171	    dist_src = torch.linalg.norm(src_loc, dim=1).unsqueeze(1)          # [B, 1]
   172	    dist_ref = torch.linalg.norm(ref_locs, dim=-1)                     # [B, K]
   173	    return torch.round((dist_src - dist_ref) / c * sr).int()           # as in shift_and_align
   174	
   175	
   176	@contextlib.contextmanager
   177	def fixed_alignment(model, aligned_refs: torch.Tensor):
   178	    """Temporarily pin ``model.shift_and_align`` to a pre-computed alignment.
   179	
   180	    ``xRIR.shift_and_align`` is algebraically yaw-invariant but not numerically: float32
   181	    norms plus ``round()`` can flip a delay by one sample under rotation.  The primary
   182	    experimental condition therefore holds the direct-path alignment at the ``k = 0``
   183	    coordinates so that only the geometry branches see the rotation::
   184	
   185	        aligned = model.shift_and_align(refs, src0, ref_locs0)
   186	        with fixed_alignment(model, aligned):
   187	            out, tgt = model(depth_k, refs, src_k, ref_locs_k, tgt)
   188	
   189	    The replacement is installed as a *bound method* of ``model`` (so ``model``'s own
   190	    ``forward`` sees the usual ``self.shift_and_align(x, src, ref)`` call signature), and
   191	    the original bound method is restored on exit, including when the block raises.
   192	
   193	    This mutates ``model`` for the duration of the block: it is for **serial, eager**
   194	    evaluation only and is **not thread-safe** -- do not share ``model`` across threads,
   195	    and do not let a lazily evaluated forward escape the block.
   196	
   197	    Args:
   198	        model: an ``xRIR`` (or subclass) instance.
   199	        aligned_refs: the cached ``[B, K, T]`` aligned reference audio to return instead.
   200	
   201	    Yields:
   202	        ``model``, with its ``shift_and_align`` replaced.
   203	    """
   204	    had_own = "shift_and_align" in vars(model)
   205	    original = vars(model).get("shift_and_align", None)
   206	
   207	    model.shift_and_align = types.MethodType(
   208	        lambda self, x, src_loc, ref_ir_locs: aligned_refs, model)
