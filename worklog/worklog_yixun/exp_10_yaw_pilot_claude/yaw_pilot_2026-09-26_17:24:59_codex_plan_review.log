   307	def build_manifest_dataset(manifest, max_samples=0, max_len=9600):
   308	    """The evaluation dataset: the unseen test split, with the manifest's references.
   309	
   310	    Args:
   311	        manifest: a loaded manifest (its ``num_shot`` selects the dataset's shot count).
   312	        max_samples: keep only the first ``n`` queries in canonical order (smoke runs
   313	            only); ``0`` keeps the whole split.
   314	        max_len: IR length in samples (exp_01's 9600).
   315	
   316	    Returns:
   317	        A ``ManifestDataset`` -- or a :class:`SubsetManifestDataset` of one -- yielding
   318	        the exp_01 six-tuple plus the query path.
   319	    """
   320	    from treble_multi_room_dataset.treble_xRIR_dataset import xRIR_Dataset
   321	
   322	    dataset = xRIR_Dataset(split="test", max_len=max_len, num_shot=manifest["num_shot"])
   323	    full = ManifestDataset(dataset, manifest)
   324	    if int(max_samples) > 0:
   325	        return SubsetManifestDataset(full, min(int(max_samples), len(full)))
