    run_dirs = {i.get("arm"): i.get("run_dir") for i in summary.get("inputs") or []}
    inputs = {i.get("arm"): i for i in summary.get("inputs") or []}
    for kind, items in (("parity_exp03", parity), ("check_online", online)):
