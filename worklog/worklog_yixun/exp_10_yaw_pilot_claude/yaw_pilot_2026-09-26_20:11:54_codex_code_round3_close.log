  1118	                                figsize=(11.0, 3.0 * len(summary["arms"])),
  1119	                                squeeze=False, constrained_layout=True)
  1120	    handles = []
  1121	    for row_index, entry in enumerate(summary["arms"]):
  1122	        arm = entry["arm"]
  1123	        arm_rows = [row for row in rows if row["arm"] == arm]
  1124	        source = band_source(entry["meta"])
  1125	        for column, metric in enumerate(FIGURE_PANELS):
  1126	            band = next((row["band"] for row in arm_rows if row["metric"] == metric),
  1127	                        None)
  1128	            ax = axes[row_index][column]
  1129	            drawn = _panel(ax, arm_rows, metric, band, band_label=BAND_LEGEND_LABEL)
  1130	            handles = _legend_handles(handles, drawn)
  1131	            if column == 0:
  1132	                parts = [arm, ax.get_ylabel()]
  1133	                if source is not None:
  1134	                    parts.append("band: {}".format(source))
  1135	                ax.set_ylabel("\n".join(parts), fontsize=7)
  1136	            if row_index:
  1137	                ax.set_title("")
  1138	    _figure_legend(figure, handles)
  1139	    figure.savefig(path, dpi=300, bbox_inches="tight")
  1140	    return figure
