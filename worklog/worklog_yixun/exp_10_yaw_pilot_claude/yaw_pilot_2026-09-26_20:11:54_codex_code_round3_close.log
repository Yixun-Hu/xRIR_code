/bin/bash -lc "mkdir -p .review-round3/renderer/tmp .review-round3/renderer/mpl .review-round3/renderer/cache
cat > .review-round3/renderer/audit.py <<'PY'
import copy
import json
import os
import sys
import types
from pathlib import Path

sys.path.insert(0, str(Path.cwd()))
from tools import exp10_summarize as s
import matplotlib
import matplotlib.pyplot as plt

ROOT = Path('.review-round3/renderer').resolve()
source = Path('.review-round2/main/summary/yaw_pilot_summary.json').resolve()
smoke = json.loads(source.read_text())
synthetic = copy.deepcopy(smoke)
synthetic['arms'] = []
statuses = ['defined', 'improvement', 'denominator uncertain', 'undefined']
for arm_name, backbone, kshot in [('released_k8','simple',8), ('released_k1','simple',1), ('control_k8','simple',8), ('cyl_k8','cylindrical',8)]:
    entry = copy.deepcopy(smoke['arms'][0])
    entry['arm'] = arm_name
    entry['meta']['arm'] = arm_name
    entry['meta']['backbone'] = backbone
    entry['meta']['num_shot'] = kshot
    for k, status in zip(['64','128','256','384'], statuses):
        for metric in ('T60','C50','EDT'):
            entry['angles'][k][metric]['query']['ratio']['status'] = status
    synthetic['arms'].append(entry)
(ROOT/'synthetic_summary.json').write_text(json.dumps(synthetic, indent=2, allow_nan=False)+'\\n')
results = {'source':str(source), 'python':sys.version, 'matplotlib':matplotlib.__version__, 'figures':[]}

def inspect(fig, renderer):
    blocks = [('text:'+str(i)+':'+text.get_text()[:60], text.get_window_extent(renderer))
              for i, text in enumerate(fig.texts)]
    blocks.extend(('legend:'+str(i), legend.get_window_extent(renderer))
                  for i, legend in enumerate(fig.legends))
    panels = [('panel:'+str(i), ax.get_tightbbox(renderer)) for i, ax in enumerate(fig.axes)]
    overlaps = []
    for i, (label, box) in enumerate(blocks):
        for other_label, other in blocks[i+1:]+panels:
            if box.overlaps(other):
                overlaps.append([label, other_label, list(box.bounds), list(other.bounds)])
    status = next(t.get_window_extent(renderer) for t in fig.texts if t.get_text().startswith('ratio status'))
    qual = next(t.get_window_extent(renderer) for t in fig.texts if 'Griffin-Lim' in t.get_text())
    legend = fig.legends[0].get_window_extent(renderer)
    scale = 72.0/fig.dpi
    return {'renderer':type(renderer).__name__, 'dpi':fig.dpi,
            'blocks':{label:list(box.bounds) for label,box in blocks},
            'panels':{label:list(box.bounds) for label,box in panels},
            'gaps_pt':{'qualification_to_status':(status.y0-qual.y1)*scale,
                       'status_to_legend':(legend.y0-status.y1)*scale,
                       'legend_to_panels':(min(box.y0 for _,box in panels)-legend.y1)*scale},
            'overlaps':overlaps}

for tag, summary in [('smoke', smoke), ('synthetic', synthetic)]:
    for name in [entry['arm'] for entry in summary['arms']]+['all_arms']:
        prefix = ROOT/(tag+'_'+name)
        make = s.make_combined_figure if name=='all_arms' else s.make_figure
        args = (summary, str(prefix)+'.png') if name=='all_arms' else (summary,name,str(prefix)+'.png')
        fig = make(*args)
        captures = []
        orig_draw = fig.draw
        def record_draw(self, renderer):
            orig_draw(renderer)
            captures.append(inspect(self,renderer))
        fig.draw = types.MethodType(record_draw,fig)
        entry = {'name':tag+'_'+name,'formats':{}}
        for extension in ['png','pdf']:
            captures.clear()
            fig.savefig(str(prefix)+'.'+extension,dpi=300,bbox_inches='tight')
            assert captures, 'draw not intercepted'
            entry['formats'][extension] = copy.deepcopy(captures)
            print(entry['name'],extension,'passes',len(captures),'gaps_pt',captures[-1]['gaps_pt'],'overlaps',captures[-1]['overlaps'],flush=True)
        fig.canvas.draw()
        entry['canvas'] = captures[-1]
        results['figures'].append(entry)
        plt.close(fig)
(ROOT/'renderer_results.json').write_text(json.dumps(results,indent=2)+'\\n')
assert all(not cap['overlaps'] for f in results['figures'] for passes in f['formats'].values() for cap in passes)
print('PASS: zero text/text, text/legend, or footer/panel overlaps across all export draws.')
