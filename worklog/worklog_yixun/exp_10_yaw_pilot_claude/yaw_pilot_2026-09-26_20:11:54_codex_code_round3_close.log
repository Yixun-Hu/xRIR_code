result={'footer_bounding_boxes_px':{'status':list(ba.bounds),'pipeline':list(bb.bounds),'overlap':bool(ba.overlaps(bb)),'intersection_height_px':min(ba.y1,bb.y1)-max(ba.y0,bb.y0)}}
