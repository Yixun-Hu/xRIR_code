    93	def arm_section(arm, parity, online, probe=None):
    94	    out = ["<h2 id='%s'>%s</h2>" % (esc(arm["arm"]), esc(arm["arm"]))]
    95	    m = arm["meta"]
    96	    out.append("<p class='meta'>checkpoint <code>%s</code> (sha256 <code>%s…</code>), backbone %s, K = %s, device %s, %d queries, batches %s, manifest <code>%s…</code>, gl_seed %s, execution <code>%s</code>, protocol <code>%s…</code>.</p>" % (
    97	        esc(m.get("checkpoint")), esc(str(m.get("checkpoint_sha256"))[:12]), esc(m.get("backbone")), esc(m.get("num_shot")), esc(m.get("device")),
    98	        arm.get("n_queries", 0), esc(m.get("batches_arg")), esc(str(m.get("manifest_hash"))[:12]), esc(m.get("gl_seed")), esc(arm.get("execution_id")), esc(str(arm.get("protocol_id"))[:12])))
    99	    if arm.get("historical_band_label"):
   100	        out.append("<p class='meta'>Figure band: %s (%s).</p>" % (esc(arm["historical_band_label"]), esc(json.dumps(arm.get("historical_band")))))
   101	    for key, label, unit, scale, shown in METRICS:
   102	        rows = metric_rows(arm, key, scale)
   103	        if not rows:
