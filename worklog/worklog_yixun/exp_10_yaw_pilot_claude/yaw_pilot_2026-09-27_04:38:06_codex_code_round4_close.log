   385	def parse_pairs(items, flag):
   386	    """``["<arm>=<path>", ...]`` → ``[(arm, path), ...]``, refusing a malformed entry."""
   387	    pairs, problems = [], []
   388	    for item in items or []:
   389	        if "=" not in item:
   390	            problems.append("%s %r is not <arm>=<path>" % (flag, item))
   391	            continue
   392	        arm, path = item.split("=", 1)
   393	        if not arm or not path:
   394	            problems.append("%s %r is not <arm>=<path>" % (flag, item))
   395	            continue
   396	        pairs.append((arm, path))
   397	    assert_ok(problems, "bad %s argument" % flag)
   398	    return pairs
