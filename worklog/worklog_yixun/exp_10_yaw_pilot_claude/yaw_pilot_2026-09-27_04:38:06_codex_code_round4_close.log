   401	def check_supplements(summary, parity=(), online=(), probes=(), stage="_all"):
   402	    """Check that every supplemental report belongs to the arm it is attached to.
   403	
   404	    A report is accepted for ``arm`` only when the arm is in this summary, the report's
   405	    ``run_dir`` resolves to the very run directory the summary was built from for that arm,
   406	    and its last path component is that arm's stage directory.  A probe summary must cover
   407	    exactly that arm, have ``batches_arg == "probe"`` and bind its own inputs.  (Codex's
   408	    review attached the cylindrical parity report to the control arm and it was rendered.)
   409	    """
   410	    problems = []
   411	    arms = [a.get("arm") for a in summary.get("arms") or []]
   412	    run_dirs = {i.get("arm"): i.get("run_dir") for i in summary.get("inputs") or []}
   413	    for kind, items in (("parity_exp03", parity), ("check_online", online)):
   414	        for arm, path in items or []:
   415	            label = "%s %s (%s)" % (arm, kind, path)
   416	            if arm not in arms:
   417	                problems.append("%s: %r is not an arm of this summary (%s)"
   418	                                % (label, arm, ", ".join(str(a) for a in arms)))
   419	                continue
   420	            if not os.path.isfile(path):
   421	                problems.append("%s: the report is missing" % label)
   422	                continue
   423	            try:
   424	                report = read_json(path)
   425	            except ValueError as exc:
   426	                problems.append("%s: not readable JSON (%s)" % (label, exc))
   427	                continue
   428	            recorded = report.get("run_dir")
   429	            if recorded is None:
   430	                problems.append("%s: the report has no run_dir; it cannot be bound to an arm"
   431	                                % label)
   432	                continue
   433	            expected_name = "%s%s" % (arm, stage)
   434	            if os.path.basename(str(recorded).rstrip("/")) != expected_name:
   435	                problems.append("%s: the report was written for %r, not this arm's %s"
   436	                                % (label, recorded, expected_name))
   437	            if arm in run_dirs and not same_path(recorded, run_dirs[arm]):
   438	                problems.append("%s: the report's run %r is not the run this summary "
   439	                                "summarised for %s (%s)"
   440	                                % (label, recorded, arm, run_dirs[arm]))
   441	    for arm, path in probes or []:
   442	        label = "%s probe summary (%s)" % (arm, path)
   443	        if arm not in arms:
   444	            problems.append("%s: %r is not an arm of this summary (%s)"
   445	                            % (label, arm, ", ".join(str(a) for a in arms)))
   446	            continue
   447	        _summary, probs, _binding = check_probe_summary(path, arm, None,
   448	                                                       require_controls_ok=False)
   449	        problems.extend(probs)
   450	    return problems
