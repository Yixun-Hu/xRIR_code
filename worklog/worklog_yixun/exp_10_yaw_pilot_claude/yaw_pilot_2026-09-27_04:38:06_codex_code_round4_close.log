   115	            esc(n), esc(c.get("k")), num(c.get("wave_max_abs_diff"), 1, 2), num(c.get("logspec_max_abs_diff"), 1, 2), "ok" if c.get("ok") else "<b>FAIL</b>")
   116	            for n, c in sorted(ctr.get("controls", {}).items()))
   117	        out.append("<h3>Controls (probe)</h3><table><thead><tr><th>control</th><th>k</th><th>max |Δ wave|</th><th>max |Δ log-spec|</th><th>ok</th></tr></thead><tbody>%s</tbody></table><p class='meta'>controls table ok = %s</p>" % (rows, ctr.get("ok")))
   118	    if parity:
   119	        cells = []
