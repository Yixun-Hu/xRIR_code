   370	def link_href(path, assets_dir, assets_href, out_path):
   371	    """The relative href both renderers use for a copied asset (finding 12).
   372	
   373	    A file inside the assets directory is linked through ``assets_href`` (the *published*
   374	    location of that directory, which the finish script stages elsewhere and renames into
   375	    place); anything else is linked relative to the page itself.
   376	    """
   377	    target = os.path.abspath(str(path))
   378	    assets = os.path.abspath(str(assets_dir)) if assets_dir else None
   379	    if assets and (target == assets or target.startswith(assets + os.sep)):
   380	        inside = os.path.relpath(target, assets).replace(os.sep, "/")
   381	        return "%s/%s" % (str(assets_href).rstrip("/"), inside) if inside != "." else str(assets_href)
   382	    return os.path.relpath(target, os.path.dirname(os.path.abspath(str(out_path)))).replace(os.sep, "/")
