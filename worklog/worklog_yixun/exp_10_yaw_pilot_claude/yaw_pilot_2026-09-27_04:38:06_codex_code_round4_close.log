    54	def note_lines(summary):
    55	    """The canonical qualifications, rendered as their *values* (finding 5).
    56	
    57	    ``notes`` is a dict (``band`` / ``broader_population`` / ``gl_free`` / ``pipeline``): the
    58	    keys are labels, the values are the sentences the report has to carry.  The
    59	    ``metric_qualifications`` block says what a Δ and a G mean per metric -- including T60's
    60	    two different denominators -- and belongs in the Markdown as much as in the page.
    61	    """
    62	    lines = []
    63	    notes = summary.get("notes") or {}
    64	    items = (sorted(notes.items()) if isinstance(notes, dict)
    65	             else [(None, text) for text in notes])
    66	    for key, text in items:
    67	        lines.append("> **%s:** %s" % (key, text) if key else "> %s" % text)
    68	    lines.append("")
    69	    qualifications = summary.get("metric_qualifications") or {}
    70	    if qualifications:
    71	        lines += ["**Metric qualifications** (canonical, from the summariser): what a Δ and a "
    72	                  "G mean for each metric, including T60's two denominators.", "",
    73	                  "| metric | Δ (change in the error vs ground truth) | G (shift from the 0° prediction) |",
    74	                  "|---|---|---|"]
    75	        for metric, entry in sorted(qualifications.items()):
    76	            if isinstance(entry, dict):
    77	                lines.append("| %s | %s | %s |" % (metric, entry.get("delta", "–"),
    78	                                                   entry.get("gap", "–")))
    79	            else:
    80	                lines.append("| %s | %s | – |" % (metric, entry))
    81	        lines.append("")
    82	    return lines
