    45	def num(x, scale=1.0, digits=3):
    46	    if x is None:
    47	        return "–"
    48	    return ("%%.%dg" % digits) % (x * scale)
    49	
    50	
    51	def ci(d, scale=1.0, digits=3):
    52	    if not d or d.get("point") is None:
    53	        return "–"
    54	    lo, hi = d.get("lo"), d.get("hi")
    55	    if lo is None or hi is None:
    56	        return "%s (no interval)" % num(d["point"], scale, digits)
    57	    return "%s [%s, %s]" % (num(d["point"], scale, digits), num(lo, scale, digits), num(hi, scale, digits))
    58	
