    31	           ("T60_abs", "T60 (absolute)", "s", 1000.0, "ms"), ("logspec_mad", "log-spec MAD (GL-free)", "", 1.0, ""),
    32	           ("mag_rel_l2", "magnitude rel-L2 (GL-free)", "", 1.0, ""), ("wave_rel_l2", "waveform rel-L2", "", 1.0, ""),
    33	           ("wave_mad", "waveform MAD", "", 1.0, ""), ("log_mse", "log-STFT MSE", "", 1.0, ""), ("loss", "test loss", "", 1.0, "")]
    34	ANGLE_DEG = {"0": "0°", "64": "45°", "128": "90°", "256": "180°", "384": "270°"}
