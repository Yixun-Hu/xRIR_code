   466	def validate_arm(root, arm, expect_n=EXPECTED_N_QUERIES, device="cuda",
   467	                 require_parity=True, array_check="size"):
   468	    """Validate one arm's full run, probe, reports and probe summary."""
   469	    entry = {"arm": arm, "problems": [], "full": None, "probe": None,
   470	             "check_online": None, "parity_all": None, "parity_probe": None,
   471	             "probe_summary": None}
   472	    full_dir = os.path.join(root, "%s_all" % arm)
   473	    probe_dir = os.path.join(root, "%s_probe" % arm)
   474	    full_meta, problems, binding = check_run(
   475	        full_dir, arm=arm, expect_device=device, expect_n=expect_n,
   476	        expect_batches_arg="all", array_check=array_check,
   477	        label="%s_all" % arm)
   478	    entry["full"] = binding
   479	    entry["problems"].extend(problems)
   480	
   481	    report, problems, binding = bind_report(
   482	        os.path.join(full_dir, "check_online.json"), full_dir, full_meta, "check_online",
   483	        require_ok=True, label="%s_all check_online" % arm)
   484	    entry["check_online"] = binding
   485	    entry["problems"].extend(problems)
   486	
   487	    probe_meta, problems, binding = check_run(
   488	        probe_dir, arm=arm, expect_device=device, expect_batches_arg="probe",
   489	        array_check=array_check, label="%s_probe" % arm)
   490	    entry["probe"] = binding
   491	    entry["problems"].extend(problems)
   492	
   493	    report, problems, binding = bind_report(
   494	        os.path.join(probe_dir, "check_online.json"), probe_dir, probe_meta, "check_online",
   495	        require_ok=True, label="%s_probe check_online" % arm)
   496	    entry["probe_check_online"] = binding
   497	    entry["problems"].extend(problems)
   498	
   499	    summary, problems, binding = check_probe_summary(
   500	        os.path.join(probe_dir, "summary", "yaw_pilot_summary.json"), arm, probe_meta,
   501	        probe_dir=probe_dir)
   502	    entry["probe_summary"] = binding
   503	    entry["problems"].extend(problems)
   504	
   505	    for key, stage_dir, stage_meta, label in (
   506	            ("parity_all", full_dir, full_meta, "%s_all parity_exp03" % arm),
   507	            ("parity_probe", probe_dir, probe_meta, "%s_probe parity_exp03" % arm)):
   508	        path = os.path.join(stage_dir, "parity_exp03.json")
   509	        if not require_parity and not os.path.isfile(path):
   510	            entry[key] = None            # released_k1: no exp_03 predecessor to compare to
   511	            continue
   512	        report, problems, binding = bind_report(path, stage_dir, stage_meta, "parity_exp03",
   513	                                                require_ok=True, label=label)
   514	        entry[key] = binding
   515	        entry["problems"].extend(problems)
   516	    return entry
