   519	def validate_cpu_record(run_dir, expect_n=EXPECTED_N_QUERIES, arm="released_k8",
   520	                        array_check="size", recorded_run_dir=None):
   521	    """Validate the CPU-protocol record, preserving its documented parity failure.
   522	
   523	    ``recorded_run_dir`` declares the path this run's reports were written under, for the
   524	    documented relocation into ``cpu_protocol/`` (see ``bind_report``).
   525	    """
   526	    entry = {"arm": arm, "run_dir": os.path.abspath(run_dir), "problems": [],
   527	             "recorded_run_dir": recorded_run_dir}
   528	    meta, problems, binding = check_run(run_dir, arm=arm, expect_device="cpu",
   529	                                        expect_n=expect_n, expect_batches_arg="all",
   530	                                        array_check=array_check,
   531	                                        label="cpu_protocol/%s_all" % arm)
   532	    entry["full"] = binding
   533	    entry["problems"].extend(problems)
   534	    report, problems, binding = bind_report(
   535	        os.path.join(run_dir, "check_online.json"), run_dir, meta, "check_online",
   536	        require_ok=True, label="cpu_protocol/%s_all check_online" % arm,
   537	        also_accept=recorded_run_dir)
   538	    entry["check_online"] = binding
   539	    entry["problems"].extend(problems)
   540	    # Parity must be *present* — the plan's CPU-protocol decision rests on it — but its
   541	    # ok is recorded, not required: exp_10's CPU run fails criterion (a) by design.
   542	    report, problems, binding = bind_report(
   543	        os.path.join(run_dir, "parity_exp03.json"), run_dir, meta, "parity_exp03",
   544	        require_ok=False, label="cpu_protocol/%s_all parity_exp03" % arm,
   545	        also_accept=recorded_run_dir)
   546	    entry["parity_all"] = binding
   547	    entry["problems"].extend(problems)
   548	    return entry
