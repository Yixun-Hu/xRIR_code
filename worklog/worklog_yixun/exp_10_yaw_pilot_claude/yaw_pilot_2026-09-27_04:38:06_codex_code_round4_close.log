   148	def qualification_table(summary):
   149	    """``metric_qualifications``: what Δ and G mean per metric, T60's denominators included."""
   150	    qualifications = summary.get("metric_qualifications") or {}
   151	    if not qualifications:
   152	        return []
   153	    rows = []
   154	    for metric, entry in sorted(qualifications.items()):
   155	        if isinstance(entry, dict):
   156	            rows.append("<tr><td>%s</td><td>%s</td><td>%s</td></tr>"
   157	                        % (esc(metric), esc(entry.get("delta", "–")), esc(entry.get("gap", "–"))))
   158	        else:
   159	            rows.append("<tr><td>%s</td><td>%s</td><td>–</td></tr>" % (esc(metric), esc(entry)))
   160	    return ["<h2>Metric qualifications</h2><p class='meta'>Canonical, from the summariser: "
   161	            "what a Δ and a G mean for each metric — T60's two denominators included.</p>"
   162	            "<div class='scroll'><table><thead><tr><th>metric</th>"
   163	            "<th>Δ (change in the error vs ground truth)</th>"
   164	            "<th>G (shift from the 0° prediction)</th></tr></thead><tbody>%s</tbody></table></div>"
   165	            % "".join(rows)]
