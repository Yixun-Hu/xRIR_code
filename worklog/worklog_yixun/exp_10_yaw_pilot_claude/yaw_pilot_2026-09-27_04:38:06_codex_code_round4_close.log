   263	                problems.append("%s: the report's %s is %r, not the run's %r"
   264	                                % (label, field, report[field], (meta or {}).get(field)))
   265	            else:
   266	                binding["bound_by"].append(field)
   267	    if meta and meta.get("per_sample_sha256"):
   268	        # No identity field in today's reports: the run's own re-verified per-sample hash
   269	        # (checked in check_run) is what the report's run_dir is bound through.
   270	        binding["per_sample_sha256"] = meta["per_sample_sha256"]
   271	        binding["bound_by"].append("meta.per_sample_sha256")
   272	    if require_ok and report.get("ok") is not True:
   273	        problems.append("%s: the report's ok is %r, not true" % (label, report.get("ok")))
   274	    if kind == "parity_exp03" and meta:
   275	        if report.get("manifest_hash") and report["manifest_hash"] != meta.get("manifest_hash"):
   276	            problems.append("%s: the report's manifest_hash %r is not the run's %r"
   277	                            % (label, report.get("manifest_hash"), meta.get("manifest_hash")))
   278	        if report.get("n_rows") is not None and meta.get("n_queries") is not None:
   279	            if int(report["n_rows"]) != int(meta["n_queries"]):
   280	                problems.append("%s: the report compares %s rows, the run has %s queries"
   281	                                % (label, report.get("n_rows"), meta.get("n_queries")))
   282	        binding["exp03_path"] = report.get("exp03_path")
   283	        binding["exp03_sha256"] = report.get("exp03_sha256")
   284	        binding["n_rows"] = report.get("n_rows")
   285	    if kind == "check_online" and meta:
   286	        angles = sorted(int(k) for k in (report.get("angles") or {}))
   287	        if angles and angles != sorted(int(k) for k in (meta.get("ks") or [])):
   288	            problems.append("%s: the report covers angles %s, the run's ks are %s"
   289	                            % (label, angles, meta.get("ks")))
   290	    return report, problems, binding
