   125	                        ANGLE_DEG.get(k, k), mkey, num(c.get("max_abs_diff"), 1, 2), "%.4g" % c.get("fraction_within_tolerance", float("nan")),
   126	                        num(c.get("paired_delta_run"), 1, 4), num(c.get("paired_delta_exp03"), 1, 4), esc(c.get("status"))))
   127	        out.append("<h3>Parity vs exp_03 (%s)</h3><p class='meta'>ok = %s; rows %s; missing required %s; exp_03 file sha256 <code>%s…</code></p><div class='scroll'><table><thead><tr><th>angle</th><th>metric</th><th>max |Δ|</th><th>within tol.</th><th>paired Δ (run)</th><th>paired Δ (exp_03)</th><th>status</th></tr></thead><tbody>%s</tbody></table></div>" % (
   128	            esc(os.path.basename(os.path.dirname(parity.get("exp03_path", "")))), parity.get("ok"), parity.get("n_rows"), esc(parity.get("missing_required")), esc(str(parity.get("exp03_sha256"))[:12]), "".join(cells)))
   129	    if online is not None:
