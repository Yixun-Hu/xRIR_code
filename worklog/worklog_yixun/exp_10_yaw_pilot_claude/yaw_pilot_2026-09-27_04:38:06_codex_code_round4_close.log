   293	def verify_summary_inputs(summary, arms=None, label="summary"):
   294	    """Re-verify a summariser JSON's ``inputs`` against the live files it names.
   295	
   296	    Both bindings the summariser itself records are checked: the per-sample and meta files
   297	    must still hash to what the summary was built from, and each run's meta must still bind
   298	    its own per-sample file.  A summary that fails this is not evidence for its numbers.
   299	    """
   300	    problems = []
   301	    entries = summary.get("inputs")
   302	    if not entries:
   303	        return ["%s: has no inputs block; its numbers are unbound" % label]
   304	    for entry in entries:
   305	        run_dir = entry.get("run_dir")
   306	        if arms is not None and entry.get("arm") not in arms:
   307	            problems.append("%s: input arm %r is not one of %s"
   308	                            % (label, entry.get("arm"), ", ".join(sorted(arms))))
   309	        for name, key in (("per_sample.json", "per_sample_sha256"), ("meta.json", "meta_sha256")):
   310	            path = os.path.join(str(run_dir), name)
   311	            if not os.path.isfile(path):
   312	                problems.append("%s: %s is missing; the summary cannot be verified" % (label, path))
   313	                continue
   314	            live = file_sha256(path)
   315	            if live != entry.get(key):
   316	                problems.append("%s: %s hashes to %s, not the %s the summary was built from"
   317	                                % (label, path, live, entry.get(key)))
   318	        meta_path = os.path.join(str(run_dir), "meta.json")
   319	        if os.path.isfile(meta_path):
   320	            meta = read_json(meta_path)
   321	            if meta.get("per_sample_sha256") != entry.get("per_sample_sha256"):
   322	                problems.append("%s: %s no longer binds its per-sample file (meta %r vs "
   323	                                "summary %r)" % (label, run_dir, meta.get("per_sample_sha256"),
   324	                                                 entry.get("per_sample_sha256")))
   325	            for field in ("execution_id", "protocol_id"):
   326	                if meta.get(field) != entry.get(field):
   327	                    problems.append("%s: %s has %s %r, the summary recorded %r"
   328	                                    % (label, run_dir, field, meta.get(field), entry.get(field)))
   329	    return problems
