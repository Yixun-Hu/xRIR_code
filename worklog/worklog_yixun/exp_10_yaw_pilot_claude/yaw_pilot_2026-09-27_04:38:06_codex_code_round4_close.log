    81	def ratio_text(h, q, cell):
    82	    """The multiple where the headline is reportable, otherwise its reason.
    83	
    84	    The room status has its own column (finding 6): it used to be appended here, which meant
    85	    a reportable cell -- the very cell whose multiple is quoted -- showed no room status at
    86	    all (control EDT at 90 degrees: 17.8x with the canonical "denominator uncertain" lost).
    87	    """
    88	    if h.get("reportable"):
    89	        return "<b>%s×</b> [%s, %s]" % (num(h["point"], 1, 3), num(h.get("lower_bound"), 1, 3), num(h.get("upper_bound"), 1, 3))
    90	    return esc(h.get("reason") or q.get("ratio", {}).get("reason") or "–")
