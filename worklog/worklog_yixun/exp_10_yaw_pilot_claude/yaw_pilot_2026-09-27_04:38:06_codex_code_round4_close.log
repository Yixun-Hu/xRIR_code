   332	def check_probe_summary(path, arm, probe_meta, probe_dir=None, require_controls_ok=True):
   333	    """Validate a probe run's own summary: exactly that arm, that execution, controls ok."""
   334	    label = "%s probe summary" % arm
   335	    problems, binding = [], {"path": os.path.abspath(path)}
   336	    if not os.path.isfile(path):
   337	        return None, ["%s: %s is missing" % (label, path)], binding
   338	    try:
   339	        summary = read_json(path)
   340	    except ValueError as exc:
   341	        return None, ["%s: not readable JSON (%s)" % (label, exc)], binding
   342	    binding["sha256"] = file_sha256(path)
   343	    arms = summary.get("arms") or []
   344	    if len(arms) != 1 or arms[0].get("arm") != arm:
   345	        problems.append("%s: the summary covers %r, not exactly the one arm %r"
   346	                        % (label, [a.get("arm") for a in arms], arm))
   347	        return summary, problems, binding
   348	    entry = arms[0]
   349	    binding["execution_id"] = entry.get("execution_id")
   350	    binding["n_queries"] = entry.get("n_queries")
   351	    binding["controls_ok"] = (entry.get("controls") or {}).get("ok")
   352	    if probe_meta and entry.get("execution_id") != probe_meta.get("execution_id"):
   353	        problems.append("%s: the summary's execution %r is not the probe run's %r"
   354	                        % (label, entry.get("execution_id"), probe_meta.get("execution_id")))
   355	    if (entry.get("meta") or {}).get("batches_arg") != "probe":
   356	        problems.append("%s: the summarised run's batches_arg is %r, not 'probe'"
   357	                        % (label, (entry.get("meta") or {}).get("batches_arg")))
   358	    if probe_dir is not None and not same_path(entry.get("run_dir") or "", probe_dir):
   359	        # run_dir is recorded relative to the repository root, so resolve both ways.
   360	        inputs = [i.get("run_dir") for i in summary.get("inputs") or []]
   361	        if not any(same_path(p or "", probe_dir) for p in inputs):
   362	            problems.append("%s: the summary's run %r is not the probe directory %s"
   363	                            % (label, entry.get("run_dir"), os.path.abspath(probe_dir)))
   364	    if require_controls_ok and binding["controls_ok"] is not True:
   365	        problems.append("%s: controls.ok is %r, not true" % (label, binding["controls_ok"]))
   366	    problems.extend(verify_summary_inputs(summary, label=label))
   367	    return summary, problems, binding
