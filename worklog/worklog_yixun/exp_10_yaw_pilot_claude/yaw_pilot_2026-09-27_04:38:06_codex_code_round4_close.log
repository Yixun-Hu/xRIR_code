   168	def main():
   169	    ap = argparse.ArgumentParser()
   170	    ap.add_argument("--summary", required=True)
   171	    ap.add_argument("--out", required=True)
   172	    ap.add_argument("--assets", required=True)
   173	    ap.add_argument("--parity", nargs="*", default=[])
   174	    ap.add_argument("--check-online", nargs="*", default=[])
   175	    ap.add_argument("--probe", nargs="*", default=[], help="<arm>=<probe summary JSON>: controls are rendered from the probe run")
   176	    ap.add_argument("--title", default="exp_10 yaw_pilot — results")
   177	    ap.add_argument("--assets-href", default=None,
   178	                    help="the published location of --assets, for the relative links (the "
   179	                         "finish script stages the assets and renames them into place)")
   180	    ap.add_argument("--backend-table", default=None,
   181	                    help="the GPU-vs-CPU backend-sensitivity Markdown, linked from the page")
   182	    ap.add_argument("--cpu-record", default=None,
   183	                    help="the CPU-protocol record (its tables), linked from the page")
   184	    args = ap.parse_args()
   185	    vr.assert_ok(["%s: %s is missing" % (flag, path)
   186	                  for flag, path in (("--backend-table", args.backend_table),
   187	                                     ("--cpu-record", args.cpu_record))
   188	                  if path and not os.path.exists(path)],
   189	                 "refusing to link a supplementary file that is not there")
   190	    s = json.load(open(args.summary))
   191	    vr.assert_ok(vr.verify_summary_inputs(s, label="the canonical summary (%s)" % args.summary),
   192	                 "refusing to render a summary that is not bound to the runs it came from")
   193	    parity_pairs = vr.parse_pairs(args.parity, "--parity")
   194	    online_pairs = vr.parse_pairs(args.check_online, "--check-online")
   195	    probe_pairs = vr.parse_pairs(args.probe, "--probe")
   196	    vr.assert_ok(vr.check_supplements(s, parity=parity_pairs, online=online_pairs,
   197	                                      probes=probe_pairs),
   198	                 "refusing to render supplemental reports that are not this arm's")
   199	    os.makedirs(args.assets, exist_ok=True)
   200	    sdir = os.path.dirname(os.path.abspath(args.summary))
   201	    # Only what this summary names: its own JSON, its tables, its CSV and its figures.
   202	    figures = vr.figure_names(s)
   203	    wanted = ["yaw_pilot_summary.json", "yaw_pilot_tables.md", "yaw_pilot_gaps.csv"] + figures
   204	    required = [n for n in wanted if not n.endswith(".pdf")]
   205	    vr.assert_ok(["%s: the summariser's directory has no %s" % (sdir, n)
   206	                  for n in required if not os.path.isfile(os.path.join(sdir, n))],
   207	                 "refusing to render: this summary's own outputs are incomplete")
   208	    copied = {}
   209	    for fn in wanted:
   210	        src = os.path.join(sdir, fn)
   211	        if not os.path.isfile(src):
   212	            continue                       # the .pdf companions are optional
   213	        shutil.copy2(src, os.path.join(args.assets, fn))
   214	        copied[fn] = sha(os.path.join(args.assets, fn))
   215	    left = [fn for fn in sorted(os.listdir(sdir))
   216	            if fn not in wanted and os.path.isfile(os.path.join(sdir, fn))]
   217	    if left:
   218	        print("not copied (not named by this summary):", ", ".join(left))
   219	    parity = {arm: json.load(open(path)) for arm, path in parity_pairs}
   220	    online = {arm: json.load(open(path)) for arm, path in online_pairs}
   221	    probes = {arm: json.load(open(path)) for arm, path in probe_pairs}
   222	    rel = args.assets_href or os.path.relpath(args.assets,
   223	                                              os.path.dirname(os.path.abspath(args.out)))
   224	
   225	    def href(path):
   226	        return vr.link_href(path, args.assets, rel, args.out)
   227	
   228	    def shown(path):
   229	        """An input inside the asset directory is named by its *published* location: the
   230	        finish script stages the assets under another name and renames them into place."""
   231	        target = os.path.abspath(path)
   232	        assets = os.path.abspath(args.assets)
   233	        return href(path) if target.startswith(assets + os.sep) else target
   234	
   235	    input_shas = {shown(args.summary): sha(args.summary)}
   236	    for _arm, p in parity_pairs + online_pairs + probe_pairs:
   237	        input_shas[shown(p)] = sha(p)
   238	    for p in (args.backend_table, args.cpu_record):
   239	        if p:
   240	            input_shas[shown(p)] = sha(p)
   241	
   242	    parts = ["<!doctype html><html><head><meta charset='utf-8'><title>%s</title><style>body{font-family:system-ui,sans-serif;max-width:1400px;margin:2em auto;padding:0 1em;color:#222}table{border-collapse:collapse;font-size:13px}th,td{border:1px solid #ccc;padding:3px 7px;text-align:right}th{background:#f3f3f3}td:first-child,th:first-child{text-align:left}.meta{color:#555;font-size:13px}.unit{color:#777;font-weight:normal}.scroll{overflow-x:auto}.note{background:#fff8e1;border-left:4px solid #e69f00;padding:.6em 1em;margin:1em 0}img{max-width:100%%}code{font-size:12px}</style></head><body>" % esc(args.title)]
   243	    parts.append("<h1>%s</h1>" % esc(args.title))
   244	    parts.append("<p class='meta'>Descriptive pilot (plan v3.1): per arm and angle, Δ = paired mean change of the error vs ground truth (α minus 0°), G = mean shift of the prediction at α relative to the prediction at 0° (no ground truth), on the shared comparison mask; %d bootstrap replicates, seeds %s, %.0f %% intervals; query-level and room-cluster (17 rooms) intervals shown separately. Generated %s by %s.</p>" % (
   245	        s.get("n_boot", 0), esc(s.get("seeds")), 100 * (1 - s.get("alpha", 0.05)), esc(s.get("generated_at")), esc(s.get("tool"))))
   246	    parts.extend(note_blocks(s))
   247	    parts.extend(qualification_table(s))
   248	    links = []
   249	    for label, path in (("full tables (every angle, every metric, exclusions, broader-population G)",
   250	                         os.path.join(args.assets, "yaw_pilot_tables.md")),
   251	                        ("canonical summary JSON (the source of every number on this page)",
   252	                         os.path.join(args.assets, "yaw_pilot_summary.json")),
   253	                        ("figure data (CSV)", os.path.join(args.assets, "yaw_pilot_gaps.csv")),
   254	                        ("backend sensitivity: GPU (primary) vs CPU protocol", args.backend_table),
   255	                        ("CPU-protocol record", args.cpu_record)):
   256	        if path and os.path.exists(path):
   257	            links.append("<li><a href='%s'>%s</a></li>" % (esc(href(path)), esc(label)))
   258	    if links:
   259	        parts.append("<h2>Supplementary results and data</h2><ul class='meta'>%s</ul>"
   260	                     % "".join(links))
   261	    if "yaw_pilot_gaps_all_arms.png" in copied:
   262	        parts.append("<h2>All arms</h2><img src='%s/yaw_pilot_gaps_all_arms.png' alt='all arms'>" % esc(rel))
   263	    for arm in s["arms"]:
   264	        parts.append(arm_section(arm, parity.get(arm["arm"]), online.get(arm["arm"]), probes.get(arm["arm"])))
   265	        fig = "yaw_pilot_gaps_%s.png" % arm["arm"]
   266	        if fig in copied:
   267	            parts.append("<img src='%s/%s' alt='%s'>" % (esc(rel), esc(fig), esc(arm["arm"])))
   268	    parts.append("<h2>Provenance</h2><ul class='meta'>%s</ul><ul class='meta'>%s</ul>" % (
   269	        "".join("<li><code>%s</code> sha256 <code>%s</code></li>" % (esc(p), esc(h)) for p, h in sorted(input_shas.items())),
   270	        "".join("<li>asset <code>%s</code> sha256 <code>%s</code></li>" % (esc(p), esc(h)) for p, h in sorted(copied.items()))))
   271	    parts.append("<ul class='meta'>%s</ul>" % "".join("<li>%s: execution <code>%s</code>, per_sample sha256 <code>%s</code>, meta sha256 <code>%s</code></li>" % (
   272	        esc(i["arm"]), esc(i["execution_id"]), esc(i["per_sample_sha256"]), esc(i["meta_sha256"])) for i in s.get("inputs", [])))
   273	    parts.append("</body></html>")
   274	    with open(args.out, "w") as f:
   275	        f.write("\n".join(parts))
   276	    print("wrote", args.out, "assets", len(copied))
