   550	
   551	def validate_record(root, arms=ARMS, expect_n=EXPECTED_N_QUERIES, device="cuda",
   552	                    cpu_run=None, array_check="size", parity_arms=PARITY_ARMS,
   553	                    cpu_recorded_run_dir=None):
   554	    """Validate the whole evidence tree; returns a report whose ``ok`` decides the finish.
   555	
   556	    Args:
   557	        root: the directory holding ``<arm>_all`` / ``<arm>_probe`` (``ckpt/exp10``).
   558	        arms: the arms the record prescribes.
   559	        expect_n: the full runs' query count.
   560	        device: the device the GPU arms must have run on.
   561	        cpu_run: the CPU-protocol run directory; ``None`` → ``<root>/cpu_protocol/released_k8_all``;
   562	            ``False`` → do not validate a CPU record.
   563	        cpu_recorded_run_dir: the path the CPU record's reports name, if the directory was
   564	            moved after they were written (a declared relocation, recorded in the report).
   565	        array_check: ``size`` (default), ``full`` or ``none``.
   566	        parity_arms: the arms with an exp_03 predecessor (parity required).
   567	
   568	    Returns:
   569	        ``{"ok", "root", "arms", "cpu", "problems"}``.
   570	    """
   571	    report = {"ok": False, "root": os.path.abspath(root), "expect_n": int(expect_n),
   572	              "device": device, "array_check": array_check,
   573	              "arms": {}, "cpu": None, "problems": []}
   574	    for arm in arms:
   575	        entry = validate_arm(root, arm, expect_n=expect_n, device=device,
   576	                             require_parity=arm in parity_arms, array_check=array_check)
   577	        report["arms"][arm] = entry
   578	        report["problems"].extend(entry["problems"])
   579	    for field in ("execution_id", "protocol_id"):
   580	        seen = {}
   581	        for arm, entry in sorted(report["arms"].items()):
   582	            value = (entry.get("full") or {}).get(field)
   583	            if not value:
   584	                continue
   585	            if value in seen:
   586	                report["problems"].append(
   587	                    "%s and %s share one %s (%s): that is one execution presented twice, "
   588	                    "not two arms" % (seen[value], arm, field, value))
   589	            seen[value] = arm
   590	    if cpu_run is not False:
   591	        cpu_run = cpu_run or os.path.join(root, "cpu_protocol", "released_k8_all")
   592	        entry = validate_cpu_record(cpu_run, expect_n=expect_n, array_check=array_check,
   593	                                    recorded_run_dir=cpu_recorded_run_dir)
   594	        report["cpu"] = entry
   595	        report["problems"].extend(entry["problems"])
   596	    report["ok"] = not report["problems"]
   597	    return report
   598	
   599	
   600	def main(argv=None):
   601	    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
   602	    parser.add_argument("--root", default="ckpt/exp10")
   603	    parser.add_argument("--arms", nargs="+", default=list(ARMS))
   604	    parser.add_argument("--expect-n", type=int, default=EXPECTED_N_QUERIES)
   605	    parser.add_argument("--device", default="cuda")
   606	    parser.add_argument("--cpu-run", default=None)
   607	    parser.add_argument("--cpu-recorded-run-dir", default=None,
   608	                        help="the run_dir the CPU record's reports name, if its directory "
   609	                             "was moved after they were written (declared relocation)")
   610	    parser.add_argument("--no-cpu", action="store_true",
   611	                        help="do not validate a CPU-protocol record")
   612	    parser.add_argument("--array-check", choices=("none", "size", "full"), default="size")
   613	    parser.add_argument("--json", default=None, help="write the validation report here")
   614	    args = parser.parse_args(argv)
   615	    report = validate_record(args.root, arms=tuple(args.arms), expect_n=args.expect_n,
   616	                             device=args.device,
   617	                             cpu_run=False if args.no_cpu else args.cpu_run,
   618	                             array_check=args.array_check,
   619	                             cpu_recorded_run_dir=args.cpu_recorded_run_dir)
   620	    if args.json:
   621	        parent = os.path.dirname(os.path.abspath(args.json))
   622	        if parent and not os.path.isdir(parent):
   623	            os.makedirs(parent)
   624	        with open(args.json, "w") as fout:
   625	            json.dump(report, fout, indent=2, sort_keys=True)
   626	    for problem in report["problems"]:
   627	        print("REFUSED: %s" % problem)
   628	    if report["ok"]:
   629	        print("validate_runs: %d arms + %s validated and bound under %s"
   630	              % (len(args.arms), "the CPU record" if report["cpu"] else "no CPU record",
   631	                 report["root"]))
   632	        return 0
   633	    print("validate_runs: %d requirement(s) failed" % len(report["problems"]))
   634	    return 2
   635	
   636	
   637	if __name__ == "__main__":
   638	    sys.exit(main())

