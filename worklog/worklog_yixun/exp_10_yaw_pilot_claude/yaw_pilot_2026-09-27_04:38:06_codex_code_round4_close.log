   134	def note_blocks(summary):
   135	    """The canonical ``notes`` rendered as their *values* (finding 5).
   136	
   137	    ``notes`` is a dict whose keys are labels (``band``, ``gl_free``, ``pipeline``,
   138	    ``broader_population``); printing the keys, as this page used to, dropped every
   139	    qualification the plan requires the report to carry.
   140	    """
   141	    notes = summary.get("notes") or {}
   142	    items = (sorted(notes.items()) if isinstance(notes, dict)
   143	             else [(None, text) for text in notes])
   144	    return ["<div class='note'>%s%s</div>" % (("<b>%s:</b> " % esc(key)) if key else "",
   145	                                              esc(text)) for key, text in items]
