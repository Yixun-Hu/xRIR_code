    64	def metric_rows(arm, key, scale):
    65	    rows = []
    66	    for k in sorted(arm["angles"], key=int):
    67	        if k == "0":
    68	            continue
    69	        cell = arm["angles"][k].get(key)
    70	        if not cell:
    71	            continue
    72	        q, r, h = cell["query"], cell.get("room", {}), cell.get("headline", {})
    73	        rows.append("<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%d</td><td>%s</td><td>%s</td><td>%s</td></tr>" % (
    74	            ANGLE_DEG.get(k, k), num(q.get("mean_0"), scale), num(q.get("mean_alpha"), scale), ci(q.get("delta"), scale),
    75	            ci(r.get("delta"), scale) if r else "–", ci(q.get("gap"), scale), ci(r.get("gap"), scale) if r else "–",
    76	            q.get("n", 0), esc(q.get("ratio", {}).get("status", "–")),
    77	            esc(cell.get("room_status") or "–"), ratio_text(h, q, cell)))
    78	    return "\n".join(rows)
