     1	#!/usr/bin/env python3
     2	"""Write exp_10's `_results.md` from the canonical summariser JSON (+ optional parity / check-online JSONs).
     3	
     4	usage: make_results_md.py --summary <yaw_pilot_summary.json> --out <yaw_pilot_results.md>
     5	       [--parity <arm>=<parity_exp03.json> ...] [--check-online <arm>=<check_online.json> ...]
     6	Only the headline metrics (EDT, C50, T60, T60_abs, logspec_mad) go into the compact tables; the
     7	summariser's own `yaw_pilot_tables.md` (copied into the assets) carries everything else.
     8	
     9	As in the HTML page, nothing is written unbound (Codex tooling review, finding 4): the
    10	summary's `inputs` hashes are re-verified against the live runs and every supplemental report
    11	has to belong to the arm it is attached to.
    12	"""
    13	import argparse
    14	import hashlib
    15	import json
    16	import os
    17	import sys
    18	
    19	sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    20	import validate_runs as vr                                          # noqa: E402
    21	
    22	HEAD = [("EDT", "EDT", 1000.0, "ms"), ("C50", "C50", 1.0, "dB"), ("T60", "T60", 1.0, "pp (Δ) / % (G)"),
    23	        ("T60_abs", "T60 absolute", 1000.0, "ms"), ("logspec_mad", "log-spec MAD (GL-free)", 1.0, "")]
    24	DEG = {"0": "0°", "64": "45°", "128": "90°", "256": "180°", "384": "270°"}
    25	
    26	
    27	def sha(path):
    28	    h = hashlib.sha256()
    29	    with open(path, "rb") as f:
    30	        for c in iter(lambda: f.read(1 << 20), b""):
    31	            h.update(c)
    32	    return h.hexdigest()
    33	
    34	
    35	def n3(x, s=1.0):
    36	    return "–" if x is None else "%.3g" % (x * s)
    37	
    38	
    39	def ci(d, s=1.0):
    40	    if not d or d.get("point") is None:
    41	        return "–"
    42	    if d.get("lo") is None or d.get("hi") is None:
    43	        return "%s (no CI)" % n3(d["point"], s)
    44	    return "%s [%s, %s]" % (n3(d["point"], s), n3(d["lo"], s), n3(d["hi"], s))
    45	
    46	
    47	def multiple(cell):
    48	    h = cell.get("headline", {})
    49	    if h.get("reportable"):
    50	        return "**%s×** [%s, %s]" % (n3(h["point"]), n3(h.get("lower_bound")), n3(h.get("upper_bound")))
    51	    return h.get("reason") or cell["query"].get("ratio", {}).get("reason") or "–"
    52	
