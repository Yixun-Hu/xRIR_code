    37	def sha(path):
    38	    h = hashlib.sha256()
    39	    with open(path, "rb") as f:
    40	        for chunk in iter(lambda: f.read(1 << 20), b""):
    41	            h.update(chunk)
    42	    return h.hexdigest()
