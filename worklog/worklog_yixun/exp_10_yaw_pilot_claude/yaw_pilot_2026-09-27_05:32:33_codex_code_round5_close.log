   400	def summary_run_dir(summary, arm):
   401	    """The run directory a summary names for ``arm``.
   402	
   403	    The ``inputs`` binding is preferred because the summariser records it as an absolute
   404	    path, while an ``arms[]`` entry's ``run_dir`` is whatever was passed on the command line
   405	    (exp_10's probe summaries carry ``ckpt/exp10/<arm>_probe``, relative to the repository
   406	    root); the arm entry is the fallback when there is no inputs binding.
   407	    """
   408	    for entry in summary.get("inputs") or []:
   409	        if entry.get("arm") == arm and entry.get("run_dir"):
   410	            return entry["run_dir"]
   411	    for entry in summary.get("arms") or []:
   412	        if entry.get("arm") == arm and entry.get("run_dir"):
   413	            return entry["run_dir"]
   414	    return None
