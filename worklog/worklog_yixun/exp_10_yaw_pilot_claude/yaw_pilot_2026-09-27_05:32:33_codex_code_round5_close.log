   384	def parse_pairs(items, flag):
   385	    """``["<arm>=<path>", ...]`` → ``[(arm, path), ...]``, refusing a malformed entry."""
   386	    pairs, problems = [], []
   387	    for item in items or []:
   388	        if "=" not in item:
   389	            problems.append("%s %r is not <arm>=<path>" % (flag, item))
   390	            continue
   391	        arm, path = item.split("=", 1)
   392	        if not arm or not path:
   393	            problems.append("%s %r is not <arm>=<path>" % (flag, item))
   394	            continue
   395	        pairs.append((arm, path))
   396	    assert_ok(problems, "bad %s argument" % flag)
   397	    return pairs
