   441	def check_supplements(summary, parity=(), online=(), probes=(), stage="_all"):
   442	    """Check that every supplemental report belongs to the arm it is attached to.
   443	
   444	    A report is accepted for ``arm`` only when the arm is in this summary, the report's
   445	    ``run_dir`` resolves to the very run directory the summary was built from for that arm,
   446	    its last path component is that arm's stage directory, and — through ``bind_report`` —
   447	    every identity field the report carries agrees with the live ``meta.json`` of that run.
   448	    The last part is the round-4 review's finding 4: reports with the correct path and a
   449	    deliberately wrong ``execution_id`` / ``protocol_id`` / ``per_sample_sha256`` were
   450	    rendered, because the binding was ``run_dir`` alone.  ``ok`` is *not* required here —
   451	    the page prints whatever the report says; requiring it is the record preflight's job
   452	    (``validate_arm``).
   453	
   454	    A probe summary must cover exactly that arm, bind its own inputs, and bind the meta of
   455	    the run it names: that run has to be a probe run (``batches_arg == "probe"``) of this
   456	    arm, with the execution the probe summary claims.  (The embedded ``meta`` is part of the
   457	    summary, so it can say "probe" about a full run; the live meta cannot.)
   458	    """
   459	    problems = []
   460	    arms = [a.get("arm") for a in summary.get("arms") or []]
   461	    run_dirs = {i.get("arm"): i.get("run_dir") for i in summary.get("inputs") or []}
   462	    inputs = {i.get("arm"): i for i in summary.get("inputs") or []}
   463	    for kind, items in (("parity_exp03", parity), ("check_online", online)):
   464	        for arm, path in items or []:
   465	            label = "%s %s (%s)" % (arm, kind, path)
   466	            if arm not in arms:
   467	                problems.append("%s: %r is not an arm of this summary (%s)"
   468	                                % (label, arm, ", ".join(str(a) for a in arms)))
   469	                continue
   470	            if not os.path.isfile(path):
   471	                problems.append("%s: the report is missing" % label)
   472	                continue
   473	            try:
   474	                report = read_json(path)
   475	            except ValueError as exc:
   476	                problems.append("%s: not readable JSON (%s)" % (label, exc))
   477	                continue
   478	            recorded = report.get("run_dir")
   479	            if recorded is None:
   480	                problems.append("%s: the report has no run_dir; it cannot be bound to an arm"
   481	                                % label)
   482	                continue
   483	            expected_name = "%s%s" % (arm, stage)
   484	            if os.path.basename(str(recorded).rstrip("/")) != expected_name:
   485	                problems.append("%s: the report was written for %r, not this arm's %s"
   486	                                % (label, recorded, expected_name))
   487	            if arm not in run_dirs:
   488	                problems.append("%s: the summary has no inputs entry for %s, so the report "
   489	                                "cannot be bound to the run it was summarised from"
   490	                                % (label, arm))
   491	                continue
   492	            if not same_path(recorded, run_dirs[arm]):
   493	                problems.append("%s: the report's run %r is not the run this summary "
   494	                                "summarised for %s (%s)"
   495	                                % (label, recorded, arm, run_dirs[arm]))
   496	                continue            # a report about another run: there is nothing to bind
   497	            meta = _live_identity(problems, label, run_dirs[arm], inputs.get(arm),
   498	                                  "the report")
   499	            _report, probs, _binding = bind_report(path, run_dirs[arm], meta, kind,
   500	                                                   require_ok=False, label=label)
   501	            problems.extend(probs)
   502	    for arm, path in probes or []:
   503	        label = "%s probe summary (%s)" % (arm, path)
   504	        if arm not in arms:
   505	            problems.append("%s: %r is not an arm of this summary (%s)"
   506	                            % (label, arm, ", ".join(str(a) for a in arms)))
   507	            continue
   508	        if not os.path.isfile(path):
   509	            problems.append("%s: the probe summary is missing" % label)
