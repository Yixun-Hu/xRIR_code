                  m.get("checkpoint"), str(m.get("checkpoint_sha256"))[:12], m.get("backbone"), m.get("num_shot"), m.get("device"),
                  arm.get("n_queries", 0), m.get("batches_arg"), str(m.get("manifest_hash"))[:12], m.get("gl_seed"), arm.get("execution_id")), ""]
