   277	def verify_summary_inputs(summary, arms=None, label="summary"):
   278	    """Re-verify a summariser JSON's ``inputs`` against the live files it names.
   279	
   280	    Both bindings the summariser itself records are checked: the per-sample and meta files
   281	    must still hash to what the summary was built from, and each run's meta must still bind
   282	    its own per-sample file.  A summary that fails this is not evidence for its numbers.
   283	
   284	    The ``inputs`` also have to be a *bijection* with the arms the summary renders: the
   285	    round-4 review kept only the control arm's binding and all three arms still rendered, so
   286	    an arm with no entry — or with two entries claiming it — is refused here.
   287	    """
   288	    problems = []
   289	    entries = summary.get("inputs")
   290	    if not entries:
   291	        return ["%s: has no inputs block; its numbers are unbound" % label]
   292	    rendered = [a.get("arm") for a in summary.get("arms") or []]
   293	    counts = {}
   294	    for entry in entries:
   295	        counts[entry.get("arm")] = counts.get(entry.get("arm"), 0) + 1
   296	    for arm in rendered:
   297	        if counts.get(arm, 0) != 1:
   298	            problems.append("%s: arm %r is rendered but %d inputs entries bind it; exactly "
   299	                            "one has to" % (label, arm, counts.get(arm, 0)))
   300	    for arm in sorted(str(k) for k in counts if rendered and k not in rendered):
   301	        problems.append("%s: the inputs entry for %r binds no rendered arm (this summary "
   302	                        "covers %s)" % (label, arm, ", ".join(str(a) for a in rendered)))
   303	    for entry in entries:
   304	        run_dir = entry.get("run_dir")
   305	        if arms is not None and entry.get("arm") not in arms:
   306	            problems.append("%s: input arm %r is not one of %s"
   307	                            % (label, entry.get("arm"), ", ".join(sorted(arms))))
   308	        for name, key in (("per_sample.json", "per_sample_sha256"), ("meta.json", "meta_sha256")):
   309	            path = os.path.join(str(run_dir), name)
   310	            if not os.path.isfile(path):
   311	                problems.append("%s: %s is missing; the summary cannot be verified" % (label, path))
   312	                continue
   313	            live = file_sha256(path)
   314	            if live != entry.get(key):
   315	                problems.append("%s: %s hashes to %s, not the %s the summary was built from"
   316	                                % (label, path, live, entry.get(key)))
   317	        meta_path = os.path.join(str(run_dir), "meta.json")
   318	        if os.path.isfile(meta_path):
   319	            meta = read_json(meta_path)
   320	            if meta.get("per_sample_sha256") != entry.get("per_sample_sha256"):
   321	                problems.append("%s: %s no longer binds its per-sample file (meta %r vs "
   322	                                "summary %r)" % (label, run_dir, meta.get("per_sample_sha256"),
   323	                                                 entry.get("per_sample_sha256")))
   324	            for field in ("execution_id", "protocol_id"):
   325	                if meta.get(field) != entry.get(field):
   326	                    problems.append("%s: %s has %s %r, the summary recorded %r"
   327	                                    % (label, run_dir, field, meta.get(field), entry.get(field)))
   328	    return problems
