   331	def check_probe_summary(path, arm, probe_meta, probe_dir=None, require_controls_ok=True):
   332	    """Validate a probe run's own summary: exactly that arm, that execution, controls ok."""
   333	    label = "%s probe summary" % arm
   334	    problems, binding = [], {"path": os.path.abspath(path)}
   335	    if not os.path.isfile(path):
   336	        return None, ["%s: %s is missing" % (label, path)], binding
   337	    try:
   338	        summary = read_json(path)
   339	    except ValueError as exc:
   340	        return None, ["%s: not readable JSON (%s)" % (label, exc)], binding
   341	    binding["sha256"] = file_sha256(path)
   342	    arms = summary.get("arms") or []
   343	    if len(arms) != 1 or arms[0].get("arm") != arm:
   344	        problems.append("%s: the summary covers %r, not exactly the one arm %r"
   345	                        % (label, [a.get("arm") for a in arms], arm))
   346	        return summary, problems, binding
   347	    entry = arms[0]
   348	    binding["execution_id"] = entry.get("execution_id")
   349	    binding["n_queries"] = entry.get("n_queries")
   350	    binding["controls_ok"] = (entry.get("controls") or {}).get("ok")
   351	    if probe_meta and entry.get("execution_id") != probe_meta.get("execution_id"):
   352	        problems.append("%s: the summary's execution %r is not the probe run's %r"
   353	                        % (label, entry.get("execution_id"), probe_meta.get("execution_id")))
   354	    if (entry.get("meta") or {}).get("batches_arg") != "probe":
   355	        problems.append("%s: the summarised run's batches_arg is %r, not 'probe'"
   356	                        % (label, (entry.get("meta") or {}).get("batches_arg")))
   357	    if probe_dir is not None and not same_path(entry.get("run_dir") or "", probe_dir):
   358	        # run_dir is recorded relative to the repository root, so resolve both ways.
   359	        inputs = [i.get("run_dir") for i in summary.get("inputs") or []]
   360	        if not any(same_path(p or "", probe_dir) for p in inputs):
   361	            problems.append("%s: the summary's run %r is not the probe directory %s"
   362	                            % (label, entry.get("run_dir"), os.path.abspath(probe_dir)))
   363	    if require_controls_ok and binding["controls_ok"] is not True:
   364	        problems.append("%s: controls.ok is %r, not true" % (label, binding["controls_ok"]))
   365	    problems.extend(verify_summary_inputs(summary, label=label))
   366	    return summary, problems, binding
