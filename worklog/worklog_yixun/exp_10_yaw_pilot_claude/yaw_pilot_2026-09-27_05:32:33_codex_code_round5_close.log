            L += ["**check_online** (`%s`): ok = %s." % (path, o.get("ok")), ""]
    rel = a.assets_href or (os.path.relpath(a.assets, os.path.dirname(os.path.abspath(a.out)))
                            if a.assets else None)

    def shown(path):
