   210	def bind_report(path, run_dir, meta, kind, require_ok=True, label=None):
   211	    """Validate a per-run validation report (``check_online.json`` / ``parity_exp03.json``).
   212	
   213	    The report must exist, be readable, name *this* run in ``run_dir``, agree with the meta
