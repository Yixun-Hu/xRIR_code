   417	def _live_identity(problems, label, run_dir, expected, what):
   418	    """Read ``run_dir/meta.json`` and require its identity to be ``expected``'s.
   419	
   420	    A report carries a ``run_dir`` and nothing else, so the identity a supplemental is
   421	    checked against is the *live* meta of the run it names — and that meta has to be the one
   422	    the summary recorded for this arm, or the report and the summary are about two runs.
   423	    """
   424	    meta_path = os.path.join(str(run_dir), "meta.json")
   425	    if not os.path.isfile(meta_path):
   426	        problems.append("%s: %s has no meta.json, so %s cannot be bound to a run"
   427	                        % (label, run_dir, what))
   428	        return None
   429	    try:
   430	        meta = read_json(meta_path)
   431	    except ValueError as exc:
   432	        problems.append("%s: %s is not readable JSON (%s)" % (label, meta_path, exc))
   433	        return None
   434	    for field in IDENTITY_FIELDS:
   435	        if expected is not None and meta.get(field) != expected.get(field):
   436	            problems.append("%s: the run it names has %s %r, but the summary recorded %r"
   437	                            % (label, field, meta.get(field), expected.get(field)))
   438	    return meta
