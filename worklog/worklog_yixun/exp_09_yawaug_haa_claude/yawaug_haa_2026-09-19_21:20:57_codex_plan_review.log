ARTIFACT_ALIASES = {'gate_g1': 'gate_g1_sha256'}
SECTIONS = ('code', 'reused', 'artifacts')

# 6.4's matrix. Each producer requires the listed approvals and never its own outputs.
PRODUCER_REQUIREMENTS = {
    'heading': ('code',),
