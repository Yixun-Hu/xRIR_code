OPTIONAL_CODE_KEYS = ('profiles',)

REUSED_DIGESTS = ('exp02_stats_sha256', 'exp02_summary_sha256',
                  'exp04_approved_digests_sha256', 'exp04_evaluator_closure',
                  'exp04_writer_closure', 'exp05_approved_digests_sha256')
