BASE = MP({**COMMON, 'arms': ARMS, 'eval_seeds': (42, 43, 44, 45, 46), 'cohorts': COHORTS,
    'grid': (0,), 'input_selection': 'standalone_k0',
    'run_grids': MP({a['role']: (0,) for a in ARMS}),
