    41	def shell(command):
    42	    """Run one shell with no GPU and normalise the machine-specific paths."""
    43	    result = subprocess.run(command, cwd=str(REPO), capture_output=True, text=True,
    44	                            env=dict(os.environ, CUDA_VISIBLE_DEVICES=''))
    45	    text = (result.stdout.replace(PYTHON, '<PYTHON>')
    46	            .replace(str(Path.home()), '<HOME>').replace(str(REPO), '<REPO>'))
    47	    return result.returncode, text, result.stderr
