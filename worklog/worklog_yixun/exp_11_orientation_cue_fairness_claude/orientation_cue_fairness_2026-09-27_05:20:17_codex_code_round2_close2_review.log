   282	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   283	        abort "$attempt" "$log" 'child_exit_<code>'
   284	        finalize "$attempt" "$log" '<code>' exp11_train
   285	        promote "attempt_$STAMP"
   286	        exit 0
   287	    fi
   288	    mkdir -p -- "$ARM_ROOT"
   289	    mkdir -- "$attempt"   # exclusive: a repeated stamp must not reuse an attempt
   290	    own_launch "$attempt"
   291	    mkdir -p -- "$RECORD"
   292	    : > "$log"
   293	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   294	    run_child "$attempt" "$log" "${child[@]}"
   295	    close_child "$attempt" "$log"
   296	    status="$CHILD_STATUS"
   297	    if [ "$status" -ne 0 ]; then
   298	        abort "$attempt" "$log" "child_exit_$status"
   299	        exit "$status"
   300	    fi
   301	    if ! finalize "$attempt" "$log" "$status" exp11_train; then
   302	        abort "$attempt" "$log" finalize_refused
   303	        exit 2
   304	    fi
   305	    promote "attempt_$STAMP"
   306	    ;;
   307	probe)
   308	    preflight
   309	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   310	    diagnostic probe "$ARM_ROOT/probe_$STAMP" \
   311	        "$RECORD/orientation_cue_fairness_${STAMP}_probe_${ARM}.log" \
   312	        "$ARM_ROOT/probe_$STAMP.json" -- \
   313	        --backbone "$ARM_BACKBONE" --save-dir "$ARM_ROOT/probe_$STAMP" \
   314	        --epochs 1 --max-train-batches 200 --max-test-batches 20 --no-save --run-type probe \
   315	        --batch-size 32 --accum-steps 2 --tf32 --num-workers 12 --decay-epochs 3 \
   316	        --yaw-aug "$ARM_YAW" --save-every 0 --log-interval 50 \
   317	        ${CHILD_EXPLORATORY[@]+"${CHILD_EXPLORATORY[@]}"}
   318	    ;;
   319	smoke)
   320	    preflight
   321	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   322	    # (a) the oriented backbone on a bounded budget, through exp_11's training entry.
   323	    diagnostic probe "$SMOKE_DIR/exp11_train_$STAMP" \
   324	        "$RECORD/orientation_cue_fairness_${STAMP}_smoke_exp11_train.log" \
   325	        "$SMOKE_DIR/receipt_exp11_train_$STAMP.json" \
   326	        --alarm-seconds "$SMOKE_ALARM_S" --max-gb "$SMOKE_MAX_GB" -- \
   327	        --backbone "$ARM_BACKBONE" --save-dir "$SMOKE_DIR/t0" $SMOKE_FLAGS \
   328	        --save-every 0 --yaw-aug "$ARM_YAW" --run-type probe \
   329	        ${CHILD_EXPLORATORY[@]+"${CHILD_EXPLORATORY[@]}"}
   330	    # (b) the CPU fixtures the HAA smokes load; the exp_01 checkpoints cannot load into
   331	    # the five-channel patch embedding, and the adapter needs its own keys.
   332	    run "$PYTHON" tools/exp11_smoke.py --make-fixture "$SMOKE_DIR/fixture_simpor.pth" \
   333	        --fixture-backbone simple_oriented
   334	    run "$PYTHON" tools/exp11_smoke.py --make-fixture "$SMOKE_DIR/fixture_simpadapter.pth" \
   335	        --fixture-backbone simple_adapter
   336	    # (c) the HAA fine-tuning smoke in the heading frame, then (d) the evaluation smoke
   337	    # that loads its best.pth -- gated on (c)'s own completion certifying it passed.
   338	    h1="$SMOKE_DIR/haa_finetune_$STAMP"
   339	    diagnostic haa_train_smoke "$h1" \
   340	        "$RECORD/orientation_cue_fairness_${STAMP}_smoke_haa_finetune.log" \
   341	        "$SMOKE_DIR/receipt_haa_finetune_$STAMP.json" \
   342	        --alarm-seconds "$SMOKE_ALARM_S" --max-gb "$SMOKE_MAX_GB" -- \
   343	        --backbone "$ARM_BACKBONE" --init "$SMOKE_DIR/fixture_simpor.pth" \
   344	        --rooms class_room --heading-json-dir "$HEADING_DIR" --save-dir "$h1/run" \
   345	        --epochs 2 --val-every 1 --batch-size 4 --val-batch-size 4 --seed 0
   346	    require_passed "$h1"
   347	    h2="$SMOKE_DIR/haa_eval_$STAMP"
   348	    diagnostic haa_eval_smoke "$h2" \
   349	        "$RECORD/orientation_cue_fairness_${STAMP}_smoke_haa_eval.log" \
   350	        "$SMOKE_DIR/receipt_haa_eval_$STAMP.json" \
   351	        --alarm-seconds "$SMOKE_ALARM_S" --max-gb "$SMOKE_MAX_GB" -- \
   352	        --backbone "$ARM_BACKBONE" --checkpoint "$h1/run/best.pth" \
   353	        --heading-json-dir "$HEADING_DIR" --rooms hallway --max-samples 4 \
   354	        --save-dir "$h2/run" --seed 0
   355	    # (e)/(f) the ADAPTER route of arms J and K. The oriented rungs above prove nothing
   356	    # about it: a different backbone, the --adapter-heading-json-dir cue instead of the
   357	    # frame, and the contextual loading mode (base weights first, the trained adapter
   358	    # afterwards). Both rungs run here so J/K have a reviewed smoke before their queue.
   359	    a1="$SMOKE_DIR/haa_adapter_finetune_$STAMP"
   360	    diagnostic haa_train_smoke "$a1" \
   361	        "$RECORD/orientation_cue_fairness_${STAMP}_smoke_haa_adapter_finetune.log" \
   362	        "$SMOKE_DIR/receipt_haa_adapter_finetune_$STAMP.json" \
   363	        --alarm-seconds "$SMOKE_ALARM_S" --max-gb "$SMOKE_MAX_GB" -- \
   364	        --backbone simple_adapter --init "$SMOKE_DIR/fixture_simpadapter.pth" \
   365	        --rooms class_room --adapter-heading-json-dir "$HEADING_DIR" \
   366	        --save-dir "$a1/run" --epochs 2 --val-every 1 --batch-size 4 \
   367	        --val-batch-size 4 --seed 0
   368	    require_passed "$a1"
   369	    a2="$SMOKE_DIR/haa_adapter_eval_$STAMP"
   370	    diagnostic haa_eval_smoke "$a2" \
   371	        "$RECORD/orientation_cue_fairness_${STAMP}_smoke_haa_adapter_eval.log" \
   372	        "$SMOKE_DIR/receipt_haa_adapter_eval_$STAMP.json" \
   373	        --alarm-seconds "$SMOKE_ALARM_S" --max-gb "$SMOKE_MAX_GB" -- \
   374	        --backbone simple_adapter --checkpoint "$a1/run/best.pth" \
   375	        --adapter-heading-json-dir "$HEADING_DIR" --rooms hallway --max-samples 4 \
   376	        --save-dir "$a2/run" --seed 0
   377	    ;;
   378	finalize)
   379	    preflight   # recovery is gated by the same reviewed commit, clean tree and pid checks
   380	    check_attempt "$ATTEMPT" || exit 2
   381	    # Everything below uses the canonical directory, never the path as it was typed.
   382	    [ "$DRY" -eq 0 ] || abort "$CANONICAL_ATTEMPT" "$LOG" finalize_refused
   383	    if ! finalize "$CANONICAL_ATTEMPT" "$LOG" "$CHILD_EXIT" exp11_train; then
   384	        abort "$CANONICAL_ATTEMPT" "$LOG" finalize_refused
   385	        exit 2
   386	    fi
   387	    promote "$(basename -- "$CANONICAL_ATTEMPT")"
   388	    ;;
