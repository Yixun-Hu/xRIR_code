   156	def attempt_with(root, arm, profile, tmp_path):
   157	    """One attempt directory under a pretraining root, with the args a profile selects."""
   158	    from tools import exp11_recipe
   159	    spec = exp11_recipe.PROFILES[profile]
   160	    args = dict(spec['recipe'], yaw_aug_seed=0, yaw_aug_width=512)
   161	    args.update(spec['production'])
   162	    args.update(backbone=spec['backbone'], save_dir='x', num_workers=12, log_interval=50,
   163	                save_every=spec['save_every'], epoch_ckpt_every=spec['epoch_ckpt_every'],
   164	                env={}, train_batches_per_epoch=exp11_recipe.TRAIN_BATCHES_PER_EPOCH,
   165	                tier='M', param_counts={}, exp11_run_type='full', exp11_profile=profile,
   166	                exp11_registry_sha256='a' * 64, exp11_source_closure_sha256='b' * 64,
   167	                exp11_git_head='c' * 40, exp11_provenance_path='p')
   168	    directory = tmp_path / root / 'attempt_20260927T000000'
   169	    directory.mkdir(parents=True)
   170	    (directory / 'args.json').write_text(json.dumps(args))
   171	    return directory
