   275	# --- close review blocker 3: promotion follows the canonical attempt ----------------
   276	
   277	
   278	def alias(target, name, tmp_path):
   279	    link = tmp_path / name
   280	    link.parent.mkdir(parents=True, exist_ok=True)
   281	    link.symlink_to(target)
   282	    return link
   283	
   284	
   285	def test_an_existing_final_alias_promotes_the_canonical_attempt(tmp_path):
   286	    """``--attempt <root>/final`` must never promote ``final -> final``.
   287	
   288	    The resolved attempt is what was validated, so it is also what is finalized and
   289	    promoted: the link ends up pointing at the real ``attempt_*`` directory.
   290	    """
   291	    attempt = attempt_with('xRIR_simpor_8_shot', 'H', 'H_RECIPE', tmp_path)
   292	    link = alias(attempt.name, 'xRIR_simpor_8_shot/final', tmp_path)
   293	    status, out, err = recovery(link, 'H', tmp_path)
   294	    assert status == 0, err[-600:]
   295	    assert 'PROMOTE {}/final -> {}'.format(attempt.parent, attempt.name) in out
   296	    assert 'PROMOTE {}/final -> final'.format(attempt.parent) not in out
   297	    assert '--run-dir {} '.format(attempt) in out          # finalization is canonical too
   298	
   299	
   300	def test_an_external_alias_promotes_the_canonical_attempt(tmp_path):
   301	    """An alias outside the arm root may not leave a dangling target under it."""
   302	    attempt = attempt_with('xRIR_simpor_yawaug_8_shot', 'I', 'I_RECIPE', tmp_path)
   303	    link = alias(attempt, 'elsewhere/attempt_alias', tmp_path)
   304	    status, out, err = recovery(link, 'I', tmp_path)
   305	    assert status == 0, err[-600:]
   306	    assert 'PROMOTE {}/final -> {}'.format(attempt.parent, attempt.name) in out
   307	    assert 'attempt_alias' not in out.split('PROMOTE')[-1]
   308	
   309	
   310	def test_an_attempt_that_does_not_resolve_into_the_arm_root_is_refused(tmp_path):
   311	    attempt = attempt_with('xRIR_simpor_8_shot', 'H', 'H_RECIPE', tmp_path)
   312	    outside = tmp_path / 'outside' / 'attempt_x'
   313	    outside.mkdir(parents=True)
   314	    (outside / 'args.json').write_text((attempt / 'args.json').read_text())
   315	    status, out, err = recovery(outside, 'H', tmp_path)
   316	    assert status == 2 and 'PROMOTE' not in out
   317	
   318	
   319	def test_a_resolved_attempt_must_be_named_like_an_attempt(tmp_path):
   320	    """``final -> some_other_directory`` is not a recoverable attempt."""
   321	    attempt = attempt_with('xRIR_simpor_8_shot', 'H', 'H_RECIPE', tmp_path)
   322	    other = attempt.parent / 'not_an_attempt'
   323	    other.mkdir()
   324	    (other / 'args.json').write_text((attempt / 'args.json').read_text())
   325	    status, out, err = recovery(other, 'H', tmp_path)
   326	    assert status == 2, out
   327	    assert 'attempt_' in err and 'PROMOTE' not in out
   328	
