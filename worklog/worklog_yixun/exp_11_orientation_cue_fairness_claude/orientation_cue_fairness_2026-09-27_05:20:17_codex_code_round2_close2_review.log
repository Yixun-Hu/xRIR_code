   218	def test_the_smoke_mode_carries_adapter_training_and_evaluation_commands():
   219	    """J/K must have a reviewed smoke before their queue, not only a fixture.
   220	
   221	    The oriented route's smokes prove nothing about ``simple_adapter``: a different
   222	    backbone, a different cue flag, and the contextual loading mode the round-2 fix
   223	    added. Both adapter rungs are therefore in the bundled smoke, the evaluation one
   224	    gated on the fine-tuning one having passed.
   225	    """
   226	    golden = (GOLD / 'launch_smoke_H.txt').read_text()
   227	    assert '--make-fixture ckpt/exp11/_smoke/fixture_simpadapter.pth' in golden
   228	    assert golden.count('--kind haa_train_smoke') == 2      # oriented, then adapter
   229	    assert golden.count('--kind haa_eval_smoke') == 2
   230	    adapter_train = [line for line in golden.splitlines()
   231	                     if '--kind haa_train_smoke' in line and 'simple_adapter' in line]
   232	    adapter_eval = [line for line in golden.splitlines()
   233	                    if '--kind haa_eval_smoke' in line and 'simple_adapter' in line]
   234	    assert len(adapter_train) == len(adapter_eval) == 1
   235	    assert '--adapter-heading-json-dir ckpt/exp06/heading' in adapter_train[0]
   236	    assert '--init ckpt/exp11/_smoke/fixture_simpadapter.pth' in adapter_train[0]
   237	    assert '--adapter-heading-json-dir ckpt/exp06/heading' in adapter_eval[0]
   238	    assert '--heading-json-dir' not in adapter_train[0].replace(
   239	        '--adapter-heading-json-dir', '')
   240	    # Each rung that hands the next one a checkpoint is gated on its own completion.
   241	    assert golden.count('passed --run-dir') == 2
   242	    assert golden.index('haa_adapter_finetune') < golden.index('haa_adapter_eval')
