   174	def recovery(attempt, arm, tmp_path):
   175	    return launch(['finalize', '--arm', arm, '--gpu', '1', '--reviewed-commit', COMMIT,
   176	                   '--attempt', str(attempt), '--log', 'L.log', '--child-exit', '0',
   177	                   '--dry-run'], {'EXP11_PRETRAIN_ROOT': str(tmp_path),
   178	                                  'EXP11_TEST_ROOTS': '1'})
