   333	def test_the_pretrain_root_override_needs_the_test_context(tmp_path):
   334	    """It must not silently move a real launch's roots or its preflight scan roots."""
   335	    attempt = attempt_with('xRIR_simpor_8_shot', 'H', 'H_RECIPE', tmp_path)
   336	    status, out, err = launch(['finalize', '--arm', 'H', '--gpu', '1', '--reviewed-commit',
   337	                               COMMIT, '--attempt', str(attempt), '--log', 'L.log',
   338	                               '--child-exit', '0', '--dry-run'],
   339	                              {'EXP11_PRETRAIN_ROOT': str(tmp_path)})
   340	    assert status == 2, out
   341	    assert 'EXP11_PRETRAIN_ROOT' in err and 'refusing' in err
   342	    assert 'PROMOTE' not in out
   343	
   344	
   345	def test_the_override_is_honoured_only_alongside_a_dry_run(tmp_path):
   346	    attempt = attempt_with('xRIR_simpor_8_shot', 'H', 'H_RECIPE', tmp_path)
   347	    args = ['finalize', '--arm', 'H', '--gpu', '1', '--reviewed-commit', COMMIT,
   348	            '--attempt', str(attempt), '--log', 'L.log', '--child-exit', '0']
   349	    env = {'EXP11_PRETRAIN_ROOT': str(tmp_path), 'EXP11_TEST_ROOTS': '1'}
   350	    status, out, err = launch(args, env)             # no --dry-run
   351	    assert status == 2 and 'EXP11_PRETRAIN_ROOT' in err
   352	    status, out, err = launch(args + ['--dry-run'], env)
   353	    assert status == 0, err[-600:]
   354	    assert str(tmp_path) in out

