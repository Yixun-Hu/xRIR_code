   313	        "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$ARM" > "$1/launching"
   314	}
   315	
   316	clear_launching() {  # clear_launching <attempt>: only once the child really is recorded
   317	    [ -f "$1/child.pid" ] || return 0
   318	    rm -f -- "$1/launching"
   319	}
