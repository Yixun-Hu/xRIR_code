   278	        [ -d "$attempt" ] || continue
   279	        name="$(basename -- "$attempt")"
   280	        if pid_alive "$attempt/launch.pid"; then
   281	            SCAN_REASON="$name has a live launcher (launch.pid)"; return 1; fi
   282	        if pid_alive "$attempt/child.pid"; then
   283	            SCAN_REASON="$name has a live trainer (child.pid)"; return 1; fi
   284	        if pid_alive "$attempt/train.pid"; then
   285	            SCAN_REASON="$name has a live trainer (train.pid)"; return 1; fi
