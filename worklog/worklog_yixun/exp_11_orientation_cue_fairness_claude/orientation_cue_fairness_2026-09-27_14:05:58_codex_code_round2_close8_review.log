   287	        if [ -f "$attempt/launching" ] && [ ! -f "$attempt/child.pid" ]; then
   288	            SCAN_REASON="$name has an unresolved launch: a launching marker and no"\
   289	" child.pid, so a trainer of it may be running without having registered. Resolve it"\
   290	" with --resolve-unregistered $attempt once nothing of the arm is alive and the marker"\
   291	" is older than ${UNRESOLVED_GRACE_S}s"
