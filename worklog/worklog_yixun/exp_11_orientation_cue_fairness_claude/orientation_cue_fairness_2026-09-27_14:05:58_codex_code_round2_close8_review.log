   272	# scan_arm <arm root> [<attempt being resolved>]: 0 when every attempt of the arm is
   273	# finished and accounted for. SCAN_REASON names the first one that is not.
   274	scan_arm() {
   275	    local root="$1" resolving="${2:-}" attempt="" name=""
