   321	# resolve_unregistered <attempt>: an operator's explicit answer to a marker nothing can
   322	# explain any more. It can only ever abort: an attempt with no child.pid has no exit
   323	# receipt and can never be published.
   324	resolve_unregistered() {
   325	    local attempt="$1" now=0 stamp=0 age=0
   326	    [ -d "$attempt" ] || { echo "refusing: $attempt is not a directory" >&2; return 1; }
   327	    [ -f "$attempt/launching" ] || {
   328	        echo "refusing: $attempt has no launching marker; nothing is unresolved" >&2
   329	        return 1; }
   330	    [ ! -f "$attempt/child.pid" ] || {
   331	        echo "refusing: $attempt recorded a child; it is a finished or running launch," \
   332	             "not an unresolved one" >&2
   333	        return 1; }
   334	    scan_arm "$ARM_ROOT" "$attempt" || {
   335	        echo "refusing: $SCAN_REASON" >&2; return 1; }
   336	    now="$(date -u +%s)"
   337	    stamp="$(date -u -r "$attempt/launching" +%s 2>/dev/null || printf '%s' "$now")"
   338	    age=$((now - stamp))
