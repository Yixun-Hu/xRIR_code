  1140	def detached_lib(script, where, env=None):
  1141	    """``lib``, but with the output on files.
  1142	
  1143	    The sink and the detached child inherit the launcher's stderr, so a captured pipe
  1144	    would only reach EOF once those orphans ended -- which is the very thing under test.
  1145	    """
