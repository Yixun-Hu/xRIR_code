   211	# its argv stays exactly what plan section 9 registers.
   212	CHILD_EXPLORATORY=()
   213	[ "$EXPLORATORY" -eq 0 ] || CHILD_EXPLORATORY=(--exploratory)
   214	
   215	case "$MODE" in
   216	full)
