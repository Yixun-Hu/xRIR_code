  1147	    body = ('set -euo pipefail\n'
  1148	            'EXP11_LAUNCH_LIB=1 source tools/exp11_launch.sh\n' + script)
  1149	    with open(out, 'w') as o, open(err, 'w') as e:
  1150	        status = subprocess.run(['bash', '-c', body], cwd=str(REPO), stdout=o, stderr=e,
  1151	                                env=dict(os.environ, CUDA_VISIBLE_DEVICES='',
  1152	                                         **(env or {}))).returncode
  1153	    return status, out.read_text(), err.read_text()
