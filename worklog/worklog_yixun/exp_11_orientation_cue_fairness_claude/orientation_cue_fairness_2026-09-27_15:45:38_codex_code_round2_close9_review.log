   807	@pytest.mark.parametrize('content', ['', 'SIGNAL TERM\n', '\n', 'not-a-pid\n'])
   808	def test_an_incomplete_child_pid_leaves_the_launch_unresolved(tmp_path, content):
   809	    """The file existing is not the registration; the pid in it is.
   810	
   811	    The shell creates ``child.pid`` by redirection before anything is written into it,
   812	    so a crash in that instant leaves a file with no pid -- no liveness to find, and,
   813	    if its mere existence counted, no marker either. The arm would read as quiet with a
   814	    trainer still running.
   815	    """
   816	    old = attempt_with('xRIR_simpor_8_shot', 'H', 'H_RECIPE', tmp_path)
   817	    stalled = old.parent / 'attempt_20260927T333333'
   818	    stalled.mkdir()
   819	    (stalled / 'launching').write_text('launcher 1\nat 2026-09-27T00:00:00+00:00\n')
   820	    (stalled / 'child.pid').write_text(content)
   821	    status, out, err = recovery(old, 'H', tmp_path)
   822	    assert status == 2, out
   823	    assert 'PROMOTE' not in out
   824	    assert 'unresolved' in err and stalled.name in err
   825	    assert (stalled / 'launching').is_file(), 'the marker must survive'
