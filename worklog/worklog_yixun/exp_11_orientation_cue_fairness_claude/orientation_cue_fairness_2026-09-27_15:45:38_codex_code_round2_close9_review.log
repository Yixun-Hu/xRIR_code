   181	        --reviewed-commit) COMMIT="${2:-}"; shift 2 ;;
   182	        --attempt-root) ATTEMPT_ROOT="${2:-}"; shift 2 ;;
   183	        --attempt) ATTEMPT="${2:-}"; shift 2 ;;
   184	        --log) LOG="${2:-}"; shift 2 ;;
   185	        --child-exit) CHILD_EXIT="${2:-}"; shift 2 ;;
   186	        --approved) APPROVED="${2:-}"; shift 2 ;;
