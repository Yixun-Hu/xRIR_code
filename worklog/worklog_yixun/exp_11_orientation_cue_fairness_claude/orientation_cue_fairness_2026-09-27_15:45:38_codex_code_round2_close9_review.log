   248	              "/proc/$HOLDER_PID/stat" 2>/dev/null || true)"
   249	    [ "$parent" = "$$" ] && { kill -TERM "$HOLDER_PID" 2>/dev/null || true; }
   250	    wait "$HOLDER_PID" 2>/dev/null || true
   251	    HOLDER_PID=""
   252	}
   253	
   254	# --- what the lock protects is a quiet arm -------------------------------------------
   255	# The lock says "one publication at a time"; it does not say "no trainer is running".
   256	# That is this scan's job, and it has to run UNDER the lock: a scan taken before
   257	# acquisition can go stale in the window between, which is exactly how a recovery could
   258	# promote an older attempt while a newer trainer of the same arm kept writing
   259	# (close review 7, blocker 1). `kill -0` asks the kernel whether a pid still exists; it
   260	# is a probe and sends no signal.
   261	UNRESOLVED_GRACE_S="${EXP11_UNRESOLVED_GRACE_S:-120}"
   262	SCAN_REASON=""
   263	
   264	pid_alive() {  # pid_alive <file>: the first field of <file> names a living process
   265	    local pid=""
   266	    [ -f "$1" ] || return 1
   267	    read -r pid _ < "$1" 2>/dev/null || return 1
   268	    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
   269	    kill -0 "$pid" 2>/dev/null
   270	}
   271	
   272	# registration_complete <attempt>: child.pid exists AND its whole content is a pid.
   273	# The shell creates that file by redirection before the pid reaches it, so existence
   274	# alone proves nothing; what makes a launch *registered* is a number to look for. Whether
   275	# that number is still alive is a separate question, asked by pid_alive.
   276	registration_complete() {
   277	    local text=""
   278	    [ -f "$1/child.pid" ] || return 1
   279	    text="$(tr -d '\n' < "$1/child.pid" 2>/dev/null || true)"
   280	    case "$text" in ''|*[!0-9]*) return 1 ;; esac
   281	    return 0
   282	}
   283	
   284	# scan_arm <arm root> [<attempt being resolved>]: 0 when every attempt of the arm is
   285	# finished and accounted for. SCAN_REASON names the first one that is not.
   286	scan_arm() {
   287	    local root="$1" resolving="${2:-}" attempt="" name="" here=""
   288	    SCAN_REASON=""
   289	    # The attempt being resolved is excluded by canonical identity, never by spelling:
   290	    # the caller's path and this glob's may name the same directory differently.
   291	    [ -z "$resolving" ] || resolving="$(realpath -- "$resolving" 2>/dev/null || printf '%s' "$resolving")"
   292	    for attempt in "$root"/attempt_*; do
   293	        [ -d "$attempt" ] || continue
   294	        name="$(basename -- "$attempt")"
   295	        here="$(realpath -- "$attempt" 2>/dev/null || printf '%s' "$attempt")"
   296	        if pid_alive "$attempt/launch.pid"; then
   297	            SCAN_REASON="$name has a live launcher (launch.pid)"; return 1; fi
   298	        if pid_alive "$attempt/child.pid"; then
   299	            SCAN_REASON="$name has a live trainer (child.pid)"; return 1; fi
   300	        if pid_alive "$attempt/train.pid"; then
   301	            SCAN_REASON="$name has a live trainer (train.pid)"; return 1; fi
   302	        [ "$here" != "$resolving" ] || continue
   303	        if [ -f "$attempt/launching" ] && ! registration_complete "$attempt"; then
   304	            SCAN_REASON="$name has an unresolved launch: a launching marker and no"\
   305	" complete child.pid, so a trainer of it may be running without having registered."\
   306	" Resolve it"\
   307	" with --resolve-unregistered $attempt once nothing of the arm is alive and the marker"\
   308	" is older than ${UNRESOLVED_GRACE_S}s"
   309	            return 1; fi
   310	    done
   311	    return 0
   312	}
   313	
   314	require_quiet_arm() {  # require_quiet_arm [<attempt being resolved>]
   315	    say "SCAN $ARM_ROOT"
   316	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   317	    scan_arm "$ARM_ROOT" "${1:-}" && return 0
   318	    echo "refusing: $SCAN_REASON" >&2
   319	    return 1
   320	}
   321	
   322	# --- the intent marker: the half-second the frozen lifecycle cannot cover -----------
   323	# `run_child` forks the detached trainer and writes child.pid only afterwards, and the
   324	# trainer needs a moment to write its own. A launcher that dies inside that window would
   325	# leave a running trainer nothing names. So the intent to launch is declared BEFORE the
   326	# fork and withdrawn once child.pid exists; a marker left behind means "a trainer of this
   327	# attempt may be running", and the arm stays closed until an operator resolves it.
   328	mark_launching() {  # mark_launching <attempt>
   329	    printf 'launcher %s\nat %s\narm %s\n' \
   330	        "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$ARM" > "$1/launching"
   331	}
   332	
   333	clear_launching() {  # clear_launching <attempt>: only once the child really is recorded
   334	    registration_complete "$1" || return 0
   335	    rm -f -- "$1/launching"
   336	}
   337	
   338	# resolve_unregistered <attempt>: an operator's explicit answer to a marker nothing can
   339	# explain any more. It can only ever abort: an attempt with no child.pid has no exit
   340	# receipt and can never be published.
   341	resolve_unregistered() {
   342	    local attempt="" root="" name="" now=0 stamp=0 age=0
   343	    # Identity is the canonical directory, never the spelling: an operator's path may be
   344	    # absolute where the root is relative, or reach the arm through a symlink.
   345	    [ -d "$1" ] || { echo "refusing: $1 is not a directory" >&2; return 1; }
   346	    attempt="$(realpath -- "$1")" || return 1
   347	    root="$(realpath -- "$ARM_ROOT")" || return 1
   348	    name="$(basename -- "$attempt")"
   349	    # The lock and the scan are this arm's, so the resolution reaches no further.
   350	    if [ "$(dirname -- "$attempt")" != "$root" ]; then
   351	        echo "refusing: $attempt is not an attempt of the selected arm ($root); this" \
   352	             "invocation locked and scanned that arm and no other" >&2
   353	        return 1
   354	    fi
   355	    case "$name" in
   356	        attempt_*) case "${name#attempt_}" in ''|*[!0-9T]*)
   357	            echo "refusing: $name is not an attempt directory of this arm" >&2
   358	            return 1 ;; esac ;;
   359	        *) echo "refusing: $name is not an attempt directory of this arm" >&2
   360	           return 1 ;;
   361	    esac
   362	    [ -f "$attempt/launching" ] || {
   363	        echo "refusing: $attempt has no launching marker; nothing is unresolved" >&2
   364	        return 1; }
   365	    if registration_complete "$attempt"; then
   366	        echo "refusing: $attempt recorded a child; it is a finished or running launch," \
   367	             "not an unresolved one" >&2
   368	        return 1
   369	    fi
   370	    scan_arm "$ARM_ROOT" "$attempt" || {
   371	        echo "refusing: $SCAN_REASON" >&2; return 1; }
   372	    now="$(date -u +%s)"
   373	    stamp="$(date -u -r "$attempt/launching" +%s 2>/dev/null || printf '%s' "$now")"
   374	    age=$((now - stamp))
   375	    if [ "$age" -lt "$UNRESOLVED_GRACE_S" ]; then
   376	        echo "refusing: $attempt/launching is ${age}s old and a trainer that has not" \
   377	             "registered yet is still possible; wait until it is ${UNRESOLVED_GRACE_S}s" >&2
   378	        return 1
   379	    fi
   380	    say "TOMBSTONE $root/$name.resolved"
   381	    say "ABORT $attempt -> ${attempt}_ABORTED_unregistered"
   382	    if [ "$DRY" -eq 0 ]; then
   383	        # Written BEFORE the rename, and never removed by anything here: a trainer that
   384	        # wakes after this can no longer find its directory, and if it somehow can, this
   385	        # is what tells it the launch was answered. The scan ignores it -- it is a
   386	        # record, not a claim (close review 8, blocker 2).
   387	        printf 'resolved-by %s\nat %s\nreason unregistered launch: no complete child.pid\n' \
   388	            "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" > "$root/$name.resolved"
   389	        mv -- "$attempt" "${attempt}_ABORTED_unregistered"
   390	        # The marker has been answered; leaving it would close the arm for good, since
   391	        # the scan reads every attempt_* directory, retired ones included.
   392	        rm -f -- "${attempt}_ABORTED_unregistered/launching"
   393	    fi
   394	    say "RESOLVED $attempt registered no child and nothing of it is alive;" \
   395	        "it can never be published"
   396	}
   397	
   398	# A deterministic pause, so a regression can hold this invocation open between two
   399	# launchers. It exists only inside the test roots and costs a real launch nothing.
   400	scan_barrier() {
   401	    local file="${EXP11_SCAN_BARRIER:-}"
   402	    [ -n "$file" ] && [ "${EXP11_TEST_ROOTS:-0}" = 1 ] || return 0
   403	    : > "$file.at"
   404	    while [ -e "$file" ]; do sleep 0.05; done
   405	}
   406	
   407	# A signal handler must END this invocation. A cleanup-only handler returns, and bash
   408	# resumes -- which would let finalization and promotion continue after the interruption.
   409	# The lock needs no releasing here: the EXIT trap ends the holder, and if anything went
   410	# wrong with that the lease ends it within a second anyway.
   411	on_signal() {  # on_signal <NAME> <number>
   412	    INTERRUPTED=1
   413	    say "SIGNAL $1"
   414	    exit $((128 + $2))
   415	}
   416	
   417	# Checked before every protected step, so nothing runs after a handler has fired even if
   418	# some future caller swallows the exit.
   419	not_interrupted() {
   420	    [ "$INTERRUPTED" -eq 0 ] && return 0
   421	    echo "refusing: a signal handler has fired; this invocation does not continue" >&2
   422	    return 1
   423	}
   424	
   425	# published_target: what `final` resolves to under this arm root, or nothing.
   426	published_target() {
   427	    [ -L "$ARM_ROOT/final" ] || return 1
   428	    readlink -f -- "$ARM_ROOT/final"
   429	}
   430	
   431	# already_published <canonical>: this attempt is the published one and it completed.
   432	already_published() {
   433	    local target
   434	    target="$(published_target)" || return 1
   435	    [ "$target" = "$1" ] && [ -f "$1/completion.json" ]
   436	}
   437	
   438	# check_final_conflict <canonical>: a DIFFERENT existing `final` is never replaced by a
   439	# recovery unless the operator asks for it, and the replaced target is logged first.
   440	check_final_conflict() {
   441	    local target
   442	    target="$(published_target)" || return 0
   443	    [ "$target" != "$1" ] || return 0
   444	    if [ "$REPLACE_FINAL" -eq 0 ]; then
   445	        echo "refusing: $ARM_ROOT/final already publishes $target, not $1; pass" \
   446	             "--replace-final to replace it" >&2
   447	        return 1
   448	    fi
   449	    say "REPLACING $ARM_ROOT/final -> $(basename -- "$target") with $(basename -- "$1")"
   450	}
   451	
   452	# abort_recovery <canonical> <log>: the abort path of a REFUSED recovery. A malformed
   453	# invocation does not establish that a finished run failed, so an attempt that is
   454	# already published or already completed is left exactly as it is -- directory,
   455	# completion and `final` untouched -- and the finalizer's own cause stands on stderr.

exec
/bin/bash -lc "nl -ba tools/exp11_launch.sh | sed -n '455,900p'; rg -n 'run_child|close_child|lifecycle|trap|launch.pid' tools/exp06_launch.sh; nl -ba tests/test_exp11_shell.py | sed -n '1,170p'; nl -ba tests/test_exp11_shell.py | sed -n '780,1330p'" in /home/yixunhu/codespace/xRIR_code_wt
