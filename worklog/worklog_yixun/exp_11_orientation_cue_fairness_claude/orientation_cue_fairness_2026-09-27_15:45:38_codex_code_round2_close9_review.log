    90	# diagnostic <run-type> <run dir> <log> <receipt> <smoke argv...>: a smoke or probe runs
    91	# through the same lifecycle as the confirmatory child -- pid file, drained pipe, end
    92	# marker, child_exit.json -- and is finalized as a never-admissible diagnostic. Review
    93	# finding 5: a failed child or a refused finalisation renames the run and its log
    94	# _ABORTED_<reason> and exits with the child's status, so smoke stops at the first failed
    95	# rung; the completion recording `passed: false` is written first and moves with the run.
    96	diagnostic() {
    97	    local kind="$1" dir="$2" log="$3" receipt="$4"
    98	    shift 4
    99	    local flags=(--receipt "$receipt" --run-type "$kind" --provenance-out "$dir/provenance.json"
   100	                 --approved "$APPROVED" --reviewed-commit "$COMMIT")
   101	    [ "${EXPLORATORY:-0}" -eq 0 ] || flags+=(--exploratory)
   102	    local cmd=("$PYTHON" tools/exp06_smoke.py "${flags[@]}" "$@")
   103	    say "MKDIR $dir"
   104	    say "SINK cat >> $log"
   105	    say "PIDFILE $dir/launch.pid"
   106	    say "RUN nohup setsid ${cmd[*]}"
   107	    if [ "$DRY" -eq 1 ]; then
   108	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   109	        finalize "$dir" "$log" '<code>' "$kind" "$receipt"
   110	        return 0
   111	    fi
   112	    mkdir -p -- "$(dirname -- "$dir")" "$RECORD"
   113	    mkdir -- "$dir"  # exclusive: a repeated stamp must not reuse a diagnostic run
   114	    own_launch "$dir"
   115	    : > "$log"
   116	    run_child "$dir" "$log" "${cmd[@]}"
   117	    close_child "$dir" "$log"
   118	    if ! finalize "$dir" "$log" "$CHILD_STATUS" "$kind" "$receipt"; then
   119	        abort "$dir" "$log" finalize_refused
   120	        exit 2
   121	    fi
   122	    if [ "$CHILD_STATUS" -ne 0 ]; then
   123	        abort "$dir" "$log" "child_failed_$CHILD_STATUS"
   124	        exit "$CHILD_STATUS"
   125	    fi
   126	}
