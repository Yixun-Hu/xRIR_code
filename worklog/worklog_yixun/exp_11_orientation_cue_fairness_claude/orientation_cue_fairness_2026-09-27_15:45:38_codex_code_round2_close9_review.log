  1099	def lifecycle(root, launch_child):
  1100	    """Replay the frozen ``run_child`` prologue and then take the registered TERM body.
  1101	
  1102	    ``run_child`` waits for its child, so no launcher can be made to exit in the middle
  1103	    of it without sending a real signal. The two lines that matter are asserted to be
  1104	    exactly the library's, so this replay cannot drift from what production does.
  1105	    """
