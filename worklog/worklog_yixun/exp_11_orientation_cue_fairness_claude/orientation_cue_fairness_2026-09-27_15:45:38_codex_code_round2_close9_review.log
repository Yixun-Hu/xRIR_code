   165	# Defaults, so the sourced library (EXP06_LAUNCH_LIB=1) is complete under `set -u`; the
   166	# argument parser below overwrites them for a real launch.
   167	APPROVED="${APPROVED:-$APPROVED_DEFAULT}"
