  1107	    assert SINK_LINE in library and CHILD_LINE in library, (
  1108	        'the frozen lifecycle changed; this replay no longer reproduces it')
  1109	    child = ('nohup setsid sleep 8 > "$pipe" 2>&1 &\nchild=$!\n'
  1110	             'printf %s\\n "$child" > "$attempt/child.pid"\n') if launch_child else ''
  1111	    return ('ARM_ROOT={root}\nDRY=0\nARM=H\n'
  1112	            'hold_arm_lock finalize || exit 2\n'
  1113	            'attempt={root}/attempt_20260927T000000\nmkdir -p -- "$attempt"\n'
  1114	            'log="$attempt/child.log"\n: > "$log"\n'
  1115	            'pipe="$attempt/child.pipe"\nmkfifo -m 600 -- "$pipe"\n'
  1116	            'cat >> "$log" < "$pipe" &\nsink=$!\n'
  1117	            'sleep 0.3\n' + child +
  1118	            'handler="$(trap -p TERM | sed -n "s/^trap -- \'\\(.*\\)\' SIGTERM$/\\1/p")"\n'
  1119	            '[ -n "$handler" ] || {{ echo NO_TERM_TRAP; exit 9; }}\n'
