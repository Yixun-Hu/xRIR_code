   468	# diagnostic <kind> <run dir> <log> <receipt> <entry argv...>: one enumerated diagnostic
   469	# kind through the same lifecycle as a confirmatory child, finalized as exp11_smoke and
   470	# never admissible as an arm.
   471	diagnostic() {
