   128	# run_child <attempt> <log> <command...>: every byte the child or any descendant writes
   129	# goes through one pipe whose sink appends to the log. Waiting for the sink waits for EOF,
   130	# which arrives only after every process holding the write end has exited -- so nothing can
   131	# append after the end marker. Sets CHILD_PID and CHILD_STATUS.
   132	run_child() {
   133	    local attempt="$1" log="$2" pipe sink pid status=0 sink_status=0
   134	    shift 2
   135	    pipe="$attempt/child.pipe"
   136	    rm -f -- "$pipe"
   137	    mkfifo -m 600 -- "$pipe"
   138	    cat >> "$log" < "$pipe" &
   139	    sink=$!
   140	    CHILD_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%S+00:00)"
   141	    nohup setsid "$@" > "$pipe" 2>&1 &
   142	    pid=$!
   143	    printf '%s\n' "$pid" > "$attempt/child.pid"
   144	    wait "$pid" || status=$?
   145	    wait "$sink" || sink_status=$?  # EOF: the child and every descendant closed the write end
   146	    rm -f -- "$pipe"
   147	    CHILD_PID="$pid"
   148	    CHILD_STATUS="$status"
   149	    # Blocker 4: a sink that died on a write error left an incomplete log. Nothing may be
   150	    # published from it -- no end marker, no receipt, no completion.
   151	    if [ "$sink_status" -ne 0 ]; then
   152	        say "SINK_FAILED status=$sink_status log=$log"
   153	        abort "$attempt" "$log" sink_failed
   154	        exit 3
   155	    fi
   156	}
   157	
   158	# close_child <attempt> <log>: append the end marker and bind exactly those bytes.
   159	close_child() {
   160	    say "MARKER EXP06_CHILD_EXIT $CHILD_STATUS <iso> >> $2"
   161	    "$PYTHON" tools/exp06_finalize.py child-exit --run-dir "$1" --log "$2" \
   162	        --child-pid "$CHILD_PID" --status "$CHILD_STATUS" --started-at "$CHILD_STARTED_AT"
   163	}
