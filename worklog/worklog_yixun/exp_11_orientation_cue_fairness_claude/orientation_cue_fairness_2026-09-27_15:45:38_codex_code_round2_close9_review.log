    63	# require_passed <run dir> <run type>: plan amendment A4. The evaluation smoke loads the
    64	# fine-tuning smoke's best.pth, so it starts only after that diagnostic's own completion
    65	# certifies it passed. A refused finalisation already stops the rung; this is the explicit
    66	# gate the plan registers between the two.
    67	require_passed() {
    68	    if ! run "$PYTHON" tools/exp06_finalize.py passed --run-dir "$1" --run-type "$2"; then
    69	        say "STOP $1 did not pass; the rung that consumes its checkpoint is not started"
    70	        exit 2
