   455	# completion and `final` untouched -- and the finalizer's own cause stands on stderr.
   456	# Full mode keeps aborting unconditionally: it launched the attempt it is aborting.
   457	abort_recovery() {
   458	    local canonical="$1" log="$2" why=""
   459	    [ -f "$canonical/completion.json" ] && why="it has completed"
