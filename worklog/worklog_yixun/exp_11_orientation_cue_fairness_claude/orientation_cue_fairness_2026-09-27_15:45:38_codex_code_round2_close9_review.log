    49	# own_launch <dir>: this launcher owns the run dir and stays alive through draining and
    50	# finalisation, so launch.pid names it -- never the child, which gets child.pid.
    51	own_launch() {
    52	    printf '%s\n' "$$" > "$1/launch.pid"
    53	}
    54	
    55	finalize() {  # finalize <attempt> <log> <child-exit> <run-type> [receipt]
    56	    local extra=()
    57	    [ -z "${OWNER:-}" ] || extra+=(--owner-pid "$OWNER")
    58	    [ $# -lt 5 ] || extra+=(--receipt "$5")
    59	    run "$PYTHON" tools/exp06_finalize.py --run-dir "$1" --run-type "$4" --log "$2" \
    60	        --child-exit "$3" ${extra[@]+"${extra[@]}"}
    61	}
