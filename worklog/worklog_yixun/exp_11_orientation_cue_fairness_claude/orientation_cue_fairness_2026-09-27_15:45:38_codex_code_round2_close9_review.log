  1123	def free(lockfile, seconds=5.0):
  1124	    """True once an independent process can take the lock, within ``seconds``."""
  1125	    deadline = time.time() + seconds
  1126	    while True:
  1127	        if subprocess.run(['flock', '-n', str(lockfile), 'true']).returncode == 0:
  1128	            return True
  1129	        if time.time() >= deadline:
  1130	            return False
  1131	        time.sleep(0.05)
