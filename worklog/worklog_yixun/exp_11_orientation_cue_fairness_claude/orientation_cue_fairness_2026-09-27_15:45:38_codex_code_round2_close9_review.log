  1134	def drain(pipe):
  1135	    """Let an orphaned sink see EOF: open the FIFO for writing and close it."""
  1136	    if pipe.exists():
  1137	        os.close(os.open(str(pipe), os.O_WRONLY | os.O_NONBLOCK))
