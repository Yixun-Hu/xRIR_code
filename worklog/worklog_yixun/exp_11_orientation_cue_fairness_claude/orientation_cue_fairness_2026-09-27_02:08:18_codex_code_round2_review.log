   931	def check_receipt_consistency(fields, record, window):
   932	    """Finding 4: field presence and two zero statuses do not make a diagnostic passed.
   933	
   934	    Every receipt the runner writes is internally consistent, so each disagreement here is
   935	    a forged or corrupted receipt: an entry outside the supported set or disagreeing with
   936	    the startup command, a non-string argv, a budget that bounds nothing, an outcome that
   937	    contradicts its own status or resource evidence, or a window outside the one the
   938	    launcher recorded for the child. Returns whether the diagnostic actually passed.
   939	
   940	    ``tools/exp06_smoke.py`` converts an over-budget run to ``aborted_memory`` or
   941	    ``aborted_alarm`` before it publishes, so a real ``ok`` receipt never exceeds either
   942	    ceiling. The child's ``ended_at`` is truncated to the second by the launcher's marker,
   943	    which is the one second of slack allowed at the end of the window.
   944	    """
   945	    entry, argv = fields['entry'], fields['argv']
   946	    _require(entry in SMOKE_ENTRIES, 'the smoke receipt records entry {!r}, not one of {}'
   947	             .format(entry, sorted(SMOKE_ENTRIES)))
   948	    _require(isinstance(argv, list) and all(isinstance(token, str) for token in argv),
   949	             'the smoke receipt argv {!r} is not a list of strings'.format(argv))
   950	    _require(record.get('entry') == entry, 'the smoke receipt ran the entry {!r}; its '
   951	             'provenance records {!r}'.format(entry, record.get('entry')))
   952	    _require(record.get('command') == [entry] + argv, 'the smoke receipt argv is not the '
   953	             'child command {!r} its provenance recorded'.format(record.get('command')))
   954	    alarm = _positive('the smoke receipt alarm_seconds', fields['alarm_seconds'])
   955	    ceiling = _positive('the smoke receipt max_gb', fields['max_gb']) * GIB
   956	    status, outcome, peak = fields['exit_status'], fields['outcome'], fields['peak_bytes']
   957	    if outcome == 'ok':
   958	        _require(status == 0, 'the smoke receipt records outcome ok with exit_status '
   959	                 '{}'.format(status))
   960	        _require(peak <= ceiling, 'the smoke receipt records outcome ok with a peak of {} '
   961	                 'bytes over its {} GiB budget'.format(peak, fields['max_gb']))
   962	        _require(fields['wall_s'] <= alarm, 'the smoke receipt records outcome ok after {} s '
   963	                 'over its {} s budget'.format(fields['wall_s'], alarm))
   964	    else:
   965	        _require(status != 0, 'the smoke receipt records outcome {!r} with exit_status 0'
   966	                 .format(outcome))
   967	    started = _timestamp(fields['started_at'], 'started_at')
   968	    ended = _timestamp(fields['ended_at'], 'ended_at')
   969	    _require(_timestamp(window['started_at'], 'started_at') <= started,
   970	             'the smoke receipt started at {}, before the child the launcher spawned at '
   971	             '{}'.format(fields['started_at'], window['started_at']))
   972	    _require(ended <= _timestamp(window['ended_at'], 'ended_at')
   973	             + datetime.timedelta(seconds=1),
   974	             'the smoke receipt ended at {}, after the child exited at {}'.format(
   975	                 fields['ended_at'], window['ended_at']))
   976	    return status == 0 and outcome == 'ok'
