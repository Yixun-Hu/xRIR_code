    43	OUTCOMES = bounded.OUTCOMES
    44	# Every exp_11 diagnostic is one of these; each names its entry, its budgets and what it
    45	# must leave behind. They are never admissible arms.
    46	KINDS = {
    47	    'probe': {'entry': 'tools.exp11_train', 'run_type': 'exp11_probe',
    48	              'alarm_seconds': 900.0, 'max_gb': 40.0,
    49	              'artifacts': ('provenance.json',)},
    50	    'haa_train_smoke': {'entry': 'tools.exp11_haa_finetune',
    51	                        'run_type': 'exp11_haa_smoke_train',
