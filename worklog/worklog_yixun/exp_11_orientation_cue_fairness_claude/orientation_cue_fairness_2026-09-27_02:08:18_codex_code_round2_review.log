    83	    datasets = {room: records.legacy.build_dataset([room], args.split, args, root, k_by_room,
    84	                                                   args.eval_seed) for room in args.rooms}
    85	    model = build_xrir_exp11(args.backbone, args.num_shot)
    86	    if adapter_phi is not None:
