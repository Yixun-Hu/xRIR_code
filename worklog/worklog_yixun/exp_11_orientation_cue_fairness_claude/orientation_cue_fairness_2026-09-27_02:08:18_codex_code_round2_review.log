   979	def diagnostic_evidence(run_dir, receipt, child_exit, run_type, repo, window):
   980	    """A smoke or probe proves nothing about an arm, but must prove what it cost.
   981	
   982	    Finding 6: the receipt carries the runner's identity, budgets, timing and peak
   983	    allocation, and the run records a ``provenance.json`` bound the way a full run's is,
   984	    minus the training artefacts. ``passed`` then reports whether the diagnostic actually
   985	    succeeded; a failed one is still recorded and is simply never ``admissible_arm``.
   986	    """
   987	    record = load_provenance(run_dir, run_type, required=DIAGNOSTIC_PROVENANCE, identity=False)
   988	    verify_source_closure(record, run_type, repo)
   989	    admission = verify_approvals(record, repo, run_type)
   990	    fields, path = diagnostic_receipt(receipt, run_type, record)
   991	    status = fields['exit_status']
   992	    passed = check_receipt_consistency(fields, record, window) and child_exit == 0
   993	    hashes = {}
   994	    if run_type in HAA_SMOKE:
   995	        # A4: the next rung consumes this one's checkpoint, so a finalised HAA diagnostic
   996	        # must have succeeded; a failed one leaves its receipt and log, and no completion.
   997	        _require(passed, 'a finalised HAA diagnostic must have succeeded: the receipt records '
   998	                 'outcome {!r} with exit_status {}, and the child exited {}'.format(
   999	                     fields['outcome'], status, child_exit))
  1000	        hashes = haa_smoke_artifacts(run_dir, run_type, repo)
  1001	    return dict(artifacts=hashes, passed=passed, **admission,
  1002	                receipt={'path': str(path.resolve()), 'sha256': provenance.sha256_file(path),
  1003	                         'runner': fields['runner'], 'entry': fields['entry'],
  1004	                         'exit_status': status, 'outcome': fields['outcome'],
  1005	                         'wall_s': fields['wall_s'], 'peak_bytes': fields['peak_bytes'],
  1006	                         'alarm_seconds': fields['alarm_seconds'], 'max_gb': fields['max_gb']})
