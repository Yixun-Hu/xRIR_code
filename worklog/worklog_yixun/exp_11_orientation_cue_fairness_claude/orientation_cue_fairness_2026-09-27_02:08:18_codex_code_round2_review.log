    92	                                 adapter_heading=adapter_heading, adapter_phi_deg=adapter_phi,
    93	                                 haa_root=root, checkpoint_sha256=checkpoint_sha256,
    94	                                 **records.legacy.job_binding(args.job_spec))
    95	    return types.SimpleNamespace(root=root, frame=frame, heading=heading,
    96	                                 adapter_heading=adapter_heading, adapter_phi_deg=adapter_phi,
    97	                                 datasets=datasets, model=model, fields=fields,
