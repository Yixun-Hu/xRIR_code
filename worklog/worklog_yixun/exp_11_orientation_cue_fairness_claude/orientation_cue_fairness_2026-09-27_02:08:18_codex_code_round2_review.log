   762	def full_evidence(run_dir, repo):
   763	    """Verify the twelve-epoch pretraining contract of plan section 5."""
   764	    run_dir = Path(run_dir)
   765	    hashes = artifacts(run_dir, FULL_ARTIFACTS)  # every file must exist before it is parsed
   766	    record = load_provenance(run_dir, 'full')
   767	    _, closure = verify_source_closure(record, 'full', repo)
   768	    admission = verify_approvals(record, repo, 'full')
   769	    verify_train_identity(record)
   770	    admission.update(verify_geometry_identity(record))
   771	    admission.update(verify_heldout_identity(record))
   772	    revalidate_inputs(record, repo)
   773	    args = _read_json(run_dir / 'args.json', 'args.json')
   774	    rows = _history_rows(run_dir / 'history.jsonl', 'history.jsonl')
   775	    last = _load_torch(run_dir / 'last.pth', 'last.pth')
   776	    meta = {key: last[key] for key in ('epoch', 'batch_idx') if key in last}
   777	    check_argument_sources(record, args, last, rows, meta)
   778	    check_exp06_bindings(record, args, closure, run_dir, 'full', repo)
   779	    _require('model' in last, 'last.pth records no "model" state dict')
   780	    state = _state_dict(_load_torch(run_dir / EPOCH_CHECKPOINT, EPOCH_CHECKPOINT), EPOCH_CHECKPOINT)
   781	    model = _state_dict(last['model'], 'last.pth["model"]')
   782	    _require(set(state) == set(model), EPOCH_CHECKPOINT + ' has a different parameter set than last.pth')
   783	    # Nit 8: torch.equal compares values across dtypes, so a float64 copy of a float32
   784	    # checkpoint would pass. Identity requires the same dtype and shape as well.
   785	    for key in sorted(state):
   786	        _require(state[key].dtype == model[key].dtype,
   787	                 '{} has dtype {} at {}, not the {} of last.pth["model"]'.format(
   788	                     EPOCH_CHECKPOINT, state[key].dtype, key, model[key].dtype))
   789	        _require(tuple(state[key].shape) == tuple(model[key].shape),
   790	                 '{} has shape {} at {}, not the {} of last.pth["model"]'.format(
   791	                     EPOCH_CHECKPOINT, tuple(state[key].shape), key, tuple(model[key].shape)))
   792	    _require(all(torch.equal(state[key], model[key]) for key in state),
   793	             EPOCH_CHECKPOINT + ' differs tensor-wise from last.pth["model"]')
   794	    return dict(artifacts=hashes, epochs=len(rows), **admission,
   795	                backbone=args['backbone'], source_closure_sha256=closure['sha256'],
   796	                registry_sha256=record.get('registry_sha256'),
   797	                git_head=record.get('git_state', {}).get('HEAD'),
   798	                checkpoint={'path': EPOCH_CHECKPOINT, 'sha256': hashes[EPOCH_CHECKPOINT],
   799	                            'epoch': exp06_recipe.EXP01_RECIPE['epochs']})
