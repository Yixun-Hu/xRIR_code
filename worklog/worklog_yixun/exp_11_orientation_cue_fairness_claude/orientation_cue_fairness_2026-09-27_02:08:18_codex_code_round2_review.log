   913	                         'runner': fields['runner'], 'entry': fields['entry'],
   914	                         'kind': fields['kind'], 'exit_status': fields['exit_status'],
   915	                         'outcome': fields['outcome'], 'wall_s': fields['wall_s'],
   916	                         'peak_bytes': fields['peak_bytes'],
   917	                         'alarm_seconds': fields['alarm_seconds'],
   918	                         'max_gb': fields['max_gb']})
