   921	def finalize(run_dir, run_type, log, child_exit, repo=REPO, receipt=None, children=(),
   922	             expect=None, owner_pid=None, job_spec=None):
   923	    """Verify one child's evidence for its exp_11 run type and write completion.json."""
   924	    run_dir = Path(run_dir)
   925	    _require(run_type in RUN_TYPES, 'unknown run type: {!r}'.format(run_type))
   926	    _require(run_dir.is_dir(), 'run directory does not exist: {}'.format(run_dir))
   927	    _require(type(child_exit) is int, 'child status must be an integer')
   928	    if run_type == 'exp11_haa_job':   # A3: a job orchestrates children and is none itself
   929	        return haa_job_completion(run_dir, children, expect, repo, job_spec, log, child_exit,
   930	                                  owner_pid)
   931	    base.refuse_live_launch(run_dir, owner_pid)
   932	    log_record, child_exit_time, log_digest = base.closed_log(log, child_exit)
   933	    receipt_record = base.child_exit_receipt(run_dir, child_exit, log_digest, child_exit_time)
   934	    diagnostic = run_type in DIAGNOSTIC
   935	    if not diagnostic:
   936	        _require(child_exit == 0, 'child exited with status {}'.format(child_exit))
   937	    fields = dict(schema_version=1, run_type=run_type, run_dir=str(run_dir.resolve()),
   938	                  repo=str(Path(repo).resolve()), child_exit=child_exit,
   939	                  child_exit_time=child_exit_time, log=log_record,
   940	                  child_exit_receipt=receipt_record,
   941	                  diagnostic=diagnostic, admissible_arm=not diagnostic)
   942	    fields.update(diagnostic_evidence(run_dir, receipt, child_exit, repo, receipt_record)
   943	                  if diagnostic
   944	                  else full_evidence(run_dir, repo) if run_type == 'exp11_train'
   945	                  else haa_train_evidence(run_dir, repo) if run_type == 'exp11_haa_finetune'
   946	                  else haa_eval_evidence(run_dir, repo))
   947	    _require(provenance.sha256_file(log) == log_digest,
   948	             'stale log: {} changed while its completion was being validated'.format(log))
   949	    return base.write_completion(run_dir / 'completion.json', fields)
