  1014	@functools.lru_cache(maxsize=None)
  1015	def expected_state_keys(backbone, num_shot):
  1016	    """The parameter names a checkpoint of this arm must carry, and nothing else."""
  1017	    with torch.random.fork_rng(devices=[]):
  1018	        return frozenset(build_xrir_exp06(backbone, num_shot).state_dict().keys())
  1019	
