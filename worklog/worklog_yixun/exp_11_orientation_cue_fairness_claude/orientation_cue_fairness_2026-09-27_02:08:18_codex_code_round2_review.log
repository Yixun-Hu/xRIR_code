   854	def smoke_run_dir(run_dir, repo):
   855	    """A finalised diagnostic lives in the disposable smoke tree and nowhere else (A4)."""
   856	    root = _resolve(SMOKE_ROOT, repo).resolve()
   857	    path = Path(run_dir).resolve()
   858	    _require(path != root and root in path.parents,
   859	             '{} is not inside the disposable smoke tree {}'.format(path, root))
   860	    return path
