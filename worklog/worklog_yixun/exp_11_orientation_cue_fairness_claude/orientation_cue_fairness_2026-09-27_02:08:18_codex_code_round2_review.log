   802	def diagnostic_receipt(receipt, run_type, provenance_record):
   803	    """Finding 6: the runner's identity, budgets, timing and memory, all required."""
   804	    _require(receipt is not None, 'a diagnostic run needs its --receipt')
   805	    path = Path(receipt)
   806	    _require(path.is_file(), 'missing smoke receipt: {}'.format(receipt))
   807	    record = _read_json(path, 'smoke receipt')
   808	    _require(record.get('diagnostic') is True, 'the smoke receipt is not marked diagnostic')
   809	    missing = [key for key in DIAGNOSTIC_RECEIPT if key not in record]
   810	    _require(not missing, 'the smoke receipt is incomplete: missing ' + ', '.join(missing))
   811	    argv = record['argv']
   812	    _require(isinstance(argv, list), 'the smoke receipt argv {!r} is not a list'.format(argv))
   813	    _require(run_type not in NO_SAVE_REQUIRED or '--no-save' in argv,
   814	             'a diagnostic must run with --no-save; its receipt records argv {!r}'.format(argv))
   815	    wrapper = HAA_SMOKE_ENTRY.get(run_type)
   816	    _require(wrapper is None or record.get('entry') == wrapper,
   817	             'a {} receipt must record the entry {!r}, not {!r}'.format(
   818	                 run_type, wrapper, record.get('entry')))
   819	    _require(type(record['exit_status']) is int,
   820	             'the smoke receipt records exit_status {!r}'.format(record['exit_status']))
   821	    _require(record['runner'] == 'tools.exp06_smoke',
   822	             'the smoke receipt records runner {!r}'.format(record['runner']))
   823	    _require(_is_sha256(record['runner_closure_sha256']),
   824	             'the smoke receipt records no runner closure digest')
   825	    _require(isinstance(record['entry'], str) and record['entry'],
   826	             'the smoke receipt records entry {!r}'.format(record['entry']))
   827	    _require(record['run_type'] == run_type,
   828	             'the smoke receipt records run_type {!r}, not {}'.format(record['run_type'], run_type))
   829	    _require(record['outcome'] in OUTCOMES,
   830	             'the smoke receipt records outcome {!r}, not one of {}'.format(
   831	                 record['outcome'], list(OUTCOMES)))
   832	    _require(type(record['exploratory']) is bool,
   833	             'the smoke receipt records exploratory {!r}'.format(record['exploratory']))
   834	    ended = _timestamp(record['ended_at'], 'ended_at')
   835	    _require(ended >= _timestamp(record['started_at'], 'started_at'),
   836	             'the smoke receipt ended_at precedes its started_at')
   837	    for key in RECEIPT_NUMBERS:
   838	        _require(_finite('the smoke receipt ' + key, record[key]) >= 0,
   839	                 'the smoke receipt {} is {!r}, not a duration or budget'.format(key, record[key]))
   840	    _require(type(record['peak_bytes']) is int and record['peak_bytes'] >= 0,
   841	             'the smoke receipt peak_bytes is {!r}'.format(record['peak_bytes']))
   842	    _require(record['git_head'] == provenance_record['git_state']['HEAD'],
   843	             'the smoke receipt git_head {!r} is not the {} of its provenance'.format(
   844	                 record['git_head'], provenance_record['git_state']['HEAD']))
   845	    closure = list(provenance_record['source_closures'].values())[0]
   846	    _require(record['runner_closure_sha256'] == closure['sha256'],
   847	             'the smoke receipt runner closure is not the {} its provenance recorded'.format(
   848	                 closure['sha256']))
   849	    _require(record['exploratory'] == bool(provenance_record.get('exploratory')),
   850	             'the smoke receipt and its provenance disagree about exploratory')
   851	    return record, path
