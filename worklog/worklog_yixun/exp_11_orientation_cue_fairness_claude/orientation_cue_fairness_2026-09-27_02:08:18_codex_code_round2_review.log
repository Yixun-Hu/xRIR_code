    73	def diagnostic_provenance(kind, argv, repo=REPO, approved=None, reviewed_commit=None,
    74	                          exploratory=False):
    75	    """A diagnostic binds its code the way a full run does, minus the training artefacts."""
    76	    spec = kind_spec(kind)
    77	    state = provenance.git_state(repo)
    78	    commit = state['HEAD'] if reviewed_commit is None else reviewed_commit
    79	    files, digest = exp11_profiles.closure_of('smoke', repo, commit)
    80	    return dict(repo=str(repo), reviewed_commit=commit, run_type=spec['run_type'],
    81	                entry=spec['entry'], kind=kind, diagnostic=True, admissible_arm=False,
    82	                source_closures={'diagnostic': {'entry_module': RUNNER, 'files': files,
    83	                                                'sha256': digest}},
    84	                orchestration_closures=exp11_train.orchestration_closures(repo, commit),
    85	                code_digests=exp11_profiles.compute_code_digests(
    86	                    repo, commit, keys=exp11_profiles.TRAINING_KEYS),
    87	                approvals=exp11_train.approvals_binding(approved),
    88	                exploratory=bool(exploratory), registry_sha256=registry_sha256(),
    89	                git_state=state, environment=provenance.environment(),
    90	                command=[kind] + list(argv))
