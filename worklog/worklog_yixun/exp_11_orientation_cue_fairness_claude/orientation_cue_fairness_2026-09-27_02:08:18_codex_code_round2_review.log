   115	def main(argv=None):
   116	    """exp_06's evaluation main, with exp_11's records written before the loop."""
   117	    command = list(sys.argv[1:] if argv is None else argv)
   118	    args = parse_args(argv)
   119	    torch.set_num_threads(args.threads)
   120	    context = prepare(args, command)
   121	    records.write_records(args, context)
   122	    model = context.model
   123	    records.load_init(model, load_model_state(args.checkpoint))
   124	    model.cuda().eval()
   125	    evaluator = Evaluator()
   126	    all_summaries = {}
   127	    for room in args.rooms:
   128	        meta = per_sample_meta(args, context, room)
   129	        per, counts, elapsed = legacy_eval.evaluate_room(model, evaluator, args, context, room)
   130	        summary = legacy_eval.room_summary(args, room, per, counts, meta, elapsed)
   131	        all_summaries[room] = summary
   132	        legacy_eval.write_room_outputs(args, room, summary, per, meta)
   133	        t60s = ('{:.2f}%'.format(summary['t60_error_pct']['mean'])
   134	                if summary['t60_error_pct'] else '-')
   135	        print('{:14s} n={:4d}  EDT {:.4f}s  C50 {:.3f}dB  T60 {}  env {:.2f}  loss {:.4f}  '
   136	              '({:.1f} min)'.format(room, summary['n_samples'],
   137	                                    summary['edt_error_s']['mean'],
   138	                                    summary['c50_error_db']['mean'], t60s,
   139	                                    summary['env_error']['mean'],
   140	                                    summary['test_loss']['mean'], elapsed), flush=True)
   141	    with open(os.path.join(args.save_dir, 'metrics_all{}.json'.format(args.tag)), 'w') as f:
   142	        json.dump(all_summaries, f, indent=2)
