   149	
   150	def verify_source_closure(record, run_type, repo):
   151	    """Three ways -- the working tree now, the bytes at spawn, the reviewed blobs.
   152	
   153	    exp_06's function reads its own ``ENTRY_MODULES`` global, which exp_11 may neither
   154	    extend nor monkeypatch, so the entry identity is decided here against exp_11's map
   155	    and the file comparison below is that function's, step for step.
   156	    """
   157	    closures = record['source_closures']
   158	    _require(isinstance(closures, dict) and len(closures) == 1,
   159	             'provenance.json must record exactly one source closure')
   160	    name, closure = sorted(closures.items())[0]
   161	    _require(isinstance(closure, dict), 'source closure {} is not a record'.format(name))
   162	    entry = closure.get('entry_module')
   163	    _require(entry == ENTRY_MODULES[run_type], 'source closure entry module is {!r}, not '
   164	             'the {!r} of {}'.format(entry, ENTRY_MODULES[run_type], run_type))
   165	    files = closure.get('files')
   166	    _require(isinstance(files, list) and files, 'the recorded source closure is empty')
   167	    for item in files:
   168	        _require(isinstance(item, dict) and isinstance(item.get('path'), str)
   169	                 and _is_sha256(item.get('working_tree_sha256'))
   170	                 and _is_sha256(item.get('reviewed_blob_sha256')),
   171	                 'incomplete source closure file record: {!r}'.format(item))
   172	    _require(closure.get('sha256') == closure_digest(files),
   173	             'recorded source closure digest does not match its own file list')
   174	    current = closure_paths(entry, str(Path(repo).resolve()))
   175	    _require(sorted(current) == sorted(item['path'] for item in files),
   176	             'source closure membership changed: '
   177	             + ', '.join(sorted(set(current) ^ {item['path'] for item in files})))
   178	    fresh, digest = provenance.closure_record(list(current), record['reviewed_commit'], repo)
   179	    _require(digest == closure['sha256'],
   180	             'source closure drift: the reviewed blobs differ from the recorded digest')
