   199	
   200	def build_parser():
   201	    parser = argparse.ArgumentParser(description='Run one bounded exp_11 diagnostic.')
   202	    parser.add_argument('--kind', choices=KIND_NAMES)
   203	    parser.add_argument('--receipt')
   204	    parser.add_argument('--alarm-seconds', type=float, default=None,
   205	                        help="at most the kind's registered budget")
   206	    parser.add_argument('--max-gb', type=float, default=None,
   207	                        help="at most the kind's registered ceiling")
   208	    parser.add_argument('--provenance-out')
   209	    parser.add_argument('--approved')
   210	    parser.add_argument('--reviewed-commit')
   211	    parser.add_argument('--exploratory', action='store_true')
   212	    parser.add_argument('--make-fixture')
   213	    parser.add_argument('--fixture-backbone', choices=FIXTURE_BACKBONES,
   214	                        default='simple_oriented')
   215	    parser.add_argument('--seed', type=int, default=0)
   216	    parser.add_argument('argv', nargs=argparse.REMAINDER,
   217	                        help="after --, the entry's own argv")
   218	    return parser
   219	
   220	
   221	def main(argv=None):
   222	    """Exit 0 on a completed diagnostic; the runner raises SystemExit(3) on an abort."""
   223	    parser = build_parser()
   224	    args = parser.parse_args(sys.argv[1:] if argv is None else list(argv))
   225	    child = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
   226	    if args.make_fixture:
   227	        make_fixture(args.make_fixture, args.fixture_backbone, args.seed)
   228	        return 0
   229	    if not args.kind:
   230	        parser.error('--kind or --make-fixture is required')
   231	    run_kind(args.kind, child, receipt=args.receipt, alarm_seconds=args.alarm_seconds,
   232	             max_gb=args.max_gb, provenance_out=args.provenance_out, approved=args.approved,
   233	             reviewed_commit=args.reviewed_commit, exploratory=args.exploratory)
   234	    return 0
   235	
   236	
   237	if __name__ == '__main__':
   238	    raise SystemExit(main())
