   136	def _checkpoint_keys(path, label, backbone, num_shot):
   137	    """Refuse a checkpoint that is not this arm's model, before anything hashes it."""
   138	    state = _state_dict(_load_torch(path, label), label)
   139	    expected = expected_state_keys(backbone, num_shot)
   140	    _require(frozenset(state) == expected, '{}: {} parameters are not the {} of '
   141	             'build_xrir_exp11({!r}, {})'.format(label, len(state), len(expected),
   142	                                                 backbone, num_shot))
