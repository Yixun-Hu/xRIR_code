    92	
    93	def run_kind(kind, argv, receipt=None, alarm_seconds=None, max_gb=None,
    94	             provenance_out=None, approved=None, reviewed_commit=None, exploratory=False):
    95	    """Run one enumerated kind in-process under its own budget; abort with status 3.
    96	
    97	    A caller may tighten a budget but never loosen it: the kind's registered ceiling is
    98	    the maximum, so a diagnostic cannot quietly grow past what the plan allowed.
    99	    """
   100	    spec = kind_spec(kind)
   101	    alarm = bounded.check_budget('alarm_seconds',
   102	                                 spec['alarm_seconds'] if alarm_seconds is None
   103	                                 else alarm_seconds)
   104	    ceiling = bounded.check_budget('max_gb', spec['max_gb'] if max_gb is None else max_gb)
   105	    if alarm > spec['alarm_seconds'] or ceiling > spec['max_gb']:
   106	        raise ValueError('the {} budget is {} s / {} GiB; {} s / {} GiB exceeds it'.format(
   107	            kind, spec['alarm_seconds'], spec['max_gb'], alarm, ceiling))
   108	    module = importlib.import_module(spec['entry'])
   109	    record = None
   110	    if provenance_out is not None:
   111	        record = diagnostic_provenance(kind, argv, REPO, approved, reviewed_commit,
   112	                                       exploratory)
   113	        provenance.write_manifest(Path(provenance_out), record)
   114	    if torch.cuda.is_available():
   115	        torch.cuda.reset_peak_memory_stats()
   116	    result = dict(schema_version=1, diagnostic=True, admissible_arm=False, runner=RUNNER,
   117	                  kind=kind, entry=spec['entry'], module=spec['entry'],
   118	                  run_type=spec['run_type'], exploratory=bool(exploratory), argv=list(argv),
   119	                  alarm_seconds=alarm, max_gb=ceiling, artifacts=list(spec['artifacts']),
   120	                  entry_status=None, aborted_memory=False, outcome_detail=None,
   121	                  runner_closure_sha256=exp11_profiles.code_digest(
   122	                      'smoke', REPO, provenance.git_state(REPO)['HEAD']
   123	                      if reviewed_commit is None else reviewed_commit),
   124	                  provenance=None if record is None else {
   125	                      'path': str(Path(provenance_out).resolve()),
   126	                      'sha256': provenance.sha256_file(provenance_out)},
   127	                  git_head=provenance.git_state(REPO)['HEAD'],
   128	                  started_at=bounded._now(), ended_at=None,
   129	                  timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())
   130	    started, limit = time.monotonic(), ceiling * GIB
   131	    deadline = started + alarm
   132	
   133	    def watchdog(signum, frame):
   134	        if bounded.peak_bytes() > limit:
   135	            raise bounded._MemoryExceeded('smoke exceeded its allocation ceiling')
   136	        if time.monotonic() >= deadline:
   137	            raise bounded._Timeout('smoke exceeded its wall-clock budget')
   138	
   139	    previous = signal.signal(signal.SIGALRM, watchdog)
   140	    tick = min(1.0, alarm)
   141	    signal.setitimer(signal.ITIMER_REAL, tick, tick)
   142	    try:
   143	        try:
   144	            status = module.main(list(argv))
   145	            result['entry_status'] = status if type(status) is int else None
   146	            result['exit_status'] = status if type(status) is int else 0
   147	            result['outcome'] = 'failed' if result['exit_status'] else 'ok'
   148	        finally:
   149	            signal.setitimer(signal.ITIMER_REAL, 0)
   150	            signal.signal(signal.SIGALRM, previous)
   151	    except bounded._Timeout:
   152	        result['exit_status'], result['outcome'] = 3, 'aborted_alarm'
   153	    except bounded._MemoryExceeded:
   154	        result['exit_status'], result['outcome'] = 3, 'aborted_memory'
   155	        result['aborted_memory'] = True
   156	    except BaseException as error:
   157	        result['exit_status'], result['outcome'] = 1, 'failed'
   158	        result['outcome_detail'] = 'error: ' + type(error).__name__
   159	        _publish(result, started, receipt)
   160	        raise
   161	    _publish(result, started, receipt)
   162	    if result['exit_status'] != 0:
   163	        raise SystemExit(3)
   164	    return result
   165	
   166	
   167	def _publish(result, started, receipt):
   168	    """One ``EXP11_SMOKE`` line and, if asked, the receipt; both carry the same record."""
   169	    result['wall_s'] = time.monotonic() - started
   170	    result['peak_bytes'] = bounded.peak_bytes()
   171	    result['ended_at'] = bounded._now()
   172	    if result['exit_status'] == 0 and result['peak_bytes'] > result['max_gb'] * GIB:
   173	        result['exit_status'], result['outcome'] = 3, 'aborted_memory'
   174	    elif result['exit_status'] == 0 and result['wall_s'] > result['alarm_seconds']:
   175	        result['exit_status'], result['outcome'] = 3, 'aborted_alarm'
   176	    print('EXP11_SMOKE ' + json.dumps(result, sort_keys=True, allow_nan=False), flush=True)
   177	    if receipt is not None:
   178	        provenance.write_completion(Path(receipt), result)
   179	    return result
