   967	def preflight(mode, gpu, reviewed_commit, attempt_root=None, repo=REPO, approved=None,
   968	              exploratory=False, min_free_gb=None):
   969	    """Gate a launch: reviewed commit, clean tree, no live launch, approvals, a free card."""
   970	    _require(mode in LAUNCH_MODES, 'unknown launch mode: {!r}'.format(mode))
   971	    state = provenance.checked_git_state(repo, confirmatory=True)
   972	    _require(state['HEAD'] == reviewed_commit,
   973	             'HEAD {} is not the reviewed commit {!r} (full 40-hex sha required)'.format(
   974	                 state['HEAD'], reviewed_commit))
   975	    running = base.live_launches(attempt_root)
   976	    _require(not running, 'another exp_11 launch is alive: {}'.format(running))
   977	    admission = approval_gate(mode, reviewed_commit, approved, exploratory, repo)
   978	    apps = base.gpu_compute_apps(gpu) if mode in EXCLUSIVE_GPU_MODES else None
   979	    _require(not apps, 'GPU {} is busy with compute apps {}'.format(gpu, apps))
   980	    free = None if min_free_gb is None else base.gpu_free_gib(gpu)
   981	    _require(free is None or free >= min_free_gb,
   982	             'GPU {} has {:.2f} GiB free, below the {} GiB this launch may allocate'.format(
   983	                 gpu, free or 0.0, min_free_gb))
   984	    return dict(mode=mode, gpu=gpu, reviewed_commit=reviewed_commit, git_state=state,
   985	                attempt_root=[str(root) for root in base.launch_roots(attempt_root)],
   986	                gpu_compute_apps=apps, live_launches=running, min_free_gb=min_free_gb,
   987	                gpu_free_gib=free, **admission)
