   122	def registry_sha256():
   123	    """The digest of exp_11's registry as it stands at finalisation."""
   124	    mapping = {name: cls.__module__ + '.' + cls.__qualname__
   125	               for name, cls in BACKBONES_EXP11.items()}
   126	    return hashlib.sha256(json.dumps(mapping, sort_keys=True).encode()).hexdigest()
