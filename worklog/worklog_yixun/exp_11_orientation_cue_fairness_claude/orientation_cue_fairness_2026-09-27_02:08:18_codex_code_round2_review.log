   182	def make_fixture(path, backbone='simple_oriented', seed=0):
   183	    """Seeded CPU initialisation of one exp_11 model, with a hash/registry sidecar."""
   184	    if backbone not in FIXTURE_BACKBONES:
   185	        raise ValueError('a fixture is one of {}, not {!r}'.format(
   186	            ', '.join(FIXTURE_BACKBONES), backbone))
   187	    path = Path(path)
   188	    path.parent.mkdir(parents=True, exist_ok=True)
   189	    torch.manual_seed(seed)
   190	    torch.save(build_xrir_exp11(backbone, 8).state_dict(), str(path))
   191	    record = dict(schema_version=1, diagnostic=True, admissible_arm=False,
   192	                  path=str(path.resolve()), seed=seed, backbone=backbone, num_shot=8,
   193	                  sha256=provenance.sha256_file(path), registry_sha256=registry_sha256(),
   194	                  git_head=provenance.git_state(REPO)['HEAD'],
   195	                  timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())
   196	    provenance.write_completion(Path(str(path) + '.json'), record)
   197	    return record
