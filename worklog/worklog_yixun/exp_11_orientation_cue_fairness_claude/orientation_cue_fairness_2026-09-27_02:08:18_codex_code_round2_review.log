   952	def approval_gate(mode, reviewed_commit, approved, exploratory, repo):
   953	    """No confirmatory launch on code exp_11's approvals do not pin."""
   954	    _require(not (exploratory and mode == 'full'),
   955	             'an exploratory launch is a diagnostic; mode full must match the approvals')
   956	    bind = not (exploratory and mode in ('smoke', 'probe'))
   957	    path = _resolve(exp11_profiles.APPROVED_RELATIVE if approved is None else approved, repo)
   958	    _require(path.is_file(), 'missing approvals file: {}'.format(path))
   959	    value, identity = exp11_profiles.load_approved_digests(
   960	        path, repo=repo if bind else None, commit=reviewed_commit if bind else None)
   961	    deviations = exp11_profiles.require(value, exp11_profiles.TRAINING_KEYS, repo=repo,
   962	                                        commit=reviewed_commit, exploratory=exploratory)
   963	    return {'approved': identity, 'approval_deviations': deviations,
   964	            'exploratory': bool(exploratory)}
