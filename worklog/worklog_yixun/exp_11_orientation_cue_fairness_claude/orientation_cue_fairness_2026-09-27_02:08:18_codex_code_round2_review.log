    65	def kind_spec(kind):
    66	    """One enumerated diagnostic kind; an unregistered name is refused, never guessed."""
    67	    if kind not in KINDS:
    68	        raise ValueError('unknown exp_11 diagnostic kind {!r}; choose from {}'.format(
    69	            kind, ', '.join(KIND_NAMES)))
    70	    return dict(KINDS[kind])
