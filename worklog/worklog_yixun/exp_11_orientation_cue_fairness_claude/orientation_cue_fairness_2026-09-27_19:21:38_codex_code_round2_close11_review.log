   186	}
   187	
   188	# --- publishing one arm is serialised, by the kernel --------------------------------
   189	# Plan section 11 amendment A1, close review 6. Publishing one arm admits exactly one
   190	# invocation at a time: recovery from alias resolution through promotion, and a full run
   191	# from before it launches its child through promotion, so a recovery is refused while a
   192	# training run still owns the arm.
   193	#
   194	# The lock is an `flock` on a per-arm FILE, and it is NOT held by this shell: every
   195	# descriptor this shell has open is inherited by the background log sink and by the
   196	# detached training child, and an orphaned sink would keep an arm locked for good. It is
   197	# held by a HOLDER PROCESS whose life is leased to this launcher's -- it exits as soon as
   198	# its parent changes -- so **the lock vanishes within a second of this launcher's exit or
   199	# death**, on every path including a signal and SIGKILL, and is never inherited by the
   200	# trainer or the log sink. The attempt is non-blocking: it refuses at once,
   201	# never waits.
   202	LOCK_FILE=""
   203	HOLDER_PID=""
   204	
   205	hold_arm_lock() {  # hold_arm_lock <mode>
   206	    LOCK_FILE="$ARM_ROOT/.publish.lock"
   207	    say "LOCK $LOCK_FILE"
   208	    # A dry run touches nothing outside the test roots, so the lock is real exactly
   209	    # where the tests exercise it and announced everywhere else.
   210	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   211	    mkdir -p -- "$ARM_ROOT" || return 1
   212	    local verdict="" pid="" out=""
   213	    # `exec` inside the substitution makes the holder a direct child of this shell, so
   214	    # its lease is this shell's pid. The read end is closed the moment the verdict is in,
   215	    # so no descriptor of ours reaches the sink or the child either.
   216	    exec {out}< <(exec "$PYTHON" tools/exp11_lock_holder.py "$LOCK_FILE" $$)
   217	    read -r -t 30 verdict pid <&"$out" || true
   218	    exec {out}<&-
   219	    if [ "$verdict" = refused ]; then
   220	        echo "refusing: $LOCK_FILE is held by another invocation publishing this arm;" \
   221	             "one publication per arm at a time. Its holder ends with that invocation," \
   222	             "so there is nothing to clear by hand" >&2
   223	        return 1
   224	    fi
   225	    if [ "$verdict" != acquired ] || [ -z "$pid" ]; then
   226	        # Not someone else's lock: the holder never reported one. Say which it is.
   227	        echo "refusing: the lock holder for $LOCK_FILE did not start (no verdict);" \
   228	             "nothing was published" >&2
   229	        return 1
   230	    fi
   231	    HOLDER_PID="$pid"
   232	    trap 'on_signal INT 2' INT
   233	    trap 'on_signal TERM 15' TERM
   234	    trap 'drop_arm_lock' EXIT
   235	    say "LOCKED $LOCK_FILE mode=$1"
   236	}
   237	
   238	# drop_arm_lock: end our own holder, so the ordinary path releases at once instead of
   239	# waiting out the lease. Every other path -- a signal, a crash, a kill -9 -- is covered
   240	# by the lease itself, which is why this needs no error handling of its own. A recorded
   241	# pid is not a licence to signal it: if that holder is already gone the number belongs to
   242	# whoever the kernel gave it to next, so nothing is sent unless the process is still this
   243	# shell's child.
   244	drop_arm_lock() {
   245	    [ -n "$HOLDER_PID" ] || return 0
   246	    local parent=""
   247	    parent="$(sed -n 's/^.*) [A-Za-z] \([0-9][0-9]*\).*/\1/p' \
   248	              "/proc/$HOLDER_PID/stat" 2>/dev/null || true)"
   249	    [ "$parent" = "$$" ] && { kill -TERM "$HOLDER_PID" 2>/dev/null || true; }
   250	    wait "$HOLDER_PID" 2>/dev/null || true
   251	    HOLDER_PID=""
   252	}
   253	
   254	# --- what the lock protects is a quiet arm -------------------------------------------
   255	# The lock says "one publication at a time"; it does not say "no trainer is running".
   256	# That is this scan's job, and it has to run UNDER the lock: a scan taken before
   257	# acquisition can go stale in the window between, which is exactly how a recovery could
   258	# promote an older attempt while a newer trainer of the same arm kept writing
   259	# (close review 7, blocker 1). `kill -0` asks the kernel whether a pid still exists; it
   260	# is a probe and sends no signal.
   261	UNRESOLVED_GRACE_S="${EXP11_UNRESOLVED_GRACE_S:-120}"
   262	SCAN_REASON=""
   263	
   264	# pid_record <file>: print the pid <file> holds, or return 1. The grammar lives in
   265	# tools/exp11_pidrecord.py and nowhere else -- this shell does NOT read pid files. Bash
   266	# command substitution drops NUL bytes, so a reader written here answered "that is a
   267	# pid" for `<digits>\0` while the trainer's reader said it was not, and a dead pid with
   268	# a NUL made an arm read quiet with a trainer in it (close review 10, blocker 1). Only
   269	# the module's stdout crosses back, and that is digits by construction.
   270	pid_record() {
   271	    [ -f "$1" ] || return 1
   272	    "$PYTHON" -m tools.exp11_pidrecord "$1" 2>/dev/null
   273	}
   274	
   275	pid_alive() {  # pid_alive <file>: the pid <file> records names a living process
   276	    local pid=""
   277	    pid="$(pid_record "$1")" || return 1
   278	    kill -0 "$pid" 2>/dev/null
   279	}
   280	
   281	# registration_complete <attempt>: child.pid holds one pid, by the grammar above. The
   282	# shell creates that file by redirection before the pid reaches it, so existence alone
   283	# proves nothing; what makes a launch *registered* is a number to look for. Whether that
   284	# number is still alive is a separate question, asked by pid_alive of the same bytes.
   285	registration_complete() {
   286	    pid_record "$1/child.pid" >/dev/null
   287	}
   288	
   289	# scan_arm <arm root> [<attempt being resolved>]: 0 when every attempt of the arm is
   290	# finished and accounted for. SCAN_REASON names the first one that is not.
   291	scan_arm() {
   292	    local root="$1" resolving="${2:-}" attempt="" name="" here=""
   293	    SCAN_REASON=""
   294	    # The attempt being resolved is excluded by canonical identity, never by spelling:
   295	    # the caller's path and this glob's may name the same directory differently.
   296	    [ -z "$resolving" ] || resolving="$(realpath -- "$resolving" 2>/dev/null || printf '%s' "$resolving")"
   297	    for attempt in "$root"/attempt_*; do
   298	        [ -d "$attempt" ] || continue
   299	        name="$(basename -- "$attempt")"
   300	        here="$(realpath -- "$attempt" 2>/dev/null || printf '%s' "$attempt")"
   301	        if pid_alive "$attempt/launch.pid"; then
   302	            SCAN_REASON="$name has a live launcher (launch.pid)"; return 1; fi
   303	        if pid_alive "$attempt/child.pid"; then
   304	            SCAN_REASON="$name has a live trainer (child.pid)"; return 1; fi
   305	        if pid_alive "$attempt/train.pid"; then
   306	            SCAN_REASON="$name has a live trainer (train.pid)"; return 1; fi
   307	        [ "$here" != "$resolving" ] || continue
   308	        # `child.pid` is the WRAPPER's (GNU timeout), not the trainer's, so a complete
   309	        # and dead one accounts for nothing: only train.pid names the trainer and only
   310	        # train.exit says it finished (close review 10, blocker 2).
   311	        if [ -f "$attempt/launching" ] &&
   312	           { [ ! -f "$attempt/train.pid" ] || [ ! -f "$attempt/train.exit" ]; }; then
   313	            SCAN_REASON="$name has an unresolved launch: a launching marker and no"\
   314	" finished trainer (train.pid and train.exit), so a trainer of it may be running or may"\
   315	" have died unrecorded -- child.pid names the timeout wrapper, not the trainer."\
   316	" Resolve it"\
   317	" with --resolve-unregistered $attempt once nothing of the arm is alive and the marker"\
   318	" is older than ${UNRESOLVED_GRACE_S}s"
