   414	        exec {reg_fd}>&-
   415	        echo "refusing: a registration in progress holds $registration; a trainer is" \
   416	             "between its checks and its write, so nothing of this arm may be retired" >&2
   417	        return 1
   418	    fi
   419	    scan_arm "$ARM_ROOT" "$attempt" || {
   420	        exec {reg_fd}>&-
   421	        echo "refusing: $SCAN_REASON" >&2; return 1; }
   422	    now="$(date -u +%s)"
   423	    stamp="$(date -u -r "$attempt/launching" +%s 2>/dev/null || printf '%s' "$now")"
   424	    age=$((now - stamp))
   425	    if [ "$age" -lt "$UNRESOLVED_GRACE_S" ]; then
   426	        exec {reg_fd}>&-
   427	        echo "refusing: $attempt/launching is ${age}s old and a trainer that has not" \
   428	             "registered yet is still possible; wait until it is ${UNRESOLVED_GRACE_S}s" >&2
   429	        return 1
   430	    fi
   431	    say "TOMBSTONE $root/$name.resolved"
   432	    say "ABORT $attempt -> ${attempt}_ABORTED_unregistered"
   433	    if [ "$DRY" -eq 0 ]; then
   434	        # Written BEFORE the rename, and never removed by anything here: a trainer that
   435	        # wakes after this can no longer find its directory, and if it somehow can, this
   436	        # is what tells it the launch was answered. The scan ignores it -- it is a
   437	        # record, not a claim (close review 8, blocker 2).
   438	        printf 'resolved-by %s\nat %s\nreason unregistered launch: no complete child.pid\n' \
   439	            "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" > "$root/$name.resolved"
   440	        mv -- "$attempt" "${attempt}_ABORTED_unregistered"

