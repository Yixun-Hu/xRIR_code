   195	
   196	def registration_complete(attempt):
   197	    """``child.pid`` holds one pid, by that grammar (the launcher's own test)."""
   198	    return pid_record(Path(attempt) / 'child.pid') is not None
   199	
   200	
   201	REGISTRATION_LOCK = '.registration.lock'
   202	REGISTRATION_WAIT_S = 60
   203	
   204	
   205	def registration_lock_path(save_dir):
   206	    """The arm root's registration lock -- one per arm, beside its attempts."""
   207	    return Path(save_dir).parent / REGISTRATION_LOCK
   208	
   209	
   210	@contextlib.contextmanager
   211	def registration_lock(save_dir, wait_seconds=REGISTRATION_WAIT_S):
   212	    """Hold the arm's REGISTRATION lock, or give up after ``wait_seconds``.
   213	
   214	    This is not the publication lock: a full-mode launcher holds that one for its
   215	    child's whole run, so a trainer could never take it. This one is held only across a
   216	    registration and across a resolution, which is exactly the pair that must not
   217	    interleave (close review 9, blocker 2). The wait is blocking but bounded, because a
   218	    resolution is short and a trainer that waits forever is a trainer nothing can end.
   219	    """
   220	    path = registration_lock_path(save_dir)
   221	    try:
   222	        handle = open(str(path), 'a')
   223	    except OSError as error:
   224	        refuse('cannot open the registration lock {}: {}'.format(path, error))
   225	    try:
   226	        # A duration belongs on the clock that only goes forward: NTP corrections and
   227	        # a resuming VM step time.time() in either direction, which would shorten this
   228	        # bound to nothing or stretch it past any trainer's patience.
   229	        deadline = time.monotonic() + wait_seconds
   230	        while True:
   231	            try:
   232	                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
   233	                break
   234	            except OSError:
   235	                if time.monotonic() >= deadline:
   236	                    refuse('the registration lock {} was held for more than {}s; '
   237	                           'another registration or a resolution is in progress'
   238	                           .format(path, wait_seconds))
   239	                time.sleep(0.05)
   240	        yield
   241	    finally:
   242	        handle.close()          # closing the descriptor releases the lock
   243	
   244	
   245	def refuse(reason):
   246	    print('refusing: ' + reason, file=sys.stderr, flush=True)
   247	    raise SystemExit(RESOLVED_EXIT)
   248	
   249	
   250	def register_trainer(save_dir, no_save=False, arm_root=None,
   251	                     wait_seconds=REGISTRATION_WAIT_S):
   252	    """Name this process in its own run directory, after parsing and before admission.
   253	
   254	    The launcher's ``child.pid`` is written by the frozen lifecycle only *after* it has
   255	    forked this process, so a launcher that dies in between leaves a trainer nothing in
   256	    the arm can see (close review 7, blocker 2). This file is the trainer's own answer.
   257	
   258	    It is also where this trainer finds out whether its launch is still a launch. A
   259	    delayed trainer can wake long after an operator resolved the attempt as unregistered
   260	    -- the marker's age proved nothing about it -- so the answer has to be in the state
   261	    of the directory, and this process **fails closed** (close review 8, blocker 2):
   262	
   263	    * the save-dir is gone: the launcher creates it, the trainer never does, so its
   264	      absence means the launch it belongs to is over;
   265	    * a ``<attempt>.resolved`` tombstone stands beside it: that launch was answered and
   266	      retired, permanently;
   267	    * neither ``launching`` nor a complete ``child.pid`` is there: from the fork onward
   268	      an ordinary launch always carries one of them.
   269	
   270	    All of that, and the write itself, happen under the arm's REGISTRATION lock, so a
   271	    resolution cannot rename the directory between the checks and the write (close
   272	    review 9, blocker 2); the write is a temp file and one ``os.replace``, so no reader
   273	    ever sees half a pid.
   274	
   275	    ``--no-save`` runs are diagnostics that no scan reads; they write no sidecars, take
   276	    no lock, and only the tombstone can refuse them.
   277	    """
   278	    directory = Path(save_dir)
   279	    tombstone = directory.parent / (directory.name + '.resolved')
   280	    if no_save:                       # a diagnostic no scan reads: only a tombstone speaks
   281	        if tombstone.is_file():
   282	            refuse('{} was resolved as an unregistered launch and retired; this trainer '
   283	                   'has nothing to run in'.format(directory))
   284	        return None
   285	    root = Path(arm_root) if arm_root is not None else directory.parent
   286	    with registration_lock(directory, wait_seconds):
   287	        # Everything below happens under the lock, so a resolution cannot rename this
   288	        # directory between the checks and the write.
   289	        if not directory.is_dir():
   290	            refuse('{} does not exist; the launcher creates the attempt and this trainer '
   291	                   'never does'.format(directory))
   292	        if directory.resolve().parent != root.resolve():
   293	            refuse('{} is not an attempt of {}; this trainer registers only in the arm '
   294	                   'whose lock it holds'.format(directory, root))
   295	        if tombstone.is_file():
   296	            refuse('{} was resolved as an unregistered launch and retired; this trainer '
   297	                   'has nothing to run in'.format(directory))
   298	        if not (directory / 'launching').is_file() and not registration_complete(directory):
   299	            refuse('{} carries no launch record -- no launching marker and no complete '
   300	                   'child.pid -- so no launch of it is in progress'.format(directory))
   301	        path = directory / 'train.pid'
   302	        # Atomic: a reader sees the old file or the whole new one, never a partial pid.
   303	        temporary = directory / ('train.pid.{}.tmp'.format(os.getpid()))
   304	        temporary.write_text('{}\n'.format(os.getpid()))
   305	        os.replace(str(temporary), str(path))
   306	    return path
   307	
   308	
   309	def exit_code(exit_request):
   310	    """``raise SystemExit`` carries None, which is status 0, not 1."""
   311	    code = exit_request.code
   312	    if code is None:
   313	        return 0
   314	    return code if isinstance(code, int) else 1
   315	
   316	
   317	def record_trainer_exit(path, code):
   318	    """Say how this trainer left, on every path it controls."""
   319	    if path is None:
   320	        return
   321	    try:
   322	        with open(str(path.parent / 'train.exit'), 'a') as stream:
   323	            stream.write('train.exit {}\n'.format(code))
   324	    except OSError:                       # a vanished run directory is not the trainer's
   325	        pass                              # problem to report; the scan reads the pid file
   326	
   327	
   328	def main(argv=None):
   329	    """Register, run, and record how it ended -- whatever ends it."""
   330	    args = parse_args(argv)
   331	    registration = register_trainer(args.save_dir, no_save=args.no_save)
   332	    code = 0
   333	    try:
   334	        run(list(sys.argv[1:] if argv is None else argv), check_admission(args))
   335	    except SystemExit as exit_request:
   336	        code = exit_code(exit_request)
   337	        raise
   338	    except BaseException:
   339	        code = 'exception'
   340	        raise
   341	    finally:
   342	        record_trainer_exit(registration, code)
   343	
   344	
   345	def run(command, args):
   346	    """The trainer's main, step for step, with the exp_11 registry and provenance."""
   347	    trainer.seed_everything(args.seed)
   348	    torch.backends.cuda.matmul.allow_tf32 = args.tf32
   349	    torch.backends.cudnn.allow_tf32 = args.tf32
   350	
   351	    train_dataset = xRIR_Dataset(split='train', max_len=args.max_len, num_shot=args.num_shot)
   352	    test_dataset = xRIR_Dataset(split='test', max_len=args.max_len, num_shot=args.num_shot)
   353	    if args.test_subset and args.test_subset < len(test_dataset):
   354	        idx = np.random.RandomState(args.seed).permutation(len(test_dataset))[: args.test_subset]
   355	        test_dataset = Subset(test_dataset, sorted(idx.tolist()))
   356	    print(f'train samples: {len(train_dataset)}  test samples: {len(test_dataset)}', flush=True)
   357	
   358	    loader_kwargs = dict(num_workers=args.num_workers, pin_memory=True,
   359	                         worker_init_fn=trainer.seed_worker,
   360	                         persistent_workers=args.num_workers > 0)
   361	    train_loader = DataLoader(train_dataset, shuffle=True, batch_size=args.batch_size,
   362	                              **loader_kwargs)
   363	    test_loader = DataLoader(test_dataset, shuffle=False, batch_size=args.batch_size,
   364	                             **loader_kwargs)
   365	    args.train_batches_per_epoch = len(train_loader)
   366	    check_counter(args, args.train_batches_per_epoch)
   367	    args.env = {key: os.environ.get(key) for key in ENV_KEYS}
   368	    model = build_model_exp11(args).cuda()
   369	
   370	    destination = args.provenance_out if args.no_save else os.path.join(args.save_dir,
   371	                                                                        'provenance.json')
   372	    root = exp06_train.resolve_data_root()
   373	    fields = provenance_fields(
   374	        command, args.run_type,
   375	        identity=exp06_train.data_identity(root) if destination else None,
   376	        geometry=exp06_train.geometry_identity(root) if destination else None,
   377	        heldout=exp06_train.heldout_wav_identity(root) if destination else None,
   378	        approved=args.approved, reviewed_commit=args.reviewed_commit,
   379	        exploratory=args.exploratory)
   380	    prepare_args(args, model, fields, destination)
   381	    fields['effective_args'] = vars(args)
   382	    if destination:
   383	        # The attempt directory is the launcher's, and it is this run's proof that a
   384	        # launch is in progress; recreating it would undo a resolution (close review 8).
   385	        if not args.no_save and not os.path.isdir(args.save_dir):
   386	            refuse('{} vanished while this trainer was starting'.format(args.save_dir))
   387	        provenance.write_manifest(destination, fields)  # exclusive; an attempt writes once
   388	    print('XRIR_RUNTIME_ARGS ' + json.dumps(vars(args), sort_keys=True, allow_nan=False),
   389	          flush=True)
   390	    if not args.no_save:
   430	    fi
   431	    say "TOMBSTONE $root/$name.resolved"
   432	    say "ABORT $attempt -> ${attempt}_ABORTED_unregistered"
   433	    if [ "$DRY" -eq 0 ]; then
   434	        # Written BEFORE the rename, and never removed by anything here: a trainer that
   435	        # wakes after this can no longer find its directory, and if it somehow can, this
   436	        # is what tells it the launch was answered. The scan ignores it -- it is a
   437	        # record, not a claim (close review 8, blocker 2).
   438	        printf 'resolved-by %s\nat %s\nreason unregistered launch: no complete child.pid\n' \
   439	            "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" > "$root/$name.resolved"
   440	        mv -- "$attempt" "${attempt}_ABORTED_unregistered"
   441	        # The marker has been answered; leaving it would close the arm for good, since
   442	        # the scan reads every attempt_* directory, retired ones included.
   443	        rm -f -- "${attempt}_ABORTED_unregistered/launching"
   444	    fi
   445	    exec {reg_fd}>&-   # the whole critical section is done: scan, tombstone, rename
   446	    say "RESOLVED $attempt registered no child and nothing of it is alive;" \
   447	        "it can never be published"
   448	}
   449	
   450	# A deterministic pause, so a regression can hold this invocation open between two
   451	# launchers. It exists only inside the test roots and costs a real launch nothing.
   452	scan_barrier() {
   453	    local file="${EXP11_SCAN_BARRIER:-}"
   454	    [ -n "$file" ] && [ "${EXP11_TEST_ROOTS:-0}" = 1 ] || return 0
   455	    : > "$file.at"
   456	    while [ -e "$file" ]; do sleep 0.05; done
   457	}
   458	
   459	# A signal handler must END this invocation. A cleanup-only handler returns, and bash
   460	# resumes -- which would let finalization and promotion continue after the interruption.
   461	# The lock needs no releasing here: the EXIT trap ends the holder, and if anything went
   462	# wrong with that the lease ends it within a second anyway.
   463	on_signal() {  # on_signal <NAME> <number>
   464	    INTERRUPTED=1
   465	    say "SIGNAL $1"
   466	    exit $((128 + $2))
   467	}
   468	
   469	# Checked before every protected step, so nothing runs after a handler has fired even if
   470	# some future caller swallows the exit.
   471	not_interrupted() {
   472	    [ "$INTERRUPTED" -eq 0 ] && return 0
   473	    echo "refusing: a signal handler has fired; this invocation does not continue" >&2
   474	    return 1
   475	}
   476	
   477	# published_target: what `final` resolves to under this arm root, or nothing.
   478	published_target() {
   479	    [ -L "$ARM_ROOT/final" ] || return 1
   480	    readlink -f -- "$ARM_ROOT/final"
   481	}
   482	
   483	# already_published <canonical>: this attempt is the published one and it completed.
   484	already_published() {
   485	    local target
   486	    target="$(published_target)" || return 1
   487	    [ "$target" = "$1" ] && [ -f "$1/completion.json" ]
   488	}
   489	
   490	# check_final_conflict <canonical>: a DIFFERENT existing `final` is never replaced by a
   491	# recovery unless the operator asks for it, and the replaced target is logged first.
   492	check_final_conflict() {
   493	    local target
   494	    target="$(published_target)" || return 0
   495	    [ "$target" != "$1" ] || return 0
   496	    if [ "$REPLACE_FINAL" -eq 0 ]; then
   497	        echo "refusing: $ARM_ROOT/final already publishes $target, not $1; pass" \
   498	             "--replace-final to replace it" >&2
   499	        return 1
   500	    fi
   501	    say "REPLACING $ARM_ROOT/final -> $(basename -- "$target") with $(basename -- "$1")"
   502	}
   503	
   504	# abort_recovery <canonical> <log>: the abort path of a REFUSED recovery. A malformed
   505	# invocation does not establish that a finished run failed, so an attempt that is
   506	# already published or already completed is left exactly as it is -- directory,
   507	# completion and `final` untouched -- and the finalizer's own cause stands on stderr.
   508	# Full mode keeps aborting unconditionally: it launched the attempt it is aborting.
   509	abort_recovery() {
   510	    local canonical="$1" log="$2" why=""
   511	    [ -f "$canonical/completion.json" ] && why="it has completed"
   512	    [ "$(published_target || true)" != "$canonical" ] || why="it is published as final"
   513	    if [ -n "$why" ]; then
   514	        say "PRESERVED $canonical ($why); the refusal is this invocation's, not the run's"
   515	        return 0
   516	    fi
   517	    abort "$canonical" "$log" finalize_refused
   518	}
   519	
   520	# diagnostic <kind> <run dir> <log> <receipt> <entry argv...>: one enumerated diagnostic
   521	# kind through the same lifecycle as a confirmatory child, finalized as exp11_smoke and
   522	# never admissible as an arm.
   523	diagnostic() {
   524	    local kind="$1" dir="$2" log="$3" receipt="$4"
   525	    shift 4
   526	    local flags=(--kind "$kind" --receipt "$receipt" --provenance-out "$dir/provenance.json"
   527	                 --approved "$APPROVED" --reviewed-commit "$COMMIT")
   528	    [ "${EXPLORATORY:-0}" -eq 0 ] || flags+=(--exploratory)
   529	    local cmd=("$PYTHON" tools/exp11_smoke.py "${flags[@]}" "$@")
   530	    say "MKDIR $dir"
   531	    say "SINK cat >> $log"
   532	    say "PIDFILE $dir/launch.pid"
   533	    say "RUN nohup setsid ${cmd[*]}"
   534	    if [ "$DRY" -eq 1 ]; then
   535	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   536	        finalize "$dir" "$log" '<code>' exp11_smoke "$receipt"
   537	        return 0
   538	    fi
   539	    mkdir -p -- "$(dirname -- "$dir")" "$RECORD"
   540	    mkdir -- "$dir"      # exclusive: a repeated stamp must not reuse a diagnostic run
   541	    own_launch "$dir"
   542	    : > "$log"
   543	    run_child "$dir" "$log" "${cmd[@]}"
   544	    close_child "$dir" "$log"
   545	    if ! finalize "$dir" "$log" "$CHILD_STATUS" exp11_smoke "$receipt"; then
   546	        abort "$dir" "$log" finalize_refused
   547	        exit 2
   548	    fi
   549	    if [ "$CHILD_STATUS" -ne 0 ]; then
   550	        abort "$dir" "$log" "child_failed_$CHILD_STATUS"
   551	        exit "$CHILD_STATUS"
   552	    fi
   553	}
   554	
   555	# The sourced library already resolved APPROVED to exp_06's record, so exp_11's default
   556	# is assigned unconditionally; EXP11_APPROVED (or --approved) overrides it.
   557	APPROVED="${EXP11_APPROVED:-$APPROVED_DEFAULT}"
   558	COMMIT="${COMMIT:-}"
   559	EXPLORATORY="${EXPLORATORY:-0}"
   560	ARM_ROOT="${ARM_ROOT:-$SIMPOR_ROOT}"
   561	CANONICAL_ATTEMPT="${CANONICAL_ATTEMPT:-}"
   562	INTERRUPTED="${INTERRUPTED:-0}"
   563	REPLACE_FINAL="${REPLACE_FINAL:-0}"
   564	RESOLVE_UNREGISTERED="${RESOLVE_UNREGISTERED:-}"
   565	DRY="${DRY:-0}"
   566	ARM="${ARM:-H}"
   567	
   568	if [ "${EXP11_LAUNCH_LIB:-0}" = 1 ]; then return 0; fi
   569	
   570	MODE="${1:-}"
   571	shift || true
   572	case "$MODE" in smoke|probe|full|finalize) ;; *) usage ;; esac
   573	GPU=""; COMMIT=""; ATTEMPT=""; LOG=""; CHILD_EXIT=""; DRY=0; ARM=H
   574	RESOLVE_UNREGISTERED=""
   575	while [ $# -gt 0 ]; do
   576	    case "$1" in
   577	        --arm) ARM="${2:-}"; shift 2 ;;
   578	        --gpu) GPU="${2:-}"; shift 2 ;;
   579	        --reviewed-commit) COMMIT="${2:-}"; shift 2 ;;
   580	        --attempt) ATTEMPT="${2:-}"; shift 2 ;;
   581	        --log) LOG="${2:-}"; shift 2 ;;
   582	        --child-exit) CHILD_EXIT="${2:-}"; shift 2 ;;
   583	        --approved) APPROVED="${2:-}"; shift 2 ;;
   584	        --exploratory) EXPLORATORY=1; shift ;;
   585	        --replace-final) REPLACE_FINAL=1; shift ;;
   586	        --resolve-unregistered) RESOLVE_UNREGISTERED="${2:-}"; shift 2 ;;
   587	        --dry-run) DRY=1; shift ;;
   588	        *) usage ;;
   589	    esac
   590	done
   591	[ -n "$GPU" ] && [ -n "$COMMIT" ] || usage
   592	apply_root_override || exit 2
   593	arm_of "$ARM" || exit 2
   594	check_ceiling || exit 2
   595	[ "$MODE" != finalize ] || [ -n "$RESOLVE_UNREGISTERED" ] \
   596	    || { [ -n "$ATTEMPT" ] && [ -n "$LOG" ] && [ -n "$CHILD_EXIT" ]; } || usage
   597	
   598	if [ "$DRY" -eq 1 ]; then STAMP='<UTC>'; else STAMP="$(date -u +%Y%m%dT%H%M%S)"; fi
   599	if [ "$MODE" = finalize ]; then OWNER=""        # recovery owns no live launch.pid
   600	elif [ "$DRY" -eq 1 ]; then OWNER='<pid>'
   601	else OWNER="$$"; fi
   602	
   603	say "EXP11_LAUNCH mode=$MODE arm=$ARM gpu=$GPU commit=$COMMIT root=$ARM_ROOT stamp=$STAMP dry_run=$DRY"
   604	say "ENV CUDA_VISIBLE_DEVICES=$GPU PYTHONHASHSEED=0 OMP_NUM_THREADS=8 XRIR_DATA_PATH=$DATA_ROOT"
   605	if [ "$DRY" -eq 0 ] && [ ! -d "$DATA_ROOT" ]; then
   606	    echo "refusing: XRIR_DATA_PATH $DATA_ROOT is not a directory" >&2
   607	    exit 2
   608	fi
   609	export XRIR_DATA_PATH="$DATA_ROOT"
   610	CHILD_EXPLORATORY=()
   611	[ "$EXPLORATORY" -eq 0 ] || CHILD_EXPLORATORY=(--exploratory)
   612	
   613	case "$MODE" in
   614	full)
   615	    scan_barrier
   616	    # From before the child launch through promotion: a recovery on this arm is refused
   617	    # while this run owns it. The arm-wide scan runs under the lock, never before it.
   618	    hold_arm_lock full || exit 2
   619	    require_quiet_arm || exit 2
   620	    preflight
   621	    attempt="$ARM_ROOT/attempt_$STAMP"
   622	    log="$RECORD/orientation_cue_fairness_${STAMP}_train_full_${ARM}.log"
   623	    say "MKDIR $attempt"
   624	    say "SINK cat >> $log"
   625	    say "PIDFILE $attempt/launch.pid"
   626	    say "CEILING ${FULL_CEILING_S}s"
   627	    child=(timeout --kill-after=60 "$FULL_CEILING_S"
   628	           "$PYTHON" tools/exp11_train.py --backbone "$ARM_BACKBONE" --save-dir "$attempt"
   629	           --num-shot 8 --max-len 9600 --lr 1e-3 --weight-decay 1e-4 --decay-epochs 3
   630	           --lr-gamma 0.1 --epochs 12 --batch-size 32 --accum-steps 2 --num-workers 12
   631	           --seed 0 --tf32 --log-interval 50 --save-every "$ARM_SAVE_EVERY"
   632	           --epoch-ckpt-every 1 --yaw-aug "$ARM_YAW" --yaw-aug-seed 0 --yaw-aug-width 512
   633	           --run-type full --approved "$APPROVED" --reviewed-commit "$COMMIT")
   634	    say "RUN nohup setsid ${child[*]}"
   635	    if [ "$DRY" -eq 1 ]; then
   636	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   637	        abort "$attempt" "$log" 'child_exit_<code>'
   638	        finalize "$attempt" "$log" '<code>' exp11_train
   639	        promote "attempt_$STAMP"
   640	        exit 0
   641	    fi
   642	    mkdir -p -- "$ARM_ROOT"
   643	    mkdir -- "$attempt"   # exclusive: a repeated stamp must not reuse an attempt
   644	    own_launch "$attempt"
