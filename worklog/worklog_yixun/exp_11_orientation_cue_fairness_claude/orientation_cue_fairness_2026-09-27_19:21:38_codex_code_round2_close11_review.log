   332	# --- the intent marker: the half-second the frozen lifecycle cannot cover -----------
   333	# `run_child` forks the detached trainer and writes child.pid only afterwards, and the
   334	# trainer needs a moment to write its own. A launcher that dies inside that window would
   335	# leave a running trainer nothing names. So the intent to launch is declared BEFORE the
   336	# fork and withdrawn only once the TRAINER is accounted for -- a complete child.pid and a
   337	# train.exit. `child.pid` holds the timeout wrapper's pid, so its death says nothing about
   338	# the trainer (close review 10). A marker left behind means "a trainer of this attempt may
   339	# be running, or died without saying so", and the arm stays closed until an operator
   340	# resolves it: a trainer that crashes before registering fails closed, by design.
   341	mark_launching() {  # mark_launching <attempt>
   342	    printf 'launcher %s\nat %s\narm %s\n' \
   343	        "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$ARM" > "$1/launching"
   344	}
   345	
   346	clear_launching() {  # clear_launching <attempt>: only once the TRAINER is accounted for
   347	    # This runs after run_child returns, so the wrapper and the sink are gone. A complete
   348	    # child.pid proves the wrapper was recorded; train.exit proves the trainer itself
   349	    # finished. A trainer that crashed before registering leaves the marker standing and
   350	    # the attempt unresolved -- fail closed, by design: the operator answers it.
   351	    registration_complete "$1" || return 0
   352	    [ -f "$1/train.exit" ] || return 0
   353	    rm -f -- "$1/launching"
   354	}
