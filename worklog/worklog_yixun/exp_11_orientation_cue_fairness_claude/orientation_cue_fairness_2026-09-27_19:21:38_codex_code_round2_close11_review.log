   320	    done
   321	    return 0
   322	}
   323	
   324	require_quiet_arm() {  # require_quiet_arm [<attempt being resolved>]
   325	    say "SCAN $ARM_ROOT"
   326	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   327	    scan_arm "$ARM_ROOT" "${1:-}" && return 0
   328	    echo "refusing: $SCAN_REASON" >&2
   329	    return 1
   330	}
