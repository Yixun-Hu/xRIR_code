   356	# resolve_unregistered <attempt>: an operator's explicit answer to a marker nothing can
   357	# explain any more. It can only ever abort: an attempt with no child.pid has no exit
   358	# receipt and can never be published.
   359	resolve_unregistered() {
   360	    local attempt="" root="" name="" now=0 stamp=0 age=0
   361	    # Identity is the canonical directory, never the spelling: an operator's path may be
   362	    # absolute where the root is relative, or reach the arm through a symlink.
   363	    [ -d "$1" ] || { echo "refusing: $1 is not a directory" >&2; return 1; }
   364	    attempt="$(realpath -- "$1")" || return 1
   365	    root="$(realpath -- "$ARM_ROOT")" || return 1
   366	    name="$(basename -- "$attempt")"
   367	    # The lock and the scan are this arm's, so the resolution reaches no further.
   368	    if [ "$(dirname -- "$attempt")" != "$root" ]; then
   369	        echo "refusing: $attempt is not an attempt of the selected arm ($root); this" \
   370	             "invocation locked and scanned that arm and no other" >&2
   371	        return 1
   372	    fi
   373	    case "$name" in
   374	        attempt_*) case "${name#attempt_}" in ''|*[!0-9T]*)
   375	            echo "refusing: $name is not an attempt directory of this arm" >&2
   376	            return 1 ;; esac ;;
   377	        *) echo "refusing: $name is not an attempt directory of this arm" >&2
   378	           return 1 ;;
   379	    esac
   380	    [ -f "$attempt/launching" ] || {
   381	        echo "refusing: $attempt has no launching marker; nothing is unresolved" >&2
   382	        return 1; }
   383	    # NOT "child.pid is complete": that file holds the `timeout` wrapper's pid, and a
   384	    # wrapper that died with its trainer unregistered is precisely the state the scan
   385	    # now calls unresolved (close review 10, blocker 2). Refusing on it would leave the
   386	    # arm shut for good -- closed by the scan, unanswerable by the operator. What may
   387	    # never be retired this way is a run that actually finished: a completion receipt,
   388	    # or the published `final`. Everything else is decided by the quiet scan below --
   389	    # nothing of the arm alive -- and by the marker's age.
   390	    if [ -f "$attempt/completion.json" ]; then
   391	        echo "refusing: $attempt has a completion receipt; it is a finished run, not an" \
   392	             "unresolved launch" >&2
   393	        return 1
   394	    fi
   395	    if [ "$(published_target || true)" = "$attempt" ]; then
   396	        echo "refusing: $attempt is published as $ARM_ROOT/final; a published attempt is" \
   397	             "never retired as an unresolved launch" >&2
   398	        return 1
   399	    fi
   400	    # The REGISTRATION lock, distinct from the publication lock this invocation already
   401	    # holds: a full-mode launcher holds the publication lock for its child's whole run,
   402	    # so a trainer could never take that one. This one is held only across a
   403	    # registration and across this resolution -- exactly the pair that must not
   404	    # interleave, because the trainer's checks and its write straddle the rename below
   405	    # (close review 9, blocker 2). The recovery and full-mode scans do not take it: an
   406	    # in-flight registration is already covered there by the launching marker or by a
   407	    # complete live child.pid, and a recovery that had to queue behind every trainer
   408	    # would be a new way to stall an arm.
   409	    local registration="$root/.registration.lock" reg_fd=""
   410	    : >> "$registration" 2>/dev/null || true
   411	    exec {reg_fd}>>"$registration" || {
   412	        echo "refusing: cannot open the registration lock $registration" >&2; return 1; }
