  1657	def render_exp11(result):
  1658	    """exp_11's blocks: each registered statement under the contrast whose direction it
  1659	    names, the three declared screen families, and the copied historical rows."""
  1660	    lines = []
  1661	    for name in result['decisions']:
  1662	        cell = result[name]
  1663	        lines.append('\n{} {} {} {}: diff {}, two-way {}, cohort {}/{} -> {}'.format(
  1664	            name, cell['contrast'], cell['room'], cell['metric'], _number(cell['diff']),
  1665	            _bounds(cell['two_way']), cell['cohort'], cell['n_test'], cell['status']))
  1666	        for field in cell['fields']:
  1667	            lines.append('  {}: {}'.format(
  1668	                field, UNAVAILABLE if cell[field] is None else cell[field]))
  1669	        if cell['margin'] is not None:
  1670	            lines.append('  margin: {} dB'.format(cell['margin']))
  1671	        lines.append('  reading: {}'.format(cell['reading']))
  1672	        lines.extend('  void: ' + reason for reason in cell['void_reasons'])
  1673	    for name in result['screens']:
  1674	        cells = result['screens'][name]
