   142	def flat_rows(difference=1.0, cohort=2, n_test=2, arms_of=(G, D)):
   143	    """Rows whose paired difference is the same in every row: a zero-width interval."""
   144	    size = cohort * len(subject.SEEDS)
   145	    return {'a': np.full(size, difference), 'b': np.zeros(size),
   146	            'clusters': np.asarray(list(range(cohort)) * len(subject.SEEDS)),
   147	            'seeds': np.asarray([seed for seed in subject.SEEDS for _ in range(cohort)]),
   148	            'cohort': cohort, 'n_test': n_test,
   149	            'per_seed_diff': {seed: difference for seed in subject.SEEDS},
   150	            'excluded': {arm: {'queries': 0, 'seeds': {seed: 0 for seed in subject.SEEDS}}
   151	                         for arm in arms_of}}
