   718	
   719	def verify_job(job_dir, job, arm, repo=REPO, sensitivity=False, inputs=None):
   720	    """Finding 2: the finalizer's own verifiers, re-run over every child of one job.
   721	
   722	    Nothing here is taken from the completion: the job specification it bound is re-read
   723	    and rehashed, ``verify_child`` re-runs each child's role validator over the directory
   724	    and compares every field of its record with that result, ``job_lineage`` re-derives
   725	    the init -> stage1 -> stage2 -> evaluation chain, and the job's own lineage fields
   726	    must equal what the re-run derived. The frozen protocol and the DiffRIR indices are
   727	    checked on top, because the finalizer knows nothing about exp_02's protocol.
   728	    """
   729	    job_dir, expect = Path(job_dir), EXPECT_OF[job]
   730	    record = job_completion(job_dir, expect, arm, inputs)
   731	    owner = job_owner(job_dir, record, inputs)
   732	    recipe = []
   733	    if inputs is not None and isinstance(record.get('log'), dict):
   734	        bind(inputs, record['log']['path'], record['log']['sha256'])
   735	    spec_path = Path(record['job_spec']['path'])
   736	    _require(spec_path.is_file(), 'missing job spec {}'.format(spec_path))
   737	    declared = record['job_spec']['sha256']
   738	    _require(provenance.sha256_file(spec_path) == declared,
   739	             'the job spec {} is not the bytes job {} bound'.format(spec_path, job_dir))
   740	    if inputs is not None:      # bound before the loader runs, never after it
   741	        bind(inputs, spec_path, declared)
   742	    spec = finalizer.load_job_spec(str(spec_path), expect)
   743	    # Finding 2b: the loader hashes what it read; that digest must still be the one the
   744	    # job certified, so a spec edited while it was being loaded is refused here.
   745	    _require(spec['job_spec_sha256'] == declared,
   746	             'the job spec {} is not the bytes job {} bound'.format(spec_path, job_dir))
   747	    children, rooms = {}, {}
   748	    for name in sorted(finalizer.expected_children(expect)):
   749	        path, role = job_dir / name, finalizer.child_role(name)
   750	        completion = path / 'completion.json'
   751	        _require(completion.is_file(),
   752	                 'job {} child {} has no completion.json'.format(job_dir, name))
   753	        certified = record['children'][name]
   754	        _require(provenance.sha256_file(completion) == certified,
   755	                 'job {} child {} is not the completion it bound'.format(job_dir, name))
   756	        if inputs is not None:      # bound before the child validator is delegated to
   757	            bind(inputs, completion, certified)
   758	        evidence = dict(finalizer.verify_child(path, name, repo, spec), role=role)
   759	        bound = _read_json(completion, name + '/completion.json', inputs, certified)
   760	        _require(bound.get('admissible_arm') is True,
   761	                 'child {} is not an admissible arm'.format(name))
   762	        args = _read_json(path / 'args.json', name + '/args.json', inputs)
   763	        child_protocol(args, name, role)
   764	        recipe.extend(child_recipe(args, name, role))
   765	        bind_child(inputs, path, evidence, bound, args, repo)
   766	        if role == 'haa_eval':
   767	            per = child_per_sample(job_dir, name, bound, arm, inputs)
   768	            check_test_indices(name, evidence['room'], per['index'])
   769	            _require(finalizer.exp06_recipe.strict_equal(per['meta'].get('heading'),
   770	                                                         args.get('heading')),
   771	                     'child {} per-sample meta heading is not the one its arguments '
   772	                     'bound'.format(name))
   773	            rooms[evidence['room']] = per
   774	        children[name] = evidence
   775	    lineage = finalizer.job_lineage(children, expect, spec)
   776	    for field in sorted(lineage):
   777	        _require(finalizer.exp06_recipe.strict_equal(record.get(field), lineage[field]),
   778	                 'job {} records {} {!r}, not the {!r} the re-run derived'.format(
   779	                     job_dir, field, record.get(field), lineage[field]))
   780	    _require(set(rooms) == set(ROOMS),
   781	             'the job {} evaluated {}'.format(job_dir, sorted(rooms)))
   782	    _require(sensitivity or not recipe,
   783	             'job {} did not run the registered recipe of plan 6.2: {}'.format(
   784	                 job_dir, '; '.join(recipe)))
   785	    return {'record': record, 'spec': spec, 'children': children, 'per': rooms,
   786	            'owner': owner, 'closure': arm_closures(children),
   787	            'heading': arm_headings(children), 'recipe_deviations': recipe}
   788	
   789	
   790	def arm_directory(arm, roots):
   791	    """One new arm's directory: its own registered root, under its own experiment's tree.
   792	
   793	    ``ARMS[arm]['root']`` is where the arm was registered; ``roots`` maps an experiment to
   794	    the tree its arms were actually written in (``--new-root``, ``--exp09-root``), so an
   795	    arm is never looked for under another experiment's root.
   796	    """
   797	    return Path(roots[ARMS[arm]['experiment']]) / Path(ARMS[arm]['root']).name
   798	
   799	
   800	def load_new_arm(roots, arm, init_sha256=None, repo=REPO, approved=None,
   801	                 sensitivity=False):
   802	    """One exp_06 or exp_09 arm: four verified jobs, one closure per role, one heading
   803	    per room in the heading frame and none at all in the room frame."""
   804	    base = arm_directory(arm, roots)
   805	    _require(base.is_dir(), 'missing arm directory {}'.format(base))
   806	    jobs, records, children, inputs, recipe = {}, {}, {}, {}, []
   807	    for job in JOBS:
   808	        job_dir = base / job
   809	        _require(job_dir.is_dir(), 'the arm {} has no job {}'.format(arm, job))
   810	        verified = verify_job(job_dir, job, arm, repo, sensitivity, inputs)
   811	        recipe.extend('{} {}: {}'.format(arm, job, item)
   812	                      for item in verified['recipe_deviations'])
   813	        record = verified['record']
   814	        _require(init_sha256 is None or record['init_sha256'] == init_sha256,
   815	                 'the arm {} job {} did not start from the registered initialisation '
   816	                 '{}'.format(arm, job, init_sha256))
   817	        _require(job not in SEEDS or record['seed'] == int(job[len('seed'):]),
   818	                 'the arm {} job {} records seed {!r}'.format(arm, job, record['seed']))
   819	        jobs[job], records[job] = verified['per'], record
   820	        for name in sorted(record['children']):
   821	            children['{}/{}'.format(job, name)] = verified['children'][name]
   822	    closures, headings = arm_closures(children), arm_headings(children)
   823	    _require(bool(headings) == (ARMS[arm]['frame'] == 'heading'),
   824	             'the {}-frame arm {} binds {} heading records'.format(
   825	                 ARMS[arm]['frame'], arm, len(headings)))
   826	    check_arm_identities(arm, closures, headings, approved)
   827	    return {'arm': arm, 'branch': 'new', 'per': jobs, 'closure': closures, 'jobs': records,
   828	            'heading': headings, 'root': str(base), 'inputs': inputs,
   829	            'recipe_deviations': recipe}
