   699	def bind_child(inputs, path, evidence, bound, args, repo):
   700	    """Finding 2: every file one child's certification rests on, with the bytes the
   701	    finalizer's own validators just re-hashed -- artefacts, log, exit receipt, the
   702	    heading records it read, the weights it started from or evaluated, and (finding 2a)
   703	    the data, source and mutable inputs its provenance declares."""
   704	    if inputs is None:
   705	        return
   706	    for name, digest in sorted((evidence.get('artifacts') or {}).items()):
   707	        bind(inputs, Path(path) / name, digest)
   708	    child_dependencies(inputs, path, evidence, repo)
   709	    for key in ('log', 'child_exit_receipt'):
   710	        binding = bound.get(key) or {}
   711	        bind(inputs, finalizer._resolve(binding['path'], repo), binding['sha256'])
   712	    for room, entry in sorted((evidence.get('heading') or {}).items()):
   713	        bind(inputs, finalizer._resolve(entry['path'], repo), entry['sha256'])
   714	    for field, key in (('init', 'init_sha256'), ('checkpoint', 'checkpoint_sha256')):
   715	        if key in evidence and args.get(field):
   716	            bind(inputs, finalizer._resolve(args[field], repo), evidence[key])
