   637	def child_per_sample(job_dir, name, record, arm, inputs=None):
   638	    """One evaluation child's per-sample file, with the fields the summariser reads."""
   639	    path = Path(job_dir) / name
   640	    names = sorted(key for key in record['artifacts'] if key.startswith('per_sample_'))
   641	    _require(len(names) == 1, 'child {} bound {} per-sample files'.format(name, len(names)))
   642	    per = _read_json(path / names[0], names[0], inputs)
   643	    meta = per.get('meta')
   644	    _require(isinstance(meta, dict), 'child {} per-sample records no meta'.format(name))
   645	    _require('heading' in meta, 'child {} per-sample meta records no heading'.format(name))
   646	    _require(meta.get('frame') == ARMS[arm]['frame'], 'child {} per-sample meta records the '
   647	             'frame {!r}, not the {!r} of arm {}'.format(name, meta.get('frame'),
   648	                                                         ARMS[arm]['frame'], arm))
   649	    if ARMS[arm]['frame'] == 'heading':
   650	        _heading_rolls(meta['heading'], 'child {} per-sample meta'.format(name))
   651	    else:      # a room-frame arm reads no heading, and the writer records that null
   652	        _require(not meta['heading'],
   653	                 'child {} per-sample meta records a heading in the room frame'.format(name))
   654	    side = per.get('side_label')
   655	    _require(isinstance(side, list) and len(side) == len(per.get('index', [])),
   656	             'child {} per-sample records no room-frame side_label'.format(name))
   657	    _require(all(value in (-1, 1) and not isinstance(value, bool) for value in side),
   658	             'child {} side labels are not the room-frame signs'.format(name))
   659	    return per
