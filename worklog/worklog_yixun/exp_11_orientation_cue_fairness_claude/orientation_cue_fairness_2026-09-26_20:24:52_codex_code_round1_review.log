   201	# --- N1i: the four-arm interaction (G - E) - (D - A) -------------------------------------
   202	
   203	QUAD = (G, E, D, A)
   204	N1I = {'name': 'N1i', 'kind': 'interaction', 'arms': QUAD, 'room': 'hallway',
   205	       'metric': 'c50', 'margin': None, 'fields': ('category',),
