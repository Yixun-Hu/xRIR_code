   536	def check_arm_identities(arm, closures, headings, approved):
   537	    """Finding 3: what really ran, against what section 6.4 approved -- not merely null."""
   538	    if approved is None:
   539	        return
   540	    code = approved['code']
   541	    for role in sorted(closures):
   542	        key = ROLE_CODE_KEY[role]
   543	        _require(code.get(key) == closures[role], 'the {} children of {} ran the closure {}, '
   544	                 'not the approved code.{} {}'.format(role, arm, closures[role], key,
   545	                                                      code.get(key)))
   546	    pinned = approved['artifacts']['heading']
   547	    for room in sorted(headings):
   548	        _require(pinned.get(room) == headings[room], 'the arm {} read the {} heading record '
   549	                 '{}, not the approved artifacts.heading.{} {}'.format(
   550	                     arm, room, headings[room], room, pinned.get(room)))
