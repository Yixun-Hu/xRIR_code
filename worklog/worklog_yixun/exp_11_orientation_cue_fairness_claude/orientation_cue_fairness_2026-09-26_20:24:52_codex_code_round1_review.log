   479	        _require(_is_sha256(entry.get('sha256')) and isinstance(entry.get('path'), str)
   480	                 and entry['path'], '{} records no json identity for {}: the finalizer '
   481	                 'binds the heading record a child read'.format(label, room))
   482	    return {room: heading[room]['k'] for room in heading}
