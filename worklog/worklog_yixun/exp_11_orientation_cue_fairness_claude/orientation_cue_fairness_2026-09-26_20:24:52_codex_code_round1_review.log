  1802	                                                            args.exploratory)
  1803	    if args.write_legacy_receipt:      # finding 3: the receipt is a producer, and gated
  1804	        record, digest = write_legacy_receipt(args.write_legacy_receipt, args.legacy_root,
  1805	                                              strict=not args.exploratory, identity=identity)
  1806	        print(json.dumps({'receipt': str(args.write_legacy_receipt), 'sha256': digest,
  1807	                          'files': len(record['files']), 'label': record['label']}))
  1808	        return 0
  1809	    _require(args.json and args.summary, 'both --json and --summary are required')
  1810	    check_output_paths(args.experiment, args.json, args.summary)
  1811	    config = EXPERIMENTS[args.experiment]
  1812	    roots = {'exp06': args.new_root, 'exp09': args.exp09_root,
  1813	             'exp11': args.exp11_root}
  1814	    new_arms = tuple(arm for arm in config['arms'] if ARMS[arm]['branch'] == 'new')
  1815	    binding = approved['reused']['legacy_receipt'] if approved else None
  1816	    if binding is not None and binding.get('sha256') is None:
  1817	        binding = None
  1818	    arms, receipt = load_legacy(args.legacy_root, args.legacy_receipt, binding)
  1819	    extra = check_reused_identities(None if args.exploratory else approved, receipt,
  1820	                                    args.gate_g1)
  1821	    inits = ({} if args.exploratory
  1822	             else expected_inits(approved, new_arms, extra))
  1823	    for arm in new_arms:
  1824	        arms[arm] = load_new_arm(roots, arm, inits.get(arm), REPO,
  1825	                                 None if args.exploratory else approved, args.sensitivity)
  1826	        deviations = deviations + list(arms[arm].get('recipe_deviations') or ())
  1827	    result = analyse(arms, args.n_boot, args.n_boot_adjusted, args.cache_root,
  1828	                     args.exploratory, receipt, args.legacy_receipt, approved, deviations,
  1829	                     approvals_receipt, identity, extra, args.sensitivity, args.experiment)
  1830	    record, digest, text = write_outputs(result, args.json, args.summary)
  1831	    print(text)
  1832	    published = {'json': args.json, 'sha256': digest,
  1833	                 'summary_sha256': record['summary_sha256']}
  1834	    if args.experiment != 'exp06':     # exp_06 prints the keys it has always printed
