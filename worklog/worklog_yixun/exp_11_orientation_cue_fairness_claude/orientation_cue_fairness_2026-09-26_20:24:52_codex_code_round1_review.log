  1794	def main(argv=None):
  1795	    """0 on success; a refusal exits 1 and an argparse usage error exits 2."""
  1796	    args = build_parser().parse_args(argv)
  1797	    producer = 'legacy_receipt' if args.write_legacy_receipt else 'summarize_haa'
  1798	    approved, approvals_receipt, deviations = approvals(args.exploratory, args.approved,
  1799	                                                        producer, args.approved_commit)
