   900	# --- the intervals and the verdicts ------------------------------------------------------
   901	
   902	
   903	def intervals(rows, alpha, n_boot, seed=BOOT_SEEDS[0]):
   904	    """The paired intervals, or ``None`` when the cohort the policy voided is empty."""
   905	    if not rows['cohort']:
   906	        return None
   907	    return bootstrap.paired_intervals(rows['a'], rows['b'], rows['clusters'], rows['seeds'],
   908	                                      alpha=alpha, n_boot=n_boot, seed=seed)
   909	
   910	
   911	def converged_two_way(rows, alpha, n_boot):
   912	    """The verdict-bearing interval, checked and quadrupled once by exp_06's bootstrap."""
   913	    def factory(size):
   914	        def interval(seed):
   915	            return intervals(rows, alpha, size, seed)['two_way']
   916	        return interval
   917	    return bootstrap.converged_interval(factory, n_boot=n_boot, seed_a=BOOT_SEEDS[0],
   918	                                        seed_b=BOOT_SEEDS[1], tol=CONVERGENCE_TOL)
   919	
   920	
   921	def verdict_of(convergence, void, margin):
   922	    """pass / fail / void / not_converged, in that order of precedence."""
   923	    if void:
   924	        return 'void'
   925	    if convergence['status'] != 'converged':
   926	        return 'not_converged'
   927	    return 'pass' if convergence['interval'][1] < margin else 'fail'
   928	
   929	
   930	def h2_label(interval):
   931	    """A screen, never a parity claim: harm, improvement, or no detected difference."""
   932	    low, high = interval
   933	    if low > 0:
   934	        return 'detected harm'
   935	    if high < 0:
   936	        return 'detected improvement'
   937	    return 'no detected difference'
   938	
   939	
   940	def decision_cell(arms, pair, room, metric, margin, n_boot=N_BOOT, alpha=ALPHA):
   941	    """H1 or H1b: one two-way interval, the invalidity policy and the convergence gate."""
   942	    treatment, comparator = pair
   943	    rows = cell_rows(arms, treatment, comparator, room, metric)
   944	    void = void_reasons(rows, treatment, comparator)
   945	    cell = {'contrast': '{} - {}'.format(treatment, comparator), 'room': room,
   946	            'metric': metric, 'margin': margin, 'alpha': alpha,
   947	            'cohort': rows['cohort'], 'n_test': rows['n_test'], 'excluded': rows['excluded'],
