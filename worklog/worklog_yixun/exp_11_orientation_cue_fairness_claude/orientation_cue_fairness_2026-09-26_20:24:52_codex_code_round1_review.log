   208	
   209	def column(arms, arm, room='hallway', metric='c50'):
   210	    return np.stack([np.asarray(arms[arm]['per'][seed][room][metric], dtype=float)
   211	                     for seed in subject.SEEDS])
   212	
   213	
   214	def joint(arms, room='hallway', metric='c50'):
   215	    """What the assembler must produce: one mask, four arms, three seeds."""
   216	    values = {arm: column(arms, arm, room, metric) for arm in QUAD}
   217	    mask = np.ones(values[G].shape[1], dtype=bool)
   218	    for arm in QUAD:
   219	        mask &= np.isfinite(values[arm]).all(axis=0)
   220	    left = np.concatenate([(values[G][i] - values[E][i])[mask] for i in range(3)])
   221	    right = np.concatenate([(values[D][i] - values[A][i])[mask] for i in range(3)])
   222	    index = np.asarray(arms[G]['per']['seed0'][room]['index'])[mask]
   223	    clusters = np.concatenate([index] * 3)
   224	    seeds = np.concatenate([np.full(int(mask.sum()), seed) for seed in subject.SEEDS])
   225	    return left, right, clusters, seeds, mask
   226	
