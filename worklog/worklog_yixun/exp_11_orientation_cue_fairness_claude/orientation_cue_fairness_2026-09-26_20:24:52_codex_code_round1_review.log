   662	def _dependency(inputs, path, digest, label):
   663	    """One validated dependency, refused rather than bound without an identity."""
   664	    _require(_is_sha256(digest),
   665	             '{} records no validated digest for {}'.format(label, path))
   666	    bind(inputs, path, digest)
