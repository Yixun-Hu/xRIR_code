   471	def _heading_rolls(heading, label):
   472	    """Every bound room rolls by the registered column and names the JSON it came from."""
   473	    _require(isinstance(heading, dict) and heading, '{} binds no heading'.format(label))
   474	    for room in sorted(heading):
