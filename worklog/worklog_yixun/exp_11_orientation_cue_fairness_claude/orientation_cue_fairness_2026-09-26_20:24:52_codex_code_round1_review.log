   611	def expected_inits(approved, arms=NEW_ARMS, inputs=None):
   612	    """What each new arm must have started from: exp_01's weights, exp_06's approved
   613	    epoch, or -- for arms E and G -- exp_04's approved ``checkpoints.aug``.
   614	
   615	    Their identity is resolved through 6.4's ``reused`` exp_04 pin rather than a literal,
   616	    so only the approvals a reviewer committed can name it; the record it was read from is
   617	    bound into ``inputs`` and published with the analysis. It is resolved only when one of
   618	    them is among the arms being loaded, so an exp_06 run depends on nothing further, and
   619	    a registered arm with a null ``init_sha256`` is never left unchecked.
   620	    """
   621	    inits = {arm: ARMS[arm]['init_sha256'] for arm in arms
   622	             if ARMS[arm]['branch'] == 'new'}   # an experiment's arms include the legacy two
   623	    if not approved:
   624	        return inits
   625	    if 'cyl_or' in inits:
   626	        inits['cyl_or'] = approved.get('artifacts', {}).get('epoch_012', {}).get('sha256')
   627	    augmented = [arm for arm in EXP04_AUG_ARMS if arm in inits]
   628	    if augmented:      # exp_09's E and exp_11's G start from the one approved checkpoint
   629	        record = finalizer.exp04_aug_checkpoint(approved)
   630	        for arm in augmented:
   631	            inits[arm] = record['checkpoint']['sha256']
   632	        if inputs is not None:
   633	            bind(inputs, record['path'], record['sha256'])
   634	    return inits
