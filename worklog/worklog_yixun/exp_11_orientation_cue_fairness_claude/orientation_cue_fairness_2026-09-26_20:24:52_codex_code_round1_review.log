  1623	def render_decisions(result, config):
  1624	    """exp_06's and exp_09's blocks: the decisions, the screen and the descriptive
  1625	    contrasts, printed exactly as they have always been printed."""
  1626	    lines = []
  1627	    for name, *_ in config['decisions']:
  1628	        cell = result[name]
  1629	        lines.append('\n{} {} {} {}: diff {}, two-way {}, margin {}, cohort {}/{} -> '
  1630	                     '{}'.format(name, cell['contrast'], cell['room'], cell['metric'],
  1631	                                 _number(cell['diff']), _bounds(cell['two_way']),
  1632	                                 cell['margin'], cell['cohort'], cell['n_test'],
  1633	                                 cell['verdict']))
  1634	        if name in config['classified']:
  1635	            lines.append('  category: {}; non-inferior at {} dB: {}'.format(
  1636	                UNAVAILABLE if cell['category'] is None else cell['category'],
  1637	                cell['margin'], UNAVAILABLE if cell['non_inferior_at_margin'] is None
  1638	                else cell['non_inferior_at_margin']))
  1639	        lines.extend('  void: ' + reason for reason in cell['void_reasons'])
  1640	    screen, descriptive = config['screen'][0], config['descriptive'][0]
  1641	    lines.append('\n{} screen ({} cells, adjusted at alpha/{})'.format(
  1642	        screen, len(result[screen]), H2_FAMILY))
  1643	    for cell in result[screen]:
  1644	        lines.append('  {:14s} {:4s} diff {} nominal {} adjusted {} -> {}'.format(
  1645	            cell['room'], cell['metric'], _number(cell['diff']),
  1646	            _bounds(cell['nominal_two_way']),
  1647	            'not available' if cell['adjusted_two_way'] is None else cell['adjusted_two_way'],
  1648	            cell['label']))
  1649	    lines.append('\nDescriptive contrasts')
  1650	    for cell in result[descriptive]:
  1651	        lines.append('  {:22s} {:14s} {:4s} diff {} {}'.format(
  1652	            cell['contrast'], cell['room'], cell['metric'], _number(cell['diff']),
  1653	            _bounds(cell['nominal_two_way'])))
  1654	    return lines
