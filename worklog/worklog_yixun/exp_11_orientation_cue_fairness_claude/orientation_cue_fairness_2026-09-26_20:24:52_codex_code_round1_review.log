   832	# --- pairing, the finite cohort and the invalidity policy of section 7 -------------------
   833	
   834	PAIR_META = ('eval_seed', 'num_shot')
   835	
   836	
   837	def assert_pairing(a, b, label):
   838	    """exp_02's own pairing assertions: the same queries, measured the same way."""
   839	    _require(a['index'] == b['index'], 'pair {}: the query indices differ'.format(label))
   840	    _require(a['ir_path'] == b['ir_path'], 'pair {}: the ir_path entries differ'.format(label))
   841	    for key in PAIR_META:
   842	        _require(a['meta'].get(key) == b['meta'].get(key) is not None,
   843	                 'pair {}: {} {!r} != {!r}'.format(label, key, a['meta'].get(key),
   844	                                                   b['meta'].get(key)))
   845	
   846	
   847	def cell_rows(arms, x, y, room, metric):
   848	    """Paired rows pooled over the three fine-tuning seeds, on the shared finite cohort."""
   849	    columns, index = {x: [], y: []}, None
   850	    for seed in SEEDS:
   851	        for arm in (x, y):
   852	            _require(seed in arms[arm]['per'] and room in arms[arm]['per'][seed],
   853	                     'arm {} has no {} of {}'.format(arm, room, seed))
   854	        a, b = arms[x]['per'][seed][room], arms[y]['per'][seed][room]
   855	        assert_pairing(a, b, '{}-{} {} {}'.format(x, y, room, seed))
   856	        index = list(a['index']) if index is None else index
   857	        _require(list(a['index']) == index,
   858	                 'the seeds of {}/{} do not share one query order'.format(room, metric))
   859	        for arm, per in ((x, a), (y, b)):
   860	            columns[arm].append(np.asarray(per[metric], dtype=float))
   861	    stacked = {arm: np.stack(columns[arm]) for arm in (x, y)}
   862	    finite = {arm: np.isfinite(stacked[arm]).all(axis=0) for arm in (x, y)}
   863	    cohort = finite[x] & finite[y]
   864	    # Finding 8: an empty cohort is a diagnosis, not an exception -- the void rule below
   865	    # needs the exclusion counts it would otherwise never reach.
   866	    rows = {arm: np.concatenate([stacked[arm][i][cohort] for i in range(len(SEEDS))])
   867	            for arm in (x, y)}
   868	    queries = np.asarray(index)[cohort]
   869	    return {'a': rows[x], 'b': rows[y],
   870	            'clusters': np.concatenate([queries] * len(SEEDS)),
   871	            'seeds': np.concatenate([np.full(int(cohort.sum()), seed) for seed in SEEDS]),
   872	            'cohort': int(cohort.sum()), 'n_test': len(index),
   873	            'per_seed_diff': {seed: (float((stacked[x][i][cohort]
   874	                                            - stacked[y][i][cohort]).mean())
   875	                                     if cohort.any() else None)
   876	                              for i, seed in enumerate(SEEDS)},
   877	            'excluded': {arm: {'queries': int((~finite[arm]).sum()),
   878	                               'seeds': {seed: int((~np.isfinite(stacked[arm][i])).sum())
   879	                                         for i, seed in enumerate(SEEDS)}}
   880	                         for arm in (x, y)}}
   881	
   882	
   883	def void_reasons(rows, treatment, comparator):
   884	    """Section 7's invalidity policy; a void verdict is never replaced by a subset."""
   885	    excess = rows['excluded'][treatment]['queries'] - rows['excluded'][comparator]['queries']
   886	    reasons = []
   887	    if not rows['cohort']:
   888	        reasons.append('no query of the {} test split is finite in every compared '
   889	                       'run'.format(rows['n_test']))
   890	    if excess > VOID_EXCESS_FRACTION * rows['n_test']:
   891	        reasons.append('{} has {} more invalid queries than {}, above the {:.0%} of {} the '
   892	                       'policy allows'.format(treatment, excess, comparator,
   893	                                              VOID_EXCESS_FRACTION, rows['n_test']))
   894	    if rows['cohort'] < VOID_COHORT_FRACTION * rows['n_test']:
   895	        reasons.append('the cohort of {} queries is below {:.0%} of the {} in the test '
   896	                       'split'.format(rows['cohort'], VOID_COHORT_FRACTION, rows['n_test']))
   897	    return reasons
