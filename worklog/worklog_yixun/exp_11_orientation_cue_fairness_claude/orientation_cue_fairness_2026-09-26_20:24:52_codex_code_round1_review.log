   507	def arm_closures(children):
   508	    """{role: digest}: every child of one entry point ran the same reviewed closure."""
   509	    closures = {}
   510	    for name in sorted(children):
   511	        digest = children[name]['source_closure_sha256']
   512	        _require(_is_sha256(digest), 'child {} records no execution closure'.format(name))
   513	        closures.setdefault(children[name]['role'], set()).add(digest)
   514	    for role in sorted(closures):
   515	        _require(len(closures[role]) == 1, 'the {} children of this arm do not share one '
   516	                 'execution closure: {}'.format(role, sorted(closures[role])))
   517	    return {role: sorted(digests)[0] for role, digests in sorted(closures.items())}
   518	
   519	
   520	def arm_headings(children):
   521	    """{room: heading json sha256}: one heading record per room, across every seed."""
   522	    headings = {}
   523	    for name in sorted(children):
   524	        for room, binding in sorted((children[name]['heading'] or {}).items()):
   525	            _require(isinstance(binding, dict) and binding.get('k') == HEADING_K,
   526	                     'child {} rolls {} by {!r}, not the registered {}'.format(
   527	                         name, room, (binding or {}).get('k'), HEADING_K))
   528	            _require(_is_sha256(binding.get('sha256')) and binding.get('path'),
   529	                     'child {} records no json identity for {}'.format(name, room))
   530	            recorded = headings.setdefault(room, binding['sha256'])
   531	            _require(recorded == binding['sha256'], 'the arm binds two heading records for '
   532	                     '{}: {} and {}'.format(room, recorded, binding['sha256']))
   533	    return headings
