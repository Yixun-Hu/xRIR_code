  1730	def write_outputs(result, json_path, summary_path):
  1731	    """Staged publication (finding 12): both files appear together, or neither at all.
  1732	
  1733	    Finding 10: the inputs are revalidated here, after the bootstrap and immediately
  1734	    before the first byte is published, so a file edited during the analysis is refused
  1735	    rather than described by a stale digest.
  1736	    """
  1737	    paths = [Path(summary_path), Path(json_path)]
  1738	    if len({path.resolve() for path in paths}) != 2 or any(
  1739	            os.path.lexists(str(path)) for path in paths):
  1740	        raise FileExistsError('output paths must be distinct and absent')
  1741	    text = render(result)
  1742	    record = dict(result, summary_path=str(paths[0].resolve()),
  1743	                  summary_sha256=hashlib.sha256(text.encode()).hexdigest())
  1744	    data = (json.dumps(_safe(record), sort_keys=True, indent=2,
  1745	                       allow_nan=False) + '\n').encode()
  1746	    recheck_inputs(result.get('inputs') or {})
  1747	    created = []
  1748	    try:
  1749	        for path, payload in zip(paths, (text.encode(), data)):
  1750	            path.parent.mkdir(parents=True, exist_ok=True)
  1751	            handle, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=str(path.parent))
  1752	            try:
  1753	                with os.fdopen(handle, 'wb') as stream:
  1754	                    provenance.apply_umask(stream.fileno())
  1755	                    stream.write(payload)
  1756	                    stream.flush()
  1757	                    os.fsync(stream.fileno())
  1758	                os.link(temporary, str(path))     # atomic, and still exclusive
  1759	                created.append(path)
  1760	            finally:
  1761	                os.unlink(temporary)
  1762	    except BaseException:
  1763	        for path in created:
  1764	            path.unlink()
  1765	        raise
  1766	    return record, hashlib.sha256(data).hexdigest(), text
  1767	
