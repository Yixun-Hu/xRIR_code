  1676	            name, len(cells), H2_FAMILY))
  1677	        for cell in cells:
  1678	            lines.append('  {:14s} {:4s} diff {} nominal {} adjusted {} -> {}'.format(
  1679	                cell['room'], cell['metric'], _number(cell['diff']),
  1680	                _bounds(cell['nominal_two_way']),
  1681	                UNAVAILABLE if cell['adjusted_two_way'] is None
  1682	                else cell['adjusted_two_way'],
  1683	                UNAVAILABLE if cell['label'] is None else cell['label']))
  1684	    lines.append('\nR1 historical rows (copied; no new inference)')
  1685	    for row in result['historical']:
  1686	        lines.append('  {:8s} {:22s} {:4s} diff {} two-way {} nominal {} -> {}'.format(
  1687	            row['name'], row['contrast'], row['metric'], _number(row['diff']),
  1688	            _bounds(row['two_way']), _bounds(row['nominal_two_way']),
  1689	            UNAVAILABLE if row['verdict'] is None else row['verdict']))
  1690	        lines.append('    source {} ({}) not recorded: {}'.format(
  1691	            row['source'], row['source_sha256'][:12], ', '.join(row['not_recorded'])))
  1692	    return lines
