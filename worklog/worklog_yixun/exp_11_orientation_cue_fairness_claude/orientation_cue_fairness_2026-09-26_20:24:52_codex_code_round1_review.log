  1695	def render(result):
  1696	    """The printed summary: exp_02's arm table, then the paired tables and the verdicts."""
  1697	    lines = []
  1698	    if result.get('mode') == 'sensitivity':
  1699	        lines.append('SENSITIVITY - relaxed admission; not the primary comparison of 6.2')
  1700	    if result['exploratory']:
  1701	        lines.append('DRAFT - exploratory run; verdicts are suppressed')
  1702	    if result['exploratory'] or result.get('mode') == 'sensitivity':
  1703	        lines.extend('Deviation: ' + item for item in result['deviations'])
  1704	    lines.append('{:22s}'.format('model') + ''.join('| {:39s}'.format(r) for r in ROOMS))
  1705	    lines.append('{:22s}'.format('') + ''.join(
  1706	        '| ' + ''.join('{:>13s}'.format(name) for _, name, _ in METRICS) for _ in ROOMS))
  1707	    for arm in ARMS:
  1708	        if arm not in result['arms']:
  1709	            continue
  1710	        for kind in ('zero-shot', 'fine-tuned'):
  1711	            line = '{:22s}'.format('{} {}'.format(arm, kind))
  1712	            for room in ROOMS:
  1713	                cells = []
  1714	                for key, _, nd in METRICS:
  1715	                    row = result['rows']['{}|{}|{}|{}'.format(arm, kind, room, key)]
  1716	                    cells.append(legacy.fmt(row['per_run'], nd))
  1717	                line += '| ' + ''.join(cells)
  1718	            lines.append(line)
  1719	    config = EXPERIMENTS[result.get('experiment', 'exp06')]
  1720	    lines.extend(render_exp11(result) if 'phase' in config
  1721	                 else render_decisions(result, config))
  1722	    lines.append('\nRoom-frame side split ({} job)'.format(result['side_split']['job']))
  1723	    for key in sorted(result['side_split']['cells']):
  1724	        entry = result['side_split']['cells'][key]
  1725	        lines.append('  {:30s} -y {!s:>10.10} (n={}) +y {!s:>10.10} (n={})'.format(
  1726	            key, entry['minus_y'], entry['n_minus_y'], entry['plus_y'], entry['n_plus_y']))
  1727	    return '\n'.join(lines) + '\n'
