   553	def child_protocol(args, name, role):
   554	    """The protocol exp_02 froze, read from the arguments the child really ran."""
   555	    for field in sorted(PROTOCOL):
   556	        if role == 'haa_train' and field == 'split':
   557	            continue                       # a fine-tuning child trains, it does not evaluate
   558	        _require(finalizer.exp06_recipe.strict_equal(args.get(field), PROTOCOL[field]),
   559	                 'child {} records {} {!r}, not the registered {!r}'.format(
   560	                     name, field, args.get(field), PROTOCOL[field]))
   561	
   562	
   563	def child_recipe(args, name, role):
   564	    """Plan 6.2's recipe, read from the arguments the child really ran.
   565	
   566	    Returns the deviations rather than raising: a confirmatory admission refuses them
   567	    all, and a ``--sensitivity`` analysis reports them beside the numbers they produced.
   568	    """
   569	    deviations = []
   570	
   571	    def check(field, expected):
   572	        if not finalizer.exp06_recipe.strict_equal(args.get(field), expected):
   573	            deviations.append('child {} records {} {!r}, not the registered {!r}'.format(
   574	                name, field, args.get(field), expected))
   575	
   576	    if role == 'haa_train':
   577	        stage = 'stage1' if name == 'stage1' else 'stage2'
   578	        for field, value in sorted(dict(TRAIN_RECIPE, **STAGES[stage]).items()):
   579	            check(field, value)
   580	        rooms = sorted(args.get('rooms') or [])
   581	        expected = (sorted(S1_ROOMS) if stage == 'stage1'
   582	                    else [name[len('stage2_'):]])
   583	        if rooms != expected:
   584	            deviations.append('child {} trains on the rooms {}, not the registered '
   585	                              '{}'.format(name, rooms, expected))
   586	        # Close review 2, finding 3: the validation loss selects ``best.pth``, and
   587	        # ``best.pth`` initialises the next stage, so exp_02's selection population is
   588	        # part of the recipe. The wrapper defaults ``--val-rooms`` to ``--rooms``.
   589	        validation = sorted(args.get('val_rooms') or args.get('rooms') or [])
   590	        if validation != expected:
   591	            deviations.append('child {} selects best.pth on the validation rooms {}, not '
   592	                              'the registered {}'.format(name, validation, expected))
   593	        return deviations
   594	    for field, value in sorted(EVAL_RECIPE.items()):
   595	        check(field, value)
   596	    room = name.rsplit('/', 1)[-1]
   597	    if args.get('rooms') != [room]:
   598	        deviations.append('child {} evaluates the rooms {!r}, not the registered '
   599	                          '[{!r}]'.format(name, args.get('rooms'), room))
   600	    return deviations
   601	
