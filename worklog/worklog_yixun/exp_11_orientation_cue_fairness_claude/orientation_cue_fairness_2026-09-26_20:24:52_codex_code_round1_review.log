   603	def check_test_indices(name, room, index):
   604	    """Exactly the DiffRIR test split of the room, in the order exp_02 registered."""
   605	    expected = legacy._test_indices(room)
   606	    _require([int(value) for value in index] == expected,
   607	             'child {} evaluated {} queries of {}, not exactly the {} DiffRIR test indices '
   608	             'in order'.format(name, len(index), room, len(expected)))
