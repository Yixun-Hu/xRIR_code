  1616	def _bounds(interval):
  1617	    """An interval the invalidity policy voided has no endpoints to print."""
  1618	    if interval is None:
  1619	        return UNAVAILABLE
  1620	    return '[{:+.4f}, {:+.4f}]'.format(interval['lo'], interval['hi'])
