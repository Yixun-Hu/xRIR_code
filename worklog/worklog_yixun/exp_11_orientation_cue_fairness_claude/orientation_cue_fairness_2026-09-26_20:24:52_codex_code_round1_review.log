   669	def child_dependencies(inputs, path, evidence, repo):
   670	    """Finding 2a: the inputs the child's provenance declares and its validators verified.
   671	
   672	    ``verify_child`` re-runs the child's own role validator, which rehashes the data
   673	    inventory (the HAA cache files it read), every file of its source closure and every
   674	    mutable input it recorded. Those bytes are what the certification rests on, so they
   675	    are retained here with the digests that validation confirmed -- publication
   676	    revalidates the whole map, and a second, different digest for any of these paths is
   677	    a contradiction rather than an update.
   678	    """
   679	    label = 'child {}'.format(Path(path).name)
   680	    record = _read_json(Path(path) / 'provenance.json', label + '/provenance.json', inputs,
   681	                        (evidence.get('artifacts') or {}).get('provenance.json'))
   682	    for key in ('data_identity', 'train_data_identity'):
   683	        identity = record.get(key)
   684	        if not isinstance(identity, dict):
   685	            continue
   686	        root = Path(identity['data_root'])
   687	        for entry in identity.get('inventory') or ():
   688	            _dependency(inputs, root / entry['path'], entry.get('sha256'), label)
   689	    for name in sorted(record.get('source_closures') or {}):
   690	        for item in (record['source_closures'][name] or {}).get('files') or ():
   691	            _dependency(inputs, finalizer._resolve(item['path'], repo),
   692	                        item.get('working_tree_sha256'), label)
   693	    for name in sorted(record.get('mutable_inputs') or {}):
   694	        entry = record['mutable_inputs'][name]
   695	        _dependency(inputs, finalizer._resolve(entry['path'], repo), entry.get('sha256'),
   696	                    label)
   697	
