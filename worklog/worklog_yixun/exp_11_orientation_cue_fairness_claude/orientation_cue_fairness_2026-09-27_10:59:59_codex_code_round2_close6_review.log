   265	# abort_recovery <canonical> <log>: the abort path of a REFUSED recovery. A malformed
   266	# invocation does not establish that a finished run failed, so an attempt that is
   267	# already published or already completed is left exactly as it is -- directory,
   268	# completion and `final` untouched -- and the finalizer's own cause stands on stderr.
   269	# Full mode keeps aborting unconditionally: it launched the attempt it is aborting.
   270	abort_recovery() {
   271	    local canonical="$1" log="$2" why=""
   272	    [ -f "$canonical/completion.json" ] && why="it has completed"
   273	    [ "$(published_target || true)" != "$canonical" ] || why="it is published as final"
