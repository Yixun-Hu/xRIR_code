   238	# published_target: what `final` resolves to under this arm root, or nothing.
   239	published_target() {
   240	    [ -L "$ARM_ROOT/final" ] || return 1
   241	    readlink -f -- "$ARM_ROOT/final"
   242	}
   243	
   244	# already_published <canonical>: this attempt is the published one and it completed.
   245	already_published() {
   246	    local target
   247	    target="$(published_target)" || return 1
   248	    [ "$target" = "$1" ] && [ -f "$1/completion.json" ]
   249	}
   250	
   251	# check_final_conflict <canonical>: a DIFFERENT existing `final` is never replaced by a
   252	# recovery unless the operator asks for it, and the replaced target is logged first.
   253	check_final_conflict() {
   254	    local target
   255	    target="$(published_target)" || return 0
   256	    [ "$target" != "$1" ] || return 0
   257	    if [ "$REPLACE_FINAL" -eq 0 ]; then
   258	        echo "refusing: $ARM_ROOT/final already publishes $target, not $1; pass" \
   259	             "--replace-final to replace it" >&2
   260	        return 1
   261	    fi
   262	    say "REPLACING $ARM_ROOT/final -> $(basename -- "$target") with $(basename -- "$1")"
   263	}
