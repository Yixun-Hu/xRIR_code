   187	# --- publishing one arm is serialised, by the kernel --------------------------------
   188	# Plan section 11 amendment A1. Publishing one arm admits exactly one invocation at a
   189	# time: recovery from alias resolution through promotion, and a full run from before it
   190	# launches its child through promotion, so a recovery is refused while a training run
   191	# still owns the arm. The lock is an `flock` on a per-arm FILE held on a descriptor this
   192	# process opens, which means **a lock vanishes with its holder**: the kernel drops it
   193	# when the process exits or dies, on every path including a signal, so there is no
   194	# cleanup code, no owner record and no stale-lock concept to get wrong. `-n` refuses
   195	# immediately rather than waiting.
   196	LOCK_FILE=""
   197	LOCK_FD=""
   198	
   199	hold_arm_lock() {  # hold_arm_lock <mode>
   200	    LOCK_FILE="$ARM_ROOT/.publish.lock"
   201	    say "LOCK $LOCK_FILE"
   202	    # A dry run touches nothing outside the test roots, so the lock is real exactly
   203	    # where the tests exercise it and announced everywhere else.
   204	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   205	    mkdir -p -- "$ARM_ROOT" || return 1
   206	    # `>>` creates the file if it is absent and never truncates it, so acquisition
   207	    # writes nothing -- not even to a file another invocation is holding.
   208	    exec {LOCK_FD}>>"$LOCK_FILE" || {
   209	        echo "refusing: cannot open the arm lock file $LOCK_FILE" >&2; return 1; }
   210	    if ! flock -n "$LOCK_FD"; then
   211	        echo "refusing: $LOCK_FILE is held by another invocation publishing this arm;" \
   212	             "one publication per arm at a time. The kernel releases it when that" \
   213	             "process ends, so there is nothing to clear by hand" >&2
   214	        return 1
   215	    fi
   216	    trap 'on_signal INT 2' INT
   217	    trap 'on_signal TERM 15' TERM
   218	    say "LOCKED $LOCK_FILE mode=$1"
   219	}
   220	
   221	# A signal handler must END this invocation. A cleanup-only handler returns, and bash
   222	# resumes -- which would let finalization and promotion continue after the interruption.
   223	# The lock needs no releasing here: the kernel drops it when this process exits.
   224	on_signal() {  # on_signal <NAME> <number>
   225	    INTERRUPTED=1
   226	    say "SIGNAL $1"
   227	    exit $((128 + $2))
   228	}
   229	
   230	# Checked before every protected step, so nothing runs after a handler has fired even if
   231	# some future caller swallows the exit.
   232	not_interrupted() {
   233	    [ "$INTERRUPTED" -eq 0 ] && return 0
   234	    echo "refusing: a signal handler has fired; this invocation does not continue" >&2
   235	    return 1
   236	}
