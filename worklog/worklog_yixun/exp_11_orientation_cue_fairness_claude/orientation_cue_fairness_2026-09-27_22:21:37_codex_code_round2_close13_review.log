   305	    local out="" pid="" kind="" status=0
   306	    # What the path IS, decided before anything opens it: a directory, FIFO, socket or
   307	    # device is definitely not a pid record, and opening a FIFO would wait for a writer
   308	    # forever. A stat that FAILS decides nothing here -- the module tells a confirmed
   309	    # absence from a path it was not allowed to inspect (close review 12, blocker 1),
   310	    # which is why this is no longer `[ -f ]`: that reads an unreadable parent as "gone".
   311	    # `%f` is the mode in hex, not `%F`'s phrase: that phrase is translated, so matching
   312	    # it would classify an ordinary file as "not a record" under any other locale.
   313	    if kind="$(stat -L -c %f -- "$1" 2>/dev/null)"; then
   314	        case "$kind" in ''|*[!0-9a-fA-F]*) return "$READER_UNKNOWN" ;; esac
   315	        if [ $(( 0x$kind & 0xF000 )) -ne $(( 0x8000 )) ]; then
   316	            return 1                          # definite: not a regular file, unopened
   317	        fi
   318	    fi
   319	    out="$(mktemp "${TMPDIR:-/tmp}/exp11_verdict.XXXXXX")" || return "$READER_UNKNOWN"
   320	    "$PYTHON" -m tools.exp11_pidrecord "$1" > "$out" 2>/dev/null || status=$?
   321	    if [ "$status" -ne 0 ]; then rm -f -- "$out"; return "$READER_UNKNOWN"; fi
   322	    if cmp -s "$out" <(printf 'norecord\n'); then rm -f -- "$out"; return 1; fi
   323	    # Digits only -- a candidate, not yet a verdict: the bytes must then match the whole
   324	    # line exactly, which is what refuses padding, NULs, CR and trailing junk.
   325	    pid="$(tr -cd '0-9' < "$out")"
   326	    case "$pid" in ''|*[!0-9]*) rm -f -- "$out"; return "$READER_UNKNOWN" ;; esac
   327	    [ "${#pid}" -le 10 ] || { rm -f -- "$out"; return "$READER_UNKNOWN"; }
   328	    if cmp -s "$out" <(printf 'record %s\n' "$pid"); then
   329	        rm -f -- "$out"
   330	        printf '%s\n' "$pid"
   331	        return 0
   332	    fi
   333	    rm -f -- "$out"
   334	    return "$READER_UNKNOWN"
   335	}
   336	
   337	# pid_alive <file>: 0 the recorded pid is alive | 1 it is not | 2 nobody can say.
   338	pid_alive() {
   339	    local pid="" status=0
   340	    pid="$(pid_record "$1")" || status=$?
   341	    [ "$status" -ne "$READER_UNKNOWN" ] || return "$READER_UNKNOWN"
   342	    [ "$status" -eq 0 ] || return 1
   343	    kill -0 "$pid" 2>/dev/null
   344	}
   345	
   346	# registration_complete <attempt>: child.pid holds one pid, by the grammar above. The
   347	# shell creates that file by redirection before the pid reaches it, so existence alone
   348	# proves nothing; what makes a launch *registered* is a number to look for. Whether that
   349	# number is still alive is a separate question, asked by pid_alive of the same bytes.
   350	# 0 complete | 1 not complete | 2 unknown -- the unknown is never folded into "not".
   351	registration_complete() {
   352	    pid_record "$1/child.pid" >/dev/null
   353	}
   354	
   355	# check_pid_reader: ask the reader two questions whose answers are known, before any
   356	# decision is taken. A reader stuck on one verdict never fails -- "record 1" for
   357	# everything makes every pid file a registration, "norecord" for everything makes every
   358	# trainer dead -- so only a probe catches it. The probes go through the same $PYTHON and
   359	# the same invocation as every real read.
   360	# probe_reader <file> <expected bytes> <where the answer goes>: 0 when the reader exited
   361	# 0 and printed EXACTLY those bytes. Byte for byte, like every real read.
   362	probe_reader() {
   363	    "$PYTHON" -m tools.exp11_pidrecord "$1" > "$3" 2>/dev/null || return 1
   364	    cmp -s "$3" "$2"
   365	}
   366	
   367	check_pid_reader() {
   368	    local dir="" bad=""
   369	    dir="$(mktemp -d "${TMPDIR:-/tmp}/exp11_pidreader.XXXXXX")" || {
   370	        echo "refusing: cannot create a probe directory for the pid reader" >&2
   371	        return 1; }
   372	    printf '1\n' > "$dir/one"
   373	    : > "$dir/empty"
   374	    printf 'record 1\n' > "$dir/want_one"
   375	    printf 'norecord\n' > "$dir/want_empty"
   376	    probe_reader "$dir/one" "$dir/want_one" "$dir/got_one" || bad="a file holding 1"
   377	    probe_reader "$dir/empty" "$dir/want_empty" "$dir/got_empty" ||
   378	        bad="${bad:+$bad and }an empty file"
   379	    rm -rf -- "$dir"
   380	    [ -z "$bad" ] && return 0
   381	    echo "refusing: pid reader unhealthy: $PYTHON -m tools.exp11_pidrecord did not" \
   382	         "answer byte for byte on $bad -- 'record 1' and 'norecord', one line each and" \
   383	         "nothing more, no padding and no NULs. Nothing of this arm can be decided by a" \
   384	         "reader that cannot say what a pid file holds" >&2
   385	    return 1
   386	}
   387	
   388	# probe_live <pid file> <what is alive>: 0 nothing found, 1 alive, 2 unknown. The last
   389	# two set SCAN_REASON and must be propagated unchanged -- an unknown liveness is not a
   390	# quiet arm, it is no answer at all.
   391	probe_live() {
   392	    local status=0
   393	    pid_alive "$1" || status=$?
   394	    case "$status" in
   395	        0) SCAN_REASON="$2"; return 1 ;;
   396	        "$READER_UNKNOWN")
   397	            SCAN_REASON="liveness unknown: pid reader failed on $1. Nothing is scanned,"\
   398	" retired or published on an answer nobody gave"
   399	            return "$READER_UNKNOWN" ;;
   400	    esac
   401	    return 0
   402	}
   403	
   404	# scan_arm <arm root> [<attempt being resolved>]: 0 when every attempt of the arm is
   405	# finished and accounted for, 1 when one is not (SCAN_REASON says which), 2 when the
   406	# reader failed and no answer exists. A broken reader closes the arm to every automated
   407	# decision; it never opens it (close review 11).
   408	scan_arm() {
   409	    local root="$1" resolving="${2:-}" attempt="" name="" here=""
   410	    SCAN_REASON=""
   411	    # The attempt being resolved is excluded by canonical identity, never by spelling:
   412	    # the caller's path and this glob's may name the same directory differently.
   413	    [ -z "$resolving" ] || resolving="$(realpath -- "$resolving" 2>/dev/null || printf '%s' "$resolving")"
   414	    for attempt in "$root"/attempt_*; do
   415	        [ -d "$attempt" ] || continue
   416	        name="$(basename -- "$attempt")"
   417	        here="$(realpath -- "$attempt" 2>/dev/null || printf '%s' "$attempt")"
   418	        probe_live "$attempt/launch.pid" "$name has a live launcher (launch.pid)" || return $?
   419	        probe_live "$attempt/child.pid" "$name has a live trainer (child.pid)" || return $?
   420	        probe_live "$attempt/train.pid" "$name has a live trainer (train.pid)" || return $?
   421	        [ "$here" != "$resolving" ] || continue
   422	        # `child.pid` is the WRAPPER's (GNU timeout), not the trainer's, so a complete
   423	        # and dead one accounts for nothing: only train.pid names the trainer and only
   424	        # train.exit says it finished (close review 10, blocker 2).
   425	        if [ -f "$attempt/launching" ] &&
   426	           { [ ! -f "$attempt/train.pid" ] || [ ! -f "$attempt/train.exit" ]; }; then
   427	            SCAN_REASON="$name has an unresolved launch: a launching marker and no"\
   428	" finished trainer (train.pid and train.exit), so a trainer of it may be running or may"\
   429	" have died unrecorded -- child.pid names the timeout wrapper, not the trainer."\
   430	" Resolve it"\
   431	" with --resolve-unregistered $attempt once nothing of the arm is alive and the marker"\
   432	" is older than ${UNRESOLVED_GRACE_S}s"
   433	            return 1; fi
   434	    done
   435	    return 0
   436	}
   437	
   438	require_quiet_arm() {  # require_quiet_arm [<attempt being resolved>]
   439	    local status=0
   440	    say "SCAN $ARM_ROOT"
   441	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   442	    check_pid_reader || return "$READER_UNKNOWN"   # before anything is looked at
   443	    scan_arm "$ARM_ROOT" "${1:-}" || status=$?
   444	    [ "$status" -eq 0 ] && return 0
   445	    echo "refusing: $SCAN_REASON" >&2
   446	    return "$status"
   447	}
   448	
   449	# --- the intent marker: the half-second the frozen lifecycle cannot cover -----------
   450	# `run_child` forks the detached trainer and writes child.pid only afterwards, and the
   451	# trainer needs a moment to write its own. A launcher that dies inside that window would
   452	# leave a running trainer nothing names. So the intent to launch is declared BEFORE the
   453	# fork and withdrawn only once the TRAINER is accounted for -- a complete child.pid and a
   454	# train.exit. `child.pid` holds the timeout wrapper's pid, so its death says nothing about
   455	# the trainer (close review 10). A marker left behind means "a trainer of this attempt may
   456	# be running, or died without saying so", and the arm stays closed until an operator
   457	# resolves it: a trainer that crashes before registering fails closed, by design.
   458	mark_launching() {  # mark_launching <attempt>
   459	    printf 'launcher %s\nat %s\narm %s\n' \
   460	        "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$ARM" > "$1/launching"
   461	}
   462	
   463	clear_launching() {  # clear_launching <attempt>: only once the TRAINER is accounted for
   464	    # This runs after run_child returns, so the wrapper and the sink are gone. A complete
   465	    # child.pid proves the wrapper was recorded; train.exit proves the trainer itself
   466	    # finished. A trainer that crashed before registering leaves the marker standing and
   467	    # the attempt unresolved -- fail closed, by design: the operator answers it.
   468	    # `|| return 0` covers BOTH "no complete child.pid" and "the reader could not say":
   469	    # a marker is withdrawn on an answer, never on the absence of one (close review 11).
   470	    registration_complete "$1" || return 0
   471	    [ -f "$1/train.exit" ] || return 0
   472	    rm -f -- "$1/launching"
   473	}
   474	
   475	# resolve_unregistered <attempt>: an operator's explicit answer to a marker nothing can
   476	# explain any more. It can only ever abort: an attempt with no child.pid has no exit
   477	# receipt and can never be published.
   478	resolve_unregistered() {
   479	    local attempt="" root="" name="" now=0 stamp=0 age=0
   480	    # This is the one decision that deliberately ignores its own target's marker -- the
   481	    # tombstone is what makes that safe -- so the liveness answers are all that stand
   482	    # between a running trainer and a retired directory. Ask the reader for them only
   483	    # once it has proved it can answer (close review 11).
   484	    check_pid_reader || return "$READER_UNKNOWN"
   485	    # Identity is the canonical directory, never the spelling: an operator's path may be
   486	    # absolute where the root is relative, or reach the arm through a symlink.
   487	    [ -d "$1" ] || { echo "refusing: $1 is not a directory" >&2; return 1; }
   488	    attempt="$(realpath -- "$1")" || return 1
   489	    root="$(realpath -- "$ARM_ROOT")" || return 1
   490	    name="$(basename -- "$attempt")"
   491	    # The lock and the scan are this arm's, so the resolution reaches no further.
   492	    if [ "$(dirname -- "$attempt")" != "$root" ]; then
   493	        echo "refusing: $attempt is not an attempt of the selected arm ($root); this" \
   494	             "invocation locked and scanned that arm and no other" >&2
   495	        return 1
   496	    fi
   497	    case "$name" in
   498	        attempt_*) case "${name#attempt_}" in ''|*[!0-9T]*)
   499	            echo "refusing: $name is not an attempt directory of this arm" >&2
   500	            return 1 ;; esac ;;
   501	        *) echo "refusing: $name is not an attempt directory of this arm" >&2
   502	           return 1 ;;
   503	    esac
   504	    # A directory we cannot look INTO says nothing about what is in it -- least of all
   505	    # that there is no marker and no live pid file. Not being able to look is never an
   506	    # answer (close review 12, blocker 1).
   507	    if ! stat -L -c %f -- "$attempt/." >/dev/null 2>&1; then
   508	        echo "refusing: liveness unknown: $attempt cannot be inspected, so neither its" \
   509	             "launching marker nor its pid files nor its receipts can be read; nothing" \
   510	             "of this arm is retired on that" >&2
   511	        return "$READER_UNKNOWN"
   512	    fi
   513	    [ -f "$attempt/launching" ] || {
   514	        echo "refusing: $attempt has no launching marker; nothing is unresolved" >&2
   515	        return 1; }
   516	    # NOT "child.pid is complete": that file holds the `timeout` wrapper's pid, and a
   517	    # wrapper that died with its trainer unregistered is precisely the state the scan
   518	    # now calls unresolved (close review 10, blocker 2). Refusing on it would leave the
   519	    # arm shut for good -- closed by the scan, unanswerable by the operator. What may
   520	    # never be retired this way is a run that actually finished: a completion receipt,
   521	    # or the published `final`. Everything else is decided by the quiet scan below --
   522	    # nothing of the arm alive -- and by the marker's age.
   523	    if [ -f "$attempt/completion.json" ]; then
   524	        echo "refusing: $attempt has a completion receipt; it is a finished run, not an" \
   525	             "unresolved launch" >&2
   526	        return 1
   527	    fi
   528	    if [ "$(published_target || true)" = "$attempt" ]; then
   529	        echo "refusing: $attempt is published as $ARM_ROOT/final; a published attempt is" \
   530	             "never retired as an unresolved launch" >&2
   531	        return 1
   532	    fi
   533	    # The REGISTRATION lock, distinct from the publication lock this invocation already
   534	    # holds: a full-mode launcher holds the publication lock for its child's whole run,
   535	    # so a trainer could never take that one. This one is held only across a
   536	    # registration and across this resolution -- exactly the pair that must not
   537	    # interleave, because the trainer's checks and its write straddle the rename below
   538	    # (close review 9, blocker 2). The recovery and full-mode scans do not take it: an
   539	    # in-flight registration is already covered there by the launching marker or by a
   540	    # complete live child.pid, and a recovery that had to queue behind every trainer
   541	    # would be a new way to stall an arm.
   542	    local registration="$root/.registration.lock" reg_fd=""
   543	    : >> "$registration" 2>/dev/null || true
   544	    exec {reg_fd}>>"$registration" || {
   545	        echo "refusing: cannot open the registration lock $registration" >&2; return 1; }
   546	    if ! flock -n "$reg_fd"; then
   547	        exec {reg_fd}>&-
   548	        echo "refusing: a registration in progress holds $registration; a trainer is" \
   549	             "between its checks and its write, so nothing of this arm may be retired" >&2
   550	        return 1
   551	    fi
   552	    local scanned=0
   553	    scan_arm "$ARM_ROOT" "$attempt" || scanned=$?
   554	    if [ "$scanned" -ne 0 ]; then
   555	        exec {reg_fd}>&-
   556	        echo "refusing: $SCAN_REASON" >&2
   557	        return "$scanned"          # 2 = the reader failed: this resolution decides nothing
   558	    fi
   559	    now="$(date -u +%s)"
   560	    stamp="$(date -u -r "$attempt/launching" +%s 2>/dev/null || printf '%s' "$now")"
   561	    age=$((now - stamp))
   562	    if [ "$age" -lt "$UNRESOLVED_GRACE_S" ]; then
   563	        exec {reg_fd}>&-
   564	        echo "refusing: $attempt/launching is ${age}s old and a trainer that has not" \
   565	             "registered yet is still possible; wait until it is ${UNRESOLVED_GRACE_S}s" >&2
   566	        return 1
   567	    fi
   568	    say "TOMBSTONE $root/$name.resolved"
   569	    say "ABORT $attempt -> ${attempt}_ABORTED_unregistered"
   570	    if [ "$DRY" -eq 0 ]; then
   571	        # Written BEFORE the rename, and never removed by anything here: a trainer that
   572	        # wakes after this can no longer find its directory, and if it somehow can, this
   573	        # is what tells it the launch was answered. The scan ignores it -- it is a
   574	        # record, not a claim (close review 8, blocker 2).
   575	        # Exactly the conditions this resolution checked -- nothing else is asserted.
   576	        # `train.exit` is NOT among them: a stale marker beside a finished trainer is
   577	        # resolvable too (close review 12, wording).
   578	        printf 'resolved-by %s\nat %s\nreason %s\n' "$$" \
   579	            "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" \
   580	            "unresolved launch, retired under this arm's publication and registration locks: a launching marker older than ${UNRESOLVED_GRACE_S}s, no recorded pid of this arm alive, no completion receipt, and not the published final. A trainer that never registered cannot be seen at all; this tombstone is what refuses it." \
   581	            > "$root/$name.resolved"
   582	        mv -- "$attempt" "${attempt}_ABORTED_unregistered"
   583	        # The marker has been answered; leaving it would close the arm for good, since
   584	        # the scan reads every attempt_* directory, retired ones included.
   585	        rm -f -- "${attempt}_ABORTED_unregistered/launching"
   586	    fi
   587	    exec {reg_fd}>&-   # the whole critical section is done: scan, tombstone, rename
   588	    # Precisely what was established, and only that: both locks were held, no recorded
   589	    # pid of the arm answered a liveness probe, the attempt has no completion receipt and
   590	    # is not the published `final`, and its marker was older than the grace. A trainer
   591	    # that never registered cannot be seen at all -- which is why the tombstone above is
   592	    # written first and never removed (close review 11 and 12, wording).
   593	    say "RESOLVED $attempt: marker older than ${UNRESOLVED_GRACE_S}s, no recorded pid of" \
   594	        "this arm alive, no completion receipt, not the published final. It can never be" \
   595	        "published, and the tombstone refuses any trainer of it that is still to come"
   596	}
   597	
   598	# A deterministic pause, so a regression can hold this invocation open between two
   599	# launchers. It exists only inside the test roots and costs a real launch nothing.
   600	scan_barrier() {
   601	    local file="${EXP11_SCAN_BARRIER:-}"
   602	    [ -n "$file" ] && [ "${EXP11_TEST_ROOTS:-0}" = 1 ] || return 0
   603	    : > "$file.at"
   604	    while [ -e "$file" ]; do sleep 0.05; done
   605	}
   606	
   607	# A signal handler must END this invocation. A cleanup-only handler returns, and bash
   608	# resumes -- which would let finalization and promotion continue after the interruption.
   609	# The lock needs no releasing here: the EXIT trap ends the holder, and if anything went
   610	# wrong with that the lease ends it within a second anyway.
   611	on_signal() {  # on_signal <NAME> <number>
   612	    INTERRUPTED=1
   613	    say "SIGNAL $1"
   614	    exit $((128 + $2))
   615	}
   616	
   617	# Checked before every protected step, so nothing runs after a handler has fired even if
   618	# some future caller swallows the exit.
   619	not_interrupted() {
   620	    [ "$INTERRUPTED" -eq 0 ] && return 0
   621	    echo "refusing: a signal handler has fired; this invocation does not continue" >&2
   622	    return 1
   623	}
   624	
   625	# published_target: what `final` resolves to under this arm root, or nothing.
   626	published_target() {
   627	    [ -L "$ARM_ROOT/final" ] || return 1
   628	    readlink -f -- "$ARM_ROOT/final"
   629	}
   630	
   631	# already_published <canonical>: this attempt is the published one and it completed.
   632	already_published() {
   633	    local target
   634	    target="$(published_target)" || return 1
   635	    [ "$target" = "$1" ] && [ -f "$1/completion.json" ]
   636	}
   637	
   638	# check_final_conflict <canonical>: a DIFFERENT existing `final` is never replaced by a
   639	# recovery unless the operator asks for it, and the replaced target is logged first.
   640	check_final_conflict() {
   641	    local target
   642	    target="$(published_target)" || return 0
   643	    [ "$target" != "$1" ] || return 0
   644	    if [ "$REPLACE_FINAL" -eq 0 ]; then
   645	        echo "refusing: $ARM_ROOT/final already publishes $target, not $1; pass" \
   646	             "--replace-final to replace it" >&2
   647	        return 1
   648	    fi
   649	    say "REPLACING $ARM_ROOT/final -> $(basename -- "$target") with $(basename -- "$1")"
   650	}
   651	
   652	# abort_recovery <canonical> <log>: the abort path of a REFUSED recovery. A malformed
   653	# invocation does not establish that a finished run failed, so an attempt that is
   654	# already published or already completed is left exactly as it is -- directory,
   655	# completion and `final` untouched -- and the finalizer's own cause stands on stderr.
   656	# Full mode keeps aborting unconditionally: it launched the attempt it is aborting.
   657	abort_recovery() {
   658	    local canonical="$1" log="$2" why=""
   659	    [ -f "$canonical/completion.json" ] && why="it has completed"
   660	    [ "$(published_target || true)" != "$canonical" ] || why="it is published as final"
   661	    if [ -n "$why" ]; then
   662	        say "PRESERVED $canonical ($why); the refusal is this invocation's, not the run's"
   663	        return 0
   664	    fi
   665	    abort "$canonical" "$log" finalize_refused
   666	}
   667	
   668	# diagnostic <kind> <run dir> <log> <receipt> <entry argv...>: one enumerated diagnostic
   669	# kind through the same lifecycle as a confirmatory child, finalized as exp11_smoke and
   670	# never admissible as an arm.
   671	diagnostic() {
   672	    local kind="$1" dir="$2" log="$3" receipt="$4"
   673	    shift 4
   674	    local flags=(--kind "$kind" --receipt "$receipt" --provenance-out "$dir/provenance.json"
   675	                 --approved "$APPROVED" --reviewed-commit "$COMMIT")
   676	    [ "${EXPLORATORY:-0}" -eq 0 ] || flags+=(--exploratory)
   677	    local cmd=("$PYTHON" tools/exp11_smoke.py "${flags[@]}" "$@")
   678	    say "MKDIR $dir"
   679	    say "SINK cat >> $log"
   680	    say "PIDFILE $dir/launch.pid"
   681	    say "RUN nohup setsid ${cmd[*]}"
   682	    if [ "$DRY" -eq 1 ]; then
   683	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   684	        finalize "$dir" "$log" '<code>' exp11_smoke "$receipt"
   685	        return 0
   686	    fi
   687	    mkdir -p -- "$(dirname -- "$dir")" "$RECORD"
   688	    mkdir -- "$dir"      # exclusive: a repeated stamp must not reuse a diagnostic run
   689	    own_launch "$dir"
   690	    : > "$log"
   691	    run_child "$dir" "$log" "${cmd[@]}"
   692	    close_child "$dir" "$log"
   693	    if ! finalize "$dir" "$log" "$CHILD_STATUS" exp11_smoke "$receipt"; then
   694	        abort "$dir" "$log" finalize_refused
   695	        exit 2
   696	    fi
   697	    if [ "$CHILD_STATUS" -ne 0 ]; then
   698	        abort "$dir" "$log" "child_failed_$CHILD_STATUS"
   699	        exit "$CHILD_STATUS"
   700	    fi
   701	}
   702	
   703	# The sourced library already resolved APPROVED to exp_06's record, so exp_11's default
   704	# is assigned unconditionally; EXP11_APPROVED (or --approved) overrides it.
   705	APPROVED="${EXP11_APPROVED:-$APPROVED_DEFAULT}"
   706	COMMIT="${COMMIT:-}"
   707	EXPLORATORY="${EXPLORATORY:-0}"
   708	ARM_ROOT="${ARM_ROOT:-$SIMPOR_ROOT}"
   709	CANONICAL_ATTEMPT="${CANONICAL_ATTEMPT:-}"
   710	INTERRUPTED="${INTERRUPTED:-0}"
   711	REPLACE_FINAL="${REPLACE_FINAL:-0}"
   712	RESOLVE_UNREGISTERED="${RESOLVE_UNREGISTERED:-}"
   713	DRY="${DRY:-0}"
   714	ARM="${ARM:-H}"
   715	
   716	if [ "${EXP11_LAUNCH_LIB:-0}" = 1 ]; then return 0; fi
   717	
   718	MODE="${1:-}"
   719	shift || true
   720	case "$MODE" in smoke|probe|full|finalize) ;; *) usage ;; esac
   721	GPU=""; COMMIT=""; ATTEMPT=""; LOG=""; CHILD_EXIT=""; DRY=0; ARM=H
   722	RESOLVE_UNREGISTERED=""
   723	while [ $# -gt 0 ]; do
   724	    case "$1" in
   725	        --arm) ARM="${2:-}"; shift 2 ;;
   726	        --gpu) GPU="${2:-}"; shift 2 ;;
   727	        --reviewed-commit) COMMIT="${2:-}"; shift 2 ;;
   728	        --attempt) ATTEMPT="${2:-}"; shift 2 ;;
   729	        --log) LOG="${2:-}"; shift 2 ;;
