/home/yixunhu/.codex/sessions/2026/09/26/rollout-2026-09-26T17-38-09-01a0dfa7-77ae-7b52-839b-bcc58738f2e6.jsonl:67:{"timestamp":"2026-09-26T21:38:39.835Z","ordinal":66,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0dfa7-77ae-7b52-839b-bcc58738f2e6","turn_id":"01a0dfa7-77ce-7782-ac15-668bcbd12958","item":{"type":"CommandExecution","id":"exec-756f1be1-dc56-475d-a7f1-24d6158517b3","process_id":"6263","command":["/bin/bash","-lc","nl -ba eval_yaw_rotation.py | sed -n '79,208p;329,444p'"],"cwd":"file:///home/yixunhu/codespace/xRIR_code","parsed_cmd":[{"type":"read","cmd":"nl -ba eval_yaw_rotation.py | sed -n '79,208p;329,444p'","name":"eval_yaw_rotation.py","path":"eval_yaw_rotation.py"}],"source":"unified_exec_startup","status":"completed","stdout":"    79\tdef forward_conditions(model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, k, aligned0):\n    80\t    \"\"\"Both experimental conditions of one batch at one angle.\n    81\t\n    82\t    Args:\n    83\t        model: an ``xRIR`` (or ``xRIR_Cyl``) in ``eval()`` mode on CUDA.\n    84\t        depth_coord: **unrotated** panorama coordinates ``[B, 3, H, W]``; the rotation is\n    85\t            applied here so P and E cannot accidentally see different geometry.\n    86\t        ref_irs: reference RIRs ``[B, K, L]`` (never rotated -- the acoustics are invariant).\n    87\t        src_loc: unrotated query-source position ``[B, 3]``.\n    88\t        ref_locs: unrotated reference-source positions ``[B, K, 3]``.\n    89\t        tgt_wav: target RIR ``[B, 1, L]``.\n    90\t        k: integer column roll.\n    91\t        aligned0: the ``k = 0`` aligned reference audio, i.e.\n    92\t            ``model.shift_and_align(ref_irs, src_loc, ref_locs)`` computed once per batch;\n    93\t            condition P is forced to use it at every angle.\n    94\t\n    95\t    Returns:\n    96\t        ``(out_P, out_E, tgt_spec)`` -- two ``[B, F, T, 1]`` log-magnitude spectrograms and\n    97\t        the shared ``[B, 1, F, T]`` target magnitude spectrogram.  At ``k = 0`` both\n    98\t        outputs equal the plain forward exactly.\n    99\t    \"\"\"\n   100\t    depth_k, src_k, ref_locs_k = rotated_views(depth_coord, src_loc, ref_locs, k)\n   101\t    with torch.no_grad():\n   102\t        with fixed_alignment(model, aligned0):\n   103\t            out_p, tgt_spec = model(depth_k, ref_irs, src_k, ref_locs_k, tgt_wav)\n   104\t        out_e, _ = model(depth_k, ref_irs, src_k, ref_locs_k, tgt_wav)\n   105\t    return out_p, out_e, tgt_spec\n   106\t\n   107\t\n   108\tdef spectral_metrics(out_k, out_0, tgt_spec):\n   109\t    \"\"\"The five per-sample spectral metrics of one batch at one angle.\n   110\t\n   111\t    Args:\n   112\t        out_k: predicted log-magnitude spectrograms at the angle, ``[B, F, T, 1]``.\n   113\t        out_0: the same batch's ``k = 0`` prediction, ``[B, F, T, 1]`` -- the paired\n   114\t            reference for ``consistency``.\n   115\t        tgt_spec: target magnitude spectrograms ``[B, 1, F, T]``.\n   116\t\n   117\t    Returns:\n   118\t        ``{\"loss\", \"stft\", \"decay\", \"log_mse\", \"consistency\"}``, each a detached CPU\n   119\t        float32 tensor of shape ``[B]``:\n   120\t\n   121\t        * ``loss``/``stft``/``decay`` -- ``tools.per_sample_metrics.per_sample_losses``,\n   122\t          i.e. exp_01's test loss and its two halves, computed on 1-sample slices;\n   123\t        * ``log_mse`` -- the per-sample form of exp_01's\n   124\t          ``Evaluator.stft_loss(out_spec.squeeze(-1), log(tgt_spec + 1e-8).squeeze(1))``;\n   125\t        * ``consistency`` -- ``mean |out_k - out_0|`` over the log-spectrogram, exactly\n   126\t          ``0`` at ``k = 0``.\n   127\t    \"\"\"\n   128\t    loss, stft, decay = per_sample_losses(out_k, tgt_spec)\n   129\t    with torch.no_grad():\n   130\t        log_tgt = torch.log(tgt_spec[:, 0] + 1e-8)\n   131\t        log_mse = ((out_k[..., 0] - log_tgt) ** 2).flatten(1).mean(dim=1)\n   132\t        consistency = (out_k - out_0).abs().flatten(1).mean(dim=1)\n   133\t    return {\"loss\": loss, \"stft\": stft, \"decay\": decay,\n   134\t            \"log_mse\": log_mse.detach().cpu().float(),\n   135\t            \"consistency\": consistency.detach().cpu().float()}\n   136\t\n   137\t\n   138\tdef acoustic_metrics_batch(out_k, tgt_wav, query_keys, evaluator, gl_seed):\n   139\t    \"\"\"EDT / C50 / T60 errors of one batch, sample by sample.\n   140\t\n   141\t    The magnitude spectrogram is rebuilt exactly as ``eval_xRIR_backbone.py`` does\n   142\t    (``(exp(out) - 1e-8)[..., 0]``) and inverted with a Griffin-Lim whose random phase\n   143\t    is seeded from ``(gl_seed, query key)``, so the same query inverts the same\n   144\t    magnitudes to the same waveform at every angle, in every model and in any angle\n   145\t    order.  The 8000-sample metric window is applied inside\n   146\t    ``tools.per_sample_metrics.acoustic_metrics``.\n   147\t\n   148\t    Args:\n   149\t        out_k: predicted log-magnitude spectrograms ``[B, F, T, 1]`` (CPU or CUDA).\n   150\t        tgt_wav: target RIRs ``[B, 1, L]``.\n   151\t        query_keys: the ``B`` query paths, in batch order.\n   152\t        evaluator: an ``eval_unseen.Evaluator``.\n   153\t        gl_seed: run-level Griffin-Lim seed.\n   154\t\n   155\t    Returns:\n   156\t        ``{\"edt\", \"c50\", \"t60\"}``, each a float64 ``np.ndarray`` of shape ``[B]`` with\n   157\t        NaN where the sample is invalid at this angle.\n   158\t\n   159\t    Raises:\n   160\t        ValueError: if ``query_keys`` does not have one key per row of ``out_k``.\n   161\t    \"\"\"\n   162\t    if len(query_keys) != out_k.shape[0]:\n   163\t        raise ValueError(\"got {} query keys for a batch of {}\".format(\n   164\t            len(query_keys), out_k.shape[0]))\n   165\t    values = {\"edt\": [], \"c50\": [], \"t60\": []}\n   166\t    for i in range(out_k.shape[0]):\n   167\t        mag = (torch.exp(out_k[i:i + 1]) - 1e-8)[..., 0].cpu()\n   168\t        wav = griffin_lim_seeded(mag, sample_seed(gl_seed, query_keys[i]))\n   169\t        sample = acoustic_metrics(wav[0].numpy(), tgt_wav[i, 0].cpu().numpy(), evaluator)\n   170\t        for name in values:\n   171\t            values[name].append(sample[name])\n   172\t    return {name: np.asarray(vals, dtype=np.float64) for name, vals in values.items()}\n   173\t\n   174\t\n   175\tdef delay_flip_counts(src_loc, ref_locs, cols):\n   176\t    \"\"\"Count the integer direct-path delays a rotation moves, per angle.\n   177\t\n   178\t    ``xRIR.shift_and_align`` is algebraically yaw-invariant, but its float32 norms and\n   179\t    ``torch.round`` are not: a delay sitting on a rounding tie can move by one sample\n   180\t    under an exactly norm-preserving rotation.  This audit quantifies that noise floor\n   181\t    over the real geometry -- it is what condition P exists to exclude.\n   182\t\n   183\t    Args:\n   184\t        src_loc: query-source positions ``[B, 3]``.\n   185\t        ref_locs: reference-source positions ``[B, K, 3]``.\n   186\t        cols: iterable of integer column rolls.\n   187\t\n   188\t    Returns:\n   189\t        ``{k: count}`` -- the number of ``(sample, reference)`` pairs (out of ``B * K``)\n   190\t        whose integer delay differs between the rotated and the unrotated coordinates.\n   191\t        ``k = 0`` is always ``0``.\n   192\t    \"\"\"\n   193\t    baseline = integer_delays(src_loc, ref_locs)\n   194\t    counts = {}\n   195\t    for k in cols:\n   196\t        angle = yaw_angle_rad(k)\n   197\t        rotated = integer_delays(rotate_vectors_z(src_loc, angle),\n   198\t                                 rotate_vectors_z(ref_locs, angle))\n   199\t        counts[int(k)] = int((rotated != baseline).sum())\n   200\t    return counts\n   201\t\n   202\t\n   203\tdef _rel_change(rotated, base):\n   204\t    \"\"\"``mean|rotated - base| / mean|base|`` as a Python float.\"\"\"\n   205\t    denom = base.abs().mean()\n   206\t    return float((rotated - base).abs().mean() / denom)\n   207\t\n   208\t\n   329\tdef pad_batch(batch, batch_size):\n   330\t    \"\"\"Repeat a short batch's rows so it is computed at exactly ``batch_size`` samples.\n   331\t\n   332\t    cuBLAS and cuDNN pick their algorithm -- and therefore their reduction order -- from\n   333\t    the *shape*, so a query's prediction depends on how many samples share its batch:\n   334\t    measured on a trained checkpoint, the same query evaluated alone and inside a batch\n   335\t    of 16 differs by 4.8e-5 in the log-spectrogram.  The split is 6337 = 396 * 16 + 1, so\n   336\t    without padding the last query would be the only one computed at a different shape.\n   337\t    Repeating rows (wrap-around) keeps the shape canonical; the padded rows are dropped\n   338\t    before anything is recorded, and because every op here is row-independent the kept\n   339\t    rows are bit-identical to their values in a full batch.\n   340\t\n   341\t    Args:\n   342\t        batch: the ``ManifestDataset`` seven-tuple, collated (six tensors + the key list).\n   343\t        batch_size: the canonical number of rows, or ``None`` to leave the batch alone.\n   344\t\n   345\t    Returns:\n   346\t        ``(padded_batch, n_real)``; the input object itself when no padding is needed.\n   347\t\n   348\t    Raises:\n   349\t        ValueError: if the batch already has more rows than ``batch_size``.\n   350\t    \"\"\"\n   351\t    n_real = len(batch[-1])\n   352\t    if batch_size is None or n_real == int(batch_size):\n   353\t        return batch, n_real\n   354\t    if n_real > int(batch_size):\n   355\t        raise ValueError(\"batch of {} rows exceeds the canonical size {}\".format(\n   356\t            n_real, batch_size))\n   357\t    order = [i % n_real for i in range(int(batch_size))]\n   358\t    index = torch.as_tensor(order, dtype=torch.long)\n   359\t    padded = tuple(item[index] if torch.is_tensor(item) else [item[i] for i in order]\n   360\t                   for item in batch)\n   361\t    return padded, n_real\n   362\t\n   363\t\n   364\tdef evaluate_batch(model, batch, evaluator, cols, acoustic_cols=(), e_acoustic_cols=(),\n   365\t                   gl_seed=0, batch_size=None):\n   366\t    \"\"\"Every per-sample metric of one collated batch, at every angle in ``cols``.\n   367\t\n   368\t    The whole batch is moved to the GPU once and the ``k = 0`` alignment and prediction\n   369\t    are computed once, so the angles share exactly one paired reference.  Nothing in the\n   370\t    loop depends on the order of ``cols`` or on which angles came before: the Griffin-Lim\n   371\t    phase is seeded per query, so the result is a pure function of\n   372\t    ``(model, batch, cols, gl_seed)``.\n   373\t\n   374\t    Args:\n   375\t        model: an ``xRIR`` on CUDA in ``eval()`` mode.\n   376\t        batch: the ``ManifestDataset`` seven-tuple, collated.\n   377\t        evaluator: an ``eval_unseen.Evaluator``.\n   378\t        cols: integer column rolls to evaluate (spectral metrics at every one).\n   379\t        acoustic_cols: the subset of ``cols`` that also gets EDT / C50 / T60 under\n   380\t            condition P; ``e_acoustic_cols`` is the same for condition E.  At ``k = 0``\n   381\t            the two conditions are the same prediction, so the acoustic metrics are\n   382\t            computed once and stored under both.\n   383\t        gl_seed: run-level Griffin-Lim seed.\n   384\t        batch_size: the canonical compute shape (see :func:`pad_batch`).  A short batch\n   385\t            is padded to it for the forward passes and the padded rows are dropped before\n   386\t            any metric is computed, so the recorded values do not depend on how many\n   387\t            queries happened to share the batch.\n   388\t\n   389\t    Returns:\n   390\t        ``(query_keys, results, delay_flips)`` where ``results[(condition, k)]`` maps a\n   391\t        metric name to a float64 ``np.ndarray`` of shape ``[n_real]``, and ``delay_flips``\n   392\t        maps each ``k`` to the number of flipped ``(sample, reference)`` delays.\n   393\t    \"\"\"\n   394\t    batch, n_real = pad_batch(batch, batch_size)\n   395\t    _, src_loc, depth_coord, tgt_wav, ref_irs, ref_locs, keys = batch\n   396\t    src_loc, depth_coord = src_loc.cuda(), depth_coord.cuda()\n   397\t    tgt_wav, ref_irs, ref_locs = tgt_wav.cuda(), ref_irs.cuda(), ref_locs.cuda()\n   398\t    keys = list(keys)[:n_real]\n   399\t    acoustic_at = {\"P\": set(int(k) for k in acoustic_cols),\n   400\t                   \"E\": set(int(k) for k in e_acoustic_cols)}\n   401\t    zero_wanted = bool(acoustic_at[\"P\"] | acoustic_at[\"E\"]) and 0 in (\n   402\t        acoustic_at[\"P\"] | acoustic_at[\"E\"])\n   403\t\n   404\t    with torch.no_grad():\n   405\t        aligned0 = model.shift_and_align(ref_irs, src_loc, ref_locs)\n   406\t        out_0, _ = model(depth_coord, ref_irs, src_loc, ref_locs, tgt_wav)\n   407\t    # Everything below is per-sample, so dropping the padded rows here is exact and\n   408\t    # keeps the (CPU-bound) Griffin-Lim off rows that would be discarded anyway.\n   409\t    out_0, tgt_real = out_0[:n_real], tgt_wav[:n_real]\n   410\t\n   411\t    results = {}\n   412\t    acoustic_0 = None\n   413\t    for k in cols:\n   414\t        out_p, out_e, tgt_spec = forward_conditions(\n   415\t            model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, k, aligned0)\n   416\t        out_p, out_e, tgt_spec = out_p[:n_real], out_e[:n_real], tgt_spec[:n_real]\n   417\t        for condition, pred in ((\"P\", out_p), (\"E\", out_e)):\n   418\t            cell = {name: value.double().numpy()\n   419\t                    for name, value in spectral_metrics(pred, out_0, tgt_spec).items()}\n   420\t            if int(k) == 0 and zero_wanted:\n   421\t                if acoustic_0 is None:\n   422\t                    acoustic_0 = acoustic_metrics_batch(pred, tgt_real, keys, evaluator,\n   423\t                                                        gl_seed)\n   424\t                cell.update({name: value.copy() for name, value in acoustic_0.items()})\n   425\t            elif int(k) in acoustic_at[condition]:\n   426\t                cell.update(acoustic_metrics_batch(pred, tgt_real, keys, evaluator, gl_seed))\n   427\t            results[(condition, int(k))] = cell\n   428\t    return keys, results, delay_flip_counts(src_loc[:n_real], ref_locs[:n_real], cols)\n   429\t\n   430\t\n   431\tdef set_precision(tf32):\n   432\t    \"\"\"Pin the TF32 policy of both cuBLAS and cuDNN for the whole run.\n   433\t\n   434\t    cuDNN's ``allow_tf32`` defaults to ``True``, and the reference-RIR encoder is a\n   435\t    ResNet-18, so leaving it on makes the forward pass depend on the batch size at the\n   436\t    1e-4 (relative) level -- measured on 8 real queries: max ``|d|`` 2.3e-4 with TF32 on\n   437\t    versus 2.4e-7 with it off.  That is far above the effects this experiment measures,\n   438\t    so TF32 is off by default and the choice is recorded in the run's meta block.\n   439\t\n   440\t    Args:\n   441\t        tf32: whether to allow TF32 for matmuls and convolutions.\n   442\t    \"\"\"\n   443\t    torch.backends.cuda.matmul.allow_tf32 = bool(tf32)\n   444\t    torch.backends.cudnn.allow_tf32 = bool(tf32)\n","stderr":"","aggregated_output":"    79\tdef forward_conditions(model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, k, aligned0):\n    80\t    \"\"\"Both experimental conditions of one batch at one angle.\n    81\t\n    82\t    Args:\n    83\t        model: an ``xRIR`` (or ``xRIR_Cyl``) in ``eval()`` mode on CUDA.\n    84\t        depth_coord: **unrotated** panorama coordinates ``[B, 3, H, W]``; the rotation is\n    85\t            applied here so P and E cannot accidentally see different geometry.\n    86\t        ref_irs: reference RIRs ``[B, K, L]`` (never rotated -- the acoustics are invariant).\n    87\t        src_loc: unrotated query-source position ``[B, 3]``.\n    88\t        ref_locs: unrotated reference-source positions ``[B, K, 3]``.\n    89\t        tgt_wav: target RIR ``[B, 1, L]``.\n    90\t        k: integer column roll.\n    91\t        aligned0: the ``k = 0`` aligned reference audio, i.e.\n    92\t            ``model.shift_and_align(ref_irs, src_loc, ref_locs)`` computed once per batch;\n    93\t            condition P is forced to use it at every angle.\n    94\t\n    95\t    Returns:\n    96\t        ``(out_P, out_E, tgt_spec)`` -- two ``[B, F, T, 1]`` log-magnitude spectrograms and\n    97\t        the shared ``[B, 1, F, T]`` target magnitude spectrogram.  At ``k = 0`` both\n    98\t        outputs equal the plain forward exactly.\n    99\t    \"\"\"\n   100\t    depth_k, src_k, ref_locs_k = rotated_views(depth_coord, src_loc, ref_locs, k)\n   101\t    with torch.no_grad():\n   102\t        with fixed_alignment(model, aligned0):\n   103\t            out_p, tgt_spec = model(depth_k, ref_irs, src_k, ref_locs_k, tgt_wav)\n   104\t        out_e, _ = model(depth_k, ref_irs, src_k, ref_locs_k, tgt_wav)\n   105\t    return out_p, out_e, tgt_spec\n   106\t\n   107\t\n   108\tdef spectral_metrics(out_k, out_0, tgt_spec):\n   109\t    \"\"\"The five per-sample spectral metrics of one batch at one angle.\n   110\t\n   111\t    Args:\n   112\t        out_k: predicted log-magnitude spectrograms at the angle, ``[B, F, T, 1]``.\n   113\t        out_0: the same batch's ``k = 0`` prediction, ``[B, F, T, 1]`` -- the paired\n   114\t            reference for ``consistency``.\n   115\t        tgt_spec: target magnitude spectrograms ``[B, 1, F, T]``.\n   116\t\n   117\t    Returns:\n   118\t        ``{\"loss\", \"stft\", \"decay\", \"log_mse\", \"consistency\"}``, each a detached CPU\n   119\t        float32 tensor of shape ``[B]``:\n   120\t\n   121\t        * ``loss``/``stft``/``decay`` -- ``tools.per_sample_metrics.per_sample_losses``,\n   122\t          i.e. exp_01's test loss and its two halves, computed on 1-sample slices;\n   123\t        * ``log_mse`` -- the per-sample form of exp_01's\n   124\t          ``Evaluator.stft_loss(out_spec.squeeze(-1), log(tgt_spec + 1e-8).squeeze(1))``;\n   125\t        * ``consistency`` -- ``mean |out_k - out_0|`` over the log-spectrogram, exactly\n   126\t          ``0`` at ``k = 0``.\n   127\t    \"\"\"\n   128\t    loss, stft, decay = per_sample_losses(out_k, tgt_spec)\n   129\t    with torch.no_grad():\n   130\t        log_tgt = torch.log(tgt_spec[:, 0] + 1e-8)\n   131\t        log_mse = ((out_k[..., 0] - log_tgt) ** 2).flatten(1).mean(dim=1)\n   132\t        consistency = (out_k - out_0).abs().flatten(1).mean(dim=1)\n   133\t    return {\"loss\": loss, \"stft\": stft, \"decay\": decay,\n   134\t            \"log_mse\": log_mse.detach().cpu().float(),\n   135\t            \"consistency\": consistency.detach().cpu().float()}\n   136\t\n   137\t\n   138\tdef acoustic_metrics_batch(out_k, tgt_wav, query_keys, evaluator, gl_seed):\n   139\t    \"\"\"EDT / C50 / T60 errors of one batch, sample by sample.\n   140\t\n   141\t    The magnitude spectrogram is rebuilt exactly as ``eval_xRIR_backbone.py`` does\n   142\t    (``(exp(out) - 1e-8)[..., 0]``) and inverted with a Griffin-Lim whose random phase\n   143\t    is seeded from ``(gl_seed, query key)``, so the same query inverts the same\n   144\t    magnitudes to the same waveform at every angle, in every model and in any angle\n   145\t    order.  The 8000-sample metric window is applied inside\n   146\t    ``tools.per_sample_metrics.acoustic_metrics``.\n   147\t\n   148\t    Args:\n   149\t        out_k: predicted log-magnitude spectrograms ``[B, F, T, 1]`` (CPU or CUDA).\n   150\t        tgt_wav: target RIRs ``[B, 1, L]``.\n   151\t        query_keys: the ``B`` query paths, in batch order.\n   152\t        evaluator: an ``eval_unseen.Evaluator``.\n   153\t        gl_seed: run-level Griffin-Lim seed.\n   154\t\n   155\t    Returns:\n   156\t        ``{\"edt\", \"c50\", \"t60\"}``, each a float64 ``np.ndarray`` of shape ``[B]`` with\n   157\t        NaN where the sample is invalid at this angle.\n   158\t\n   159\t    Raises:\n   160\t        ValueError: if ``query_keys`` does not have one key per row of ``out_k``.\n   161\t    \"\"\"\n   162\t    if len(query_keys) != out_k.shape[0]:\n   163\t        raise ValueError(\"got {} query keys for a batch of {}\".format(\n   164\t            len(query_keys), out_k.shape[0]))\n   165\t    values = {\"edt\": [], \"c50\": [], \"t60\": []}\n   166\t    for i in range(out_k.shape[0]):\n   167\t        mag = (torch.exp(out_k[i:i + 1]) - 1e-8)[..., 0].cpu()\n   168\t        wav = griffin_lim_seeded(mag, sample_seed(gl_seed, query_keys[i]))\n   169\t        sample = acoustic_metrics(wav[0].numpy(), tgt_wav[i, 0].cpu().numpy(), evaluator)\n   170\t        for name in values:\n   171\t            values[name].append(sample[name])\n   172\t    return {name: np.asarray(vals, dtype=np.float64) for name, vals in values.items()}\n   173\t\n   174\t\n   175\tdef delay_flip_counts(src_loc, ref_locs, cols):\n   176\t    \"\"\"Count the integer direct-path delays a rotation moves, per angle.\n   177\t\n   178\t    ``xRIR.shift_and_align`` is algebraically yaw-invariant, but its float32 norms and\n   179\t    ``torch.round`` are not: a delay sitting on a rounding tie can move by one sample\n   180\t    under an exactly norm-preserving rotation.  This audit quantifies that noise floor\n   181\t    over the real geometry -- it is what condition P exists to exclude.\n   182\t\n   183\t    Args:\n   184\t        src_loc: query-source positions ``[B, 3]``.\n   185\t        ref_locs: reference-source positions ``[B, K, 3]``.\n   186\t        cols: iterable of integer column rolls.\n   187\t\n   188\t    Returns:\n   189\t        ``{k: count}`` -- the number of ``(sample, reference)`` pairs (out of ``B * K``)\n   190\t        whose integer delay differs between the rotated and the unrotated coordinates.\n   191\t        ``k = 0`` is always ``0``.\n   192\t    \"\"\"\n   193\t    baseline = integer_delays(src_loc, ref_locs)\n   194\t    counts = {}\n   195\t    for k in cols:\n   196\t        angle = yaw_angle_rad(k)\n   197\t        rotated = integer_delays(rotate_vectors_z(src_loc, angle),\n   198\t                                 rotate_vectors_z(ref_locs, angle))\n   199\t        counts[int(k)] = int((rotated != baseline).sum())\n   200\t    return counts\n   201\t\n   202\t\n   203\tdef _rel_change(rotated, base):\n   204\t    \"\"\"``mean|rotated - base| / mean|base|`` as a Python float.\"\"\"\n   205\t    denom = base.abs().mean()\n   206\t    return float((rotated - base).abs().mean() / denom)\n   207\t\n   208\t\n   329\tdef pad_batch(batch, batch_size):\n   330\t    \"\"\"Repeat a short batch's rows so it is computed at exactly ``batch_size`` samples.\n   331\t\n   332\t    cuBLAS and cuDNN pick their algorithm -- and therefore their reduction order -- from\n   333\t    the *shape*, so a query's prediction depends on how many samples share its batch:\n   334\t    measured on a trained checkpoint, the same query evaluated alone and inside a batch\n   335\t    of 16 differs by 4.8e-5 in the log-spectrogram.  The split is 6337 = 396 * 16 + 1, so\n   336\t    without padding the last query would be the only one computed at a different shape.\n   337\t    Repeating rows (wrap-around) keeps the shape canonical; the padded rows are dropped\n   338\t    before anything is recorded, and because every op here is row-independent the kept\n   339\t    rows are bit-identical to their values in a full batch.\n   340\t\n   341\t    Args:\n   342\t        batch: the ``ManifestDataset`` seven-tuple, collated (six tensors + the key list).\n   343\t        batch_size: the canonical number of rows, or ``None`` to leave the batch alone.\n   344\t\n   345\t    Returns:\n   346\t        ``(padded_batch, n_real)``; the input object itself when no padding is needed.\n   347\t\n   348\t    Raises:\n   349\t        ValueError: if the batch already has more rows than ``batch_size``.\n   350\t    \"\"\"\n   351\t    n_real = len(batch[-1])\n   352\t    if batch_size is None or n_real == int(batch_size):\n   353\t        return batch, n_real\n   354\t    if n_real > int(batch_size):\n   355\t        raise ValueError(\"batch of {} rows exceeds the canonical size {}\".format(\n   356\t            n_real, batch_size))\n   357\t    order = [i % n_real for i in range(int(batch_size))]\n   358\t    index = torch.as_tensor(order, dtype=torch.long)\n   359\t    padded = tuple(item[index] if torch.is_tensor(item) else [item[i] for i in order]\n   360\t                   for item in batch)\n   361\t    return padded, n_real\n   362\t\n   363\t\n   364\tdef evaluate_batch(model, batch, evaluator, cols, acoustic_cols=(), e_acoustic_cols=(),\n   365\t                   gl_seed=0, batch_size=None):\n   366\t    \"\"\"Every per-sample metric of one collated batch, at every angle in ``cols``.\n   367\t\n   368\t    The whole batch is moved to the GPU once and the ``k = 0`` alignment and prediction\n   369\t    are computed once, so the angles share exactly one paired reference.  Nothing in the\n   370\t    loop depends on the order of ``cols`` or on which angles came before: the Griffin-Lim\n   371\t    phase is seeded per query, so the result is a pure function of\n   372\t    ``(model, batch, cols, gl_seed)``.\n   373\t\n   374\t    Args:\n   375\t        model: an ``xRIR`` on CUDA in ``eval()`` mode.\n   376\t        batch: the ``ManifestDataset`` seven-tuple, collated.\n   377\t        evaluator: an ``eval_unseen.Evaluator``.\n   378\t        cols: integer column rolls to evaluate (spectral metrics at every one).\n   379\t        acoustic_cols: the subset of ``cols`` that also gets EDT / C50 / T60 under\n   380\t            condition P; ``e_acoustic_cols`` is the same for condition E.  At ``k = 0``\n   381\t            the two conditions are the same prediction, so the acoustic metrics are\n   382\t            computed once and stored under both.\n   383\t        gl_seed: run-level Griffin-Lim seed.\n   384\t        batch_size: the canonical compute shape (see :func:`pad_batch`).  A short batch\n   385\t            is padded to it for the forward passes and the padded rows are dropped before\n   386\t            any metric is computed, so the recorded values do not depend on how many\n   387\t            queries happened to share the batch.\n   388\t\n   389\t    Returns:\n   390\t        ``(query_keys, results, delay_flips)`` where ``results[(condition, k)]`` maps a\n   391\t        metric name to a float64 ``np.ndarray`` of shape ``[n_real]``, and ``delay_flips``\n   392\t        maps each ``k`` to the number of flipped ``(sample, reference)`` delays.\n   393\t    \"\"\"\n   394\t    batch, n_real = pad_batch(batch, batch_size)\n   395\t    _, src_loc, depth_coord, tgt_wav, ref_irs, ref_locs, keys = batch\n   396\t    src_loc, depth_coord = src_loc.cuda(), depth_coord.cuda()\n   397\t    tgt_wav, ref_irs, ref_locs = tgt_wav.cuda(), ref_irs.cuda(), ref_locs.cuda()\n   398\t    keys = list(keys)[:n_real]\n   399\t    acoustic_at = {\"P\": set(int(k) for k in acoustic_cols),\n   400\t                   \"E\": set(int(k) for k in e_acoustic_cols)}\n   401\t    zero_wanted = bool(acoustic_at[\"P\"] | acoustic_at[\"E\"]) and 0 in (\n   402\t        acoustic_at[\"P\"] | acoustic_at[\"E\"])\n   403\t\n   404\t    with torch.no_grad():\n   405\t        aligned0 = model.shift_and_align(ref_irs, src_loc, ref_locs)\n   406\t        out_0, _ = model(depth_coord, ref_irs, src_loc, ref_locs, tgt_wav)\n   407\t    # Everything below is per-sample, so dropping the padded rows here is exact and\n   408\t    # keeps the (CPU-bound) Griffin-Lim off rows that would be discarded anyway.\n   409\t    out_0, tgt_real = out_0[:n_real], tgt_wav[:n_real]\n   410\t\n   411\t    results = {}\n   412\t    acoustic_0 = None\n   413\t    for k in cols:\n   414\t        out_p, out_e, tgt_spec = forward_conditions(\n   415\t            model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, k, aligned0)\n   416\t        out_p, out_e, tgt_spec = out_p[:n_real], out_e[:n_real], tgt_spec[:n_real]\n   417\t        for condition, pred in ((\"P\", out_p), (\"E\", out_e)):\n   418\t            cell = {name: value.double().numpy()\n   419\t                    for name, value in spectral_metrics(pred, out_0, tgt_spec).items()}\n   420\t            if int(k) == 0 and zero_wanted:\n   421\t                if acoustic_0 is None:\n   422\t                    acoustic_0 = acoustic_metrics_batch(pred, tgt_real, keys, evaluator,\n   423\t                                                        gl_seed)\n   424\t                cell.update({name: value.copy() for name, value in acoustic_0.items()})\n   425\t            elif int(k) in acoustic_at[condition]:\n   426\t                cell.update(acoustic_metrics_batch(pred, tgt_real, keys, evaluator, gl_seed))\n   427\t            results[(condition, int(k))] = cell\n   428\t    return keys, results, delay_flip_counts(src_loc[:n_real], ref_locs[:n_real], cols)\n   429\t\n   430\t\n   431\tdef set_precision(tf32):\n   432\t    \"\"\"Pin the TF32 policy of both cuBLAS and cuDNN for the whole run.\n   433\t\n   434\t    cuDNN's ``allow_tf32`` defaults to ``True``, and the reference-RIR encoder is a\n   435\t    ResNet-18, so leaving it on makes the forward pass depend on the batch size at the\n   436\t    1e-4 (relative) level -- measured on 8 real queries: max ``|d|`` 2.3e-4 with TF32 on\n   437\t    versus 2.4e-7 with it off.  That is far above the effects this experiment measures,\n   438\t    so TF32 is off by default and the choice is recorded in the run's meta block.\n   439\t\n   440\t    Args:\n   441\t        tf32: whether to allow TF32 for matmuls and convolutions.\n   442\t    \"\"\"\n   443\t    torch.backends.cuda.matmul.allow_tf32 = bool(tf32)\n   444\t    torch.backends.cudnn.allow_tf32 = bool(tf32)\n","exit_code":0,"duration":{"secs":0,"nanos":4744},"formatted_output":"    79\tdef forward_conditions(model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, k, aligned0):\n    80\t    \"\"\"Both experimental conditions of one batch at one angle.\n    81\t\n    82\t    Args:\n    83\t        model: an ``xRIR`` (or ``xRIR_Cyl``) in ``eval()`` mode on CUDA.\n    84\t        depth_coord: **unrotated** panorama coordinates ``[B, 3, H, W]``; the rotation is\n    85\t            applied here so P and E cannot accidentally see different geometry.\n    86\t        ref_irs: reference RIRs ``[B, K, L]`` (never rotated -- the acoustics are invariant).\n    87\t        src_loc: unrotated query-source position ``[B, 3]``.\n    88\t        ref_locs: unrotated reference-source positions ``[B, K, 3]``.\n    89\t        tgt_wav: target RIR ``[B, 1, L]``.\n    90\t        k: integer column roll.\n    91\t        aligned0: the ``k = 0`` aligned reference audio, i.e.\n    92\t            ``model.shift_and_align(ref_irs, src_loc, ref_locs)`` computed once per batch;\n    93\t            condition P is forced to use it at every angle.\n    94\t\n    95\t    Returns:\n    96\t        ``(out_P, out_E, tgt_spec)`` -- two ``[B, F, T, 1]`` log-magnitude spectrograms and\n    97\t        the shared ``[B, 1, F, T]`` target magnitude spectrogram.  At ``k = 0`` both\n    98\t        outputs equal the plain forward exactly.\n    99\t    \"\"\"\n   100\t    depth_k, src_k, ref_locs_k = rotated_views(depth_coord, src_loc, ref_locs, k)\n   101\t    with torch.no_grad():\n   102\t        with fixed_alignment(model, aligned0):\n   103\t            out_p, tgt_spec = model(depth_k, ref_irs, src_k, ref_locs_k, tgt_wav)\n   104\t        out_e, _ = model(depth_k, ref_irs, src_k, ref_locs_k, tgt_wav)\n   105\t    return out_p, out_e, tgt_spec\n   106\t\n   107\t\n   108\tdef spectral_metrics(out_k, out_0, tgt_spec):\n   109\t    \"\"\"The five per-sample spectral metrics of one batch at one angle.\n   110\t\n   111\t    Args:\n   112\t        out_k: predicted log-magnitude spectrograms at the angle, ``[B, F, T, 1]``.\n   113\t        out_0: the same batch's ``k = 0`` prediction, ``[B, F, T, 1]`` -- the paired\n   114\t            reference for ``consistency``.\n   115\t        tgt_spec: target magnitude spectrograms ``[B, 1, F, T]``.\n   116\t\n   117\t    Returns:\n   118\t        ``{\"loss\", \"stft\", \"decay\", \"log_mse\", \"consistency\"}``, each a detached CPU\n   119\t        float32 tensor of shape ``[B]``:\n   120\t\n   121\t        * ``loss``/``stft``/``decay`` -- ``tools.per_sample_metrics.per_sample_losses``,\n   122\t          i.e. exp_01's test loss and its two halves, computed on 1-sample slices;\n   123\t        * ``log_mse`` -- the per-sample form of exp_01's\n   124\t          ``Evaluator.stft_loss(out_spec.squeeze(-1), log(tgt_spec + 1e-8).squeeze(1))``;\n   125\t        * ``consistency`` -- ``mean |out_k - out_0|`` over the log-spectrogram, exactly\n   126\t          ``0`` at ``k = 0``.\n   127\t    \"\"\"\n   128\t    loss, stft, decay = per_sample_losses(out_k, tgt_spec)\n   129\t    with torch.no_grad():\n   130\t        log_tgt = torch.log(tgt_spec[:, 0] + 1e-8)\n   131\t        log_mse = ((out_k[..., 0] - log_tgt) ** 2).flatten(1).mean(dim=1)\n   132\t        consistency = (out_k - out_0).abs().flatten(1).mean(dim=1)\n   133\t    return {\"loss\": loss, \"stft\": stft, \"decay\": decay,\n   134\t            \"log_mse\": log_mse.detach().cpu().float(),\n   135\t            \"consistency\": consistency.detach().cpu().float()}\n   136\t\n   137\t\n   138\tdef acoustic_metrics_batch(out_k, tgt_wav, query_keys, evaluator, gl_seed):\n   139\t    \"\"\"EDT / C50 / T60 errors of one batch, sample by sample.\n   140\t\n   141\t    The magnitude spectrogram is rebuilt exactly as ``eval_xRIR_backbone.py`` does\n   142\t    (``(exp(out) - 1e-8)[..., 0]``) and inverted with a Griffin-Lim whose random phase\n   143\t    is seeded from ``(gl_seed, query key)``, so the same query inverts the same\n   144\t    magnitudes to the same waveform at every angle, in every model and in any angle\n   145\t    order.  The 8000-sample metric window is applied inside\n   146\t    ``tools.per_sample_metrics.acoustic_metrics``.\n   147\t\n   148\t    Args:\n   149\t        out_k: predicted log-magnitude spectrograms ``[B, F, T, 1]`` (CPU or CUDA).\n   150\t        tgt_wav: target RIRs ``[B, 1, L]``.\n   151\t        query_keys: the ``B`` query paths, in batch order.\n   152\t        evaluator: an ``eval_unseen.Evaluator``.\n   153\t        gl_seed: run-level Griffin-Lim seed.\n   154\t\n   155\t    Returns:\n   156\t        ``{\"edt\", \"c50\", \"t60\"}``, each a float64 ``np.ndarray`` of shape ``[B]`` with\n   157\t        NaN where the sample is invalid at this angle.\n   158\t\n   159\t    Raises:\n   160\t        ValueError: if ``query_keys`` does not have one key per row of ``out_k``.\n   161\t    \"\"\"\n   162\t    if len(query_keys) != out_k.shape[0]:\n   163\t        raise ValueError(\"got {} query keys for a batch of {}\".format(\n   164\t            len(query_keys), out_k.shape[0]))\n   165\t    values = {\"edt\": [], \"c50\": [], \"t60\": []}\n   166\t    for i in range(out_k.shape[0]):\n   167\t        mag = (torch.exp(out_k[i:i + 1]) - 1e-8)[..., 0].cpu()\n   168\t        wav = griffin_lim_seeded(mag, sample_seed(gl_seed, query_keys[i]))\n   169\t        sample = acoustic_metrics(wav[0].numpy(), tgt_wav[i, 0].cpu().numpy(), evaluator)\n   170\t        for name in values:\n   171\t            values[name].append(sample[name])\n   172\t    return {name: np.asarray(vals, dtype=np.float64) for name, vals in values.items()}\n   173\t\n   174\t\n   175\tdef delay_flip_counts(src_loc, ref_locs, cols):\n   176\t    \"\"\"Count the integer direct-path delays a rotation moves, per angle.\n   177\t\n   178\t    ``xRIR.shift_and_align`` is algebraically yaw-invariant, but its float32 norms and\n   179\t    ``torch.round`` are not: a delay sitting on a rounding tie can move by one sample\n   180\t    under an exactly norm-preserving rotation.  This audit quantifies that noise floor\n   181\t    over the real geometry -- it is what condition P exists to exclude.\n   182\t\n   183\t    Args:\n   184\t        src_loc: query-source positions ``[B, 3]``.\n   185\t        ref_locs: reference-source positions ``[B, K, 3]``.\n   186\t        cols: iterable of integer column rolls.\n   187\t\n   188\t    Returns:\n   189\t        ``{k: count}`` -- the number of ``(sample, reference)`` pairs (out of ``B * K``)\n   190\t        whose integer delay differs between the rotated and the unrotated coordinates.\n   191\t        ``k = 0`` is always ``0``.\n   192\t    \"\"\"\n   193\t    baseline = integer_delays(src_loc, ref_locs)\n   194\t    counts = {}\n   195\t    for k in cols:\n   196\t        angle = yaw_angle_rad(k)\n   197\t        rotated = integer_delays(rotate_vectors_z(src_loc, angle),\n   198\t                                 rotate_vectors_z(ref_locs, angle))\n   199\t        counts[int(k)] = int((rotated != baseline).sum())\n   200\t    return counts\n   201\t\n   202\t\n   203\tdef _rel_change(rotated, base):\n   204\t    \"\"\"``mean|rotated - base| / mean|base|`` as a Python float.\"\"\"\n   205\t    denom = base.abs().mean()\n   206\t    return float((rotated - base).abs().mean() / denom)\n   207\t\n   208\t\n   329\tdef pad_batch(batch, batch_size):\n   330\t    \"\"\"Repeat a short batch's rows so it is computed at exactly ``batch_size`` samples.\n   331\t\n   332\t    cuBLAS and cuDNN pick their algorithm -- and therefore their reduction order -- from\n   333\t    the *shape*, so a query's prediction depends on how many samples share its batch:\n   334\t    measured on a trained checkpoint, the same query evaluated alone and inside a batch\n   335\t    of 16 differs by 4.8e-5 in the log-spectrogram.  The split is 6337 = 396 * 16 + 1, so\n   336\t    without padding the last query would be the only one computed at a different shape.\n   337\t    Repeating rows (wrap-around) keeps the shape canonical; the padded rows are dropped\n   338\t    before anything is recorded, and because every op here is row-independent the kept\n   339\t    rows are bit-identical to their values in a full batch.\n   340\t\n   341\t    Args:\n   342\t        batch: the ``ManifestDataset`` seven-tuple, collated (six tensors + the key list).\n   343\t        batch_size: the canonical number of rows, or ``None`` to leave the batch alone.\n   344\t\n   345\t    Returns:\n   346\t        ``(padded_batch, n_real)``; the input object itself when no padding is needed.\n   347\t\n   348\t    Raises:\n   349\t        ValueError: if the batch already has more rows than ``batch_size``.\n   350\t    \"\"\"\n   351\t    n_real = len(batch[-1])\n   352\t    if batch_size is None or n_real == int(batch_size):\n   353\t        return batch, n_real\n   354\t    if n_real > int(batch_size):\n   355\t        raise ValueError(\"batch of {} rows exceeds the canonical size {}\".format(\n   356\t            n_real, batch_size))\n   357\t    order = [i % n_real for i in range(int(batch_size))]\n   358\t    index = torch.as_tensor(order, dtype=torch.long)\n   359\t    padded = tuple(item[index] if torch.is_tensor(item) else [item[i] for i in order]\n   360\t                   for item in batch)\n   361\t    return padded, n_real\n   362\t\n   363\t\n   364\tdef evaluate_batch(model, batch, evaluator, cols, acoustic_cols=(), e_acoustic_cols=(),\n   365\t                   gl_seed=0, batch_size=None):\n   366\t    \"\"\"Every per-sample metric of one collated batch, at every angle in ``cols``.\n   367\t\n   368\t    The whole batch is moved to the GPU once and the ``k = 0`` alignment and prediction\n   369\t    are computed once, so the angles share exactly one paired reference.  Nothing in the\n   370\t    loop depends on the order of ``cols`` or on which angles came before: the Griffin-Lim\n   371\t    phase is seeded per query, so the result is a pure function of\n   372\t    ``(model, batch, cols, gl_seed)``.\n   373\t\n   374\t    Args:\n   375\t        model: an ``xRIR`` on CUDA in ``eval()`` mode.\n   376\t        batch: the ``ManifestDataset`` seven-tuple, collated.\n   377\t        evaluator: an ``eval_unseen.Evaluator``.\n   378\t        cols: integer column rolls to evaluate (spectral metrics at every one).\n   379\t        acoustic_cols: the subset of ``cols`` that also gets EDT / C50 / T60 under\n   380\t            condition P; ``e_acoustic_cols`` is the same for condition E.  At ``k = 0``\n   381\t            the two conditions are the same prediction, so the acoustic metrics are\n   382\t            computed once and stored under both.\n   383\t        gl_seed: run-level Griffin-Lim seed.\n   384\t        batch_size: the canonical compute shape (see :func:`pad_batch`).  A short batch\n   385\t            is padded to it for the forward passes and the padded rows are dropped before\n   386\t            any metric is computed, so the recorded values do not depend on how many\n   387\t            queries happened to share the batch.\n   388\t\n   389\t    Returns:\n   390\t        ``(query_keys, results, delay_flips)`` where ``results[(condition, k)]`` maps a\n   391\t        metric name to a float64 ``np.ndarray`` of shape ``[n_real]``, and ``delay_flips``\n   392\t        maps each ``k`` to the number of flipped ``(sample, reference)`` delays.\n   393\t    \"\"\"\n   394\t    batch, n_real = pad_batch(batch, batch_size)\n   395\t    _, src_loc, depth_coord, tgt_wav, ref_irs, ref_locs, keys = batch\n   396\t    src_loc, depth_coord = src_loc.cuda(), depth_coord.cuda()\n   397\t    tgt_wav, ref_irs, ref_locs = tgt_wav.cuda(), ref_irs.cuda(), ref_locs.cuda()\n   398\t    keys = list(keys)[:n_real]\n   399\t    acoustic_at = {\"P\": set(int(k) for k in acoustic_cols),\n   400\t                   \"E\": set(int(k) for k in e_acoustic_cols)}\n   401\t    zero_wanted = bool(acoustic_at[\"P\"] | acoustic_at[\"E\"]) and 0 in (\n   402\t        acoustic_at[\"P\"] | acoustic_at[\"E\"])\n   403\t\n   404\t    with torch.no_grad():\n   405\t        aligned0 = model.shift_and_align(ref_irs, src_loc, ref_locs)\n   406\t        out_0, _ = model(depth_coord, ref_irs, src_loc, ref_locs, tgt_wav)\n   407\t    # Everything below is per-sample, so dropping the padded rows here is exact and\n   408\t    # keeps the (CPU-bound) Griffin-Lim off rows that would be discarded anyway.\n   409\t    out_0, tgt_real = out_0[:n_real], tgt_wav[:n_real]\n   410\t\n   411\t    results = {}\n   412\t    acoustic_0 = None\n   413\t    for k in cols:\n   414\t        out_p, out_e, tgt_spec = forward_conditions(\n   415\t            model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, k, aligned0)\n   416\t        out_p, out_e, tgt_spec = out_p[:n_real], out_e[:n_real], tgt_spec[:n_real]\n   417\t        for condition, pred in ((\"P\", out_p), (\"E\", out_e)):\n   418\t            cell = {name: value.double().numpy()\n   419\t                    for name, value in spectral_metrics(pred, out_0, tgt_spec).items()}\n   420\t            if int(k) == 0 and zero_wanted:\n   421\t                if acoustic_0 is None:\n   422\t                    acoustic_0 = acoustic_metrics_batch(pred, tgt_real, keys, evaluator,\n   423\t                                                        gl_seed)\n   424\t                cell.update({name: value.copy() for name, value in acoustic_0.items()})\n   425\t            elif int(k) in acoustic_at[condition]:\n   426\t                cell.update(acoustic_metrics_batch(pred, tgt_real, keys, evaluator, gl_seed))\n   427\t            results[(condition, int(k))] = cell\n   428\t    return keys, results, delay_flip_counts(src_loc[:n_real], ref_locs[:n_real], cols)\n   429\t\n   430\t\n   431\tdef set_precision(tf32):\n   432\t    \"\"\"Pin the TF32 policy of both cuBLAS and cuDNN for the whole run.\n   433\t\n   434\t    cuDNN's ``allow_tf32`` defaults to ``True``, and the reference-RIR encoder is a\n   435\t    ResNet-18, so leaving it on makes the forward pass depend on the batch size at the\n   436\t    1e-4 (relative) level -- measured on 8 real queries: max ``|d|`` 2.3e-4 with TF32 on\n   437\t    versus 2.4e-7 with it off.  That is far above the effects this experiment measures,\n   438\t    so TF32 is off by default and the choice is recorded in the run's meta block.\n   439\t\n   440\t    Args:\n   441\t        tf32: whether to allow TF32 for matmuls and convolutions.\n   442\t    \"\"\"\n   443\t    torch.backends.cuda.matmul.allow_tf32 = bool(tf32)\n   444\t    torch.backends.cudnn.allow_tf32 = bool(tf32)\n"},"started_at_ms":1790458719835,"completed_at_ms":1790458719835}}
/home/yixunhu/.codex/sessions/2026/09/26/rollout-2026-09-26T17-38-09-01a0dfa7-77ae-7b52-839b-bcc58738f2e6.jsonl:69:{"timestamp":"2026-09-26T21:38:39.848Z","ordinal":68,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0dfa7-ee68-7612-9f88-95b6f524f22b","call_id":"call_s1gAtBSoPRhzygJ52cNMVmg0","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"Warning: truncated output (original token count: 10312)\nTotal output lines: 3\n\n{\"label\":\"flac metrics\",\"output\":\"     1\\timport torch\\n     2\\timport pyroomacoustics\\n     3\\tfrom torchmetrics import Metric\\n     4\\t\\n     5\\tclass RT60Error(Metric):\\n     6\\t    def __init__(self, \\n     7\\t                 fs=22050,\\n     8\\t                 n_audio_ch=1, \\n     9\\t                 dataset_name='AcousticRooms',\\n    10\\t                 name=\\\"RT60Error\\\", \\n    11\\t                 **kwargs):\\n    12\\t        super().__init__(**kwargs)\\n    13\\t\\n    14\\t        self.add_state(\\\"t60_error\\\", default=[], dist_reduce_fx=\\\"cat\\\")\\n    15\\t        self.add_state(\\\"total_invalids\\\", default=[], dist_reduce_fx=\\\"cat\\\")\\n    16\\t        self.fs = fs    \\n    17\\t        self.n_audio_ch = n_audio_ch\\n    18\\t        \\n    19\\t        self.dataset = dataset_name\\n    20\\t\\n    21\\t        # Following xRIR code \\n    22\\t        if self.dataset == 'AcousticRooms':\\n    23\\t            self.decay_db = 20\\n    24\\t        elif self.dataset == 'HAA': \\n    25\\t            self.decay_db = 30\\n    26\\t        else:\\n    27\\t            raise NotImplementedError(f\\\"Dataset {self.dataset} not recognized for RT60 computation.\\\")\\n    28\\t\\n    29\\t    def compute_t60(self, wav_gt_ff, wav_prd):\\n    30\\t        t60s_gt = _mesure_rt60_pyroomacoustics(wav_gt_ff, fs=self.fs, decay_db=self.decay_db)\\n    31\\t        t60s_prd = _mesure_rt60_pyroomacoustics(wav_prd, fs=self.fs, decay_db=self.decay_db)\\n    32\\t        return t60s_gt, t60s_prd\\n    33\\t\\n    34\\t    def compute(self):\\n    35\\t        mean_t60error = torch.mean(torch.cat(self.t60_error)) if isinstance(self.t60_error, list) else torch.mean(self.t60_error)\\n    36\\t        mean_invalids = torch.mean(torch.cat(self.total_invalids)) if isinstance(self.total_invalids, list) else torch.mean(self.total_invalids)\\n    37\\t        mean_t60error = round(mean_t60error.item(), 4)\\n    38\\t        return mean_t60error, mean_invalids.item()\\n    39\\t    \\n    40\\t    def reset(self):\\n    41\\t        self.t60_error = []\\n    42\\t        self.total_invalids = []\\n    43\\t        \\n    44\\t    def update(self, wav_prd, wav_gt_ff):\\n    45\\t        t60s_gt, t60s_prd = self.compute_t60(wav_gt_ff, wav_prd)\\n    46\\t        t60s = torch.cat((t60s_gt, t60s_prd), dim=-1)  # Shape [B, 2 * n_ch]\\n    47\\t\\n    48\\t        # Diff Rel \\n    49\\t        diff = torch.abs(t60s[...,self.n_audio_ch:] - t60s[...,:self.n_audio_ch]) / torch.abs(t60s[...,:self.n_audio_ch])\\n    50\\t\\n    51\\t        if self.dataset == 'AcousticRooms':\\n    52\\t            diff = diff.mean(dim=1) * 100\\n    53\\t            self.t60_error.append(diff)\\n    54\\t            device = t60s_gt.device\\n    55\\t            self.total_invalids.append(torch.tensor([0.0], device=device))\\n    56\\t        else:\\n    57\\t            mask = (t60s < -0.5).any(dim=1)\\n    58\\t            diff_mean = diff.mean(dim=1)  # Mean error per audio \\n    59\\t            diff_mean[mask] = 1.0  # Assign max error to invalid samples\\n    60\\t            mean_t60error = diff_mean * 100  # Convert to percentage\\n    61\\t            invalid = mask.sum().expand_as(mean_t60error).float()  # Count invalid samples\\n    62\\t            self.t60_error.append(mean_t60error)\\n    63\\t            self.total_invalids.append(invalid)\\n    64\\t        \\n    65\\tdef _mesure_rt60_pyroomacoustics(signal, fs, decay_db=30):\\n    66\\t    device = signal.device\\n    67\\t    B, C, T = signal.shape\\n    68\\t    if B > 1:\\n    69\\t        raise ValueError(\\\"Only one channel is supported, use torch version for batch processing.\\\")\\n    70\\t    signal = signal.squeeze(0).cpu().numpy()\\n    71\\t    t60s = []\\n    72\\t    for c in range(C):\\n    73\\t        try:\\n    74\\t            T60 = pyroomacoustics.experimental.measure_rt60(signal[c], fs=fs, decay_db=decay_db)\\n    75\\t        except ValueError:\\n    76\\t            T60 = -1\\n    77\\t        t60s.append(T60)\\n    78\\t    t60s = torch.tensor(t60s, device=device).unsqueeze(0)\\n    79\\t    return t60s\\n    80\\t\\n    81\\tdef _measure_rt60_torch(h, fs=1, decay_db=60, energy_thres=1.0):\\n    82\\t    \\\"\\\"\\\"\\n    83\\t    Torch implementation of T60 computation. Allows batch processing.\\n    84\\t    \\\"\\\"\\\"\\n    85\\t    power = h ** 2  # Compute power\\n    86\\t    energy = torch.flip(torch.cumsum(torch.flip(power, dims=[-1]), dim=-1), dims=[-1])  # Schroeder integration\\n    87\\t    \\n    88\\t    if energy_thres < 1.0:\\n    89\\t        assert 0.0 < energy_thres < 1.0\\n    90\\t        energy = energy - energy[..., :1] * (1.0 - energy_thres)\\n    91\\t        energy = torch.clamp(energy, min=0.0)\\n    92\\t    \\n    93\\t    # Find the last non-zero index\\n    94\\t    mask = energy > 0\\n    95\\t    i_nz = torch.max(mask * torch.arange(energy.shape[-1], device=h.device), dim=-1).values\\n    96\\t    energy_db = 10 * torch.log10(energy + 1e-10)\\n    97\\t    energy_db = energy_db - energy_db[..., :1]\\n    98\\t    \\n    99\\t    min_energy_db = -torch.min(energy_db, dim=-1).values\\n   100\\t    decay_db = torch.minimum(decay_db * torch.ones_like(min_energy_db), min_energy_db - 5)\\n   101\\t    \\n   102\\t    # Find index where energy drops below -5 dB\\n   103\\t    mask_5db = energy_db < -5\\n   104\\t    i_5db = torch.where(mask_5db, torch.arange(energy.shape[-1], device=h.device), energy.shape[-1]).min(dim=-1).values\\n   105\\t    t_5db = i_5db / fs\\n   106\\t    \\n   107\\t    # Find index where energy drops below -5 - decay_db\\n   108\\t    mask_decay = energy_db < (-5 - decay_db.unsqueeze(-1))\\n   109\\t    i_decay = torch.where(mask_decay, torch.arange(energy.shape[-1], device=h.device), energy.shape[-1]).min(dim=-1).values\\n   110\\t    t_decay = i_decay / fs\\n   111\\t    \\n   112\\t    # Compute T60\\n   113\\t    decay_time = t_decay - t_5db\\n   114\\t    est_rt60 = (60.0 / decay_db) * decay_time\\n   115\\t    return est_rt60\\n     1\\timport torch\\n     2\\timport numpy as np\\n     3\\tfrom torchmetrics import Metric\\n     4\\t\\n     5\\tclass C50(Metric):\\n     6\\t    def __init__(self, \\n     7\\t                 fs=22050,\\n     8\\t                 n_audio_ch=1, \\n     9\\t                 name=\\\"C50\\\", \\n    10\\t                 **kwargs):\\n    11\\t        super().__init__(**kwargs)\\n    12\\t\\n    13\\t        self.add_state(\\\"c50\\\", default=[], dist_reduce_fx=\\\"cat\\\")\\n    14\\t        self.fs = fs    \\n    15\\t        self.n_audio_ch = n_audio_ch\\n    16\\t    \\n    17\\t    def compute_c50(self, wav_prd, wav_gt_ff):\\n    18\\t        c50_gt = _measure_clarity(wav_gt_ff, fs=self.fs)\\n    19\\t        c50_prd = _measure_clarity(wav_prd, fs=self.fs)\\n    20\\t        return c50_gt, c50_prd\\n    21\\t\\n    22\\t    def compute(self):\\n    23\\t        mean_c50 = torch.mean(torch.cat(self.c50)) if isinstance(self.c50, list) else torch.mean(self.c50)\\n    24\\t        mean_c50 = round(mean_c50.item(), 4)\\n    25\\t        return mean_c50\\n    26\\t\\n    27\\t    def reset(self):\\n    28\\t        self.c50 = []\\n    29\\t        \\n    30\\t    def update(self, wav_prd, wav_gt_ff):\\n    31\\t        c50_gt, c50_prd = self.compute_c50(wav_prd, wav_gt_ff)\\n    32\\t        c50_instance = torch.abs(c50_prd - c50_gt)  # Shape [B, n_ch])\\n    33\\t        mean_c50 = torch.mean(c50_instance, dim=1)  # Shape [B]\\n    34\\t        self.c50.append(mean_c50)\\n    35\\t\\n    36\\tdef _measure_clarity(h, time=50, fs=22050):\\n    37\\t    device = h.device\\n    38\\t    B, C, T = h.shape\\n    39\\t    if B > 1:\\n    40\\t        raise ValueError(\\\"Only one channel is supported, use torch version for batch processing.\\\")\\n    41\\t    signal = h.squeeze(0).cpu().numpy()\\n    42\\t    C50s = []\\n    43\\t    for c in range(C):\\n    44\\t        C50 = _c50(signal[c], time=time, fs=fs)\\n    45\\t        C50s.append(C50)\\n    46\\t    C50s = torch.tensor(C50s, device=device).unsqueeze(0)\\n    47\\t    return C50s\\n    48\\t\\n    49\\tdef _c50(signal, time=50, fs=22050):\\n    50\\t    h2 = signal**2\\n    51\\t    t = int((time/1000)*fs + 1) \\n    52\\t    c50 = 10*np.log10((np.sum(h2[:t])/np.sum(h2[t:])) + 1e-10)\\n    53\\t    return c50\\n    54\\t\\n    55\\tdef measure_clarity_torch(signal, time=50, fs=22050):\\n    56\\t    \\\"\\\"\\\"\\n    57\\t    C50 calculation with torch that supports batch processing.\\n    58\\t    \\\"\\\"\\\"\\n    59\\t    h2 = signal ** 2  # Shape [B, n_ch, n_time]\\n    60\\t    t = int((time / 1000) * fs)  \\n    61\\t\\n    62\\t    early_energy = torch.sum(h2[..., :t], dim=-1)  \\n    63\\t    late_energy = torch.sum(h2[..., t:], dim=-1)  \\n    64\\t\\n    65\\t    c50 = 10 * torch.log10(torch.clamp(early_energy / late_energy, min=1e-10))\\n    66\\t    return c50 \\n     1\\timport torch\\n     2\\tfrom torchmetrics import Metric\\n     3\\timport numpy as np\\n     4\\t\\n     5\\tclass EDT(Metric):\\n     6\\t    def __init__(self, \\n     7\\t                 fs=22050, \\n     8\\t                 n_audio_ch=1, \\n     9\\t                 name=\\\"EDT\\\", \\n    10\\t                 **kwargs):\\n    11\\t        super().__init__(**kwargs)\\n    12\\t\\n    13\\t        self.add_state(\\\"edt_error\\\", default=[], dist_reduce_fx=\\\"cat\\\")\\n    14\\t        self.fs = fs    \\n    15\\t        self.n_audio_ch = n_audio_ch\\n    16\\t    \\n    17\\t    def compute_edt(self, wav_prd, wav_gt_ff):\\n    18\\t        edt_gt = _measure_edt(wav_gt_ff, fs=self.fs)\\n    19\\t        edt_prd = _measure_edt(wav_prd, fs=self.fs)\\n    20\\t        return edt_gt, edt_prd\\n    21\\t\\n    22\\t    def compute(self, stats=False):\\n    23\\t        mean_edt = torch.mean(torch.cat(self.edt_error)) if isinstance(self.edt_error, list) else torch.mean(self.edt_error)\\n    24\\t        mean_edt = mean_edt * 1000 # s to ms \\n    25\\t        mean_edt = round(mean_edt.item(), 4)\\n    26\\t        return mean_edt\\n    27\\t\\n    28\\t    def reset(self):\\n    29\\t        self.edt_error = []\\n    30\\t        \\n    31\\t    def update(self, wav_prd, wav_gt_ff):\\n    32\\t        edt_gt, edt_prd = self.compute_edt(wav_prd, wav_gt_ff)\\n    33\\t        edt_error = torch.abs(edt_prd - edt_gt)  \\n    34\\t        mean_edt = torch.mean(edt_error, dim=1) \\n    35\\t        self.edt_error.append(mean_edt)\\n    36\\t\\n    37\\tdef _measure_edt(h, fs=22050):\\n    38\\t    device = h.device   \\n    39\\t    B, C, T = h.shape\\n    40\\t    if B > 1:\\n    41\\t        raise ValueError(\\\"Only one channel is supported\\\")\\n    42\\t    signal = h.squeeze(0).cpu().numpy()\\n    43\\t    EDTs = []\\n    44\\t    for c in range(C):\\n    45\\t        EDT = _edt(signal[c], fs=fs)\\n    46\\t        EDTs.append(EDT)\\n    47\\t    EDTs = torch.tensor(EDTs, device=device).unsqueeze(0)\\n    48\\t    return EDTs\\n    49\\t\\n    50\\tdef _edt(h, fs=22050, decay_db=10):\\n    51\\t    h = np.array(h)\\n    52\\t    # check if h is only nans\\n    53\\t    if np.all(np.isnan(h)):\\n    54\\t        return np.nan\\n    55\\t    fs = float(fs)\\n    56\\t    # The power of the impulse response in dB\\n    57\\t    power = h ** 2\\n    58\\t    energy = np.cumsum(power[::-1])[::-1]  # Integration according to Schroeder\\n    59\\t\\n    60\\t    # remove the possibly all zero tail\\n    61\\t    if np.all(energy == 0):\\n    62\\t        return np.nan\\n    63\\t\\n    64\\t    if np.where(energy > 0)[0].shape[0] == 0:\\n    65\\t        return np.nan\\n    66\\t    \\n    67\\t    i_nz = np.max(np.where(energy > 0)[0])\\n    68\\t    energy = energy[:i_nz]\\n    69\\t    energy_db = 10 * np.log10(energy)\\n    70\\t    energy_db -= energy_db[0]\\n    71\\t\\n    72\\t    i_decay = np.min(np.where(- decay_db - energy_db > 0)[0])\\n    73\\t    t_decay = i_decay / fs\\n    74\\t    # compute the decay time\\n    75\\t    decay_time = t_decay\\n    76\\t    est_edt = (60 / decay_db) * decay_time \\n    77\\t\\n    78\\t    return est_edt\\n\"}\n{\"label\":\"eval portions\",\"output\":\"    79\\tdef forward_conditions(model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, k, aligned0):\\n    80\\t    \\\"\\\"\\\"Both experimental conditions of one batch at one angle.\\n    81\\t\\n    82\\t    Args:\\n    83\\t        model: an ``xRIR`` (or ``xRIR_Cyl``) in ``eval()`` mode on CUDA.\\n    84\\t        depth_coord: **unrotated** panorama coordinates ``[B, 3, H, W]``; the rotation is\\n    85\\t            applied here so P and E cannot accidentally see different geometry.\\n    86\\t        ref_irs: reference RIRs ``[B, K, L]`` (never rotated -- the acoustics are invariant).\\n    87\\t        src_loc: unrotated query-source position ``[B, 3]``.\\n    88\\t        ref_locs: unrotated reference-source positions ``[B, K, 3]``.\\n    89\\t        tgt_wav: target RIR ``[B, 1, L]``.\\n    90\\t        k: integer column roll.\\n    91\\t        aligned0: the ``k = 0`` aligned reference audio, i.e.\\n    92\\t            ``model.shift_and_align(ref_irs, src_loc, ref_locs)`` computed once per batch;\\n    93\\t            condition P is forced to use it at every angle.\\n    94\\t\\n    95\\t    Returns:\\n    96\\t        ``(out_P, out_E, tgt_spec)`` -- two ``[B, F, T, 1]`` log-magnitude spectrograms and\\n    97\\t        the shared ``[B, 1, F, T]`` target magnitude spectrogram.  At ``k = 0`` both\\n    98\\t        outputs equal the plain forward exactly.\\n    99\\t    \\\"\\\"\\\"\\n   100\\t    depth_k, src_k, ref_locs_k = rotated_views(depth_coord, src_loc, ref_locs, k)\\n   101\\t    with torch.no_grad():\\n   102\\t        with fixed_alignment(model, aligned0):\\n   103\\t            out_p, tgt_spec = model(depth_k, ref_irs, src_k, ref_locs_k, tgt_wav)\\n   104\\t        out_e, _ = model(depth_k, ref_irs, src_k, ref_locs_k, tgt_wav)\\n   105\\t    return out_p, out_e, tgt_spec\\n   106\\t\\n   107\\t\\n   108\\tdef spectral_metrics(out_k, out_0, tgt_spec):\\n   109\\t    \\\"\\\"\\\"The five per-sample spectral metrics of one batch at one angle.\\n   110\\t\\n   111\\t    Args:\\n   112\\t        out_k: predicted log-magnitude spectrograms at the angle, ``[B, F, T, 1]``.\\n   113\\t        out_0: the same batch's ``k = 0`` prediction, ``[B, F, T, 1]`` -- the paired\\n   114\\t            reference for ``consistency``.\\n   115\\t        tgt_spec: target magnitude spectrograms ``[B, 1, F, T]``.\\n   116\\t\\n   117\\t    Returns:\\n   118\\t        ``{\\\"loss\\\", \\\"stft\\\", \\\"decay\\\", \\\"log_mse\\\", \\\"consistency\\\"}``, each a detached CPU\\n   119\\t        float32 tensor of shape ``[B]``:\\n   120\\t\\n   121\\t        * ``loss``/``stft``/``decay`` -- ``tools.per_sample_metrics.per_sample_losses``,\\n   122\\t          i.e. exp_01's test loss and its two halves, computed on 1-sample slices;\\n   123\\t        * ``log_mse`` -- the per-sample form of exp_01's\\n   124\\t          ``Evaluator.stft_loss(out_spec.squeeze(-1), log(tgt_spec + 1e-8).squeeze(1))``;\\n   125\\t        * ``consistency`` -- ``mean |out_k - out_0|`` over the log-spectrogram, exactly\\n   126\\t          ``0`` at ``k = 0``.\\n   127\\t    \\\"\\\"\\\"\\n   128\\t    loss, stft, decay = per_sample_losses(out_k, tgt_spec)\\n   129\\t    with torch.no_grad():\\n   130\\t        log_tgt = torch.log(tgt_spec[:, 0] + 1e-8)\\n   131\\t        log_mse = ((out_k[..., 0] - log_tgt) ** 2).flatten(1).mean(dim=1)\\n   132\\t        consistency = (out_k - out_0).abs().flatten(1).mean(dim=1)\\n   133\\t    return {\\\"loss\\\": loss, \\\"stft\\\": stft, \\\"decay\\\": decay,\\n   134\\t            \\\"log_mse\\\": log_mse.detach().cpu().float(),\\n   135\\t            \\\"consistency\\\": consistency.detach().cpu().float()}\\n   136\\t\\n   137\\t\\n   138\\tdef acoustic_metrics_batch(out_k, tgt_wav, query_keys, evaluator, gl_seed):\\n   139\\t    \\\"\\\"\\\"EDT / C50 / T60 errors of one batch, sample by sample.\\n   140\\t\\n   141\\t    The magnitude spectrogram is rebuilt exactly as ``eval_xRIR_backbone.py`` does\\n   142\\t    (``(exp(out) - 1e-8)[..., 0]``) and inverted with a Griffin-Lim whose random phase\\n   143\\t    is seeded from ``(gl_seed, query key)``, so the same query inverts the same\\n   144\\t    magnitudes to the same waveform at every angle, in every model and in any angle\\n   145\\t    order.  The 8000-sample metric window is applied inside\\n   146\\t    ``tools.per_sample_metrics.acoustic_metrics``.\\n   147\\t\\n   148\\t    Args:\\n   149\\t        out_k: predicted log-magnitude spectrograms ``[B, F, T, 1]`` (CPU or CUDA).\\n   150\\t        tgt_wav: target RIRs ``[B, 1, L]``.\\n   151\\t        query_keys: the ``B`` query paths, in batch order.\\n   152\\t        evaluator: an ``eval_unseen.Evaluator``.\\n   153\\t        gl_seed: run-level Griffin-Lim seed.\\n   154\\t\\n   155\\t    Returns:\\n   156\\t        ``{\\\"edt\\\", \\\"c50\\\", \\\"t60\\\"}``, each a float64 ``np.ndarray`` of shape ``[B]`` with\\n   157\\t        NaN where the sample is invalid at this angle.\\n   158\\t\\n   159\\t    Raises:\\n   160\\t        ValueError: if ``query_keys`` does not have one key per row of ``out_k``.\\n   161\\t    \\\"\\\"\\\"\\n   162\\t    if len(query_keys) != out_k.shape[0]:\\n   163\\t        raise ValueError(\\\"got {} query keys for a batch of {}\\\".format(\\n   164\\t            len(query_keys), out_k.shape[0]))\\n   165\\t    values = {\\\"edt\\\": [], \\\"c50\\\": [], \\\"t60\\\": []}\\n   166\\t    for i in range(out_k.shape[0]):\\n   167\\t        mag = (torch.exp(out_k[i:i + 1]) - 1e-8)[..., 0].cpu()\\n   168\\t        wav = griffin_lim_seeded(mag, sample_seed(gl_seed, query_keys[i]))\\n   169\\t        sample = acoustic_metrics(wav[0].numpy(), tgt_wav[i, 0].cpu().numpy(), evaluator)\\n   170\\t        for name in values:\\n   171\\t            values[name].append(sample[name])\\n   172\\t    return {name: np.asarray(vals, dtype=np.float64) for name, vals in values.items()}\\n   173\\t\\n   174\\t\\n   175\\tdef delay_flip_counts(src_loc, ref_locs, cols):\\n   176\\t    \\\"\\\"\\\"Count the integer direct-path delays a rotation moves, per angle.\\n   177\\t\\n   178\\t    ``xRIR.shift_and_align`` is algebraically yaw-invariant, but its float32 norms and\\n   179\\t    ``torch.round`` are not: a delay sitting on a rounding tie can move by one sample\\n   180\\t    under an exactly norm-preserving rotation.  This audit quantifies that noise floor\\n   181\\t    over the real geometry -- it is what condition P exists to exclude.\\n   182\\t\\n   183\\t    Args:\\n   184\\t        src_loc: query-source positions ``[B, 3]``.\\n   185\\t        ref_locs: reference-source positions ``[B, K, 3]``.\\n   186\\t        cols: iterable of integer column rolls.\\n   187\\t\\n   188\\t    Returns:\\n   189\\t        ``{k: count}`` -- the number of ``(sample, reference)`` pairs (out of ``B * K``)\\n   190\\t        whose integer delay differs between the rotated and the unrotated coordinates.\\n   191\\t        ``k = 0`` is always ``0``.\\n   192\\t    \\\"\\\"\\\"\\n   193\\t    baseline = integer_delays(src_loc, ref_locs)\\n   194\\t    counts = {}\\n   195\\t    for k in cols:\\n   196\\t        angle = yaw_angle_rad(k)\\n   197\\t        rotated = integer_delays(rotate_vectors_z(src_loc, angle),\\n   198\\t                                 rotate_vectors_z(ref_locs, angle))\\n   199\\t        counts[int(k)] = int((rotated != baseline).sum())\\n   200\\t    return counts\\n   201\\t\\n   202\\t\\n   203\\tdef _rel_change(rotated, base):\\n   204\\t    \\\"\\\"\\\"``mean|rotated - base| / mean|base|`` as a Python float.\\\"\\\"\\\"\\n   205\\t    denom = base.abs().mean()\\n   206\\t    return float((rotated - base).abs().mean() / denom)\\n   207\\t\\n   208\\t\\n   329\\tdef pad_batch(batch, batch_size):\\n   330\\t    \\\"\\\"\\\"Repeat a short batch's rows so it is computed at exactly ``batch_size`` samples.\\n   331\\t\\n   332\\t    cuBLAS and cuDNN pick their algorithm -- and therefore their reduction order -- from\\n   333\\t    the *shape*, so a query's prediction depends on how many samples share its batch:\\n   334\\t    measured on a trained checkpoint, the same query evaluated alone and inside a batch\\n   335\\t    of 16 differs by 4.8e-5 in the log-spectrogram.  The split is 6337 = 396 * 16 + 1, so\\n   336\\t    without padding the last query would be the only one computed at a different shape.\\n   337\\t    Repeating rows (wrap-around) keeps the shape canonical; the padded rows are dropped\\n   338\\t    before anything is recorded, and because every op here is row-independent the kept\\n   339\\t    rows are bit-identical to their values in a full batch.\\n   340\\t\\n   341\\t    Args:\\n   342\\t        batch: the ``ManifestDataset`` seven-tuple, collated (six tensors + the key lis…312 tokens truncated…`cols``.\\n   367\\t\\n   368\\t    The whole batch is moved to the GPU once and the ``k = 0`` alignment and prediction\\n   369\\t    are computed once, so the angles share exactly one paired reference.  Nothing in the\\n   370\\t    loop depends on the order of ``cols`` or on which angles came before: the Griffin-Lim\\n   371\\t    phase is seeded per query, so the result is a pure function of\\n   372\\t    ``(model, batch, cols, gl_seed)``.\\n   373\\t\\n   374\\t    Args:\\n   375\\t        model: an ``xRIR`` on CUDA in ``eval()`` mode.\\n   376\\t        batch: the ``ManifestDataset`` seven-tuple, collated.\\n   377\\t        evaluator: an ``eval_unseen.Evaluator``.\\n   378\\t        cols: integer column rolls to evaluate (spectral metrics at every one).\\n   379\\t        acoustic_cols: the subset of ``cols`` that also gets EDT / C50 / T60 under\\n   380\\t            condition P; ``e_acoustic_cols`` is the same for condition E.  At ``k = 0``\\n   381\\t            the two conditions are the same prediction, so the acoustic metrics are\\n   382\\t            computed once and stored under both.\\n   383\\t        gl_seed: run-level Griffin-Lim seed.\\n   384\\t        batch_size: the canonical compute shape (see :func:`pad_batch`).  A short batch\\n   385\\t            is padded to it for the forward passes and the padded rows are dropped before\\n   386\\t            any metric is computed, so the recorded values do not depend on how many\\n   387\\t            queries happened to share the batch.\\n   388\\t\\n   389\\t    Returns:\\n   390\\t        ``(query_keys, results, delay_flips)`` where ``results[(condition, k)]`` maps a\\n   391\\t        metric name to a float64 ``np.ndarray`` of shape ``[n_real]``, and ``delay_flips``\\n   392\\t        maps each ``k`` to the number of flipped ``(sample, reference)`` delays.\\n   393\\t    \\\"\\\"\\\"\\n   394\\t    batch, n_real = pad_batch(batch, batch_size)\\n   395\\t    _, src_loc, depth_coord, tgt_wav, ref_irs, ref_locs, keys = batch\\n   396\\t    src_loc, depth_coord = src_loc.cuda(), depth_coord.cuda()\\n   397\\t    tgt_wav, ref_irs, ref_locs = tgt_wav.cuda(), ref_irs.cuda(), ref_locs.cuda()\\n   398\\t    keys = list(keys)[:n_real]\\n   399\\t    acoustic_at = {\\\"P\\\": set(int(k) for k in acoustic_cols),\\n   400\\t                   \\\"E\\\": set(int(k) for k in e_acoustic_cols)}\\n   401\\t    zero_wanted = bool(acoustic_at[\\\"P\\\"] | acoustic_at[\\\"E\\\"]) and 0 in (\\n   402\\t        acoustic_at[\\\"P\\\"] | acoustic_at[\\\"E\\\"])\\n   403\\t\\n   404\\t    with torch.no_grad():\\n   405\\t        aligned0 = model.shift_and_align(ref_irs, src_loc, ref_locs)\\n   406\\t        out_0, _ = model(depth_coord, ref_irs, src_loc, ref_locs, tgt_wav)\\n   407\\t    # Everything below is per-sample, so dropping the padded rows here is exact and\\n   408\\t    # keeps the (CPU-bound) Griffin-Lim off rows that would be discarded anyway.\\n   409\\t    out_0, tgt_real = out_0[:n_real], tgt_wav[:n_real]\\n   410\\t\\n   411\\t    results = {}\\n   412\\t    acoustic_0 = None\\n   413\\t    for k in cols:\\n   414\\t        out_p, out_e, tgt_spec = forward_conditions(\\n   415\\t            model, depth_coord, ref_irs, src_loc, ref_locs, tgt_wav, k, aligned0)\\n   416\\t        out_p, out_e, tgt_spec = out_p[:n_real], out_e[:n_real], tgt_spec[:n_real]\\n   417\\t        for condition, pred in ((\\\"P\\\", out_p), (\\\"E\\\", out_e)):\\n   418\\t            cell = {name: value.double().numpy()\\n   419\\t                    for name, value in spectral_metrics(pred, out_0, tgt_spec).items()}\\n   420\\t            if int(k) == 0 and zero_wanted:\\n   421\\t                if acoustic_0 is None:\\n   422\\t                    acoustic_0 = acoustic_metrics_batch(pred, tgt_real, keys, evaluator,\\n   423\\t                                                        gl_seed)\\n   424\\t                cell.update({name: value.copy() for name, value in acoustic_0.items()})\\n   425\\t            elif int(k) in acoustic_at[condition]:\\n   426\\t                cell.update(acoustic_metrics_batch(pred, tgt_real, keys, evaluator, gl_seed))\\n   427\\t            results[(condition, int(k))] = cell\\n   428\\t    return keys, results, delay_flip_counts(src_loc[:n_real], ref_locs[:n_real], cols)\\n   429\\t\\n   430\\t\\n   431\\tdef set_precision(tf32):\\n   432\\t    \\\"\\\"\\\"Pin the TF32 policy of both cuBLAS and cuDNN for the whole run.\\n   433\\t\\n   434\\t    cuDNN's ``allow_tf32`` defaults to ``True``, and the reference-RIR encoder is a\\n   435\\t    ResNet-18, so leaving it on makes the forward pass depend on the batch size at the\\n   436\\t    1e-4 (relative) level -- measured on 8 real queries: max ``|d|`` 2.3e-4 with TF32 on\\n   437\\t    versus 2.4e-7 with it off.  That is far above the effects this experiment measures,\\n   438\\t    so TF32 is off by default and the choice is recorded in the run's meta block.\\n   439\\t\\n   440\\t    Args:\\n   441\\t        tf32: whether to allow TF32 for matmuls and convolutions.\\n   442\\t    \\\"\\\"\\\"\\n   443\\t    torch.backends.cuda.matmul.allow_tf32 = bool(tf32)\\n   444\\t    torch.backends.cudnn.allow_tf32 = bool(tf32)\\n\"}\n{\"label\":\"flac rotation\",\"output\":\"     1\\t\\\"\\\"\\\"Physically-consistent azimuthal (yaw) rotation of FLAC scene conditioning.\\n     2\\t\\n     3\\tFor a mono room impulse response, rigidly rotating the whole scene (room geometry\\n     4\\t+ source + listener) about the vertical axis leaves the ground-truth RIR unchanged.\\n     5\\tThis module applies that rotation to the *conditioning* metadata only: the\\n     6\\tequirectangular depth panorama (a horizontal circular roll together with a rotation\\n     7\\tof its stored per-pixel 3D vectors) and the source/context pose vectors (a rotation\\n     8\\tabout z). ``context_audio`` (the reference RIR waveforms) and the target RIR are\\n     9\\tyaw-invariant and are intentionally left untouched.\\n    10\\t\\n    11\\tUsed both by the standalone rotation-invariance diagnostic and by ``eval_FLAC.py``\\n    12\\t(via its optional ``--rotate-deg`` flag).\\n    13\\t\\\"\\\"\\\"\\n    14\\timport math\\n    15\\tfrom typing import Dict, List, Sequence, Tuple\\n    16\\t\\n    17\\timport torch\\n    18\\t\\n    19\\tPOSE_KEYS: Tuple[str, ...] = (\\\"source\\\", \\\"source_vit\\\", \\\"context_poses\\\", \\\"context_poses_vit\\\")\\n    20\\t\\n    21\\t# Yaw subgroup G = C4 aligned with the panorama columns (90 deg = 128 columns of\\n    22\\t# W=512 -> exact roll). Single source of truth for the frame-averaging angles.\\n    23\\tDEFAULT_FRAME_ANGLES: Tuple[float, ...] = (0.0, 90.0, 180.0, 270.0)\\n    24\\t\\n    25\\t# Largest number of samples fed to the ViT conditioners in ONE frame-averaging\\n    26\\t# forward. The orbit used to run one angle at a time: at the training micro-batch\\n    27\\t# (8) that is a ~8-sample, ~512-token ViT forward per angle per conditioner, and\\n    28\\t# exp_11's P0 profiling measured every orbit cell at only 28-34% GPU utilisation\\n    29\\t# -- latency/kernel-launch bound, not compute bound. Stacking the rotated\\n    30\\t# variants along the batch dimension turns C small forwards into a few large\\n    31\\t# ones. 64 is a PER-RANK conditioner batch equal to the effective global batch,\\n    32\\t# so one orbit chunk costs about one ordinary step's worth of activations; the\\n    33\\t# batched peak is requalified by the 8x8 P0 spot cells (real forward + backward +\\n    34\\t# checkpoint recompute), not inferred from the sequential measurement.\\n    35\\t#\\n    36\\t# DISCLOSED RECIPE CHANGE (exp_11, approved as such). The averaging ARITHMETIC is\\n    37\\t# identical -- same terms, same order, same divisor. The augmentation SCHEDULE is\\n    38\\t# not: train-mode DINOv3 draws a random RoPE position rescale once per forward\\n    39\\t# (pos_embed_rescale 2.0), so angles sharing a chunk now share one draw where the\\n    40\\t# per-angle loop gave them independent draws, and fewer draws are taken overall.\\n    41\\t# This is applied identically to every arm INCLUDING the contemporaneous C4L\\n    42\\t# bridge, which is therefore the sole inferential comparator; historical rows\\n    43\\t# evaluated under the per-angle loop are labelled legacy-loop. In eval mode the\\n    44\\t# rescale is off, so eval-mode batched and loop results agree numerically.\\n    45\\t#\\n    46\\t# This is the DEFAULT, not the only value: announcement 06 requires every FA arm\\n    47\\t# to declare its effective chunk plan, and exp_14 makes the cap a per-arm config\\n    48\\t# key (``training.frame_avg_max_fwd_samples``) passed to\\n    49\\t# :func:`invariant_conditioning` as ``max_fwd_samples``. Nothing assigns to this\\n    50\\t# name at runtime -- see :func:`resolve_frame_avg_cap`.\\n    51\\tFRAME_AVG_MAX_FWD_SAMPLES: int = 64\\n    52\\t\\n    53\\t# Recorded in evaluation provenance so a metrics row states which orbit execution\\n    54\\t# produced it ('batched' here, 'loop' for the legacy per-angle path).\\n    55\\tORBIT_EXECUTION: str = \\\"batched\\\"\\n    56\\t\\n    57\\t\\n    58\\tdef resolve_frame_avg_cap(max_fwd_samples=None) -> int:\\n    59\\t    \\\"\\\"\\\"The frame-average forward cap this call must use.\\n    60\\t\\n    61\\t    ``None`` -> :data:`FRAME_AVG_MAX_FWD_SAMPLES` (64), i.e. exactly the\\n    62\\t    behaviour every recipe already in the record was run under. Anything else is\\n    63\\t    validated and returned as-is; the module global is never rebound, because the\\n    64\\t    cap is a per-arm property (exp_14's ``training.frame_avg_max_fwd_samples``)\\n    65\\t    and a process-wide assignment would (a) leak into whatever else the process\\n    66\\t    later conditions and (b) survive a mid-step crash as a cap nobody declared.\\n    67\\t\\n    68\\t    Validation is on the RAW value and fail-closed. ``bool`` is rejected before\\n    69\\t    ``int`` because ``isinstance(True, int)`` is True and ``max(1, 64 // True)``\\n    70\\t    would quietly become a 64-angle chunk plan; a float or a numeric string is\\n    71\\t    rejected rather than coerced, because ``int(\\\"32\\\")`` succeeding on a typo is\\n    72\\t    how an arm gets trained under a cap its config never stated.\\n    73\\t    \\\"\\\"\\\"\\n    74\\t    if max_fwd_samples is None:\\n    75\\t        return FRAME_AVG_MAX_FWD_SAMPLES\\n    76\\t    if isinstance(max_fwd_samples, bool) or not isinstance(max_fwd_samples, int):\\n    77\\t        raise ValueError(\\n    78\\t            f\\\"max_fwd_samples must be an int (the frame-average per-forward sample \\\"\\n    79\\t            f\\\"cap), got {max_fwd_samples!r}\\\"\\n    80\\t        )\\n    81\\t    if max_fwd_samples < 1:\\n    82\\t        raise ValueError(f\\\"max_fwd_samples must be >= 1, got {max_fwd_samples}\\\")\\n    83\\t    return int(max_fwd_samples)\\n    84\\t\\n    85\\t\\n    86\\tdef wrap_angle(phi):\\n    87\\t    \\\"\\\"\\\"\\n    88\\t    Wrap an angle into the half-open interval ``(-pi, pi]``.\\n    89\\t\\n    90\\t    The interval is closed at ``+pi`` and open at ``-pi``, so an input of exactly\\n    91\\t    ``-pi`` maps to ``+pi`` (and ``+pi`` stays ``+pi``). Works elementwise on\\n    92\\t    Python floats and on ``torch.Tensor`` inputs alike.\\n    93\\t\\n    94\\t    Parameters\\n    95\\t    ----------\\n    96\\t    phi : float or torch.Tensor\\n    97\\t        Angle(s) in radians.\\n    98\\t\\n    99\\t    Returns\\n   100\\t    -------\\n   101\\t    float or torch.Tensor\\n   102\\t        The wrapped angle(s) in ``(-pi, pi]``, same type as the input.\\n   103\\t    \\\"\\\"\\\"\\n   104\\t    return math.pi - (math.pi - phi) % (2.0 * math.pi)\\n   105\\t\\n   106\\t\\n   107\\tdef draw_yaw_offsets(n: int, img_w: int, generator: torch.Generator) -> torch.Tensor:\\n   108\\t    \\\"\\\"\\\"\\n   109\\t    Draw ``n`` independent panorama-column yaw offsets ``d ~ Uniform{0..img_w-1}``.\\n   110\\t\\n   111\\t    The unit of a *drawn* rotation is one panorama column, never a degree: an\\n   112\\t    integer column shift is applied by :func:`rotate_scene_metadata` with no\\n   113\\t    interpolation, so the offset that is recorded is exactly the offset that is\\n   114\\t    applied (``dj == d``; pinned by test). Angles come from\\n   115\\t    :func:`offsets_to_radians`.\\n   116\\t\\n   117\\t    The draw is taken from the CALLER'S generator and from nothing else. Two\\n   118\\t    properties follow, and both are load-bearing for exp_14's design:\\n   119\\t\\n   120\\t    * **Global-RNG isolation.** The evaluation's own sampling noise is drawn from\\n   121\\t      the global RNG seeded by ``pl.seed_everything(eval_seed)``. If the yaw draw\\n   122\\t      advanced that stream, a rotated cell and its paired unrotated cell would\\n   123\\t      sample different diffusion noise and the seed-paired contrast would be void.\\n   124\\t    * **Chunk independence.** Consecutive calls consume one contiguous stream, so\\n   125\\t      any batch partition of the same item order yields the same per-item\\n   126\\t      assignment; the batch size is pinned anyway, but the assignment does not\\n   127\\t      depend on that pin holding.\\n   128\\t\\n   129\\t    Parameters\\n   130\\t    ----------\\n   131\\t    n : int\\n   132\\t        Number of offsets (e.g. the current batch size). ``0`` is legal — a tail\\n   133\\t        batch of zero items consumes no randomness.\\n   134\\t    img_w : int\\n   135\\t        Panorama width in columns (the support is ``{0, ..., img_w-1}``).\\n   136\\t    generator : torch.Generator\\n   137\\t        A dedicated CPU generator, seeded with the rotation seed. Required: a\\n   138\\t        ``None`` here would silently fall back to the global RNG.\\n   139\\t\\n   140\\t    Returns\\n   141\\t    -------\\n   142\\t    torch.Tensor\\n   143\\t        ``int64`` tensor of shape ``[n]`` with values in ``[0, img_w)``.\\n   144\\t    \\\"\\\"\\\"\\n   145\\t    if generator is None:\\n   146\\t        raise ValueError(\\n   147\\t            \\\"draw_yaw_offsets requires a dedicated torch.Generator: passing None \\\"\\n   148\\t            \\\"would draw from the GLOBAL RNG and perturb the evaluation's own \\\"\\n   149\\t            \\\"sampling noise (see the docstring).\\\"\\n   150\\t        )\\n   151\\t    n = int(n)\\n   152\\t    img_w = int(img_w)\\n   153\\t    if n < 0:\\n   154\\t        raise ValueError(f\\\"n must be >= 0, got {n}\\\")\\n   155\\t    if img_w <= 0:\\n   156\\t        raise ValueError(f\\\"img_w must be > 0, got {img_w}\\\")\\n   157\\t    return torch.randint(0, img_w, (n,), generator=generator, dtype=torch.long)\\n   158\\t\\n   159\\t\\n   160\\tdef offsets_to_radians(offsets: Sequence, img_w: int) -> List[float]:\\n   161\\t    \\\"\\\"\\\"\\n   162\\t    Convert panorama-column offsets to yaw angles in radians: ``d * 2*pi / img_w``.\\n   163\\t\\n   164\\t    Exact by construction on the column grid — :func:`rotate_scene_metadata`\\n   165\\t    re-quantises the angle back to ``round(alpha * img_w / 2pi) % img_w`` and\\n   166\\t    recovers the same ``d`` for every offset in the support (pinned by test), so\\n   167\\t    the recorded offset and the applied rotation can never disagree.\\n   168\\t\\n   169\\t    Parameters\\n   170\\t    ----------\\n   171\\t    offsets : Sequence\\n   172\\t        Column offsets: a ``torch.Tensor``, list, or any iterable of integers.\\n   173\\t    img_w : int\\n   174\\t        Panorama width in columns.\\n   175\\t\\n   176\\t    Returns\\n   177\\t    -------\\n   178\\t    List[float]\\n   179\\t        One angle in radians per offset, in the input order.\\n   180\\t    \\\"\\\"\\\"\\n   181\\t    img_w = int(img_w)\\n   182\\t    if img_w <= 0:\\n   183\\t        raise ValueError(f\\\"img_w must be > 0, got {img_w}\\\")\\n   184\\t    if isinstance(offsets, torch.Tensor):\\n   185\\t        offsets = offsets.tolist()\\n   186\\t    return [float(int(d)) * 2.0 * math.pi / float(img_w) for d in offsets]\\n   187\\t\\n   188\\t\\n   189\\tdef cylindrical_pose_features(\\n   190\\t    md: Dict[str, object], eps: float = 1e-6\\n   191\\t) -> Dict[str, object]:\\n   192\\t    \\\"\\\"\\\"\\n   193\\t    Replace absolute pose vectors with yaw-invariant cylindrical features.\\n   194\\t\\n   195\\t    Each pose ``(x, y, z)`` becomes ``(r, z, dphi)`` where ``r = sqrt(x^2 + y^2)``\\n   196\\t    and ``dphi`` is the azimuth measured *relative* to a scene-intrinsic reference\\n   197\\t    azimuth. Because every azimuth in a rigidly yaw-rotated scene shifts by the\\n   198\\t    same amount, the relative ``dphi`` (and ``r``, ``z``) are invariant under any\\n   199\\t    yaw rotation, making these features an exact invariant of the C-infinity yaw\\n   200\\t    group.\\n   201\\t\\n   202\\t    The reference azimuth is the target source's azimuth. If the source lies on\\n   203\\t    the vertical axis (``r_s < eps``, azimuth undefined) the reference falls back\\n   204\\t    to the azimuth of the largest-``r`` pose among ``{source, context poses}`` --\\n   205\\t    still a scene-intrinsic quantity, so invariance is preserved in the fallback.\\n   206\\t    If *every* pose is degenerate (largest ``r`` also ``< eps``) every ``dphi``\\n   207\\t    is exactly ``0``.\\n   208\\t\\n   209\\t    Only ``'source'`` and ``'context_poses'`` are transformed; ``'*_vit'`` poses,\\n   210\\t    ``'depth'`` and all other keys pass through untouched (same objects). The\\n   211\\t    input dict is not mutated: a shallow copy is returned with fresh tensors for\\n   212\\t    the replaced keys, preserving each pose tensor's dtype and device.\\n   213\\t\\n   214\\t    Parameters\\n   215\\t    ----------\\n   216\\t    md : Dict[str, object]\\n   217\\t        One per-sample metadata dict. ``'source'`` (shape ``[3]``) and, optionally,\\n   218\\t        ``'context_poses'`` (shape ``[N, 3]``) are read; the last dimension is\\n   219\\t        ordered ``(x, y, z)``.\\n   220\\t    eps : float, optional\\n   221\\t        Radius below which a pose azimuth is treated as undefined (default 1e-6).\\n   222\\t\\n   223\\t    Returns\\n   224\\t    -------\\n   225\\t    Dict[str, object]\\n   226\\t        A shallow copy of ``md`` with ``'source'`` -> ``(r_s, z_s, 0.0)`` and each\\n   227\\t        ``'context_poses'`` row -> ``(r_i, z_i, wrap(phi_i - phi_ref))``.\\n   228\\t    \\\"\\\"\\\"\\n   229\\t    out: Dict[str, object] = dict(md)\\n   230\\t\\n   231\\t    source = md.get(\\\"source\\\")\\n   232\\t    context = md.get(\\\"context_poses\\\")\\n   233\\t\\n   234\\t    # Candidate poses for the fallback reference azimuth: source + context rows.\\n   235\\t    cand_r = []\\n   236\\t    cand_phi = []\\n   237\\t\\n   238\\t    r_s = phi_s = sz = None\\n   239\\t    if source is not None:\\n   240\\t        assert isinstance(source, torch.Tensor)\\n   241\\t        sx, sy, sz = source[..., 0], source[..., 1], source[..., 2]\\n   242\\t        r_s = torch.sqrt(sx * sx + sy * sy)\\n   243\\t        phi_s = torch.atan2(sy, sx)\\n   244\\t        cand_r.append(r_s.reshape(1))\\n   245\\t        cand_phi.append(phi_s.reshape(1))\\n   246\\t\\n   247\\t    r_c = phi_c = cz = None\\n   248\\t    if context is not None:\\n   249\\t        assert isinstance(context, torch.Tensor)\\n   250\\t        cx, cy, cz = context[..., 0], context[..., 1], context[..., 2]\\n   251\\t        r_c = torch.sqrt(cx * cx + cy * cy)\\n   252\\t        phi_c = torch.atan2(cy, cx)\\n   253\\t        cand_r.append(r_c.reshape(-1))\\n   254\\t        cand_phi.append(phi_c.reshape(-1))\\n   255\\t\\n   256\\t    # Reference azimuth: target source, unless degenerate -> largest-r pose.\\n   257\\t    # The fallback pose must itself be non-degenerate (its azimuth defined);\\n   258\\t    # if even the largest r is < eps the scene is all-degenerate -> dphi == 0.\\n   259\\t    phi_ref = None\\n   260\\t    if r_s is not None and bool(r_s >= eps):\\n   261\\t        phi_ref = phi_s\\n   262\\t    elif cand_r:\\n   263\\t        all_r = torch.cat(cand_r)\\n   264\\t        all_phi = torch.cat(cand_phi)\\n   265\\t        max_idx = int(torch.argmax(all_r))\\n   266\\t        if bool(all_r[max_idx] >= eps):\\n   267\\t            phi_ref = all_phi[max_idx]\\n   268\\t\\n   269\\t    if source is not None:\\n   270\\t        out[\\\"source\\\"] = torch.stack([r_s, sz, torch.zeros_like(r_s)])\\n   271\\t\\n   272\\t    if context is not None:\\n   273\\t        if phi_ref is not None:\\n   274\\t            dphi = wrap_angle(phi_c - phi_ref)\\n   275\\t        else:\\n   276\\t            dphi = torch.zeros_like(r_c)\\n   277\\t        out[\\\"context_poses\\\"] = torch.stack([r_c, cz, dphi], dim=-1)\\n   278\\t\\n   279\\t    return out\\n   280\\t\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0dfa7-77ce-7782-ac15-668bcbd12958","create_time":1790458719.8484325}}}
