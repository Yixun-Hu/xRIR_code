itself, so a caller can never pass a ``W`` that\\n    disagrees with the depth map.\\n\\n    Args:\\n        depth_coord: receiver-frame panorama coordinates ``[B, 3, H, W]``.\\n        src_loc: receiver-frame query-source position ``[B, 3]``.\\n        ref_locs: receiver-frame reference-source positions ``[B, K, 3]``.\\n        k: integer column roll (negative and ``>= W`` values are reduced modulo ``W``).\\n\\n    Returns:\\n        ``(depth_coord', src_loc', ref_locs')``; at ``k = 0`` the inputs are returned\\n        unchanged value-for-value.\\n    \\\"\\\"\\\"\\n    return rotate_scene_yaw(depth_coord, src_loc, ref_locs, k, W=depth_coord.shape[-1])\\n\\n\\n\"}\n\n[76] tool exec call: text(await tools.exec_command({cmd:\"env CUDA_VISIBLE_DEVICES='' PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=\\\"$PWD\\\" XRIR_DATA_PATH=/home/yixunhu/data_cache/AcousticRooms /home/yixunhu/miniconda3/envs/xRIR/bin/python - <<'PY' > .review-round1/main/repeat-check.log\\nimport json,numpy as np\\nfrom tools.exp10_compare import load_run\\npaths=['.review-round1/main/smoke','.review-round1/main/smoke-repeat']\\na,pa=load_run(paths[0]); b,pb=load_run(paths[1])\\nassert a['protocol_id']==b['protocol_id'] and a['execution_id']!=b['execution_id']\\nfor name in a['arrays']:\\n    assert a['arrays'][name]['sha256']==b['arrays'][name]['sha256'],name\\n    np.testing.assert_array_equal(np.load(paths[0]+'/'+name),np.load(paths[1]+'/'+name))\\nfor p in (pa,pb):\\n    p.pop('meta');p.pop('execution_id')\\nassert pa==pb\\nprint('All five saved arrays bit-identical; all per-query metrics and controls identical.')\\nprint('Same protocol_id, distinct execution_id.')\\nprint('Repeat timing',json.dumps(b['timing'],sort_keys=True))\\nprint('per_batch16_forward_s',b['timing']['inference_s']/9)\\nprint('GL_ms_per_query_angle',1000*b['timing']['inversion_s']/144)\\nPY\",\"sandbox_permissions\":\"require_escalated\",\"justification\":\"May I record the comparison of the two CPU smoke runs under .review-round1/