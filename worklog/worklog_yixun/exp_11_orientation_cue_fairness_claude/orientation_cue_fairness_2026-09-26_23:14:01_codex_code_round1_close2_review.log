 a ``--max-samples`` smoke run still proves the manifest describes the real\\n    split.  Exposes ``dataset`` / ``manifest`` / ``entries`` like the wrapped object.\\n\\n    Args:\\n        base: a fully validated ``ManifestDataset``.\\n        n: how many leading entries (in the manifest's canonical order) to keep.\\n\\n    Raises:\\n        ValueError: if ``n`` is outside ``1 .. len(base)``.\\n    \\\"\\\"\\\"\\n\\n    def __init__(self, base, n):\\n        if not 1 <= int(n) <= len(base):\\n            raise ValueError(\\\"cannot take the first {} of {} entries\\\".format(n, len(base)))\\n        self.base = base\\n        self.dataset = base.dataset\\n        self.manifest = base.manifest\\n        self.entries = base.entries[:int(n)]\\n\\n    def __len__(self):\\n        return len(self.entries)\\n\\n    def __getitem__(self, idx):\\n        if not 0 <= int(idx) < len(self.entries):\\n            raise IndexError(\\\"index {} is outside the truncated manifest\\\".format(idx))\\n        return self.base[int(idx)]\\n\\n\\ndef build_manifest_dataset(manifest, max_samples=0, max_len=9600):\\n    \\\"\\\"\\\"The evaluation dataset: the unseen test split, with the manifest's references.\\n\\n    Args:\\n\"}\n{\"chunk_id\":\"6ab094\",\"wall_time_seconds\":5.000499132,\"session_id\":63092,\"original_token_count\":0,\"output\":\"\"}\n"},{"type":"input_text","text":"\n[32] tool exec call: text(await tools.exec_command({cmd:\"tail -16 .review-round3/renderer/audit.log\\nsed -n '790,915p' tools/exp10_summarize.py\\nsed -n '1,100p' .review-round2/main/summary/yaw_pilot_summary.json\",max_output_tokens:3600}));\n\n"},{"type":"input_text","text":"\n[33] tool exec result: Script completed\nWall time 0.1 seconds\nOutput:\n\n{\"chunk_id\":\"226c43\",\"wall_time_seconds\":0.000007428,\"exit_code\":0,\"original_token_count\":2761,\"output\":\"smoke_released_k8_smoke png passes 2 gaps_pt {'qualification_to_status': 9.144000000000005, 'status_to_legend': 9.658000000000001, 'legend_to