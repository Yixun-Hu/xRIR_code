_decay = i_decay / fs\n   219\t        # compute the decay time\n   220\t        decay_time = t_decay\n   221\t        est_edt = (60 / decay_db) * decay_time\n   222\t        return est_edt\n   223\t\n   224\t    def measure_rt60(self, h, fs=22050, decay_db=20, plot=False, rt60_tgt=None):\n   225\t        \"\"\"\n   226\t        Analyze the RT60 of an impulse response. Optionaly plots some useful information.\n   227\t        Parameters\n   228\t        ----------\n   229\t        h: array_like\n   230\t            The impulse response.\n   231\t        fs: float or int, optional\n   232\t            The sampling frequency of h (default to 1, i.e., samples).\n   233\t        decay_db: float or int, optional\n   234\t            The decay in decibels for which we actually estimate the time. Although\n   235\t            we would like to estimate the RT60, it might not be practical. Instead,\n   236\t            we measure the RT20 or RT30 and extrapolate to RT60.\n   237\t        plot: bool, optional\n   238\t            If set to ``True``, the power decay and different estimated values will\n   239\t            be plotted (default False).\n   240\t        rt60_tgt: float\n   241\t            This parameter can be used to indicate a target RT60 to which we want\n   242\t            to compare the estimated value.\n   243\t        \"\"\"\n   244\t\n   245\t        h = np.array(h)\n   246\t        fs = float(fs)\n   247\t\n   248\t        # The power of the impulse response in dB\n   249\t        power = h ** 2\n   250\t        energy = np.cumsum(power[::-1])[::-1]  # Integration according to Schroeder\n   251\t\n   252\t        # remove the possibly all zero tail\n   253\t        i_nz = np.max(np.where(energy > 0)[0])\n   254\t        energy = energy[:i_nz]\n   255\t        energy_db = 10 * np.log10(energy)\n   256\t        energy_db -= energy_db[0]\n   257\t        # -5 dB headroom\n   258\t        i_5db = np.min(np.where(-5 - energy_db > 0)[0])\n   259\t        e_5db = energy_db[i_5db]\n   260\t        t_5db = i_5db / fs\n   261\t\n   262\t        i_decay = np.min(np.where(-5 - decay_db - energy_db > 0)[0])\n   263\t        t_decay = i_decay / fs\n   264\t\n   265\t        # compute the decay time\n   266\t        decay_time = t_decay - t_5db\n   267\t        est_rt60 = (60 / decay_db) * decay_time\n   268\t\n   269\t        return est_rt60\n   270\t    def measure_clarity(self, signal, time=50, fs=22050):\n   271\t        h2 = signal**2\n   272\t        t = int((time/1000)*fs + 1)\n   273\t        return 10*np.log10(np.sum(h2[:t])/np.sum(h2[t:]))\n   274\t    def compute_energy_db(self, h):\n   275\t        h = np.array(h)\n   276\t        # The power of the impulse response in dB\n   277\t        power = h ** 2\n   278\t        energy = np.cumsum(power[::-1])[::-1]  # Integration according to Schroeder\n   279\t\n   280\t        # remove the possibly all zero tail\n   281\t        i_nz = np.max(np.where(energy > 0)[0])\n   282\t        energy = energy[:i_nz]\n   283\t        energy_db = 10 * np.log10(energy)\n   284\t        energy_db -= energy_db[0]\n   285\t        return  energy_db\n   286\t    def evaluate_edt(self, pred_ir, gt_ir):\n   287\t        np_pred_ir = pred_ir\n   288\t        np_gt_ir = gt_ir\n   289\t        pred_edt = self.measure_edt(np_pred_ir)\n   290\t        gt_edt = self.measure_edt(np_gt_ir)\n   291\t        edt_error = abs(pred_edt - gt_edt)\n   292\t        self.edt_error.append(edt_error)\n   293\t\n   294\t    def evaluate_clarity(self, pred_ir, gt_ir):\n   295\t        np_pred_ir = pred_ir\n   296\t        np_gt_ir = gt_ir\n   297\t        pred_clarity = self.measure_clarity(np_pred_ir)\n   298\t        gt_clarity = self.measure_clarity(np_gt_ir)\n   299\t        clarity_error = abs(pred_clarity - gt_clarity)\n   300\t        self.clarity_error.append(clarity_error)\n   301\t\n   302\t    def evaluate_t60(self, pred_ir, gt_ir):\n   303\t        np_pred_ir = pred_ir\n   304\t        np_gt_ir = gt_ir\n   305\t        mse = np.mean((np_pred_ir - np_gt_ir) ** 2)\n   306\t        self.mse.append(mse)\n   307\t        psnr = self.psnr_metric(np_pred_ir, np_gt_ir)\n   308\t        self.psnr.append(psnr)\n   309\t        try:\n   310\t            pred_t60 = self.measure_rt60(np_pred_ir)\n   311\t            gt_t60 = self.measure_rt60(np_gt_ir)\n   312\t            t60_error = abs(pred_t60 - gt_t60) / gt_t60\n   313\t            self.t60_error.append(t60_error)\n   314\t        except:\n   315\t            self.invalid += 1\n   316\t    def evaluate_energy_db(self, pred_ir, gt_ir):\n   317\t        pred_db = self.compute_energy_db(pred_ir)\n   318\t        gt_db = self.compute_energy_db(gt_ir)\n   319\t        return pred_db, gt_db\n   320\t    def evaluate_spec_mse(self, pred_ir_spec, gt_ir_spec):\n   321\t        self.spec_mse.append(np.mean(pred_ir_spec - gt_ir_spec)**2)\n   322\t   \n   323\t\n   324\tdef apply_delay(signal, delay_tensor):\n   325\t    \"\"\"\n   326\t    Apply integer delay to each sample in the batch with zero-padding.\n   327\t    \n   328\t    Args:\n   329\t    - signal: Tensor of shape [batch_size, sequence_length, channels] or [batch_size, sequence_length].\n   330\t    - delay_tensor: Tensor of shape [batch_size] with integer delay values for each sample.\n   331\t    \n   332\t    Returns:\n   333\t    - Delayed signal with the same shape as input signal.\n   334\t    \"\"\"\n   335\t    batch_size, sequence_length = signal.shape[:2]\n   336\t    \n   337\t    # Output tensor initialized with zeros (same shape as input signal)\n   338\t    delayed_signal = torch.zeros_like(signal)\n   339\t    \n   340\t    for i in range(batch_size):\n   341\t        delay = delay_tensor[i].item()  # Get the delay value for this batch item\n   342\t        \n   343\t        if delay > 0:\n   344\t            # Positive delay: shift right and pad with zeros at the beginning\n   345\t            delayed_signal[i, delay:] = signal[i, :-delay]\n   346\t        elif delay < 0:\n   347\t            # Negative delay: shift left and pad with zeros at the end\n   348\t            delayed_signal[i, :delay] = signal[i, -delay:]\n   349\t        else:\n   350\t            # No delay, just copy the signal\n   351\t            delayed_signal[i] = signal[i]\n   352\t    \n   353\t    return delayed_signal\n   354\t\n   355\tif __name__ == \"__main__\":\n   356\t\n   357\t    from treble_multi_room_dataset.treble_xRIR_dataset import xRIR_Dataset\n   358\t    from torch.utils.data import DataLoader\n   359\t    from model.xRIR import xRIR\n   360\t    import torch\n   361\t    import matplotlib.pyplot as plt\n   362\t    import torch.nn.functional as F\n   363\t    import librosa\n   364\t\n   365\t\n   366\t    # Check if CUDA is available\n   367\t    if torch.cuda.is_available():\n   368\t        # Set the device\n   369\t        torch.cuda.set_device(0) \n   370\t\n   371\t        # Verify the current device\n   372\t        print(torch.cuda.current_device())\n   373\t\n   374\t\n   375\t    test_dataset = xRIR_Dataset(num_shot = 8, split=\"test\")\n   376\t    test_loader = DataLoader(test_dataset, shuffle=True, batch_size=1)\n   377\t\n   378\t\n   379\t    model = xRIR(num_channels=8)\n   380\t    model.load_state_dict(torch.load(\"./checkpoints/xRIR_unseen.pth\", map_location=\"cpu\"))\n   381\t    model.cuda()\n   382\t\n   383\t    model.eval()\n   384\t    test_loss = 0\n   385\t    cnt = 0\n   386\t    t60_error_list = []\n   387\t    c50_error_list = []\n   388\t    edt_error_list = []\n   389\t    drre_list = []\n   390\t    mag_loss_list = []\n   391\t    env_loss_list = []\n   392\t    count_outlier = 0\n   393\t    with torch.no_grad():\n   394\t        for data in test_loader:\n   395\t            proj_listener_pos, proj_source_pos, depth, tgt_wav, all_ref_irs, all_ref_src_pos = data\n   396\t\n   397\t            out_spec, tgt_spec =  model(depth.cuda(), all_ref_irs.cuda(), proj_source_pos.cuda(),  all_ref_src_pos.cuda(), tgt_wav.cuda())\n   398\t            \n   399\t            pred_mag_spec = torch.exp(out_spec) - 1e-8\n   400\t            pred_mag_spec = pred_mag_spec[...,0].cpu()\n   401\t            out_wav = griffin_lim(pred_mag_spec).unsqueeze(0)\n   402\t\n   403\t\n   404\t            evaluator = Evaluator()\n   405\t            gt_edt = evaluator.measure_edt(tgt_wav[0, 0, :8000].cpu().numpy())\n   406\t            pred_edt = evaluator.measure_edt(out_wav[0, 0, :8000].cpu().numpy())\n   407\t            print(\"GT EDT: {}s, Pred EDT: {}s, EDT Error: {}s\".format(gt_edt, pred_edt, np.abs(gt_edt - pred_edt)))\n   408\t            edt_error_list.append(np.abs(gt_edt - pred_edt))\n   409\t\n   410\t\n   411\t            gt_c50 = evaluator.measure_clarity(tgt_wav[0, 0, :8000].cpu().numpy())\n   412\t            pred_c50 = evaluator.measure_clarity(out_wav[0, 0, :8000].cpu().numpy())\n   413\t            print(\"GT C50: {}dB, Pred C50: {}dB, C50 Error: {}dB\".format(gt_c50, pred_c50, np.abs(gt_c50 - pred_c50)))\n   414\t            if np.abs(gt_c50 - pred_c50) != np.inf and np.abs(gt_c50 - pred_c50) != -np.inf:\n   415\t                c50_error_list.append(np.abs(gt_c50 - pred_c50))\n   416\t            else:\n   417\t                count_outlier += 1\n   418\t\n   419\t            gt_t60 = evaluator.measure_rt60(tgt_wav[0, 0, :8000].cpu().numpy())\n   420\t            pred_t60 = evaluator.measure_rt60(out_wav[0, 0, :8000].cpu().numpy())\n   421\t            print(\"GT T60: {}s, Pred T60: {}s, T60 Percentage Error: {}\\%\".format(gt_t60, pred_t60, np.abs(gt_t60 - pred_t60) / gt_t60 * 100.))\n   422\t            t60_error_list.append(np.abs(gt_t60 - pred_t60) / gt_t60 * 100.)\n   423\t\n   424\t            mag_loss = evaluator.stft_loss(out_spec.squeeze(-1).cpu().numpy(), torch.log(tgt_spec + 1e-8).squeeze(1).cpu().numpy())\n   425\t            print(\"STFT loss: \".format(mag_loss))\n   426\t            mag_loss_list.append(mag_loss)\n   427\t            print(\"HHH\", cnt)\n   428\t\n   429\t            cnt += 1\n   430\t            print(\"Average EDT error: \", np.mean(edt_error_list))\n   431\t            print(\"Average C50 error: \", np.mean(c50_error_list))\n   432\t            print(\"Average T60 error: \", np.mean(t60_error_list))\n   433\t            print(\"----------{}----------\".format(cnt))\n   434\t\n   435\t        print(\"Average EDT error: \", np.mean(edt_error_list))\n   436\t        print(\"Average C50 error: \", np.mean(c50_error_list))\n   437\t        print(\"Average T60 error: \", np.mean(t60_error_list))\n   438\t        print(\"Number of Outliers: \", count_outlier)\n","exit_code":0,"duration":{"secs":0,"nanos":6477},"formatted_output":"     1\timport sys\n     2\timport numpy as np\n     3\timport os\n     4\t\n     5\tfrom scipy import stats\n     6\timport matplotlib.pyplot as plt\n     7\tfrom scipy.interpolate import interp1d\n     8\timport torchaudio\n     9\tfrom scipy.signal import hilbert\n    10\t\n    11\tdef griffin_lim(spec, n_fft=124, win_length=62, hop_length=31, power=1, n_iter=32):\n    12\t    transform = torchaudio.transforms.GriffinLim(\n    13\t        n_fft=n_fft, n_iter=n_iter,win_length=win_length,hop_length=hop_length,power=power\n    14\t    )\n    15\t    return transform(spec)\n    16\t\n    17\t\n    18\tdef normalize(audio, norm='peak'):\n    19\t    \"\"\"\n    20\t    normalize IR\n    21\t    :param audio: IR\n    22\t    :param norm: normalization mode\n    23\t    :return: normalized IR\n    24\t    \"\"\"\n    25\t    if norm == 'peak':\n    26\t        peak = abs(audio).max()\n    27\t        if peak != 0:\n    28\t            return audio / peak\n    29\t        else:\n    30\t            return audio\n    31\t    elif norm == 'rms':\n    32\t        if torch.is_tensor(audio):\n    33\t            audio = audio.numpy()\n    34\t        audio_without_padding = np.trim_zeros(audio, trim='b')\n    35\t        rms = np.sqrt(np.mean(np.square(audio_without_padding))) * 100\n    36\t        if rms != 0:\n    37\t            return audio / rms\n    38\t        else:\n    39\t            return audio\n    40\t    else:\n    41\t        raise NotImplementedError\n    42\t\n    43\t\n    44\tdef measure_drr_energy_ratio(y, cutoff_time=0.003, fs=22050):\n    45\t    \"\"\"\n    46\t    get direct to reverberant energy ratio (DRR)\n    47\t    :param y: IR\n    48\t    :param cutoff_time: cutoff time to compute DRR\n    49\t    :param fs: sampling frequency\n    50\t    :return: DRR\n    51\t    \"\"\"\n    52\t    direct_sound_idx = int(cutoff_time * fs)\n    53\t\n    54\t    # removing leading silence\n    55\t    y = normalize(y)\n    56\t    y = np.trim_zeros(y, trim='fb')\n    57\t\n    58\t    # everything up to the given idx is summed up and treated as direct sound energy\n    59\t    y = np.power(y, 2)\n    60\t    direct = sum(y[:direct_sound_idx + 1])\n    61\t    reverberant = sum(y[direct_sound_idx + 1:])\n    62\t    if direct == 0 or reverberant == 0:\n    63\t        drr = 1\n    64\t        # print('Direct or reverberant is 0')\n    65\t    else:\n    66\t        drr = 10 * np.log10(direct / reverberant)\n    67\t\n    68\t    return drr\n    69\t\n    70\t\n    71\tdef calculate_drr_diff(gt, est, cutoff_time=0.003, fs=22050, compute_relative_diff=False, get_diff_val=True,\n    72\t                       get_gt_val=False, get_pred_val=False,):\n    73\t    \"\"\"\n    74\t    get difference in DRR, DRR for gt or DRR for estimated IR\n    75\t    :param gt: gt IR\n    76\t    :param est: estimated IR\n    77\t    :param cutoff_time: cutoff time to compute DRR\n    78\t    :param fs: sampling frequency\n    79\t    :param compute_relative_diff: flag to compute relative difference\n    80\t    :param get_diff_val: flag to get difference in DRR\n    81\t    :param get_gt_val: flag to get DRR of gt IR\n    82\t    :param get_pred_val: flag to get DRR of estimated IR\n    83\t    :return: difference in DRR, DRR of gt IR or DRR of estimated IR\n    84\t    \"\"\"\n    85\t    drr_gt = measure_drr_energy_ratio(gt, cutoff_time=cutoff_time, fs=fs)\n    86\t    drr_est = measure_drr_energy_ratio(est, cutoff_time=cutoff_time, fs=fs)\n    87\t    diff = abs(drr_gt - drr_est)\n    88\t    if compute_relative_diff:\n    89\t        diff = abs(diff / drr_gt)\n    90\t\n    91\t    if get_diff_val:\n    92\t        return diff\n    93\t    elif get_gt_val:\n    94\t        return drr_gt\n    95\t    elif get_pred_val:\n    96\t        return drr_est\n    97\t\n    98\t\n    99\t\n   100\tclass Evaluator:\n   101\t    def __init__(self, cfg=None, seq_name=None):\n   102\t        self.mse = []\n   103\t        self.psnr = []\n   104\t        self.ssim = []\n   105\t        self.cfg = cfg\n   106\t        self.seq_name = seq_name\n   107\t        self.t60_error = []\n   108\t        self.clarity_error = []\n   109\t        self.edt_error = []\n   110\t        self.spec_mse = []\n   111\t\n   112\t        self.invalid = 0\n   113\t\n   114\t    def psnr_metric(self, img_pred, img_gt):\n   115\t        mse = np.mean((img_pred - img_gt)**2)\n   116\t        psnr = -10 * np.log(mse) / np.log(10)\n   117\t        return psnr\n   118\t\n   119\t    def stft_loss(self, img_pred, img_gt):\n   120\t        mse = np.mean((img_pred - img_gt)**2)\n   121\t        return mse\n   122\t\n   123\t    def env_loss(self, pred_wav, gt_wav):\n   124\t        pred_env = np.abs(hilbert(pred_wav))\n   125\t        gt_env = np.abs(hilbert(gt_wav))\n   126\t        envelope_distance = np.mean(np.abs(gt_env - pred_env) / np.max(gt_env)) * 100.\n   127\t        return float(envelope_distance)\n   128\t    \n   129\t    def t60_impulse(self, energy, rt='t20', fs=22050, trans=False, trans1=False):\n   130\t        rt = rt.lower()\n   131\t        if rt == 't30':\n   132\t            init = -5.0\n   133\t            end = -35.0\n   134\t            factor = 2.0\n   135\t        elif rt == 't20':\n   136\t            init = -5.0\n   137\t            end = -25.0\n   138\t            factor = 3.0\n   139\t        elif rt == 't10':\n   140\t            init = -5.0\n   141\t            end = -15.0\n   142\t            factor = 6.0\n   143\t        elif rt == 'edt':\n   144\t            init = 0.0\n   145\t            end = -10.0\n   146\t            factor = 6.0\n   147\t\n   148\t        if trans:\n   149\t            result = energy[0][..., None]\n   150\t            new_energy = []\n   151\t            for band in range(result.shape[1]):\n   152\t                # Filtering signal\n   153\t                filtered_signal = result[:, band]\n   154\t                abs_signal = np.abs(filtered_signal)\n   155\t                # Schroeder integration\n   156\t                sch = abs_signal**2\n   157\t                new_energy.append(sch)\n   158\t            energy = np.array(new_energy)\n   159\t        elif trans1:\n   160\t            abs_signal = np.abs(energy[0])\n   161\t            energy = np.array(abs_signal**2).reshape(1, -1, 22).mean(-1)\n   162\t            factor *= 1\n   163\t            trans = False\n   164\t        else:\n   165\t            factor *= 1\n   166\t\n   167\t        t60 = np.zeros(energy.shape[0])\n   168\t        c50 = np.zeros(energy.shape[0])\n   169\t        schdb_list = []\n   170\t        for band in range(energy.shape[0]):\n   171\t            if trans:\n   172\t                pow_energy = energy[band]\n   173\t            else:\n   174\t                if not trans1:\n   175\t                    pow_energy = np.power(10, energy[band])\n   176\t                else:\n   177\t                    pow_energy = energy[band]\n   178\t                x_dense = np.arange(0, pow_energy.shape[-1]*22)\n   179\t                x_bin = np.arange(0, pow_energy.shape[-1]*22, 22)\n   180\t                f = interp1d(x_bin, pow_energy, kind = 'slinear')\n   181\t                pow_energy = f(x_dense[:len(x_bin)*22-22])\n   182\t                # pow_energy = np.interp(x_dense, x_bin, pow_energy)\n   183\t            sch = np.cumsum(pow_energy[::-1])[::-1]\n   184\t            sch_db = 10.0 * np.log10(sch / np.max(sch))\n   185\t            sch_db -= sch_db[0]\n   186\t            if band == 0:\n   187\t                out_sch_db = sch_db\n   188\t            schdb_list.append(sch_db)\n   189\t\n   190\t            init_sample = np.min(np.where(-5 - sch_db > 0)[0])\n   191\t            if len(np.where(-35 - sch_db> 0)[0]) > 0:\n   192\t                end_sample = np.min(np.where(-35 - sch_db> 0)[0])\n   193\t            else:\n   194\t                end_sample = len(sch_db) - 1\n   195\t            t60[band] = factor * (end_sample / fs - init_sample / fs)\n   196\t            if trans1 or not trans:\n   197\t                t = int((50 / 1000.0) * fs + 1)\n   198\t            else:\n   199\t                t = int((50 / 1000.0) * fs + 1)\n   200\t            c50[band] = 10.0 * np.log10((np.sum(pow_energy[:t]) / np.sum(pow_energy[t:])))\n   201\t        return t60, out_sch_db, c50, init_sample\n   202\t    \n   203\t    def measure_edt(self, h, fs=22050, decay_db=10):\n   204\t        h = np.array(h)\n   205\t        fs = float(fs)\n   206\t\n   207\t        # The power of the impulse response in dB\n   208\t        power = h ** 2\n   209\t        energy = np.cumsum(power[::-1])[::-1]  # Integration according to Schroeder\n   210\t\n   211\t        # remove the possibly all zero tail\n   212\t        i_nz = np.max(np.where(energy > 0)[0])\n   213\t        energy = energy[:i_nz]\n   214\t        energy_db = 10 * np.log10(energy)\n   215\t        energy_db -= energy_db[0]\n   216\t\n   217\t        i_decay = np.min(np.where(- decay_db - energy_db > 0)[0])\n   218\t        t_decay = i_decay / fs\n   219\t        # compute the decay time\n   220\t        decay_time = t_decay\n   221\t        est_edt = (60 / decay_db) * decay_time\n   222\t        return est_edt\n   223\t\n   224\t    def measure_rt60(self, h, fs=22050, decay_db=20, plot=False, rt60_tgt=None):\n   225\t        \"\"\"\n   226\t        Analyze the RT60 of an impulse response. Optionaly plots some useful information.\n   227\t        Parameters\n   228\t        ----------\n   229\t        h: array_like\n   230\t            The impulse response.\n   231\t        fs: float or int, optional\n   232\t            The sampling frequency of h (default to 1, i.e., samples).\n   233\t        decay_db: float or int, optional\n   234\t            The decay in decibels for which we actually estimate the time. Although\n   235\t            we would like to estimate the RT60, it might not be practical. Instead,\n   236\t            we measure the RT20 or RT30 and extrapolate to RT60.\n   237\t        plot: bool, optional\n   238\t            If set to ``True``, the power decay and different estimated values will\n   239\t            be plotted (default False).\n   240\t        rt60_tgt: float\n   241\t            This parameter can be used to indicate a target RT60 to which we want\n   242\t            to compare the estimated value.\n   243\t        \"\"\"\n   244\t\n   245\t        h = np.array(h)\n   246\t        fs = float(fs)\n   247\t\n   248\t        # The power of the impulse response in dB\n   249\t        power = h ** 2\n   250\t        energy = np.cumsum(power[::-1])[::-1]  # Integration according to Schroeder\n   251\t\n   252\t        # remove the possibly all zero tail\n   253\t        i_nz = np.max(np.where(energy > 0)[0])\n   254\t        energy = energy[:i_nz]\n   255\t        energy_db = 10 * np.log10(energy)\n   256\t        energy_db -= energy_db[0]\n   257\t        # -5 dB headroom\n   258\t        i_5db = np.min(np.where(-5 - energy_db > 0)[0])\n   259\t        e_5db = energy_db[i_5db]\n   260\t        t_5db = i_5db / fs\n   261\t\n   262\t        i_decay = np.min(np.where(-5 - decay_db - energy_db > 0)[0])\n   263\t        t_decay = i_decay / fs\n   264\t\n   265\t        # compute the decay time\n   266\t        decay_time = t_decay - t_5db\n   267\t        est_rt60 = (60 / decay_db) * decay_time\n   268\t\n   269\t        return est_rt60\n   270\t    def measure_clarity(self, signal, time=50, fs=22050):\n   271\t        h2 = signal**2\n   272\t        t = int((time/1000)*fs + 1)\n   273\t        return 10*np.log10(np.sum(h2[:t])/np.sum(h2[t:]))\n   274\t    def compute_energy_db(self, h):\n   275\t        h = np.array(h)\n   276\t        # The power of the impulse response in dB\n   277\t        power = h ** 2\n   278\t        energy = np.cumsum(power[::-1])[::-1]  # Integration according to Schroeder\n   279\t\n   280\t        # remove the possibly all zero tail\n   281\t        i_nz = np.max(np.where(energy > 0)[0])\n   282\t        energy = energy[:i_nz]\n   283\t        energy_db = 10 * np.log10(energy)\n   284\t        energy_db -= energy_db[0]\n   285\t        return  energy_db\n   286\t    def evaluate_edt(self, pred_ir, gt_ir):\n   287\t        np_pred_ir = pred_ir\n   288\t        np_gt_ir = gt_ir\n   289\t        pred_edt = self.measure_edt(np_pred_ir)\n   290\t        gt_edt = self.measure_edt(np_gt_ir)\n   291\t        edt_error = abs(pred_edt - gt_edt)\n   292\t        self.edt_error.append(edt_error)\n   293\t\n   294\t    def evaluate_clarity(self, pred_ir, gt_ir):\n   295\t        np_pred_ir = pred_ir\n   296\t        np_gt_ir = gt_ir\n   297\t        pred_clarity = self.measure_clarity(np_pred_ir)\n   298\t        gt_clarity = self.measure_clarity(np_gt_ir)\n   299\t        clarity_error = abs(pred_clarity - gt_clarity)\n   300\t        self.clarity_error.append(clarity_error)\n   301\t\n   302\t    def evaluate_t60(self, pred_ir, gt_ir):\n   303\t        np_pred_ir = pred_ir\n   304\t        np_gt_ir = gt_ir\n   305\t        mse = np.mean((np_pred_ir - np_gt_ir) ** 2)\n   306\t        self.mse.append(mse)\n   307\t        psnr = self.psnr_metric(np_pred_ir, np_gt_ir)\n   308\t        self.psnr.append(psnr)\n   309\t        try:\n   310\t            pred_t60 = self.measure_rt60(np_pred_ir)\n   311\t            gt_t60 = self.measure_rt60(np_gt_ir)\n   312\t            t60_error = abs(pred_t60 - gt_t60) / gt_t60\n   313\t            self.t60_error.append(t60_error)\n   314\t        except:\n   315\t            self.invalid += 1\n   316\t    def evaluate_energy_db(self, pred_ir, gt_ir):\n   317\t        pred_db = self.compute_energy_db(pred_ir)\n   318\t        gt_db = self.compute_energy_db(gt_ir)\n   319\t        return pred_db, gt_db\n   320\t    def evaluate_spec_mse(self, pred_ir_spec, gt_ir_spec):\n   321\t        self.spec_mse.append(np.mean(pred_ir_spec - gt_ir_spec)**2)\n   322\t   \n   323\t\n   324\tdef apply_delay(signal, delay_tensor):\n   325\t    \"\"\"\n   326\t    Apply integer delay to each sample in the batch with zero-padding.\n   327\t    \n   328\t    Args:\n   329\t    - signal: Tensor of shape [batch_size, sequence_length, channels] or [batch_size, sequence_length].\n   330\t    - delay_tensor: Tensor of shape [batch_size] with integer delay values for each sample.\n   331\t    \n   332\t    Returns:\n   333\t    - Delayed signal with the same shape as input signal.\n   334\t    \"\"\"\n   335\t    batch_size, sequence_length = signal.shape[:2]\n   336\t    \n   337\t    # Output tensor initialized with zeros (same shape as input signal)\n   338\t    delayed_signal = torch.zeros_like(signal)\n   339\t    \n   340\t    for i in range(batch_size):\n   341\t        delay = delay_tensor[i].item()  # Get the delay value for this batch item\n   342\t        \n   343\t        if delay > 0:\n   344\t            # Positive delay: shift right and pad with zeros at the beginning\n   345\t            delayed_signal[i, delay:] = signal[i, :-delay]\n   346\t        elif delay < 0:\n   347\t            # Negative delay: shift left and pad with zeros at the end\n   348\t            delayed_signal[i, :delay] = signal[i, -delay:]\n   349\t        else:\n   350\t            # No delay, just copy the signal\n   351\t            delayed_signal[i] = signal[i]\n   352\t    \n   353\t    return delayed_signal\n   354\t\n   355\tif __name__ == \"__main__\":\n   356\t\n   357\t    from treble_multi_room_dataset.treble_xRIR_dataset import xRIR_Dataset\n   358\t    from torch.utils.data import DataLoader\n   359\t    from model.xRIR import xRIR\n   360\t    import torch\n   361\t    import matplotlib.pyplot as plt\n   362\t    import torch.nn.functional as F\n   363\t    import librosa\n   364\t\n   365\t\n   366\t    # Check if CUDA is available\n   367\t    if torch.cuda.is_available():\n   368\t        # Set the device\n   369\t        torch.cuda.set_device(0) \n   370\t\n   371\t        # Verify the current device\n   372\t        print(torch.cuda.current_device())\n   373\t\n   374\t\n   375\t    test_dataset = xRIR_Dataset(num_shot = 8, split=\"test\")\n   376\t    test_loader = DataLoader(test_dataset, shuffle=True, batch_size=1)\n   377\t\n   378\t\n   379\t    model = xRIR(num_channels=8)\n   380\t    model.load_state_dict(torch.load(\"./checkpoints/xRIR_unseen.pth\", map_location=\"cpu\"))\n   381\t    model.cuda()\n   382\t\n   383\t    model.eval()\n   384\t    test_loss = 0\n   385\t    cnt = 0\n   386\t    t60_error_list = []\n   387\t    c50_error_list = []\n   388\t    edt_error_list = []\n   389\t    drre_list = []\n   390\t    mag_loss_list = []\n   391\t    env_loss_list = []\n   392\t    count_outlier = 0\n   393\t    with torch.no_grad():\n   394\t        for data in test_loader:\n   395\t            proj_listener_pos, proj_source_pos, depth, tgt_wav, all_ref_irs, all_ref_src_pos = data\n   396\t\n   397\t            out_spec, tgt_spec =  model(depth.cuda(), all_ref_irs.cuda(), proj_source_pos.cuda(),  all_ref_src_pos.cuda(), tgt_wav.cuda())\n   398\t            \n   399\t            pred_mag_spec = torch.exp(out_spec) - 1e-8\n   400\t            pred_mag_spec = pred_mag_spec[...,0].cpu()\n   401\t            out_wav = griffin_lim(pred_mag_spec).unsqueeze(0)\n   402\t\n   403\t\n   404\t            evaluator = Evaluator()\n   405\t            gt_edt = evaluator.measure_edt(tgt_wav[0, 0, :8000].cpu().numpy())\n   406\t            pred_edt = evaluator.measure_edt(out_wav[0, 0, :8000].cpu().numpy())\n   407\t            print(\"GT EDT: {}s, Pred EDT: {}s, EDT Error: {}s\".format(gt_edt, pred_edt, np.abs(gt_edt - pred_edt)))\n   408\t            edt_error_list.append(np.abs(gt_edt - pred_edt))\n   409\t\n   410\t\n   411\t            gt_c50 = evaluator.measure_clarity(tgt_wav[0, 0, :8000].cpu().numpy())\n   412\t            pred_c50 = evaluator.measure_clarity(out_wav[0, 0, :8000].cpu().numpy())\n   413\t            print(\"GT C50: {}dB, Pred C50: {}dB, C50 Error: {}dB\".format(gt_c50, pred_c50, np.abs(gt_c50 - pred_c50)))\n   414\t            if np.abs(gt_c50 - pred_c50) != np.inf and np.abs(gt_c50 - pred_c50) != -np.inf:\n   415\t                c50_error_list.append(np.abs(gt_c50 - pred_c50))\n   416\t            else:\n   417\t                count_outlier += 1\n   418\t\n   419\t            gt_t60 = evaluator.measure_rt60(tgt_wav[0, 0, :8000].cpu().numpy())\n   420\t            pred_t60 = evaluator.measure_rt60(out_wav[0, 0, :8000].cpu().numpy())\n   421\t            print(\"GT T60: {}s, Pred T60: {}s, T60 Percentage Error: {}\\%\".format(gt_t60, pred_t60, np.abs(gt_t60 - pred_t60) / gt_t60 * 100.))\n   422\t            t60_error_list.append(np.abs(gt_t60 - pred_t60) / gt_t60 * 100.)\n   423\t\n   424\t            mag_loss = evaluator.stft_loss(out_spec.squeeze(-1).cpu().numpy(), torch.log(tgt_spec + 1e-8).squeeze(1).cpu().numpy())\n   425\t            print(\"STFT loss: \".format(mag_loss))\n   426\t            mag_loss_list.append(mag_loss)\n   427\t            print(\"HHH\", cnt)\n   428\t\n   429\t            cnt += 1\n   430\t            print(\"Average EDT error: \", np.mean(edt_error_list))\n   431\t            print(\"Average C50 error: \", np.mean(c50_error_list))\n   432\t            print(\"Average T60 error: \", np.mean(t60_error_list))\n   433\t            print(\"----------{}----------\".format(cnt))\n   434\t\n   435\t        print(\"Average EDT error: \", np.mean(edt_error_list))\n   436\t        print(\"Average C50 error: \", np.mean(c50_error_list))\n   437\t        print(\"Average T60 error: \", np.mean(t60_error_list))\n   438\t        print(\"Number of Outliers: \", count_outlier)\n"},"started_at_ms":1790458709523,"completed_at_ms":1790458709523}}
/home/yixunhu/.codex/sessions/2026/09/26/rollout-2026-09-26T17-38-09-01a0dfa7-77ae-7b52-839b-bcc58738f2e6.jsonl:50:{"timestamp":"2026-09-26T21:38:29.546Z","ordinal":49,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a0dfa7-77ae-7b52-839b-bcc58738f2e6","turn_id":"01a0dfa7-77ce-7782-ac15-668bcbd12958","item":{"type":"CommandExecution","id":"exec-38f1bce5-747b-4aea-8ced-b1490f4e3104","process_id":"2887","command":["/bin/bash","-lc","nl -ba tools/per_sample_metrics.py"],"cwd":"file:///home/yixunhu/codespace/xRIR_code","parsed_cmd":[{"type":"read","cmd":"nl -ba tools/per_sample_metrics.py","name":"per_sample_metrics.py","path":"tools/per_sample_metrics.py"}],"source":"unified_exec_startup","status":"completed","stdout":"     1\t\"\"\"Per-sample versions of the exp_01 evaluation metrics (exp_03).\n     2\t\n     3\texp_03's unit of analysis is a single query compared with *itself* under a yaw\n     4\trotation, so every metric has to exist per sample and be numerically identical to what\n     5\tthe baseline scripts compute:\n     6\t\n     7\t* the loss halves go through the original ``utils.spec_utils`` functions on 1-sample\n     8\t  slices, laid out exactly as ``train_xRIR_backbone.compute_loss`` calls them;\n     9\t* the waveform comes from ``eval_unseen.griffin_lim``, but with its random phase\n    10\t  initialisation seeded per sample so that ``k = 0`` and ``k != 0`` -- and every model,\n    11\t  in any angle order -- invert the same magnitudes to the same waveform;\n    12\t* the acoustic errors apply ``eval_xRIR_backbone.py``'s validity rules unchanged,\n    13\t  returning NaN instead of raising or dropping a sample.\n    14\t\"\"\"\n    15\tfrom __future__ import annotations\n    16\t\n    17\timport contextlib\n    18\timport hashlib\n    19\timport io\n    20\timport numbers\n    21\t\n    22\timport numpy as np\n    23\timport torch\n    24\t\n    25\tfrom eval_unseen import griffin_lim\n    26\tfrom utils.spec_utils import compute_spect_energy_decay_losses, stft_l1_loss\n    27\t\n    28\t\n    29\tdef per_sample_losses(out_spec, tgt_spec):\n    30\t    \"\"\"Per-sample test loss, split into its STFT-L1 and energy-decay halves.\n    31\t\n    32\t    Calls the two loss functions on 1-sample slices, in the same layout as\n    33\t    ``train_xRIR_backbone.compute_loss`` (which reduces with ``mean``), so the mean of\n    34\t    the returned per-sample values is the batch loss and no batch-size effect can leak\n    35\t    into a paired comparison.  ``compute_spect_energy_decay_losses`` prints its input\n    36\t    shapes on every call, so stdout is redirected exactly as the training script does.\n    37\t\n    38\t    Args:\n    39\t        out_spec: predicted log-magnitude spectrograms ``[B, F, T, 1]`` (model output).\n    40\t        tgt_spec: target magnitude spectrograms ``[B, 1, F, T]`` (model output).\n    41\t\n    42\t    Returns:\n    43\t        ``(loss, stft, decay)``: three detached CPU float32 tensors of shape ``[B]``,\n    44\t        with ``loss = stft + decay``.\n    45\t    \"\"\"\n    46\t    stft_terms = []\n    47\t    decay_terms = []\n    48\t    with torch.no_grad():\n    49\t        for i in range(out_spec.shape[0]):\n    50\t            gt = tgt_spec[i:i + 1].permute(0, 2, 3, 1)\n    51\t            pred = out_spec[i:i + 1]\n    52\t            with contextlib.redirect_stdout(io.StringIO()):\n    53\t                decay_terms.append(compute_spect_energy_decay_losses(\n    54\t                    gts=gt, preds=torch.exp(pred) - 1e-8))\n    55\t            stft_terms.append(stft_l1_loss(pred_spect=pred, gt_spect=gt))\n    56\t    stft = torch.stack(stft_terms).detach().cpu().float()\n    57\t    decay = torch.stack(decay_terms).detach().cpu().float()\n    58\t    return stft + decay, stft, decay\n    59\t\n    60\t\n    61\tdef sample_seed(base_seed, query_key):\n    62\t    \"\"\"A stable 63-bit per-sample seed derived from ``(base_seed, query_key)``.\n    63\t\n    64\t    Keyed by the query path rather than by a running counter, so the same query gets\n    65\t    the same seed at every angle, in every model, whatever order the runs happen in.\n    66\t\n    67\t    Args:\n    68\t        base_seed: run-level seed (in exp_03, the manifest seed).\n    69\t        query_key: the query's path relative to the IR root.\n    70\t\n    71\t    Returns:\n    72\t        A Python ``int`` in ``[0, 2**63)``.\n    73\t    \"\"\"\n    74\t    digest = hashlib.sha256(\"{}:{}\".format(base_seed, query_key).encode()).digest()[:8]\n    75\t    return int.from_bytes(digest, \"little\") & ((1 << 63) - 1)\n    76\t\n    77\t\n    78\tdef griffin_lim_seeded(mag_spec, seed):\n    79\t    \"\"\"``eval_unseen.griffin_lim`` with its random phase initialisation pinned.\n    80\t\n    81\t    Griffin-Lim starts from a random phase drawn from the global torch RNG, so an\n    82\t    unseeded inversion makes two evaluations of the *same* magnitudes differ -- noise\n    83\t    that would be indistinguishable from a rotation effect in a paired comparison.\n    84\t    Seeding immediately before the call makes the inversion a pure function of\n    85\t    ``(mag_spec, seed)``.\n    86\t\n    87\t    Note: this reseeds the global torch RNG as a side effect (that is the point); it is\n    88\t    for evaluation, never inside training.\n    89\t\n    90\t    Args:\n    91\t        mag_spec: magnitude spectrogram ``[F, T]`` or ``[1, F, T]`` (the model's\n    92\t            ``exp(out_spec) - 1e-8``).\n    93\t        seed: the per-sample seed, e.g. from :func:`sample_seed`.\n    94\t\n    95\t    Returns:\n    96\t        The inverted waveform as ``[1, T]`` -- the batch dimension is kept, so callers\n    97\t        index it exactly like ``eval_xRIR_backbone.py`` does (``wav[0, :8000]``).\n    98\t\n    99\t    Raises:\n   100\t        ValueError: if ``mag_spec`` is not ``[F, T]`` or ``[1, F, T]``.\n   101\t    \"\"\"\n   102\t    mag = mag_spec\n   103\t    if mag.dim() == 2:\n   104\t        mag = mag.unsqueeze(0)\n   105\t    if mag.dim() != 3 or mag.shape[0] != 1:\n   106\t        raise ValueError(\"mag_spec must be [F, T] or [1, F, T], got shape {}\".format(\n   107\t            tuple(mag_spec.shape)))\n   108\t    torch.manual_seed(int(seed))\n   109\t    return griffin_lim(mag)\n   110\t\n   111\t\n   112\tdef acoustic_metrics(pred_ir, gt_ir, evaluator, want_t60=True, window=8000):\n   113\t    \"\"\"EDT / C50 / T60 errors of one prediction, with exp_01's validity rules.\n   114\t\n   115\t    Applies ``eval_xRIR_backbone.py``'s rules unchanged, on the first ``window``\n   116\t    samples of each IR.  The window is enforced *here* rather than left to the caller,\n   117\t    so no call site can widen it and quietly compare a rotated angle on more of the tail\n   118\t    than ``k = 0`` was measured on:\n   119\t\n   120\t    * ``edt``  -- ``|EDT(gt) - EDT(pred)|`` in seconds; NaN if either measurement raises\n   121\t      ``ValueError``/``IndexError`` (a silent or all-zero IR has no Schroeder decay);\n   122\t    * ``c50``  -- ``|C50(gt) - C50(pred)|`` in dB; NaN when the difference is not finite\n   123\t      (the exp_01 \"C50 outlier\" rule);\n   124\t    * ``t60``  -- ``|T60(gt) - T60(pred)| / T60(gt) * 100`` as a percentage; NaN on\n   125\t      ``ValueError``/``IndexError``/``ZeroDivisionError``, and NaN when ``want_t60`` is\n   126\t      False.\n   127\t\n   128\t    Any non-finite result is normalised to NaN, so a vanishing ``T60(gt)`` reports an\n   129\t    invalid sample rather than an infinite \"error\" that would swamp a mean.\n   130\t\n   131\t    A NaN here means \"this sample is invalid at this angle\"; the paired analysis drops\n   132\t    the pair and reports the invalid fraction separately, so nothing is ever silently\n   133\t    imputed.  numpy's divide/invalid warnings are suppressed locally -- a degenerate IR\n   134\t    is an expected outcome, not a bug.\n   135\t\n   136\t    Args:\n   137\t        pred_ir: predicted impulse response (1-D numpy array).\n   138\t        gt_ir: ground-truth impulse response, same length.\n   139\t        evaluator: an ``eval_unseen.Evaluator``.\n   140\t        want_t60: compute T60 (it is the noisiest metric and descriptive only).\n   141\t            When False, ``measure_rt60`` is not called at all.\n   142\t        window: number of leading samples measured; exp_01's 8000.\n   143\t\n   144\t    Returns:\n   145\t        ``{\"edt\": float, \"c50\": float, \"t60\": float}``, NaN where invalid.\n   146\t\n   147\t    Raises:\n   148\t        ValueError: if ``window`` is not a positive integer.\n   149\t    \"\"\"\n   150\t    if isinstance(window, bool) or not isinstance(window, numbers.Integral) or int(window) < 1:\n   151\t        raise ValueError(\"window must be a positive integer number of samples, got {!r}\"\n   152\t                         .format(window))\n   153\t    pred_ir = np.asarray(pred_ir)[:int(window)]\n   154\t    gt_ir = np.asarray(gt_ir)[:int(window)]\n   155\t\n   156\t    nan = float(\"nan\")\n   157\t    edt = c50 = t60 = nan\n   158\t    with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n   159\t        try:\n   160\t            edt = abs(evaluator.measure_edt(gt_ir) - evaluator.measure_edt(pred_ir))\n   161\t        except (ValueError, IndexError):\n   162\t            edt = nan\n   163\t        clarity = abs(evaluator.measure_clarity(gt_ir) - evaluator.measure_clarity(pred_ir))\n   164\t        c50 = float(clarity) if np.isfinite(clarity) else nan\n   165\t        if want_t60:\n   166\t            try:\n   167\t                gt_t60 = evaluator.measure_rt60(gt_ir)\n   168\t                t60 = abs(gt_t60 - evaluator.measure_rt60(pred_ir)) / gt_t60 * 100.0\n   169\t            except (ValueError, IndexError, ZeroDivisionError):\n   170\t                t60 = nan\n   171\t    return {key: (float(value) if np.isfinite(value) else nan)\n   172\t            for key, value in ((\"edt\", edt), (\"c50\", c50), (\"t60\", t60))}\n","stderr":"","aggregated_output":"     1\t\"\"\"Per-sample versions of the exp_01 evaluation metrics (exp_03).\n     2\t\n     3\texp_03's unit of analysis is a single query compared with *itself* under a yaw\n     4\trotation, so every metric has to exist per sample and be numerically identical to what\n     5\tthe baseline scripts compute:\n     6\t\n     7\t* the loss halves go through the original ``utils.spec_utils`` functions on 1-sample\n     8\t  slices, laid out exactly as ``train_xRIR_backbone.compute_loss`` calls them;\n     9\t* the waveform comes from ``eval_unseen.griffin_lim``, but with its random phase\n    10\t  initialisation seeded per sample so that ``k = 0`` and ``k != 0`` -- and every model,\n    11\t  in any angle order -- invert the same magnitudes to the same waveform;\n    12\t* the acoustic errors apply ``eval_xRIR_backbone.py``'s validity rules unchanged,\n    13\t  returning NaN instead of raising or dropping a sample.\n    14\t\"\"\"\n    15\tfrom __future__ import annotations\n    16\t\n    17\timport contextlib\n    18\timport hashlib\n    19\timport io\n    20\timport numbers\n    21\t\n    22\timport numpy as np\n    23\timport torch\n    24\t\n    25\tfrom eval_unseen import griffin_lim\n    26\tfrom utils.spec_utils import compute_spect_energy_decay_losses, stft_l1_loss\n    27\t\n    28\t\n    29\tdef per_sample_losses(out_spec, tgt_spec):\n    30\t    \"\"\"Per-sample test loss, split into its STFT-L1 and energy-decay halves.\n    31\t\n    32\t    Calls the two loss functions on 1-sample slices, in the same layout as\n    33\t    ``train_xRIR_backbone.compute_loss`` (which reduces with ``mean``), so the mean of\n    34\t    the returned per-sample values is the batch loss and no batch-size effect can leak\n    35\t    into a paired comparison.  ``compute_spect_energy_decay_losses`` prints its input\n    36\t    shapes on every call, so stdout is redirected exactly as the training script does.\n    37\t\n    38\t    Args:\n    39\t        out_spec: predicted log-magnitude spectrograms ``[B, F, T, 1]`` (model output).\n    40\t        tgt_spec: target magnitude spectrograms ``[B, 1, F, T]`` (model output).\n    41\t\n    42\t    Returns:\n    43\t        ``(loss, stft, decay)``: three detached CPU float32 tensors of shape ``[B]``,\n    44\t        with ``loss = stft + decay``.\n    45\t    \"\"\"\n    46\t    stft_terms = []\n    47\t    decay_terms = []\n    48\t    with torch.no_grad():\n    49\t        for i in range(out_spec.shape[0]):\n    50\t            gt = tgt_spec[i:i + 1].permute(0, 2, 3, 1)\n    51\t            pred = out_spec[i:i + 1]\n    52\t            with contextlib.redirect_stdout(io.StringIO()):\n    53\t                decay_terms.append(compute_spect_energy_decay_losses(\n    54\t                    gts=gt, preds=torch.exp(pred) - 1e-8))\n    55\t            stft_terms.append(stft_l1_loss(pred_spect=pred, gt_spect=gt))\n    56\t    stft = torch.stack(stft_terms).detach().cpu().float()\n    57\t    decay = torch.stack(decay_terms).detach().cpu().float()\n    58\t    return stft + decay, stft, decay\n    59\t\n    60\t\n    61\tdef sample_seed(base_seed, query_key):\n    62\t    \"\"\"A stable 63-bit per-sample seed derived from ``(base_seed, query_key)``.\n    63\t\n    64\t    Keyed by the query path rather than by a running counter, so the same query gets\n    65\t    the same seed at every angle, in every model, whatever order the runs happen in.\n    66\t\n    67\t    Args:\n    68\t        base_seed: run-level seed (in exp_03, the manifest seed).\n    69\t        query_key: the query's path relative to the IR root.\n    70\t\n    71\t    Returns:\n    72\t        A Python ``int`` in ``[0, 2**63)``.\n    73\t    \"\"\"\n    74\t    digest = hashlib.sha256(\"{}:{}\".format(base_seed, query_key).encode()).digest()[:8]\n    75\t    return int.from_bytes(digest, \"little\") & ((1 << 63) - 1)\n    76\t\n    77\t\n    78\tdef griffin_lim_seeded(mag_spec, seed):\n    79\t    \"\"\"``eval_unseen.griffin_lim`` with its random phase initialisation pinned.\n    80\t\n    81\t    Griffin-Lim starts from a random phase drawn from the global torch RNG, so an\n    82\t    unseeded inversion makes two evaluations of the *same* magnitudes differ -- noise\n    83\t    that would be indistinguishable from a rotation effect in a paired comparison.\n    84\t    Seeding immediately before the call makes the inversion a pure function of\n    85\t    ``(mag_spec, seed)``.\n    86\t\n    87\t    Note: this reseeds the global torch RNG as a side effect (that is the point); it is\n    88\t    for evaluation, never inside training.\n    89\t\n    90\t    Args:\n    91\t        mag_spec: magnitude spectrogram ``[F, T]`` or ``[1, F, T]`` (the model's\n    92\t            ``exp(out_spec) - 1e-8``).\n    93\t        seed: the per-sample seed, e.g. from :func:`sample_seed`.\n    94\t\n    95\t    Returns:\n    96\t        The inverted waveform as ``[1, T]`` -- the batch dimension is kept, so callers\n    97\t        index it exactly like ``eval_xRIR_backbone.py`` does (``wav[0, :8000]``).\n    98\t\n    99\t    Raises:\n   100\t        ValueError: if ``mag_spec`` is not ``[F, T]`` or ``[1, F, T]``.\n   101\t    \"\"\"\n   102\t    mag = mag_spec\n   103\t    if mag.dim() == 2:\n   104\t        mag = mag.unsqueeze(0)\n   105\t    if mag.dim() != 3 or mag.shape[0] != 1:\n   106\t        raise ValueError(\"mag_spec must be [F, T] or [1, F, T], got shape {}\".format(\n   107\t            tuple(mag_spec.shape)))\n   108\t    torch.manual_seed(int(seed))\n   109\t    return griffin_lim(mag)\n   110\t\n   111\t\n   112\tdef acoustic_metrics(pred_ir, gt_ir, evaluator, want_t60=True, window=8000):\n   113\t    \"\"\"EDT / C50 / T60 errors of one prediction, with exp_01's validity rules.\n   114\t\n   115\t    Applies ``eval_xRIR_backbone.py``'s rules unchanged, on the first ``window``\n   116\t    samples of each IR.  The