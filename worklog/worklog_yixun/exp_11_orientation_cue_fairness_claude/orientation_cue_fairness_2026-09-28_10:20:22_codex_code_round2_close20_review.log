+def default_signals():
+    """Give the child the signal dispositions a terminal would.
+
+    A shell inherits SIGINT ignored when it is started under `nohup`, `setsid` or as a
+    background job without job control, and bash cannot trap a signal that was ignored
+    on entry -- so an INT trap simply never registers there. That is a property of how
+    the SUITE was launched, not of the launcher: a real exp_11 launcher is started with
+    `nohup setsid`, never sees SIGINT at all, and its TERM trap -- the operative one --
+    registers regardless.
+    """
+    signal.signal(signal.SIGINT, signal.SIG_DFL)
+    signal.signal(signal.SIGTERM, signal.SIG_DFL)
+
