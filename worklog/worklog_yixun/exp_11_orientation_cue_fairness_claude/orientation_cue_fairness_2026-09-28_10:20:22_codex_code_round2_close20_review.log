+def commit_record(repo, value, message):
+    """Write the record into a tmp repository and commit it; return that commit."""
+    path = repo / profiles.APPROVED_RELATIVE
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(json.dumps(value, indent=2, sort_keys=True) + '\n')
