  1750	@pytest.mark.parametrize('mode,what', [(0o300, 'search and write, no read'),
  1751	                                       (0o100, 'search only')])
  1752	@pytest.mark.parametrize('scan_mode', ['full', 'finalize'])
  1753	def test_an_arm_root_that_cannot_be_listed_is_never_quiet(tmp_path, mode, what, scan_mode):
