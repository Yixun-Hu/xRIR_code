   207	require_passed() {  # require_passed <run dir>: the next rung consumes this one's checkpoint
   208	    if ! run "$PYTHON" tools/exp11_finalize.py passed --run-dir "$1" --run-type exp11_smoke; then
   209	        say "STOP $1 did not pass; the rung that consumes its checkpoint is not started"
   210	        exit 2
