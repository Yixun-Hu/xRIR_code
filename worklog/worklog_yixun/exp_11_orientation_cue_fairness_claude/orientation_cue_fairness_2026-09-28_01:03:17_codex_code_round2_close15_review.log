    88	# apply_reader_override: EXP11_PYTHON lets a regression break the pid reader the way a
    89	# broken environment would -- a missing interpreter, an unimportable module -- so the
    90	# fail-closed paths can be exercised against this file rather than a copy of it. Like
    91	# EXP11_PRETRAIN_ROOT it is a dry-run test affordance and is refused outright otherwise:
    92	# a real launch decides liveness with the interpreter the pinned library names, and no
    93	# invocation may swap the interpreter that also finalizes, publishes and trains.
    94	apply_reader_override() {
    95	    [ -n "${EXP11_PYTHON:-}" ] || return 0
    96	    if [ "${EXP11_TEST_ROOTS:-0}" != 1 ] || [ "$DRY" -ne 1 ]; then
    97	        echo "refusing: EXP11_PYTHON replaces the interpreter that reads every pid file," \
    98	             "so it is honoured only with EXP11_TEST_ROOTS=1 and --dry-run" >&2
    99	        return 1
   100	    fi
   101	    PYTHON="$EXP11_PYTHON"
   102	}
