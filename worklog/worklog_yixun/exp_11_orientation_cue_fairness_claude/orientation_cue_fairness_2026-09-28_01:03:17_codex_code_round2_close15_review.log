  1755	    old, attempt, stub = registered_live_attempt(tmp_path)
  1756	    root = old.parent
  1757	    unlistable(root, mode)
  1758	    try:
  1759	        result = scan_under_lock(root, mode=scan_mode)
  1760	        assert result.returncode == 2, (what, result.stdout, result.stderr)
  1761	        assert 'cannot be enumerated' in result.stderr, result.stderr
  1762	        assert 'PROMOTE' not in result.stdout
  1763	    finally:
  1764	        root.chmod(0o700)
  1765	        stub.terminate()
  1766	        stub.wait(timeout=30)
