   582	# --- the intent marker: the half-second the frozen lifecycle cannot cover -----------
   583	# `run_child` forks the detached trainer and writes child.pid only afterwards, and the
   584	# trainer needs a moment to write its own. A launcher that dies inside that window would
   585	# leave a running trainer nothing names. So the intent to launch is declared BEFORE the
   586	# fork and withdrawn only once the TRAINER is accounted for -- a complete child.pid and a
   587	# train.exit. `child.pid` holds the timeout wrapper's pid, so its death says nothing about
   588	# the trainer (close review 10). A marker left behind means "a trainer of this attempt may
   589	# be running, or died without saying so", and the arm stays closed until an operator
   590	# resolves it: a trainer that crashes before registering fails closed, by design.
   591	mark_launching() {  # mark_launching <attempt>
   592	    printf 'launcher %s\nat %s\narm %s\n' \
   593	        "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$ARM" > "$1/launching"
   594	}
   595	
   596	clear_launching() {  # clear_launching <attempt>: only once the TRAINER is accounted for
   597	    # This runs after run_child returns, so the wrapper and the sink are gone. A complete
   598	    # child.pid proves the wrapper was recorded; train.exit proves the trainer itself
   599	    # finished. A trainer that crashed before registering leaves the marker standing and
   600	    # the attempt unresolved -- fail closed, by design: the operator answers it.
   601	    # `|| return 0` covers BOTH "no complete child.pid" and "the reader could not say":
   602	    # a marker is withdrawn on an answer, never on the absence of one (close review 11).
   603	    # And not at all while the arm it belongs to cannot even be enumerated: the marker is
   604	    # protection, and protection is not withdrawn on an understanding we do not have
   605	    # (close review 13).
   606	    local listing=""
   607	    listing="$(mktemp "$EXP11_TEMPDIR/attempts.XXXXXX")" || return 0
   608	    if ! list_attempts "$(dirname -- "$1")" "$listing"; then rm -f -- "$listing"; return 0; fi
   609	    rm -f -- "$listing"
   610	    registration_complete "$1" || return 0
   611	    file_present "$1/train.exit" || return 0   # absent OR unknown: the marker stays
   612	    rm -f -- "$1/launching"
   613	}
