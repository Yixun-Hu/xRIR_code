  1703	def test_the_file_classification_does_not_depend_on_a_translated_word(tmp_path):
  1704	    """`stat -c %F` prints a phrase in the caller's language.
  1705	
  1706	    "regular file" is `fichier régulier` under a French locale and something else again
  1707	    elsewhere, so a classification that matches that text calls a perfectly ordinary
  1708	    train.pid a directory -- and a live trainer's record then reads as no record. The
  1709	    mode bits are the same in every language.
  1710	    """
  1711	    text = (REPO / 'tools/exp11_launch.sh').read_text()
  1712	    assert '-c %F' not in text, 'the file type must be read from the mode, not a phrase'
  1713	    fifo = tmp_path / 'child.pid'
  1714	    os.mkfifo(str(fifo))
  1715	    result = lib('status=0\npid_record {fifo} || status=$?\necho "STATUS $status"\n'
  1716	                 .format(fifo=fifo))
  1717	    assert 'STATUS 1' in result.stdout, result.stdout   # definite, and it did not block
