   170	    echo "       [--attempt-root <dir>] [--approved <json>] [--exploratory]" >&2
   171	    echo "       [--attempt <dir> --log <path> --child-exit <n>] [--dry-run]" >&2
   172	    echo "       finalize also takes [--replace-final]" >&2
   173	    exit 2
   174	}
