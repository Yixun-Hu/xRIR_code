   176	# arm_of <H|I>: the attempt root, augmentation and saving cadence of one pretraining arm.
   177	# H is exp_01's recipe (save_every 500); I is exp_04's, whose constraints the trainer
   178	# re-applies (--save-every 0 and no --resume).
   179	arm_of() { case "$1" in
   180	  H) ARM_ROOT="$SIMPOR_ROOT"; ARM_YAW=0; ARM_SAVE_EVERY=500;;
   181	  I) ARM_ROOT="$SIMPOR_YAW_ROOT"; ARM_YAW=1; ARM_SAVE_EVERY=0;;
   182	  *) echo "refusing: unknown arm $1 (H or I)" >&2; return 1;; esac
   183	  ARM_BACKBONE=simple_oriented; }
   184	
   185	# Every gate before a child starts, through exp_11's own finalizer: HEAD at the reviewed
   186	# commit, a tree clean outside worklog/, no live launch.pid or child.pid under either
   187	# attempt root or the smoke tree, exp_11's approvals, and -- for probe and full -- a card
   188	# with no compute apps at all.
   189	preflight() {
   190	    local extra=()
   191	    [ "${EXPLORATORY:-0}" -eq 0 ] || extra+=(--exploratory)
   192	    [ "$MODE" != smoke ] || extra+=(--min-free-gb "$SMOKE_MAX_GB")
   193	    run "$PYTHON" tools/exp11_finalize.py preflight --mode "$MODE" --gpu "$GPU" \
   194	        --reviewed-commit "$COMMIT" --attempt-root "$SIMPOR_ROOT" \
   195	        --attempt-root "$SIMPOR_YAW_ROOT" --attempt-root "$SMOKE_DIR" \
