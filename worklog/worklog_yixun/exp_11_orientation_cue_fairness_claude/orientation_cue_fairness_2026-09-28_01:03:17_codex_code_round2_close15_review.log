  1720	# --- close review 13: a root we cannot LIST hides every attempt in it ---------------
  1721	# A directory with mode 0300 is searchable and writable but not listable. The glob
  1722	# `"$root"/attempt_*` over it silently expands to nothing, the unmatched pattern fails
  1723	# `-d`, and the scan declared the arm quiet -- while both locks still acquired, because
  1724	# a lock file is a known pathname. A resolution then retired a registered live trainer.
  1725	
  1726	
  1727	def scan_under_lock(root, mode='full'):
  1728	    """``require_quiet_arm`` where each mode runs it: under the arm lock."""
  1729	    return lib('ARM_ROOT={root}\nDRY=0\nARM=H\n'
  1730	               'hold_arm_lock {mode} || exit 9\nrequire_quiet_arm\n'.format(
  1731	                   root=root, mode=mode), {'EXP11_TEST_ROOTS': '1'})
  1732	
  1733	
  1734	def resolve_under_lock(attempt, grace='3600'):
  1735	    return lib('ARM_ROOT={root}\nDRY=0\nARM=H\nUNRESOLVED_GRACE_S={grace}\n'
  1736	               'hold_arm_lock finalize || exit 9\n'
  1737	               'resolve_unregistered {attempt}\n'.format(
  1738	                   root=attempt.parent, grace=grace, attempt=attempt),
  1739	               {'EXP11_TEST_ROOTS': '1'})
  1740	
  1741	
  1742	def unlistable(root, mode):
  1743	    """Take away the right to LIST the arm, leaving the lock files reachable."""
  1744	    (root / '.publish.lock').touch()
  1745	    (root / '.registration.lock').touch()
  1746	    root.chmod(mode)
  1747	
