   158	def attempt_with(root, arm, profile, tmp_path, name='attempt_20260927T000000'):
   159	    """One attempt directory under a pretraining root, with the args a profile selects."""
   160	    from tools import exp11_recipe
   161	    spec = exp11_recipe.PROFILES[profile]
   162	    args = dict(spec['recipe'], yaw_aug_seed=0, yaw_aug_width=512)
   163	    args.update(spec['production'])
   164	    args.update(backbone=spec['backbone'], save_dir='x', num_workers=12, log_interval=50,
   165	                save_every=spec['save_every'], epoch_ckpt_every=spec['epoch_ckpt_every'],
   166	                env={}, train_batches_per_epoch=exp11_recipe.TRAIN_BATCHES_PER_EPOCH,
   167	                tier='M', param_counts={}, exp11_run_type='full', exp11_profile=profile,
   168	                exp11_registry_sha256='a' * 64, exp11_source_closure_sha256='b' * 64,
   169	                exp11_git_head='c' * 40, exp11_provenance_path='p')
   170	    directory = tmp_path / root / name
   171	    directory.mkdir(parents=True)
   172	    (directory / 'args.json').write_text(json.dumps(args))
   173	    return directory
