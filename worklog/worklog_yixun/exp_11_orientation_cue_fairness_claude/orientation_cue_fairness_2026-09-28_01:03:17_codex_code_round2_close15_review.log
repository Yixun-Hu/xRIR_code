   176	def recovery(attempt, arm, tmp_path, extra=(), log='L.log'):
   177	    return launch(['finalize', '--arm', arm, '--gpu', '1', '--reviewed-commit', COMMIT,
   178	                   '--attempt', str(attempt), '--log', log, '--child-exit', '0',
   179	                   '--dry-run'] + list(extra),
   180	                  {'EXP11_PRETRAIN_ROOT': str(tmp_path), 'EXP11_TEST_ROOTS': '1'})
