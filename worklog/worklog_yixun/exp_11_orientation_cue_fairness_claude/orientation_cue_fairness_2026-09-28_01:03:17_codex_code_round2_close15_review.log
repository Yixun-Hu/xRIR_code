   214	promote() {  # promote <attempt basename>: atomic, so `final` never points at nothing
   215	    say "PROMOTE $ARM_ROOT/final -> $1"
   216	    if [ "${DRY:-0}" -eq 0 ]; then
   217	        ln -s -- "$1" "$ARM_ROOT/.final.$$"
   218	        mv -Tf -- "$ARM_ROOT/.final.$$" "$ARM_ROOT/final"
