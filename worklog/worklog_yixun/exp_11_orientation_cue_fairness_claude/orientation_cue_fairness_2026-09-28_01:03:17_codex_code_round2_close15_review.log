   222	# --- publishing one arm is serialised, by the kernel --------------------------------
   223	# Plan section 11 amendment A1, close review 6. Publishing one arm admits exactly one
   224	# invocation at a time: recovery from alias resolution through promotion, and a full run
   225	# from before it launches its child through promotion, so a recovery is refused while a
   226	# training run still owns the arm.
   227	#
   228	# The lock is an `flock` on a per-arm FILE, and it is NOT held by this shell: every
   229	# descriptor this shell has open is inherited by the background log sink and by the
   230	# detached training child, and an orphaned sink would keep an arm locked for good. It is
   231	# held by a HOLDER PROCESS whose life is leased to this launcher's -- it exits as soon as
   232	# its parent changes -- so **the lock vanishes within a second of this launcher's exit or
   233	# death**, on every path including a signal and SIGKILL, and is never inherited by the
   234	# trainer or the log sink. The attempt is non-blocking: it refuses at once,
   235	# never waits.
   236	LOCK_FILE=""
   237	HOLDER_PID=""
   238	
   239	hold_arm_lock() {  # hold_arm_lock <mode>
   240	    LOCK_FILE="$ARM_ROOT/.publish.lock"
   241	    say "LOCK $LOCK_FILE"
   242	    # A dry run touches nothing outside the test roots, so the lock is real exactly
   243	    # where the tests exercise it and announced everywhere else.
   244	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   245	    mkdir -p -- "$ARM_ROOT" || return 1
   246	    local verdict="" pid="" out=""
   247	    # `exec` inside the substitution makes the holder a direct child of this shell, so
   248	    # its lease is this shell's pid. The read end is closed the moment the verdict is in,
   249	    # so no descriptor of ours reaches the sink or the child either.
   250	    exec {out}< <(exec "$PYTHON" tools/exp11_lock_holder.py "$LOCK_FILE" $$)
   251	    read -r -t 30 verdict pid <&"$out" || true
   252	    exec {out}<&-
   253	    if [ "$verdict" = refused ]; then
   254	        echo "refusing: $LOCK_FILE is held by another invocation publishing this arm;" \
   255	             "one publication per arm at a time. Its holder ends with that invocation," \
   256	             "so there is nothing to clear by hand" >&2
   257	        return 1
   258	    fi
   259	    if [ "$verdict" != acquired ] || [ -z "$pid" ]; then
   260	        # Not someone else's lock: the holder never reported one. Say which it is.
   261	        echo "refusing: the lock holder for $LOCK_FILE did not start (no verdict);" \
   262	             "nothing was published" >&2
   263	        return 1
   264	    fi
   265	    HOLDER_PID="$pid"
   266	    trap 'on_signal INT 2' INT
   267	    trap 'on_signal TERM 15' TERM
   268	    trap 'drop_arm_lock; rm -rf -- "$EXP11_TEMPDIR"' EXIT
   269	    say "LOCKED $LOCK_FILE mode=$1"
   270	}
   271	
   272	# drop_arm_lock: end our own holder, so the ordinary path releases at once instead of
   273	# waiting out the lease. Every other path -- a signal, a crash, a kill -9 -- is covered
   274	# by the lease itself, which is why this needs no error handling of its own. A recorded
   275	# pid is not a licence to signal it: if that holder is already gone the number belongs to
   276	# whoever the kernel gave it to next, so nothing is sent unless the process is still this
   277	# shell's child.
   278	drop_arm_lock() {
   279	    [ -n "$HOLDER_PID" ] || return 0
   280	    local parent=""
   281	    parent="$(sed -n 's/^.*) [A-Za-z] \([0-9][0-9]*\).*/\1/p' \
   282	              "/proc/$HOLDER_PID/stat" 2>/dev/null || true)"
   283	    [ "$parent" = "$$" ] && { kill -TERM "$HOLDER_PID" 2>/dev/null || true; }
   284	    wait "$HOLDER_PID" 2>/dev/null || true
   285	    HOLDER_PID=""
   286	}
   287	
   288	# --- what the lock protects is a quiet arm -------------------------------------------
   289	# The lock says "one publication at a time"; it does not say "no trainer is running".
   290	# That is this scan's job, and it has to run UNDER the lock: a scan taken before
   291	# acquisition can go stale in the window between, which is exactly how a recovery could
   292	# promote an older attempt while a newer trainer of the same arm kept writing
   293	# (close review 7, blocker 1). `kill -0` asks the kernel whether a pid still exists; it
   294	# is a probe and sends no signal.
   295	UNRESOLVED_GRACE_S="${EXP11_UNRESOLVED_GRACE_S:-120}"
   296	SCAN_REASON=""
   297	NEWLINE=$'\n'   # a real newline: a verdict that is two lines is not a verdict
   298	
   299	# THREE answers, never two (close review 11). The grammar lives in
   300	# tools/exp11_pidrecord.py and nowhere else -- this shell does NOT read pid files, since
   301	# Bash command substitution drops NUL bytes (close review 10, blocker 1). But a reader
   302	# that cannot run -- no interpreter, an unimportable module, a crash -- used to be
   303	# indistinguishable from "this file holds no record": both were exit 1. Read as "no
   304	# record", a broken reader makes every pid file in the arm look dead, and a resolution
   305	# then retires the attempt of a registered, running trainer. So the reader now answers
   306	# `record <pid>` or `norecord` on stdout with exit 0, and everything else is UNKNOWN.
   307	#
   308	# pid_record <file>: 0 and the pid on stdout | 1 no record | 2 the reader failed.
   309	#
   310	# The verdict is checked as RAW BYTES, in a file, before anything of it passes through a
   311	# shell expansion: command substitution deletes trailing newlines and NUL bytes, so
   312	# `norecord\n\n` and `norecord\0\n` -- neither of which is the protocol -- arrived here
   313	# as clean verdicts and retired a live trainer's attempt (close review 12, blocker 2).
   314	# Only the digits of an accepted pid cross back, and digits survive intact.
   315	READER_UNKNOWN=2
   316	
   317	# --- three states for every path this launcher asks about (close review 14) ----------
   371	
   372	pid_record() {
   373	    local out="" pid="" kind="" size="" status=0
   374	    # What the path IS, decided before anything opens it: a directory, FIFO, socket or
   375	    # device is definitely not a pid record, and opening a FIFO would wait for a writer
   376	    # forever. A stat that FAILS decides nothing here -- the module tells a confirmed
   377	    # absence from a path it was not allowed to inspect (close review 12, blocker 1),
   378	    # which is why this is no longer `[ -f ]`: that reads an unreadable parent as "gone".
   379	    # `%f` is the mode in hex, not `%F`'s phrase: that phrase is translated, so matching
   380	    # it would classify an ordinary file as "not a record" under any other locale.
   381	    if kind="$(stat -L -c %f -- "$1" 2>/dev/null)"; then
   382	        case "$kind" in ''|*[!0-9a-fA-F]*) return "$READER_UNKNOWN" ;; esac
   383	        if [ $(( 0x$kind & 0xF000 )) -ne $(( 0x8000 )) ]; then
   384	            return 1                          # definite: not a regular file, unopened
   385	        fi
   386	    fi
   387	    out="$(mktemp "$EXP11_TEMPDIR/verdict.XXXXXX")" || return "$READER_UNKNOWN"
   388	    timeout "$READER_TIMEOUT_S" "$PYTHON" -m tools.exp11_pidrecord "$1" \
   389	        > "$out" 2>/dev/null || status=$?
   390	    if [ "$status" -ne 0 ]; then rm -f -- "$out"; return "$READER_UNKNOWN"; fi
   391	    # A verdict is eighteen bytes at most ('record ' + ten digits + a newline), so the
   392	    # size answers first and no rogue reader's output is ever read, compared or -- worst
   393	    # of all -- materialised as a shell variable (close review 13, nonblocking).
   394	    size="$(stat -c %s -- "$out" 2>/dev/null)" || { rm -f -- "$out"; return "$READER_UNKNOWN"; }
   395	    case "$size" in ''|*[!0-9]*) rm -f -- "$out"; return "$READER_UNKNOWN" ;; esac
   396	    if [ "$size" -gt 64 ]; then rm -f -- "$out"; return "$READER_UNKNOWN"; fi
   397	    if cmp -s "$out" <(printf 'norecord\n'); then rm -f -- "$out"; return 1; fi
   398	    # Digits only -- a candidate, not yet a verdict: the bytes must then match the whole
   399	    # line exactly, which is what refuses padding, NULs, CR and trailing junk.
   400	    pid="$(head -c 64 -- "$out" | tr -cd '0-9')"
   401	    case "$pid" in ''|*[!0-9]*) rm -f -- "$out"; return "$READER_UNKNOWN" ;; esac
   402	    [ "${#pid}" -le 10 ] || { rm -f -- "$out"; return "$READER_UNKNOWN"; }
   403	    if cmp -s "$out" <(printf 'record %s\n' "$pid"); then
   404	        rm -f -- "$out"
   405	        printf '%s\n' "$pid"
   406	        return 0
   407	    fi
   408	    rm -f -- "$out"
   409	    return "$READER_UNKNOWN"
   410	}
   411	
   412	# pid_alive <file>: 0 the recorded pid is alive | 1 it is not | 2 nobody can say.
   413	pid_alive() {
   414	    local pid="" status=0
   415	    pid="$(pid_record "$1")" || status=$?
   416	    [ "$status" -ne "$READER_UNKNOWN" ] || return "$READER_UNKNOWN"
   417	    [ "$status" -eq 0 ] || return 1
   418	    kill -0 "$pid" 2>/dev/null
   419	}
   420	
   421	# registration_complete <attempt>: child.pid holds one pid, by the grammar above. The
   422	# shell creates that file by redirection before the pid reaches it, so existence alone
   423	# proves nothing; what makes a launch *registered* is a number to look for. Whether that
   424	# number is still alive is a separate question, asked by pid_alive of the same bytes.
   425	# 0 complete | 1 not complete | 2 unknown -- the unknown is never folded into "not".
   426	registration_complete() {
   427	    pid_record "$1/child.pid" >/dev/null
   428	}
   429	
   430	# check_pid_reader: ask the reader two questions whose answers are known, before any
   431	# decision is taken. A reader stuck on one verdict never fails -- "record 1" for
   432	# everything makes every pid file a registration, "norecord" for everything makes every
   433	# trainer dead -- so only a probe catches it. The probes go through the same $PYTHON and
   434	# the same invocation as every real read.
   435	# probe_reader <file> <expected bytes> <where the answer goes>: 0 when the reader exited
   436	# 0 and printed EXACTLY those bytes. Byte for byte, like every real read.
   437	probe_reader() {
   438	    timeout "$READER_TIMEOUT_S" "$PYTHON" -m tools.exp11_pidrecord "$1" \
   439	        > "$3" 2>/dev/null || return 1
   440	    cmp -s "$3" "$2"
   441	}
   442	
   443	check_pid_reader() {
   444	    local dir="" bad=""
   445	    dir="$(mktemp -d "$EXP11_TEMPDIR/pidreader.XXXXXX")" || {
   446	        echo "refusing: cannot create a probe directory for the pid reader" >&2
   447	        return 1; }
   448	    printf '1\n' > "$dir/one"
   449	    : > "$dir/empty"
   450	    printf 'record 1\n' > "$dir/want_one"
   451	    printf 'norecord\n' > "$dir/want_empty"
   452	    probe_reader "$dir/one" "$dir/want_one" "$dir/got_one" || bad="a file holding 1"
   453	    probe_reader "$dir/empty" "$dir/want_empty" "$dir/got_empty" ||
   454	        bad="${bad:+$bad and }an empty file"
   455	    rm -rf -- "$dir"
   456	    [ -z "$bad" ] && return 0
   457	    echo "refusing: pid reader unhealthy: $PYTHON -m tools.exp11_pidrecord did not" \
   458	         "answer byte for byte on $bad -- 'record 1' and 'norecord', one line each and" \
   459	         "nothing more, no padding and no NULs. Nothing of this arm can be decided by a" \
   460	         "reader that cannot say what a pid file holds" >&2
   461	    return 1
   462	}
   463	
   464	# probe_live <pid file> <what is alive>: 0 nothing found, 1 alive, 2 unknown. The last
   465	# two set SCAN_REASON and must be propagated unchanged -- an unknown liveness is not a
   466	# quiet arm, it is no answer at all.
   467	probe_live() {
   468	    local status=0
   469	    pid_alive "$1" || status=$?
   470	    case "$status" in
   471	        0) SCAN_REASON="$2"; return 1 ;;
   472	        "$READER_UNKNOWN")
   473	            SCAN_REASON="liveness unknown: pid reader failed on $1. Nothing is scanned,"\
   474	" retired or published on an answer nobody gave"
   475	            return "$READER_UNKNOWN" ;;
   476	    esac
   477	    return 0
   478	}
