   199	finalize() {  # finalize <run dir> <log> <child-exit> <run-type> [receipt]
   200	    local extra=()
   201	    [ -z "${OWNER:-}" ] || extra+=(--owner-pid "$OWNER")
   202	    [ $# -lt 5 ] || extra+=(--receipt "$5")
   203	    run "$PYTHON" tools/exp11_finalize.py --run-dir "$1" --run-type "$4" --log "$2" \
   204	        --child-exit "$3" ${extra[@]+"${extra[@]}"}
   205	}
