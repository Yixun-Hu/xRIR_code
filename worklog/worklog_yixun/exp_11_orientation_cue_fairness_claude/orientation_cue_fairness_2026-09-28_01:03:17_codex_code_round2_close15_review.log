   118	# check_attempt <attempt> <root> <arm>: recovery may promote only this arm's own attempt.
   119	# The basename is linked under the root --arm selects, so an attempt of the other arm
   120	# would leave a dangling or wrong `final`; the directory AND the profile its recorded
   121	# arguments select must both be the selected arm's.
   122	CHECK_ATTEMPT_PY='
   123	import json, sys
   124	from pathlib import Path
   125	from tools import exp11_recipe
   126	attempt, root, arm = sys.argv[1:4]
   127	expected = {"H": "H_RECIPE", "I": "I_RECIPE"}[arm]
   128	try:
   129	    # The path that is VALIDATED must be the path that is finalized and promoted, or an
   130	    # alias (an existing `final`, or a link from outside) would be validated here and
   131	    # promoted by its own basename - a self-referencing or dangling link under the root.
   132	    directory, base = Path(attempt).resolve(), Path(root).resolve()
   133	    if directory.parent != base:
   134	        raise ValueError("attempt {} is not an attempt of the arm {} root {}".format(
   135	            directory, arm, base))
   136	    if not directory.name.startswith("attempt_"):
   137	        raise ValueError("{} is not an attempt_<UTC> directory".format(directory))
   138	    args = json.loads((directory / "args.json").read_text())
   139	    profile = exp11_recipe.select_profile(args)
   140	    if profile != expected:
   141	        raise ValueError("attempt {} recorded the profile {}, not the {} of arm {}".format(
   142	            directory, profile, expected, arm))
   143	except (OSError, ValueError, KeyError) as error:
   144	    raise SystemExit("refusing: " + str(error))
   145	print("ATTEMPT ok {} arm={} profile={}".format(attempt, arm, expected))
   146	print("ATTEMPT canonical {}".format(directory))
   147	'
   148	
   149	# check_attempt <attempt>: sets CANONICAL_ATTEMPT to the resolved directory, which is
   150	# what finalization and promotion then use.
   151	check_attempt() {
   152	    local output
   153	    say "ATTEMPTCHECK $1 arm=$ARM root=$ARM_ROOT"
   154	    output="$(CUDA_VISIBLE_DEVICES="" "$PYTHON" -c "$CHECK_ATTEMPT_PY" "$1" "$ARM_ROOT" \
   155	              "$ARM")" || return 1
   156	    printf '%s\n' "$output"
   157	    CANONICAL_ATTEMPT="${output##*ATTEMPT canonical }"
   158	    case "$CANONICAL_ATTEMPT" in
   159	        "$ARM_ROOT"/attempt_*|/*) ;;
   160	        *) echo "refusing: no canonical attempt was resolved for $1" >&2; return 1 ;;
   161	    esac
   162	}
   163	ARM=""
   164	ARM_BACKBONE=simple_oriented
