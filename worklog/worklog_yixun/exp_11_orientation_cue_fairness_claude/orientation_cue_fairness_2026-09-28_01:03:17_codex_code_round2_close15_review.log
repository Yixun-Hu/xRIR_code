    67	FULL_CEILING_MAX=129600
    68	FULL_CEILING_S="${EXP11_FULL_CEILING_S-$FULL_CEILING_MAX}"
    69	
    70	# The value is validated as a BOUNDED DECIMAL STRING before any arithmetic: bash's
    71	# integer comparisons error out above 2**63-1, which left the `if` false and the launch
    72	# running with an overflowing value handed to GNU timeout. Six digits is the whole
    73	# contract (129600 has six), so the numeric comparison below can never be out of range;
    74	# leading zeros are refused with everything else that is not a plain decimal.
    75	check_ceiling() {
    76	    local why="must be a plain decimal of at most 6 digits in (0, $FULL_CEILING_MAX]"
    77	    case "$FULL_CEILING_S" in
    78	        ''|*[!0-9]*|0*|???????*)
    79	            echo "refusing: EXP11_FULL_CEILING_S '$FULL_CEILING_S' $why" >&2; return 1 ;;
    80	    esac
    81	    if [ "$FULL_CEILING_S" -le 0 ] || [ "$FULL_CEILING_S" -gt "$FULL_CEILING_MAX" ]; then
    82	        echo "refusing: EXP11_FULL_CEILING_S $FULL_CEILING_S $why;" \
    83	             "an override may only tighten the 36 h ceiling" >&2
    84	        return 1
    85	    fi
    86	}
