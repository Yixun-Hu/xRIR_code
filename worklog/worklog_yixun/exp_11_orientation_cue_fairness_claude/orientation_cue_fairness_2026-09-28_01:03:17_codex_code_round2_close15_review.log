   107	    if [ "${EXP11_TEST_ROOTS:-0}" != 1 ] || [ "$DRY" -ne 1 ]; then
   108	        echo "refusing: EXP11_PRETRAIN_ROOT moves the attempt roots and the roots" \
   109	             "preflight scans, so it is honoured only with EXP11_TEST_ROOTS=1 and" \
   110	             "--dry-run" >&2
