   183	def publish(attempt, target=None, completed=True):
   184	    """Make ``final`` point at an attempt, as a finished run leaves the root."""
   185	    if completed:
   186	        (attempt / 'completion.json').write_text('{"run_type": "exp11_train"}')
   187	    link = attempt.parent / 'final'
   188	    if link.is_symlink() or link.exists():
   189	        link.unlink()
   190	    link.symlink_to((target or attempt).name)
   191	    return link
