   137	def load_approved_digests(path=None, repo=None, commit=None):
   138	    """Read the approvals; unknown or missing keys and malformed values are refused.
   139	
   140	    Returns ``(frozen approvals, {'path', 'sha256'})``. The hash is what a producer
   141	    records so the finalizer can re-read the file and prove it did not change mid-run.
   142	    With ``repo`` and ``commit`` the bytes must also equal the blob committed there, and
   143	    the identity names the tracked path and the commit it was bound to.
   144	    """
   145	    if (repo is None) != (commit is None):
   146	        raise ValueError('binding approvals needs both the repository and the commit')
   147	    path = Path(TEMPLATE_PATH if path is None else path).resolve()
   148	    try:
   149	        raw = path.read_bytes()
   150	        value = json.loads(raw)
   151	    except (OSError, ValueError) as error:
   152	        raise ValueError('approved digests are unreadable: {}'.format(error)) from error
   153	    _shape(value, ('schema_version', 'code', 'reused', 'artifacts'), 'the file')
   154	    if value['schema_version'] != SCHEMA_VERSION or type(value['schema_version']) is not int:
   155	        raise ValueError('approved digests schema: schema_version must be {}'.format(SCHEMA_VERSION))
   156	    _shape(value['code'], CODE_KEYS, 'code')
   157	    _shape(value['reused'], REUSED_KEYS, 'reused')
   158	    _shape(value['artifacts'], ARTIFACT_KEYS, 'artifacts')
   159	    for name, keys in NESTED.items():
   160	        section, key = name.split('.')
   161	        _shape(value[section][key], keys, name)
   162	    for key, item in sorted(value['code'].items()):
