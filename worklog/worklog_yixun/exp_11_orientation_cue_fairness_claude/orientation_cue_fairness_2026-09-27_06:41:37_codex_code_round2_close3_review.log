   115	def committed_bytes(path, repo, commit):
   116	    """Finding 2 of full_train review 2: the blob a reviewer committed, or a refusal.
   117	
   118	    Hashing whatever file ``--approved`` names establishes that it did not change during
   119	    the run; it never establishes that anybody reviewed it. Plan section 6.4 fills the
   120	    approvals in a *second reviewed commit*, so a confirmatory run's approvals must be a
   121	    tracked path of this repository whose blob at the reviewed commit is byte-identical
   122	    to the file being read. Untracked, edited or foreign files are refused here.
   123	    """
   124	    root = Path(repo).resolve()
   125	    try:
   126	        relative = Path(path).resolve().relative_to(root).as_posix()
   127	    except ValueError as error:
   128	        raise ValueError('approvals {} lie outside the repository {}'.format(path, root)) from error
   129	    blob = subprocess.run(['git', 'cat-file', '-p', '{}:{}'.format(commit, relative)],
   130	                          cwd=str(root), capture_output=True)
   131	    if blob.returncode != 0:
   132	        raise ValueError('approvals {} are not tracked at {}: {}'.format(
   133	            relative, commit, blob.stderr.decode('utf-8', 'replace').strip()))
   134	    return relative, blob.stdout
