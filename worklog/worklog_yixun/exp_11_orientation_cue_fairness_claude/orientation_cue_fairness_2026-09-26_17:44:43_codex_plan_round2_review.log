     2	from __future__ import annotations
     3	
     4	import math
     5	
     6	import torch
     7	from torch import nn
     8	from einops.layers.torch import Rearrange
     9	
    10	from model.cylindrical_vit import CylindricalViT
    11	
    12	
    13	def azimuth_channels(H, W, dtype=torch.float32):
    14	    """Return column-centred (cos theta, sin theta), broadcast to [2, H, W]."""
    15	    theta = (torch.arange(W, dtype=dtype) + 0.5) * (2.0 * math.pi / W) - math.pi
    16	    return torch.stack((theta.cos(), theta.sin()))[:, None].expand(2, H, W)
    17	
    18	
    19	class CylindricalViTOriented(CylindricalViT):
    20	    """Append heading-frame azimuth after the parent's per-column gauge alignment."""
    21	
    22	    def __init__(self, in_channels=3, image_size=(256, 512), patch_size=(16, 32),
    23	                 dim=512, depth=12, heads=8, dim_head=64, mlp_dim=None):
    24	        super().__init__(in_channels=in_channels, image_size=image_size, patch_size=patch_size,
    25	                         dim=dim, depth=depth, heads=heads, dim_head=dim_head, mlp_dim=mlp_dim)
    26	        p1, p2 = patch_size
    27	        patch_dim = 5 * p1 * p2
    28	        self.to_patch_embedding = nn.Sequential(
    29	            Rearrange('b c (h p1) (w p2) -> b (h w) (p1 p2 c)', p1=p1, p2=p2),
    30	            nn.LayerNorm(patch_dim), nn.Linear(patch_dim, dim), nn.LayerNorm(dim),
    31	        )
    32	        channels = torch.stack((self.cos_theta, self.sin_theta))[:, None]
    33	        self.register_buffer('az_channels', channels.expand(2, *image_size), persistent=False)
    34	
    35	    def forward(self, img):
    36	        """Encode heading-frame xyz [B, 3, H, W] into [B, num_tokens, dim]."""
    37	        cos = self.cos_theta.to(img.dtype)
    38	        sin = self.sin_theta.to(img.dtype)
    39	        x, y, z = img[:, 0], img[:, 1], img[:, 2]
    40	        x_a = x * cos + y * sin
    41	        y_a = -x * sin + y * cos
    42	        aligned = torch.stack([x_a, y_a, z], dim=1)
    43	        azimuth = self.az_channels.to(img.dtype).expand(img.shape[0], -1, -1, -1)
    44	        tokens = self.to_patch_embedding(torch.cat([aligned, azimuth], dim=1))
    45	        tokens = tokens + self.pos_embedding.to(tokens.dtype)
    46	        return self.transformer(tokens, self.rel_index)
