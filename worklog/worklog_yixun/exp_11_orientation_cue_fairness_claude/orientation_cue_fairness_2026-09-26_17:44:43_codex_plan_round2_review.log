    84	def continuous_fit(theta_deg, level):
    85	    """Descriptive 0.5-degree grid least squares: level = a + b*cos(theta-phi), b>=0."""
    86	    theta, level = _paired(theta_deg, level)
    87	    grid = np.arange(-180.0, 180.0, 0.5)
    88	    cosine = np.cos(np.deg2rad(theta[:, None] - grid[None]))
    89	    centered = cosine - cosine.mean(axis=0)
    90	    denom = np.sum(centered ** 2, axis=0)
    91	    slope = np.divide(centered.T @ (level - level.mean()), denom,
    92	                      out=np.zeros_like(denom), where=denom > 1e-12).clip(0)
    93	    intercept = level.mean() - slope * cosine.mean(axis=0)
    94	    mse = np.mean((level[:, None] - intercept - cosine * slope) ** 2, axis=0)
    95	    best = int(np.argmin(mse))
    96	    return dict(phi_deg=float(grid[best]), a=float(intercept[best]),
    97	                b=float(slope[best]), mse=float(mse[best]))
