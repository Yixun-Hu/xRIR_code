    56	        raise ValueError('one positive horizontal distance is required per RIR')
    57	    energy = np.array([early_level(rir, sr, window_s) for rir in rirs])
    58	    if np.any(energy <= 0):
    59	        raise ValueError('heading requires positive early energy')
    60	    return 10 * np.log10(dist ** 2 * energy)
