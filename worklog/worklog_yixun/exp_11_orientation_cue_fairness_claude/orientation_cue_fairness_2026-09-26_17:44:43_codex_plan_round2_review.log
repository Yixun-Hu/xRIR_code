   125	def _closure_digest(files, key):
   126	    """Digest the closure as [[path, hash], ...], as exp_03's closure records do."""
   127	    return hashlib.sha256(json.dumps([[f['path'], f[key]] for f in files],
   128	                                     sort_keys=True).encode()).hexdigest()
