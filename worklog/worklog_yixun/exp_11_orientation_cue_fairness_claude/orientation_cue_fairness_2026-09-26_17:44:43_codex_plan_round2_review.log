    22	_MASK64 = (1 << 64) - 1
    23	_SPLITMIX64_GAMMA = 0x9E3779B97F4A7C15
    24	_SPLITMIX64_MIX1 = 0xBF58476D1CE4E5B9
    25	_SPLITMIX64_MIX2 = 0x94D049BB133111EB
    26	_MASK32 = (1 << 32) - 1
    27	_YAW_AUG_RANK_BITS = 12
    28	_YAW_AUG_MAX_RANK = 1 << _YAW_AUG_RANK_BITS
    29	_YAW_AUG_MAX_STEP = 1 << (32 - _YAW_AUG_RANK_BITS)
    30	_FMIX32_MUL1 = 0x85EBCA6B
    31	_FMIX32_MUL2 = 0xC2B2AE35
    32	
    33	
    34	def splitmix64(x: int) -> int:
    35	    """One SplitMix64 round: avalanche a 64-bit word into a 64-bit word."""
    36	    z = (x + _SPLITMIX64_GAMMA) & _MASK64
    37	    z = ((z ^ (z >> 30)) * _SPLITMIX64_MIX1) & _MASK64
    38	    z = ((z ^ (z >> 27)) * _SPLITMIX64_MIX2) & _MASK64
    39	    return z ^ (z >> 31)
    40	
    41	
