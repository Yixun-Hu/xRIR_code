   224	def estimate_room_heading(room_dir, override_deg=None, override_reason=None):
   225	    """Infer an acoustic axis from exactly the 12 training RIRs, retaining audit evidence.
   226	
   227	    Full input files are streamed only for SHA256 identity. Signal calculations
   228	    select training rows from a read-only mmap. The source digest binds current
   229	    file bytes, including uncommitted code, using provenance's closure discovery.
   230	    """
   231	    if override_deg is None and override_reason is not None:
   232	        raise ValueError('override reason requires an override heading')
   233	    if override_deg is not None:
   234	        heading_roll_k(override_deg)
   235	        if not isinstance(override_reason, str) or not override_reason.strip():
   236	            raise ValueError('override heading requires a nonblank reason')
   237	    room = Path(room_dir)
   238	    meta = json.loads((room / 'meta.json').read_text())
   239	    train = meta['train']
   240	    if (len(train) != 12 or len(set(train)) != 12 or
   241	            any(isinstance(i, bool) or not isinstance(i, int) or i < 0 for i in train)):
   242	        raise ValueError('expected 12 distinct nonnegative training indices')
   243	    train = np.array(train, dtype=np.int64)
   244	    xyz = np.load(room / 'xyzs.npy')[train] - np.load(room / 'speaker_xyz.npy')
   245	    theta = np.rad2deg(np.arctan2(xyz[:, 1], xyz[:, 0]))
   246	    dist = np.linalg.norm(xyz[:, :2], axis=1)
   247	    rirs = np.load(room / 'rirs.npy', mmap_mode='r')[train]
   248	    levels = {name: compensated_levels(rirs, dist, meta['sr'], duration)
   249	              for name, duration in [('5ms', .005), ('50ms', .05)]}
   250	    winner, table, reason = decide_heading(theta, levels)
   251	    loo = _leave_one_out_winners(theta, levels)
   252	    stable = winner is not None and all(value == winner for value in loo)
   253	    accepted = winner is not None and stable
   254	    if winner is not None and not stable:
   255	        reason = 'leave-one-out decision is unstable'
   256	    phi = CANDIDATES[winner] if accepted else None
   257	    decision = 'estimated' if accepted else 'refused'
   258	    if override_deg is not None:
   259	        phi, decision = override_deg, 'override'
   260	    descriptive = {}
   261	    for window, level in levels.items():
   262	        fits = [continuous_fit(np.delete(theta, i), np.delete(level, i))['phi_deg']
   263	                for i in range(len(train))]
   264	        descriptive[window] = dict(continuous_fit=continuous_fit(theta, level),
   265	            loo_phi_deg=fits, loo_range_deg=[min(fits), max(fits)],
   266	            mean_direction_deg=mean_direction(theta, 10 ** ((level - level.max()) / 10)))
   267	    repo = Path(__file__).resolve().parents[1]
   268	    state = git_state(repo)
   269	    records, head_digest = closure_record(source_closure('tools.exp06_heading', repo),
   270	                                          state['HEAD'], repo)
   271	    files = [dict(path=r['path'], sha256=r['working_tree_sha256'],
   272	                  head_blob_sha256=r['reviewed_blob_sha256']) for r in records]
   273	    digest = _closure_digest(files, 'sha256')
   274	    git = {key: state[key] for key in GIT_FIELDS}
   275	    return dict(schema_version=1, room=room.name, phi_deg=phi,
   276	        admissibility=_admissibility(files, git),
   277	        k=heading_roll_k(phi) if phi is not None else None, decision=decision,
   278	        reason=override_reason if decision == 'override' else reason,
   279	        override_deg=override_deg, override_reason=override_reason,
   280	        estimator=dict(winner=winner, table=table, reason=reason,
   281	                       leave_one_out_winners=loo, leave_one_out_stable=stable),
   282	        descriptive=descriptive,
   283	        per_mic=[dict(index=int(idx), theta_deg=float(theta[i]), distance_m=float(dist[i]),
   284	                      levels_db={w: float(level[i]) for w, level in levels.items()})
   285	                 for i, idx in enumerate(train)],
   286	        input_sha256={name: sha256_file(room / name) for name in
   287	                      ['meta.json', 'xyzs.npy', 'speaker_xyz.npy', 'rirs.npy']},
   288	        source_closure=dict(entry_module='tools.exp06_heading', repo=str(repo), files=files,
   289	                            sha256=digest, head_sha256=head_digest, git=git, basis='working_tree'),
   290	        timestamp=datetime.datetime.now(datetime.timezone.utc).isoformat())
