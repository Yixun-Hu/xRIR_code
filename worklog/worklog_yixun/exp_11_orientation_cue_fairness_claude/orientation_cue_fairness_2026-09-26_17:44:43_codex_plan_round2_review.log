   111	def check_admission(args):
   112	    """Finding 1 of the second full_train review: agree with the launcher's wrapper.
   113	
   114	    A confirmatory run always names the approvals it is admitted under. A registered
   115	    smoke or probe is dispatched by ``tools/exp06_smoke.py``, which holds the approvals
   116	    itself and forwards only ``--run-type`` (and ``--exploratory``) to this child; such a
   117	    child is admitted without ``--approved`` only while ``--no-save`` keeps it from
   118	    producing any artefact that could later be mistaken for an arm.
   119	    """
   120	    if args.approved is not None:
   121	        return args
   122	    if args.run_type not in DIAGNOSTIC_RUN_TYPES:
   123	        raise ValueError('a full run must name the approvals it is admitted under (--approved)')
   124	    if not args.no_save:
   125	        raise ValueError('a {} run that writes to its save-dir must name its approvals '
   126	                         '(--approved), or run with --no-save'.format(args.run_type))
   127	    return args
