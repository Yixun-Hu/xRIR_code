   192	class HeadingFrameDataset(HAADataset):
   193	    """Rotate geometry after the pinned dataset's draw; audio and room data stay intact.
   194	
   195	    The parent retains its eager RIR loading behavior. Training-only mmap access
   196	    belongs to the estimator, not to this compatibility wrapper.
   197	    """
   198	
   199	    def __init__(self, rooms, split, root=DEFAULT_ROOT, num_shot=8, max_len=9600,
   200	                 eval_seed=None, depth_variant='default', *, k_by_room):
   201	        rooms = list(rooms)
   202	        if any(room not in k_by_room for room in rooms):
   203	            raise ValueError('a heading roll is required for every room')
   204	        self.k_by_room = dict(k_by_room)
   205	        for room in rooms:
   206	            canonical_heading_deg(self.k_by_room[room], 512)
   207	        super().__init__(rooms, split, root=root, num_shot=num_shot, max_len=max_len,
   208	                         eval_seed=eval_seed, depth_variant=depth_variant)
   209	
   210	    def __getitem__(self, i):
   211	        item = super().__getitem__(i)
   212	        k = self.k_by_room[self.items[i][0]]
   213	        if k == 0:
   214	            return item
   215	        listener, src, depth, target, audio, refs = item
   216	        depth, src, refs = rotate_scene_yaw(depth.unsqueeze(0), src.unsqueeze(0), refs.unsqueeze(0), k)
   217	        return listener, src.squeeze(0), depth.squeeze(0), target, audio, refs.squeeze(0)
   218	
   219	    def side_label(self, room, idx):
   220	        """Original room-frame sign of microphone y relative to the speaker."""
   221	        return int(self.data[room]['src_local'][idx, 1].sign().item())
   222	
