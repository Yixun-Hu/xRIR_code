   812	def void_reasons(rows, treatment, comparator):
   813	    """Section 7's invalidity policy; a void verdict is never replaced by a subset."""
   814	    excess = rows['excluded'][treatment]['queries'] - rows['excluded'][comparator]['queries']
   815	    reasons = []
   816	    if not rows['cohort']:
   817	        reasons.append('no query of the {} test split is finite in every compared '
   818	                       'run'.format(rows['n_test']))
   819	    if excess > VOID_EXCESS_FRACTION * rows['n_test']:
   820	        reasons.append('{} has {} more invalid queries than {}, above the {:.0%} of {} the '
   821	                       'policy allows'.format(treatment, excess, comparator,
   822	                                              VOID_EXCESS_FRACTION, rows['n_test']))
   823	    if rows['cohort'] < VOID_COHORT_FRACTION * rows['n_test']:
   824	        reasons.append('the cohort of {} queries is below {:.0%} of the {} in the test '
   825	                       'split'.format(rows['cohort'], VOID_COHORT_FRACTION, rows['n_test']))
   826	    return reasons
