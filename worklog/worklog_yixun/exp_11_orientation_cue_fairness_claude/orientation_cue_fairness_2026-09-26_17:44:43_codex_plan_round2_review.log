   144	                         else dict(exp06_recipe.expected_param_counts(args.backbone)))
   145	    tier = tier_of(vars(args))
   146	    if tier != exp06_recipe.TIER:
   147	        raise ValueError('exp_06 pretrains at tier {}, not {}'.format(exp06_recipe.TIER, tier))
   148	    args.tier = tier
