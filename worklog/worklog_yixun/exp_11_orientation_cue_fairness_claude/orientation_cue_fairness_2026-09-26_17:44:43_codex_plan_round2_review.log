   150	    args.exp06_registry_sha256 = fields.get('registry_sha256')
   151	    args.exp06_source_closure_sha256 = fields.get('source_closures', {}).get('training', {}).get('sha256')
   152	    args.exp06_git_head = fields.get('git_state', {}).get('HEAD')
   153	    args.exp06_provenance_path = destination
   154	    for flag in ('run_type', 'provenance_out', 'approved', 'reviewed_commit', 'exploratory'):
   155	        if hasattr(args, flag):
