   131	def _admissibility(files, git):
   132	    """Only a clean tree whose closure equals its HEAD blobs can bind a confirmatory run."""
   133	    return ('confirmatory' if not git['dirty_outside_worklog']
   134	            and all(f['head_blob_sha256'] == f['sha256'] for f in files) else 'diagnostic')
   135	
   136	
   137	def candidate_contrasts(theta_deg, levels, candidates=CANDIDATES,
   138	                        half_width_deg=45, min_in=3, min_out=3):
   139	    """Mean inside minus outside each inclusive circular sector; None if undersampled."""
   140	    theta, levels = _paired(theta_deg, levels)
   141	    result = {}
   142	    for name, phi in candidates.items():
   143	        inside = np.abs((theta - phi + 180) % 360 - 180) <= half_width_deg
   144	        result[name] = (float(levels[inside].mean() - levels[~inside].mean())
   145	                        if inside.sum() >= min_in and (~inside).sum() >= min_out else None)
   146	    return result
   147	
   148	
   149	def decide_heading(theta_deg, levels_by_window):
   150	    """Apply both-window agreement, 3 dB contrast, and 3 dB competitor margins.
   151	
   152	    Leave-one-out stability is a separate gate, applied by estimate_room_heading.
   153	    The table retains raw winners even when a decision threshold refuses them.
   154	    """
   155	    if len(levels_by_window) != 2:
   156	        raise ValueError('exactly two energy windows are required')
   157	    table = {}
   158	    for window, levels in levels_by_window.items():
   159	        contrasts = candidate_contrasts(theta_deg, levels)
   160	        ranked = sorted(((v, k) for k, v in contrasts.items() if v is not None), reverse=True)
   161	        table[window] = dict(contrasts_db=contrasts, winner=ranked[0][1] if ranked else None,
   162	                             competitor_count=max(0, len(ranked) - 1),
   163	                             runner_up_margin_db=ranked[0][0] - ranked[1][0] if len(ranked) > 1 else None)
   164	    rows = list(table.values())
   165	    winners = [row['winner'] for row in rows]
   166	    if None in winners:
   167	        return None, table, 'insufficient microphones inside/outside candidate sectors'
   168	    if winners[0] != winners[1]:
   169	        return None, table, 'windows disagree'
   170	    winner = winners[0]
   171	    if any(row['contrasts_db'][winner] < 3 for row in rows):
   172	        return None, table, 'contrast below 3 dB'
   173	    if any(row['runner_up_margin_db'] is not None and row['runner_up_margin_db'] < 3 for row in rows):
   174	        return None, table, 'runner-up margin below 3 dB'
   175	    return winner, table, 'accepted'
   176	
   177	
   178	def _leave_one_out_winners(theta_deg, levels_by_window):
   179	    return [decide_heading(np.delete(theta_deg, i),
   180	            {w: np.delete(level, i) for w, level in levels_by_window.items()})[0]
   181	            for i in range(len(theta_deg))]
   182	
   183	
   184	def leave_one_out_stable(theta_deg, levels_by_window):
   185	    """Require every refit to pass all decision thresholds with the original winner."""
   186	    winner = decide_heading(theta_deg, levels_by_window)[0]
   187	    if winner is None or len(theta_deg) < 2:
   188	        return False
   189	    return all(refit == winner for refit in _leave_one_out_winners(theta_deg, levels_by_window))
   190	
