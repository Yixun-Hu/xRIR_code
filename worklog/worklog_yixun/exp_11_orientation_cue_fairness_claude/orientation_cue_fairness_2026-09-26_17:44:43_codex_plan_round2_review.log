    37	def early_level(rir, sr, window_s):
    38	    """Energy in floor(window_s * sr) samples, from the first >20%-peak onset.
    39	
    40	    Samples beyond the RIR are implicitly zero; a silent RIR has zero energy.
    41	    """
    42	    rir = _vector(rir)
    43	    if not np.isfinite([sr, window_s]).all() or sr <= 0 or window_s <= 0:
    44	        raise ValueError('sample rate and window must be positive and finite')
    45	    n = int(window_s * sr)
    46	    if n < 1:
    47	        raise ValueError('window must contain at least one sample')
    48	    onset = np.flatnonzero(np.abs(rir) > 0.2 * np.max(np.abs(rir)))
    49	    return float(np.sum(rir[onset[0]:onset[0] + n] ** 2)) if onset.size else 0.0
