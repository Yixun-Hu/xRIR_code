   136	def prepare_args(args, model, fields, destination):
   137	    """Record the derived tier/parameter counts and the five exp_06 provenance keys.
   138	
   139	    ``run_type`` and ``provenance_out`` leave the namespace: ``args.json`` then holds
   140	    exactly the trainer's 33 fields plus the ``exp06_*`` class of ``tools.exp06_recipe``.
   141	    Capacities outside the recipe's tier are refused rather than recorded as ``custom``.
   142	    """
