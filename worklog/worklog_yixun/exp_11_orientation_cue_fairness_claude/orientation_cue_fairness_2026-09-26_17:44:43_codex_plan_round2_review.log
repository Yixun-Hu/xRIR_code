    99	def parse_args(argv=None):
   100	    """Parse and apply the trainer's post-conditions on the yaw seed."""
   101	    parser = build_parser()
   102	    args = parser.parse_args(argv)
   103	    args.yaw_aug_seed = args.seed if args.yaw_aug_seed is None else args.yaw_aug_seed
   104	    if args.provenance_out is not None and not args.no_save:
   105	        parser.error("--provenance-out applies to --no-save runs; saving runs write it to --save-dir")
   106	    if args.exploratory and args.run_type == 'full':
   107	        parser.error("--exploratory is a diagnostic mode; a full run must match the approvals")
   108	    return args
