   269	    parent="$(sed -n 's/^.*) [A-Za-z] \([0-9][0-9]*\).*/\1/p' \
   270	              "/proc/$HOLDER_PID/stat" 2>/dev/null || true)"
   271	    [ "$parent" = "$$" ] && { kill -TERM "$HOLDER_PID" 2>/dev/null || true; }
   272	    wait "$HOLDER_PID" 2>/dev/null || true
   273	    HOLDER_PID=""
   274	}
   275	
   276	# --- what the lock protects is a quiet arm -------------------------------------------
   277	# The lock says "one publication at a time"; it does not say "no trainer is running".
   278	# That is this scan's job, and it has to run UNDER the lock: a scan taken before
   279	# acquisition can go stale in the window between, which is exactly how a recovery could
   280	# promote an older attempt while a newer trainer of the same arm kept writing
   281	# (close review 7, blocker 1). `kill -0` asks the kernel whether a pid still exists; it
   282	# is a probe and sends no signal.
   283	UNRESOLVED_GRACE_S="${EXP11_UNRESOLVED_GRACE_S:-120}"
   284	SCAN_REASON=""
   285	NEWLINE=$'\n'   # a real newline: a verdict that is two lines is not a verdict
   286	
   287	# THREE answers, never two (close review 11). The grammar lives in
   288	# tools/exp11_pidrecord.py and nowhere else -- this shell does NOT read pid files, since
   289	# Bash command substitution drops NUL bytes (close review 10, blocker 1). But a reader
   290	# that cannot run -- no interpreter, an unimportable module, a crash -- used to be
   291	# indistinguishable from "this file holds no record": both were exit 1. Read as "no
   292	# record", a broken reader makes every pid file in the arm look dead, and a resolution
   293	# then retires the attempt of a registered, running trainer. So the reader now answers
   294	# `record <pid>` or `norecord` on stdout with exit 0, and everything else is UNKNOWN.
   295	#
   296	# pid_record <file>: 0 and the pid on stdout | 1 no record | 2 the reader failed.
   297	#
   298	# The verdict is checked as RAW BYTES, in a file, before anything of it passes through a
   299	# shell expansion: command substitution deletes trailing newlines and NUL bytes, so
   300	# `norecord\n\n` and `norecord\0\n` -- neither of which is the protocol -- arrived here
   301	# as clean verdicts and retired a live trainer's attempt (close review 12, blocker 2).
   302	# Only the digits of an accepted pid cross back, and digits survive intact.
   303	READER_UNKNOWN=2
   304	pid_record() {
   305	    local out="" pid="" kind="" size="" status=0
   300	# `norecord\n\n` and `norecord\0\n` -- neither of which is the protocol -- arrived here
   301	# as clean verdicts and retired a live trainer's attempt (close review 12, blocker 2).
   302	# Only the digits of an accepted pid cross back, and digits survive intact.
   303	READER_UNKNOWN=2
   304	pid_record() {
   305	    local out="" pid="" kind="" size="" status=0
   306	    # What the path IS, decided before anything opens it: a directory, FIFO, socket or
   307	    # device is definitely not a pid record, and opening a FIFO would wait for a writer
   308	    # forever. A stat that FAILS decides nothing here -- the module tells a confirmed
   309	    # absence from a path it was not allowed to inspect (close review 12, blocker 1),
   310	    # which is why this is no longer `[ -f ]`: that reads an unreadable parent as "gone".
   311	    # `%f` is the mode in hex, not `%F`'s phrase: that phrase is translated, so matching
   312	    # it would classify an ordinary file as "not a record" under any other locale.
   313	    if kind="$(stat -L -c %f -- "$1" 2>/dev/null)"; then
   314	        case "$kind" in ''|*[!0-9a-fA-F]*) return "$READER_UNKNOWN" ;; esac
   315	        if [ $(( 0x$kind & 0xF000 )) -ne $(( 0x8000 )) ]; then
   316	            return 1                          # definite: not a regular file, unopened
   317	        fi
   318	    fi
   319	    out="$(mktemp "${TMPDIR:-/tmp}/exp11_verdict.XXXXXX")" || return "$READER_UNKNOWN"
   320	    "$PYTHON" -m tools.exp11_pidrecord "$1" > "$out" 2>/dev/null || status=$?
   321	    if [ "$status" -ne 0 ]; then rm -f -- "$out"; return "$READER_UNKNOWN"; fi
   322	    # A verdict is eighteen bytes at most ('record ' + ten digits + a newline), so the
   323	    # size answers first and no rogue reader's output is ever read, compared or -- worst
   324	    # of all -- materialised as a shell variable (close review 13, nonblocking).
   325	    size="$(stat -c %s -- "$out" 2>/dev/null)" || { rm -f -- "$out"; return "$READER_UNKNOWN"; }
   326	    case "$size" in ''|*[!0-9]*) rm -f -- "$out"; return "$READER_UNKNOWN" ;; esac
   327	    if [ "$size" -gt 64 ]; then rm -f -- "$out"; return "$READER_UNKNOWN"; fi
   328	    if cmp -s "$out" <(printf 'norecord\n'); then rm -f -- "$out"; return 1; fi
   329	    # Digits only -- a candidate, not yet a verdict: the bytes must then match the whole
   330	    # line exactly, which is what refuses padding, NULs, CR and trailing junk.
   331	    pid="$(head -c 64 -- "$out" | tr -cd '0-9')"
   332	    case "$pid" in ''|*[!0-9]*) rm -f -- "$out"; return "$READER_UNKNOWN" ;; esac
   333	    [ "${#pid}" -le 10 ] || { rm -f -- "$out"; return "$READER_UNKNOWN"; }
   334	    if cmp -s "$out" <(printf 'record %s\n' "$pid"); then
   335	        rm -f -- "$out"
   336	        printf '%s\n' "$pid"
   337	        return 0
   338	    fi
   339	    rm -f -- "$out"
   340	    return "$READER_UNKNOWN"
   341	}
   342	
   343	# pid_alive <file>: 0 the recorded pid is alive | 1 it is not | 2 nobody can say.
   344	pid_alive() {
   345	    local pid="" status=0
   346	    pid="$(pid_record "$1")" || status=$?
   347	    [ "$status" -ne "$READER_UNKNOWN" ] || return "$READER_UNKNOWN"
   348	    [ "$status" -eq 0 ] || return 1
   349	    kill -0 "$pid" 2>/dev/null
   350	}
   351	
   352	# registration_complete <attempt>: child.pid holds one pid, by the grammar above. The
   353	# shell creates that file by redirection before the pid reaches it, so existence alone
   354	# proves nothing; what makes a launch *registered* is a number to look for. Whether that
   355	# number is still alive is a separate question, asked by pid_alive of the same bytes.
   356	# 0 complete | 1 not complete | 2 unknown -- the unknown is never folded into "not".
   357	registration_complete() {
   358	    pid_record "$1/child.pid" >/dev/null
   359	}
   360	
   361	# check_pid_reader: ask the reader two questions whose answers are known, before any
   362	# decision is taken. A reader stuck on one verdict never fails -- "record 1" for
   363	# everything makes every pid file a registration, "norecord" for everything makes every
   364	# trainer dead -- so only a probe catches it. The probes go through the same $PYTHON and
   365	# the same invocation as every real read.
   366	# probe_reader <file> <expected bytes> <where the answer goes>: 0 when the reader exited
   367	# 0 and printed EXACTLY those bytes. Byte for byte, like every real read.
   368	probe_reader() {
   369	    "$PYTHON" -m tools.exp11_pidrecord "$1" > "$3" 2>/dev/null || return 1
   370	    cmp -s "$3" "$2"
   371	}
   372	
   373	check_pid_reader() {
   374	    local dir="" bad=""
   375	    dir="$(mktemp -d "${TMPDIR:-/tmp}/exp11_pidreader.XXXXXX")" || {
   376	        echo "refusing: cannot create a probe directory for the pid reader" >&2
   377	        return 1; }
   378	    printf '1\n' > "$dir/one"
   379	    : > "$dir/empty"
   380	    printf 'record 1\n' > "$dir/want_one"
   381	    printf 'norecord\n' > "$dir/want_empty"
   382	    probe_reader "$dir/one" "$dir/want_one" "$dir/got_one" || bad="a file holding 1"
   383	    probe_reader "$dir/empty" "$dir/want_empty" "$dir/got_empty" ||
   384	        bad="${bad:+$bad and }an empty file"
   385	    rm -rf -- "$dir"
   386	    [ -z "$bad" ] && return 0
   387	    echo "refusing: pid reader unhealthy: $PYTHON -m tools.exp11_pidrecord did not" \
   388	         "answer byte for byte on $bad -- 'record 1' and 'norecord', one line each and" \
   389	         "nothing more, no padding and no NULs. Nothing of this arm can be decided by a" \
   390	         "reader that cannot say what a pid file holds" >&2
   391	    return 1
   392	}
   393	
   394	# probe_live <pid file> <what is alive>: 0 nothing found, 1 alive, 2 unknown. The last
   395	# two set SCAN_REASON and must be propagated unchanged -- an unknown liveness is not a
   396	# quiet arm, it is no answer at all.
   397	probe_live() {
   398	    local status=0
   399	    pid_alive "$1" || status=$?
   400	    case "$status" in
   401	        0) SCAN_REASON="$2"; return 1 ;;
   402	        "$READER_UNKNOWN")
   403	            SCAN_REASON="liveness unknown: pid reader failed on $1. Nothing is scanned,"\
   404	" retired or published on an answer nobody gave"
   405	            return "$READER_UNKNOWN" ;;
   406	    esac
   407	    return 0
   408	}
   409	
   410	# list_attempts <arm root> <listing file>: 0 only when the root really was ENUMERATED,
   411	# the listing then holding its attempt_* entries NUL-separated. A directory with mode
   412	# 0300 is searchable and writable but NOT listable: every known pathname under it still
   413	# works -- both lock files open, `stat` answers, the holder starts -- while a glob over
   414	# it silently expands to nothing. That read as "this arm has no attempts", and a
   415	# resolution retired the attempt of a registered, running trainer (close review 13). A
   416	# successful stat of a name we already knew is never evidence that we saw the directory.
   417	list_attempts() {
   418	    local root="$1" out="$2"
   419	    [ -d "$root" ] || return 1
   420	    [ -r "$root" ] && [ -x "$root" ] || return 1     # listing needs read AND search
   421	    find "$root" -mindepth 1 -maxdepth 1 -name 'attempt_*' -print0 > "$out" 2>/dev/null
   422	}
   423	
   424	# scan_arm <arm root> [<attempt being resolved>]: 0 when every attempt of the arm is
   425	# finished and accounted for, 1 when one is not (SCAN_REASON says which), 2 when the
   426	# reader failed and no answer exists. A broken reader closes the arm to every automated
   427	# decision; it never opens it (close review 11).
   428	scan_arm() {
   429	    local root="$1" resolving="${2:-}" attempt="" name="" here="" listing="" mode=""
   430	    local -a attempts=()
   431	    SCAN_REASON=""
   432	    # The attempt being resolved is excluded by canonical identity, never by spelling:
   433	    # the caller's path and this glob's may name the same directory differently.
   434	    [ -z "$resolving" ] || resolving="$(realpath -- "$resolving" 2>/dev/null || printf '%s' "$resolving")"
   435	    listing="$(mktemp "${TMPDIR:-/tmp}/exp11_attempts.XXXXXX")" || {
   436	        SCAN_REASON="liveness unknown: cannot create a listing file for $root"
   437	        return "$READER_UNKNOWN"; }
   438	    if ! list_attempts "$root" "$listing"; then
   439	        rm -f -- "$listing"
   440	        SCAN_REASON="liveness unknown: the arm root cannot be enumerated ($root); an"\
   441	" attempt nobody can see is not an attempt that is not there, and nothing of this arm is"\
   442	" scanned, retired or published on that"
   443	        return "$READER_UNKNOWN"
   444	    fi
   445	    # -d '' is the NUL delimiter: an attempt name may hold anything but a NUL.
   446	    while IFS= read -r -d '' attempt; do attempts+=("$attempt"); done < "$listing"
   447	    rm -f -- "$listing"
   448	    for attempt in ${attempts[@]+"${attempts[@]}"}; do
   449	        # `-d` answers "no" both for a name that is not a directory and for one nobody
   450	        # was allowed to look at; only a stat that SUCCEEDED classifies (close review 13).
   451	        mode="$(stat -L -c %f -- "$attempt" 2>/dev/null)" || {
   452	            SCAN_REASON="liveness unknown: $attempt is in this arm and cannot be"\
   453	" inspected, so what it holds cannot be known"
   454	            return "$READER_UNKNOWN"; }
   455	        case "$mode" in ''|*[!0-9a-fA-F]*)
   456	            SCAN_REASON="liveness unknown: $attempt has no readable file mode"
   457	            return "$READER_UNKNOWN" ;;
   458	        esac
   459	        [ $(( 0x$mode & 0xF000 )) -eq $(( 0x4000 )) ] || continue   # not a directory
   460	        name="$(basename -- "$attempt")"
   461	        here="$(realpath -- "$attempt" 2>/dev/null || printf '%s' "$attempt")"
   462	        probe_live "$attempt/launch.pid" "$name has a live launcher (launch.pid)" || return $?
   463	        probe_live "$attempt/child.pid" "$name has a live trainer (child.pid)" || return $?
   464	        probe_live "$attempt/train.pid" "$name has a live trainer (train.pid)" || return $?
   465	        [ "$here" != "$resolving" ] || continue
   466	        # `child.pid` is the WRAPPER's (GNU timeout), not the trainer's, so a complete
   467	        # and dead one accounts for nothing: only train.pid names the trainer and only
   468	        # train.exit says it finished (close review 10, blocker 2).
   469	        if [ -f "$attempt/launching" ] &&
   470	           { [ ! -f "$attempt/train.pid" ] || [ ! -f "$attempt/train.exit" ]; }; then
   471	            SCAN_REASON="$name has an unresolved launch: a launching marker and no"\
   472	" finished trainer (train.pid and train.exit), so a trainer of it may be running or may"\
   473	" have died unrecorded -- child.pid names the timeout wrapper, not the trainer."\
   474	" Resolve it"\
   475	" with --resolve-unregistered $attempt once nothing of the arm is alive and the marker"\
   476	" is older than ${UNRESOLVED_GRACE_S}s"
   477	            return 1; fi
   478	    done
   479	    return 0
   480	}
   481	
   482	require_quiet_arm() {  # require_quiet_arm [<attempt being resolved>]
   483	    local status=0
   484	    say "SCAN $ARM_ROOT"
   485	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   486	    check_pid_reader || return "$READER_UNKNOWN"   # before anything is looked at
   487	    scan_arm "$ARM_ROOT" "${1:-}" || status=$?
   488	    [ "$status" -eq 0 ] && return 0
   489	    echo "refusing: $SCAN_REASON" >&2
   490	    return "$status"
   491	}
   492	
   493	# --- the intent marker: the half-second the frozen lifecycle cannot cover -----------
   494	# `run_child` forks the detached trainer and writes child.pid only afterwards, and the
   495	# trainer needs a moment to write its own. A launcher that dies inside that window would
   496	# leave a running trainer nothing names. So the intent to launch is declared BEFORE the
   497	# fork and withdrawn only once the TRAINER is accounted for -- a complete child.pid and a
   498	# train.exit. `child.pid` holds the timeout wrapper's pid, so its death says nothing about
   499	# the trainer (close review 10). A marker left behind means "a trainer of this attempt may
   500	# be running, or died without saying so", and the arm stays closed until an operator
   501	# resolves it: a trainer that crashes before registering fails closed, by design.
   502	mark_launching() {  # mark_launching <attempt>
   503	    printf 'launcher %s\nat %s\narm %s\n' \
   504	        "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$ARM" > "$1/launching"
   505	}
   506	
   507	clear_launching() {  # clear_launching <attempt>: only once the TRAINER is accounted for
   508	    # This runs after run_child returns, so the wrapper and the sink are gone. A complete
   509	    # child.pid proves the wrapper was recorded; train.exit proves the trainer itself
   510	    # finished. A trainer that crashed before registering leaves the marker standing and
   511	    # the attempt unresolved -- fail closed, by design: the operator answers it.
   512	    # `|| return 0` covers BOTH "no complete child.pid" and "the reader could not say":
   513	    # a marker is withdrawn on an answer, never on the absence of one (close review 11).
   514	    # And not at all while the arm it belongs to cannot even be enumerated: the marker is
   515	    # protection, and protection is not withdrawn on an understanding we do not have
   516	    # (close review 13).
   517	    local listing=""
   518	    listing="$(mktemp "${TMPDIR:-/tmp}/exp11_attempts.XXXXXX")" || return 0
   519	    if ! list_attempts "$(dirname -- "$1")" "$listing"; then rm -f -- "$listing"; return 0; fi
   520	    rm -f -- "$listing"
   521	    registration_complete "$1" || return 0
   522	    [ -f "$1/train.exit" ] || return 0
   523	    rm -f -- "$1/launching"
   524	}
   525	
   526	# resolve_unregistered <attempt>: an operator's explicit answer to a marker nothing can
   527	# explain any more. It can only ever abort: an attempt with no child.pid has no exit
   528	# receipt and can never be published.
   529	resolve_unregistered() {
   530	    local attempt="" root="" name="" now=0 stamp=0 age=0
   531	    # This is the one decision that deliberately ignores its own target's marker -- the
   532	    # tombstone is what makes that safe -- so the liveness answers are all that stand
   533	    # between a running trainer and a retired directory. Ask the reader for them only
   534	    # once it has proved it can answer (close review 11).
   535	    check_pid_reader || return "$READER_UNKNOWN"
   536	    # Identity is the canonical directory, never the spelling: an operator's path may be
   537	    # absolute where the root is relative, or reach the arm through a symlink.
   538	    [ -d "$1" ] || { echo "refusing: $1 is not a directory" >&2; return 1; }
   539	    attempt="$(realpath -- "$1")" || return 1
   540	    root="$(realpath -- "$ARM_ROOT")" || return 1
   541	    name="$(basename -- "$attempt")"
   542	    # The lock and the scan are this arm's, so the resolution reaches no further.
   543	    if [ "$(dirname -- "$attempt")" != "$root" ]; then
   544	        echo "refusing: $attempt is not an attempt of the selected arm ($root); this" \
   545	             "invocation locked and scanned that arm and no other" >&2
   546	        return 1
   547	    fi
   548	    case "$name" in
   549	        attempt_*) case "${name#attempt_}" in ''|*[!0-9T]*)
   550	            echo "refusing: $name is not an attempt directory of this arm" >&2
   551	            return 1 ;; esac ;;
   552	        *) echo "refusing: $name is not an attempt directory of this arm" >&2
   553	           return 1 ;;
   554	    esac
   555	    # A directory we cannot look INTO says nothing about what is in it -- least of all
   556	    # that there is no marker and no live pid file. Not being able to look is never an
   557	    # answer (close review 12, blocker 1).
   558	    if ! stat -L -c %f -- "$attempt/." >/dev/null 2>&1; then
   559	        echo "refusing: liveness unknown: $attempt cannot be inspected, so neither its" \
   560	             "launching marker nor its pid files nor its receipts can be read; nothing" \
   561	             "of this arm is retired on that" >&2
   562	        return "$READER_UNKNOWN"
   563	    fi
   564	    [ -f "$attempt/launching" ] || {
   565	        echo "refusing: $attempt has no launching marker; nothing is unresolved" >&2
   566	        return 1; }
   567	    # NOT "child.pid is complete": that file holds the `timeout` wrapper's pid, and a
   568	    # wrapper that died with its trainer unregistered is precisely the state the scan
   569	    # now calls unresolved (close review 10, blocker 2). Refusing on it would leave the
   570	    # arm shut for good -- closed by the scan, unanswerable by the operator. What may
   571	    # never be retired this way is a run that actually finished: a completion receipt,
   572	    # or the published `final`. Everything else is decided by the quiet scan below --
   573	    # nothing of the arm alive -- and by the marker's age.
   574	    if [ -f "$attempt/completion.json" ]; then
   575	        echo "refusing: $attempt has a completion receipt; it is a finished run, not an" \
   576	             "unresolved launch" >&2
   577	        return 1
   578	    fi
   579	    if [ "$(published_target || true)" = "$attempt" ]; then
   580	        echo "refusing: $attempt is published as $ARM_ROOT/final; a published attempt is" \
   581	             "never retired as an unresolved launch" >&2
   582	        return 1
   583	    fi
   584	    # The REGISTRATION lock, distinct from the publication lock this invocation already
   585	    # holds: a full-mode launcher holds the publication lock for its child's whole run,
   586	    # so a trainer could never take that one. This one is held only across a
   587	    # registration and across this resolution -- exactly the pair that must not
   588	    # interleave, because the trainer's checks and its write straddle the rename below
   589	    # (close review 9, blocker 2). The recovery and full-mode scans do not take it: an
   590	    # in-flight registration is already covered there by the launching marker or by a
   591	    # complete live child.pid, and a recovery that had to queue behind every trainer
   592	    # would be a new way to stall an arm.
   593	    local registration="$root/.registration.lock" reg_fd=""
   594	    : >> "$registration" 2>/dev/null || true
   595	    exec {reg_fd}>>"$registration" || {
   596	        echo "refusing: cannot open the registration lock $registration" >&2; return 1; }
   597	    if ! flock -n "$reg_fd"; then
   598	        exec {reg_fd}>&-
   599	        echo "refusing: a registration in progress holds $registration; a trainer is" \
   600	             "between its checks and its write, so nothing of this arm may be retired" >&2
   601	        return 1
   602	    fi
   603	    local scanned=0
   604	    scan_arm "$ARM_ROOT" "$attempt" || scanned=$?
   605	    if [ "$scanned" -ne 0 ]; then
   606	        exec {reg_fd}>&-
   607	        echo "refusing: $SCAN_REASON" >&2
   608	        return "$scanned"          # 2 = the reader failed: this resolution decides nothing
   609	    fi
   610	    now="$(date -u +%s)"
   611	    stamp="$(date -u -r "$attempt/launching" +%s 2>/dev/null || printf '%s' "$now")"
   612	    age=$((now - stamp))
   613	    if [ "$age" -lt "$UNRESOLVED_GRACE_S" ]; then
   614	        exec {reg_fd}>&-
   615	        echo "refusing: $attempt/launching is ${age}s old and a trainer that has not" \
   616	             "registered yet is still possible; wait until it is ${UNRESOLVED_GRACE_S}s" >&2
   617	        return 1
   618	    fi
   619	    say "TOMBSTONE $root/$name.resolved"
   620	    say "ABORT $attempt -> ${attempt}_ABORTED_unregistered"
   621	    if [ "$DRY" -eq 0 ]; then
   622	        # Written BEFORE the rename, and never removed by anything here: a trainer that
   623	        # wakes after this can no longer find its directory, and if it somehow can, this
   624	        # is what tells it the launch was answered. The scan ignores it -- it is a
   625	        # record, not a claim (close review 8, blocker 2).
   626	        # Exactly the conditions this resolution checked -- nothing else is asserted.
   627	        # `train.exit` is NOT among them: a stale marker beside a finished trainer is
   628	        # resolvable too (close review 12, wording).
   629	        printf 'resolved-by %s\nat %s\nreason %s\n' "$$" \
   630	            "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" \
   631	            "unresolved launch, retired under this arm's publication and registration locks: a launching marker older than ${UNRESOLVED_GRACE_S}s, no recorded pid of this arm alive, no completion receipt, and not the published final. A trainer that never registered cannot be seen at all; this tombstone is what refuses it." \
   632	            > "$root/$name.resolved"
   633	        mv -- "$attempt" "${attempt}_ABORTED_unregistered"
   634	        # The marker has been answered; leaving it would close the arm for good, since
   635	        # the scan reads every attempt_* directory, retired ones included.
   636	        rm -f -- "${attempt}_ABORTED_unregistered/launching"
   637	    fi
   638	    exec {reg_fd}>&-   # the whole critical section is done: scan, tombstone, rename
   639	    # Precisely what was established, and only that: both locks were held, no recorded
   640	    # pid of the arm answered a liveness probe, the attempt has no completion receipt and
   641	    # is not the published `final`, and its marker was older than the grace. A trainer
   642	    # that never registered cannot be seen at all -- which is why the tombstone above is
   643	    # written first and never removed (close review 11 and 12, wording).
   644	    say "RESOLVED $attempt: marker older than ${UNRESOLVED_GRACE_S}s, no recorded pid of" \
   645	        "this arm alive, no completion receipt, not the published final. It can never be" \
   646	        "published, and the tombstone refuses any trainer of it that is still to come"
   647	}
   648	
   649	# A deterministic pause, so a regression can hold this invocation open between two
   650	# launchers. It exists only inside the test roots and costs a real launch nothing.
   651	scan_barrier() {
   652	    local file="${EXP11_SCAN_BARRIER:-}"
   653	    [ -n "$file" ] && [ "${EXP11_TEST_ROOTS:-0}" = 1 ] || return 0
   654	    : > "$file.at"
   655	    while [ -e "$file" ]; do sleep 0.05; done
   656	}
   657	
   658	# A signal handler must END this invocation. A cleanup-only handler returns, and bash
   659	# resumes -- which would let finalization and promotion continue after the interruption.
   660	# The lock needs no releasing here: the EXIT trap ends the holder, and if anything went
   661	# wrong with that the lease ends it within a second anyway.
