   228	# commit, a tree clean outside worklog/, no live launch.pid or child.pid under either
   229	# attempt root or the smoke tree, exp_11's approvals, and -- for probe and full -- a card
   230	# with no compute apps at all.
     1	"""Is this path there? One errno-aware answer, for the shell and for the trainer.
     2	
     3	`test -e` and `stat` in bash carry no errno. ENAMETOOLONG, EIO, an ACL that hides a name
     4	and a plain "no such file" all come back the same way, and the launcher read that as a
     5	confirmed **absence** whenever the parent directory looked fine (close review 15). An
     6	absent marker leaves an arm quiet, an absent receipt retires a finished run, an absent
     7	`final` is replaced. So the classification lives here, in the one language where the
     8	errno is available, and the shell asks this module the way it asks the pid reader.
     9	
    10	**The CLI answers, or it does not answer at all.** One line on stdout, exit 0, and
    11	**no path ever crosses** (plan §11 amendment A2):
    12	
    13	    probe <path>          present <mode-hex>   it is there, and this is its mode
    14	                          absent               it is NOT there
    15	    link <path>           link                 the name is there and is a symlink
    16	                          notlink              the name is there and is not one
    17	                          nolink               there is no such name
    18	    same <a> <b>          same | different     device and inode of the FOLLOWED stats
    19	    sameparent <p> <d>    same | different     the same, for p's parent as written
    20	
    21	Three close reviews in a row found holes in the grammar of a path field -- relative
    22	paths, spaces, byte counts against character counts, a terminal `..`, a trailing slash.
    23	A protocol that carries no paths has no such grammar, and the questions that needed one
    24	-- "is this the attempt `final` publishes?", "is this attempt in this arm?" -- are
    25	answered here, where two `os.stat`s and `os.path.samestat` settle them exactly.
    26	
    27	Anything else -- a non-zero exit, no line, another first word, a misuse (exit 2) -- is
    28	**unknown**: the caller must refuse to decide rather than read it as an absence.
    29	
    30	The shell defends against a MALFORMED answer, not against a lying module: the module is
    31	part of the `launch_sh` approvals key, pinned with the launcher it serves, and
    32	health-checked before every scan and every resolution. What crosses the boundary is a
    33	keyword from a fixed set and, for `present`, a validated mode.
    34	
    35	An absence is the strongest claim here, so it is the most guarded: it needs
    36	``FileNotFoundError`` from ``os.stat`` **and** from ``os.lstat`` (a name that lstats but
    37	does not stat is a dangling or looping symlink -- the name IS there), and a parent
    38	directory that could itself be stat'ed and can be searched. Every other errno is
    39	unknown.
    40	"""
    41	import errno
    42	import os
    43	from pathlib import Path
    44	import stat
    45	import sys
    46	
    47	PRESENT, ABSENT, UNKNOWN = 'present', 'absent', 'unknown'
    48	LINK, NOTLINK, NOLINK = 'link', 'notlink', 'nolink'
    49	SAME, DIFFERENT = 'same', 'different'
    50	USAGE_EXIT = 2          # a misuse is not a verdict about any path
    51	UNKNOWN_EXIT = 2
    52	
    53	
    54	def _why(error):
    55	    name = errno.errorcode.get(getattr(error, 'errno', None), 'OSError')
    56	    return '{}: {}'.format(name, error)
    57	
    58	
    59	# --- what a verdict field may look like (close review 16) ---------------------------
    60	# Every field is validated before it is printed AND after it is read, so a probe that
    61	# answers `link garbage` or `present 41ed relative` grants nothing: `garbage` as the
    62	# published target let a resolution retire the attempt that `final` really pointed at.
    63	PATH_MAX = 4096
    64	FILE_TYPES = (0o010000, 0o020000, 0o040000, 0o060000, 0o100000, 0o120000, 0o140000)
    65	
    66	
    67	def valid_mode(text):
    68	    """A file mode in hex, three to six digits, whose type bits name a known type."""
    69	    if not isinstance(text, str) or not 3 <= len(text) <= 6:
    70	        return False
    71	    if any(character not in '0123456789abcdef' for character in text):
    72	        return False
    73	    return (int(text, 16) & 0o170000) in FILE_TYPES
    74	
    75	
    76	def _absolute(name):
    77	    """Make a path absolute WITHOUT normalizing it: `..` is the kernel's business.
    78	
    79	    ``abspath`` collapses `missing/../leaf` to `leaf`, and the parent check then
    80	    inspects a directory the lookup never reached (close review 16).
    81	    """
    82	    return name if name.startswith('/') else os.path.join(os.getcwd(), name)
    83	
    84	
    85	def _parent_is_inspectable(name):
    86	    """An absence may only be claimed about a directory we could look into."""
    87	    parent = os.path.dirname(_absolute(name)) or '/'
    88	    try:
    89	        info = os.stat(parent)
    90	    except OSError as error:
    91	        return False, 'cannot inspect the directory {}: {}'.format(parent, _why(error))
    92	    if not stat.S_ISDIR(info.st_mode):
    93	        return False, '{} is not a directory'.format(parent)
    94	    if not os.access(parent, os.X_OK):
    95	        return False, '{} cannot be searched'.format(parent)
    96	    return True, None
    97	
    98	
    99	def probe(path):
   100	    """``(PRESENT, stat_result)`` | ``(ABSENT, None)`` | ``(UNKNOWN, reason)``."""
   101	    name = str(path)
   102	    # A trailing slash demands that the last component be a directory. ENOTDIR and
   103	    # ENOENT are different news, and only a successful stat of a directory settles it.
   104	    trailing_slash = name.endswith('/') and name != '/'
   105	    try:
   106	        return PRESENT, os.stat(name)
   107	    except FileNotFoundError:
   108	        pass
   109	    except OSError as error:               # EACCES, ELOOP, EIO, ENAMETOOLONG, ENOTDIR...
   110	        return UNKNOWN, 'cannot inspect {}: {}'.format(name, _why(error))
   111	    try:
   112	        os.lstat(name)                     # the name itself, unfollowed
   113	        return UNKNOWN, ('{} is a symlink whose target cannot be resolved; the name is '
   114	                         'there'.format(name))
   115	    except FileNotFoundError:
   116	        pass
   117	    except OSError as error:
   118	        return UNKNOWN, 'cannot inspect {}: {}'.format(name, _why(error))
   119	    if trailing_slash:
   120	        return UNKNOWN, ('{} ends in a slash, so its last component must be a directory; '
   121	                         'what failed here cannot be told apart'.format(name))
   122	    inspectable, why = _parent_is_inspectable(name)
   123	    return (ABSENT, None) if inspectable else (UNKNOWN, why)
   124	
   125	
   126	def probe_link(path):
   127	    """``(LINK, target)`` | ``(NOTLINK, None)`` | ``(NOLINK, None)`` | ``(UNKNOWN, why)``."""
   128	    name = str(path)
   129	    if name.endswith('/') and name != '/':
   130	        return UNKNOWN, ('{} ends in a slash, so it names a directory, not the link '
   131	                         'itself'.format(name))
   132	    try:
   133	        info = os.lstat(name)
   134	    except FileNotFoundError:
   135	        inspectable, why = _parent_is_inspectable(name)
   136	        return (NOLINK, None) if inspectable else (UNKNOWN, why)
   137	    except OSError as error:
   138	        return UNKNOWN, 'cannot inspect {}: {}'.format(name, _why(error))
   139	    if not stat.S_ISLNK(info.st_mode):
   140	        return NOTLINK, None
   141	    try:
   142	        os.stat(name)                      # it must resolve to something we can see
   143	    except OSError as error:
   144	        return UNKNOWN, 'cannot resolve {}: {}'.format(name, _why(error))
   145	    return LINK, None
   146	
   147	
   148	def same(first, second):
   149	    """Are these two names the same file? Device and inode of the FOLLOWED stats.
   150	
   151	    A dangling link, a name that is not there, a parent nobody may enter: none of them
   152	    make two paths *different*, they make the question unanswerable.
   153	    """
   154	    try:
   155	        first_info = os.stat(str(first))
   156	    except OSError as error:
   157	        return UNKNOWN, 'cannot inspect {}: {}'.format(first, _why(error))
   158	    try:
   159	        second_info = os.stat(str(second))
   160	    except OSError as error:
   161	        return UNKNOWN, 'cannot inspect {}: {}'.format(second, _why(error))
   162	    return (SAME if os.path.samestat(first_info, second_info) else DIFFERENT), None
   163	
   164	
   165	def same_parent(path, directory):
   166	    """Is ``path``'s parent -- the dirname of the name AS WRITTEN -- that directory?"""
   167	    return same(os.path.dirname(_absolute(str(path))) or '/', directory)
   168	
   169	
   170	def file_state(path):
   171	    """PRESENT only for a regular file; ABSENT for no such name or another kind."""
   172	    state, detail = probe(path)
   173	    if state == PRESENT and not stat.S_ISREG(detail.st_mode):
   174	        return ABSENT, detail
   175	    return state, detail
   176	
   177	
   178	def directory_state(path):
   179	    state, detail = probe(path)
   180	    if state == PRESENT and not stat.S_ISDIR(detail.st_mode):
   181	        return ABSENT, detail
   182	    return state, detail
   183	
   184	
   185	def main(argv):
   186	    questions = {'probe': 1, 'link': 1, 'same': 2, 'sameparent': 2}
   187	    if len(argv) < 2 or argv[1] not in questions or len(argv) != questions[argv[1]] + 2:
   188	        print('usage: python -m tools.exp11_pathprobe <probe|link> <path>\n'
   189	              '       python -m tools.exp11_pathprobe <same|sameparent> <path> <path>',
   190	              file=sys.stderr)
   191	        return USAGE_EXIT
   192	    question = argv[1]
   193	    if question == 'probe':
   194	        state, detail = probe(argv[2])
   195	    elif question == 'link':
   196	        state, detail = probe_link(argv[2])
   197	    elif question == 'same':
   198	        state, detail = same(argv[2], argv[3])
   199	    else:
   200	        state, detail = same_parent(argv[2], argv[3])
   201	    if state == UNKNOWN:
   202	        print('cannot decide {}: {}'.format(' '.join(argv[2:]), detail), file=sys.stderr)
   203	        return UNKNOWN_EXIT
   204	    if state != PRESENT:
   205	        print(state)
   206	        return 0
   207	    mode = '{:x}'.format(detail.st_mode)
   208	    if not valid_mode(mode):                  # a mode nobody could act on is no verdict
   209	        print('refusing to answer about {}: {} is not a file mode'.format(argv[2], mode),
   210	              file=sys.stderr)
   211	        return UNKNOWN_EXIT
   212	    print('present {}'.format(mode))
   213	    return 0
   214	
   215	
   216	if __name__ == '__main__':
   217	    sys.exit(main(sys.argv))
