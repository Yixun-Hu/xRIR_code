   223	REGISTRATION_LOCK = '.registration.lock'
   224	REGISTRATION_WAIT_S = 60
   225	
   226	
   227	def registration_lock_path(save_dir):
   228	    """The arm root's registration lock -- one per arm, beside its attempts."""
   229	    return Path(save_dir).parent / REGISTRATION_LOCK
   230	
   231	
   232	@contextlib.contextmanager
   233	def registration_lock(save_dir, wait_seconds=REGISTRATION_WAIT_S):
   234	    """Hold the arm's REGISTRATION lock, or give up after ``wait_seconds``.
   235	
   236	    This is not the publication lock: a full-mode launcher holds that one for its
   237	    child's whole run, so a trainer could never take it. This one is held only across a
   238	    registration and across a resolution, which is exactly the pair that must not
   239	    interleave (close review 9, blocker 2). The wait is blocking but bounded, because a
   240	    resolution is short and a trainer that waits forever is a trainer nothing can end.
   241	    """
   242	    path = registration_lock_path(save_dir)
   243	    try:
   244	        handle = open(str(path), 'a')
   245	    except OSError as error:
   246	        refuse('cannot open the registration lock {}: {}'.format(path, error))
   247	    try:
   248	        # A duration belongs on the clock that only goes forward: NTP corrections and
   249	        # a resuming VM step time.time() in either direction, which would shorten this
   250	        # bound to nothing or stretch it past any trainer's patience.
   251	        deadline = time.monotonic() + wait_seconds
   252	        while True:
   253	            try:
   254	                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
   255	                break
   256	            except OSError:
   257	                if time.monotonic() >= deadline:
   258	                    refuse('the registration lock {} was held for more than {}s; '
   259	                           'another registration or a resolution is in progress'
   260	                           .format(path, wait_seconds))
   261	                time.sleep(0.05)
   262	        yield
   263	    finally:
   264	        handle.close()          # closing the descriptor releases the lock
   265	
   266	
   267	def refuse(reason):
   268	    print('refusing: ' + reason, file=sys.stderr, flush=True)
   269	    raise SystemExit(RESOLVED_EXIT)
