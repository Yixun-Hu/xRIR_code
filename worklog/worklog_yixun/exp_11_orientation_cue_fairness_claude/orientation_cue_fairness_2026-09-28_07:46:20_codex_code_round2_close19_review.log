   384	def exit_code(exit_request):
   385	    """``raise SystemExit`` carries None, which is status 0, not 1."""
   386	    code = exit_request.code
   387	    if code is None:
   388	        return 0
   389	    return code if isinstance(code, int) else 1
   390	
   391	
   392	def record_trainer_exit(path, code):
   393	    """Say how this trainer left, on every path it controls."""
   394	    if path is None:
   395	        return
   396	    try:
   397	        with open(str(path.parent / 'train.exit'), 'a') as stream:
   398	            stream.write('train.exit {}\n'.format(code))
   399	    except OSError:                       # a vanished run directory is not the trainer's
   400	        pass                              # problem to report; the scan reads the pid file
   401	
