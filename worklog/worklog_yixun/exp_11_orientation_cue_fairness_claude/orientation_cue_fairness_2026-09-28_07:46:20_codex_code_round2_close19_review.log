   210	def demand_known(state, detail, path, what):
   211	    """Refuse rather than act on a path this process could not inspect."""
   212	    if state == UNSURE:
   213	        refuse('cannot inspect {} ({}: {}); this trainer does not register on a launch '
   214	               'it cannot verify'.format(path, what, detail))
   215	    return state == PRESENT
