   403	def main(argv=None):
   404	    """Register, run, and record how it ended -- whatever ends it."""
   405	    args = parse_args(argv)
   406	    registration = register_trainer(args.save_dir, no_save=args.no_save)
   407	    code = 0
   408	    try:
   409	        run(list(sys.argv[1:] if argv is None else argv), check_admission(args))
   410	    except SystemExit as exit_request:
   411	        code = exit_code(exit_request)
   412	        raise
   413	    except BaseException:
   414	        code = 'exception'
   415	        raise
   416	    finally:
   417	        record_trainer_exit(registration, code)
