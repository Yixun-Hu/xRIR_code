   271	
   272	def register_trainer(save_dir, no_save=False, arm_root=None,
   273	                     wait_seconds=REGISTRATION_WAIT_S):
   274	    """Name this process in its own run directory, after parsing and before admission.
   275	
   276	    The launcher's ``child.pid`` is written by the frozen lifecycle only *after* it has
   277	    forked this process, so a launcher that dies in between leaves a trainer nothing in
   278	    the arm can see (close review 7, blocker 2). This file is the trainer's own answer.
   279	
   280	    It is also where this trainer finds out whether its launch is still a launch. A
   281	    delayed trainer can wake long after an operator resolved the attempt as unregistered
   282	    -- the marker's age proved nothing about it -- so the answer has to be in the state
   283	    of the directory, and this process **fails closed** (close review 8, blocker 2):
   284	
   285	    * the save-dir is gone: the launcher creates it, the trainer never does, so its
   286	      absence means the launch it belongs to is over;
   287	    * a ``<attempt>.resolved`` tombstone stands beside it: that launch was answered and
   288	      retired, permanently;
   289	    * neither ``launching`` nor a complete ``child.pid`` is there: from the fork onward
   290	      an ordinary launch always carries one of them.
   291	
   292	    All of that, and the write itself, happen under the arm's REGISTRATION lock, so a
   293	    resolution cannot rename the directory between the checks and the write (close
   294	    review 9, blocker 2); the write is a temp file and one ``os.replace``, so no reader
   295	    ever sees half a pid.
   296	
   297	    ``--no-save`` runs are diagnostics that no scan reads; they write no sidecars, take
   298	    no lock, and only the tombstone can refuse them.
   299	    """
   300	    # The ATTEMPT is canonicalised first, and its arm is its canonical parent: the
   301	    # validated directory, the registration lock and the tombstone must all be of ONE
   302	    # arm. Reached through `arm_alias/attempt_X -> arm_canonical/attempt_X`, the alias's
   303	    # parent had no tombstone and its own lock, while every write landed in the
   304	    # canonical attempt -- whose tombstone said it had been retired (close review 15,
   305	    # blocker 3).
   306	    given = Path(save_dir)
   307	    # Absolute, but NOT normalised: what exists is the kernel's question (close reviews
   308	    # 16-17). `realpath` then resolves what it can and leaves the rest, so a --no-save
   309	    # diagnostic -- which has no run directory at all -- is still answered. In process,
   310	    # with the filesystem's own meaning of `..` and of every symlink on the way; never a
   311	    # string handed over by a subprocess, and never a grammar to validate (plan §11 A2).
   312	    given_abs = os.path.join(os.getcwd(), str(given))
   313	    directory = Path(os.path.realpath(given_abs))
   314	    arm = directory.parent
   315	    tombstone = arm / (directory.name + '.resolved')
   316	    if no_save:                       # a diagnostic no scan reads: only a tombstone speaks
   317	        if demand_known(*file_state(tombstone), path=tombstone, what='the tombstone'):
   318	            refuse('{} was resolved as an unregistered launch and retired; this trainer '
   319	                   'has nothing to run in'.format(directory))
   320	        return None
   321	    if not demand_known(*directory_state(given), path=given, what='the run directory'):
   322	        refuse('{} does not exist; the launcher creates the attempt and this trainer '
   323	               'never does'.format(given))
   324	    # The arm this path NAMES -- the parent of the spelling, with `..` collapsed -- must
   325	    # be the arm the attempt IS IN. Collapsing is safe here and only here: it feeds an
   326	    # identity comparison, which can never accept a wrong arm, and it is what lets
   327	    # `arm/attempt_X/sub/..`, `//`, `/./` and a trailing slash register through the
   328	    # default call while an attempt symlinked into another arm still refuses (close
   329	    # review 18). Existence is never decided from it.
   330	    lexical_parent = os.path.dirname(os.path.normpath(given_abs))
   331	    contained, why = exp11_pathprobe.same(lexical_parent, arm)
   332	    if contained == exp11_pathprobe.UNKNOWN:
   333	        refuse('cannot establish whether {} is an attempt of {} ({})'
   334	               .format(given, lexical_parent, why))
   335	    if contained != exp11_pathprobe.SAME:
   336	        refuse('{} is an attempt of {}, not of the {} it is written as; the directory, '
   337	               'the lock and the tombstone must be of one arm'
   338	               .format(given, arm, lexical_parent))
   339	    if arm_root is not None:                  # a caller that names the arm must name THIS one
   340	        root = Path(arm_root)
   341	        if not demand_known(*directory_state(root), path=root, what='the arm root'):
   342	            refuse('{} does not exist; this trainer registers only in the arm whose lock '
   343	                   'it holds'.format(root))
   344	        configured, why = exp11_pathprobe.same(root, arm)
   345	        if configured == exp11_pathprobe.UNKNOWN:
   346	            refuse('cannot establish whether {} is an attempt of {} ({})'
   347	                   .format(given, root, why))
   348	        if configured != exp11_pathprobe.SAME:
   349	            refuse('{} is an attempt of {}, not of the {} this trainer was given; the '
   350	                   'directory, the lock and the tombstone must be of one arm'
   351	                   .format(given, arm, root))
   352	    with registration_lock(directory, wait_seconds):
   353	        # Everything below happens under the lock, so a resolution cannot rename this
   354	        # directory between the checks and the write. The checks are re-made here: the
   355	        # directory may have been retired between the canonicalisation and the lock.
   356	        if not demand_known(*directory_state(directory), path=directory,
   357	                            what='the run directory'):
   358	            refuse('{} does not exist; the launcher creates the attempt and this trainer '
   359	                   'never does'.format(directory))
   360	        if demand_known(*file_state(tombstone), path=tombstone, what='the tombstone'):
   361	            refuse('{} was resolved as an unregistered launch and retired; this trainer '
   362	                   'has nothing to run in'.format(directory))
   363	        marker = demand_known(*file_state(directory / 'launching'),
   364	                              path=directory / 'launching', what='the launching marker')
   365	        if not marker:
   366	            # The other half of a launch record. Its reader has the same three states,
   367	            # and "I could not read child.pid" is not "there is no launch here".
   368	            verdict, detail = exp11_pidrecord.inspect_record(directory / 'child.pid')
   369	            if verdict == exp11_pidrecord.UNKNOWN:
   370	                refuse('cannot inspect {}/child.pid ({}); this trainer does not register '
   371	                       'on a launch it cannot verify'.format(directory, detail))
   372	            if verdict != exp11_pidrecord.RECORD:
   373	                refuse('{} carries no launch record -- no launching marker and no '
   374	                       'complete child.pid -- so no launch of it is in progress'
   375	                       .format(directory))
   376	        path = directory / 'train.pid'
   377	        # Atomic: a reader sees the old file or the whole new one, never a partial pid.
   378	        temporary = directory / ('train.pid.{}.tmp'.format(os.getpid()))
   379	        temporary.write_text('{}\n'.format(os.getpid()))
   380	        os.replace(str(temporary), str(path))
   381	    return path
