    47	# running with an overflowing value handed to GNU timeout. Six digits is the whole
    48	# contract (129600 has six), so the numeric comparison below can never be out of range;
    49	# leading zeros are refused with everything else that is not a plain decimal.
    50	check_ceiling() {
    51	    local why="must be a plain decimal of at most 6 digits in (0, $FULL_CEILING_MAX]"
    52	    case "$FULL_CEILING_S" in
    53	        ''|*[!0-9]*|0*|???????*)
    54	            echo "refusing: EXP11_FULL_CEILING_S '$FULL_CEILING_S' $why" >&2; return 1 ;;
    55	    esac
    56	    if [ "$FULL_CEILING_S" -le 0 ] || [ "$FULL_CEILING_S" -gt "$FULL_CEILING_MAX" ]; then
    57	        echo "refusing: EXP11_FULL_CEILING_S $FULL_CEILING_S $why;" \
    58	             "an override may only tighten the 36 h ceiling" >&2
    59	        return 1
    60	    fi
    61	}
    62	
    63	# apply_root_override: EXP11_PRETRAIN_ROOT is a dry-run test affordance and nothing else.
    64	apply_root_override() {
    65	    [ -n "${EXP11_PRETRAIN_ROOT:-}" ] || return 0
    66	    if [ "${EXP11_TEST_ROOTS:-0}" != 1 ] || [ "$DRY" -ne 1 ]; then
    67	        echo "refusing: EXP11_PRETRAIN_ROOT moves the attempt roots and the roots" \
    68	             "preflight scans, so it is honoured only with EXP11_TEST_ROOTS=1 and" \
    69	             "--dry-run" >&2
    70	        return 1
    71	    fi
    72	    PRETRAIN_ROOT="$EXP11_PRETRAIN_ROOT"
    73	    SIMPOR_ROOT="$PRETRAIN_ROOT/xRIR_simpor_8_shot"
    74	    SIMPOR_YAW_ROOT="$PRETRAIN_ROOT/xRIR_simpor_yawaug_8_shot"
    75	}
    76	
    77	# check_attempt <attempt> <root> <arm>: recovery may promote only this arm's own attempt.
    78	# The basename is linked under the root --arm selects, so an attempt of the other arm
    79	# would leave a dangling or wrong `final`; the directory AND the profile its recorded
    80	# arguments select must both be the selected arm's.
    81	CHECK_ATTEMPT_PY='
    82	import json, sys
    83	from pathlib import Path
    84	from tools import exp11_recipe
    85	attempt, root, arm = sys.argv[1:4]
    86	expected = {"H": "H_RECIPE", "I": "I_RECIPE"}[arm]
    87	try:
    88	    # The path that is VALIDATED must be the path that is finalized and promoted, or an
    89	    # alias (an existing `final`, or a link from outside) would be validated here and
    90	    # promoted by its own basename - a self-referencing or dangling link under the root.
    91	    directory, base = Path(attempt).resolve(), Path(root).resolve()
    92	    if directory.parent != base:
    93	        raise ValueError("attempt {} is not an attempt of the arm {} root {}".format(
    94	            directory, arm, base))
    95	    if not directory.name.startswith("attempt_"):
    96	        raise ValueError("{} is not an attempt_<UTC> directory".format(directory))
    97	    args = json.loads((directory / "args.json").read_text())
    98	    profile = exp11_recipe.select_profile(args)
    99	    if profile != expected:
   100	        raise ValueError("attempt {} recorded the profile {}, not the {} of arm {}".format(
   101	            directory, profile, expected, arm))
   102	except (OSError, ValueError, KeyError) as error:
   103	    raise SystemExit("refusing: " + str(error))
   104	print("ATTEMPT ok {} arm={} profile={}".format(attempt, arm, expected))
   105	print("ATTEMPT canonical {}".format(directory))
   106	'
   107	
   108	# check_attempt <attempt>: sets CANONICAL_ATTEMPT to the resolved directory, which is
   109	# what finalization and promotion then use.
   110	check_attempt() {
   111	    local output
   112	    say "ATTEMPTCHECK $1 arm=$ARM root=$ARM_ROOT"
   113	    output="$(CUDA_VISIBLE_DEVICES="" "$PYTHON" -c "$CHECK_ATTEMPT_PY" "$1" "$ARM_ROOT" \
   114	              "$ARM")" || return 1
   115	    printf '%s\n' "$output"
   116	    CANONICAL_ATTEMPT="${output##*ATTEMPT canonical }"
   117	    case "$CANONICAL_ATTEMPT" in
   118	        "$ARM_ROOT"/attempt_*|/*) ;;
   119	        *) echo "refusing: no canonical attempt was resolved for $1" >&2; return 1 ;;
   120	    esac
   121	}
   122	ARM=""
   123	ARM_BACKBONE=simple_oriented
   124	ARM_YAW=0
   125	ARM_SAVE_EVERY=500
   126	
   127	usage() {
   128	    echo "usage: $0 <smoke|probe|full|finalize> --arm <H|I> --gpu <g> --reviewed-commit <sha40>" >&2
   129	    echo "       [--attempt-root <dir>] [--approved <json>] [--exploratory]" >&2
   130	    echo "       [--attempt <dir> --log <path> --child-exit <n>] [--dry-run]" >&2
   131	    echo "       finalize also takes [--replace-final] [--break-lock]" >&2
   132	    exit 2
   133	}
   134	
   135	# arm_of <H|I>: the attempt root, augmentation and saving cadence of one pretraining arm.
   136	# H is exp_01's recipe (save_every 500); I is exp_04's, whose constraints the trainer
   137	# re-applies (--save-every 0 and no --resume).
   138	arm_of() { case "$1" in
   139	  H) ARM_ROOT="$SIMPOR_ROOT"; ARM_YAW=0; ARM_SAVE_EVERY=500;;
   140	  I) ARM_ROOT="$SIMPOR_YAW_ROOT"; ARM_YAW=1; ARM_SAVE_EVERY=0;;
   141	  *) echo "refusing: unknown arm $1 (H or I)" >&2; return 1;; esac
   142	  ARM_BACKBONE=simple_oriented; }
   143	
   144	# Every gate before a child starts, through exp_11's own finalizer: HEAD at the reviewed
   145	# commit, a tree clean outside worklog/, no live launch.pid or child.pid under either
   146	# attempt root or the smoke tree, exp_11's approvals, and -- for probe and full -- a card
   147	# with no compute apps at all.
   148	preflight() {
   149	    local extra=()
   150	    [ "${EXPLORATORY:-0}" -eq 0 ] || extra+=(--exploratory)
   151	    [ "$MODE" != smoke ] || extra+=(--min-free-gb "$SMOKE_MAX_GB")
   152	    run "$PYTHON" tools/exp11_finalize.py preflight --mode "$MODE" --gpu "$GPU" \
   153	        --reviewed-commit "$COMMIT" --attempt-root "$SIMPOR_ROOT" \
   154	        --attempt-root "$SIMPOR_YAW_ROOT" --attempt-root "$SMOKE_DIR" \
   155	        --approved "$APPROVED" ${extra[@]+"${extra[@]}"}
   156	}
   157	
   158	finalize() {  # finalize <run dir> <log> <child-exit> <run-type> [receipt]
   159	    local extra=()
   160	    [ -z "${OWNER:-}" ] || extra+=(--owner-pid "$OWNER")
   161	    [ $# -lt 5 ] || extra+=(--receipt "$5")
   162	    run "$PYTHON" tools/exp11_finalize.py --run-dir "$1" --run-type "$4" --log "$2" \
   163	        --child-exit "$3" ${extra[@]+"${extra[@]}"}
   164	}
   165	
   166	require_passed() {  # require_passed <run dir>: the next rung consumes this one's checkpoint
   167	    if ! run "$PYTHON" tools/exp11_finalize.py passed --run-dir "$1" --run-type exp11_smoke; then
   168	        say "STOP $1 did not pass; the rung that consumes its checkpoint is not started"
   169	        exit 2
   170	    fi
   171	}
   172	
   173	promote() {  # promote <attempt basename>: atomic, so `final` never points at nothing
   174	    say "PROMOTE $ARM_ROOT/final -> $1"
   175	    if [ "${DRY:-0}" -eq 0 ]; then
   176	        ln -s -- "$1" "$ARM_ROOT/.final.$$"
   177	        mv -Tf -- "$ARM_ROOT/.final.$$" "$ARM_ROOT/final"
   178	    fi
   179	}
   180	
   181	# --- publishing one arm is serialised -----------------------------------------------
   182	# Close review 2: recovery had no ownership at all, so two invocations could interleave
   183	# -- one finalising while the other renamed the shared attempt out from under it -- and
   184	# report success over a dangling `final`. Every path that validates, finalises or
   185	# promotes an attempt of an arm takes this lock first. `mkdir` is the atomic primitive:
   186	# it succeeds for exactly one caller. A held lock REFUSES immediately, it never waits,
   187	# and a stale one is evidence of an interrupted publication, so it is cleared only by an
   188	# explicit --break-lock and never on a timer.
   189	LOCK_DIR=""
   190	LOCK_HELD=0
   191	# The GENERATION of the lock this invocation holds. A lock directory is not identity
   192	# enough: it can be retired and re-created between two statements of one shell, so a
   193	# process-local flag would let an earlier owner remove its successor's lock. The owner
   194	# file carries this nonce, and cleanup acts only where the nonce is still ours.
   195	LOCK_NONCE=""
   196	INTERRUPTED=0
   197	# A lock whose owner file has not landed yet is an acquisition in progress, not a stale
   198	# lock; only one older than this may be broken.
   199	LOCK_GRACE_S="${EXP11_LOCK_GRACE_S:-30}"
   200	BREAKING_DIR=""
   201	BREAKING_HELD=0
   202	LOCK_NONCE_CANDIDATE=""
   203	
   204	# Every reader of an owner file ends in `|| true`: an absent or unreadable owner is
   205	# explicit NON-ownership, and `sed`'s failure must never propagate under `set -e` --
   206	# that is what pre-empted the signal handler's own exit.
   207	lock_nonce_of() {  # the generation recorded in one lock directory, or nothing
   208	    sed -n 's/^pid [0-9][0-9]* nonce \([^ ][^ ]*\).*/\1/p' "$1/owner" 2>/dev/null || true
   209	}
   210	
   211	lock_pid_of() {
   212	    sed -n 's/^pid \([0-9][0-9]*\).*/\1/p' "$1/owner" 2>/dev/null || true
   213	}
   214	
   215	lock_owner_line() {
   216	    cat -- "$1/owner" 2>/dev/null | tr -d '\n' || true
   217	}
   218	
   219	lock_inode_of() {
   220	    stat -c %i -- "$1" 2>/dev/null || true
   221	}
   222	
   223	# Older than the initialisation grace? `mkdir` publishes the pathname before the owner
   224	# file lands, so a lock without an owner is an acquisition in progress until it is old
   225	# enough to be an abandoned one.
   226	lock_older_than_grace() {
   227	    local age
   228	    age="$(( $(date +%s) - $(stat -c %Y -- "$1" 2>/dev/null || echo 0) ))"
   229	    [ "$age" -ge "$LOCK_GRACE_S" ]
   230	}
   231	
   232	lock_is_live() {  # a pid that is gone does not hold a lock; a live one is never overridden
   233	    local pid
   234	    pid="$(lock_pid_of "$1")"
   235	    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
   236	}
   237	
   238	# A test-only ordering hook: wait (bounded) for a file to appear. It takes a PATH, never
   239	# a command, so nothing here evaluates anything the environment supplies.
   240	lock_barrier() { lock_wait_for "${EXP11_LOCK_BARRIER:-}"; }
   241	
   242	# The same hook at the one point inside acquisition the schedules need to interleave at:
   243	# after the owner file has landed and before self-verification.
   244	lock_acquire_barrier() { lock_wait_for "${EXP11_ACQUIRE_BARRIER:-}"; }
   245	
   246	lock_wait_for() {
   247	    local file="$1" waited=0
   248	    [ -n "$file" ] || return 0
   249	    while [ ! -e "$file" ] && [ "$waited" -lt 100 ]; do sleep 0.1; waited=$((waited + 1)); done
   250	}
   251	
   252	release_lock() {
   253	    release_breaking
   254	    [ "$LOCK_HELD" -eq 1 ] || return 0
   255	    LOCK_HELD=0
   256	    local now=""
   257	    if [ -f "$LOCK_DIR/owner" ]; then
   258	        now="$(lock_nonce_of "$LOCK_DIR")"
   259	    else
   260	        say "UNLOCK SKIPPED $LOCK_DIR has no owner: this invocation owns nothing there"
   261	        return 0
   262	    fi
   263	    if [ -n "$LOCK_NONCE" ] && [ "$now" != "$LOCK_NONCE" ]; then
   264	        say "UNLOCK SKIPPED $LOCK_DIR holds the generation ${now:-none}, not $LOCK_NONCE"
   265	        return 0
   266	    fi
   267	    rm -f -- "$LOCK_DIR/owner"
   268	    rmdir -- "$LOCK_DIR" 2>/dev/null || true
   269	    say "UNLOCK $LOCK_DIR"
   270	}
   271	
   272	# The BREAKING META-LOCK. Retirement exposes the lock pathname for as long as it takes
   273	# to re-create it, and nothing may acquire it in that window -- which is what let a
   274	# breaker and an ordinary caller both end up holding. `take_lock` refuses while this
   275	# exists, and a second breaker refuses on it rather than racing the first.
   276	take_breaking() {
   277	    BREAKING_DIR="$LOCK_DIR.breaking"
   278	    if ! mkdir -- "$BREAKING_DIR" 2>/dev/null; then
   279	        echo "refusing: a break of $LOCK_DIR is already in progress" \
   280	             "($(lock_owner_line "$BREAKING_DIR"))" >&2
   281	        return 1
   282	    fi
   283	    BREAKING_HELD=1
   284	    printf 'pid %s nonce %s arm %s at %s\n' "$$" "$LOCK_NONCE_CANDIDATE" "$ARM" \
   285	        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$BREAKING_DIR/owner"
   286	}
   287	
   288	release_breaking() {
   289	    [ "$BREAKING_HELD" -eq 1 ] || return 0
   290	    BREAKING_HELD=0
   291	    local now=""
   292	    [ ! -f "$BREAKING_DIR/owner" ] || now="$(lock_nonce_of "$BREAKING_DIR")"
   293	    if [ -n "$now" ] && [ "$now" != "$LOCK_NONCE_CANDIDATE" ]; then
   294	        say "UNBREAKING SKIPPED $BREAKING_DIR is not this invocation's"
   295	        return 0
   296	    fi
   297	    rm -f -- "$BREAKING_DIR/owner"
   298	    rmdir -- "$BREAKING_DIR" 2>/dev/null || true
   299	}
   300	
   301	# A signal handler must END this invocation. A cleanup-only handler returns, and bash
   302	# resumes -- which would let finalization and promotion continue with the lock released.
   303	on_signal() {  # on_signal <NAME> <number>
   304	    INTERRUPTED=1
   305	    say "SIGNAL $1"
   306	    release_lock
   307	    exit $((128 + $2))
   308	}
   309	
   310	# Checked before every protected step, so nothing runs after a handler has fired even if
   311	# some future caller swallows the exit.
   312	not_interrupted() {
   313	    [ "$INTERRUPTED" -eq 0 ] && return 0
   314	    echo "refusing: a signal handler has fired; this invocation does not continue" >&2
   315	    return 1
   316	}
   317	
   318	# break_lock <observed-nonce>: retire the SPECIFIC stale lock this invocation observed,
   319	# under the breaking meta-lock so nothing can acquire the exposed pathname meanwhile.
   320	#
   321	# The two schedules the close review demonstrated are closed as follows. (1) An acquirer
   322	# paused between `mkdir` and its owner write leaves an owner-less lock: that is an
   323	# acquisition in progress until it is older than the grace, so the breaker refuses rather
   324	# than retiring it. (2) A breaker whose observation is out of date fails the generation
   325	# comparison, and because the meta-lock is held for the whole break, no third caller can
   326	# slip into the exposed pathname even in the defensive restore branch.
   327	break_lock() {
   328	    local observed="$1" retired="$LOCK_DIR.broken.${1:-empty}" now
   329	    [ -d "$LOCK_DIR" ] || return 0
   330	    take_breaking || return 1
   331	    if lock_is_live "$LOCK_DIR"; then
   332	        echo "refusing: --break-lock will not override the live owner of $LOCK_DIR" \
   333	             "($(lock_owner_line "$LOCK_DIR"))" >&2
   334	        return 1
   335	    fi
   336	    if [ ! -f "$LOCK_DIR/owner" ]; then
   337	        if ! lock_older_than_grace "$LOCK_DIR"; then
   338	            echo "refusing: $LOCK_DIR has no owner file yet and is younger than the" \
   339	                 "${LOCK_GRACE_S}s grace: that is an acquisition in progress, not a" \
   340	                 "stale lock" >&2
   341	            return 1
   342	        fi
   343	    fi
   344	    now="$(lock_nonce_of "$LOCK_DIR")"
   345	    if [ "$now" != "$observed" ]; then
   346	        echo "refusing: $LOCK_DIR now holds the generation ${now:-none}, not the" \
   347	             "${observed:-none} this invocation observed; another publication has" \
   348	             "taken it" >&2
   349	        return 1
   350	    fi
   351	    lock_barrier
   352	    if ! mv -T -- "$LOCK_DIR" "$retired" 2>/dev/null; then
   353	        echo "refusing: could not retire the stale lock $LOCK_DIR as $retired;" \
   354	             "another --break-lock reached it first" >&2
   355	        return 1
   356	    fi
   357	    # Defensive: with the meta-lock held nothing else can have replaced the directory
   358	    # between the comparison and the rename, so this branch should be unreachable.
   359	    now="$(lock_nonce_of "$retired")"
   360	    if [ "$now" != "$observed" ]; then
   361	        mv -T -- "$retired" "$LOCK_DIR" 2>/dev/null \
   362	            || say "UNRESTORED $retired could not be put back as $LOCK_DIR"
   363	        echo "refusing: the lock changed generation while it was being retired" >&2
   364	        return 1
   365	    fi
   366	    say "BREAKLOCK $LOCK_DIR retired as $retired owner=$(lock_owner_line "$retired")"
   367	}
   368	
   369	take_lock() {  # take_lock <mode>
   370	    LOCK_DIR="$ARM_ROOT/.publish.lock"
   371	    say "LOCK $LOCK_DIR"
   372	    # A dry run touches nothing outside the test roots, so the lock is real exactly
   373	    # where the tests exercise it and announced everywhere else.
   374	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   375	    mkdir -p -- "$ARM_ROOT" || return 1
   376	    # The generation is chosen BEFORE anything is created, so the meta-lock and the lock
   377	    # itself carry the same invocation identity.
   378	    LOCK_NONCE_CANDIDATE="$$-$(date -u +%s%N)-${RANDOM}${RANDOM}"
   379	    if [ "$BREAK_LOCK" -eq 1 ] && [ -d "$LOCK_DIR" ]; then
   380	        break_lock "$(lock_nonce_of "$LOCK_DIR")" || { release_breaking; return 1; }
   381	    fi
   382	    if [ -d "$LOCK_DIR.breaking" ] && [ "$BREAKING_HELD" -eq 0 ]; then
   383	        echo "refusing: a break of $LOCK_DIR is in progress; the lock pathname is not" \
   384	             "available while it is being retired" >&2
   385	        return 1
   386	    fi
   387	    if ! mkdir -- "$LOCK_DIR" 2>/dev/null; then
   388	        local live=no
   389	        lock_is_live "$LOCK_DIR" && live=yes
   390	        echo "refusing: another publication holds the lock $LOCK_DIR (owner:" \
   391	             "$(lock_owner_line "$LOCK_DIR"), live=$live)." \
   392	             "Publishing one arm is serialised; a stale lock is cleared only with" \
   393	             "--break-lock, never automatically" >&2
   394	        return 1
   395	    fi
   396	    local inode
   397	    inode="$(lock_inode_of "$LOCK_DIR")"
   398	    LOCK_NONCE="$LOCK_NONCE_CANDIDATE"
   399	    LOCK_HELD=1
   400	    trap release_lock EXIT
   401	    trap 'on_signal INT 2' INT
   402	    trap 'on_signal TERM 15' TERM
   403	    # The owner file lands atomically inside the directory this invocation created: a
   404	    # write into a retired directory fails here rather than appearing in somebody else's.
   405	    if ! { printf 'pid %s nonce %s mode %s arm %s at %s\n' "$$" "$LOCK_NONCE" "$1" \
   406	               "$ARM" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$LOCK_DIR/.owner.$$" \
   407	           && mv -- "$LOCK_DIR/.owner.$$" "$LOCK_DIR/owner"; }; then
   408	        LOCK_HELD=0
   409	        echo "refusing: could not record ownership of $LOCK_DIR; it was retired while" \
   410	             "this invocation was acquiring it" >&2
   411	        return 1
   412	    fi
   413	    lock_acquire_barrier
   414	    # SELF-VERIFICATION. Between `mkdir` and now the directory may have been retired and
   415	    # re-created by somebody else; this invocation then owns nothing and must remove
   416	    # nothing. Same inode, our own generation, and no break in progress.
   417	    if [ "$(lock_inode_of "$LOCK_DIR")" != "$inode" ] \
   418	       || [ "$(lock_nonce_of "$LOCK_DIR")" != "$LOCK_NONCE" ] \
   419	       || { [ -d "$LOCK_DIR.breaking" ] && [ "$BREAKING_HELD" -eq 0 ]; }; then
   420	        LOCK_HELD=0
   421	        echo "refusing: $LOCK_DIR is no longer the lock this invocation created" \
   422	             "(inode or generation changed, or a break began); nothing was removed" >&2
   423	        return 1
   424	    fi
   425	    release_breaking
   426	}
   427	
   428	# published_target: what `final` resolves to under this arm root, or nothing.
   429	published_target() {
   430	    [ -L "$ARM_ROOT/final" ] || return 1
   431	    readlink -f -- "$ARM_ROOT/final"
   432	}
   433	
   434	# already_published <canonical>: this attempt is the published one and it completed.
   435	already_published() {
   436	    local target
   437	    target="$(published_target)" || return 1
   438	    [ "$target" = "$1" ] && [ -f "$1/completion.json" ]
   439	}
   440	
   441	# check_final_conflict <canonical>: a DIFFERENT existing `final` is never replaced by a
   442	# recovery unless the operator asks for it, and the replaced target is logged first.
   443	check_final_conflict() {
   444	    local target
   445	    target="$(published_target)" || return 0
   446	    [ "$target" != "$1" ] || return 0
   447	    if [ "$REPLACE_FINAL" -eq 0 ]; then
   448	        echo "refusing: $ARM_ROOT/final already publishes $target, not $1; pass" \
   449	             "--replace-final to replace it" >&2
   450	        return 1
   451	    fi
   452	    say "REPLACING $ARM_ROOT/final -> $(basename -- "$target") with $(basename -- "$1")"
   453	}
   454	
   455	# abort_recovery <canonical> <log>: the abort path of a REFUSED recovery. A malformed
   456	# invocation does not establish that a finished run failed, so an attempt that is
   457	# already published or already completed is left exactly as it is -- directory,
   458	# completion and `final` untouched -- and the finalizer's own cause stands on stderr.
   459	# Full mode keeps aborting unconditionally: it launched the attempt it is aborting.
   460	abort_recovery() {
   461	    local canonical="$1" log="$2" why=""
   462	    [ -f "$canonical/completion.json" ] && why="it has completed"
   463	    [ "$(published_target || true)" != "$canonical" ] || why="it is published as final"
   464	    if [ -n "$why" ]; then
   465	        say "PRESERVED $canonical ($why); the refusal is this invocation's, not the run's"
   466	        return 0
   467	    fi
   468	    abort "$canonical" "$log" finalize_refused
   469	}
   470	
   471	# diagnostic <kind> <run dir> <log> <receipt> <entry argv...>: one enumerated diagnostic
   472	# kind through the same lifecycle as a confirmatory child, finalized as exp11_smoke and
   473	# never admissible as an arm.
   474	diagnostic() {
   475	    local kind="$1" dir="$2" log="$3" receipt="$4"
   476	    shift 4
   477	    local flags=(--kind "$kind" --receipt "$receipt" --provenance-out "$dir/provenance.json"
   478	                 --approved "$APPROVED" --reviewed-commit "$COMMIT")
   479	    [ "${EXPLORATORY:-0}" -eq 0 ] || flags+=(--exploratory)
   480	    local cmd=("$PYTHON" tools/exp11_smoke.py "${flags[@]}" "$@")
   481	    say "MKDIR $dir"
   482	    say "SINK cat >> $log"
   483	    say "PIDFILE $dir/launch.pid"
   484	    say "RUN nohup setsid ${cmd[*]}"
   485	    if [ "$DRY" -eq 1 ]; then
   486	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   487	        finalize "$dir" "$log" '<code>' exp11_smoke "$receipt"
   488	        return 0
   489	    fi
   490	    mkdir -p -- "$(dirname -- "$dir")" "$RECORD"
   491	    mkdir -- "$dir"      # exclusive: a repeated stamp must not reuse a diagnostic run
   492	    own_launch "$dir"
   493	    : > "$log"
   494	    run_child "$dir" "$log" "${cmd[@]}"
   495	    close_child "$dir" "$log"
   496	    if ! finalize "$dir" "$log" "$CHILD_STATUS" exp11_smoke "$receipt"; then
   497	        abort "$dir" "$log" finalize_refused
