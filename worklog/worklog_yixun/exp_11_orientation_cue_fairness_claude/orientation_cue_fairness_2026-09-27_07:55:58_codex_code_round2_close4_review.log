   542	def lock_with(root, nonce='n0', pid='999999', mode='finalize'):
   543	    """A lock directory owned by a given pid and generation nonce."""
   544	    lock = root / LOCK
   545	    lock.mkdir(parents=True, exist_ok=True)
   546	    (lock / 'owner').write_text(
   547	        'pid {} nonce {} mode {} arm H at 2026-09-27T00:00:00Z\n'.format(nonce and pid or pid,
   548	                                                                        nonce, mode))
   549	    return lock
