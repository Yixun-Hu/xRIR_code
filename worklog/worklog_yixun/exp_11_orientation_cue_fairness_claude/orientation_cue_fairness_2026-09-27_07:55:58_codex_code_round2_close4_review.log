   304	             "$(cat -- "$LOCK_DIR/owner" 2>/dev/null | tr -d '\n'), live=$live)." \
   305	             "Publishing one arm is serialised; a stale lock is cleared only with" \
   306	             "--break-lock, never automatically" >&2
