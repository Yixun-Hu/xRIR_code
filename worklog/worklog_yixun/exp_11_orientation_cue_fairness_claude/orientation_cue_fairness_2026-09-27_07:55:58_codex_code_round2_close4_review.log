   645	def test_two_interleaved_breakers_leave_exactly_one_holder(tmp_path):
   646	    """The real race, with a file barrier inside break_lock to order the two readers."""
   647	    root = tmp_path / 'xRIR_simpor_8_shot'
   648	    root.mkdir(parents=True)
   649	    lock_with(root, nonce='stale')
   650	    gate = tmp_path / 'gate'
   651	    slow = subprocess.Popen(
   652	        ['bash', '-c',
   653	         'set -euo pipefail\nEXP11_LAUNCH_LIB=1 source tools/exp11_launch.sh\n'
   654	         'ARM_ROOT={root}\nDRY=0\nARM=H\nBREAK_LOCK=1\ntake_lock finalize\n'
   655	         'echo SLOW_ACQUIRED\nsleep 3\n'.format(root=root)],
   656	        cwd=str(REPO), stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
   657	        env=dict(os.environ, CUDA_VISIBLE_DEVICES='', EXP11_LOCK_BARRIER=str(gate)))
   658	    fast = lib('ARM_ROOT={root}\nDRY=0\nARM=H\nBREAK_LOCK=1\ntake_lock finalize\n'
   659	               'echo FAST_ACQUIRED\nLOCK_HELD=0\n'.format(root=root))
   660	    gate.write_text('go\n')
   661	    slow_out, slow_err = slow.communicate(timeout=60)
   662	    acquired = ('FAST_ACQUIRED' in fast.stdout) + ('SLOW_ACQUIRED' in slow_out)
   663	    assert acquired == 1, (fast.stdout, fast.stderr, slow_out, slow_err)
   664	    assert (root / LOCK).is_dir(), 'the loser removed the winner\'s lock'
     1	#!/usr/bin/env bash
     2	# exp_11 launcher (plan v3 items 6 and 12). Certified invocation for a confirmatory run:
     3	#   nohup setsid tools/exp11_launch.sh full --arm H --gpu 1 --reviewed-commit <sha> \
     4	#       > <launcher.log> 2>&1 &
     5	# Recovery after a crashed launcher (the child already exited):
     6	#   tools/exp11_launch.sh finalize --arm H --gpu 1 --reviewed-commit <sha> \
     7	#       --attempt <dir> --log <child.log> --child-exit <code>
     8	# --dry-run prints every command and path (timestamps as <UTC>) and executes nothing.
     9	#
    10	# The child lifecycle -- exclusive directory, one drained pipe, the end marker, the exit
    11	# receipt -- is tools/exp06_launch.sh's and is sourced here as a library; it is shared
    12	# evidence, not an exp_11 decision, and forking it would fork the very bytes closed_log
    13	# re-validates. Both files are bound by exp_11's `launch_sh` approvals key. What this
    14	# script overrides is everything that names an experiment: the finalizer it calls
    15	# (tools/exp11_finalize.py), the approvals, the attempt roots, the record and the arms.
    16	#
    17	# EXP11_LAUNCH_LIB=1 source tools/exp11_launch.sh defines the functions and returns, so
    18	# the pipeline can reuse them without a mode.
    19	set -euo pipefail
    20	cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
    21	EXP06_LAUNCH_LIB=1 source tools/exp06_launch.sh
    22	export PYTHONPATH="$PWD"
    23	
    24	RECORD=worklog/worklog_yixun/exp_11_orientation_cue_fairness_claude
    25	APPROVED_DEFAULT="$RECORD/orientation_cue_fairness_results_assets/approved_digests.json"
    26	SMOKE_DIR=ckpt/exp11/_smoke
    27	# The pretraining roots. EXP11_PRETRAIN_ROOT exists for the dry-run tests alone: it moves
    28	# the attempt roots AND the roots preflight scans for live pid files, so a real launch may
    29	# never take it. It is honoured only with EXP11_TEST_ROOTS=1 *and* --dry-run, and is
    30	# refused outright otherwise (see apply_root_override below).
    31	PRETRAIN_ROOT=ckpt/exp11/pretrain
    32	SIMPOR_ROOT="$PRETRAIN_ROOT/xRIR_simpor_8_shot"          # arm H
    33	SIMPOR_YAW_ROOT="$PRETRAIN_ROOT/xRIR_simpor_yawaug_8_shot"   # arm I
    34	HEADING_DIR="${EXP06_HEADING_DIR:-ckpt/exp06/heading}"
    35	SMOKE_FLAGS="--epochs 1 --max-train-batches 3 --max-test-batches 2 --batch-size 4 --num-workers 4 --no-save"
    36	SMOKE_ALARM_S="${EXP11_SMOKE_ALARM_S:-300}"
    37	SMOKE_MAX_GB="${EXP11_SMOKE_MAX_GB:-6}"
    38	# Plan section 7 reserves 36 h per pretraining; the child runs under that hard ceiling, so
    39	# a stalled attempt fails and is aborted instead of holding the card indefinitely. The
    40	# value goes straight to GNU timeout, where 0 means "no timeout", so an override is
    41	# validated before anything starts and may only TIGHTEN the registered ceiling.
    42	FULL_CEILING_MAX=129600
    43	FULL_CEILING_S="${EXP11_FULL_CEILING_S-$FULL_CEILING_MAX}"
    44	
    45	# The value is validated as a BOUNDED DECIMAL STRING before any arithmetic: bash's
    46	# integer comparisons error out above 2**63-1, which left the `if` false and the launch
    47	# running with an overflowing value handed to GNU timeout. Six digits is the whole
    48	# contract (129600 has six), so the numeric comparison below can never be out of range;
    49	# leading zeros are refused with everything else that is not a plain decimal.
    50	check_ceiling() {
    51	    local why="must be a plain decimal of at most 6 digits in (0, $FULL_CEILING_MAX]"
    52	    case "$FULL_CEILING_S" in
    53	        ''|*[!0-9]*|0*|???????*)
    54	            echo "refusing: EXP11_FULL_CEILING_S '$FULL_CEILING_S' $why" >&2; return 1 ;;
    55	    esac
    56	    if [ "$FULL_CEILING_S" -le 0 ] || [ "$FULL_CEILING_S" -gt "$FULL_CEILING_MAX" ]; then
    57	        echo "refusing: EXP11_FULL_CEILING_S $FULL_CEILING_S $why;" \
    58	             "an override may only tighten the 36 h ceiling" >&2
    59	        return 1
    60	    fi
    61	}
    62	
    63	# apply_root_override: EXP11_PRETRAIN_ROOT is a dry-run test affordance and nothing else.
    64	apply_root_override() {
    65	    [ -n "${EXP11_PRETRAIN_ROOT:-}" ] || return 0
    66	    if [ "${EXP11_TEST_ROOTS:-0}" != 1 ] || [ "$DRY" -ne 1 ]; then
    67	        echo "refusing: EXP11_PRETRAIN_ROOT moves the attempt roots and the roots" \
    68	             "preflight scans, so it is honoured only with EXP11_TEST_ROOTS=1 and" \
    69	             "--dry-run" >&2
    70	        return 1
    71	    fi
    72	    PRETRAIN_ROOT="$EXP11_PRETRAIN_ROOT"
    73	    SIMPOR_ROOT="$PRETRAIN_ROOT/xRIR_simpor_8_shot"
    74	    SIMPOR_YAW_ROOT="$PRETRAIN_ROOT/xRIR_simpor_yawaug_8_shot"
    75	}
    76	
    77	# check_attempt <attempt> <root> <arm>: recovery may promote only this arm's own attempt.
    78	# The basename is linked under the root --arm selects, so an attempt of the other arm
    79	# would leave a dangling or wrong `final`; the directory AND the profile its recorded
    80	# arguments select must both be the selected arm's.
    81	CHECK_ATTEMPT_PY='
    82	import json, sys
    83	from pathlib import Path
    84	from tools import exp11_recipe
    85	attempt, root, arm = sys.argv[1:4]
    86	expected = {"H": "H_RECIPE", "I": "I_RECIPE"}[arm]
    87	try:
    88	    # The path that is VALIDATED must be the path that is finalized and promoted, or an
    89	    # alias (an existing `final`, or a link from outside) would be validated here and
    90	    # promoted by its own basename - a self-referencing or dangling link under the root.
    91	    directory, base = Path(attempt).resolve(), Path(root).resolve()
    92	    if directory.parent != base:
    93	        raise ValueError("attempt {} is not an attempt of the arm {} root {}".format(
    94	            directory, arm, base))
    95	    if not directory.name.startswith("attempt_"):
    96	        raise ValueError("{} is not an attempt_<UTC> directory".format(directory))
    97	    args = json.loads((directory / "args.json").read_text())
    98	    profile = exp11_recipe.select_profile(args)
    99	    if profile != expected:
   100	        raise ValueError("attempt {} recorded the profile {}, not the {} of arm {}".format(
   101	            directory, profile, expected, arm))
   102	except (OSError, ValueError, KeyError) as error:
   103	    raise SystemExit("refusing: " + str(error))
   104	print("ATTEMPT ok {} arm={} profile={}".format(attempt, arm, expected))
   105	print("ATTEMPT canonical {}".format(directory))
   106	'
   107	
   108	# check_attempt <attempt>: sets CANONICAL_ATTEMPT to the resolved directory, which is
   109	# what finalization and promotion then use.
   110	check_attempt() {
   111	    local output
   112	    say "ATTEMPTCHECK $1 arm=$ARM root=$ARM_ROOT"
   113	    output="$(CUDA_VISIBLE_DEVICES="" "$PYTHON" -c "$CHECK_ATTEMPT_PY" "$1" "$ARM_ROOT" \
   114	              "$ARM")" || return 1
   115	    printf '%s\n' "$output"
   116	    CANONICAL_ATTEMPT="${output##*ATTEMPT canonical }"
   117	    case "$CANONICAL_ATTEMPT" in
   118	        "$ARM_ROOT"/attempt_*|/*) ;;
   119	        *) echo "refusing: no canonical attempt was resolved for $1" >&2; return 1 ;;
   120	    esac
   121	}
   122	ARM=""
   123	ARM_BACKBONE=simple_oriented
   124	ARM_YAW=0
   125	ARM_SAVE_EVERY=500
   126	
   127	usage() {
   128	    echo "usage: $0 <smoke|probe|full|finalize> --arm <H|I> --gpu <g> --reviewed-commit <sha40>" >&2
   129	    echo "       [--attempt-root <dir>] [--approved <json>] [--exploratory]" >&2
   130	    echo "       [--attempt <dir> --log <path> --child-exit <n>] [--dry-run]" >&2
   131	    echo "       finalize also takes [--replace-final] [--break-lock]" >&2
   132	    exit 2
   133	}
   134	
   135	# arm_of <H|I>: the attempt root, augmentation and saving cadence of one pretraining arm.
   136	# H is exp_01's recipe (save_every 500); I is exp_04's, whose constraints the trainer
   137	# re-applies (--save-every 0 and no --resume).
   138	arm_of() { case "$1" in
   139	  H) ARM_ROOT="$SIMPOR_ROOT"; ARM_YAW=0; ARM_SAVE_EVERY=500;;
   140	  I) ARM_ROOT="$SIMPOR_YAW_ROOT"; ARM_YAW=1; ARM_SAVE_EVERY=0;;
   141	  *) echo "refusing: unknown arm $1 (H or I)" >&2; return 1;; esac
   142	  ARM_BACKBONE=simple_oriented; }
   143	
   144	# Every gate before a child starts, through exp_11's own finalizer: HEAD at the reviewed
   145	# commit, a tree clean outside worklog/, no live launch.pid or child.pid under either
   146	# attempt root or the smoke tree, exp_11's approvals, and -- for probe and full -- a card
   147	# with no compute apps at all.
   148	preflight() {
   149	    local extra=()
   150	    [ "${EXPLORATORY:-0}" -eq 0 ] || extra+=(--exploratory)
   151	    [ "$MODE" != smoke ] || extra+=(--min-free-gb "$SMOKE_MAX_GB")
   152	    run "$PYTHON" tools/exp11_finalize.py preflight --mode "$MODE" --gpu "$GPU" \
   153	        --reviewed-commit "$COMMIT" --attempt-root "$SIMPOR_ROOT" \
   154	        --attempt-root "$SIMPOR_YAW_ROOT" --attempt-root "$SMOKE_DIR" \
   155	        --approved "$APPROVED" ${extra[@]+"${extra[@]}"}
   156	}
   157	
   158	finalize() {  # finalize <run dir> <log> <child-exit> <run-type> [receipt]
   159	    local extra=()
   160	    [ -z "${OWNER:-}" ] || extra+=(--owner-pid "$OWNER")
   161	    [ $# -lt 5 ] || extra+=(--receipt "$5")
   162	    run "$PYTHON" tools/exp11_finalize.py --run-dir "$1" --run-type "$4" --log "$2" \
   163	        --child-exit "$3" ${extra[@]+"${extra[@]}"}
   164	}
   165	
   166	require_passed() {  # require_passed <run dir>: the next rung consumes this one's checkpoint
   167	    if ! run "$PYTHON" tools/exp11_finalize.py passed --run-dir "$1" --run-type exp11_smoke; then
   168	        say "STOP $1 did not pass; the rung that consumes its checkpoint is not started"
   169	        exit 2
   170	    fi
   171	}
   172	
   173	promote() {  # promote <attempt basename>: atomic, so `final` never points at nothing
   174	    say "PROMOTE $ARM_ROOT/final -> $1"
   175	    if [ "${DRY:-0}" -eq 0 ]; then
   176	        ln -s -- "$1" "$ARM_ROOT/.final.$$"
   177	        mv -Tf -- "$ARM_ROOT/.final.$$" "$ARM_ROOT/final"
   178	    fi
   179	}
   180	
   181	# --- publishing one arm is serialised -----------------------------------------------
   182	# Close review 2: recovery had no ownership at all, so two invocations could interleave
   183	# -- one finalising while the other renamed the shared attempt out from under it -- and
   184	# report success over a dangling `final`. Every path that validates, finalises or
   185	# promotes an attempt of an arm takes this lock first. `mkdir` is the atomic primitive:
   186	# it succeeds for exactly one caller. A held lock REFUSES immediately, it never waits,
   187	# and a stale one is evidence of an interrupted publication, so it is cleared only by an
   188	# explicit --break-lock and never on a timer.
   189	LOCK_DIR=""
   190	LOCK_HELD=0
   191	# The GENERATION of the lock this invocation holds. A lock directory is not identity
   192	# enough: it can be retired and re-created between two statements of one shell, so a
   193	# process-local flag would let an earlier owner remove its successor's lock. The owner
   194	# file carries this nonce, and cleanup acts only where the nonce is still ours.
   195	LOCK_NONCE=""
   196	INTERRUPTED=0
   197	
   198	lock_nonce_of() {  # the generation recorded in one lock directory, or nothing
   199	    sed -n 's/^pid [0-9][0-9]* nonce \([^ ][^ ]*\).*/\1/p' "$1/owner" 2>/dev/null
   200	}
   201	
   202	lock_pid_of() {
   203	    sed -n 's/^pid \([0-9][0-9]*\).*/\1/p' "$1/owner" 2>/dev/null
   204	}
   205	
   206	lock_is_live() {  # a pid that is gone does not hold a lock; a live one is never overridden
   207	    local pid
   208	    pid="$(lock_pid_of "$1")"
   209	    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
   210	}
   285	    fi
   286	    say "BREAKLOCK $LOCK_DIR retired as $retired owner=$(cat -- "$retired/owner" \
   287	        2>/dev/null | tr -d '\n')"
   288	}
   289	
   290	take_lock() {  # take_lock <mode>
   291	    LOCK_DIR="$ARM_ROOT/.publish.lock"
   292	    say "LOCK $LOCK_DIR"
   293	    # A dry run touches nothing outside the test roots, so the lock is real exactly
   294	    # where the tests exercise it and announced everywhere else.
   295	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
