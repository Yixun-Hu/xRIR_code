   552	def test_the_term_handler_terminates_instead_of_resuming(tmp_path):
   553	    """A handler that only cleans up lets the protected work continue unlocked.
   554	
   555	    The registered body is replayed directly -- no signal is ever sent -- and execution
   556	    must not return to the caller: the handler cleans up, says so, and exits 128+n.
   557	    """
   558	    root = tmp_path / 'xRIR_simpor_8_shot'
   559	    root.mkdir(parents=True)
   560	    script = ('ARM_ROOT={root}\nDRY=0\nARM=H\ntake_lock finalize\n'
   561	              'handler="$(trap -p TERM | sed -n "s/^trap -- \'\\(.*\\)\' SIGTERM$/\\1/p")"\n'
   562	              '[ -n "$handler" ] || {{ echo NO_TERM_TRAP; exit 9; }}\n'
   563	              'eval "$handler"\n'
   564	              'echo "CONTINUED_AFTER_HANDLER LOCK_HELD=$LOCK_HELD"\n'
   565	              'promote attempt_X\n').format(root=root)
   566	    result = lib(script)
   567	    assert 'CONTINUED_AFTER_HANDLER' not in result.stdout, (
   568	        'the TERM handler returned and execution resumed without the lock')
   569	    assert 'PROMOTE' not in result.stdout
   570	    assert result.returncode == 143, result.stdout[-400:]
   571	    assert 'SIGNAL TERM' in result.stdout
