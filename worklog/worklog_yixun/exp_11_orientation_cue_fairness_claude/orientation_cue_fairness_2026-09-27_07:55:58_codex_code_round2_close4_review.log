   611	def test_a_breaker_refuses_once_the_lock_it_observed_has_changed(tmp_path):
   612	    """Two breakers that saw the same stale lock: the second must not delete the first's.
   613	
   614	    The observation is passed to ``break_lock``, so a breaker that acts on a generation
   615	    which is no longer there refuses instead of retiring whatever it now finds.
   616	    """
   617	    root = tmp_path / 'xRIR_simpor_8_shot'
   618	    root.mkdir(parents=True)
   619	    lock_with(root, nonce='stale')
   620	    first = lib('ARM_ROOT={root}\nDRY=0\nARM=H\nBREAK_LOCK=1\ntake_lock finalize\n'
   621	                'cat "$LOCK_DIR/owner"\nLOCK_HELD=0\n'.format(root=root))
   622	    assert first.returncode == 0, first.stderr[-300:]
   623	    assert (root / LOCK).is_dir() and 'stale' not in (root / LOCK / 'owner').read_text()
   624	    fresh = (root / LOCK / 'owner').read_text()
   625	    second = lib('ARM_ROOT={root}\nDRY=0\nARM=H\nLOCK_DIR="$ARM_ROOT/{lock}"\n'
   626	                 'break_lock stale\n'.format(root=root, lock=LOCK))
   627	    assert second.returncode != 0, second.stdout[-300:]
   628	    assert (root / LOCK).is_dir(), "a late breaker retired a generation it never observed"
   629	    assert (root / LOCK / 'owner').read_text() == fresh
