   298	        break_lock "$(lock_nonce_of "$LOCK_DIR")" || return 1
   299	    fi
   300	    if ! mkdir -- "$LOCK_DIR" 2>/dev/null; then
   301	        local live=no
   302	        lock_is_live "$LOCK_DIR" && live=yes
