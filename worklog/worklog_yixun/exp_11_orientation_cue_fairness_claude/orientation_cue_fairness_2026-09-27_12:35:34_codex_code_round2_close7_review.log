   654	def lifecycle(root, launch_child):
   655	    """Replay the frozen ``run_child`` prologue and then take the registered TERM body.
   656	
   657	    ``run_child`` waits for its child, so no launcher can be made to exit in the middle
   658	    of it without sending a real signal. The two lines that matter are asserted to be
   659	    exactly the library's, so this replay cannot drift from what production does.
   660	    """
   661	    library = (REPO / 'tools/exp06_launch.sh').read_text()
   662	    assert SINK_LINE in library and CHILD_LINE in library, (
   663	        'the frozen lifecycle changed; this replay no longer reproduces it')
   664	    child = ('nohup setsid sleep 8 > "$pipe" 2>&1 &\nchild=$!\n'
   665	             'printf %s\\n "$child" > "$attempt/child.pid"\n') if launch_child else ''
   666	    return ('ARM_ROOT={root}\nDRY=0\nARM=H\n'
   667	            'hold_arm_lock finalize || exit 2\n'
   668	            'attempt={root}/attempt_20260927T000000\nmkdir -p -- "$attempt"\n'
   669	            'log="$attempt/child.log"\n: > "$log"\n'
   670	            'pipe="$attempt/child.pipe"\nmkfifo -m 600 -- "$pipe"\n'
   671	            'cat >> "$log" < "$pipe" &\nsink=$!\n'
   672	            'sleep 0.3\n' + child +
   673	            'handler="$(trap -p TERM | sed -n "s/^trap -- \'\\(.*\\)\' SIGTERM$/\\1/p")"\n'
   674	            '[ -n "$handler" ] || {{ echo NO_TERM_TRAP; exit 9; }}\n'
   675	            'eval "$handler"\necho CONTINUED\n').format(root=root)
   676	
