   443	    fi
   444	    not_interrupted || exit 2
   445	    if ! finalize "$attempt" "$log" "$status" exp11_train; then
   446	        abort "$attempt" "$log" finalize_refused
   447	        exit 2
   448	    fi
   449	    not_interrupted || exit 2
   450	    promote "attempt_$STAMP"
   451	    ;;
   452	probe)
   453	    preflight
