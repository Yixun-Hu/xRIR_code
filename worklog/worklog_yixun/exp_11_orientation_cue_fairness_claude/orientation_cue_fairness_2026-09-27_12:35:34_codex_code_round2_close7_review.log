     1	"""Hold one exp_11 arm's publication lock, for exactly as long as its launcher lives.
     2	
     3	Plan section 11 amendment A1, close review 6. The launcher must not hold the lock on a
     4	descriptor of its own: the sourced lifecycle (``tools/exp06_launch.sh``) hands every
     5	open descriptor to the background log sink and to the detached training child, so an
     6	orphaned sink -- one waiting on a FIFO writer that will never arrive -- would keep an
     7	arm locked for good with no trainer running.
     8	
     9	So the lock lives in this process instead, and its life is *leased* to the launcher's:
    10	
    11	* ``flock(LOCK_EX | LOCK_NB)`` on the arm's lock file. Refused means another invocation
    12	  is publishing this arm; this process says ``refused`` and exits 1.
    13	* Taken means it prints ``acquired <pid>`` and then does nothing but watch its parent.
    14	  When the launcher exits or dies -- normally, on a signal, on SIGKILL -- this process
    15	  is reparented, sees the changed parent id and exits, and the kernel drops the lock.
    16	  The launcher also terminates it directly at the end of the protected section, so on
    17	  the ordinary path the release is immediate.
    18	* The lock file is opened for append and never written to: a lock is a name the kernel
    19	  knows, not a record anybody reads. The descriptor is close-on-exec and this process
    20	  execs nothing, so the lock cannot escape into any other program.
    21	"""
    22	import fcntl
    23	import os
    24	import signal
    25	import sys
    26	import time
    27	
    28	LEASE_POLL_S = 0.5
    29	
    30	
    31	def open_lock(path):
    32	    """Open the lock file without truncating it, on a close-on-exec descriptor."""
    33	    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_CLOEXEC, 0o600)
    34	    fcntl.fcntl(fd, fcntl.F_SETFD, fcntl.fcntl(fd, fcntl.F_GETFD) | fcntl.FD_CLOEXEC)
    35	    return fd
    36	
    37	
    38	def _leave(signum, frame):
    39	    raise SystemExit(0)
    40	
    41	
    42	def main(argv):
    43	    if len(argv) != 3:
    44	        print('usage: exp11_lock_holder.py <lock file> <launcher pid>', file=sys.stderr)
    45	        return 2
    46	    path, launcher = argv[1], int(argv[2])
    47	    fd = open_lock(path)
    48	    try:
    49	        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    50	    except OSError:
    51	        print('refused', flush=True)
    52	        return 1
    53	    signal.signal(signal.SIGTERM, _leave)
    54	    signal.signal(signal.SIGINT, _leave)
    55	    print('acquired {}'.format(os.getpid()), flush=True)
    56	    while os.getppid() == launcher:
    57	        time.sleep(LEASE_POLL_S)
    58	    return 0
    59	
    60	
    61	if __name__ == '__main__':
    62	    sys.exit(main(sys.argv))

