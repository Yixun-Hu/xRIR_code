   494	def test_full_mode_takes_the_lock_once_and_never_refuses_itself(tmp_path):
   495	    """One protected section, one descriptor.
   496	
   497	    flock(2) treats two descriptors on the same file as independent even inside a single
   498	    process, so acquiring the arm lock twice would refuse the launcher its own lock.
   499	    """
   500	    status, out, err = launch(['full', '--arm', 'H', '--gpu', '1', '--reviewed-commit',
   501	                               COMMIT, '--dry-run'],
   502	                              {'EXP11_PRETRAIN_ROOT': str(tmp_path),
   503	                               'EXP11_TEST_ROOTS': '1'})
   504	    assert status == 0, err[-600:]
   505	    assert 'another invocation' not in err, 'the launcher refused its own lock'
   506	    lines = out.splitlines()
   507	    assert sum(1 for line in lines if line.startswith('LOCK ')) == 1, out
   508	    assert sum(1 for line in lines if line.startswith('LOCKED ')) == 1, out
