   461	        --yaw-aug "$ARM_YAW" --save-every 0 --log-interval 50 \
   462	        ${CHILD_EXPLORATORY[@]+"${CHILD_EXPLORATORY[@]}"}
   463	    ;;
   464	smoke)
   465	    preflight
   466	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   467	    # (a) the oriented backbone on a bounded budget, through exp_11's training entry.
   468	    diagnostic probe "$SMOKE_DIR/exp11_train_$STAMP" \
