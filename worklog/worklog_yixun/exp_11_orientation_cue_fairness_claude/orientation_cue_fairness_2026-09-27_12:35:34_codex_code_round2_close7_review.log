   734	def test_the_launcher_signals_nothing_that_is_not_its_own_holder(tmp_path):
   735	    """A recorded pid is not a licence to signal it.
   736	
   737	    ``HOLDER_PID`` comes out of the holder's own announcement; if that holder has since
   738	    died, the number can belong to anybody. Releasing the lock must therefore check that
   739	    the process is still this launcher's child before it sends anything. Here it is a
   740	    bystander this test started, and it has to survive.
   741	    """
   742	    bystander = subprocess.Popen(['sleep', '30'])
   743	    try:
   744	        result = lib('HOLDER_PID={}\ndrop_arm_lock\necho RELEASED\n'.format(bystander.pid))
   745	        assert 'RELEASED' in result.stdout, result.stderr[-400:]
   746	        time.sleep(0.5)
   747	        assert bystander.poll() is None, (
   748	            'the launcher signalled a process that was never its holder')
   749	    finally:
   750	        bystander.terminate()
   751	        bystander.wait(timeout=30)
