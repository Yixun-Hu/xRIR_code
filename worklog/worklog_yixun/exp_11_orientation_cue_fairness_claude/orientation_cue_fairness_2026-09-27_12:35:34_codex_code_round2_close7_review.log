   594	def handler_replay(root, signal_name):
   595	    """Take the real lock, then replay the registered handler body. No signal is sent."""
   596	    return ('ARM_ROOT={root}\nDRY=0\nARM=H\nhold_arm_lock finalize\n'
   597	            'handler="$(trap -p {sig} | sed -n "s/^trap -- \'\\(.*\\)\' SIG{sig}$/\\1/p")"\n'
   598	            '[ -n "$handler" ] || {{ echo NO_{sig}_TRAP; exit 9; }}\n'
   599	            'eval "$handler"\necho CONTINUED_AFTER_HANDLER\n'
   600	            'promote attempt_X\n').format(root=root, sig=signal_name)
