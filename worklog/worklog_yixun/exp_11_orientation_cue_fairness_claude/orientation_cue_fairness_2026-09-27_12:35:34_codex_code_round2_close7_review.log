   678	def free(lockfile, seconds=5.0):
   679	    """True once an independent process can take the lock, within ``seconds``."""
   680	    deadline = time.time() + seconds
   681	    while True:
   682	        if subprocess.run(['flock', '-n', str(lockfile), 'true']).returncode == 0:
   683	            return True
   684	        if time.time() >= deadline:
   685	            return False
   686	        time.sleep(0.05)
   687	
   688	
   689	def drain(pipe):
   690	    """Let an orphaned sink see EOF: open the FIFO for writing and close it."""
   691	    if pipe.exists():
   692	        os.close(os.open(str(pipe), os.O_WRONLY | os.O_NONBLOCK))
   693	
   694	
   695	def detached_lib(script, where, env=None):
   696	    """``lib``, but with the output on files.
   697	
   698	    The sink and the detached child inherit the launcher's stderr, so a captured pipe
   699	    would only reach EOF once those orphans ended -- which is the very thing under test.
   700	    """
   701	    out, err = where / 'launcher.out', where / 'launcher.err'
   702	    body = ('set -euo pipefail\n'
   703	            'EXP11_LAUNCH_LIB=1 source tools/exp11_launch.sh\n' + script)
   704	    with open(out, 'w') as o, open(err, 'w') as e:
   705	        status = subprocess.run(['bash', '-c', body], cwd=str(REPO), stdout=o, stderr=e,
   706	                                env=dict(os.environ, CUDA_VISIBLE_DEVICES='',
   707	                                         **(env or {}))).returncode
   708	    return status, out.read_text(), err.read_text()
