# Every gate before a child starts, through exp_11's own finalizer: HEAD at the reviewed
# commit, a tree clean outside worklog/, no live launch.pid or child.pid under either
# attempt root or the smoke tree, exp_11's approvals, and -- for probe and full -- a card
# with no compute apps at all.
preflight() {
    local extra=()
    [ "${EXPLORATORY:-0}" -eq 0 ] || extra+=(--exploratory)
    [ "$MODE" != smoke ] || extra+=(--min-free-gb "$SMOKE_MAX_GB")
    run "$PYTHON" tools/exp11_finalize.py preflight --mode "$MODE" --gpu "$GPU" \
        --reviewed-commit "$COMMIT" --attempt-root "$SIMPOR_ROOT" \
        --attempt-root "$SIMPOR_YAW_ROOT" --attempt-root "$SMOKE_DIR" \
        --approved "$APPROVED" ${extra[@]+"${extra[@]}"}
}

finalize() {  # finalize <run dir> <log> <child-exit> <run-type> [receipt]
    local extra=()
    [ -z "${OWNER:-}" ] || extra+=(--owner-pid "$OWNER")
    [ $# -lt 5 ] || extra+=(--receipt "$5")
    run "$PYTHON" tools/exp11_finalize.py --run-dir "$1" --run-type "$4" --log "$2" \
        --child-exit "$3" ${extra[@]+"${extra[@]}"}
}

require_passed() {  # require_passed <run dir>: the next rung consumes this one's checkpoint
    if ! run "$PYTHON" tools/exp11_finalize.py passed --run-dir "$1" --run-type exp11_smoke; then
        say "STOP $1 did not pass; the rung that consumes its checkpoint is not started"
        exit 2
    fi
}

promote() {  # promote <attempt basename>: atomic, so `final` never points at nothing
    say "PROMOTE $ARM_ROOT/final -> $1"
    if [ "${DRY:-0}" -eq 0 ]; then
        ln -s -- "$1" "$ARM_ROOT/.final.$$"
        mv -Tf -- "$ARM_ROOT/.final.$$" "$ARM_ROOT/final"
    fi
}

# --- publishing one arm is serialised, by the kernel --------------------------------
   300	# invocation does not establish that a finished run failed, so an attempt that is
   301	# already published or already completed is left exactly as it is -- directory,
   302	# completion and `final` untouched -- and the finalizer's own cause stands on stderr.
   303	# Full mode keeps aborting unconditionally: it launched the attempt it is aborting.
   304	abort_recovery() {
   305	    local canonical="$1" log="$2" why=""
   306	    [ -f "$canonical/completion.json" ] && why="it has completed"
   307	    [ "$(published_target || true)" != "$canonical" ] || why="it is published as final"
   308	    if [ -n "$why" ]; then
   309	        say "PRESERVED $canonical ($why); the refusal is this invocation's, not the run's"
   310	        return 0
   311	    fi
   312	    abort "$canonical" "$log" finalize_refused
   313	}
   314	
   315	# diagnostic <kind> <run dir> <log> <receipt> <entry argv...>: one enumerated diagnostic
   316	# kind through the same lifecycle as a confirmatory child, finalized as exp11_smoke and
   317	# never admissible as an arm.
   318	diagnostic() {
   319	    local kind="$1" dir="$2" log="$3" receipt="$4"
   320	    shift 4
   321	    local flags=(--kind "$kind" --receipt "$receipt" --provenance-out "$dir/provenance.json"
   322	                 --approved "$APPROVED" --reviewed-commit "$COMMIT")
   323	    [ "${EXPLORATORY:-0}" -eq 0 ] || flags+=(--exploratory)
   324	    local cmd=("$PYTHON" tools/exp11_smoke.py "${flags[@]}" "$@")
   325	    say "MKDIR $dir"
   326	    say "SINK cat >> $log"
   327	    say "PIDFILE $dir/launch.pid"
   328	    say "RUN nohup setsid ${cmd[*]}"
   329	    if [ "$DRY" -eq 1 ]; then
   330	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   331	        finalize "$dir" "$log" '<code>' exp11_smoke "$receipt"
   332	        return 0
   333	    fi
   334	    mkdir -p -- "$(dirname -- "$dir")" "$RECORD"
   335	    mkdir -- "$dir"      # exclusive: a repeated stamp must not reuse a diagnostic run
   336	    own_launch "$dir"
   337	    : > "$log"
   338	    run_child "$dir" "$log" "${cmd[@]}"
   339	    close_child "$dir" "$log"
   340	    if ! finalize "$dir" "$log" "$CHILD_STATUS" exp11_smoke "$receipt"; then
   341	        abort "$dir" "$log" finalize_refused
   342	        exit 2
   343	    fi
   344	    if [ "$CHILD_STATUS" -ne 0 ]; then
   345	        abort "$dir" "$log" "child_failed_$CHILD_STATUS"
   346	        exit "$CHILD_STATUS"
   347	    fi
   348	}
   349	
   350	# The sourced library already resolved APPROVED to exp_06's record, so exp_11's default
   351	# is assigned unconditionally; EXP11_APPROVED (or --approved) overrides it.
   352	APPROVED="${EXP11_APPROVED:-$APPROVED_DEFAULT}"
   353	COMMIT="${COMMIT:-}"
   354	EXPLORATORY="${EXPLORATORY:-0}"
   355	ARM_ROOT="${ARM_ROOT:-$SIMPOR_ROOT}"
   356	CANONICAL_ATTEMPT="${CANONICAL_ATTEMPT:-}"
   357	INTERRUPTED="${INTERRUPTED:-0}"
   358	REPLACE_FINAL="${REPLACE_FINAL:-0}"
   359	DRY="${DRY:-0}"
   360	ARM="${ARM:-H}"
   361	
   362	if [ "${EXP11_LAUNCH_LIB:-0}" = 1 ]; then return 0; fi
   363	
   364	MODE="${1:-}"
   365	shift || true
   366	case "$MODE" in smoke|probe|full|finalize) ;; *) usage ;; esac
   367	GPU=""; COMMIT=""; ATTEMPT=""; LOG=""; CHILD_EXIT=""; DRY=0; ARM=H
   368	while [ $# -gt 0 ]; do
   369	    case "$1" in
   370	        --arm) ARM="${2:-}"; shift 2 ;;
   371	        --gpu) GPU="${2:-}"; shift 2 ;;
   372	        --reviewed-commit) COMMIT="${2:-}"; shift 2 ;;
   373	        --attempt) ATTEMPT="${2:-}"; shift 2 ;;
   374	        --log) LOG="${2:-}"; shift 2 ;;
   375	        --child-exit) CHILD_EXIT="${2:-}"; shift 2 ;;
   376	        --approved) APPROVED="${2:-}"; shift 2 ;;
   377	        --exploratory) EXPLORATORY=1; shift ;;
   378	        --replace-final) REPLACE_FINAL=1; shift ;;
   379	        --dry-run) DRY=1; shift ;;
   380	        *) usage ;;
   381	    esac
   382	done
   383	[ -n "$GPU" ] && [ -n "$COMMIT" ] || usage
   384	apply_root_override || exit 2
   385	arm_of "$ARM" || exit 2
   386	check_ceiling || exit 2
   387	[ "$MODE" != finalize ] || { [ -n "$ATTEMPT" ] && [ -n "$LOG" ] && [ -n "$CHILD_EXIT" ]; } || usage
   388	
   389	if [ "$DRY" -eq 1 ]; then STAMP='<UTC>'; else STAMP="$(date -u +%Y%m%dT%H%M%S)"; fi
   390	if [ "$MODE" = finalize ]; then OWNER=""        # recovery owns no live launch.pid
   391	elif [ "$DRY" -eq 1 ]; then OWNER='<pid>'
   392	else OWNER="$$"; fi
   393	
   394	say "EXP11_LAUNCH mode=$MODE arm=$ARM gpu=$GPU commit=$COMMIT root=$ARM_ROOT stamp=$STAMP dry_run=$DRY"
   395	say "ENV CUDA_VISIBLE_DEVICES=$GPU PYTHONHASHSEED=0 OMP_NUM_THREADS=8 XRIR_DATA_PATH=$DATA_ROOT"
   396	if [ "$DRY" -eq 0 ] && [ ! -d "$DATA_ROOT" ]; then
   397	    echo "refusing: XRIR_DATA_PATH $DATA_ROOT is not a directory" >&2
   398	    exit 2
   399	fi
   400	export XRIR_DATA_PATH="$DATA_ROOT"
   401	CHILD_EXPLORATORY=()
   402	[ "$EXPLORATORY" -eq 0 ] || CHILD_EXPLORATORY=(--exploratory)
   403	
   404	case "$MODE" in
   405	full)
   406	    preflight
   407	    # From before the child launch through promotion: a recovery on this arm is refused
   408	    # while this run owns it.
   409	    hold_arm_lock full || exit 2
   410	    attempt="$ARM_ROOT/attempt_$STAMP"
   411	    log="$RECORD/orientation_cue_fairness_${STAMP}_train_full_${ARM}.log"
   412	    say "MKDIR $attempt"
   413	    say "SINK cat >> $log"
   414	    say "PIDFILE $attempt/launch.pid"
   415	    say "CEILING ${FULL_CEILING_S}s"
   416	    child=(timeout --kill-after=60 "$FULL_CEILING_S"
   417	           "$PYTHON" tools/exp11_train.py --backbone "$ARM_BACKBONE" --save-dir "$attempt"
   418	           --num-shot 8 --max-len 9600 --lr 1e-3 --weight-decay 1e-4 --decay-epochs 3
   419	           --lr-gamma 0.1 --epochs 12 --batch-size 32 --accum-steps 2 --num-workers 12
   420	           --seed 0 --tf32 --log-interval 50 --save-every "$ARM_SAVE_EVERY"
   421	           --epoch-ckpt-every 1 --yaw-aug "$ARM_YAW" --yaw-aug-seed 0 --yaw-aug-width 512
   422	           --run-type full --approved "$APPROVED" --reviewed-commit "$COMMIT")
   423	    say "RUN nohup setsid ${child[*]}"
   424	    if [ "$DRY" -eq 1 ]; then
   425	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   426	        abort "$attempt" "$log" 'child_exit_<code>'
   427	        finalize "$attempt" "$log" '<code>' exp11_train
   428	        promote "attempt_$STAMP"
   429	        exit 0
   430	    fi
   431	    mkdir -p -- "$ARM_ROOT"
   432	    mkdir -- "$attempt"   # exclusive: a repeated stamp must not reuse an attempt
   433	    own_launch "$attempt"
   434	    mkdir -p -- "$RECORD"
   435	    : > "$log"
   436	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   437	    run_child "$attempt" "$log" "${child[@]}"
   438	    close_child "$attempt" "$log"
   439	    status="$CHILD_STATUS"
   440	    if [ "$status" -ne 0 ]; then
   441	        abort "$attempt" "$log" "child_exit_$status"
