   711	@pytest.mark.parametrize('launch_child', [False, True])
   712	def test_no_orphan_of_the_launcher_keeps_the_arm_locked(tmp_path, launch_child):
   713	    """Close review 6's boundary: the sink must not inherit the lock.
   714	
   715	    Interrupted after the sink started -- with the child not yet launched, and again
   716	    with it launched and detached -- the launcher exits 143 and the arm must be free
   717	    again at once. An orphaned sink waits on its FIFO for a writer that never comes, so
   718	    a lock it inherited would never be released at all.
   719	    """
   720	    root = tmp_path / 'xRIR_simpor_8_shot'
   721	    root.mkdir(parents=True)
   722	    status, out, err = detached_lib(lifecycle(root, launch_child), tmp_path,
   723	                                    {'EXP11_TEST_ROOTS': '1'})
   724	    assert status == 143, out[-400:] + err[-400:]
   725	    assert 'CONTINUED' not in out
   726	    pipe = root / 'attempt_20260927T000000/child.pipe'
   727	    try:
   728	        assert free(root / LOCKFILE), (
   729	            'an orphan of the launcher still holds the arm lock')
   730	    finally:
   731	        drain(pipe)
