    42	def shell(command):
    43	    """Run one shell with no GPU and normalise the machine-specific paths."""
    44	    result = subprocess.run(command, cwd=str(REPO), capture_output=True, text=True,
    45	                            env=dict(os.environ, CUDA_VISIBLE_DEVICES=''))
    46	    text = (result.stdout.replace(PYTHON, '<PYTHON>')
    47	            .replace(str(Path.home()), '<HOME>').replace(str(REPO), '<REPO>'))
    48	    return result.returncode, text, result.stderr
