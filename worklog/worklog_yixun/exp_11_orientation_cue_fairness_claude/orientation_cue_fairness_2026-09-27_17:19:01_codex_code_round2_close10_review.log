   385	        geometry=exp06_train.geometry_identity(root) if destination else None,
   386	        heldout=exp06_train.heldout_wav_identity(root) if destination else None,
   387	        approved=args.approved, reviewed_commit=args.reviewed_commit,
   388	        exploratory=args.exploratory)
   389	    prepare_args(args, model, fields, destination)
   390	    fields['effective_args'] = vars(args)

