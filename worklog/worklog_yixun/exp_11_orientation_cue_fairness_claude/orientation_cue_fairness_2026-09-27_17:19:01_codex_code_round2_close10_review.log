   191	PID_RECORD = re.compile(rb'[0-9]{1,10}\n?')
   192	
   193	
   194	def pid_record(path):
   195	    """The pid a pid file holds, or None -- the launcher's grammar, byte for byte.
   196	
   197	    A valid record is the WHOLE file: ``^[0-9]{1,10}\n?$``. Not stripped, not split, not
   198	    scanned for a first field: two readers that disagree about the bytes disagree about
   199	    whether a trainer exists (close review 9, blocker 1).
   200	    """
   201	    try:
   202	        data = Path(path).read_bytes()          # bytes: text mode would turn CRLF into LF
   203	    except OSError:
   204	        return None
   205	    return int(data.decode('ascii')) if PID_RECORD.fullmatch(data) else None
   206	
   207	
   208	def registration_complete(attempt):
   209	    """``child.pid`` holds one pid, by that grammar (the launcher's own test)."""
   210	    return pid_record(Path(attempt) / 'child.pid') is not None
