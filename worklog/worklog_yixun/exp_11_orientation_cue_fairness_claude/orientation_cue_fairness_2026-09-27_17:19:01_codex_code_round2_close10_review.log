"""Golden dry runs of exp_11's launcher and HAA pipeline (plan v3 items 10 and 12).

Every argv the two shells would issue is frozen in
``orientation_cue_fairness_results_assets/golden/``. A deliberate change regenerates the
files in the same commit; an accidental one -- a flag, a path, a run type, a cue -- fails
here. The refusals (unknown init, malformed job, unknown arm) are checked directly.
"""
import json
import os
from pathlib import Path
import subprocess
import time

import pytest

REPO = Path(__file__).resolve().parents[1]
GOLD = (REPO / 'worklog/worklog_yixun/exp_11_orientation_cue_fairness_claude'
        / 'orientation_cue_fairness_results_assets/golden')
PYTHON = '/home/yixunhu/miniconda3/envs/xRIR/bin/python'
COMMIT = 'c' * 40
LAUNCH = ['bash', 'tools/exp11_launch.sh']
PIPELINE = ['bash', 'tools/exp11_haa_pipeline.sh']
CASES = {
    'launch_full_H': LAUNCH + ['full', '--arm', 'H', '--gpu', '1',
                               '--reviewed-commit', COMMIT, '--dry-run'],
    'launch_full_I': LAUNCH + ['full', '--arm', 'I', '--gpu', '1',
                               '--reviewed-commit', COMMIT, '--dry-run'],
    'launch_probe_H': LAUNCH + ['probe', '--arm', 'H', '--gpu', '1',
                                '--reviewed-commit', COMMIT, '--dry-run'],
    'launch_smoke_H': LAUNCH + ['smoke', '--arm', 'H', '--gpu', '1',
                                '--reviewed-commit', COMMIT, '--dry-run'],
    'pipeline_simple_or_seed0': PIPELINE + ['1', 'simple_or:0', '--dry-run'],
    'pipeline_simple_or_yaw_seed1': PIPELINE + ['1', 'simple_or_yaw:1', '--dry-run'],
    'pipeline_control_adapter_seed2': PIPELINE + ['1', 'control_adapter:2', '--dry-run'],
    'pipeline_yawaug_adapter_zeroshot': PIPELINE + ['1', 'yawaug_adapter:zeroshot',
                                                    '--dry-run'],
    'pipeline_mixed_queue': PIPELINE + ['0', 'simple_or:0', 'control_adapter:zeroshot',
                                        'simple_or_yaw:2', '--dry-run'],
}


def shell(command):
    """Run one shell with no GPU and normalise the machine-specific paths."""
    result = subprocess.run(command, cwd=str(REPO), capture_output=True, text=True,
                            env=dict(os.environ, CUDA_VISIBLE_DEVICES=''))
    text = (result.stdout.replace(PYTHON, '<PYTHON>')
            .replace(str(Path.home()), '<HOME>').replace(str(REPO), '<REPO>'))
    return result.returncode, text, result.stderr


@pytest.mark.parametrize('name', sorted(CASES))
def test_golden_dry_run(name):
    status, text, stderr = shell(CASES[name])
    assert status == 0, stderr[-800:]
    golden = GOLD / (name + '.txt')
    assert golden.is_file(), 'missing golden {}'.format(golden)
    assert text == golden.read_text(), (
        'the {} dry run changed; regenerate {} in the same commit if deliberate'.format(
            name, golden.name))


def test_static_syntax():
    for script in ('tools/exp11_launch.sh', 'tools/exp11_haa_pipeline.sh'):
        assert subprocess.run(['bash', '-n', script], cwd=str(REPO)).returncode == 0


def test_the_pipeline_refuses_the_whole_queue_before_anything_runs():
    for job, message in (('cyl_or:0', 'unknown init'),          # an exp_06 arm
                         ('yawaug:0', 'unknown init'),          # an exp_09 arm
                         ('simple_or:x', 'is not a seed'),
                         ('simple_or:0:1', 'is not a seed'),
                         ('zeroshot', 'unknown job')):
        result = subprocess.run(PIPELINE + ['1', job, '--dry-run'], cwd=str(REPO),
                                capture_output=True, text=True,
                                env=dict(os.environ, CUDA_VISIBLE_DEVICES=''))
        assert result.returncode == 2, job
        assert message in result.stderr, (job, result.stderr)
        assert 'MKDIR' not in result.stdout


def test_the_launcher_refuses_an_unknown_arm_and_an_incomplete_recovery():
    for extra, status in ((['--arm', 'Z'], 2), ([], 2)):
        result = subprocess.run(
            LAUNCH + ['full', '--gpu', '1', '--reviewed-commit', COMMIT, '--dry-run'] + extra,
            cwd=str(REPO), capture_output=True, text=True,
            env=dict(os.environ, CUDA_VISIBLE_DEVICES=''))
        if extra:
            assert result.returncode == status and 'unknown arm' in result.stderr
    result = subprocess.run(LAUNCH + ['finalize', '--arm', 'H', '--gpu', '1',
                                      '--reviewed-commit', COMMIT, '--dry-run'],
                            cwd=str(REPO), capture_output=True, text=True,
                            env=dict(os.environ, CUDA_VISIBLE_DEVICES=''))
    assert result.returncode == 2 and 'usage' in result.stderr


def test_every_init_and_every_cue_appears_in_the_golden_queues():
    """Each arm's frame, cue flag and entry points are what plan section 2.2 registers."""
    heading = (GOLD / 'pipeline_simple_or_seed0.txt').read_text()
    assert 'frame=heading' in heading and '--heading-json-dir ckpt/exp06/heading' in heading
    assert '--adapter-heading-json-dir' not in heading
    adapter = (GOLD / 'pipeline_control_adapter_seed2.txt').read_text()
    assert 'frame=room' in adapter
    assert '--adapter-heading-json-dir ckpt/exp06/heading' in adapter
    assert '--heading-json-dir' not in adapter.replace('--adapter-heading-json-dir', '')
    for text in (heading, adapter):
        assert 'tools/exp11_haa_finetune.py' in text and 'tools/exp11_haa_eval.py' in text
        assert '--run-type exp11_haa_finetune' in text or 'exp11_haa_finetune' in text
        assert 'tools/exp06_haa_finetune.py' not in text
        assert 'CENSUS gpu=' in text          # the explicit exclusive-card census
        assert 'exp11_haa_job' in text
    mixed = (GOLD / 'pipeline_mixed_queue.txt').read_text()
    for init in ('simple_or', 'control_adapter', 'simple_or_yaw'):
        assert 'JOB {} '.format(init) in mixed
    assert mixed.count('CENSUS gpu=0') == 3   # one census per job, never inherited
    assert 'QUEUE_DONE gpu=0' in mixed


# --- blocker 4: the 36 h ceiling may only be tightened ------------------------------

CEILING = 129600


def launch(args, env=None):
    result = subprocess.run(LAUNCH + args, cwd=str(REPO), capture_output=True, text=True,
                            env=dict(os.environ, CUDA_VISIBLE_DEVICES='', **(env or {})))
    return result.returncode, result.stdout, result.stderr


@pytest.mark.parametrize('value', ['0', '-1', '36h', '', '129601', '1000000'])
def test_an_override_that_disables_or_loosens_the_ceiling_is_refused(value):
     1	#!/usr/bin/env bash
     2	# exp_11 launcher (plan v3 items 6 and 12). Certified invocation for a confirmatory run:
     3	#   nohup setsid tools/exp11_launch.sh full --arm H --gpu 1 --reviewed-commit <sha> \
     4	#       > <launcher.log> 2>&1 &
     5	# Recovery after a crashed launcher (the child already exited):
     6	#   tools/exp11_launch.sh finalize --arm H --gpu 1 --reviewed-commit <sha> \
     7	#       --attempt <dir> --log <child.log> --child-exit <code>
     8	# --dry-run prints every command and path (timestamps as <UTC>) and executes nothing.
     9	#
    10	# The child lifecycle -- exclusive directory, one drained pipe, the end marker, the exit
    11	# receipt -- is tools/exp06_launch.sh's and is sourced here as a library; it is shared
    12	# evidence, not an exp_11 decision, and forking it would fork the very bytes closed_log
    13	# re-validates. Both files are bound by exp_11's `launch_sh` approvals key. What this
    14	# script overrides is everything that names an experiment: the finalizer it calls
    15	# (tools/exp11_finalize.py), the approvals, the attempt roots, the record and the arms.
    16	#
    17	# Publishing one arm is serialised by an `flock` on a per-arm lock FILE. The lock is held
    18	# by a holder process leased to this launcher's life, never on a descriptor of the
    19	# launcher's own: **it vanishes within ~1 s of the launcher's exit or death and is never
    20	# inherited by the trainer or the log sink**. There is no cleanup code, no owner record
    21	# and no stale-lock concept -- nothing to clear by hand and nothing to get wrong (plan
    22	# section 11 amendment A1, close review 6).
    23	#
    24	# EXP11_LAUNCH_LIB=1 source tools/exp11_launch.sh defines the functions and returns, so
    25	# the pipeline can reuse them without a mode.
    26	set -euo pipefail
    27	cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
    28	EXP06_LAUNCH_LIB=1 source tools/exp06_launch.sh
    29	export PYTHONPATH="$PWD"
    30	
    31	RECORD=worklog/worklog_yixun/exp_11_orientation_cue_fairness_claude
    32	APPROVED_DEFAULT="$RECORD/orientation_cue_fairness_results_assets/approved_digests.json"
    33	SMOKE_DIR=ckpt/exp11/_smoke
    34	# The pretraining roots. EXP11_PRETRAIN_ROOT exists for the dry-run tests alone: it moves
    35	# the attempt roots AND the roots preflight scans for live pid files, so a real launch may
    36	# never take it. It is honoured only with EXP11_TEST_ROOTS=1 *and* --dry-run, and is
    37	# refused outright otherwise (see apply_root_override below).
    38	PRETRAIN_ROOT=ckpt/exp11/pretrain
    39	SIMPOR_ROOT="$PRETRAIN_ROOT/xRIR_simpor_8_shot"          # arm H
    40	SIMPOR_YAW_ROOT="$PRETRAIN_ROOT/xRIR_simpor_yawaug_8_shot"   # arm I
    41	HEADING_DIR="${EXP06_HEADING_DIR:-ckpt/exp06/heading}"
    42	SMOKE_FLAGS="--epochs 1 --max-train-batches 3 --max-test-batches 2 --batch-size 4 --num-workers 4 --no-save"
    43	SMOKE_ALARM_S="${EXP11_SMOKE_ALARM_S:-300}"
    44	SMOKE_MAX_GB="${EXP11_SMOKE_MAX_GB:-6}"
    45	# Plan section 7 reserves 36 h per pretraining; the child runs under that hard ceiling, so
    46	# a stalled attempt fails and is aborted instead of holding the card indefinitely. The
    47	# value goes straight to GNU timeout, where 0 means "no timeout", so an override is
    48	# validated before anything starts and may only TIGHTEN the registered ceiling.
    49	FULL_CEILING_MAX=129600
    50	FULL_CEILING_S="${EXP11_FULL_CEILING_S-$FULL_CEILING_MAX}"
    51	
    52	# The value is validated as a BOUNDED DECIMAL STRING before any arithmetic: bash's
    53	# integer comparisons error out above 2**63-1, which left the `if` false and the launch
    54	# running with an overflowing value handed to GNU timeout. Six digits is the whole
    55	# contract (129600 has six), so the numeric comparison below can never be out of range;
    56	# leading zeros are refused with everything else that is not a plain decimal.
    57	check_ceiling() {
    58	    local why="must be a plain decimal of at most 6 digits in (0, $FULL_CEILING_MAX]"
    59	    case "$FULL_CEILING_S" in
    60	        ''|*[!0-9]*|0*|???????*)
    61	            echo "refusing: EXP11_FULL_CEILING_S '$FULL_CEILING_S' $why" >&2; return 1 ;;
    62	    esac
    63	    if [ "$FULL_CEILING_S" -le 0 ] || [ "$FULL_CEILING_S" -gt "$FULL_CEILING_MAX" ]; then
    64	        echo "refusing: EXP11_FULL_CEILING_S $FULL_CEILING_S $why;" \
    65	             "an override may only tighten the 36 h ceiling" >&2
    66	        return 1
    67	    fi
    68	}
    69	
    70	# apply_root_override: EXP11_PRETRAIN_ROOT is a dry-run test affordance and nothing else.
    71	apply_root_override() {
    72	    [ -n "${EXP11_PRETRAIN_ROOT:-}" ] || return 0
    73	    if [ "${EXP11_TEST_ROOTS:-0}" != 1 ] || [ "$DRY" -ne 1 ]; then
    74	        echo "refusing: EXP11_PRETRAIN_ROOT moves the attempt roots and the roots" \
    75	             "preflight scans, so it is honoured only with EXP11_TEST_ROOTS=1 and" \
    76	             "--dry-run" >&2
    77	        return 1
    78	    fi
    79	    PRETRAIN_ROOT="$EXP11_PRETRAIN_ROOT"
    80	    SIMPOR_ROOT="$PRETRAIN_ROOT/xRIR_simpor_8_shot"
    81	    SIMPOR_YAW_ROOT="$PRETRAIN_ROOT/xRIR_simpor_yawaug_8_shot"
    82	}
    83	
    84	# check_attempt <attempt> <root> <arm>: recovery may promote only this arm's own attempt.
    85	# The basename is linked under the root --arm selects, so an attempt of the other arm
    86	# would leave a dangling or wrong `final`; the directory AND the profile its recorded
    87	# arguments select must both be the selected arm's.
    88	CHECK_ATTEMPT_PY='
    89	import json, sys
    90	from pathlib import Path
    91	from tools import exp11_recipe
    92	attempt, root, arm = sys.argv[1:4]
    93	expected = {"H": "H_RECIPE", "I": "I_RECIPE"}[arm]
    94	try:
    95	    # The path that is VALIDATED must be the path that is finalized and promoted, or an
    96	    # alias (an existing `final`, or a link from outside) would be validated here and
    97	    # promoted by its own basename - a self-referencing or dangling link under the root.
    98	    directory, base = Path(attempt).resolve(), Path(root).resolve()
    99	    if directory.parent != base:
   100	        raise ValueError("attempt {} is not an attempt of the arm {} root {}".format(
   101	            directory, arm, base))
   102	    if not directory.name.startswith("attempt_"):
   103	        raise ValueError("{} is not an attempt_<UTC> directory".format(directory))
   104	    args = json.loads((directory / "args.json").read_text())
   105	    profile = exp11_recipe.select_profile(args)
   106	    if profile != expected:
   107	        raise ValueError("attempt {} recorded the profile {}, not the {} of arm {}".format(
   108	            directory, profile, expected, arm))
   109	except (OSError, ValueError, KeyError) as error:
   110	    raise SystemExit("refusing: " + str(error))
   111	print("ATTEMPT ok {} arm={} profile={}".format(attempt, arm, expected))
   112	print("ATTEMPT canonical {}".format(directory))
   113	'
   114	
   115	# check_attempt <attempt>: sets CANONICAL_ATTEMPT to the resolved directory, which is
   116	# what finalization and promotion then use.
   117	check_attempt() {
   118	    local output
   119	    say "ATTEMPTCHECK $1 arm=$ARM root=$ARM_ROOT"
   120	    output="$(CUDA_VISIBLE_DEVICES="" "$PYTHON" -c "$CHECK_ATTEMPT_PY" "$1" "$ARM_ROOT" \
   121	              "$ARM")" || return 1
   122	    printf '%s\n' "$output"
   123	    CANONICAL_ATTEMPT="${output##*ATTEMPT canonical }"
   124	    case "$CANONICAL_ATTEMPT" in
   125	        "$ARM_ROOT"/attempt_*|/*) ;;
   126	        *) echo "refusing: no canonical attempt was resolved for $1" >&2; return 1 ;;
   127	    esac
   128	}
   129	ARM=""
   130	ARM_BACKBONE=simple_oriented
   131	ARM_YAW=0
   132	ARM_SAVE_EVERY=500
   133	
   134	usage() {
   135	    echo "usage: $0 <smoke|probe|full|finalize> --arm <H|I> --gpu <g> --reviewed-commit <sha40>" >&2
   136	    echo "       [--attempt-root <dir>] [--approved <json>] [--exploratory]" >&2
   137	    echo "       [--attempt <dir> --log <path> --child-exit <n>] [--dry-run]" >&2
   138	    echo "       finalize also takes [--replace-final]" >&2
   139	    exit 2
   140	}
   141	
   142	# arm_of <H|I>: the attempt root, augmentation and saving cadence of one pretraining arm.
   143	# H is exp_01's recipe (save_every 500); I is exp_04's, whose constraints the trainer
   144	# re-applies (--save-every 0 and no --resume).
   145	arm_of() { case "$1" in
   146	  H) ARM_ROOT="$SIMPOR_ROOT"; ARM_YAW=0; ARM_SAVE_EVERY=500;;
   147	  I) ARM_ROOT="$SIMPOR_YAW_ROOT"; ARM_YAW=1; ARM_SAVE_EVERY=0;;
   148	  *) echo "refusing: unknown arm $1 (H or I)" >&2; return 1;; esac
   149	  ARM_BACKBONE=simple_oriented; }
   150	
   151	# Every gate before a child starts, through exp_11's own finalizer: HEAD at the reviewed
   152	# commit, a tree clean outside worklog/, no live launch.pid or child.pid under either
   153	# attempt root or the smoke tree, exp_11's approvals, and -- for probe and full -- a card
   154	# with no compute apps at all.
   155	preflight() {
   156	    local extra=()
   157	    [ "${EXPLORATORY:-0}" -eq 0 ] || extra+=(--exploratory)
   158	    [ "$MODE" != smoke ] || extra+=(--min-free-gb "$SMOKE_MAX_GB")
   159	    run "$PYTHON" tools/exp11_finalize.py preflight --mode "$MODE" --gpu "$GPU" \
   160	        --reviewed-commit "$COMMIT" --attempt-root "$SIMPOR_ROOT" \
   245	    [ -n "$HOLDER_PID" ] || return 0
   246	    local parent=""
   247	    parent="$(sed -n 's/^.*) [A-Za-z] \([0-9][0-9]*\).*/\1/p' \
   248	              "/proc/$HOLDER_PID/stat" 2>/dev/null || true)"
   249	    [ "$parent" = "$$" ] && { kill -TERM "$HOLDER_PID" 2>/dev/null || true; }
   250	    wait "$HOLDER_PID" 2>/dev/null || true
   251	    HOLDER_PID=""
   252	}
   253	
   254	# --- what the lock protects is a quiet arm -------------------------------------------
   255	# The lock says "one publication at a time"; it does not say "no trainer is running".
   256	# That is this scan's job, and it has to run UNDER the lock: a scan taken before
   257	# acquisition can go stale in the window between, which is exactly how a recovery could
   258	# promote an older attempt while a newer trainer of the same arm kept writing
   259	# (close review 7, blocker 1). `kill -0` asks the kernel whether a pid still exists; it
   260	# is a probe and sends no signal.
   261	UNRESOLVED_GRACE_S="${EXP11_UNRESOLVED_GRACE_S:-120}"
   262	SCAN_REASON=""
   263	
   264	# pid_record <file>: print the pid <file> holds, or return 1. The grammar is the WHOLE
   265	# file and it is written once, here: `^[0-9]{1,10}\n?$` -- digits, at most one trailing
   266	# newline, nothing else. No leading blank, no second record, no CR, no other bytes.
   267	# Both readers below use it, so "is a trainer registered" and "is that pid alive" can
   268	# never be answered from two different readings of the same bytes (close review 9).
   269	pid_record() {
   270	    local text="" size=0
   271	    [ -f "$1" ] || return 1
   272	    size="$(wc -c < "$1" 2>/dev/null)" || return 1
   273	    case "$size" in ''|*[!0-9]*) return 1 ;; esac
   274	    [ "$size" -ge 1 ] && [ "$size" -le 11 ] || return 1
   275	    text="$(cat -- "$1" 2>/dev/null)" || return 1   # $() strips trailing newlines
   276	    case "$text" in ''|*[!0-9]*) return 1 ;; esac   # digits only, so no CR and no blank
   277	    [ "${#text}" -le 10 ] || return 1
   278	    # Exactly the digits, or the digits and ONE newline; two trailing newlines are not
   279	    # a record, and `$()` would otherwise have hidden the second.
   280	    [ "${#text}" -eq "$size" ] || [ $(( ${#text} + 1 )) -eq "$size" ] || return 1
   281	    printf '%s' "$text"
   282	}
   283	
   284	pid_alive() {  # pid_alive <file>: the pid <file> records names a living process
   285	    local pid=""
   286	    pid="$(pid_record "$1")" || return 1
   287	    kill -0 "$pid" 2>/dev/null
   288	}
   289	
   290	# registration_complete <attempt>: child.pid holds one pid, by the grammar above. The
   291	# shell creates that file by redirection before the pid reaches it, so existence alone
   292	# proves nothing; what makes a launch *registered* is a number to look for. Whether that
   293	# number is still alive is a separate question, asked by pid_alive of the same bytes.
   294	registration_complete() {
   295	    pid_record "$1/child.pid" >/dev/null
   296	}
   297	
   298	# scan_arm <arm root> [<attempt being resolved>]: 0 when every attempt of the arm is
   299	# finished and accounted for. SCAN_REASON names the first one that is not.
   300	scan_arm() {
   301	    local root="$1" resolving="${2:-}" attempt="" name="" here=""
   302	    SCAN_REASON=""
   303	    # The attempt being resolved is excluded by canonical identity, never by spelling:
   304	    # the caller's path and this glob's may name the same directory differently.
   305	    [ -z "$resolving" ] || resolving="$(realpath -- "$resolving" 2>/dev/null || printf '%s' "$resolving")"
   306	    for attempt in "$root"/attempt_*; do
   307	        [ -d "$attempt" ] || continue
   308	        name="$(basename -- "$attempt")"
   309	        here="$(realpath -- "$attempt" 2>/dev/null || printf '%s' "$attempt")"
   310	        if pid_alive "$attempt/launch.pid"; then
   311	            SCAN_REASON="$name has a live launcher (launch.pid)"; return 1; fi
   312	        if pid_alive "$attempt/child.pid"; then
   313	            SCAN_REASON="$name has a live trainer (child.pid)"; return 1; fi
   314	        if pid_alive "$attempt/train.pid"; then
   315	            SCAN_REASON="$name has a live trainer (train.pid)"; return 1; fi
   316	        [ "$here" != "$resolving" ] || continue
   317	        if [ -f "$attempt/launching" ] && ! registration_complete "$attempt"; then
   318	            SCAN_REASON="$name has an unresolved launch: a launching marker and no"\
   319	" complete child.pid, so a trainer of it may be running without having registered."\
   320	" Resolve it"\
   321	" with --resolve-unregistered $attempt once nothing of the arm is alive and the marker"\
   322	" is older than ${UNRESOLVED_GRACE_S}s"
   323	            return 1; fi
   324	    done
   325	    return 0
   326	}
   327	
   328	require_quiet_arm() {  # require_quiet_arm [<attempt being resolved>]
   329	    say "SCAN $ARM_ROOT"
   330	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   331	    scan_arm "$ARM_ROOT" "${1:-}" && return 0
   332	    echo "refusing: $SCAN_REASON" >&2
   333	    return 1
   334	}
   335	
   336	# --- the intent marker: the half-second the frozen lifecycle cannot cover -----------
   337	# `run_child` forks the detached trainer and writes child.pid only afterwards, and the
   338	# trainer needs a moment to write its own. A launcher that dies inside that window would
   339	# leave a running trainer nothing names. So the intent to launch is declared BEFORE the
   340	# fork and withdrawn once child.pid exists; a marker left behind means "a trainer of this
   341	# attempt may be running", and the arm stays closed until an operator resolves it.
   342	mark_launching() {  # mark_launching <attempt>
   343	    printf 'launcher %s\nat %s\narm %s\n' \
   344	        "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$ARM" > "$1/launching"
   345	}
   346	
   347	clear_launching() {  # clear_launching <attempt>: only once the child really is recorded
   348	    registration_complete "$1" || return 0
   349	    rm -f -- "$1/launching"
   350	}
   351	
   352	# resolve_unregistered <attempt>: an operator's explicit answer to a marker nothing can
   353	# explain any more. It can only ever abort: an attempt with no child.pid has no exit
   354	# receipt and can never be published.
   355	resolve_unregistered() {
   356	    local attempt="" root="" name="" now=0 stamp=0 age=0
   357	    # Identity is the canonical directory, never the spelling: an operator's path may be
   358	    # absolute where the root is relative, or reach the arm through a symlink.
   359	    [ -d "$1" ] || { echo "refusing: $1 is not a directory" >&2; return 1; }
   360	    attempt="$(realpath -- "$1")" || return 1
   361	    root="$(realpath -- "$ARM_ROOT")" || return 1
   362	    name="$(basename -- "$attempt")"
   363	    # The lock and the scan are this arm's, so the resolution reaches no further.
   364	    if [ "$(dirname -- "$attempt")" != "$root" ]; then
   365	        echo "refusing: $attempt is not an attempt of the selected arm ($root); this" \
   366	             "invocation locked and scanned that arm and no other" >&2
   367	        return 1
   368	    fi
   369	    case "$name" in
   370	        attempt_*) case "${name#attempt_}" in ''|*[!0-9T]*)
   371	            echo "refusing: $name is not an attempt directory of this arm" >&2
   372	            return 1 ;; esac ;;
   373	        *) echo "refusing: $name is not an attempt directory of this arm" >&2
   374	           return 1 ;;
   375	    esac
   376	    [ -f "$attempt/launching" ] || {
   377	        echo "refusing: $attempt has no launching marker; nothing is unresolved" >&2
   378	        return 1; }
   379	    if registration_complete "$attempt"; then
   380	        echo "refusing: $attempt recorded a child; it is a finished or running launch," \
   381	             "not an unresolved one" >&2
   382	        return 1
   383	    fi
   384	    # The REGISTRATION lock, distinct from the publication lock this invocation already
   385	    # holds: a full-mode launcher holds the publication lock for its child's whole run,
   386	    # so a trainer could never take that one. This one is held only across a
   387	    # registration and across this resolution -- exactly the pair that must not
   388	    # interleave, because the trainer's checks and its write straddle the rename below
   389	    # (close review 9, blocker 2). The recovery and full-mode scans do not take it: an
   390	    # in-flight registration is already covered there by the launching marker or by a
   391	    # complete live child.pid, and a recovery that had to queue behind every trainer
   392	    # would be a new way to stall an arm.
   393	    local registration="$root/.registration.lock" reg_fd=""
   394	    : >> "$registration" 2>/dev/null || true
   395	    exec {reg_fd}>>"$registration" || {
   396	        echo "refusing: cannot open the registration lock $registration" >&2; return 1; }
   397	    if ! flock -n "$reg_fd"; then
   398	        exec {reg_fd}>&-
   399	        echo "refusing: a registration in progress holds $registration; a trainer is" \
   400	             "between its checks and its write, so nothing of this arm may be retired" >&2
   401	        return 1
   402	    fi
   403	    scan_arm "$ARM_ROOT" "$attempt" || {
   404	        exec {reg_fd}>&-
   405	        echo "refusing: $SCAN_REASON" >&2; return 1; }
   406	    now="$(date -u +%s)"
   407	    stamp="$(date -u -r "$attempt/launching" +%s 2>/dev/null || printf '%s' "$now")"
   408	    age=$((now - stamp))
   409	    if [ "$age" -lt "$UNRESOLVED_GRACE_S" ]; then
   410	        exec {reg_fd}>&-
   411	        echo "refusing: $attempt/launching is ${age}s old and a trainer that has not" \
   412	             "registered yet is still possible; wait until it is ${UNRESOLVED_GRACE_S}s" >&2
   413	        return 1
   414	    fi
   415	    say "TOMBSTONE $root/$name.resolved"
   416	    say "ABORT $attempt -> ${attempt}_ABORTED_unregistered"
   417	    if [ "$DRY" -eq 0 ]; then
   418	        # Written BEFORE the rename, and never removed by anything here: a trainer that
   419	        # wakes after this can no longer find its directory, and if it somehow can, this
   420	        # is what tells it the launch was answered. The scan ignores it -- it is a
   421	        # record, not a claim (close review 8, blocker 2).
   422	        printf 'resolved-by %s\nat %s\nreason unregistered launch: no complete child.pid\n' \
   423	            "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" > "$root/$name.resolved"
   424	        mv -- "$attempt" "${attempt}_ABORTED_unregistered"
   425	        # The marker has been answered; leaving it would close the arm for good, since
   426	        # the scan reads every attempt_* directory, retired ones included.
   427	        rm -f -- "${attempt}_ABORTED_unregistered/launching"
   428	    fi
   429	    exec {reg_fd}>&-   # the whole critical section is done: scan, tombstone, rename
   430	    say "RESOLVED $attempt registered no child and nothing of it is alive;" \
   431	        "it can never be published"
   432	}
   433	
   434	# A deterministic pause, so a regression can hold this invocation open between two
   435	# launchers. It exists only inside the test roots and costs a real launch nothing.
   436	scan_barrier() {
   437	    local file="${EXP11_SCAN_BARRIER:-}"
   438	    [ -n "$file" ] && [ "${EXP11_TEST_ROOTS:-0}" = 1 ] || return 0
   439	    : > "$file.at"
   440	    while [ -e "$file" ]; do sleep 0.05; done
   441	}
   442	
   443	# A signal handler must END this invocation. A cleanup-only handler returns, and bash
   444	# resumes -- which would let finalization and promotion continue after the interruption.
   445	# The lock needs no releasing here: the EXIT trap ends the holder, and if anything went
   446	# wrong with that the lease ends it within a second anyway.
   447	on_signal() {  # on_signal <NAME> <number>
   448	    INTERRUPTED=1
   449	    say "SIGNAL $1"
   450	    exit $((128 + $2))
   451	}
   452	
   453	# Checked before every protected step, so nothing runs after a handler has fired even if
