   212	
   213	REGISTRATION_LOCK = '.registration.lock'
   214	REGISTRATION_WAIT_S = 60
   215	
   216	
   217	def registration_lock_path(save_dir):
   218	    """The arm root's registration lock -- one per arm, beside its attempts."""
   219	    return Path(save_dir).parent / REGISTRATION_LOCK
   220	
   221	
   222	@contextlib.contextmanager
   223	def registration_lock(save_dir, wait_seconds=REGISTRATION_WAIT_S):
   224	    """Hold the arm's REGISTRATION lock, or give up after ``wait_seconds``.
   225	
   226	    This is not the publication lock: a full-mode launcher holds that one for its
   227	    child's whole run, so a trainer could never take it. This one is held only across a
   228	    registration and across a resolution, which is exactly the pair that must not
   229	    interleave (close review 9, blocker 2). The wait is blocking but bounded, because a
   230	    resolution is short and a trainer that waits forever is a trainer nothing can end.
   231	    """
   232	    path = registration_lock_path(save_dir)
   233	    try:
   234	        handle = open(str(path), 'a')
   235	    except OSError as error:
   236	        refuse('cannot open the registration lock {}: {}'.format(path, error))
   237	    try:
   238	        deadline = time.time() + wait_seconds
   239	        while True:
   240	            try:
   241	                fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
   242	                break
   243	            except OSError:
   244	                if time.time() >= deadline:
   245	                    refuse('the registration lock {} was held for more than {}s; '
   246	                           'another registration or a resolution is in progress'
   247	                           .format(path, wait_seconds))
   248	                time.sleep(0.05)
   249	        yield
   250	    finally:
   251	        handle.close()          # closing the descriptor releases the lock
   252	
   253	
   254	def refuse(reason):
   255	    print('refusing: ' + reason, file=sys.stderr, flush=True)
   256	    raise SystemExit(RESOLVED_EXIT)
   257	
   258	
   259	def register_trainer(save_dir, no_save=False, arm_root=None,
   260	                     wait_seconds=REGISTRATION_WAIT_S):
   261	    """Name this process in its own run directory, after parsing and before admission.
   262	
   263	    The launcher's ``child.pid`` is written by the frozen lifecycle only *after* it has
   264	    forked this process, so a launcher that dies in between leaves a trainer nothing in
   265	    the arm can see (close review 7, blocker 2). This file is the trainer's own answer.
   266	
   267	    It is also where this trainer finds out whether its launch is still a launch. A
   268	    delayed trainer can wake long after an operator resolved the attempt as unregistered
   269	    -- the marker's age proved nothing about it -- so the answer has to be in the state
   270	    of the directory, and this process **fails closed** (close review 8, blocker 2):
   271	
   272	    * the save-dir is gone: the launcher creates it, the trainer never does, so its
   273	      absence means the launch it belongs to is over;
   274	    * a ``<attempt>.resolved`` tombstone stands beside it: that launch was answered and
   275	      retired, permanently;
   276	    * neither ``launching`` nor a complete ``child.pid`` is there: from the fork onward
   277	      an ordinary launch always carries one of them.
   278	
   279	    All of that, and the write itself, happen under the arm's REGISTRATION lock, so a
   280	    resolution cannot rename the directory between the checks and the write (close
   281	    review 9, blocker 2); the write is a temp file and one ``os.replace``, so no reader
   282	    ever sees half a pid.
   283	
   284	    ``--no-save`` runs are diagnostics that no scan reads; they write no sidecars, take
   285	    no lock, and only the tombstone can refuse them.
   286	    """
   287	    directory = Path(save_dir)
   288	    tombstone = directory.parent / (directory.name + '.resolved')
   289	    if no_save:                       # a diagnostic no scan reads: only a tombstone speaks
   290	        if tombstone.is_file():
   291	            refuse('{} was resolved as an unregistered launch and retired; this trainer '
   292	                   'has nothing to run in'.format(directory))
   293	        return None
   294	    root = Path(arm_root) if arm_root is not None else directory.parent
   295	    with registration_lock(directory, wait_seconds):
   296	        # Everything below happens under the lock, so a resolution cannot rename this
   297	        # directory between the checks and the write.
   298	        if not directory.is_dir():
   299	            refuse('{} does not exist; the launcher creates the attempt and this trainer '
   300	                   'never does'.format(directory))
   301	        if directory.resolve().parent != root.resolve():
   302	            refuse('{} is not an attempt of {}; this trainer registers only in the arm '
   303	                   'whose lock it holds'.format(directory, root))
   304	        if tombstone.is_file():
   305	            refuse('{} was resolved as an unregistered launch and retired; this trainer '
   306	                   'has nothing to run in'.format(directory))
   307	        if not (directory / 'launching').is_file() and not registration_complete(directory):
   308	            refuse('{} carries no launch record -- no launching marker and no complete '
   309	                   'child.pid -- so no launch of it is in progress'.format(directory))
   310	        path = directory / 'train.pid'
   311	        # Atomic: a reader sees the old file or the whole new one, never a partial pid.
   312	        temporary = directory / ('train.pid.{}.tmp'.format(os.getpid()))
   313	        temporary.write_text('{}\n'.format(os.getpid()))
   314	        os.replace(str(temporary), str(path))
   315	    return path
   316	
   317	
   318	def exit_code(exit_request):
   319	    """``raise SystemExit`` carries None, which is status 0, not 1."""
   320	    code = exit_request.code
   321	    if code is None:
   322	        return 0
   323	    return code if isinstance(code, int) else 1
   324	
   325	
   326	def record_trainer_exit(path, code):
   327	    """Say how this trainer left, on every path it controls."""
   328	    if path is None:
   329	        return
   330	    try:
   331	        with open(str(path.parent / 'train.exit'), 'a') as stream:
   332	            stream.write('train.exit {}\n'.format(code))
   333	    except OSError:                       # a vanished run directory is not the trainer's
   334	        pass                              # problem to report; the scan reads the pid file
   335	
   336	
   337	def main(argv=None):
   338	    """Register, run, and record how it ended -- whatever ends it."""
   339	    args = parse_args(argv)
   340	    registration = register_trainer(args.save_dir, no_save=args.no_save)
   341	    code = 0
   342	    try:
   343	        run(list(sys.argv[1:] if argv is None else argv), check_admission(args))
   344	    except SystemExit as exit_request:
   345	        code = exit_code(exit_request)
   346	        raise
   347	    except BaseException:
   348	        code = 'exception'
   349	        raise
   350	    finally:
   351	        record_trainer_exit(registration, code)
   352	
   353	
   354	def run(command, args):
   355	    """The trainer's main, step for step, with the exp_11 registry and provenance."""
   356	    trainer.seed_everything(args.seed)
   357	    torch.backends.cuda.matmul.allow_tf32 = args.tf32
   358	    torch.backends.cudnn.allow_tf32 = args.tf32
   359	
   360	    train_dataset = xRIR_Dataset(split='train', max_len=args.max_len, num_shot=args.num_shot)
   361	    test_dataset = xRIR_Dataset(split='test', max_len=args.max_len, num_shot=args.num_shot)
   362	    if args.test_subset and args.test_subset < len(test_dataset):
   363	        idx = np.random.RandomState(args.seed).permutation(len(test_dataset))[: args.test_subset]
   364	        test_dataset = Subset(test_dataset, sorted(idx.tolist()))
   365	    print(f'train samples: {len(train_dataset)}  test samples: {len(test_dataset)}', flush=True)
   366	
   367	    loader_kwargs = dict(num_workers=args.num_workers, pin_memory=True,
   368	                         worker_init_fn=trainer.seed_worker,
   369	                         persistent_workers=args.num_workers > 0)
   370	    train_loader = DataLoader(train_dataset, shuffle=True, batch_size=args.batch_size,
   371	                              **loader_kwargs)
   372	    test_loader = DataLoader(test_dataset, shuffle=False, batch_size=args.batch_size,
   373	                             **loader_kwargs)
   374	    args.train_batches_per_epoch = len(train_loader)
   375	    check_counter(args, args.train_batches_per_epoch)
   376	    args.env = {key: os.environ.get(key) for key in ENV_KEYS}
   377	    model = build_model_exp11(args).cuda()
   378	
   379	    destination = args.provenance_out if args.no_save else os.path.join(args.save_dir,
