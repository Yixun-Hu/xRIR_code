   314	# drop_arm_lock: end our own holder, so the ordinary path releases at once instead of
   315	# waiting out the lease. Every other path -- a signal, a crash, a kill -9 -- is covered
   316	# by the lease itself, which is why this needs no error handling of its own. A recorded
   317	# pid is not a licence to signal it: if that holder is already gone the number belongs to
   318	# whoever the kernel gave it to next, so nothing is sent unless the process is still this
   319	# shell's child.
   320	drop_arm_lock() {
   321	    [ -n "$HOLDER_PID" ] || return 0
   322	    local parent=""
   323	    parent="$(sed -n 's/^.*) [A-Za-z] \([0-9][0-9]*\).*/\1/p' \
   324	              "/proc/$HOLDER_PID/stat" 2>/dev/null || true)"
   325	    [ "$parent" = "$$" ] && { kill -TERM "$HOLDER_PID" 2>/dev/null || true; }
   326	    wait "$HOLDER_PID" 2>/dev/null || true
   327	    HOLDER_PID=""
   328	}
