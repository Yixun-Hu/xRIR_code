   218	# arm_of <H|I>: the attempt root, augmentation and saving cadence of one pretraining arm.
   219	# H is exp_01's recipe (save_every 500); I is exp_04's, whose constraints the trainer
   220	# re-applies (--save-every 0 and no --resume).
   275	# death**, on every path including a signal and SIGKILL, and is never inherited by the
   276	# trainer or the log sink. The attempt is non-blocking: it refuses at once,
   277	# never waits.
   278	LOCK_FILE=""
   279	HOLDER_PID=""
   280	
   281	hold_arm_lock() {  # hold_arm_lock <mode>
   282	    LOCK_FILE="$ARM_ROOT/.publish.lock"
   283	    say "LOCK $LOCK_FILE"
   284	    # A dry run touches nothing outside the test roots, so the lock is real exactly
   285	    # where the tests exercise it and announced everywhere else.
   286	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   287	    mkdir -p -- "$ARM_ROOT" || return 1
   288	    local verdict="" pid="" out=""
   289	    # `exec` inside the substitution makes the holder a direct child of this shell, so
   290	    # its lease is this shell's pid. The read end is closed the moment the verdict is in,
   291	    # so no descriptor of ours reaches the sink or the child either.
   292	    exec {out}< <(exec "$PYTHON" tools/exp11_lock_holder.py "$LOCK_FILE" $$)
   293	    read -r -t 30 verdict pid <&"$out" || true
   294	    exec {out}<&-
   295	    if [ "$verdict" = refused ]; then
   296	        echo "refusing: $LOCK_FILE is held by another invocation publishing this arm;" \
   297	             "one publication per arm at a time. Its holder ends with that invocation," \
   298	             "so there is nothing to clear by hand" >&2
   299	        return 1
   300	    fi
   301	    if [ "$verdict" != acquired ] || [ -z "$pid" ]; then
   302	        # Not someone else's lock: the holder never reported one. Say which it is.
   303	        echo "refusing: the lock holder for $LOCK_FILE did not start (no verdict);" \
   304	             "nothing was published" >&2
   305	        return 1
   306	    fi
   307	    HOLDER_PID="$pid"
   308	    trap 'on_signal INT 2' INT
   309	    trap 'on_signal TERM 15' TERM
   310	    trap 'drop_arm_lock; rm -rf -- "$EXP11_TEMPDIR"' EXIT
   311	    say "LOCKED $LOCK_FILE mode=$1"
   312	}
