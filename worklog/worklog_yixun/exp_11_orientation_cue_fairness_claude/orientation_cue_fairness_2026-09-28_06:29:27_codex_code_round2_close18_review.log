   678	        fi
   679	        if [ "$marker" -eq 0 ] &&
   680	           { [ "$recorded" -ne 0 ] || [ "$finished" -ne 0 ]; }; then
   681	            SCAN_REASON="$name has an unresolved launch: a launching marker and no"\
   682	" finished trainer (train.pid and train.exit), so a trainer of it may be running or may"\
   683	" have died unrecorded -- child.pid names the timeout wrapper, not the trainer."\
   684	" Resolve it"\
   685	" with --resolve-unregistered $attempt once nothing of the arm is alive and the marker"\
   686	" is older than ${UNRESOLVED_GRACE_S}s"
