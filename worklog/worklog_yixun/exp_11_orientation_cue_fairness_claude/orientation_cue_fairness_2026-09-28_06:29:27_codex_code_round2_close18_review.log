   612	# scan_arm <arm root> [<attempt being resolved>]: 0 when every attempt of the arm is
   613	# finished and accounted for, 1 when one is not (SCAN_REASON says which), 2 when the
   614	# reader failed and no answer exists. A broken reader closes the arm to every automated
   615	# decision; it never opens it (close review 11).
   616	scan_arm() {
   617	    local root="$1" resolving="${2:-}" attempt="" name="" listing="" mode="" excluded=0
   618	    local -a attempts=()
   619	    SCAN_REASON=""
   620	    listing="$(mktemp "$EXP11_TEMPDIR/attempts.XXXXXX")" || {
   621	        SCAN_REASON="liveness unknown: cannot create a listing file for $root"
   622	        return "$READER_UNKNOWN"; }
   623	    if ! list_attempts "$root" "$listing"; then
   624	        rm -f -- "$listing"
   625	        SCAN_REASON="liveness unknown: the arm root cannot be enumerated ($root); an"\
   626	" attempt nobody can see is not an attempt that is not there, and nothing of this arm is"\
   627	" scanned, retired or published on that"
   628	        return "$READER_UNKNOWN"
   629	    fi
   630	    # -d '' is the NUL delimiter: an attempt name may hold anything but a NUL.
   631	    while IFS= read -r -d '' attempt; do attempts+=("$attempt"); done < "$listing"
   632	    rm -f -- "$listing"
