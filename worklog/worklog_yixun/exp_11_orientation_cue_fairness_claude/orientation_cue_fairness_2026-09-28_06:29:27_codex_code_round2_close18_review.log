   169	# check_attempt <attempt>: sets CANONICAL_ATTEMPT to the resolved directory, which is
   170	# what finalization and promotion then use.
   171	check_attempt() {
   172	    local output name="" status=0
   173	    say "ATTEMPTCHECK $1 arm=$ARM root=$ARM_ROOT"
   174	    output="$(CUDA_VISIBLE_DEVICES="" "$PYTHON" -c "$CHECK_ATTEMPT_PY" "$1" "$ARM_ROOT" \
   175	              "$ARM")" || return 1
   176	    printf '%s\n' "$output"
   177	    CANONICAL_ATTEMPT="${output##*ATTEMPT canonical }"
   178	    case "$CANONICAL_ATTEMPT" in
   179	        /*) ;;
   180	        *) echo "refusing: no canonical attempt was resolved for $1" >&2; return 1 ;;
   181	    esac
   182	    # The name, from the slash-stripped basename, and the containment as an IDENTITY
   183	    # question -- not as a prefix of two strings (plan §11 A2). The directory that was
   184	    # validated above is the one asked about here, and the one finalized and promoted.
   185	    name="${CANONICAL_ATTEMPT%/}"
   186	    name="${name##*/}"
   187	    case "$name" in
   188	        attempt_*) case "${name#attempt_}" in ''|*[!0-9T]*)
   189	            echo "refusing: $name is not an attempt_<UTC> directory of this arm" >&2
   190	            return 1 ;; esac ;;
   191	        *) echo "refusing: $name is not an attempt_<UTC> directory of this arm" >&2
   192	           return 1 ;;
   193	    esac
   194	    same_parent "$CANONICAL_ATTEMPT" "$ARM_ROOT" || status=$?
   195	    if [ "$status" -eq "$READER_UNKNOWN" ]; then
   196	        echo "refusing: whether $CANONICAL_ATTEMPT is an attempt of $ARM_ROOT cannot be" \
   197	             "established" >&2
   198	        return 1
   199	    fi
   200	    if [ "$status" -ne 0 ]; then
   201	        echo "refusing: $CANONICAL_ATTEMPT is not an attempt of $ARM_ROOT" >&2
   202	        return 1
   203	    fi
   204	}
