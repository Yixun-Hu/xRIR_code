   634	        # `-d` answers "no" both for a name that is not a directory and for one nobody
   635	        # was allowed to look at; only a stat that SUCCEEDED classifies (close review 13).
   636	        mode="$(stat -L -c %f -- "$attempt" 2>/dev/null)" || {
   637	            SCAN_REASON="liveness unknown: $attempt is in this arm and cannot be"\
   638	" inspected, so what it holds cannot be known"
   639	            return "$READER_UNKNOWN"; }
   640	        case "$mode" in ''|*[!0-9a-fA-F]*)
   641	            SCAN_REASON="liveness unknown: $attempt has no readable file mode"
   642	            return "$READER_UNKNOWN" ;;
   643	        esac
   644	        [ $(( 0x$mode & 0xF000 )) -eq $(( 0x4000 )) ] || continue   # not a directory
   645	        name="$(basename -- "$attempt")"
   646	
   647	        probe_live "$attempt/launch.pid" "$name has a live launcher (launch.pid)" || return $?
   648	        probe_live "$attempt/child.pid" "$name has a live trainer (child.pid)" || return $?
   649	        probe_live "$attempt/train.pid" "$name has a live trainer (train.pid)" || return $?
   650	        # The attempt being resolved is excluded by IDENTITY, never by spelling: the
   651	        # caller's path and this listing's may name one directory differently, and an
   652	        # identity nobody can establish excludes nothing (plan §11 A2).
