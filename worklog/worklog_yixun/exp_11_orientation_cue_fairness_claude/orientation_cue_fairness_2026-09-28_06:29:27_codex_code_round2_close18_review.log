    for spelling in ('{root}//{name}', '{root}/./{name}', '{root}/{name}/'):
        result = lib('ARM_ROOT={root}\nDRY=1\nARM=H\nstatus=0\n'
                     'already_published {path} || status=$?\necho "STATUS $status"\n'
