exec
/bin/bash -lc "sed -n '2120,2570p' tests/test_exp11_shell.py; rg -n '"'^def (lib|registered_live_attempt|resolve_with_reader|path_reader|path_verdict|unresolved_attempt)'"' tests/test_exp11_shell.py; cat tools/exp11_pathprobe.py; sed -n '1050,1210p' tools/exp11_launch.sh" in /home/yixunhu/codespace/xRIR_code_wt
