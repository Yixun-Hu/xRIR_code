   373	# probe_verdict <probe|link> <path>: run the path probe and print the one line it
   374	# answered, or fail. Failing means UNKNOWN to every caller.
   375	probe_verdict() {
   376	    local out="" line="" status=0 question="$1"
   377	    shift
   378	    out="$(mktemp "$EXP11_TEMPDIR/probe.XXXXXX")" || return 1
   379	    timeout --kill-after=5 "$READER_TIMEOUT_S" \
   380	        "$PYTHON" -m tools.exp11_pathprobe "$question" "$@" > "$out" 2>/dev/null || status=$?
   381	    if [ "$status" -ne 0 ]; then rm -f -- "$out"; return 1; fi
   382	    line="$(one_line "$out")" || { rm -f -- "$out"; return 1; }
   383	    rm -f -- "$out"
   384	    printf '%s\n' "$line"
   385	}
