   660	            fi
   661	            [ "$excluded" -ne 0 ] || continue
   662	        fi
   663	        # `child.pid` is the WRAPPER's (GNU timeout), not the trainer's, so a complete
   664	        # and dead one accounts for nothing: only train.pid names the trainer and only
   665	        # train.exit says it finished (close review 10, blocker 2). Each of the three is
   666	        # a three-state question: a marker we could not look at closes the arm, because
   667	        # the alternative is closing our eyes and calling it quiet (close review 14).
