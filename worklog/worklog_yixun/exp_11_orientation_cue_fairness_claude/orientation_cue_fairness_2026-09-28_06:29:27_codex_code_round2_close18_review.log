   387	# --- three states for every path this launcher asks about (close review 14) ----------
   388	# `[ -f x ]` answers "no" for a file that is not there AND for one nobody was allowed to
   389	# look at, and every lifecycle guard that used it turned the second into the first. Bash
   390	# cannot do better on its own: `stat` carries no errno, so ENAMETOOLONG, EIO and an ACL
   391	# that hides a name all come back the same way (close review 15). The classification
   392	# therefore comes from tools/exp11_pathprobe.py, and what crosses back is one verdict
   393	# line, validated here byte for byte -- exactly as the pid reader's verdicts are.
   394	#
   395	# A verdict carries a keyword and, for `present`, a mode -- and nothing else (plan §11
   396	# amendment A2). Three close reviews running found holes in the grammar of a path field;
   397	# a protocol with no paths in it has no such grammar. What used to be "compare the path
   398	# the probe returned with this one" is now an identity QUESTION, answered in Python by
   399	# device and inode.
   400	#
   575	
   576	# probe_live <pid file> <what is alive>: 0 nothing found, 1 alive, 2 unknown. The last
   577	# two set SCAN_REASON and must be propagated unchanged -- an unknown liveness is not a
   578	# quiet arm, it is no answer at all.
   579	probe_live() {
   580	    local status=0
   581	    pid_alive "$1" || status=$?
   582	    case "$status" in
   583	        0) SCAN_REASON="$2"; return 1 ;;
   584	        "$READER_UNKNOWN")
   585	            SCAN_REASON="liveness unknown: pid reader failed on $1. Nothing is scanned,"\
   586	" retired or published on an answer nobody gave"
   587	            return "$READER_UNKNOWN" ;;
   588	    esac
   589	    return 0
   590	}
   591	
   592	# list_attempts <arm root> <listing file>: 0 only when the root really was ENUMERATED,
   593	# the listing then holding its attempt_* entries NUL-separated. A directory with mode
   594	# 0300 is searchable and writable but NOT listable: every known pathname under it still
   595	# works -- both lock files open, `stat` answers, the holder starts -- while a glob over
   596	# it silently expands to nothing. That read as "this arm has no attempts", and a
   597	# resolution retired the attempt of a registered, running trainer (close review 13). A
   598	# successful stat of a name we already knew is never evidence that we saw the directory.
   599	list_attempts() {
   600	    local root="$1" out="$2" canonical=""
   601	    # The DIRECTORY the root denotes, not the name it was given by: `-d`, `-r` and `-x`
   602	    # all follow a symlink, but `find -P` does not descend one handed to it as a
   603	    # starting point -- it returned an empty listing and success for an arm with a live
   604	    # trainer in it (close review 14, blocker 1). `realpath -e` is checked: a root that
   605	    # cannot be resolved is not an empty arm.
   606	    canonical="$(realpath -e -- "$root" 2>/dev/null)" || return 1
   607	    [ -d "$canonical" ] || return 1
   608	    [ -r "$canonical" ] && [ -x "$canonical" ] || return 1   # listing needs read AND search
   609	    find "$canonical" -mindepth 1 -maxdepth 1 -name 'attempt_*' -print0 > "$out" 2>/dev/null
   610	}
