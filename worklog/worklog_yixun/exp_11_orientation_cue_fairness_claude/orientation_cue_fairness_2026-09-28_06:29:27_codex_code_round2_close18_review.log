   138	# check_attempt <attempt> <root> <arm>: recovery may promote only this arm's own attempt.
   139	# The basename is linked under the root --arm selects, so an attempt of the other arm
   140	# would leave a dangling or wrong `final`; the directory AND the profile its recorded
   141	# arguments select must both be the selected arm's.
   142	CHECK_ATTEMPT_PY='
   143	import json, sys
   144	from pathlib import Path
   145	from tools import exp11_recipe
   146	attempt, root, arm = sys.argv[1:4]
   147	expected = {"H": "H_RECIPE", "I": "I_RECIPE"}[arm]
   148	try:
   149	    # The path that is VALIDATED must be the path that is finalized and promoted, or an
   150	    # alias (an existing `final`, or a link from outside) would be validated here and
   151	    # promoted by its own basename - a self-referencing or dangling link under the root.
   152	    directory, base = Path(attempt).resolve(), Path(root).resolve()
   153	    if directory.parent != base:
   154	        raise ValueError("attempt {} is not an attempt of the arm {} root {}".format(
   155	            directory, arm, base))
   156	    if not directory.name.startswith("attempt_"):
   157	        raise ValueError("{} is not an attempt_<UTC> directory".format(directory))
   158	    args = json.loads((directory / "args.json").read_text())
   159	    profile = exp11_recipe.select_profile(args)
   160	    if profile != expected:
   161	        raise ValueError("attempt {} recorded the profile {}, not the {} of arm {}".format(
   162	            directory, profile, expected, arm))
   163	except (OSError, ValueError, KeyError) as error:
   164	    raise SystemExit("refusing: " + str(error))
   165	print("ATTEMPT ok {} arm={} profile={}".format(attempt, arm, expected))
   166	print("ATTEMPT canonical {}".format(directory))
   167	'
