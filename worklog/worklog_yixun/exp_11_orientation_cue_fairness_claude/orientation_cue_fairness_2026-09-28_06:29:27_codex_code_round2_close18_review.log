   673	           [ "$finished" -eq "$READER_UNKNOWN" ]; then
   674	            SCAN_REASON="liveness unknown: $name has a launching marker, a train.pid or a"\
   675	" train.exit that cannot be inspected, so whether a trainer of it is accounted for cannot"\
   676	" be known"
