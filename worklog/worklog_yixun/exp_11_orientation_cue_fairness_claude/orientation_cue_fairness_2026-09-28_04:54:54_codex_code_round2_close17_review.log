def pid_of(pidfile):
    """The pid in a registration file, if it still names a living process."""
    try:
        pid = int(pidfile.read_text().split()[0])
    except (OSError, ValueError, IndexError):
        return None
    try:
        os.kill(pid, 0)          # a probe, never a signal: signal 0 delivers nothing
    except OSError:
        return None

