   441	# link (no name, or a name that is not one) | 2 it is there and cannot be resolved, or
   442	# nobody could look. `readlink -f` answered "nothing" for the last two alike.
   443	probe_link_target() {
   444	    local line=""
   445	    line="$(probe_verdict link "$1")" || return "$READER_UNKNOWN"
