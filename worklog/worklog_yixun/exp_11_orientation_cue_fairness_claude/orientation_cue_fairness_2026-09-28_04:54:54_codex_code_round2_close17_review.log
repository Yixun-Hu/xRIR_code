   431	# the name is something else) | 2 nobody could say.
   432	file_present() {
   433	    local status=0
   434	    probe_path "$1" || status=$?
   435	    [ "$status" -ne "$READER_UNKNOWN" ] || return "$READER_UNKNOWN"
