   329	# shell creates that file by redirection before the pid reaches it, so existence alone
   330	# proves nothing; what makes a launch *registered* is a number to look for. Whether that
   331	# number is still alive is a separate question, asked by pid_alive of the same bytes.
   332	# 0 complete | 1 not complete | 2 unknown -- the unknown is never folded into "not".
   333	registration_complete() {
   334	    pid_record "$1/child.pid" >/dev/null
   335	}
