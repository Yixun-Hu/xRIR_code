   260	# drop_arm_lock: end our own holder, so the ordinary path releases at once instead of
   261	# waiting out the lease. Every other path -- a signal, a crash, a kill -9 -- is covered
   262	# by the lease itself, which is why this needs no error handling of its own. A recorded
   263	# pid is not a licence to signal it: if that holder is already gone the number belongs to
   264	# whoever the kernel gave it to next, so nothing is sent unless the process is still this
   265	# shell's child.
   266	drop_arm_lock() {
   267	    [ -n "$HOLDER_PID" ] || return 0
   268	    local parent=""
   269	    parent="$(sed -n 's/^.*) [A-Za-z] \([0-9][0-9]*\).*/\1/p' \
   270	              "/proc/$HOLDER_PID/stat" 2>/dev/null || true)"
   271	    [ "$parent" = "$$" ] && { kill -TERM "$HOLDER_PID" 2>/dev/null || true; }
   272	    wait "$HOLDER_PID" 2>/dev/null || true
   273	    HOLDER_PID=""
   274	}
   275	
   276	# --- what the lock protects is a quiet arm -------------------------------------------
   277	# The lock says "one publication at a time"; it does not say "no trainer is running".
   278	# That is this scan's job, and it has to run UNDER the lock: a scan taken before
   279	# acquisition can go stale in the window between, which is exactly how a recovery could
   280	# promote an older attempt while a newer trainer of the same arm kept writing
   281	# (close review 7, blocker 1). `kill -0` asks the kernel whether a pid still exists; it
   282	# is a probe and sends no signal.
   283	UNRESOLVED_GRACE_S="${EXP11_UNRESOLVED_GRACE_S:-120}"
   284	SCAN_REASON=""
   285	NEWLINE=$'\n'   # a real newline: a verdict that is two lines is not a verdict
   380	scan_arm() {
   381	    local root="$1" resolving="${2:-}" attempt="" name="" here=""
   382	    SCAN_REASON=""
   383	    # The attempt being resolved is excluded by canonical identity, never by spelling:
   384	    # the caller's path and this glob's may name the same directory differently.
   385	    [ -z "$resolving" ] || resolving="$(realpath -- "$resolving" 2>/dev/null || printf '%s' "$resolving")"
   386	    for attempt in "$root"/attempt_*; do
   387	        [ -d "$attempt" ] || continue
   388	        name="$(basename -- "$attempt")"
   389	        here="$(realpath -- "$attempt" 2>/dev/null || printf '%s' "$attempt")"
   390	        probe_live "$attempt/launch.pid" "$name has a live launcher (launch.pid)" || return $?
   391	        probe_live "$attempt/child.pid" "$name has a live trainer (child.pid)" || return $?
   392	        probe_live "$attempt/train.pid" "$name has a live trainer (train.pid)" || return $?
   393	        [ "$here" != "$resolving" ] || continue
   394	        # `child.pid` is the WRAPPER's (GNU timeout), not the trainer's, so a complete
   395	        # and dead one accounts for nothing: only train.pid names the trainer and only
   396	        # train.exit says it finished (close review 10, blocker 2).
   397	        if [ -f "$attempt/launching" ] &&
   398	           { [ ! -f "$attempt/train.pid" ] || [ ! -f "$attempt/train.exit" ]; }; then
   399	            SCAN_REASON="$name has an unresolved launch: a launching marker and no"\
   400	" finished trainer (train.pid and train.exit), so a trainer of it may be running or may"\
   401	" have died unrecorded -- child.pid names the timeout wrapper, not the trainer."\
   402	" Resolve it"\
   403	" with --resolve-unregistered $attempt once nothing of the arm is alive and the marker"\
   404	" is older than ${UNRESOLVED_GRACE_S}s"
   405	            return 1; fi
   406	    done
   407	    return 0
   408	}
   409	
   410	require_quiet_arm() {  # require_quiet_arm [<attempt being resolved>]
   411	    local status=0
   412	    say "SCAN $ARM_ROOT"
   413	    if [ "$DRY" -eq 1 ] && [ "${EXP11_TEST_ROOTS:-0}" != 1 ]; then return 0; fi
   414	    check_pid_reader || return "$READER_UNKNOWN"   # before anything is looked at
   415	    scan_arm "$ARM_ROOT" "${1:-}" || status=$?
   416	    [ "$status" -eq 0 ] && return 0
   417	    echo "refusing: $SCAN_REASON" >&2
   418	    return "$status"
   419	}
   420	
   421	# --- the intent marker: the half-second the frozen lifecycle cannot cover -----------
   422	# `run_child` forks the detached trainer and writes child.pid only afterwards, and the
   423	# trainer needs a moment to write its own. A launcher that dies inside that window would
   424	# leave a running trainer nothing names. So the intent to launch is declared BEFORE the
   425	# fork and withdrawn only once the TRAINER is accounted for -- a complete child.pid and a
   426	# train.exit. `child.pid` holds the timeout wrapper's pid, so its death says nothing about
   427	# the trainer (close review 10). A marker left behind means "a trainer of this attempt may
   428	# be running, or died without saying so", and the arm stays closed until an operator
   429	# resolves it: a trainer that crashes before registering fails closed, by design.
   430	mark_launching() {  # mark_launching <attempt>
   431	    printf 'launcher %s\nat %s\narm %s\n' \
   432	        "$$" "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" "$ARM" > "$1/launching"
   433	}
   434	
   435	clear_launching() {  # clear_launching <attempt>: only once the TRAINER is accounted for
   436	    # This runs after run_child returns, so the wrapper and the sink are gone. A complete
   437	    # child.pid proves the wrapper was recorded; train.exit proves the trainer itself
   438	    # finished. A trainer that crashed before registering leaves the marker standing and
   439	    # the attempt unresolved -- fail closed, by design: the operator answers it.
   440	    # `|| return 0` covers BOTH "no complete child.pid" and "the reader could not say":
   441	    # a marker is withdrawn on an answer, never on the absence of one (close review 11).
   442	    registration_complete "$1" || return 0
   443	    [ -f "$1/train.exit" ] || return 0
   444	    rm -f -- "$1/launching"
   445	}
   446	
   447	# resolve_unregistered <attempt>: an operator's explicit answer to a marker nothing can
   448	# explain any more. It can only ever abort: an attempt with no child.pid has no exit
   449	# receipt and can never be published.
   450	resolve_unregistered() {
   451	    local attempt="" root="" name="" now=0 stamp=0 age=0
   452	    # This is the one decision that deliberately ignores its own target's marker -- the
   453	    # tombstone is what makes that safe -- so the liveness answers are all that stand
   454	    # between a running trainer and a retired directory. Ask the reader for them only
   455	    # once it has proved it can answer (close review 11).
   456	    check_pid_reader || return "$READER_UNKNOWN"
   457	    # Identity is the canonical directory, never the spelling: an operator's path may be
   458	    # absolute where the root is relative, or reach the arm through a symlink.
   459	    [ -d "$1" ] || { echo "refusing: $1 is not a directory" >&2; return 1; }
   460	    attempt="$(realpath -- "$1")" || return 1
   461	    root="$(realpath -- "$ARM_ROOT")" || return 1
   462	    name="$(basename -- "$attempt")"
   463	    # The lock and the scan are this arm's, so the resolution reaches no further.
   464	    if [ "$(dirname -- "$attempt")" != "$root" ]; then
   465	        echo "refusing: $attempt is not an attempt of the selected arm ($root); this" \
   466	             "invocation locked and scanned that arm and no other" >&2
   467	        return 1
   468	    fi
   469	    case "$name" in
   470	        attempt_*) case "${name#attempt_}" in ''|*[!0-9T]*)
   471	            echo "refusing: $name is not an attempt directory of this arm" >&2
   472	            return 1 ;; esac ;;
   473	        *) echo "refusing: $name is not an attempt directory of this arm" >&2
   474	           return 1 ;;
   475	    esac
   476	    [ -f "$attempt/launching" ] || {
   477	        echo "refusing: $attempt has no launching marker; nothing is unresolved" >&2
   478	        return 1; }
   479	    # NOT "child.pid is complete": that file holds the `timeout` wrapper's pid, and a
   480	    # wrapper that died with its trainer unregistered is precisely the state the scan
   481	    # now calls unresolved (close review 10, blocker 2). Refusing on it would leave the
   482	    # arm shut for good -- closed by the scan, unanswerable by the operator. What may
   483	    # never be retired this way is a run that actually finished: a completion receipt,
   484	    # or the published `final`. Everything else is decided by the quiet scan below --
   485	    # nothing of the arm alive -- and by the marker's age.
   486	    if [ -f "$attempt/completion.json" ]; then
   487	        echo "refusing: $attempt has a completion receipt; it is a finished run, not an" \
   488	             "unresolved launch" >&2
   489	        return 1
   490	    fi
   491	    if [ "$(published_target || true)" = "$attempt" ]; then
   492	        echo "refusing: $attempt is published as $ARM_ROOT/final; a published attempt is" \
   493	             "never retired as an unresolved launch" >&2
   494	        return 1
   495	    fi
   496	    # The REGISTRATION lock, distinct from the publication lock this invocation already
   497	    # holds: a full-mode launcher holds the publication lock for its child's whole run,
   498	    # so a trainer could never take that one. This one is held only across a
   499	    # registration and across this resolution -- exactly the pair that must not
   500	    # interleave, because the trainer's checks and its write straddle the rename below
   501	    # (close review 9, blocker 2). The recovery and full-mode scans do not take it: an
   502	    # in-flight registration is already covered there by the launching marker or by a
   503	    # complete live child.pid, and a recovery that had to queue behind every trainer
   504	    # would be a new way to stall an arm.
   505	    local registration="$root/.registration.lock" reg_fd=""
   506	    : >> "$registration" 2>/dev/null || true
   507	    exec {reg_fd}>>"$registration" || {
   508	        echo "refusing: cannot open the registration lock $registration" >&2; return 1; }
   509	    if ! flock -n "$reg_fd"; then
   510	        exec {reg_fd}>&-
   511	        echo "refusing: a registration in progress holds $registration; a trainer is" \
   512	             "between its checks and its write, so nothing of this arm may be retired" >&2
   513	        return 1
   514	    fi
   515	    local scanned=0
   516	    scan_arm "$ARM_ROOT" "$attempt" || scanned=$?
   517	    if [ "$scanned" -ne 0 ]; then
   518	        exec {reg_fd}>&-
   519	        echo "refusing: $SCAN_REASON" >&2
   520	        return "$scanned"          # 2 = the reader failed: this resolution decides nothing
   521	    fi
   522	    now="$(date -u +%s)"
   523	    stamp="$(date -u -r "$attempt/launching" +%s 2>/dev/null || printf '%s' "$now")"
   524	    age=$((now - stamp))
   525	    if [ "$age" -lt "$UNRESOLVED_GRACE_S" ]; then
   526	        exec {reg_fd}>&-
   527	        echo "refusing: $attempt/launching is ${age}s old and a trainer that has not" \
   528	             "registered yet is still possible; wait until it is ${UNRESOLVED_GRACE_S}s" >&2
   529	        return 1
   530	    fi
   531	    say "TOMBSTONE $root/$name.resolved"
   532	    say "ABORT $attempt -> ${attempt}_ABORTED_unregistered"
   533	    if [ "$DRY" -eq 0 ]; then
   534	        # Written BEFORE the rename, and never removed by anything here: a trainer that
   535	        # wakes after this can no longer find its directory, and if it somehow can, this
   536	        # is what tells it the launch was answered. The scan ignores it -- it is a
   537	        # record, not a claim (close review 8, blocker 2).
   538	        printf 'resolved-by %s\nat %s\nreason %s\n' "$$" \
   539	            "$(date -u +%Y-%m-%dT%H:%M:%S+00:00)" \
   540	            'unresolved launch: a launching marker with no finished trainer (no train.exit), and no recorded pid of this arm alive. A trainer that never registered may still exist; this tombstone is what refuses it.' \
   541	            > "$root/$name.resolved"
   542	        mv -- "$attempt" "${attempt}_ABORTED_unregistered"
   543	        # The marker has been answered; leaving it would close the arm for good, since
   544	        # the scan reads every attempt_* directory, retired ones included.
   545	        rm -f -- "${attempt}_ABORTED_unregistered/launching"
   546	    fi
   547	    exec {reg_fd}>&-   # the whole critical section is done: scan, tombstone, rename
   548	    # Precisely what was established: no *recorded* pid of the arm answered a liveness
   549	    # probe and this attempt's trainer never said it finished. A trainer that never
   550	    # registered cannot be seen at all -- that is why the tombstone above is written
   551	    # first and never removed (close review 11, wording).
   552	    say "RESOLVED $attempt has no finished trainer and no recorded pid of this arm was" \
   553	        "alive; it can never be published, and the tombstone refuses any trainer of it" \
   554	        "that is still to come"
   555	}
   556	
   557	# A deterministic pause, so a regression can hold this invocation open between two
   558	# launchers. It exists only inside the test roots and costs a real launch nothing.
   559	scan_barrier() {
   560	    local file="${EXP11_SCAN_BARRIER:-}"
   561	    [ -n "$file" ] && [ "${EXP11_TEST_ROOTS:-0}" = 1 ] || return 0
   562	    : > "$file.at"
   563	    while [ -e "$file" ]; do sleep 0.05; done
   564	}
   565	
   566	# A signal handler must END this invocation. A cleanup-only handler returns, and bash
   567	# resumes -- which would let finalization and promotion continue after the interruption.
   568	# The lock needs no releasing here: the EXIT trap ends the holder, and if anything went
   569	# wrong with that the lease ends it within a second anyway.
   570	on_signal() {  # on_signal <NAME> <number>
   571	    INTERRUPTED=1
   572	    say "SIGNAL $1"
   573	    exit $((128 + $2))
   574	}
   575	
   576	# Checked before every protected step, so nothing runs after a handler has fired even if
   577	# some future caller swallows the exit.
   578	not_interrupted() {
   579	    [ "$INTERRUPTED" -eq 0 ] && return 0
   580	    echo "refusing: a signal handler has fired; this invocation does not continue" >&2
   620	    if [ -n "$why" ]; then
   621	        say "PRESERVED $canonical ($why); the refusal is this invocation's, not the run's"
   622	        return 0
   623	    fi
   624	    abort "$canonical" "$log" finalize_refused
   625	}
   626	
   627	# diagnostic <kind> <run dir> <log> <receipt> <entry argv...>: one enumerated diagnostic
   628	# kind through the same lifecycle as a confirmatory child, finalized as exp11_smoke and
   629	# never admissible as an arm.
   630	diagnostic() {
   631	    local kind="$1" dir="$2" log="$3" receipt="$4"
   632	    shift 4
   633	    local flags=(--kind "$kind" --receipt "$receipt" --provenance-out "$dir/provenance.json"
   634	                 --approved "$APPROVED" --reviewed-commit "$COMMIT")
   635	    [ "${EXPLORATORY:-0}" -eq 0 ] || flags+=(--exploratory)
   636	    local cmd=("$PYTHON" tools/exp11_smoke.py "${flags[@]}" "$@")
   637	    say "MKDIR $dir"
   638	    say "SINK cat >> $log"
   639	    say "PIDFILE $dir/launch.pid"
   640	    say "RUN nohup setsid ${cmd[*]}"
   641	    if [ "$DRY" -eq 1 ]; then
   642	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   643	        finalize "$dir" "$log" '<code>' exp11_smoke "$receipt"
   644	        return 0
   645	    fi
   646	    mkdir -p -- "$(dirname -- "$dir")" "$RECORD"
   647	    mkdir -- "$dir"      # exclusive: a repeated stamp must not reuse a diagnostic run
   648	    own_launch "$dir"
   649	    : > "$log"
   650	    run_child "$dir" "$log" "${cmd[@]}"
   651	    close_child "$dir" "$log"
   652	    if ! finalize "$dir" "$log" "$CHILD_STATUS" exp11_smoke "$receipt"; then
   653	        abort "$dir" "$log" finalize_refused
   654	        exit 2
   655	    fi
   656	    if [ "$CHILD_STATUS" -ne 0 ]; then
   657	        abort "$dir" "$log" "child_failed_$CHILD_STATUS"
   658	        exit "$CHILD_STATUS"
   659	    fi
   660	}
   661	
   662	# The sourced library already resolved APPROVED to exp_06's record, so exp_11's default
   663	# is assigned unconditionally; EXP11_APPROVED (or --approved) overrides it.
   664	APPROVED="${EXP11_APPROVED:-$APPROVED_DEFAULT}"
   665	COMMIT="${COMMIT:-}"
   666	EXPLORATORY="${EXPLORATORY:-0}"
   667	ARM_ROOT="${ARM_ROOT:-$SIMPOR_ROOT}"
   668	CANONICAL_ATTEMPT="${CANONICAL_ATTEMPT:-}"
   669	INTERRUPTED="${INTERRUPTED:-0}"
   670	REPLACE_FINAL="${REPLACE_FINAL:-0}"
   671	RESOLVE_UNREGISTERED="${RESOLVE_UNREGISTERED:-}"
   672	DRY="${DRY:-0}"
   673	ARM="${ARM:-H}"
   674	
   675	if [ "${EXP11_LAUNCH_LIB:-0}" = 1 ]; then return 0; fi
   676	
   677	MODE="${1:-}"
   678	shift || true
   679	case "$MODE" in smoke|probe|full|finalize) ;; *) usage ;; esac
   680	GPU=""; COMMIT=""; ATTEMPT=""; LOG=""; CHILD_EXIT=""; DRY=0; ARM=H
   681	RESOLVE_UNREGISTERED=""
   682	while [ $# -gt 0 ]; do
   683	    case "$1" in
   684	        --arm) ARM="${2:-}"; shift 2 ;;
   685	        --gpu) GPU="${2:-}"; shift 2 ;;
   686	        --reviewed-commit) COMMIT="${2:-}"; shift 2 ;;
   687	        --attempt) ATTEMPT="${2:-}"; shift 2 ;;
   688	        --log) LOG="${2:-}"; shift 2 ;;
   689	        --child-exit) CHILD_EXIT="${2:-}"; shift 2 ;;
   690	        --approved) APPROVED="${2:-}"; shift 2 ;;
   691	        --exploratory) EXPLORATORY=1; shift ;;
   692	        --replace-final) REPLACE_FINAL=1; shift ;;
   693	        --resolve-unregistered) RESOLVE_UNREGISTERED="${2:-}"; shift 2 ;;
   694	        --dry-run) DRY=1; shift ;;
   695	        *) usage ;;
   696	    esac
   697	done
   698	[ -n "$GPU" ] && [ -n "$COMMIT" ] || usage
   699	apply_root_override || exit 2
   700	apply_reader_override || exit 2
   701	arm_of "$ARM" || exit 2
   702	check_ceiling || exit 2
   703	[ "$MODE" != finalize ] || [ -n "$RESOLVE_UNREGISTERED" ] \
   704	    || { [ -n "$ATTEMPT" ] && [ -n "$LOG" ] && [ -n "$CHILD_EXIT" ]; } || usage
   705	
   706	if [ "$DRY" -eq 1 ]; then STAMP='<UTC>'; else STAMP="$(date -u +%Y%m%dT%H%M%S)"; fi
   707	if [ "$MODE" = finalize ]; then OWNER=""        # recovery owns no live launch.pid
   708	elif [ "$DRY" -eq 1 ]; then OWNER='<pid>'
   709	else OWNER="$$"; fi
   710	
   711	say "EXP11_LAUNCH mode=$MODE arm=$ARM gpu=$GPU commit=$COMMIT root=$ARM_ROOT stamp=$STAMP dry_run=$DRY"
   712	say "ENV CUDA_VISIBLE_DEVICES=$GPU PYTHONHASHSEED=0 OMP_NUM_THREADS=8 XRIR_DATA_PATH=$DATA_ROOT"
   713	if [ "$DRY" -eq 0 ] && [ ! -d "$DATA_ROOT" ]; then
   714	    echo "refusing: XRIR_DATA_PATH $DATA_ROOT is not a directory" >&2
   715	    exit 2
   716	fi
   717	export XRIR_DATA_PATH="$DATA_ROOT"
   718	CHILD_EXPLORATORY=()
   719	[ "$EXPLORATORY" -eq 0 ] || CHILD_EXPLORATORY=(--exploratory)
   720	
   721	case "$MODE" in
   722	full)
   723	    scan_barrier
   724	    # From before the child launch through promotion: a recovery on this arm is refused
   725	    # while this run owns it. The arm-wide scan runs under the lock, never before it.
   726	    hold_arm_lock full || exit 2
   727	    require_quiet_arm || exit 2
   728	    preflight
   729	    attempt="$ARM_ROOT/attempt_$STAMP"
   730	    log="$RECORD/orientation_cue_fairness_${STAMP}_train_full_${ARM}.log"
   731	    say "MKDIR $attempt"
   732	    say "SINK cat >> $log"
   733	    say "PIDFILE $attempt/launch.pid"
   734	    say "CEILING ${FULL_CEILING_S}s"
   735	    child=(timeout --kill-after=60 "$FULL_CEILING_S"
   736	           "$PYTHON" tools/exp11_train.py --backbone "$ARM_BACKBONE" --save-dir "$attempt"
   737	           --num-shot 8 --max-len 9600 --lr 1e-3 --weight-decay 1e-4 --decay-epochs 3
   738	           --lr-gamma 0.1 --epochs 12 --batch-size 32 --accum-steps 2 --num-workers 12
   739	           --seed 0 --tf32 --log-interval 50 --save-every "$ARM_SAVE_EVERY"
   740	           --epoch-ckpt-every 1 --yaw-aug "$ARM_YAW" --yaw-aug-seed 0 --yaw-aug-width 512
   741	           --run-type full --approved "$APPROVED" --reviewed-commit "$COMMIT")
   742	    say "RUN nohup setsid ${child[*]}"
   743	    if [ "$DRY" -eq 1 ]; then
   744	        say "MARKER EXP06_CHILD_EXIT <code> <iso> >> $log"
   745	        abort "$attempt" "$log" 'child_exit_<code>'
   746	        finalize "$attempt" "$log" '<code>' exp11_train
   747	        promote "attempt_$STAMP"
   748	        exit 0
   749	    fi
   750	    mkdir -p -- "$ARM_ROOT"
   751	    mkdir -- "$attempt"   # exclusive: a repeated stamp must not reuse an attempt
   752	    own_launch "$attempt"
   753	    mkdir -p -- "$RECORD"
   754	    : > "$log"
   755	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   756	    mark_launching "$attempt"   # before the fork: the child may exist before child.pid
   757	    run_child "$attempt" "$log" "${child[@]}"
   758	    clear_launching "$attempt"  # only if the trainer left a train.exit
   759	    close_child "$attempt" "$log"
   760	    status="$CHILD_STATUS"
   761	    if [ "$status" -ne 0 ]; then
   762	        abort "$attempt" "$log" "child_exit_$status"
   763	        exit "$status"
   764	    fi
   765	    not_interrupted || exit 2
   766	    if ! finalize "$attempt" "$log" "$status" exp11_train; then
   767	        abort "$attempt" "$log" finalize_refused
   768	        exit 2
   769	    fi
   770	    not_interrupted || exit 2
   771	    promote "attempt_$STAMP"
   772	    ;;
   773	probe)
   774	    preflight
   775	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   776	    diagnostic probe "$ARM_ROOT/probe_$STAMP" \
   777	        "$RECORD/orientation_cue_fairness_${STAMP}_probe_${ARM}.log" \
   778	        "$ARM_ROOT/probe_$STAMP.json" -- \
   779	        --backbone "$ARM_BACKBONE" --save-dir "$ARM_ROOT/probe_$STAMP" \
   780	        --epochs 1 --max-train-batches 200 --max-test-batches 20 --no-save --run-type probe \
   781	        --batch-size 32 --accum-steps 2 --tf32 --num-workers 12 --decay-epochs 3 \
   782	        --yaw-aug "$ARM_YAW" --save-every 0 --log-interval 50 \
   783	        ${CHILD_EXPLORATORY[@]+"${CHILD_EXPLORATORY[@]}"}
   784	    ;;
   785	smoke)
   786	    preflight
   787	    export CUDA_VISIBLE_DEVICES="$GPU" PYTHONHASHSEED=0 OMP_NUM_THREADS=8
   788	    # (a) the oriented backbone on a bounded budget, through exp_11's training entry.
   789	    diagnostic probe "$SMOKE_DIR/exp11_train_$STAMP" \
   790	        "$RECORD/orientation_cue_fairness_${STAMP}_smoke_exp11_train.log" \
   791	        "$SMOKE_DIR/receipt_exp11_train_$STAMP.json" \
   792	        --alarm-seconds "$SMOKE_ALARM_S" --max-gb "$SMOKE_MAX_GB" -- \
   793	        --backbone "$ARM_BACKBONE" --save-dir "$SMOKE_DIR/t0" $SMOKE_FLAGS \
   794	        --save-every 0 --yaw-aug "$ARM_YAW" --run-type probe \
   795	        ${CHILD_EXPLORATORY[@]+"${CHILD_EXPLORATORY[@]}"}
   796	    # (b) the CPU fixtures the HAA smokes load; the exp_01 checkpoints cannot load into
   797	    # the five-channel patch embedding, and the adapter needs its own keys.
   798	    run "$PYTHON" tools/exp11_smoke.py --make-fixture "$SMOKE_DIR/fixture_simpor.pth" \
   799	        --fixture-backbone simple_oriented
   800	    run "$PYTHON" tools/exp11_smoke.py --make-fixture "$SMOKE_DIR/fixture_simpadapter.pth" \
   801	        --fixture-backbone simple_adapter
