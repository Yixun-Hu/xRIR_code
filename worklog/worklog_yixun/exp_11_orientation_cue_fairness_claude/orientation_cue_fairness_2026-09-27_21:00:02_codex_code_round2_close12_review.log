" have died unrecorded -- child.pid names the timeout wrapper, not the trainer."\
" Resolve it"\
" with --resolve-unregistered $attempt once nothing of the arm is alive and the marker"\
" is older than ${UNRESOLVED_GRACE_S}s"
            return 1; fi
    done
    return 0
}

