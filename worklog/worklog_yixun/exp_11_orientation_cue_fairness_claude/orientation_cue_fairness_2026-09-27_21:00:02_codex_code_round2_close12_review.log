   304	    [ "$status" -eq 0 ] || return "$READER_UNKNOWN"
   305	    case "$answer" in
   306	        *"$NEWLINE"*) return "$READER_UNKNOWN" ;;   # a verdict is ONE line
   307	        'record '*)
   308	            # The digits are the protocol's, not this shell's reading of a file -- but a
   309	            # verdict that is not digits is not a verdict, and `kill -0 <word>` would
   310	            # fail and read as "not alive".
   311	            answer="${answer#record }"
   312	            case "$answer" in ''|*[!0-9]*) return "$READER_UNKNOWN" ;; esac
   313	            printf '%s\n' "$answer"; return 0 ;;
   314	        norecord) return 1 ;;
   315	        *) return "$READER_UNKNOWN" ;;
   316	    esac
   317	}
   318	
   319	# pid_alive <file>: 0 the recorded pid is alive | 1 it is not | 2 nobody can say.
   320	pid_alive() {
   321	    local pid="" status=0
   322	    pid="$(pid_record "$1")" || status=$?
   323	    [ "$status" -ne "$READER_UNKNOWN" ] || return "$READER_UNKNOWN"
   324	    [ "$status" -eq 0 ] || return 1
   325	    kill -0 "$pid" 2>/dev/null
   326	}
