    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=str(REPO),
                                   text=True).strip()
    current = profiles.compute_code_digests(REPO, head, keys=('summarize_haa',))
    approved = {'code': {'summarize_haa': current['summarize_haa']}}

