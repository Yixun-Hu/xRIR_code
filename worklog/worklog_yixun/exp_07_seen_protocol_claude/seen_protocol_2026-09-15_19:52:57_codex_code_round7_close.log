   111	        directory = (root / row['attempt']).resolve()
   112	        if directory == Path(certified).resolve():
   113	            continue
   114	        require(directory.is_dir(), 'the ledger names a missing attempt: ' + row['attempt'])
   115	        files = sorted(item for item in directory.rglob('*') if item.is_file())
   116	        require(files, 'a bound attempt holds no files: ' + row['attempt'])
   117	        records.append(dict(role=role, attempt=row['attempt'], mode=row['mode'],
   118	                            hours=row['hours'], path=str(directory),
   119	                            files=[stamp(item) for item in files],
   120	                            **terminal_state(directory, row)))
