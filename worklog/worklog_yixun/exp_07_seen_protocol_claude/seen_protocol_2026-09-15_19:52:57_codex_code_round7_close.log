```bash
STAMP=$(date +%Y%m%dT%H%M%S%N)

tools/exp07_launch.sh smoke --backbone "$BACKBONE" --yaw-aug "$YAW" \
  --gpu "$GPU" --reviewed-commit "$MERGE" --log-dir "$REC" \
  --timestamp "$STAMP"

tools/exp07_launch.sh probe --backbone "$BACKBONE" --yaw-aug "$YAW" \
  --gpu "$GPU" --reviewed-commit "$MERGE" --log-dir "$REC" \
