    72	def terminal_state(directory, row):
    73	    """A ledger-listed attempt ended certified or aborted; bind that state's evidence.
    74	
    75	    Setup failure is the documented third shape of an abort: ``execute_attempt`` raises
    76	    before the child is spawned, so ``guard.log_created`` is false, ``abort_log`` renames
    77	    nothing (``log.aborted`` is null), no ``execution.json`` was ever written and there is
    78	    no log on disk to hash.  Any other abort must bind a log.
    79	    """
    80	    completion, abort = directory / 'completion.json', directory / 'abort.json'
    81	    if completion.is_file():  # a recovered attempt keeps its abort.json as well
    82	        record = json.loads(completion.read_text()).get('log') or {}
    83	        require(record.get('path'), 'a certified attempt records no log: ' + row['attempt'])
    84	        return dict(state='certified', setup_failure=False,
    85	                    logs=[external_log(record['path'], record.get('sha256'))])
    86	    require(abort.is_file(),
    87	            'the attempt has no terminal state (completion.json or abort.json): ' + row['attempt'])
    88	    record = json.loads(abort.read_text())
    89	    reason = record.get('reason')
    90	    require(isinstance(reason, str) and reason, 'an aborted attempt records no reason: '
    91	            + row['attempt'])
    92	    log = record.get('log') or {}
    93	    logs = [external_log(log[key]) for key in ('original', 'aborted') if log.get(key)]
    94	    failure = not log.get('aborted') and not (directory / 'execution.json').is_file()
    95	    require(failure or any(item['present'] for item in logs),
    96	            'an aborted attempt that spawned a child must bind its log: ' + row['attempt'])
    97	    return dict(state='aborted', setup_failure=failure, reason=reason, logs=logs)
