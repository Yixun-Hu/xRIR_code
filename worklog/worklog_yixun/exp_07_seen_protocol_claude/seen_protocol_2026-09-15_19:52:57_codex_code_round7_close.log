+    monkeypatch.setattr(calibration, 'HISTORICAL', shifted)
+    result, _ = calibrated.build()
+    assert result['passed'] is False and result['metrics']['C50']['passed'] is False
+    assert result['metrics']['EDT']['passed'] is True
