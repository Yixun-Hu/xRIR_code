nohup setsid tools/exp07_launch.sh full \
  --backbone "$BACKBONE" --yaw-aug "$YAW" --gpu "$GPU" \
  --reviewed-commit "$MERGE" --probe-json "$RECEIPT" \
  --log-dir "$REC" --timestamp "$STAMP" \
  > "$REC/${ROLE}_${STAMP}_launcher.log" 2>&1 &
```

