    after=bound.binder.collect(**bound.arguments)
    assert before==after
    print('UNDETECTED external aborted-attempt log mutation')
    data['reason']='rewritten';abort.write_text(json.dumps(data))
    assert bound.binder.collect(**bound.arguments)!=after
    print('DETECTED round5 abort.json mutation')
    abort.unlink()
    bound.binder.collect(**bound.arguments)
    print('ACCEPTED aborted full attempt with no abort.json')
    probe=directory/'_probe_t_arm';completion=probe/'completion.json'
    outside=directory/'probe.log';outside.write_text('probe evidence')
    data=json.loads(completion.read_text());data['log']={'path':str(outside),'sha256':p.sha256_file(outside)}
    completion.write_text(json.dumps(data))
    before=bound.binder.collect(**bound.arguments);outside.write_text('different probe evidence')
    assert bound.binder.collect(**bound.arguments)==before
    print('UNDETECTED external probe log mutation')


