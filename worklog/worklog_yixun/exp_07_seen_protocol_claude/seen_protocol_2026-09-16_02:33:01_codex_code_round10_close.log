    36	def fake_pytest(cases=None, status=0, output=b'9 passed, 0 skipped\n'):
    37	    """A stand-in for the pytest subprocess: writes the JUnit XML and returns its status."""
    38	    cases = passing() if cases is None else cases
    39	    def runner(command, **kwargs):
    40	        junit = next(item for item in command if item.startswith('--junitxml='))
    41	        Path(junit[len('--junitxml='):]).write_text(
    42	            SUITE.format(n=len(cases), cases=''.join(case(*item) for item in cases)))
    43	        return SimpleNamespace(returncode=status, stdout=output)
    44	    return runner
