   105	    """Import hermetically; refuse files outside the repo and interpreter prefixes."""
   106	    repo = Path(repo).resolve()
   107	    code = '''import importlib, json, os, sys
   108	repo = os.path.realpath(sys.argv[1])
   109	sys.path = [repo] + [p for p in sys.path if p]
   110	importlib.import_module(sys.argv[2])
