   172	@torch.no_grad()
   173	def alignment_audit(model, batches, offsets_per_batch, W=512, sr=22050, c=343.0):
   174	    """Count changed integer delays on the model's dtype/device, without a forward.
   175	
   176	    Each six-tuple must carry ``query_paths`` (use AuditBatch). The digest hashes
   177	    compact JSON [path, offset] records, each followed by a newline, in query order.
   178	    """
   179	    parameter = next(model.parameters())
   180	    pairs = changed = 0
   181	    digest = hashlib.sha256()
   182	    for batch, offsets in zip_longest(batches, offsets_per_batch):
   183	        if batch is None or offsets is None:
   184	            raise ValueError("batch and offset iterables must have equal lengths")
   185	        paths = getattr(batch, "query_paths", None)
   186	        if paths is None or len(paths) != batch[1].shape[0] or any(not isinstance(p, str) for p in paths):
   187	            raise ValueError("query_paths must contain one path string per query")
   188	        depth, src, refs = (batch[i].to(device=parameter.device, dtype=parameter.dtype, non_blocking=True)
   189	                            for i in (2, 1, 5))
   190	        offsets = offsets.to(parameter.device)
   191	        _, rotated_src, rotated_refs = apply_yaw_aug(depth, src, refs, offsets, W=W)
   192	        before = integer_delays(src, refs, sr=sr, c=c)
   193	        after = integer_delays(rotated_src, rotated_refs, sr=sr, c=c)
   194	        pairs += before.numel()
   195	        changed += int((before != after).sum().item())
   196	        for path, offset in zip(paths, offsets.tolist()):
   197	            digest.update((json.dumps([path, offset], separators=(",", ":")) + "\n").encode("utf-8"))
   198	    return {"pairs": pairs, "changed_delays": changed, "fraction": changed / pairs if pairs else 0.0,
   199	            "cohort_sha256": digest.hexdigest(), "W": W}
