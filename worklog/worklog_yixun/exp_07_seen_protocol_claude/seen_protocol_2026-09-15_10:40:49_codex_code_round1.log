   164	class AuditBatch(tuple):
   165	    """Trainer's six tensors plus query paths, attached after loader collation."""
   166	    def __new__(cls, batch, query_paths):
   167	        instance = super().__new__(cls, batch)
   168	        instance.query_paths = query_paths
