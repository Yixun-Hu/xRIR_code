+        sample['P']['0'][source][:count] = [None] * count
+        metrics = calibrated.built.read(run / 'metrics_yaw.json')
+        metrics['P'] = calibrated.built.summaries(sample['P'])
+        calibrated.built.rebind(run, sample=sample, metrics=metrics)
