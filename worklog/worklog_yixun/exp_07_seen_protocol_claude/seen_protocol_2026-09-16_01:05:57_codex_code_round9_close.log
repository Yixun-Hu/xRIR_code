  --rendered "$REC/seen_protocol_results.md" \
    "$REC/seen_protocol_01_results.html" "$ASSETS/table_seen_unseen.tex" \
  --unseen-table "$UNSEEN" --unseen-binding "$UNSEEN_BINDING" \
  --out ckpt/exp07
"$PY" "$ASSETS/check_record.py" ckpt/exp07
