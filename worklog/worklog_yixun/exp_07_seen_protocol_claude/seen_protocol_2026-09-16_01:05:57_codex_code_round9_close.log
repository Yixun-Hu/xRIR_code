                additions[role+'/'+name]=attempt/name
            for name in ('train_manifest.json','completion.json'):
                additions[role+'/probe/'+name]=attempt.parent/'_probe_t_arm'/name
        for file in aborted_attempt(bound).iterdir():
            if file.is_file():additions['abort/'+file.name]=file
        # Actual source of the other canonical producer (fixture's closure is table only).
        additions['other producer closure']=binder.ROOT/'tools/exp07_pairs.py'
        if 'released_seen' not in roles:
            additions['released checkpoint']=bound.built.attempts['released_seen']/'epoch_012.pth'
        mutations=[]
        for name,file in additions.items():
            assert str(file) not in data['inputs'],name
            mutations.append(('add '+name,lambda d,s,f=file:d['inputs'].__setitem__(str(f),p.sha256_file(f)),'does not bind as this product'))
        for dependency in sorted(data['inputs']):
            if Path(dependency).name=='cumulative_hours.json' or Path(dependency).name.startswith('_probe_t_'):
                mutations.append(('omit '+dependency,lambda d,s,k=dependency:d['inputs'].pop(k),'missing training dependency'))
        for name,mutate,reason in mutations:
            change_product(path,mutate);recite(bound)
            try:
                with pytest.raises(ValueError,match=reason):binder.collect(**bound.arguments)
                # Repaired outer citation digests do not make the edited product acceptable.
                with pytest.raises(ValueError,match=reason):checker.main([str(bound.reports)])
                count+=1
            finally:path.write_bytes(raw);sidecar(path).write_bytes(side_raw);recite(bound)
        print('END_TO_END',index,'refused',len(mutations),'mutations',flush=True)
    print('END_TO_END collect and checker',count,'mutations refused',flush=True)


def test_foreign_data_inventory_from_unused_role(exp07_fixture,table_fixture,tmp_path,monkeypatch):
    # Use real producers with a distinct, byte-identical inventory root per role.
    def build():
        built=exp07_fixture()
        for (role,shot),runs in built.paths.items():
            root=built.root/('data_'+role)
            if not root.exists():shutil.copytree(str(built.root/'data'),str(root))
            for directory in runs:
                run=Path(directory);manifest=read(run/'eval_manifest.json')
                manifest['data_root']=str(root);manifest['data_identity']['data_root']=str(root)
                built.rebind(run,manifest=manifest)
        return built
    inputs=record_inputs.__wrapped__(build,table_fixture,tmp_path)
    bnd=bound.__wrapped__(inputs,tmp_path,monkeypatch)
    report=bnd.binder.collect(**bnd.arguments);saved(bnd,report)
    for index,product in enumerate(inputs['pairs']):
        data=read(product);roles=set(data['pairing'])
        foreign=next(role for role in ('seen_cyl','seen_aug','released_seen') if role not in roles)
        run=Path(bnd.built.paths[(foreign,8)][0]);manifest=read(run/'eval_manifest.json')
        item=manifest['data_identity']['inventory'][0]
        filename=Path(manifest['data_identity']['data_root'])/item['path']
        assert str(filename) not in data['inputs']
        raw=product.read_bytes();side_raw=sidecar(product).read_bytes()
        change_product(product,lambda d,s:d['inputs'].__setitem__(str(filename),p.sha256_file(filename)));recite(bnd)
        with pytest.raises(ValueError,match='does not bind as this product'):bnd.binder.collect(**bnd.arguments)
        with pytest.raises(ValueError,match='does not bind as this product'):load_asset('check_record').main([str(bnd.reports)])
        product.write_bytes(raw);sidecar(product).write_bytes(side_raw);recite(bnd)
        print('REFUSED unused-role data-inventory file',index,foreign,flush=True)
