    report=bound.binder.collect(**bound.arguments);saved(bound,report)
    checker=load_asset('check_record');checker.main([str(bound.reports)])
    records={}
    def walk(value):
        if isinstance(value,dict):
            if isinstance(value.get('path'),str) and isinstance(value.get('sha256'),str):records[value['path']]=value['sha256']
            for item in value.values():walk(item)
        elif isinstance(value,list):
            for item in value:walk(item)
    walk(report['attempts'])
    required=set()
    for arm in report['attempts']:
        required.update(str(path.resolve()) for path in Path(arm['path']).rglob('*') if path.is_file())
        for other in arm['other_attempts']:
            required.update(str(path.resolve()) for path in Path(other['path']).rglob('*') if path.is_file())
            required.update(item['path'] for item in other['logs'] if item['present'])
        required.add(arm['log']['path'])
    assert required<=set(records)
    assert all(p.sha256_file(path)==records[path] for path in required)
    for filename in sorted(required):
        path=Path(filename);raw=path.read_bytes()
        # Whitespace remains valid JSON: the checker must bind bytes, not just semantics.
        path.write_bytes(raw+b' \\n')
        try:
            with pytest.raises((ValueError,KeyError,OSError)):checker.main([str(bound.reports)])
        finally:path.write_bytes(raw)
    checker.main([str(bound.reports)])
    (REVIEW/'attempt-inventory.json').write_text(json.dumps(sorted(required),indent=2))
    print('ATTEMPT full file inventories and logs',len(required),'independent edits all detected',flush=True)


