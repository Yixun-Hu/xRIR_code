import subprocess
import pytest
from test_exp07_record_tools import parity_receipt
from tools.exp07_record import load_asset


def test_receipts_from_other_commits(tmp_path):
    binder=load_asset('bind_provenance')
    git=lambda *args:subprocess.check_output(['git']+list(args),text=True).strip()
    head=git('rev-parse','HEAD');other=git('rev-parse','main');ancestor=git('rev-parse','d58c2fd')
    assert subprocess.run(['git','merge-base','--is-ancestor',other,head]).returncode==1
    receipt=tmp_path/'parity.receipt.json'
    parity_receipt(receipt,other)
    with pytest.raises(ValueError,match='not an ancestor'):
        binder.parity_record(binder.stamp(receipt),head)
    print('REFUSED whole passing receipt copied from nonancestor',other,flush=True)
    parity_receipt(receipt,ancestor)
    record=binder.parity_record(binder.stamp(receipt),head)
    assert record['git_head']==ancestor
    print('ACCEPTED ancestor receipt, preserving original parity commit (allows later pin/bookkeeping commits)',flush=True)
