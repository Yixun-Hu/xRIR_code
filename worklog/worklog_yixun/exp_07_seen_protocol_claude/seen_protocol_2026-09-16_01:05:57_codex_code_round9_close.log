    payloads={seed:{'P':{'0':{name:[float(seed)]*6217 for name in
                ('edt','c50','t60','loss','log_mse')}}} for seed in range(42,47)}
    payloads[42]['P']['0'][metric][:5]=[None]*5
    cells=[payloads[s]['P']['0'] for s in sorted(payloads)]
    with pytest.raises(ValueError,match='finite count tolerance'):
        table.seed_finite_means(cells,sorted(payloads),metric,2)
    if metric in ('loss','log_mse'):
        assert cal.seed_means(payloads)
        print('HOLE exact 6212 vs 6217 calibration',metric,flush=True)
    else:
        with pytest.raises(ValueError,match='finite count tolerance'):
            cal.seed_means(payloads)


def test_calibration_unknown_metric_wrong_roles_k_and_no_approvals(calibrated,monkeypatch):
    def never(*a,**k):
        raise AssertionError('approval loader accessed')
    monkeypatch.setattr(table,'load_approved_digests',never)
    assert calibrated.build()[0]['passed']
    for identity in [('released_seen',1),('seen_simple',8),('seen_cyl',8),('seen_aug',8)]:
        with pytest.raises(ValueError,match='not a K|not the released checkpoint'):
            calibrated.build(calibrated.built.paths[identity])
        print('REFUSED calibration wrong identity',identity,flush=True)
    for directory in calibrated.runs:
        run=Path(directory);sample=read(run/'per_sample_yaw.json');metrics=read(run/'metrics_yaw.json')
        sample['P']['0']['surprise']=[.5]*12
        metrics['P']=calibrated.built.summaries(sample['P'])
        calibrated.built.rebind(run,sample=sample,metrics=metrics)
    with pytest.raises(ValueError,match='unknown metric'):
        calibrated.build()
    with pytest.raises(ValueError,match='unknown metric'):
        cal.measure(calibrated.runs)
    print('REFUSED unknown metric; calibration independent of approval loader',flush=True)


def test_table_helper_extraction_bytes(exp07_fixture):
    built=exp07_fixture()
    source=subprocess.check_output(['git','show','d58c2fd:tools/exp07_table.py'],text=True)
    old=types.ModuleType('round7_table');old.__file__=table.__file__
    exec(compile(source,'round7_table.py','exec'),old.__dict__)
    before,_=old.build_table(built.directories,built.profile,built.approved,producer=built.producer)
    after,_=table.build_table(built.directories,built.profile,built.approved,producer=built.producer)
    encode=lambda obj:json.dumps(obj,sort_keys=True,indent=2,allow_nan=False).encode()+b'\n'
    (REVIEW/'table-d58c2fd.json').write_bytes(encode(before))
    (REVIEW/'table-fd6e521.json').write_bytes(encode(after))
    assert encode(before['rows'])==encode(after['rows'])
    normalized=copy.deepcopy(after)
    for contract in normalized['contracts'].values():
        for key in ('num_shot','seed','eval_manifest_sha256'):
            contract.pop(key)
    assert encode(before)==encode(normalized)
    # Isolate the helper extraction itself from the separately intended identity additions.
    old.run_contract=table.run_contract
    isolated,_=old.build_table(built.directories,built.profile,built.approved,producer=built.producer)
    assert encode(isolated)==encode(after)
    print('BYTE_IDENTICAL numerical rows',hashlib.sha256(encode(after['rows'])).hexdigest(),
          '; full JSON differs only by three added contract identity fields;',
          'helper-only full JSON byte-identical',flush=True)


@pytest.mark.parametrize('which',['log','junit'])
@pytest.mark.parametrize('exists',[True,False])
def test_parity_symlink_reservation(tmp_path,which,exists):
    target=tmp_path/'target'
    if exists:target.write_bytes(b'preserve')
    log=tmp_path/'p.log';xml=tmp_path/'p.xml'
    path=log if which=='log' else xml
    path.symlink_to(target)
    def never(*a,**k):raise AssertionError('child spawned')
    with pytest.raises(FileExistsError):parity.run(log,xml,None,never)
    assert path.is_symlink()
    assert target.read_bytes()==b'preserve' if exists else not target.exists()
    if which=='junit':assert not log.exists()
    print('REFUSED symlink reservation',which,'target exists',exists,flush=True)


