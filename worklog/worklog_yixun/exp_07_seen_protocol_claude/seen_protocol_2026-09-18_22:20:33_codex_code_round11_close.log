@pytest.mark.parametrize('form', ['symlink_to_other_attempt', 'plain_final_directory'])
def test_final_directory_identity_must_survive_checkpoint_hardlink(bound, tmp_path, form):
    report = previous.write_report(bound)
    attempt = bound.built.attempts['seen_simple']
    previous.relocate(attempt, tmp_path / 'archive' / attempt.name)
    final = attempt.parent / 'final'
    final.unlink()
    other = attempt.parent / ('attempt_other' if form == 'symlink_to_other_attempt' else 'final')
    other.mkdir()
    os.link(str(attempt / 'epoch_012.pth'), str(other / 'epoch_012.pth'))
    if form == 'symlink_to_other_attempt':
        final.symlink_to(other.name, target_is_directory=True)
    assert not final.samefile(attempt)
    assert (final / 'epoch_012.pth').samefile(attempt / 'epoch_012.pth')
    outcomes = []
    for label, check in [('collect', lambda: bound.binder.collect(**bound.arguments)),
                         ('check_record', lambda: load_asset('check_record').main([str(bound.reports)]))]:
        try:
            result = check()
        except ValueError:
            outcomes.append((label, 'REFUSED'))
        else:
            if label == 'collect':
                assert result == report
            outcomes.append((label, 'ACCEPTED'))
    print('FINAL_DIRECTORY_IDENTITY', form, outcomes, flush=True)
    assert all(state == 'REFUSED' for _, state in outcomes), outcomes
