   463	def validate_outputs(attempt, mode, expected, limits=None):
   464	    if mode != 'full':
   465	        if {f.name for f in attempt.iterdir()} - {'execution.json', 'abort.json', 'train_inventory.json'} != {'effective_args.json', 'train_manifest.json'}:
   466	            raise ValueError('no-save run wrote unexpected outputs')
   467	        return {}
   468	    check_runtime(json.loads((attempt / 'args.json').read_text()), expected, mode)
   469	    history = [json.loads(line) for line in (attempt / 'history.jsonl').read_text().splitlines()]
   470	    if [r['epoch'] for r in history] != list(range(1, 13)) or any(
   471	            not math.isfinite(r[key]) for r in history for key in ('train_loss', 'test_loss', 'epoch_minutes')):
   472	        raise ValueError('incomplete or non-finite history')
   473	    if history[0]['epoch_minutes'] > (limits['epoch_seconds'] / 60 if limits else 2.431 * 60):
   474	        raise LauncherFailure('guard_epoch_one', 'epoch one exceeds probe acceptance' if limits
   475	                              else 'epoch one exceeds 2.431 h acceptance')
   476	    epochs = sorted(attempt.glob('epoch_*.pth'))
   477	    if [f.name for f in epochs] != ['epoch_%03d.pth' % i for i in range(1, 13)]:
   478	        raise ValueError('missing or unexpected epoch checkpoints')
   479	    return directory_listing(attempt)
