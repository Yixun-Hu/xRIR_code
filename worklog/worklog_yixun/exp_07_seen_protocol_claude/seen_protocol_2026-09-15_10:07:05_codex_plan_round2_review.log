    82	def cell_mask(e0_a, ek_a=None, e0_b=None, ek_b=None, seeds=(42, 43, 44, 45, 46)):
    83	    """H1: baseline both arms; H2: baseline/angle both; TOST: aug only.
    84	
    85	    Per-seed exclusions condition on that seed's baseline. Arm totals
    86	    condition on all five baseline seeds; joint totals on both arms.
    87	    """
    88	    if len(seeds) != 5 or len(set(seeds)) != 5:
    89	        raise ValueError("exactly five distinct seed labels are required")
    90	    if (ek_b is not None and e0_b is None) or (
    91	            e0_b is not None and (ek_a is None) != (ek_b is None)):
    92	        raise ValueError("both arms require corresponding baseline/angle arrays")
    93	    if e0_b is None and ek_a is None:
    94	        raise ValueError("a cell requires both arms or a baseline/angle pair")
    95	    baseline_masks, paired_masks, counts = [], [], {}
    96	    shape = _seed_values(e0_a).shape
    97	    arms = [("a", e0_a, ek_a)]
    98	    if e0_b is not None:
    99	        arms.append(("b", e0_b, ek_b))
   100	    for arm, base, angle in arms:
   101	        base = _seed_values(base)
   102	        angle = base if angle is None else _seed_values(angle)
   103	        if base.shape != shape or angle.shape != shape:
   104	            raise ValueError("all seed arrays must have the same query shape")
   105	        base_valid = np.isfinite(base)
   106	        paired = np.stack([valid_mask(x, y) for x, y in zip(base, angle)])
   107	        baseline_masks.append(base_valid.all(axis=0))
   108	        paired_masks.append(paired.all(axis=0))
   109	        counts[arm] = {"total": _validity_counts(baseline_masks[-1], paired_masks[-1]),
   110	                       "seeds": {str(seed): _validity_counts(b, p) for seed, b, p in
   111	                                 zip(seeds, base_valid, paired)}}
   112	    baseline, mask = np.logical_and.reduce(baseline_masks), np.logical_and.reduce(paired_masks)
   113	    counts["joint"] = _validity_counts(baseline, mask)
   114	    if not mask.any():
   115	        raise ValueError("empty cell after all-seed finite mask")
   116	    return mask, counts
