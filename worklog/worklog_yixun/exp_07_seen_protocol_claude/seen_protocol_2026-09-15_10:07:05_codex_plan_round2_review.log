   551	def _complete_attempt(attempt, mode, log_path, fields, digest, metrics, hours):
   552	    limits = tier_gates.timing_limits(fields, fields['effective_args']['CUDA_VISIBLE_DEVICES']) if mode == 'full' else None
   553	    outputs = validate_outputs(attempt, mode, fields['effective_args'], limits)
   554	    fields['mutable_inputs']['train_manifest'] = {
   555	        'path': str((attempt / 'train_manifest.json').resolve()), 'sha256': digest}
   556	    required = {'effective_args', 'train_manifest'} | ({'control_args', 'probe_receipt'} if mode == 'full' else set())
   557	    missing = required - fields['mutable_inputs'].keys()
   558	    if missing:
   559	        raise LauncherFailure('input_changed', 'missing mutable inputs: ' + ', '.join(sorted(missing)))
