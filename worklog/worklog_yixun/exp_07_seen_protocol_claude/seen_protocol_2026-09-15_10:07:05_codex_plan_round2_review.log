    51	    # point_3d[1] += 1.5528907
    52	    point_4d = np.append(point_3d, 1.0)
    53	    camera_coord_point = camera_matrix @ point_4d
    54	    return camera_coord_point[:3]
    55	
    56	
    57	def compute_energy_db(h):
    58	    h = np.array(h)
    59	    power = h ** 2
    60	    energy = np.cumsum(power[::-1])[::-1]
    61	    i_nz = np.max(np.where(energy > 0)[0])
    62	    energy = energy[:i_nz]
    63	    energy_db = 10 * np.log10(energy)
    64	    energy_db -= energy_db[0]
    65	    return  energy_db
