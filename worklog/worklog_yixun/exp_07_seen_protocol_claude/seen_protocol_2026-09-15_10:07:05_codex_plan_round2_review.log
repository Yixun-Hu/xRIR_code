    94	def set_budget(root, limits, renewal=None, commit=True):
    95	    """Validate the arm ceiling; commit=False performs a read-only preflight."""
    96	    from tools.exp04_launcher import hours_record
    97	    root = Path(root)
    98	    if any(not math.isfinite(limits[k]) or limits[k] <= 0 for k in ('ceiling_hours', 'projection_hours')):
    99	        raise ValueError('invalid cumulative ceiling or projection')
   100	    if commit:
   101	        root.mkdir(parents=True, exist_ok=True)
   102	    with (root / '.hours.lock').open('a') if commit else nullcontext() as lock:
   103	        if commit:
   104	            fcntl.flock(lock, fcntl.LOCK_EX)
   105	        record = hours_record(root)
   106	        for attempt in root.glob('attempt_*_ABORTED_slow*'):
   107	            try:
   108	                abort = json.loads((attempt / 'abort.json').read_text())
   109	                fields = json.loads((attempt / 'train_manifest.json').read_text())
   110	                digest = fields['mutable_inputs']['probe_receipt']['sha256']
   111	                if abort['reason'] != 'guard_epoch_one' or digest == limits['probe_receipt_sha256']:
   112	                    raise ValueError('slow abort requires a new probe receipt')
   113	            except (OSError, KeyError, TypeError, ValueError) as error:
   114	                raise ValueError('slow abort requires intact evidence and a new probe receipt') from error
   115	        used = sum(r['hours'] for r in record['attempts'] if r['mode'] == 'full')
   116	        ceiling = limits['ceiling_hours']
   117	        old = record.get('probe_receipt_sha256')
   118	        if old == limits['probe_receipt_sha256'] and record.get('probe_projection_hours') != limits['projection_hours']:
   119	            raise ValueError('receipt projection disagrees with cumulative ceiling')
   120	        if used or renewal is not None:
   121	            if not old or not math.isfinite(record.get('ceiling_hours', 0)) or record.get('ceiling_hours', 0) <= 0:
   122	                raise ValueError('missing or invalid cumulative ceiling')
   123	            if renewal is None:
   124	                ceiling = min(ceiling, record['ceiling_hours'])
   125	        if renewal is not None:
   126	            timestamp, separator, reason = renewal.partition(': ')
   127	            if not separator or not reason.strip():
   128	                raise ValueError('renewal requires notebook timestamp: reason')
   129	            parsed = datetime.datetime.fromisoformat(timestamp)
   130	            if parsed.tzinfo is None or timestamp != parsed.isoformat():
   131	                raise ValueError('renewal requires ISO-8601 notebook timestamp')
   132	            if limits['probe_receipt_sha256'] in [old, *record.get('probe_receipt_history', [])]:
   133	                raise ValueError('renewal requires a new clean receipt')
   134	            record.setdefault('renewals', []).append(dict(timestamp=timestamp, reason=reason.strip(),
   135	                old_ceiling=record['ceiling_hours'], new_ceiling=ceiling,
   136	                receipt_sha256=limits['probe_receipt_sha256']))
   137	        if used + limits['projection_hours'] > ceiling:
   138	            raise ValueError('cumulative hours + projection exceeds tier ceiling')
   139	        if old and old != limits['probe_receipt_sha256']:
   140	            record.setdefault('probe_receipt_history', []).append(old)
   141	        record.update(ceiling_hours=ceiling, probe_receipt_sha256=limits['probe_receipt_sha256'],
   142	                      probe_projection_hours=limits['projection_hours'])
   143	        if commit:
   144	            p.write_completion(root / 'cumulative_hours.json', record)
   145	    return dict(limits, ceiling_hours=ceiling)

