   175	            save_checkpoint(os.path.join(args.save_dir, "last.pth"), model, optimizer, scheduler,
   176	                            epoch, batch_idx, best_test_loss, args)
   177	    scheduler.step()
   178	    avg = tot / max(count, 1)
   179	    print(f"Train Epoch: {epoch}, Avg Train Loss: {avg:.5f} (stft {tot_stft / max(count, 1):.5f}, "
   180	          f"decay {tot_decay / max(count, 1):.5f}), {(time.time() - t_start) / 60:.1f} min", flush=True)
   181	    return avg
