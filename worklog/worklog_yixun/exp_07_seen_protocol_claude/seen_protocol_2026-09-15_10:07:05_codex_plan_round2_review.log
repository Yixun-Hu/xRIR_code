   200	def main():
   201	    args = parse_args()
   202	    seed_everything(args.seed)
   203	    torch.backends.cuda.matmul.allow_tf32 = args.tf32
   204	    torch.backends.cudnn.allow_tf32 = args.tf32
   205	
   206	    train_dataset = xRIR_Dataset(split="train", max_len=args.max_len, num_shot=args.num_shot)
   207	    test_dataset = xRIR_Dataset(split="test", max_len=args.max_len, num_shot=args.num_shot)
   208	    if args.test_subset and args.test_subset < len(test_dataset):
   209	        idx = np.random.RandomState(args.seed).permutation(len(test_dataset))[: args.test_subset]
   210	        test_dataset = Subset(test_dataset, sorted(idx.tolist()))
   211	    print(f"train samples: {len(train_dataset)}  test samples: {len(test_dataset)}", flush=True)
   212	
   213	    loader_kwargs = dict(num_workers=args.num_workers, pin_memory=True, worker_init_fn=seed_worker,
   214	                         persistent_workers=args.num_workers > 0)
   215	    train_loader = DataLoader(train_dataset, shuffle=True, batch_size=args.batch_size, **loader_kwargs)
   216	    test_loader = DataLoader(test_dataset, shuffle=False, batch_size=args.batch_size, **loader_kwargs)
   217	    args.train_batches_per_epoch = len(train_loader)
   218	    if args.yaw_aug and args.epochs * args.train_batches_per_epoch >= 2**20:
   219	        raise ValueError("--yaw-aug 1 requires epochs * train_batches_per_epoch < 2**20")
   220	    args.env = {key: os.environ.get(key) for key in
   221	                ("PYTHONHASHSEED", "XRIR_DATA_PATH", "OMP_NUM_THREADS", "CUDA_VISIBLE_DEVICES")}
   222	    model = build_model(args).cuda()
   223	    print("XRIR_RUNTIME_ARGS " + json.dumps(vars(args), sort_keys=True, allow_nan=False), flush=True)
   224	    if not args.no_save:
   225	        os.makedirs(args.save_dir, exist_ok=True)
   226	        with open(os.path.join(args.save_dir, "args.json"), "w") as f:
   227	            json.dump(vars(args), f, indent=2)
   228	
   229	    n_params = sum(p.numel() for p in model.parameters())
   230	    size_mb = sum(p.numel() * p.element_size() for p in model.parameters()) / 1024**2
   231	    print(f"backbone: {args.backbone}  params: {n_params / 1e6:.2f}M  model size: {size_mb:.1f}MB", flush=True)
   232	
   233	    optimizer = optim.AdamW(model.parameters(), lr=args.lr, weight_decay=args.weight_decay)
   234	    scheduler = ExponentialLR(optimizer, decay_epochs=args.decay_epochs, gamma=args.lr_gamma)
   235	
   236	    start_epoch = 1
   237	    best_test_loss = float("inf")
   238	    if args.resume:
   239	        ckpt = torch.load(args.resume, map_location="cpu")
   240	        model.load_state_dict(ckpt["model"])
   241	        optimizer.load_state_dict(ckpt["optimizer"])
   242	        scheduler.load_state_dict(ckpt["scheduler"])
   243	        best_test_loss = ckpt.get("best_test_loss", best_test_loss)
   244	        # A mid-epoch checkpoint restarts that epoch; a per-epoch checkpoint starts the next one.
   245	        start_epoch = ckpt["epoch"] if ckpt.get("batch_idx", 0) else ckpt["epoch"] + 1
   246	        print(f"resumed from {args.resume}: epoch {ckpt['epoch']} batch {ckpt.get('batch_idx', 0)} "
   247	              f"best_test_loss {best_test_loss:.5f} -> starting epoch {start_epoch}", flush=True)
   248	
   249	    history_path = os.path.join(args.save_dir, "history.jsonl")
   250	    print(f"yaw_aug ENABLED W={args.yaw_aug_width} seed={args.yaw_aug_seed} "
   251	          f"counter=(epoch-1)*{args.train_batches_per_epoch}+batch_idx" if args.yaw_aug else "yaw_aug DISABLED", flush=True)
   252	    for epoch in range(start_epoch, args.epochs + 1):
   253	        t0 = time.time()
   254	        train_loss = train_epoch(model, train_loader, optimizer, scheduler, epoch, args, best_test_loss)
   255	        test_loss = test_epoch(model, test_loader, epoch, args)
   256	        if args.no_save:
   257	            continue
   258	        is_best = test_loss < best_test_loss
   259	        if is_best:
   260	            best_test_loss = test_loss
   261	            torch.save(model.state_dict(), os.path.join(args.save_dir, "best.pth"))
   262	        if args.epoch_ckpt_every and epoch % args.epoch_ckpt_every == 0:
   263	            torch.save(model.state_dict(), os.path.join(args.save_dir, f"epoch_{epoch:03d}.pth"))
   264	        save_checkpoint(os.path.join(args.save_dir, "last.pth"), model, optimizer, scheduler,
   265	                        epoch, 0, best_test_loss, args)
   266	        with open(history_path, "a") as f:
   267	            f.write(json.dumps({"epoch": epoch, "train_loss": train_loss, "test_loss": test_loss,
   268	                                "best_test_loss": best_test_loss, "is_best": is_best,
   269	                                "lr": optimizer.param_groups[0]["lr"],
   270	                                "epoch_minutes": (time.time() - t0) / 60.0}) + "\n")
   271	        print(f"epoch {epoch} done in {(time.time() - t0) / 60:.1f} min; best test loss {best_test_loss:.5f}"
   272	              f"{' (new best)' if is_best else ''}", flush=True)
