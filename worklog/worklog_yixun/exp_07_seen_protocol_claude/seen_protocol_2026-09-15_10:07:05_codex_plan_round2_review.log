   542	def complete_attempt(attempt, mode, log_path, fields, digest, metrics, hours, transaction=None):
   543	    """Defer stop signals through validation and commit, including the caller handoff."""
   544	    with p.deferred_termination():
   545	        result = _complete_attempt(attempt, mode, log_path, fields, digest, metrics, hours)
   546	        if transaction is not None:
   547	            transaction['committed'] = True
   548	        return result
