   147	def parse_args(argv=None):
   148	    parser = evaluator.build_parser(require_eval_manifest=False)
   149	    for name in ("run-label", "reviewed-commit", "data-root", "log-dir"):
   150	        parser.add_argument("--" + name, required=True)
   151	    parser.add_argument("--num-shot", type=int, required=True)
   152	    parser.add_argument('--gpu', default='1')
   153	    parser.add_argument('--allow-dirty', action='store_true')
   154	    parser.add_argument('--bind-input', action='append', default=[], metavar='NAME=PATH')
   155	    parser.add_argument('--tier', choices=('S', 'M', 'L'))
   156	    parser.add_argument('--entry', choices=('exp04', 'exp05'), default='exp04')
   157	    args = parser.parse_args(argv)
   158	    args.entry = 'exp05' if args.tier is not None else args.entry
   159	    args.tier = args.tier or 'M'
   160	    if args.eval_manifest is not None:
   161	        parser.error("eval-manifest is created by the launcher")
   162	    for key in ("out_dir", "checkpoint", "manifest", "data_root", "log_dir"):
   163	        setattr(args, key, str(Path(getattr(args, key)).resolve()))
   164	    args.eval_manifest = str(Path(args.out_dir) / "eval_manifest.json")
   165	    return args
