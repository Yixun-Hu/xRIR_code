   426	def run_child(argv, log_path, gpu, guard, deadline=None):
   427	    child = sink = None
   428	    with log_path.open('xb') as log:
   429	        guard.log_created = True
   430	        try:
   431	            child = subprocess.Popen(argv, cwd=REPO, env=child_environment(gpu),
   432	                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
   433	            if getattr(guard, 'execution_path', None):
   434	                guard.execution.update(child_pgid=child.pid, child_exit_status=None)
   435	                p.write_completion(guard.execution_path, guard.execution)
   436	                guard.execution['spawn_execution_sha256'] = p.sha256_file(guard.execution_path)
   437	                print('EXP04_SPAWN ' + json.dumps(guard.execution, sort_keys=True), flush=True)
   438	            sink = subprocess.Popen(['tee', '-a', str(log_path)], stdin=child.stdout, stdout=2,
   439	                                    start_new_session=True)
   440	            child.stdout.close()
   441	            while child.poll() is None or sink.poll() is None:
   442	                guard.poll(log_path)
   443	                if deadline is not None and time.monotonic() > deadline:
   444	                    raise LauncherFailure('deadline_tier' if guard.tier_limits else 'deadline_43h',
   445	                                          'tier cumulative ceiling reached' if guard.tier_limits else '43 h cumulative ceiling reached')
   446	                if sink.poll() not in (None, 0):
   447	                    raise RuntimeError('log sink failed')
   448	                time.sleep(0.05)
   449	            log.flush()
   450	            os.fsync(log.fileno())
   451	            guard.poll(log_path)
   452	            if sink.returncode:
   453	                raise RuntimeError('log sink failed')
   454	            if getattr(guard, 'execution_path', None):
   455	                guard.execution.update(child_exit_status=child.returncode,
   456	                    ended_at=datetime.datetime.now().astimezone().isoformat(), log_sha256=p.sha256_file(log_path))
   457	                p.write_completion(guard.execution_path, guard.execution)
   458	            return child.returncode
   459	        finally:
   460	            p.reap_process_groups(child, sink)
