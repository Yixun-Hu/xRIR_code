    80	def paired_validity(e0, ek):
    81	    """Split a paired series into the four validity categories.
    82	
    83	    A rotation can degrade a prediction so far that the metric stops being defined at
    84	    all; that has to be reported, not silently dropped.  Conditioning on a usable
    85	    baseline separates "the rotation broke this sample" from "this sample was never
    86	    measurable".
    87	
    88	    Args:
    89	        e0: per-sample errors at ``k = 0`` (non-finite entries allowed).
    90	        ek: per-sample errors at the compared angle.
    91	
    92	    Returns:
    93	        ``{"n", "baseline_invalid", "newly_invalid", "recovered", "paired_valid",
    94	        "newly_invalid_frac"}``; the first five are ``int`` counts, and
    95	        ``newly_invalid_frac = newly_invalid / (n - baseline_invalid)`` is ``0.0`` when
    96	        no sample had a usable baseline.
    97	
    98	    Raises:
    99	        ValueError: if the two series have different lengths or are not 1-D.
   100	    """
   101	    a, b = _as_1d(e0, "e0"), _as_1d(ek, "ek")
   102	    if a.shape != b.shape:
   103	        raise ValueError("e0 and ek must have the same length, got {} and {}".format(
   104	            a.size, b.size))
   105	    finite0, finitek = np.isfinite(a), np.isfinite(b)
   106	    baseline_invalid = int(np.count_nonzero(~finite0))
   107	    usable = int(a.size) - baseline_invalid
   108	    newly_invalid = int(np.count_nonzero(finite0 & ~finitek))
   109	    return {"n": int(a.size), "baseline_invalid": baseline_invalid,
   110	            "newly_invalid": newly_invalid,
   111	            "recovered": int(np.count_nonzero(~finite0 & finitek)),
   112	            "paired_valid": int(np.count_nonzero(finite0 & finitek)),
   113	            "newly_invalid_frac": (newly_invalid / usable) if usable else 0.0}
   114	
   115	
   116	def _check_pair(e0, ek, name0="e0", namek="ek"):
   117	    """Validate one paired series and return it as float64 arrays."""
   118	    a, b = _as_1d(e0, name0), _as_1d(ek, namek)
   119	    if a.shape != b.shape:
   120	        raise ValueError("{} and {} must have the same length, got {} and {}".format(
   121	            name0, namek, a.size, b.size))
   122	    if a.size == 0:
   123	        raise ValueError("{}/{} are empty".format(name0, namek))
   124	    if not (np.isfinite(a).all() and np.isfinite(b).all()):
   125	        raise ValueError("{}/{} must be finite; mask them with valid_mask() first".format(
   126	            name0, namek))
   127	    if a.mean() == 0.0:
   128	        raise ValueError("mean({}) == 0, the relative degradation is undefined".format(name0))
   129	    return a, b
