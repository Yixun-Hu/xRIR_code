    53	    admitted = admit_runs(profile, groups, approved=approved, producer=producer,
    54	                          producer_key='producer_results_table')
    55	    rows = []
    56	    for (arm, shot, _), runs in zip(groups, admitted['groups']):
    57	        cells = [run['P']['0'] for run in runs]
    58	        names = set().union(*(set(cell) for cell in cells))
    59	        if names - set(METRICS):
    60	            raise ValueError('unknown metric names: ' + ', '.join(sorted(names - set(METRICS))))
    61	        if any(set(cell) != names for cell in cells):
    62	            raise ValueError('metric coverage differs across seeds')
    63	        metrics = {}
    64	        for source, specification in METRICS.items():
    65	            if specification is None or source not in names:
    66	                continue
    67	            name, unit, scale = specification
    68	            per_seed = {}
    69	            for run, cell in zip(runs, cells):
    70	                values = np.asarray(cell[source], dtype=float)
    71	                finite = values[np.isfinite(values)]
    72	                if not finite.size:
    73	                    raise ValueError('zero finite queries: ' + source)
    74	                per_seed[str(run['meta']['manifest_seed'])] = {
    75	                    'mean': float(finite.mean() * scale), 'n_finite': int(finite.size)}
    76	            counts = [v['n_finite'] for v in per_seed.values()]
    77	            if max(counts) - min(counts) > profile['finite_count_tolerance']:
    78	                raise ValueError('finite count tolerance exceeded: ' + source)
    79	            means = np.asarray([v['mean'] for v in per_seed.values()])
    80	            if not np.isfinite(means).all():
    81	                raise ValueError('nonfinite seed mean: ' + source)
    82	            metrics[name] = dict(source=source, unit=unit, mean=float(means.mean()),
    83	                                 sd=float(means.std(ddof=1)), per_seed=per_seed)
    84	        protocol = dict(num_shot=shot, split=profile['dataset']['split'],
    85	            n_queries=profile['dataset']['n_queries'], seeds=sorted(profile['seeds'][shot]),
    86	            epoch=arm['epoch'], condition=profile['condition'], k=0,
    87	            batch_size=profile['batch_size'], tf32=profile['tf32'], max_samples=profile['max_samples'])
    88	        rows.append(dict(role=arm['role'], label=arm['label'], num_shot=shot,
    89	                         epoch=arm['epoch'], protocol=protocol, metrics=metrics))
    90	    literal = json.loads(json.dumps(json_value(profile)))
    91	    digest = hashlib.sha256(json.dumps(literal, sort_keys=True,
    92	        separators=(',', ':'), allow_nan=False).encode()).hexdigest()
    93	    return dict(schema_version=1, profile_name='TABLE_V1', profile=literal,
    94	                profile_digest=digest, inputs=admitted['inputs'],
    95	                producer_closure_sha256=producer['sha256'], rows=rows), admitted
