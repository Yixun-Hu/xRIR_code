   572	    recovered_log = Path(fields.get('log_path', str(log_path)))
   573	    recovered = Path(fields.get('attempt_path', str(attempt)))
   574	    if recovered != attempt:
   575	        if recovered.parent != attempt.parent or not attempt.name.startswith(recovered.name + '_ABORTED_'):
   576	            raise ValueError('invalid recovered attempt path')
   577	        if os.path.lexists(recovered):
