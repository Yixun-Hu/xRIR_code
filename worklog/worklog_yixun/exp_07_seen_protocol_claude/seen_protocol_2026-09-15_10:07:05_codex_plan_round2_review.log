   325	class LogGuard:
   326	    def __init__(self, expected, mode, attempt=None, limits=None):
   327	        self.expected, self.mode = expected, mode
   328	        self.output_dir = Path(attempt) if attempt else REPO / expected.get('save_dir', '.')
   329	        self.runtime = None
   330	        self.banner = False
   331	        self.steps, self.losses = [], []
   332	        self.test_loss = None
   333	        self.position = 0
   334	        self.first_step_time = None
   335	        self.epoch_one_done = False
   336	        self.probe = None
   337	        self.log_created = False
   338	        self.epoch_limit_seconds = limits['epoch_seconds'] if limits else 2.431 * 3600
   339	        self.live_epoch_limit_seconds = limits['epoch_seconds'] if limits else 2.6 * 3600
   340	        self.tier_limits = limits
   341	
   342	    def runtime_payload(self, payload):
   343	        try:
   344	            actual = json.loads(payload.read_text() if isinstance(payload, Path) else payload)
   345	            check_runtime(actual, self.expected, self.mode)
   346	            return actual
   347	        except (OSError, ValueError, TypeError, AttributeError, KeyError) as error:
   348	            raise LauncherFailure('guard_runtime_args', str(error)) from error
   349	
   350	    def feed(self, line):
   351	        prefix = 'EXP04_PROBE_RESULT ' if self.expected.get('tier', 'M') == 'M' else 'EXP05_PROBE_RESULT '
   352	        if line.startswith(('EXP04_PROBE_RESULT ', 'EXP05_PROBE_RESULT ')):
   353	            if not line.startswith(prefix):
   354	                raise ValueError('probe result prefix differs from tier')
   355	            self.probe = json.loads(line[len(prefix):])
   356	        if line.startswith('XRIR_RUNTIME_ARGS '):
   357	            self.runtime = self.runtime_payload(line[len('XRIR_RUNTIME_ARGS '):])
   358	        wanted = ('yaw_aug ENABLED W={yaw_aug_width} seed={yaw_aug_seed} '
   359	                  'counter=(epoch-1)*{train_batches_per_epoch}+batch_idx'.format(**self.expected)
   360	                  if self.expected['yaw_aug'] else 'yaw_aug DISABLED')
   361	        if line.strip() == wanted:
   362	            if self.banner:
   363	                raise LauncherFailure('guard_banner', 'duplicate banner')
   364	            self.banner = True
   365	            if self.tier_limits and self.mode == 'full':
   366	                self.first_step_time = time.monotonic()
   367	        step = re.search(r'Train Epoch: (\d+) \[(\d+)/(\d+)\].*?loss (\S+)', line)
   368	        if step:
   369	            if not self.banner or self.runtime is None:
   370	                raise LauncherFailure('guard_banner', 'first step without banner or runtime args')
   371	            if self.mode == 'full':
   372	                runtime = self.output_dir / 'args.json'
   373	                self.runtime_payload(runtime)
   374	            values = re.findall(r'(?:loss |stft |decay )([^\s,)]+)', line)
   375	            if not values or not all(math.isfinite(float(value)) for value in values):
   376	                raise ValueError('non-finite training loss')
   377	            self.first_step_time = self.first_step_time or time.monotonic()
   378	            self.steps.append((int(step[1]), int(step[2])))
   379	            self.losses.append(float(step[4]))
   380	        if line.startswith('Test set (epoch 1):'):
   381	            match = re.search(r'Average loss: (\S+) over (\d+) batches', line)
   382	            self.test_loss = float(match[1])
   383	            if not math.isfinite(self.test_loss) or (self.mode == 'smoke' and int(match[2]) != 2):
   384	                raise ValueError('invalid test loss/count')
   385	        if line.startswith('epoch 1 done'):
   386	            self.epoch_one_done = True
   387	            if self.mode == 'full':
   388	                history = self.output_dir / 'history.jsonl'
   389	                first = json.loads(history.read_text().splitlines()[0])
   390	                limit = self.epoch_limit_seconds / 60 if self.tier_limits else 2.431 * 60
   391	                if not math.isfinite(first['epoch_minutes']) or first['epoch_minutes'] > limit:
   392	                    raise LauncherFailure('guard_epoch_one', 'epoch one exceeds timing acceptance' if self.tier_limits
   393	                                          else 'epoch one exceeds 2.431 h acceptance')
   394	
   395	    def poll(self, path):
   396	        with path.open() as stream:
   397	            stream.seek(self.position)
   398	            while True:
   399	                line = stream.readline()
   400	                if not line.endswith('\n'):
   401	                    break
   402	                self.position = stream.tell()
   403	                self.feed(line)
   404	        if (self.mode == 'full' and self.first_step_time and not self.epoch_one_done
   405	                and time.monotonic() - self.first_step_time > self.live_epoch_limit_seconds):
   406	            raise LauncherFailure('guard_epoch_one', 'epoch one exceeds probe acceptance' if self.tier_limits
   407	                                  else 'epoch one exceeds 2.6 h operational ceiling')
   408	
   409	    def finish(self):
   410	        if not self.banner or not self.runtime or not self.steps:
   411	            raise LauncherFailure('guard_banner', 'missing runtime args, banner or steps')
   412	        if self.mode == 'smoke' and (self.steps != [(1, 0), (1, 1), (1, 2)] or self.test_loss is None):
   413	            raise ValueError('smoke requires three finite steps and test loss')
   414	        if self.mode == 'probe' and (not self.probe or self.probe.get('yaw_aug') != self.expected['yaw_aug']
   415	                or self.probe.get('warmup_micro_batches') != 10 or self.probe.get('timed_micro_batches') != 50
   416	                or not math.isfinite(self.probe.get('mean_iteration_seconds', float('nan')))
   417	                or self.probe['mean_iteration_seconds'] <= 0):
   418	            raise ValueError('missing or invalid probe result')
   419	        if self.mode == 'probe' and self.expected.get('tier', 'M') != 'M':
   420	            tier_probe.projection(self.probe)
   421	            if any(self.probe.get(k) != self.expected[k] for k in ('tier', 'backbone')):
   422	                raise ValueError('probe tier/backbone mismatch')
   423	        return dict(train_losses=self.losses, test_loss=self.test_loss, banner=self.banner, probe=self.probe)
