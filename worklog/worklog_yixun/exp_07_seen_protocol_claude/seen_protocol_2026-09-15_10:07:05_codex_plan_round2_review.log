   119	def _samples(pairs, n_boot, seed, clusters):
   120	    if isinstance(n_boot, bool) or not isinstance(n_boot, numbers.Integral):
   121	        raise TypeError("n_boot must be an integer")
   122	    if n_boot < 1:
   123	        raise ValueError("n_boot must be positive")
   124	    pairs = [(np.asarray(a, dtype=np.float64), np.asarray(b, dtype=np.float64))
   125	             for a, b in pairs]
   126	    return _bootstrap_ratios(pairs, int(n_boot), seed, clusters)
