   491	def abort_log(log_path, reason, created):
   492	    if not created:
   493	        return None
   494	    destination = log_path.with_name(log_path.stem + '_ABORTED_' + reason + '.log')
   495	    if destination.exists():
   496	        destination = destination.with_name(destination.stem + '_' + uuid.uuid4().hex + '.log')
   497	    try:
   498	        log_path.rename(destination)
   499	        return str(destination.resolve())
