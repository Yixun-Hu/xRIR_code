   300	def revalidate(manifest, required=(), source_drift=None):
   301	    """Rehash declared inputs; missing required keys and missing files are mismatches.
   302	
   303	    A launcher adds eval_manifest={path, sha256} in memory after exclusive creation,
   304	    avoiding a self-referential digest in the serialized manifest itself.
   305	    """
   306	    mismatches = ['missing.' + key for key in required if key not in manifest]
   307	    repo = Path(manifest.get('repo', '.'))
   308	    def check(label, path, expected):
   309	        try:
   310	            actual = sha256_file(path)
   311	        except OSError:
   312	            actual = None
   313	        if expected is None or actual != expected:
   314	            mismatches.append(label)
   315	    for key, digest in [('checkpoint', 'checkpoint_sha256'),
   316	                         ('manifest_path', 'manifest_file_sha256')]:
   317	        if key in manifest:
   318	            check(key, repo / manifest[key], manifest.get(digest))
   319	    for name, record in manifest.get('mutable_inputs', {}).items():
   320	        check(name, repo / record['path'], record.get('sha256'))
   321	    if 'eval_manifest' in manifest:
   322	        record = manifest['eval_manifest']
   323	        check('eval_manifest', record['path'], record.get('sha256'))
   324	    closures = dict(manifest.get('source_closures', {}))
   325	    if 'evaluator_closure' in manifest:
   326	        closures['evaluator'] = manifest['evaluator_closure']
   327	    for name, closure in closures.items():
   328	        if source_drift is not None:
   329	            expected = hashlib.sha256(json.dumps([[r['path'], r['reviewed_blob_sha256']]
   330	                for r in closure['files']], sort_keys=True).encode()).hexdigest()
   331	            if closure.get('sha256') != expected:
   332	                mismatches.append('source.' + name + '.sha256')
   333	        for record in closure['files']:
   334	            if source_drift is not None:
   335	                blob = subprocess.run(['git', 'show', '{}:{}'.format(manifest['reviewed_commit'], record['path'])],
   336	                                      cwd=repo, capture_output=True)
   337	                digest = record.get('reviewed_blob_sha256')
   338	                if (blob.returncode or hashlib.sha256(blob.stdout).hexdigest() != digest
   339	                        or digest != record.get('working_tree_sha256')):
   340	                    mismatches.append('source.{}.{}'.format(name, record['path']))
   341	                try:
   342	                    now = sha256_file(repo / record['path'])
   343	                except OSError:
   344	                    now = None
   345	                drift = dict(path=record['path'], spawn_sha256=record.get('working_tree_sha256'), now_sha256=now)
   346	                if now != drift['spawn_sha256'] and drift not in source_drift:
   347	                    source_drift.append(drift)
   348	                continue
   349	            check('source.{}.{}'.format(name, record['path']), repo / record['path'],
   350	                  record.get('working_tree_sha256'))
   351	    for key in ('data_identity', 'train_data_identity'):
   352	        if key not in manifest:
   353	            continue
   354	        identity = manifest[key]
   355	        inventory = identity.get('inventory')
   356	        if inventory is None:
   357	            try:
   358	                sidecar = identity['inventory_file']
   359	                check(key + '.inventory_file', sidecar['path'], sidecar.get('sha256'))
   360	                inventory = json.loads(Path(sidecar['path']).read_text())['inventory']
   361	            except (OSError, KeyError, ValueError, TypeError):
   362	                mismatches.append(key + '.inventory_file')
   363	                continue
   364	        for record in inventory:
   365	            check(key + '.' + record['path'], Path(identity['data_root']) / record['path'],
   366	                  record.get('sha256'))
   367	        if 'manifest_path' in identity:
   368	            check(key + '.manifest_path', identity['manifest_path'], identity.get('manifest_file_sha256'))
   369	        if _inventory_digest(inventory) != identity.get('inventory_sha256'):
   370	            mismatches.append(key + '.inventory_sha256')
   371	    return mismatches
