    67	def invalid_fraction(ek):
    68	    """Fraction of *all* non-finite entries in one series (0.0 when empty).
    69	
    70	    This is a marginal count: it does not distinguish a sample that was already invalid
    71	    at ``k = 0`` from one the rotation broke.  For the paired split -- which is the
    72	    degradation indicator -- use :func:`paired_validity`.
    73	    """
    74	    a = _as_1d(ek, "ek")
    75	    if a.size == 0:
    76	        return 0.0
    77	    return float(np.count_nonzero(~np.isfinite(a)) / a.size)
