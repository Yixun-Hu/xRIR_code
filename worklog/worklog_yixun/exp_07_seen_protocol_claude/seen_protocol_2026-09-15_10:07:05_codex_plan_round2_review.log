   269	    main()
   225	def _inventory_digest(records):
   226	    return hashlib.sha256(json.dumps([[r['path'], r['sha256']] for r in records],
   227	                                    sort_keys=True).encode()).hexdigest()
   228	
   229	
   230	def _inventory(files, data_root, workers=8):
   231	    root = Path(data_root).resolve()
   232	    def record(name):
   233	        path = root / name
   234	        path.resolve().relative_to(root)
   235	        before = path.stat()
   236	        digest = sha256_file(path)
   237	        after = path.stat()
   238	        if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
   239	            raise ValueError('data changed while hashing: ' + name)
   240	        return {'path': name, 'sha256': digest, 'size': after.st_size,
   241	                'mtime_ns': after.st_mtime_ns}
   242	    with ThreadPoolExecutor(max_workers=workers) as pool:
   243	        records = list(pool.map(record, sorted(set(files))))
   244	    # Missing files raise above; retain the zero field for exp_03 schema compatibility.
   245	    return {'data_root': str(root), 'inventory': records, 'inventory_files': len(records),
   246	        'inventory_missing': 0, 'inventory_bytes': sum(r['size'] for r in records),
   247	        'inventory_sha256': _inventory_digest(records)}
   248	
