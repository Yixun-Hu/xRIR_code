   129	def _sample_metadata(result, samples, n_boot, seed):
   130	    for key in ("lo", "hi", "alpha"):
   131	        result.pop(key, None)
   132	    result.update(samples=samples, n_boot=int(n_boot), seed=seed)
   133	    return result
