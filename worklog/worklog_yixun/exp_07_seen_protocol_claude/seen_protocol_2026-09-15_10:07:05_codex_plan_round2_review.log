   192	def _capture_environment(repo, data_root, gpu='1'):
   193	    code = "from tools.provenance import environment; import json; print(json.dumps(environment()))"
   194	    output = subprocess.check_output([sys.executable, "-c", code], cwd=repo, text=True,
   195	                                     env=child_environment(repo, data_root, gpu))
   196	    return json.loads(output.splitlines()[-1])
