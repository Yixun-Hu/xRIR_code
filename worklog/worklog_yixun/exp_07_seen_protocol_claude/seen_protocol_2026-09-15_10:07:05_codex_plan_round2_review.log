   514	def assert_quiescent(pgid, log_path):
   515	    """Require a gone group and no fuser-visible writers (ordinary user permissions).
   516	
   517	    The execution receipt separately requires successful child and tee completion;
   518	    fuser, like /proc inspection, cannot inspect inaccessible users' descriptors.
   519	    """
   520	    if type(pgid) is not int or pgid <= 0:
   521	        raise ValueError('missing or invalid recorded process group')
   522	    try:
   523	        os.killpg(pgid, 0)
   524	    except ProcessLookupError:
   525	        pass
   526	    else:
   527	        raise ValueError('child process group is still present')
   528	    log_path.stat()
   529	    result = subprocess.run(['fuser', '-I', '-v', str(log_path.resolve())],
   530	        capture_output=True, text=True, env=dict(os.environ, LC_ALL='C'))
   531	    access = re.findall(r'^\s+\S+\s+([.cefrmF]{5})\s+\S+', result.stderr, re.M)
   532	    pids = result.stdout.split()
   533	    if (result.returncode not in (0, 1) or
   534	            result.returncode == 0 and (not access or len(access) != len(pids) or
   535	                                       not all(pid.isdigit() for pid in pids)) or
   536	            result.returncode == 1 and (result.stdout.strip() or result.stderr.strip())):
   537	        raise ValueError('cannot inspect log writers with fuser')
   538	    if any('F' in flags for flags in access):
   539	        raise ValueError('log writer still open: ' + result.stdout.strip())
