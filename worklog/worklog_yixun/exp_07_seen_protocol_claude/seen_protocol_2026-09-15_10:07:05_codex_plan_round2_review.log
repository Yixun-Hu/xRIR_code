    51	@p.termination_handlers()
    52	def execute_run(args, command, fields_factory, repo):
    53	    """Own exclusive creation, spawn, digest revalidation and atomic finalisation."""
    54	    run = Path(args.out_dir).resolve()
    55	    run.mkdir()  # Deliberately before input hashing and outside abort handling.
    56	    reason = "setup_failed"
    57	    log_path = None
    58	    log_created = False
    59	    committed = False
    60	    started = datetime.datetime.now().astimezone()
    61	    try:
    62	        log_dir = Path(args.log_dir).resolve()
    63	        if run == log_dir or run in log_dir.parents:
    64	            raise ValueError("log-dir must be outside out-dir")
    65	        log_dir.mkdir(parents=True, exist_ok=True)
    66	        stamp = datetime.datetime.now().astimezone().strftime("%Y-%m-%d_%H:%M:%S.%f")
    67	        label = args.run_label
    68	        if not label or Path(label).name != label or label in (".", ".."):
    69	            raise ValueError("run-label must be a filename component")
    70	        log_path = log_dir / (label + "_" + stamp + ".log")
    71	        fields = dict(fields_factory(), schema_version=1)
    72	        manifest_path = run / "eval_manifest.json"
    73	        digest = p.write_manifest(manifest_path, fields)
    74	        reason = "log_exists"
    75	        with log_path.open("xb"):
    76	            log_created = True
    77	        reason = "child_failed"
    78	        status = _run_child(command, log_path, repo, args.data_root, args.gpu)
    79	        if status:
    80	            raise RuntimeError(reason)
    81	        reason = "output_invalid"
    82	        listing = sorted(item.name for item in run.iterdir())
    83	        if listing != sorted(["eval_manifest.json", *OUTPUTS]):
    84	            raise RuntimeError(reason)
    85	        expected = dict(eval_manifest_sha256=digest, conditions=fields["conditions"],
    86	                        n_samples=fields["n_samples"])
    87	        tier_fields = {key: fields[key] for key in TIER_FIELDS} if 'tier' in fields else {}
    88	        expected.update(tier_fields)
    89	        for name in OUTPUTS:
    90	            payload = json.loads((run / name).read_text())
    91	            meta = payload.get("meta", {})
    92	            if any(type(meta.get(key)) is not type(value) or
    93	                   json.dumps(meta.get(key), sort_keys=True) != json.dumps(value, sort_keys=True)
    94	                   for key, value in expected.items()):
    95	                raise ValueError("output meta mismatch: " + name)
    96	            if name == "per_sample_yaw.json" and (not isinstance(payload.get("query"), list)
    97	                    or len(payload["query"]) != fields["n_samples"]):
    98	                raise ValueError("output query count mismatch")
    99	        with p.deferred_termination():
   100	            reason = "input_changed"
   101	            declared = dict(fields, eval_manifest={"path": str(manifest_path), "sha256": digest})
   102	            mismatches = p.revalidate(declared, required=REQUIRED_INPUTS)
   103	            if mismatches:
   104	                raise ValueError("mutable input mismatch: " + ", ".join(mismatches))
   105	            reason = "output_invalid"
   106	            completion = {"schema_version": 1, "eval_manifest_sha256": digest,
   107	                          "confirmatory": fields['confirmatory'], "allow_dirty_used": fields['allow_dirty_used'],
   108	                          "directory_listing": listing, "child_exit_status": status,
   109	                          "started_at": started.isoformat(),
   110	                          "ended_at": datetime.datetime.now().astimezone().isoformat(),
   111	                          "log": {"path": str(log_path), "sha256": p.sha256_file(log_path)},
   112	                          "outputs": {name: p.sha256_file(run / name) for name in OUTPUTS}}
   113	            completion.update(tier_fields)
   114	            p.write_completion(run / "completion.json", completion)
   115	            committed = True
   116	        return completion
   117	    except BaseException as error:
   118	        if committed:
   119	            print('CERTIFIED ' + str(run), flush=True)
   120	            raise
   121	        reason = p.masked_abort_reason(error, reason)
   122	        renamed = None
   123	        if log_created:
   124	            try:
   125	                aborted_log = log_path.with_name(log_path.stem + "_ABORTED_" + reason + ".log")
   126	                if aborted_log.exists():
   127	                    aborted_log = aborted_log.with_name(aborted_log.stem + "_" + uuid.uuid4().hex + ".log")
   128	                log_path.rename(aborted_log)
   129	                renamed = str(aborted_log)
   130	            except OSError:
   131	                pass  # Preserve the original failure if the log cannot be renamed.
   132	        ended = datetime.datetime.now().astimezone()
   133	        p.write_completion(run / 'abort.json', dict(reason=reason, exception_type=type(error).__name__,
   134	            exception_message=str(error), started_at=started.isoformat(), aborted_at=ended.isoformat(),
   135	            wall_hours=(ended - started).total_seconds() / 3600,
   136	            log={'original': str(log_path) if log_path else None, 'aborted': renamed}))
   137	        completion_path = run / "completion.json"
   138	        if completion_path.exists():
   139	            completion_path.unlink()
   140	        aborted = run.with_name(run.name + "_ABORTED_" + reason)
   141	        if aborted.exists():
   142	            aborted = aborted.with_name(aborted.name + "_" + uuid.uuid4().hex)
   143	        run.rename(aborted)
   144	        raise
