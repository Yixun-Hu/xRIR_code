   504	def diagnostic_value(value):
   505	    if isinstance(value, dict):
   506	        return {k: diagnostic_value(v) for k, v in value.items()}
   507	    if isinstance(value, (list, tuple)):
   508	        return [diagnostic_value(v) for v in value]
   509	    if isinstance(value, Path) or isinstance(value, float) and not math.isfinite(value):
   510	        return str(value)
   511	    return value
