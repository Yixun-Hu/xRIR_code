   102	def render_markdown(json_path, generation_command=None):
   103	    """Read all table content from JSON; the sidecar supplies only command provenance.
   104	
   105	    During publication the writer supplies that command before finalizing the sidecar.
   106	    No run directories are opened, including when regenerating an existing table.
   107	    """
   108	    path = Path(json_path).absolute()
   109	    raw = path.read_bytes()
   110	    digest = hashlib.sha256(raw).hexdigest()
   111	    result = json.loads(raw)
   112	    sidecar = Path(str(path) + '.provenance.json')
   113	    if sidecar.exists():
   114	        receipt = json.loads(sidecar.read_text())
   115	        if receipt['outputs'].get(str(path)) != digest:
   116	            raise ValueError('canonical JSON digest mismatch')
   117	        generation_command = receipt['generation_command']
   118	    lines = [BEGIN, '# Model comparison', '',
   119	        'Mean ± sample SD over five evaluation seeds (42–46). Each seed selects the K-specific '
   120	        'reference manifest and the Griffin-Lim phase. Each seed mean uses its finite queries; '
   121	        'per-seed finite counts are recorded in the canonical JSON. '
   122	        'Values are rounded to 6 significant digits; the JSON is canonical.', '']
   123	    columns = ('T60', 'C50', 'EDT', 'loss', 'log_mse')
   124	    lines += ['| Model | K | T60 (%) | C50 (dB) | EDT (ms) | Loss (objective) | Log-STFT MSE | Protocol |',
   125	             '| --- | --- | --- | --- | --- | --- | --- | --- |']
   126	    for row in result['rows']:
   127	        cells = ['{:.6g} ± {:.6g}'.format(row['metrics'][name]['mean'], row['metrics'][name]['sd'])
   128	                 if name in row['metrics'] else '—' for name in columns]
   129	        protocol = row['protocol']
   130	        description = ('K = {num_shot}; {split}; {n_queries} queries; ' +
   131	            '{} seeds; epoch {{epoch}}; {{condition}}; k = {{k}}; batch {{batch_size}}; TF32 {{precision}}'
   132	            .format(len(protocol['seeds']))).format(**protocol, precision='on' if protocol['tf32'] else 'off')
   133	        lines.append('| ' + ' | '.join([row['label'], str(row['num_shot'])] + cells + [description]) + ' |')
   134	    lines += ['', '## Protocol', '',
   135	        'Rows report K, {dataset[split]} split query count, seed count, epoch, condition {condition}, '
   136	        'standalone k = {grid[0]}, canonical batch {batch_size}, and TF32 {precision}. '
   137	        'max_samples = {max_samples}; no test-time augmentation.'.format(
   138	            **result['profile'], precision='on' if result['profile']['tf32'] else 'off'),
   139	        'Finite-count tolerance: {} queries between seeds in each row/metric; empty seeds are refused.'
   140	        .format(result['profile']['finite_count_tolerance']), '', '## Provenance', '',
   141	        'Canonical JSON: `{}`; sha256: `{}`.'.format(path, digest),
   142	        'Profile digest: `{}`.'.format(result['profile_digest']), '', 'Generation command:',
   143	        '```sh', shlex.join(generation_command or []), '```']
   144	    body = '\n'.join(lines) + '\n'
   145	    return body + STAMP + hashlib.sha256(body.encode()).hexdigest() + ' -->\n' + END + '\n'
