    29	
    30	def _run_child(command, log_path, repo, data_root, gpu='1'):
    31	    """Run a literal argv through tee; both processes finish before the log closes."""
    32	    env = child_environment(repo, data_root, gpu)
    33	    child = sink = None
    34	    with log_path.open("ab") as log:
    35	        try:
    36	            child = subprocess.Popen(command, cwd=repo, env=env, stdout=subprocess.PIPE,
    37	                                     stderr=subprocess.STDOUT, start_new_session=True)
    38	            sink = subprocess.Popen(["tee", "-a", str(log_path)], stdin=child.stdout, stdout=2,
    39	                                    start_new_session=True)
    40	            child.stdout.close()
    41	            status = child.wait()
    42	            if sink.wait():
    43	                raise RuntimeError("log_sink")
    44	            log.flush()
    45	            os.fsync(log.fileno())
    46	            return status
    47	        finally:
    48	            p.reap_process_groups(child, sink)
    49	
