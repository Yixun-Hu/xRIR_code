   227	def main(argv=None):
   228	    parser = argparse.ArgumentParser(description=__doc__)
   229	    parser.add_argument('--profile', choices=('TABLE_V1',), required=True)
   230	    parser.add_argument('--runs', nargs='+', required=True)
   231	    parser.add_argument('--json', required=True)
   232	    parser.add_argument('--md', required=True)
   233	    parser.add_argument('--force-md', action='store_true', help='Regenerate Markdown; JSON is always exclusive')
   234	    argv = sys.argv[1:] if argv is None else argv
   235	    args = parser.parse_args(argv)
   236	    result, admitted = build_table(args.runs)
   237	    command = ['results_table.py', '--profile', args.profile, '--runs'] + [str(Path(d).resolve()) for d in args.runs]
   238	    command += ['--json', str(Path(args.json).absolute()), '--md', str(Path(args.md).absolute())]
   239	    write_outputs(result, admitted, args.json, args.md, args.force_md, command + (['--force-md'] if args.force_md else []))
   240	    return result
