    91	    batch, n_real = yaw.pad_batch(batch, batch_size)
    92	    _, src, depth, target, refs, locations, keys = batch
    93	    src, depth = src.cuda(), depth.cuda()
    94	    target, refs, locations = target.cuda(), refs.cuda(), locations.cuda()
    95	    keys = list(keys)[:n_real]
    96	    with yaw.torch.no_grad():
    97	        aligned0 = model.shift_and_align(refs, src, locations)
    98	        baseline, _ = model(depth, refs, src, locations, target)
    99	    baseline, target_real = baseline[:n_real], target[:n_real]
   100	    results = {}
   101	    for k in cols:
   102	        depth_k, src_k, locations_k = yaw.rotated_views(depth, src, locations, k)
   103	        with yaw.torch.no_grad(), yaw.fixed_alignment(model, aligned0):
   104	            prediction, spectrum = model(depth_k, refs, src_k, locations_k, target)
   105	        prediction, spectrum = prediction[:n_real], spectrum[:n_real]
   106	        cell = {name: values.double().numpy() for name, values in
   107	                yaw.spectral_metrics(prediction, baseline, spectrum).items()}
   108	        if int(k) in acoustic_cols:
   109	            cell.update(yaw.acoustic_metrics_batch(prediction, target_real, keys, evaluator, gl_seed))
   110	        results[("P", int(k))] = cell
   111	    return keys, results, yaw.delay_flip_counts(src[:n_real], locations[:n_real], cols)
