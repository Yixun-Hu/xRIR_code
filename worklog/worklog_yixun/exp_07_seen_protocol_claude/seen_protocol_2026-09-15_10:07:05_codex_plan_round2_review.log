   250	def data_identity(manifest_path, data_root):
   251	    """Hash every query/reference IR, its unpadded-id metadata, and receiver depth."""
   252	    from tools.reference_manifest import load_manifest, manifest_hash
   253	    manifest = load_manifest(manifest_path)
   254	    files = set()
