   173	def convergence(fn, seed_a=0, seed_b=1, tol=0.10):
   174	    """Maximum endpoint movement / seed-a width on the specified companion.
   175	
   176	    The caller supplies the profile's decision companion (and H1 superiority
   177	    companion separately). Identical zero-width intervals pass; changed ones
   178	    fail. Non-finite or reversed intervals fail closed.
   179	    """
   180	    if not np.isfinite(tol) or tol < 0:
   181	        raise ValueError("convergence tolerance must be finite and nonnegative")
   182	    intervals = []
   183	    for seed in (seed_a, seed_b):
   184	        value = fn(seed)
   185	        if isinstance(value, dict):
   186	            value = (value["lo"], value["hi"])
   187	        interval = np.asarray(value, dtype=float)
   188	        if interval.shape != (2,):
   189	            raise ValueError("convergence requires two interval endpoints")
   190	        intervals.append(interval)
   191	    a, b = intervals
   192	    finite = np.isfinite(intervals).all() and a[0] <= a[1] and b[0] <= b[1]
   193	    width = float(a[1] - a[0]) if finite else float("nan")
   194	    movement = float(np.max(np.abs(a - b))) if finite else float("inf")
   195	    ratio = (movement / width if width > 0 else
   196	             0.0 if finite and movement == 0 else float("inf"))
   197	    return {"passed": bool(finite and ratio <= tol), "movement": movement,
   198	            "width": width, "ratio": ratio, "tolerance": tol,
   199	            "seed_a": {"seed": seed_a, "lo": float(a[0]), "hi": float(a[1])},
   200	            "seed_b": {"seed": seed_b, "lo": float(b[0]), "hi": float(b[1])}}
   201	
   202	
   203	def h1_verdict(edt_upper, c50_upper, margin=0.03):
   204	    edt = np.isfinite(edt_upper) and edt_upper < margin
   205	    c50 = np.isfinite(c50_upper) and c50_upper < margin
   206	    if edt and c50:
   207	        return "non-inferior"
   208	    if edt or c50:
   209	        return "non-inferior on {} only".format("EDT" if edt else "C50")
   210	    return "not shown"
   211	
   212	
   213	def superiority(upper):
   214	    """Use the upper endpoint of H1's adjusted two-sided companion."""
   215	    return bool(np.isfinite(upper) and upper < 0)
   216	
   217	
   218	def h2_verdict(c50_uppers):
   219	    if len(c50_uppers) != 4:
   220	        raise ValueError("H2 requires the four primary C50 cells")
   221	    passes = sum(np.isfinite(bound) and bound < 0 for bound in c50_uppers)
   222	    return "supported" if passes == 4 else "partially supported" if passes else "not supported"
   223	
   224	
   225	def tost_verdict(lo, hi, margin=0.02):
   226	    equivalent = np.isfinite([lo, hi, margin]).all() and 0 < margin and -margin < lo <= hi < margin
   227	    return "equivalent" if equivalent else "equivalence not established"
