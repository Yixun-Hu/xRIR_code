    43	def convert_equirect_to_camera_coord(depth_map, img_h, img_w):
    44	    phi, theta = torch.meshgrid(torch.arange(img_h), torch.arange(img_w))
    45	    theta_map = (theta + 0.5) * 2.0 * np.pi / img_w - np.pi
    46	    phi_map = (phi + 0.5) * np.pi / img_h - np.pi / 2
    47	    sin_theta = torch.sin(theta_map)
    48	    cos_theta = torch.cos(theta_map)
    49	    sin_phi = torch.sin(phi_map)
    50	    cos_phi = torch.cos(phi_map)
    51	    # print("GGG ", depth_map.max(), depth_map.min())
    52	    return torch.stack([depth_map * cos_phi * cos_theta, depth_map * cos_phi * sin_theta, -depth_map * sin_phi], dim=-1)
