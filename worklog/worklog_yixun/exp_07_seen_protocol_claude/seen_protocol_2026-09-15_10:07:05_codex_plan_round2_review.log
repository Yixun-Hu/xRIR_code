   189	def write_outputs(result, admitted, json_path, md_path, force_md=False, command=()):
   190	    paths = [Path(json_path).absolute(), Path(md_path).absolute(),
   191	             Path(str(json_path) + '.provenance.json').absolute()]
   192	    if (len({p.resolve() for p in paths}) != 3 or any(p.is_symlink() for p in paths)
   193	            or any(os.path.lexists(paths[i]) for i in (0, 2))
   194	            or (os.path.lexists(paths[1]) and not force_md)):
   195	        raise FileExistsError('output paths must be distinct and absent; --force-md permits Markdown only')
   196	    if any(str(path.resolve()) in admitted['inputs'] for path in paths):
   197	        raise ValueError('output overlaps an input')
   198	    previous = paths[1].read_bytes() if paths[1].exists() else None
   199	    data, created = _json_bytes(result), []
   200	    recheck_inputs(admitted)
   201	    try:
   202	        _publish(paths[0], data)
   203	        created.append(paths[0])
   204	        markdown = _preserve_manual(render_markdown(paths[0], command), previous).encode()
   205	        receipt = dict(schema_version=1, profile_digest=result['profile_digest'],
   206	            inputs=admitted['inputs'], producer=admitted['producer'],
   207	            approved_digests=admitted['approved_digests'], run_flags=admitted['run_flags'],
   208	            generated_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),
   209	            generation_command=list(command), outputs={str(path): hashlib.sha256(payload).hexdigest()
   210	                for path, payload in zip(paths, (data, markdown))})
   211	        recheck_inputs(admitted)
   212	        current = paths[1].read_bytes() if paths[1].exists() else None
   213	        if current != previous:
   214	            raise ValueError('Markdown changed during rendering')
   215	        _publish(paths[1], markdown, overwrite=previous is not None)
   216	        created.append(paths[1])
   217	        _publish(paths[2], _json_bytes(receipt))
   218	    except BaseException:
   219	        for path in reversed(created):
   220	            if path == paths[1] and previous is not None:
   221	                _publish(path, previous, overwrite=True)
   222	            else:
   223	                path.unlink()
   224	        raise
