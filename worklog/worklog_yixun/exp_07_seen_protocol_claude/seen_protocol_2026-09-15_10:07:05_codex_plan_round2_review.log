    59	def _seed_values(values):
    60	    matrix = np.asarray(values, dtype=np.float64)
    61	    if matrix.ndim != 2 or matrix.shape[0] != 5:
    62	        raise ValueError("expected five seed arrays with shape (5, n)")
    63	    return matrix
    64	
    65	
    66	def five_seed_mean(per_seed_arrays):
    67	    """Plain five-seed mean; any non-finite seed makes the query NaN."""
    68	    values = _seed_values(per_seed_arrays)
    69	    with np.errstate(invalid="ignore", over="ignore"):
    70	        means = values.mean(axis=0)
    71	    means[~np.isfinite(values).all(axis=0)] = np.nan
    72	    return means
