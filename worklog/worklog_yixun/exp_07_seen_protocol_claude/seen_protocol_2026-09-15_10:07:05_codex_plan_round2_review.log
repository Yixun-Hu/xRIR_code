   143	def _bootstrap_ratios(pairs, n_boot, seed, clusters=None):
   144	    """Bootstrap ``r`` for several paired series over the *same* resamples.
   145	
   146	    Sharing the draws is what makes a difference-in-differences of two models paired:
   147	    both models are recomputed on the identical resampled set of queries.
   148	
   149	    Args:
   150	        pairs: list of ``(e0, ek)`` float64 arrays, all of the same length.
   151	        n_boot: number of resamples.
   152	        seed: ``np.random.default_rng`` seed.
   153	        clusters: ``None`` to resample pairs, or one cluster id per pair to resample
   154	            whole clusters with replacement (multiplicity weights).
   155	
   156	    Returns:
   157	        A list of ``[n_boot]`` arrays of ratios, one per input pair.
   158	
   159	    Raises:
   160	        ValueError: if any resample leaves ``r`` undefined (a resampled ``mean(e0)`` of
   161	            zero).  Dropping such draws would silently shift the percentiles.
   162	    """
   163	    n = pairs[0][0].size
