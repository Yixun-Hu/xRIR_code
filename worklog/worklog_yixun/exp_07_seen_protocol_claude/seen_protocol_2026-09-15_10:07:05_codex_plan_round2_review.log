   267	def train_data_identity(data_root, cache_path=None, workers=8):
   268	    """Content-hash train IRs using the actual split, with a stat-validated cache.
   269	
   270	    A stale cache raises instead of silently reusing it. Remove that cache explicitly
   271	    to rebuild. The default cache is outside the dataset, keyed by root and count.
   272	    """
   273	    from treble_multi_room_dataset.treble_xRIR_dataset import xRIR_Dataset
   274	    root = Path(data_root).resolve()
   275	    dataset = xRIR_Dataset(split='train', ir_path=str(root / 'single_channel_ir'))
   276	    files = sorted(str(Path(f).resolve().relative_to(root)) for f in dataset.file_list)
   277	    key = hashlib.sha256(json.dumps([str(root), len(files)]).encode()).hexdigest()
   278	    cache = Path(cache_path) if cache_path else Path(tempfile.gettempdir()) / 'xrir-provenance' / (key + '.json')
   279	    if cache.exists():
   280	        try:
   281	            record = json.loads(cache.read_text())
   282	            stamps = []
   283	            for name in files:
   284	                stat = (root / name).stat()
   285	                stamps.append((name, stat.st_size, stat.st_mtime_ns))
   286	            cached = [(r['path'], r['size'], r['mtime_ns']) for r in record['inventory']]
   287	            if (record['data_root'] == str(root) and record['cache_key'] == key
   288	                    and cached == stamps and record['inventory_files'] == len(files)
   289	                    and _inventory_digest(record['inventory']) == record['inventory_sha256']):
   290	                return record
   291	        except (OSError, ValueError, KeyError, TypeError):
   292	            pass
   293	        raise ValueError('stale training inventory cache: ' + str(cache))
   294	    record = dict(_inventory(files, root, workers), split='train', cache_key=key)
   295	    cache.parent.mkdir(parents=True, exist_ok=True)
   296	    write_completion(cache, record)
   297	    return record
