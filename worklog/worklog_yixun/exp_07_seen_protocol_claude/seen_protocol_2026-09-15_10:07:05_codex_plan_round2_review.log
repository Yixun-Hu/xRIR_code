    75	def _validity_counts(baseline, paired):
    76	    return {"n": int(baseline.size),
    77	            "baseline_invalid": int((~baseline).sum()),
    78	            "newly_invalid": int((baseline & ~paired).sum()),
    79	            "excluded": int((~paired).sum()), "valid": int(paired.sum())}
    80	
