rel=Path('worklog/worklog_yixun/exp_07_seen_protocol_claude'); assets=rel/'seen_protocol_results_assets'
head=subprocess.check_output(['git','rev-parse','HEAD'],text=True).strip()
common=['--table',str(main/'ckpt/exp07/results/TABLE_SEEN_V1.json'),'--pairs']+[str(main/('ckpt/exp07/results/PAIRS_SEEN_V1_'+role+'.json')) for role in ['seen_cyl','seen_aug','released_seen']]+['--unseen-table',str(main/'ckpt/yaw_aug/results/TABLE_V1.json'),'--unseen-binding',str(main/'ckpt/yaw_aug/binding_report_20260915T084205518027Z.json')]
