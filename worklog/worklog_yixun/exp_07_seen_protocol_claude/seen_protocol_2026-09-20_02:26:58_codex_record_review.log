 target=scratch/output.name
 subprocess.run([__import__('sys').executable,'-B',str(repo/assets/generator)]+common+['--out',str(target)],check=True)
 result=subprocess.run(['diff','-u',str(main/output),str(target)],capture_output=True,text=True)
 (scratch/(output.name+'.diff')).write_text(result.stdout)
 print('REGENERATE',generator,'diff exit',result.returncode,'sha',p.sha256_file(target),flush=True)
