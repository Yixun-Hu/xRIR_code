   473	
   474	def run_probe(root, stamp, name, commit, log_path, args):
   475	    """One single-arm fit probe; the receipt binds its own attempt and GPU snapshots."""
   476	    output = root / ('_probe_' + stamp + '_' + name + '.json')
   477	    if output.exists():
   478	        raise FileExistsError(str(output))
   479	    before = base.gpu_snapshot(args.gpu)
   480	    attempt = root / ('_probe_' + stamp + '_arm')
   481	    relative = os.path.relpath(attempt, REPO)
   482	    cmd = ([PYTHON, '-m', 'tools.exp07_probe', '--tier', 'M', '--backbone', args.backbone,
   483	            '--protocol', PROTOCOL, '--save-dir', relative] +
   484	           (['--yaw-aug', str(args.yaw_aug)] if args.yaw_aug else []))
   485	    trainer_argv = probe.trainer_command('M', args.backbone, relative, PROTOCOL, args.yaw_aug)
   486	
   487	    def fields_factory():
   488	        fields = build_fields([PYTHON] + trainer_argv, args.gpu, commit, 'probe', args.allow_dirty)
   489	        fields['trainer_command'], fields['command'] = fields['command'], cmd
   490	        return fields
   491	
   492	    completed = base.execute_attempt(attempt, 'probe', args.gpu, log_path, fields_factory,
   493	                                     allow_cotenant=args.allow_cotenant)
   494	    after = base.gpu_snapshot(args.gpu)
   495	    arms_before = [completed['resource_before']]
   496	    states = [before, *arms_before, after]
   497	    result = dict(completed['metrics']['probe'], schema_version=1, gpu=args.gpu, before=before,
   498	                  after=after, arms_before=arms_before, attempts=[str(attempt)],
   499	                  reviewed_commit=commit,
   500	                  PROBE_NOT_CLEAN=any(bool(state['compute_apps']) for state in states))
   501	    result.update(probe_attempt=dict(path=str(attempt.resolve()), **{
   502	        part + '_sha256': p.sha256_file(attempt / (part + '.json'))
   503	        for part in ('train_manifest', 'completion')}),
   504	        live_epoch_limit_seconds=1.05 * result['T_epoch'], live_epoch_limit_start='banner')
   505	    result['PROBE_NOT_CLEAN'] |= any(
   506	        state['gpu'] != args.gpu or not before['uuid'] or state['uuid'] != before['uuid']
   507	        or not math.isfinite(state['free_gib']) or state['free_gib'] < 40 for state in states)
   508	    if result['PROBE_NOT_CLEAN']:
   509	        result['passed'] = False
   510	    p.write_manifest(output, result)
   511	    if result['PROBE_NOT_CLEAN']:
   512	        print('PROBE_NOT_CLEAN: GPU resource checks failed; re-probe on a clean GPU.', flush=True)
   513	    return result
   514	
   515	
   516	if __name__ == '__main__':
   517	    main()

