   277	def recovery_evidence(fields, execution, attempt, launcher_log):
   278	    """Finalisation evidence for a seen attempt: closures, bindings, split and log."""
   279	    if fields.get('repo') != str(REPO) or fields.get('mode') not in ('smoke', 'probe', 'full'):
   280	        raise ValueError('invalid recovery repo or mode')
   281	    if not re.fullmatch('[0-9a-f]{40}', fields.get('reviewed_commit', '')):
   282	        raise ValueError('invalid reviewed_commit')
   283	    closures = fields.get('source_closures', {})
   284	    if (not train_minimum() <= {r['path'] for r in closures.get('training', {}).get('files', [])}
   285	            or not closures.get('launcher', {}).get('files')):
   286	        raise ValueError('recovery closure minimum missing')
   287	    if not fields.get('resource_before') or not set(ENV_KEYS) <= set(fields.get('env', {})):
   288	        raise ValueError('recovery resource_before or env missing')
   289	    mode = fields['mode']
   290	    if mode in ('smoke', 'full'):
   291	        save_dir = fields['effective_args']['save_dir']
   292	        original = str(Path(save_dir).parent) if mode == 'smoke' else save_dir
   293	        if (REPO / original).resolve() != Path(fields['attempt_path']):
   294	            raise ValueError('recovery command attempt path mismatch')
   295	        check_golden(fields['command'], mode, original)
   296	    required = ({'effective_args', 'train_inventory'} | SEEN_INPUTS |
   297	                ({'control_args', 'probe_receipt'} if mode == 'full' else set()))
   298	    if not required <= set(fields.get('mutable_inputs', {})):
   299	        raise ValueError('recovery required bindings missing')
   300	    if fields['mutable_inputs']['seen_split'] != e7p.seen_split_identity(REPO):
   301	        raise ValueError('recovery seen split changed')
   302	    if mode == 'full' and fields['train_data_identity'].get('inventory_files') != TRAIN_FILES[PROTOCOL]:
   303	        raise ValueError('recovery training inventory count')
   304	    if launcher_log is None:
   305	        raise ValueError('recovery requires --launcher-log from nohup setsid invocation')
   306	    path = Path(launcher_log).resolve()
   307	    spawn = dict(train_manifest_sha256=execution['train_manifest_sha256'],
   308	                 child_pgid=execution['child_pgid'], child_exit_status=None)
   309	    spawn['spawn_execution_sha256'] = p.hashlib.sha256((
   310	        json.dumps(spawn, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()).hexdigest()
   311	    if execution.get('spawn_execution_sha256') != spawn['spawn_execution_sha256']:
   312	        raise ValueError('spawn execution digest mismatch')
   313	    line = 'EXP04_SPAWN ' + json.dumps(spawn, sort_keys=True)
   314	    if path == attempt or attempt in path.parents or path.read_text().splitlines().count(line) != 1:
   315	        raise ValueError('execution does not match external launcher log')
