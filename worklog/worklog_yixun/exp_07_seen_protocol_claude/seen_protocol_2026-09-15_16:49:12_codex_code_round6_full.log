    47	def build(out_dir, seeds=SEEDS, num_shots=NUM_SHOTS, entries=None, factory=seen_dataset):
    48	    """Write one manifest per (K, seed) and the index binding them; never overwrite.
    49	
    50	    The split identity is captured BEFORE any dataset is constructed and re-checked
    51	    before the index is published: a pickle replaced while the grid is being built would
    52	    otherwise be recorded as the source of manifests drawn from the old split (or of a
    53	    mixed grid).  The captured binding is the one stored.
    54	    """
    55	    expected = ENTRIES if entries is None else entries
    56	    out = Path(out_dir)
    57	    out.mkdir(parents=True, exist_ok=True)
    58	    index_path = out / INDEX
    59	    if index_path.exists():
    60	        raise FileExistsError(str(index_path))
    61	    split = e7p.seen_split_identity(REPO)  # before the first dataset reads the pickle
    62	    manifests = {}
    63	    for num_shot in num_shots:
    64	        dataset = factory(num_shot)  # one dataset per K, reused across the seeds
    65	        for seed in seeds:
    66	            path = out / manifest_name(num_shot, seed)
    67	            if path.exists():
    68	                raise FileExistsError(str(path))
    69	            manifest = build_manifest(dataset, seed=seed, num_shot=num_shot)
    70	            if len(manifest['entries']) != expected:
    71	                raise ValueError('{} has {} entries, expected {}'.format(
    72	                    path.name, len(manifest['entries']), expected))
    73	            with path.open('x') as stream:  # exclusive creation
    74	                json.dump(manifest, stream)
    75	            manifests[path.name] = dict(num_shot=num_shot, seed=seed,
    76	                                        entries=len(manifest['entries']),
    77	                                        manifest_hash=manifest_hash(manifest),
    78	                                        file_sha256=p.sha256_file(path))
    79	    if e7p.seen_split_identity(REPO) != split:
    80	        raise ValueError('seen_test_split.pkl changed while the manifests were built')
    81	    index = dict(schema_version=1, entries=expected, num_shots=list(num_shots),
    82	                 seeds=list(seeds), seen_split=split, manifests=manifests)
    83	    p.write_manifest(index_path, index)
    84	    return index
