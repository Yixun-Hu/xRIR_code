   211	def mean_sd(metrics, name):
   212	    """EDT in seconds with its SD in milliseconds, so no printed SD rounds to zero."""
   213	    metric = metrics[name]
   214	    if name == 'EDT':
   215	        return '{} s ± {} ms'.format(format(metric['mean'] / 1000, '.3f'),
   216	                                     display(metric['sd'], 'EDT'))
   217	    return '{} ± {} {}'.format(native(name, metric['mean']), native(name, metric['sd']),
   218	                               metric['unit'])
