   135	def load_approved_digests(path=None):
   136	    """Read the committed exp_07 pins; return a frozen view and the file's identity.
   137	
   138	    ``evaluator`` pins tools.exp07_eval's closure and ``writer`` tools.exp04_eval_launch's;
   139	    ``training_launcher`` is the list of admissible training-launcher closures and
   140	    ``training`` the single closure all three arms must share.  The committed all-null
   141	    template loads -- the schema is reviewable before anything is approved -- but every
   142	    producer refuses those nulls in production; only --exploratory lists them as
   143	    deviations.  Pins are all-null or all-filled: a half-filled file is refused.
   144	    """
   145	    path = Path(path or APPROVED_DIGESTS_PATH).resolve()
   146	    raw = path.read_bytes()
   147	    value = json.loads(raw)
   148	    def shape(obj, keys):
   149	        if type(obj) is not dict or set(obj) != set(keys):
   150	            raise ValueError('approved digests schema: expected ' + ', '.join(keys))
   151	    shape(value, ('schema_version', 'closures', 'checkpoints'))
   152	    shape(value['closures'], CLOSURES)
   153	    shape(value['checkpoints'], NEW_ROLES)
   154	    def digest(item):
   155	        return type(item) is str and bool(re.fullmatch('[0-9a-f]{64}', item))
   156	    checks = [(value['schema_version'], lambda v: type(v) is int and v == 1)]
   157	    checks += [(value['closures'][key], digest) for key in CLOSURES if key != 'training_launcher']
   158	    launchers = value['closures']['training_launcher']  # [] is this pin's unfilled form
   159	    checks += [(None if launchers == [] else launchers,
   160	                lambda v: type(v) is list and len(v) >= 1 and all(digest(item) for item in v))]
   161	    for role, arm in value['checkpoints'].items():
   162	        shape(arm, ('path', 'epoch', 'sha256'))
   163	        expected = next(a['checkpoint'] for a in ARMS if a['role'] == role)
   164	        checks += [(arm['path'], lambda v, expected=expected: type(v) is str and v == expected),
   165	                   (arm['epoch'], lambda v: type(v) is int and v == 12), (arm['sha256'], digest)]
   166	    if any(item is not None and not valid(item) for item, valid in checks):
   167	        raise ValueError('approved digests schema: invalid pin type or value')
   168	    if any(item is None for item, _ in checks) and any(item is not None for item, _ in checks):
   169	        raise ValueError('approved digests schema: requires all-null or all-filled pins')
