   220	
   221	def render_summary(result):
   222	    """Every number here is read from the result the canonical JSON is written from."""
   223	    lines = ['DESCRIPTIVE {} {} - {}'.format(result['profile_name'], *result['pairing']),
   224	             'Profile sha256: ' + result['profile_digest'],
   225	             'No verdict. ' + result['verdict_scope']]
   226	    for cell in result['cells']:
   227	        absolute, relative = (cell['statistics'][name] for name in ('absolute', 'relative'))
   228	        lines.append('{} K={}{}: absolute={:.8g} {} {}, relative={:.8g} {}, rooms {} {}, n={}'
   229	                     .format(cell['metric'], cell['num_shot'],
   230	                             ' [reference]' if cell['reference'] else '',
   231	                             absolute['estimate'], absolute['unit'], absolute['interval'],
   232	                             relative['estimate'], relative['interval'],
   233	                             cell['n_rooms_retained'], relative['room_cluster_interval'],
   234	                             cell['paired_cohort']['n_queries']))
   235	        lines.append('  cohort means: ' + ', '.join(
   236	            '{}={:.8g}'.format(role, summary['mean'])
   237	            for role, summary in sorted(cell['arm_means'].items())))
   238	    if result.get('reconverge_attempted'):
   239	        lines.append('Reconvergence re-run at n_boot {}'.format(result['reconverge_n_boot']))
   240	    lines.extend('Re-run at a larger n_boot: ' + item for item in result['reconverge_required'])
   241	    lines.extend('Deviation: ' + item for item in result['deviations'])
   242	    if not result['final']:
   243	        lines.append('NOT FINAL')
   244	    return '\n'.join(lines) + '\n'
   245	
