   200	def build_fields(argv, gpu, reviewed_commit, mode, allow_dirty=False):
   201	    """The pre-spawn record: closures, the seen inventory, the split and the twin diff."""
   202	    state = p.checked_git_state(REPO, mode == 'full', allow_dirty)
   203	    files = p.source_closure(ENTRY_MODULE, REPO)
   204	    if not train_minimum() <= set(files):
   205	        raise ValueError('training closure missing required files')
   206	    closures = {}
   207	    for role, paths in [('training', files), ('launcher',
   208	            p.source_closure('tools.exp07_launcher', REPO) +
   209	            ['tools/exp07_probe.py', 'tools/exp07_launch.sh'])]:
   210	        records, digest = p.closure_record(paths, reviewed_commit, REPO)
   211	        if not records or any(r['reviewed_blob_sha256'] is None or
   212	                r['reviewed_blob_sha256'] != r['working_tree_sha256'] or
   213	                r['commits_after_reviewed'] for r in records):
   214	            raise ValueError(role + ' closure differs from reviewed commit')
   215	        closures[role] = {'files': records, 'sha256': digest}
   216	    # The split file selects the training inventory: capture its identity BEFORE the
   217	    # inventory is built, re-verify it afterwards and bind the one it was selected under.
   218	    split = e7p.seen_split_identity(REPO)
   219	    print('Hashing training data identity...', flush=True)
   220	    data = e7p.train_data_identity(DATA_ROOT, protocol=PROTOCOL,
   221	                                   cache_path=REPO / e7p.SEEN_CACHE)
   222	    if e7p.seen_split_identity(REPO) != split:
   223	        raise ValueError('seen split changed during training inventory construction')
   224	    provisional = effective_args(argv, gpu, 1)
   225	    bpe = math.ceil(data['inventory_files'] / provisional['batch_size'])
   226	    effective = effective_args(argv, gpu, bpe)
   227	    check_runtime(effective, effective, mode)
   228	    fields = dict(repo=str(REPO), reviewed_commit=reviewed_commit, mode=mode, protocol=PROTOCOL,
   229	        source_closures=closures, train_data_identity=data, effective_args=effective,
   230	        command=list(argv), environment=p.environment(), git_state=state, allow_dirty=allow_dirty,
   231	        env={key: child_environment(gpu)[key] for key in ENV_KEYS},
   232	        mutable_inputs={'seen_split': split})
   233	    if mode == 'full':
   234	        control_path = REPO / CONTROLS[arm(effective['backbone'], effective['yaw_aug'])]
   235	        control = json.loads(control_path.read_text())
   236	        control_env = control.get('env') or dict(XRIR_DATA_PATH=DATA_ROOT, OMP_NUM_THREADS='2',
   237	                                                 CUDA_VISIBLE_DEVICES='1')
   238	        fields['control_excluded_differences'] = compare_control(effective, control, control_env)
   239	        fields['control_env_reconstructed'] = control_env
   240	        fields['mutable_inputs']['control_args'] = {'path': str(control_path),
   241	                                                    'sha256': p.sha256_file(control_path)}
   242	    return fields
