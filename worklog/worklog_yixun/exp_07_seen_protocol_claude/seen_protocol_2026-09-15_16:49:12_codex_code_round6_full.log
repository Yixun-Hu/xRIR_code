   221	def protocol_line(row):
   222	    values = dict(row['protocol'], tf32='on' if row['protocol']['tf32'] else 'off',
   223	                  seeds=len(row['protocol']['seeds']))
   224	    return ('K = {num_shot}; {split}; {n_queries} queries; {seeds} seeds; epoch {epoch}; '
   225	            'condition {condition}; k = {k}; batch {batch_size}; TF32 {tf32}; '
   226	            'training {training}').format(**values)
