   229	def tables(record, head):
   230	    """Shared presentation model: titles, headers and producer-valued cells."""
   231	    yield ('Seen split — mean ± seed SD (TABLE_SEEN_V1)',
   232	           ['Arm', 'K', 'EDT (s)', 'EDT (ms)', 'C50 (dB)', 'T60 (%)', 'Loss', 'log-STFT MSE',
   233	            'Protocol'],
   234	           [[row['label'], row['num_shot'], mean_sd(row['metrics'], 'EDT'),
   235	             '{} ± {}'.format(display(row['metrics']['EDT']['mean'], 'EDT'),
   236	                              display(row['metrics']['EDT']['sd'], 'EDT'))] +
   237	            [mean_sd(row['metrics'], name) for name in ('C50', 'T60', 'loss', 'log_mse')] +
   238	            [protocol_line(row)] for row in record['table']['rows']])
   239	    rows = []
   240	    for data in record['pairs']:
   241	        arm, baseline = data['pairing']
   242	        for cell in data['cells']:
   243	            absolute, relative = (cell['statistics'][key] for key in ('absolute', 'relative'))
   244	            rows.append([' minus '.join(data['pairing']), cell['metric'], cell['num_shot'],
   245	                         native(cell['metric'], absolute['estimate']), absolute['unit'],
   246	                         native(cell['metric'], absolute['interval']),
   247	                         native(cell['metric'], absolute['room_cluster_interval']),
   248	                         percent(relative['estimate']), percent(relative['interval']),
   249	                         percent(relative['room_cluster_interval']),
   250	                         cell['paired_cohort']['n_queries'], cell['n_rooms_retained'],
   251	                         percent(relative['convergence']['ratio']),
   252	                         native(cell['metric'], cell['arm_means'][arm]['mean']),
   253	                         native(cell['metric'], cell['arm_means'][baseline]['mean'])])
   254	    yield ('Descriptive paired differences (PAIRS_SEEN_V1) — no verdict',
   255	           ['Pairing', 'Metric', 'K', 'Absolute difference', 'Unit', 'Query 95% interval',
   256	            'Room 95% interval', 'Relative difference (%)', 'Relative query 95% (%)',
   257	            'Relative room 95% (%)', 'Queries', 'Rooms', 'Convergence ratio (%)',
   258	            'Cohort mean (arm)', 'Cohort mean (baseline)'], rows)
   259	    seen = {(row['role'], row['num_shot']): row for row in record['table']['rows']}
   260	    unseen = {(row['role'], row['num_shot']): row for row in record['unseen']['rows']}
   261	    rows = []
   262	    for shot in (1, 8):
   263	        for seen_role, unseen_role in PROTOCOL_PAIRS + ((REFERENCE_ROLE, None),):
   264	            row = seen[(seen_role, shot)]
   265	            other = unseen[(unseen_role, shot)] if unseen_role else None
   266	            rows.append([row['label'], shot] +
   267	                        [mean_sd(row['metrics'], name) for name in ACOUSTIC] +
   268	                        ([mean_sd(other['metrics'], name) for name in ACOUSTIC]
   269	                         if other else ['—'] * 3))
   270	    yield ('Seen and unseen protocols — mean ± seed SD',
   271	           ['Method', 'K', 'Seen EDT (s)', 'Seen C50 (dB)', 'Seen T60 (%)', 'Unseen EDT (s)',
   272	            'Unseen C50 (dB)', 'Unseen T60 (%)'], rows)
   273	    yield ('Provenance', ['Canonical input', 'sha256', 'Profile digest', 'Producer closure',
   274	                          'Approval file', 'Approval sha256'],
   275	           [[receipt['path'], receipt['sha256'], receipt['profile_digest'],
   276	             receipt['producer_closure_sha256'], receipt['approved_digests']['path'],
   277	             receipt['approved_digests']['sha256']] for receipt in record['receipts']])
   278	    report = record['receipts'][-1]['binding_report']
   279	    yield ('Provenance — git HEAD and the exp_04 record', ['Field', 'Value'],
   280	           [['git HEAD', head], ['exp_04 binding report', report['path']],
   281	            ['exp_04 binding report sha256', report['sha256']]])
