   106	def check_cell(data, cell, label):
   107	    """A cell is publishable only if BOTH its statistics converged and it drives nothing.
   108	
   109	    The aggregate flags are a summary; a mutated cell must not pass because the summary
   110	    still says "final".  Every statistic the profile registers must be present, carry a
   111	    passed convergence diagnostic and no outstanding reconvergence, and the cell's own
   112	    pairing, grid and seed labels must be the parent's.
   113	    """
   114	    where = '{} {} K={}'.format(label, cell.get('metric'), cell.get('num_shot'))
   115	    if cell.get('decision_driving') is not False:
   116	        raise ValueError('a descriptive cell cannot drive a decision: ' + where)
   117	    if list(cell.get('pairing') or []) != list(data['pairing']):
   118	        raise ValueError('cell pairing differs from its pairing: ' + where)
   119	    profile = data['profile']
   120	    if cell.get('k') != profile['grid'][0] or list(cell.get('seed_labels') or []) != list(
   121	            profile['eval_seeds']):
   122	        raise ValueError('cell grid or seed labels differ from the profile: ' + where)
   123	    if list(cell.get('quantiles') or []) != list(profile['quantiles']):
   124	        raise ValueError('cell quantiles differ from the profile: ' + where)
   125	    statistics = cell.get('statistics') or {}
   126	    if set(statistics) != set(profile['statistics']):
   127	        raise ValueError('cell statistics differ from the profile: ' + where)
   128	    for name, statistic in sorted(statistics.items()):
   129	        if statistic.get('reconverge_required') is not False:
   130	            raise ValueError('cell {} still needs a larger n_boot: {}'.format(name, where))
   131	        if (statistic.get('convergence') or {}).get('passed') is not True:
   132	            raise ValueError('cell {} did not converge: {}'.format(name, where))
   133	    if not (cell.get('paired_cohort') or {}).get('n_queries'):
   134	        raise ValueError('empty paired cohort: ' + where)
