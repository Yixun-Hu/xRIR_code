   318	@contextmanager
   319	def seen_overrides():
   320	    """Rebind exp04_launcher's collaborators to exp_07's for the duration of a run.
   321	
   322	    The shared orchestration resolves ``check_golden``, ``check_runtime``, ``LogGuard``,
   323	    ``complete_attempt``, ``recovery_evidence``, ``tier_gates``, ``TRAIN_MINIMUM``,
   324	    ``child_environment`` and ``REPO`` as module globals of ``exp04_launcher``.  Binding
   325	    them here is how exp_07 supplies its own decisions without editing that file; outside
   326	    this context ``exp04_launcher`` behaves exactly as main's bytes describe.
   327	    """
   328	    with patch.multiple(base, REPO=REPO, TRAIN_MINIMUM=train_minimum(), tier_gates=gates,
   329	                        child_environment=child_environment, check_golden=check_golden,
   330	                        check_runtime=check_runtime, compare_control=compare_control,
   331	                        complete_attempt=complete_attempt, recovery_evidence=recovery_evidence,
   332	                        LogGuard=LogGuard):
   333	        yield
