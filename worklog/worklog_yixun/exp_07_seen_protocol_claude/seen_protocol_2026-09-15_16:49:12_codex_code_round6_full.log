   247	def main(argv=None):
   248	    parser = argparse.ArgumentParser(description=__doc__)
   249	    parser.add_argument('--profile', choices=('PAIRS_SEEN_V1',), required=True)
   250	    parser.add_argument('--runs-a', nargs='+', required=True, help="the pairing's first arm")
