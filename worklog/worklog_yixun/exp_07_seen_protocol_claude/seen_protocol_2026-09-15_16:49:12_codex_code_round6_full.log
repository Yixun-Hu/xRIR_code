    70	def is_canonical_split(explicit, binding, repo):
    71	    """Does an explicit ``--bind-input seen_split=...`` name the authors' own file?
    72	
    73	    Binding paths are absolutised by the shared builder, so the canonical file arrives
    74	    spelled differently from ``seen_split_identity``'s repository-relative record.  Paths
    75	    are therefore compared after resolution (a symlink to the file is the file) and the
    76	    digest must match as well, so a byte-identical copy elsewhere is not accepted.
    77	    """
    78	    try:
    79	        resolved = Path(explicit['path']).resolve()
    80	        digest = explicit['sha256']
    81	    except (AttributeError, KeyError, TypeError):
    82	        return False
    83	    return (resolved == (Path(repo).resolve() / binding['path']).resolve()
    84	            and digest == binding['sha256'])
    85	
    86	
    87	def build_fields(args, command, repo):
    88	    """The shared bindings, with the split identity, the seen split and this writer."""
    89	    with patch.object(base, 'MUTABLE_INPUTS', MUTABLE_INPUTS):
    90	        fields = base.build_fields(args, command, repo, module=evaluator)
    91	    fields.update(evaluator.split_metadata(args))  # the shared builder records "unseen"
    92	    records, digest = p.closure_record(p.source_closure(WRITER, repo),
    93	                                       fields['reviewed_commit'], repo)
    94	    if not records or any(record['reviewed_blob_sha256'] is None or
    95	            record['reviewed_blob_sha256'] != record['working_tree_sha256'] or
    96	            record['commits_after_reviewed'] for record in records):
    97	        raise ValueError('writer closure differs from reviewed_commit')
    98	    fields['source_closures']['writer'] = {'files': records, 'sha256': digest}
    99	    binding = e7p.seen_split_identity(repo)
   100	    explicit = fields['mutable_inputs'].get('seen_split')
   101	    if explicit is not None and not is_canonical_split(explicit, binding, repo):
   102	        raise ValueError('seen_split must bind ' + e7p.SEEN_SPLIT)
   103	    fields['mutable_inputs']['seen_split'] = binding
   104	    # A run counts as confirmatory only when its manifest holds every query of its split.
   105	    fields['confirmatory'] = bool(fields['confirmatory']
   106	                                  and fields['split_count'] == evaluator.SPLIT_ENTRIES[args.split])
   107	    return fields
   108	
   109	
   110	def main(argv=None):
   111	    args = parse_args(argv)
   112	    repo = Path(__file__).resolve().parents[1]
   113	    command = child_command(args, repo)
   114	    return base.execute_run(args, command, lambda: build_fields(args, command, repo), repo)
   115	
   116	
   117	if __name__ == '__main__':
   118	    main()
