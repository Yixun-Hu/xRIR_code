    30	def write_outputs(result, admitted, json_path, md_path, renderer, force_md=False, command=()):
    31	    """exp_04's publication transaction with the document renderer supplied by the caller.
    32	
    33	    Amendment A1: ``tools.results_table.write_outputs`` keeps main's bytes -- exp_04's
    34	    bound record re-hashes it -- and it renders with its own ``render_markdown``, so the
    35	    exp_07 producers need this copy.  It is the reviewed transaction verbatim apart from
    36	    ``renderer``: distinct, absent, non-symlink outputs that never overlap an input; the
    37	    inputs rechecked before and after rendering; JSON published first, then the Markdown
    38	    (with any manual section preserved), then the provenance sidecar; and every created
    39	    file rolled back, the Markdown restored to its previous bytes, on any failure.
    40	    """
    41	    paths = [Path(json_path).absolute(), Path(md_path).absolute(),
    42	             Path(str(json_path) + '.provenance.json').absolute()]
    43	    if (len({item.resolve() for item in paths}) != 3 or any(item.is_symlink() for item in paths)
    44	            or any(os.path.lexists(paths[i]) for i in (0, 2))
    45	            or (os.path.lexists(paths[1]) and not force_md)):
    46	        raise FileExistsError('output paths must be distinct and absent; '
    47	                              '--force-md permits Markdown only')
    48	    if any(str(item.resolve()) in admitted['inputs'] for item in paths):
    49	        raise ValueError('output overlaps an input')
    50	    previous = paths[1].read_bytes() if paths[1].exists() else None
    51	    data, created = _json_bytes(result), []
    52	    recheck_inputs(admitted)
    53	    try:
    54	        _publish(paths[0], data)
    55	        created.append(paths[0])
    56	        markdown = _preserve_manual(renderer(paths[0], command), previous).encode()
    57	        receipt = dict(schema_version=1, profile_digest=result['profile_digest'],
    58	            inputs=admitted['inputs'], producer=admitted['producer'],
    59	            approved_digests=admitted['approved_digests'], run_flags=admitted['run_flags'],
    60	            generated_at=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    61	            generation_command=list(command),
    62	            outputs={str(path): hashlib.sha256(payload).hexdigest()
    63	                     for path, payload in zip(paths, (data, markdown))})
    64	        recheck_inputs(admitted)
    65	        current = paths[1].read_bytes() if paths[1].exists() else None
    66	        if current != previous:
    67	            raise ValueError('Markdown changed during rendering')
    68	        _publish(paths[1], markdown, overwrite=previous is not None)
    69	        created.append(paths[1])
    70	        _publish(paths[2], _json_bytes(receipt))
    71	    except BaseException:
    72	        for path in reversed(created):
    73	            if path == paths[1] and previous is not None:
    74	                _publish(path, previous, overwrite=True)
    75	            else:
    76	                path.unlink()
    77	        raise
