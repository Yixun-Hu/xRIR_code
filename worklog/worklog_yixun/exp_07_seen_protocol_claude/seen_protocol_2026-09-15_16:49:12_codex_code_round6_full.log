     2	
     3	The evaluation of exp_07 pins its conditioning sets exactly as exp_03 does, but over
     4	the authors' SEEN test split: every manifest is
     5	``reference_manifest.build_manifest(seen_test_dataset, seed, num_shot)``, written once
     6	and never overwritten, and the index records each manifest's semantic hash, its file
     7	digest and its entry count (6 217 queries) together with the digest of the split file
     8	those queries come from.
     9	
    10	Run it from the repository root: the frozen seen dataset module opens
    11	``treble_multi_room_dataset/seen_test_split.pkl`` relative to the working directory.
    12	"""
    13	import argparse
    14	import json
    15	import os
    16	from pathlib import Path
    17	
    18	from tools import exp07_provenance as e7p
    19	from tools import provenance as p
    20	from tools.reference_manifest import build_manifest, manifest_hash
    21	
    22	REPO = Path(__file__).resolve().parents[1]
    23	SEEDS = (42, 43, 44, 45, 46)
    24	NUM_SHOTS = (8, 1)
    25	ENTRIES = 6217  # the seen test split (plan section 2)
    26	MAX_LEN = 9600
    27	INDEX = 'reference_manifests_seen_index.json'
    28	
    29	
    30	def manifest_name(num_shot, seed):
    31	    return 'reference_manifest_seen_k{}_seed{}.json'.format(num_shot, seed)
    32	
    33	
    34	def seen_dataset(num_shot, data_root=None, max_len=MAX_LEN):
    35	    """The frozen seen test split at ``num_shot`` references, from the repository root."""
    36	    if Path.cwd().resolve() != REPO:
    37	        raise ValueError('build the seen manifests from the repository root: ' + str(REPO))
    38	    if data_root is not None:
    39	        os.environ['XRIR_DATA_PATH'] = str(data_root)
    40	    from treble_multi_room_dataset import treble_xRIR_seen_dataset as seen
    41	    if data_root is not None and Path(seen.BASE_DATA_PATH) != Path(data_root):
    42	        raise ValueError('the seen dataset module was imported with data root '
    43	                         + seen.BASE_DATA_PATH)
    44	    return seen.xRIR_Dataset(split='test', num_shot=num_shot, max_len=max_len)
