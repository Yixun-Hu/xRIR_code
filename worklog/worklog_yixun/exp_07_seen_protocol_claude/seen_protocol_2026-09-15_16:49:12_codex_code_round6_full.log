     1	"""Launch exp_07 (seen-split) evaluation through the reviewed exp_04 run owner.
     2	
     3	Amendment A1: ``tools/exp04_eval_launch.py`` keeps main's bytes.  ``execute_run`` --
     4	exclusive run creation, the tee'd child, digest revalidation and the atomic completion --
     5	is reused exactly as it is; only the arguments, the child command, the bindings and the
     6	split identity are decided here.
     7	
     8	Where the split identity lives: the evaluation manifest carries ``split`` and
     9	``seen_split_sha256`` and is hash-bound by the completion (``eval_manifest_sha256``);
    10	both output metas carry the same two fields, are verified by the child itself before it
    11	exits (``exp07_eval.check_outputs``) and are hash-bound by the completion's ``outputs``.
    12	The reviewed ``execute_run`` therefore needs no split-specific branch.
    13	
    14	    python tools/exp07_eval_launch.py --split seen --backbone simple \
    15	        --checkpoint <ckpt> --num-shot 8 --manifest <seen manifest> \
    16	        --manifest-hash <hash> --gl-seed 42 --conditions P --yaw-cols 0 ...
    17	"""
    18	import sys
    19	from pathlib import Path
    20	from unittest.mock import patch
    21	
    22	from tools import exp04_eval_launch as base
    23	from tools import exp07_eval as evaluator
    24	from tools import exp07_provenance as e7p
    25	from tools import provenance as p
    26	
    27	OUTPUTS = base.OUTPUTS
    28	REQUIRED_INPUTS = base.REQUIRED_INPUTS
    29	MUTABLE_INPUTS = base.MUTABLE_INPUTS | {'seen_split'}
    30	SPLIT_FIELDS = evaluator.SPLIT_FIELDS
    31	ENTRY = 'tools/exp07_eval.py'
    32	WRITER = 'tools.exp07_eval_launch'
