   336	def refusal_self_test():
   337	    """Exercise the seen refusals in scratch storage, with no trainer spawn."""
   338	    import tempfile
   339	    refusals = []
   340	
   341	    def refuses(name, action):
   342	        try:
   343	            action()
   344	        except (ValueError, FileExistsError):
   345	            refusals.append(name)
   346	        else:
   347	            raise AssertionError('refusal not enforced: ' + name)
   348	
   349	    with tempfile.TemporaryDirectory(prefix='exp07_refuse_') as temporary:
   350	        root = Path(temporary)
   351	        attempt = base.create_attempt(root, 'attempt_test')
   352	        refuses('exclusive_directory', lambda: base.create_attempt(root, attempt.name))
   353	        seen = command('full', 'ckpt/exp07/seen_aug/attempt_test', 'simple', 1)
   354	        argv = list(seen)
   355	        argv[argv.index('--lr') + 1] = '0.5'
   356	        refuses('golden_argv', lambda: check_golden(argv, 'full', 'ckpt/exp07/seen_aug/attempt_test'))
   357	        refuses('seen_other_arm', lambda: check_golden(seen, 'full', 'ckpt/exp07/seen_simple/attempt_test'))
   358	        refuses('seen_unseen_argv', lambda: check_golden(
   359	            base.command('full', 'ckpt/exp07/seen_aug/attempt_test'), 'full',
   360	            'ckpt/exp07/seen_aug/attempt_test'))
   361	        refuses('seen_arm', lambda: arm('cylindrical', 1))
   362	        expected = effective_args(seen, '1', TRAIN_BATCHES[PROTOCOL])
   363	        refuses('runtime_schema', lambda: check_runtime(dict(expected, lr='0.001'), expected, 'full'))
   364	        wrong = effective_args(seen, '1', TRAIN_BATCHES['unseen'])
   365	        refuses('seen_bpe', lambda: check_runtime(wrong, wrong, 'full'))
   366	        refuses('seen_protocol', lambda: check_runtime(dict(expected, protocol='unseen'),
   367	                                                       dict(expected, protocol='unseen'), 'full'))
   368	        control = json.loads((REPO / CONTROLS['seen_simple']).read_text())
   369	        refuses('seen_control', lambda: compare_control(expected, control,
   370	            dict(XRIR_DATA_PATH=DATA_ROOT, OMP_NUM_THREADS='2', CUDA_VISIBLE_DEVICES='1')))
   371	        refuses('banner', lambda: LogGuard(expected, 'full').feed('Train Epoch: 1 [0/9265] loss 1'))
   372	        refuses('probe_prefix', lambda: LogGuard(expected, 'probe').feed('EXP05_PROBE_RESULT {}'))
   373	        refuses('full_cotenant', lambda: base.resource_gate('1', root, 'full', True))
   374	        base.abort_attempt(attempt, 'test', 1)
   375	        refuses('one_retry', lambda: gates.set_budget(root, dict(protocol=PROTOCOL,
   376	            ceiling_hours=45., projection_hours=1., probe_receipt_sha256='a' * 64), commit=False))
   377	    return {'passed': True, 'refusals': refusals}
