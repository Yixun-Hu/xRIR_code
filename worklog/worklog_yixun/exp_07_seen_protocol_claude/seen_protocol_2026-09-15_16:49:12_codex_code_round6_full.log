   380	@p.termination_handlers()
   381	def main(argv=None):
   382	    import argparse
   383	    import datetime
   384	    import fcntl
   385	    import subprocess
   386	    import sys
   387	    parser = argparse.ArgumentParser(description=__doc__)
   388	    parser.add_argument('mode', choices=('smoke', 'probe', 'full', 'finalize', 'refuse-test'))
   389	    parser.add_argument('attempt_dir', nargs='?')
   390	    parser.add_argument('--gpu', default='1', choices=('0', '1'))
   391	    parser.add_argument('--backbone', choices=('simple', 'cylindrical'), default='simple')
   392	    parser.add_argument('--yaw-aug', type=int, choices=(0, 1), default=0,
   393	                        help='1 selects the seen_aug arm (simple backbone only)')
   394	    parser.add_argument('--reviewed-commit')
   395	    parser.add_argument('--log-dir')
   396	    parser.add_argument('--launcher-log', help='finalize: external nohup setsid launcher stdout log')
   397	    parser.add_argument('--timestamp', default=datetime.datetime.now().strftime('%Y%m%dT%H%M%S%f'))
   398	    parser.add_argument('--allow-cotenant', action='store_true')
   399	    parser.add_argument('--allow-dirty', action='store_true')
   400	    parser.add_argument('--probe-json', help='full requires a clean passing seen probe receipt')
   401	    parser.add_argument('--renew-ceiling', help='full only: notebook timestamp: reason')
   402	    args = parser.parse_args(argv)
   403	    if args.renew_ceiling is not None and args.mode != 'full':
   404	        parser.error('--renew-ceiling requires a full run')
   405	    try:
   406	        name = arm(args.backbone, args.yaw_aug)
   407	    except ValueError as error:
   408	        parser.error(str(error))
   409	    args.log_dir = args.log_dir or str(REPO / RECORD)
   410	    with seen_overrides():
   411	        if args.mode == 'finalize':
   412	            if not args.attempt_dir:
   413	                parser.error('finalize requires an attempt directory')
   414	            result = base.finalize_attempt(args.attempt_dir, args.launcher_log)
   415	            print(json.dumps(result, sort_keys=True, allow_nan=False), flush=True)
   416	            return result
   417	        if args.attempt_dir:
   418	            parser.error('attempt directory is only valid for finalize')
   419	        if args.mode == 'refuse-test':
   420	            result = refusal_self_test()
   421	            print(json.dumps(result), flush=True)
   422	            return result
   423	        if not args.reviewed_commit:
   424	            parser.error('--reviewed-commit is required')
   425	        if args.mode == 'full' and not args.probe_json:
   426	            parser.error('full requires --probe-json (clean passing fit-probe)')
   427	        if args.mode == 'full' and args.allow_cotenant:
   428	            parser.error('full forbids --allow-cotenant')
   429	        if not re.fullmatch(r'[A-Za-z0-9_-]+', args.timestamp) or '_ABORTED_' in args.timestamp:
   430	            parser.error('timestamp must be a safe filename component')
   431	        if Path(sys.executable).resolve() != Path(PYTHON).resolve():
   432	            parser.error('launcher requires pinned interpreter ' + PYTHON)
   433	        root, stamp, mode = arm_root(args.backbone, args.yaw_aug), args.timestamp, args.mode
   434	        commit = subprocess.check_output(['git', 'rev-parse', args.reviewed_commit + '^{commit}'],
   435	                                         cwd=str(REPO), text=True).strip()
   436	        receipt = (gates.validate_receipt(args.probe_json, commit, args.gpu, 'M', args.backbone,
   437	                                          PROTOCOL, args.yaw_aug) if mode == 'full' else None)
   438	        if mode in ('smoke', 'full'):
   439	            attempt = root / (('_smoke_' if mode == 'smoke' else 'attempt_') + stamp)
   440	            relative = os.path.relpath(attempt, REPO)
   441	            cmd = command(mode, relative, args.backbone, args.yaw_aug)
   442	            check_golden(cmd, mode, relative)
   443	        root.mkdir(parents=True, exist_ok=True)
   444	        with (root / '.launch.lock').open('a') as lock, \
   445	                patch.dict(os.environ, child_environment(args.gpu)):
   446	            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
   447	            log_dir = Path(args.log_dir).resolve()
   448	            train_log = 'seen_protocol_{}_train_{}_{}.log'.format(stamp, name, mode)
   449	            if mode in ('smoke', 'full'):
   450	                limits, projection = None, 30.0
   451	                if mode == 'full':
   452	                    limits = gates.timing_limits(dict(reviewed_commit=commit,
   453	                        effective_args=effective_args(cmd, args.gpu, TRAIN_BATCHES[PROTOCOL]),
   454	                        mutable_inputs=dict(probe_receipt=receipt)), args.gpu)
   455	                    projection = limits['projection_hours']
   456	
   457	                def fields_factory():
   458	                    fields = build_fields(cmd, args.gpu, commit, mode, args.allow_dirty)
   459	                    if mode == 'full':
   460	                        fields['mutable_inputs']['probe_receipt'] = receipt
   461	                    return fields
   462	
   463	                result = base.execute_attempt(attempt, mode, args.gpu, log_dir / train_log,
   464	                    fields_factory, allow_cotenant=args.allow_cotenant, projection=projection,
   465	                    **({'limits': limits, 'renew_ceiling': args.renew_ceiling} if limits else {}))
   466	            else:
   467	                result = run_probe(root, stamp, name, commit, log_dir / train_log, args)
   468	            print(json.dumps(result, sort_keys=True, allow_nan=False), flush=True)
   469	            if mode == 'probe' and not result['passed']:
   470	                raise SystemExit(1)
   471	            return result
