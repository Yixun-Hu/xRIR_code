    69	def check_table(data):
    70	    roles = [arm['role'] for arm in data['profile']['arms']]
    71	    expected = {(role, shot) for role in roles for shot in data['profile']['num_shot']}
    72	    actual = [(row['role'], row['num_shot']) for row in data['rows']]
    73	    if len(actual) != 8 or set(actual) != expected or len(set(actual)) != len(actual):
    74	        raise ValueError('incomplete seen table coverage')
    75	    for row in data['rows']:
    76	        missing = set(COLUMNS) - set(row['metrics'])
    77	        if missing:
    78	            raise ValueError('missing metrics: ' + ', '.join(sorted(missing)))
