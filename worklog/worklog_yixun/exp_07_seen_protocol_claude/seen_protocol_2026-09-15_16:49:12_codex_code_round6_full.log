   173	    require(type(epoch_seconds) is float and
   174	            _equal(limits.get('epoch_seconds'), 1.05 * epoch_seconds), 'training epoch acceptance')
   175	    for key, value in (('tier', profile['tier']), ('backbone', arm['backbone']),
   176	                       ('protocol', 'seen'), ('yaw_aug', arm['yaw_aug']),
   177	                       ('passed', True), ('PROBE_NOT_CLEAN', False)):
   178	        require(_equal(receipt.get(key), value), 'probe receipt ' + key)
   179	    recorded = {}
   180	    for name in ('training', 'launcher'):
   181	        # A7: the approval pins the REVIEWED source identity, so recompute it here from the
   182	        # manifest's complete records instead of trusting the label they are stored beside.
   183	        # Drift of the working tree AFTER the spawn is the completion's business, not this
   184	        # digest's, and stays permitted.
   185	        try:
   186	            recorded[name] = _closure_digest(manifest['source_closures'][name])
   187	        except (ValueError, KeyError, TypeError) as error:
   188	            raise ValueError('training closure records ' + name + ': ' + str(error))
   189	        require(_equal(manifest['source_closures'][name].get('sha256'), recorded[name]),
   190	                'training closure digest ' + name)
   191	    require(recorded['launcher'] in (pins['closures']['training_launcher'] or ()),
   192	            'training launcher closure')
   193	    require(recorded['training'] == pins['closures']['training'], 'training closure')
   194	    trainer = recorded['training']
   195	    for key, value in dict(profile['recipe'], **profile['full_run']).items():
   196	        require(_equal(args.get(key), value), 'args ' + key)
   197	    for key in ('backbone', 'yaw_aug', 'yaw_aug_seed', 'yaw_aug_width'):
   198	        require(_equal(args.get(key), arm[key]), 'args ' + key)
   199	    require(_equal(args.get('train_batches_per_epoch'), profile['train_batches_per_epoch']),
   200	            'args train_batches_per_epoch')
   201	    require(_equal(args.get('tier', profile['tier']), profile['tier']), 'args tier')
   202	    for key, value in TIERS[profile['tier']].items():  # the seen arms are trained at tier M
   203	        require(_equal(args.get('vit_' + key, value), value), 'args tier configuration')
   204	    require(_equal(args.get('backbone'), fields.get('backbone')), 'evaluated backbone')
   205	    effective = manifest.get('effective_args') or {}
   206	    runtime = {key: value for key, value in args.items() if key != 'env'}
   207	    for key, value in (args.get('env') or {}).items():  # tools.exp04_launcher.normalize
   208	        require(key not in runtime or _equal(runtime[key], value), 'args env conflict ' + key)
   209	        runtime[key] = value
   210	    require(_equal(runtime, effective), 'effective_args disagree with args.json')
   211	    require((root / effective.get('save_dir', 'absent')).resolve() == attempt,
   212	            'effective_args save_dir')
   213	    require({'epoch_%03d.pth' % epoch for epoch in range(1, 13)} <=
   214	            set(finished.get('directory_listing') or ()), 'training epoch checkpoints')
   215	    return dict(role=arm['role'], reference=False, training=trainer, waivers=waivers, inputs=inputs)
   216	
   217	
   218	def admit(directories, profile, approved=None, producer=None, exploratory=False,
   219	          producer_key='producer_table'):
   220	    """Route runs to (arm, K) groups, apply the contract, then collect through exp_04.
   221	
   222	    Only differences this module checks independently are waived from the inherited
   223	    admission; nothing on disk and no imported producer's state is modified.
   224	    """
   225	    pins, receipt = load_approved_digests() if approved is None else approved
   226	    approved = (pins, receipt)
   227	    deviations, groups, contracts, waivers, snapshots = [], [], {}, set(), {}
   228	    sidecars = {}  # shared across the runs of one arm; see run_contract
   229	    def check(ok, message):
   230	        if not ok:
   231	            deviations.append(message)
   232	    check(type(pins['schema_version']) is int and pins['schema_version'] == 1,
   233	          'approval schema_version')
   234	    for key in ('evaluator', 'writer', 'training_launcher', 'training', producer_key):
   235	        check(bool(pins['closures'][key]), 'profile not yet approved: ' + key)
   236	    for arm in profile['arms']:
   237	        effective = dict(arm)
   238	        if not arm['reference']:
   239	            checkpoint = pins['checkpoints'][arm['role']]
   240	            check(checkpoint['path'] == arm['checkpoint'] and
   241	                  _equal(checkpoint['epoch'], arm['epoch']),
   242	                  'approved checkpoint path/epoch: ' + arm['role'])
   243	            effective['sha256'] = checkpoint['sha256']
   244	        check(effective['sha256'] is not None,
   245	              'profile not yet approved: ' + arm['role'] + ' checkpoint')
   246	        for shot in sorted(profile['num_shot'], reverse=True):
   247	            groups.append((effective, shot, []))
   248	    if deviations and not exploratory:
   249	        raise ValueError('admission failed: ' + '; '.join(deviations))
   250	    directories = sorted(str(Path(item).resolve()) for item in directories)
   251	    check(len(set(directories)) == len(directories), 'duplicate run directories')
   252	    for directory in directories:
   253	        try:
   254	            fields = json.loads((Path(directory) / 'eval_manifest.json').read_text())
   255	            matches = [(arm, paths) for arm, shot, paths in groups
   256	                       if _equal(fields.get('num_shot'), shot) and
   257	                       (Path(fields['repo']) / fields['checkpoint']).resolve() ==
   258	                       (REPO / arm['checkpoint']).resolve()]
   259	            if len(matches) != 1:
   260	                raise ValueError('unregistered checkpoint/K')
   261	            arm, paths = matches[0]
   262	            paths.append(directory)
   263	            contract = run_contract(directory, arm, profile, pins, sidecars)
   264	            contracts[directory] = {key: value for key, value in contract.items()
   265	                                    if key not in ('waivers', 'inputs')}
   266	            for path, digest in contract['inputs'].items():
   267	                check(snapshots.get(path, digest) == digest, 'contract input changed: ' + path)
   268	                snapshots[path] = digest
   269	            waivers.update(contract['waivers'])
   270	        except (ValueError, TypeError, KeyError, OSError, IndexError) as error:
   271	            check(False, '{}: {}'.format(directory, error))
   272	    trainers = {c['training'] for c in contracts.values() if c['training'] is not None}
   273	    check(len(trainers) <= 1, 'the new arms do not share one training closure')
   274	    entry = 'tools.exp07_' + ('pairs' if producer_key == 'producer_pairs' else 'table')
   275	    producer = producer_identity(entry) if producer is None else producer
   276	    admitted = admit_runs(profile, groups, approved=approved, exploratory=True,
   277	                          producer=producer, producer_key=producer_key)
   278	    for path, digest in snapshots.items():
   279	        # Evidence only this contract reads -- the training inventory sidecar, the probe
   280	        # receipt, the hours ledger -- is bound here; what exp_04 also binds must agree.
   281	        check(admitted['inputs'].setdefault(path, digest) == digest,
   282	              'contract input changed: ' + path)
   283	    deviations.extend(item for item in admitted['deviations'] if item not in waivers)
   284	    if deviations and not exploratory:
   285	        raise ValueError('admission failed: ' + '; '.join(deviations))
   286	    admitted.update(deviations=deviations, contracts=contracts)
   287	    return groups, admitted
   288	
   289	
   290	MARKDOWN = REPO / 'worklog/worklog_yixun/model_comparison_seen.md'
   291	
   292	
   293	def render_markdown(json_path, command=None):
   294	    """The shared table, headed by the admission status the canonical JSON carries.
   295	
   296	    A reader must see the exploratory status and every deviation in the document itself:
   297	    a command-line flag or an output file name is not disclosure.  The banner goes inside
   298	    the generated block, whose stamp is recomputed over the complete body.
   299	    """
   300	    result = json.loads(Path(json_path).read_bytes())
   301	    text = shared_markdown(json_path, command)
   302	    if not result.get('exploratory') and not result.get('deviations'):
   303	        return text
   304	    banner = ['', '> **EXPLORATORY - NOT a confirmatory exp_07 result.**', '>',
   305	              '> Every number below is provisional until these admission deviations are',
   306	              '> cleared and the table is produced again without --exploratory.', '',
   307	              '## Admission deviations', '']
   308	    banner += ['- ' + item for item in result.get('deviations') or ['(none recorded)']]
   309	    marker, newline, rest = text.partition(STAMP)[0].partition('\n')
   310	    body = marker + newline + '\n'.join(banner) + '\n' + rest
   311	    return body + STAMP + hashlib.sha256(body.encode()).hexdigest() + ' -->\n' + END + '\n'
   312	
   313	
   314	def write_outputs(result, admitted, json_path, md_path, force_md=False, command=()):
   315	    """Publish through the record's copy of exp_04's transaction, rendering exp_07's table."""
   316	    return publish_outputs(result, admitted, json_path, md_path, render_markdown,
   317	                           force_md, command)
   318	
   319	
   320	def build_table(directories, profile=None, approved=None, exploratory=False, producer=None):
   321	    """Admit the runs and aggregate them under the TABLE_V1 rules; write no artefacts.
   322	
   323	    Each seed mean uses its own finite queries and the row bounds the count differences;
   324	    EDT is reported in ms.  The released row carries its unknown epoch as such.
   325	    """
   326	    profile = json_value(get_profile('TABLE_SEEN_V1')) if profile is None else profile
   327	    groups, admitted = admit(directories, profile, approved, producer, exploratory)
   328	    rows = []
   329	    for (arm, shot, _), runs in zip(groups, admitted['groups']):
   330	        if not runs:  # exploratory only: admission has already named the missing arm
   331	            continue
   332	        cells = [run['P'][str(profile['grid'][0])] for run in runs]
   333	        names = set().union(*(set(cell) for cell in cells))
   334	        if names - set(METRICS):
   335	            raise ValueError('unknown metric names: ' + ', '.join(sorted(names - set(METRICS))))
   336	        if any(set(cell) != names for cell in cells):
   337	            raise ValueError('metric coverage differs across seeds')
   338	        missing = {source for source, item in METRICS.items() if item} - names
   339	        if missing:  # plan section 2: every row reports all five, spectral ones included
   340	            raise ValueError('missing metrics: ' + ', '.join(sorted(missing)))
   341	        metrics = {}
   342	        for source, specification in METRICS.items():
   343	            if specification is None or source not in names:
   344	                continue
   345	            name, unit, scale = specification
   346	            per_seed = {}
   347	            for run, cell in zip(runs, cells):
   348	                values = np.asarray(cell[source], dtype=float)
   349	                finite = values[np.isfinite(values)]
   350	                if not finite.size:
   351	                    raise ValueError('zero finite queries: ' + source)
   352	                per_seed[str(run['meta']['manifest_seed'])] = {
   353	                    'mean': float(finite.mean() * scale), 'n_finite': int(finite.size)}
   354	            counts = [item['n_finite'] for item in per_seed.values()]
   355	            if max(counts) - min(counts) > profile['finite_count_tolerance']:
   356	                raise ValueError('finite count tolerance exceeded: ' + source)
   357	            means = np.asarray([item['mean'] for item in per_seed.values()])
   358	            if not np.isfinite(means).all():
   359	                raise ValueError('nonfinite seed mean: ' + source)
   360	            metrics[name] = dict(source=source, unit=unit, mean=float(means.mean()),
   361	                                 sd=float(means.std(ddof=profile['seed_sd_ddof'])),
   362	                                 per_seed=per_seed)
   363	        protocol = dict(num_shot=shot, split=profile['dataset']['split'],
   364	            n_queries=profile['dataset']['n_queries'], seeds=sorted(profile['seeds'][shot]),
   365	            epoch=arm['epoch'] if arm['epoch'] is not None else 'unknown (external)',
   366	            condition=profile['condition'], k=profile['grid'][0], training=arm['training'],
   367	            batch_size=profile['batch_size'], tf32=profile['tf32'],
   368	            max_samples=profile['max_samples'])
   369	        rows.append(dict(role=arm['role'], label=arm['label'], num_shot=shot, epoch=arm['epoch'],
   370	                         backbone=arm['backbone'], reference=arm['reference'],
   371	                         protocol=protocol, metrics=metrics))
   372	    literal = json.loads(json.dumps(json_value(profile)))
   373	    digest = hashlib.sha256(json.dumps(literal, sort_keys=True, separators=(',', ':'),
   374	                                       allow_nan=False).encode()).hexdigest()
   375	    return dict(schema_version=1, profile_name='TABLE_SEEN_V1', profile=literal,
   376	                profile_digest=digest, exploratory=exploratory, rows=rows,
   377	                deviations=list(admitted['deviations']), contracts=admitted['contracts'],
   378	                inputs=admitted['inputs'],
   379	                producer_closure_sha256=admitted['producer']['sha256']), admitted
   380	
   381	
   382	def main(argv=None):
   383	    parser = argparse.ArgumentParser(description=__doc__)
   384	    parser.add_argument('--profile', choices=('TABLE_SEEN_V1',), required=True)
   385	    parser.add_argument('--runs', nargs='+', required=True)
   386	    parser.add_argument('--json', required=True)
   387	    parser.add_argument('--md', default=str(MARKDOWN))
   388	    parser.add_argument('--force-md', action='store_true',
   389	                        help='Regenerate the Markdown; the JSON is always exclusive')
   390	    parser.add_argument('--exploratory', action='store_true',
   391	                        help='List unapproved pins and deviations instead of refusing')
   392	    argv = sys.argv[1:] if argv is None else argv
   393	    args = parser.parse_args(argv)
   394	    result, admitted = build_table(args.runs, exploratory=args.exploratory)
   395	    command = ['exp07_table.py', '--profile', args.profile, '--runs']
   396	    command += [str(Path(item).resolve()) for item in args.runs]
   397	    command += ['--json', str(Path(args.json).absolute()), '--md', str(Path(args.md).absolute())]
   398	    command += ['--force-md'] if args.force_md else []
   399	    command += ['--exploratory'] if args.exploratory else []
   400	    write_outputs(result, admitted, args.json, args.md, args.force_md, command)
   401	    return result
   402	
   403	
   404	if __name__ == '__main__':
   405	    try:
   406	        main()
   407	    except (ValueError, OSError, RuntimeError, KeyError) as error:
   408	        raise SystemExit(str(error))

