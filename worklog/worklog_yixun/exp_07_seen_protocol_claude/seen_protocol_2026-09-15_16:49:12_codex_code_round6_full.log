     1	"""Descriptive exp_07 paired differences on the seen split: no verdict, no decision.
     2	
     3	One cell is a pairing at one K and one metric.  The paired cohort is the queries finite
     4	for all five evaluation seeds in BOTH arms (an empty cohort refuses the cell); the
     5	per-query value is each arm's plain five-seed mean; and the two reported statistics are
     6	the ABSOLUTE difference of the arm means in the table's units (EDT in ms) and the
     7	RELATIVE difference (delta / the baseline arm's mean).  Both are recomputed inside each
     8	of the profile's shared query-level resamples -- one call to the shared sampler returns
     9	both series, so the intervals describe the same draws -- and the whole-room cluster
    10	resampling of the same query-weighted statistic is reported as the secondary interval.
    11	Intervals are exact order statistics at the profile's quantiles.
    12	
    13	These are checkpoint-conditional descriptive intervals: five evaluation seeds do not
    14	estimate training-seed variability, so no cell carries a verdict, a significance marker
    15	or a superiority/equivalence claim, and ``decision_driving`` is false throughout.
    16	"""
    17	import argparse
    18	import hashlib
    19	import json
    20	import sys
    21	from pathlib import Path
    22	
    23	import numpy as np
    24	
    25	from tools.exp07_profiles import get_profile, json_value
    26	from tools.exp07_table import admit
    27	from tools.paired_compare import (REPO, _digest, _samples, cell_mask, convergence,
    28	                                  five_seed_mean, two_sided_interval, write_outputs)
    29	from tools.results_table import METRICS
    30	from tools.summarize_yaw import rooms_from_paths
    31	
    32	BASELINE = 'seen_simple'
    33	# metric name -> (per-sample source name, unit, scale), as the canonical table reports it
    34	UNITS = {spec[0]: (source, spec[1], spec[2]) for source, spec in METRICS.items() if spec}
    35	
    36	
    37	def matrix(runs, source, k=0):
    38	    return np.asarray([run['P'][str(k)][source] for run in runs], dtype=float)
    39	
    40	
    41	def cohort(queries, mask):
    42	    if not mask.any():
    43	        raise ValueError('empty cohort')
    44	    rooms = rooms_from_paths(queries)[mask]
    45	    return dict(n_queries=int(mask.sum()), n_rooms=len(set(rooms)),
    46	                retained_sha256=_digest(sorted(np.asarray(queries)[mask].tolist())),
    47	                excluded=np.asarray(queries)[~mask].tolist())
    48	
    49	
    50	def seed_summary(values, mask):
    51	    means = values[:, mask].mean(axis=1)
    52	    return dict(mean=float(means.mean()), sd=float(means.std(ddof=1)) if len(means) > 1 else None,
    53	                per_seed=means.tolist())
    54	
    55	
    56	def difference_draws(means_a, means_b, n_boot, seed, clusters=None):
    57	    """Both statistics from ONE set of resamples of the shared sampler.
    58	
    59	    The relative series is the sampler's own ratio; the absolute series uses a constant
    60	    baseline of one, which turns the same ratio into ``mean(a - b)`` on that draw.
    61	    """
    62	    relative, shifted = _samples([(means_b, means_a), (np.ones_like(means_a), means_a - means_b)],
    63	                                 n_boot, seed, clusters)
    64	    return {'relative': relative, 'absolute': shifted + 1.0}
    65	
    66	
    67	def paired_cell(profile, runs_a, runs_b, pairing, metric, shot, n_boot=None):
    68	    """One descriptive cell; raises on an empty cohort or a mis-specified profile.
    69	
    70	    ``n_boot`` overrides the profile's resample count for the registered reconvergence
    71	    re-run; everything else -- the cohort, the estimates and the seeds -- is unchanged,
    72	    so the retry differs from the first attempt in the number of draws and nothing else.
    73	    """
    74	    n_boot = profile['n_boot'] if n_boot is None else n_boot
    75	    alpha, quantiles = profile['interval_alpha'], tuple(profile['quantiles'])
    76	    if quantiles != (alpha / 2, 1 - alpha / 2):
    77	        raise ValueError('the profile quantiles do not match its interval alpha')
    78	    source, unit, scale = UNITS[metric]
    79	    a, b = (matrix(runs, source) * scale for runs in (runs_a, runs_b))
    80	    mask, counts = cell_mask(a, e0_b=b, seeds=profile['eval_seeds'])
    81	    queries = runs_a[0]['query']
    82	    retained = cohort(queries, mask)
    83	    means_a, means_b = (five_seed_mean(values)[mask] for values in (a, b))
    84	    rooms = rooms_from_paths(queries)[mask]
    85	    seed_a, seed_b = profile['bootstrap_seeds']
    86	    draws = {seed: difference_draws(means_a, means_b, n_boot, seed)
    87	             for seed in (seed_a, seed_b)}
    88	    clustered = difference_draws(means_a, means_b, n_boot, seed_a, rooms)
    89	    difference = float(means_a.mean() - means_b.mean())
    90	    estimates = {'absolute': difference, 'relative': difference / float(means_b.mean())}
    91	    statistics = {}
    92	    for name in profile['statistics']:
    93	        gate = convergence(lambda seed: two_sided_interval(draws[seed][name], alpha),
    94	                           seed_a, seed_b, profile['convergence_tolerance'])
    95	        statistics[name] = dict(estimate=estimates[name], n_boot=n_boot,
    96	                                unit=unit if name == 'absolute' else 'fraction of ' + pairing[1],
    97	                                interval=list(two_sided_interval(draws[seed_a][name], alpha)),
    98	                                room_cluster_interval=list(two_sided_interval(clustered[name], alpha)),
    99	                                convergence=gate, reconverge_required=not gate['passed'])
   100	    reference = [list(pair) for pair in profile['reference_pairings']]
   101	    return dict(pairing=list(pairing), metric=metric, num_shot=shot, k=profile['grid'][0],
   102	                decision_driving=profile['decision_driving'], statistics=statistics,
   103	                reference=list(pairing) in reference, quantiles=list(quantiles),
   104	                paired_cohort=retained, n_rooms_retained=len(set(rooms)),
   105	                seed_labels=list(profile['eval_seeds']), source=source,
   106	                exclusions={pairing[0]: counts['a'], pairing[1]: counts['b'],
   107	                            'joint': counts['joint']},
   108	                arm_means={role: seed_summary(values, mask)
   109	                           for role, values in zip(pairing, (a, b))})
   110	
   111	
   112	def flagged_statistics(cell):
   113	    return sorted(name for name, statistic in cell['statistics'].items()
   114	                  if statistic['reconverge_required'])
   115	
   116	
   117	def reconverged_cell(profile, runs_a, runs_b, pairing, cell):
   118	    """Re-run this cell's flagged statistics once at the profile's larger n_boot.
   119	
   120	    The first attempt is kept verbatim under ``first_attempt`` (its count, diagnostic and
   121	    both intervals), the retry count is carried forward, and a statistic that fails again
   122	    keeps ``reconverge_required`` true -- so the pairing stays non-final.
   123	    """
   124	    n_boot = profile['reconverge_n_boot']
   125	    if not isinstance(n_boot, int) or n_boot <= profile['n_boot']:
   126	        raise ValueError('reconverge_n_boot must exceed the profile n_boot')
   127	    retried = paired_cell(profile, runs_a, runs_b, pairing, cell['metric'], cell['num_shot'],
   128	                          n_boot=n_boot)
   129	    statistics = dict(cell['statistics'])
   130	    for name in flagged_statistics(cell):
   131	        previous = cell['statistics'][name]
   132	        again = dict(retried['statistics'][name])
   133	        again['first_attempt'] = {key: previous[key] for key in
   134	                                  ('n_boot', 'convergence', 'interval', 'room_cluster_interval')}
   135	        again['reconverge_attempts'] = previous.get('reconverge_attempts', 0) + 1
   136	        statistics[name] = again
   137	    return dict(cell, statistics=statistics)
   138	
   139	
   140	def _role_and_shot(profile, directory):
   141	    fields = json.loads((Path(directory) / 'eval_manifest.json').read_text())
   142	    matches = [arm['role'] for arm in profile['arms']
   143	               if (Path(fields['repo']) / fields['checkpoint']).resolve() ==
   144	               (REPO / arm['checkpoint']).resolve()]
   145	    if len(matches) != 1:
   146	        raise ValueError('unregistered checkpoint: ' + str(directory))
   147	    return matches[0], fields.get('num_shot')
   148	
   149	
   150	def _side(profile, directories, label):
   151	    identified = [_role_and_shot(profile, item) for item in directories]
   152	    roles = {role for role, _ in identified}
   153	    if len(roles) != 1:
   154	        raise ValueError(label + ' must hold exactly one arm, got: ' + ', '.join(sorted(roles)))
   155	    return roles.pop(), sorted({shot for _, shot in identified}, reverse=True)
   156	
   157	
   158	def build_pairs(runs_a, runs_b, profile=None, approved=None, exploratory=False, producer=None,
   159	                reconverge=False):
   160	    """Admit both arms of one registered pairing and compute its descriptive cells.
   161	
   162	    ``reconverge`` re-runs every flagged cell once at the profile's registered larger
   163	    n_boot (plan section 2's publication procedure); the original diagnostic, the retry
   164	    count and the provenance of the first attempt are kept inside the cell.
   165	    """
   166	    profile = json_value(get_profile('PAIRS_SEEN_V1')) if profile is None else profile
   167	    role_a, shots_a = _side(profile, runs_a, '--runs-a')
   168	    role_b, shots_b = _side(profile, runs_b, '--runs-b')
   169	    if role_b != BASELINE:
   170	        raise ValueError('--runs-b must be the ' + BASELINE + ' baseline, got ' + role_b)
   171	    pairing = (role_a, role_b)
   172	    if list(pairing) not in [list(pair) for pair in profile['pairings']]:
   173	        raise ValueError('unregistered pairing: ' + ' - '.join(pairing))
   174	    if shots_a != shots_b or not set(shots_a) <= set(profile['num_shot']):
   175	        raise ValueError('both arms must be evaluated at the same registered shot counts')
   176	    arms = [arm for arm in profile['arms'] if arm['role'] in pairing]
   177	    restricted = dict(profile, num_shot=shots_a,
   178	                      arms=sorted(arms, key=lambda arm: pairing.index(arm['role'])))
   179	    groups, admitted = admit(list(runs_a) + list(runs_b), restricted, approved, producer,
   180	                             exploratory, producer_key='producer_pairs')
   181	    indexed = {(arm['role'], shot): runs
   182	               for (arm, shot, _), runs in zip(groups, admitted['groups'])}
   183	    literal = json.loads(json.dumps(json_value(profile)))
   184	    result = dict(schema_version=1, profile_name='PAIRS_SEEN_V1', profile=literal,
   185	                  profile_digest=hashlib.sha256(json.dumps(literal, sort_keys=True,
   186	                      separators=(',', ':'), allow_nan=False).encode()).hexdigest(),
   187	                  exploratory=exploratory, pairing=list(pairing), decision_driving=False,
   188	                  verdict_scope=profile['verdict_scope'], cells=[], reconverge_required=[],
   189	                  reconverge_attempted=bool(reconverge),
   190	                  reconverge_n_boot=profile['reconverge_n_boot'] if reconverge else None,
   191	                  deviations=list(admitted['deviations']), inputs=admitted['inputs'],
   192	                  run_flags=admitted['run_flags'], contracts=admitted['contracts'],
   193	                  producer_closure_sha256=admitted['producer']['sha256'])
   194	    for shot in shots_a:
   195	        for metric in profile['metrics']['descriptive']:
   196	            label = '{} K={}'.format(metric, shot)
   197	            try:
   198	                cell = paired_cell(profile, indexed[(pairing[0], shot)],
   199	                                   indexed[(pairing[1], shot)], pairing, metric, shot)
   200	            except (ValueError, KeyError, TypeError, IndexError) as error:
   201	                if not exploratory:
   202	                    raise ValueError('{}: {}'.format(label, error))
   203	                result['deviations'].append('{}: {}'.format(label, error))
   204	                continue
   205	            if reconverge and flagged_statistics(cell):
   206	                try:
   207	                    cell = reconverged_cell(profile, indexed[(pairing[0], shot)],
   208	                                            indexed[(pairing[1], shot)], pairing, cell)
   209	                except (ValueError, KeyError, TypeError, IndexError) as error:
   210	                    if not exploratory:
   211	                        raise ValueError('{}: {}'.format(label, error))
   212	                    result['deviations'].append('{}: {}'.format(label, error))
   213	            result['cells'].append(cell)
   214	            flagged = flagged_statistics(cell)
   215	            if flagged:
   216	                result['reconverge_required'].append(label + ' ' + '/'.join(flagged))
   217	    result['final'] = not result['reconverge_required'] and not result['deviations']
   218	    return result, admitted
