   146	def load_unseen(table, binding):
   147	    """exp_04's own admission, plus the digest its binding report recorded for that table."""
   148	    data, receipt, draft = exp04.load(table, 'TABLE_V1')
   149	    if draft:
   150	        raise ValueError('draft unseen table refused')
   151	    report = json.loads(Path(binding).read_bytes())
   152	    records = [item for item in report['results'] if item['profile'] == 'TABLE_V1']
   153	    if len(records) != 1:
   154	        raise ValueError('the exp_04 binding report does not bind TABLE_V1')
   155	    bound = {item['path']: item['sha256'] for item in records[0]['outputs']}
   156	    sidecar = Path(str(Path(table).resolve()) + '.provenance.json')
   157	    if (bound.get(receipt['path']) != receipt['sha256']
   158	            or records[0]['sidecar']['sha256'] != sha(sidecar.read_bytes())):
   159	        raise ValueError('the unseen table is not the one the exp_04 report binds')
   160	    receipt = dict(receipt, binding_report=dict(path=str(Path(binding).resolve()),
   161	                                                sha256=sha(Path(binding).read_bytes())))
   162	    return data, receipt
