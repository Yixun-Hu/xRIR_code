   165	def arguments(argv=None):
   166	    parser = argparse.ArgumentParser(description=__doc__)
   167	    parser.add_argument('--table', required=True, help='canonical TABLE_SEEN_V1.json')
   168	    parser.add_argument('--pairs', nargs='+', required=True,
   169	                        help='the three canonical PAIRS_SEEN_V1.json outputs')
   170	    parser.add_argument('--unseen-table', required=True, help="exp_04's bound TABLE_V1.json")
   171	    parser.add_argument('--unseen-binding', required=True, help="exp_04's binding report")
   172	    parser.add_argument('--out', required=True)
   173	    args = parser.parse_args(argv)
   174	    sources = [args.table] + list(args.pairs) + [args.unseen_table]
   175	    if len({Path(item).resolve() for item in sources}) != len(sources):
   176	        raise ValueError('duplicate canonical input')
   177	    table, table_receipt = load(args.table, 'TABLE_SEEN_V1')
   178	    validate(table, 'TABLE_SEEN_V1')
   179	    pairs = [load(path, 'PAIRS_SEEN_V1') for path in sorted(args.pairs)]
   180	    for data, _ in pairs:
   181	        validate(data, 'PAIRS_SEEN_V1')
   182	    check_pairs([data for data, _ in pairs])
   183	    pairs.sort(key=lambda item: PAIRINGS.index(tuple(item[0]['pairing'])))
   184	    unseen, unseen_receipt = load_unseen(args.unseen_table, args.unseen_binding)
   185	    available = {(row['role'], row['num_shot']) for row in unseen['rows']}
   186	    for seen_role, unseen_role in PROTOCOL_PAIRS:
   187	        for shot in table['profile']['num_shot']:
   188	            if (unseen_role, shot) not in available:
   189	                raise ValueError('the unseen table has no {} row at K = {}'.format(unseen_role, shot))
   190	    receipts = [table_receipt] + [receipt for _, receipt in pairs] + [unseen_receipt]
   191	    published = {output for receipt in receipts for output in receipt['outputs']}
   192	    published |= {str(Path(item).resolve()) + '.provenance.json' for item in sources}
   193	    published |= {str(Path(item).resolve()) for item in sources}
   194	    # The exp_04 binding report and every approval blob are inputs too: refuse to write
   195	    # a document over any of them, whatever spelling named them on the command line.
   196	    published |= {str(Path(args.unseen_binding).resolve())}
   197	    published |= {str(Path(receipt['approved_digests']['path']).resolve())
   198	                  for receipt in receipts if receipt.get('approved_digests')}
   199	    published |= {str(Path(unseen_receipt['binding_report']['path']).resolve())}
   200	    if str(Path(args.out).resolve()) in published:
   201	        raise ValueError('output overlaps canonical input')
   202	    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=REPO, text=True).strip()
   203	    record = dict(table=table, pairs=[data for data, _ in pairs], unseen=unseen, receipts=receipts)
   204	    return args, record, head
