   169	            raise ValueError('unknown protocol: ' + str(values['protocol']))
   170	        files = TRAIN_FILES[values['protocol']]
   171	        bpe = values.pop('train_batches_per_epoch', math.ceil(files / values['batch_size']))
   172	        if type(bpe) is not int or bpe != math.ceil(files / values['batch_size']):
   173	            raise ValueError('invalid train_batches_per_epoch')
   174	        for key, value in dict(yaw_aug=0, yaw_aug_seed=values['seed'],
   175	                               yaw_aug_width=512, no_save=False).items():
   176	            values.setdefault(key, value)
   177	        if values['yaw_aug_seed'] is None:  # exp_05 A1: the historical default is the seed
   178	            values['yaw_aug_seed'] = values['seed']
   179	    if tier_of(baseline) != 'M' or tier_of(treatment) != 'M':
   180	        raise ValueError('the seen arms and their unseen twins are tier M')
   181	    if treatment['protocol'] != PROTOCOL:
   182	        raise ValueError('control comparison requires a seen treatment')
   183	    missing = object()
   184	    differences = {key: {'treatment': treatment.get(key), 'control': baseline.get(key)}
   185	        for key in treatment.keys() | baseline.keys()
   186	        if type(treatment.get(key, missing)) is not type(baseline.get(key, missing))
   187	        or treatment.get(key, missing) != baseline.get(key, missing)}
   188	    if differences.get('protocol') != dict(treatment=PROTOCOL, control='unseen'):
   189	        raise ValueError('control mismatch: a seen arm requires its unseen-protocol twin')
   190	    refused = differences.keys() - (CONTROL_EXCLUSIONS | {'protocol'})
   191	    if refused:
   192	        raise ValueError('control mismatch: ' + ', '.join(sorted(refused)))
   193	    return differences
