   137	def validate(data, name):
   138	    """The canonical validation both the generators and the binder apply."""
   139	    if name == 'TABLE_SEEN_V1':
   140	        return check_table(data)
   141	    if name == 'PAIRS_SEEN_V1':
   142	        return check_pairing(data)
   143	    raise ValueError('unregistered profile: ' + str(name))
