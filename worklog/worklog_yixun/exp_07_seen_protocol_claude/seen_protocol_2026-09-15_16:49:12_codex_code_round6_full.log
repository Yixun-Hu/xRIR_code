    81	def check_pairs(records):
    82	    """Three registered pairings, each one final, descriptive and completely covered."""
    83	    if sorted(tuple(data['pairing']) for data in records) != sorted(PAIRINGS):
    84	        raise ValueError('incomplete pairing coverage')
    85	    for data in records:
    86	        check_pairing(data)
