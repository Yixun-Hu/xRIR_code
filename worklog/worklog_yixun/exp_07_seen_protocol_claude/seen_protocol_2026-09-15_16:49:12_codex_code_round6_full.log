   268	def complete_attempt(attempt, mode, log_path, fields, digest, metrics, hours, transaction=None):
   269	    """Require the seen bindings before the shared completion commits anything."""
   270	    missing = SEEN_INPUTS - set(fields.get('mutable_inputs', {}))
   271	    if missing:
   272	        raise base.LauncherFailure('input_changed',
   273	                                   'missing mutable inputs: ' + ', '.join(sorted(missing)))
   274	    return _BASE_COMPLETE(attempt, mode, log_path, fields, digest, metrics, hours, transaction)
