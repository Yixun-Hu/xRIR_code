   245	class LogGuard(base.LogGuard):
   246	    """The shared guard, reading the exp_07 probe line and refusing the other two."""
   247	
   248	    def feed(self, line):
   249	        if line.startswith(('EXP04_PROBE_RESULT ', 'EXP05_PROBE_RESULT ')):
   250	            raise ValueError('probe result prefix differs from the seen probe')
   251	        if line.startswith(probe.PREFIX):
   252	            self.probe = json.loads(line[len(probe.PREFIX):])
   253	        super().feed(line)
   254	
   255	    def finish(self):
   256	        result = super().finish()
   257	        if self.mode == 'probe':
   258	            probe.projection(self.probe)
   259	            if any(self.probe.get(key) != self.expected.get(key)
   260	                   for key in ('tier', 'backbone', 'protocol', 'yaw_aug')):
   261	                raise ValueError('probe tier/backbone/protocol mismatch')
   262	        return result
