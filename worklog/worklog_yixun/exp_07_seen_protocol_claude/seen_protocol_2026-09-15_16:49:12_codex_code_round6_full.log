    35	def parse_args(argv=None):
    36	    """exp_04's evaluation CLI plus ``--split``; ``--entry`` names this launcher only."""
    37	    parser = evaluator.build_parser(require_eval_manifest=False)
    38	    for name in ('run-label', 'reviewed-commit', 'data-root', 'log-dir'):
    39	        parser.add_argument('--' + name, required=True)
    40	    parser.add_argument('--num-shot', type=int, required=True)
    41	    parser.add_argument('--gpu', default='1')
    42	    parser.add_argument('--allow-dirty', action='store_true')
    43	    parser.add_argument('--bind-input', action='append', default=[], metavar='NAME=PATH')
    44	    parser.add_argument('--entry', choices=('exp07',), default='exp07')
    45	    args = parser.parse_args(argv)
    46	    if args.eval_manifest is not None:
    47	        parser.error('eval-manifest is created by the launcher')
    48	    for key in ('out_dir', 'checkpoint', 'manifest', 'data_root', 'log_dir'):
    49	        setattr(args, key, str(Path(getattr(args, key)).resolve()))
    50	    args.eval_manifest = str(Path(args.out_dir) / 'eval_manifest.json')
    51	    return args
    52	
    53	
    54	def child_command(args, repo):
    55	    """Serialize only evaluator arguments, retaining empty grids and bool flags."""
    56	    command = [sys.executable, str(Path(repo) / ENTRY)]
    57	    for action in evaluator.build_parser()._actions:
    58	        if action.dest == 'help':
    59	            continue
    60	        value = getattr(args, action.dest)
    61	        if isinstance(value, bool):
    62	            if value:
    63	                command.append(action.option_strings[0])
    64	        else:
    65	            command.append(action.option_strings[0])
    66	            command.extend(str(item) for item in (value if isinstance(value, list) else [value]))
    67	    return command
