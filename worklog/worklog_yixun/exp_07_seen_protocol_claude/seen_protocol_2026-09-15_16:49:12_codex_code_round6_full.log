    89	def check_pairing(data):
    90	    """One pairing: ten final descriptive cells, no verdict, every cell converged."""
    91	    label = ' - '.join(data['pairing'])
    92	    if data.get('final') is not True or data.get('reconverge_required'):
    93	        raise ValueError('pairing is not final: ' + label)
    94	    if (data.get('decision_driving') is not False or 'verdict' in data
    95	            or any('verdict' in cell for cell in data['cells'])):
    96	        raise ValueError('descriptive pairs cannot carry a verdict: ' + label)
    97	    expected = {(metric, shot) for metric in data['profile']['metrics']['descriptive']
    98	                for shot in data['profile']['num_shot']}
    99	    actual = [(cell['metric'], cell['num_shot']) for cell in data['cells']]
   100	    if len(actual) != 10 or set(actual) != expected or len(set(actual)) != len(actual):
   101	        raise ValueError('incomplete pair cell coverage: ' + label)
   102	    for cell in data['cells']:
   103	        check_cell(data, cell, label)
