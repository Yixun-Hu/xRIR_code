    87	def main(argv=None):
    88	    parser = argparse.ArgumentParser(description=__doc__)
    89	    parser.add_argument('--data-root', required=True)
    90	    parser.add_argument('--out-dir', default=str(REPO / 'ckpt/exp07'))
    91	    parser.add_argument('--seeds', type=int, nargs='+', default=list(SEEDS))
    92	    parser.add_argument('--num-shots', type=int, nargs='+', default=list(NUM_SHOTS))
    93	    args = parser.parse_args(argv)
    94	    index = build(args.out_dir, args.seeds, args.num_shots,
    95	                  factory=lambda num_shot: seen_dataset(num_shot, data_root=args.data_root))
    96	    print(json.dumps(index, sort_keys=True), flush=True)
    97	    return index
