   257	    parser.add_argument('--reconverge', action='store_true',
   258	                        help='Re-run every flagged cell once at the registered larger n_boot')
   259	    args = parser.parse_args(sys.argv[1:] if argv is None else argv)
   260	    result, admitted = build_pairs(args.runs_a, args.runs_b, exploratory=args.exploratory,
   261	                                   reconverge=args.reconverge)
   262	    write_outputs(result, admitted, args.json, args.summary, render_summary)
   263	    return result
