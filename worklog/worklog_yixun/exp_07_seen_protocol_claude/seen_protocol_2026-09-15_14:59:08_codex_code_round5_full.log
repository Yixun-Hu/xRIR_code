import copy
import json
from pathlib import Path
import pytest
from exp07_fixture import exp07_fixture
from test_paired_compare import admission_fixture
from test_results_table import table_fixture
from test_exp07_record_tools import record_inputs, bound, argv, edit, sidecar
from test_exp07_table import rebind_training
from tools.exp07_record import load_asset
from tools import provenance as p
from tools import exp07_table as table

@pytest.mark.parametrize('mutation', ['absolute_reconverge','relative_failed','cell_decision','wrong_pairing'])
def test_nested_pair_status(record_inputs, mutation):
    def mutate(data):
        cell=data['cells'][0]
        if mutation == 'absolute_reconverge':
            cell['statistics']['absolute']['reconverge_required']=True
        elif mutation == 'relative_failed':
            cell['statistics']['relative']['convergence']['passed']=False
        elif mutation == 'cell_decision':
            cell['decision_driving']=True
        else:
            cell['pairing']=['seen_aug','released_seen']
    edit(record_inputs['pairs'][0],mutate)
    load_asset('make_results_md').arguments(argv(record_inputs))
    print('ACCEPTED_NESTED_STATUS',mutation)

def cite_current(bound):
    paths=bound.arguments['results']+[bound.arguments['unseen_table']]
    for document in bound.arguments['rendered']:
        path=Path(document)
        path.write_text(path.read_text()+'\n'+'\n'.join(p.sha256_file(x) for x in paths))

@pytest.mark.parametrize('mutation',['nonfinal_pairs','empty_table','missing_eval_input','stale_inventory_input','mismatched_approval_path'])
def test_binder_admission(bound,mutation):
    path=Path(bound.arguments['results'][0])
    if mutation == 'nonfinal_pairs':
        path=Path(bound.arguments['results'][1])
        edit(path,lambda d:d.update(final=False,reconverge_required=['EDT K=8']))
    elif mutation == 'empty_table':
        edit(path,lambda d:d.update(rows=[]))
    else:
        data=json.loads(path.read_text())
        side=json.loads(sidecar(path).read_text())
        if mutation == 'missing_eval_input':
            key=str(Path(bound.arguments['runs'][0])/'metrics_yaw.json')
            assert key in data['inputs']
            data['inputs'].pop(key);side['inputs'].pop(key)
        elif mutation == 'stale_inventory_input':
            key=str(bound.built.attempts['seen_simple']/'train_inventory.json')
            data['inputs'][key]=side['inputs'][key]='f'*64
        else:
            old=side['approved_digests']['path']
            digest=data['inputs'].pop(old)
            side['inputs'].pop(old)
            side['approved_digests']['path']='/nonexistent/approved.json'
            data['inputs']['/nonexistent/approved.json']=digest
            side['inputs']['/nonexistent/approved.json']=digest
        path.write_text(json.dumps(data))
        side['outputs'][str(path)]=p.sha256_file(path)
        sidecar(path).write_text(json.dumps(side))
    cite_current(bound)
    result=bound.binder.collect(**bound.arguments)
    print('ACCEPTED_BINDER',mutation,len(result['runs']),len(result['results']))

def test_aborted_attempt_is_unbound(bound):
    directory=bound.built.attempts['seen_simple'].parent
    aborted=directory/'attempt_previous_ABORTED_slow'
    aborted.mkdir()
    evidence=aborted/'abort.json'
    evidence.write_text('{"reason":"slow"}')
    ledger_path=directory/'cumulative_hours.json'
    ledger=json.loads(ledger_path.read_text())
    ledger['attempts'].insert(0,dict(attempt=aborted.name,hours=1.,mode='full'))
    ledger['total_hours']+=1.
    ledger_path.write_text(json.dumps(ledger))
    before=bound.binder.collect(**bound.arguments)
    evidence.write_text('{"reason":"forged"}')
    after=bound.binder.collect(**bound.arguments)
    assert before == after
    print('ABORT_EVIDENCE_CHANGE_UNDETECTED', before['attempts'][2]['full_attempts'])

def test_unrelated_audit_is_accepted(bound):
    Path(bound.arguments['audit']).write_text('{"protocol":"unseen","passed":false}')
    report=bound.binder.collect(**bound.arguments)
    print('UNRELATED_AUDIT_ACCEPTED',report['audit']['sha256'])

@pytest.mark.parametrize('closure,kind',[('training','empty'),('launcher','empty'),('training','unreviewed'),('launcher','unreviewed'),('training','label'),('launcher','label')])
def test_round4_exact_closure_mutations(exp07_fixture,closure,kind):
    built=exp07_fixture()
    manifest=built.read(built.attempts['seen_simple']/'train_manifest.json')
    target=manifest['source_closures'][closure]
    if kind == 'empty':target['files']=[]
    elif kind == 'unreviewed':
        target['files']=[dict(path='wrong.py',reviewed_blob_sha256=None,working_tree_sha256='e'*64,commits_after_reviewed=[])]
    else:target['sha256']='f'*64
    rebind_training(built,'seen_simple',manifest=manifest)
    with pytest.raises(ValueError,match='training closure'):
        table.build_table(built.directories,built.profile,built.approved,producer=built.producer)
    print('REFUSED_ROUND4',closure,kind)

def test_exp04_default_writer_matches_base_bytes(table_fixture,tmp_path,monkeypatch):
    import types,subprocess,datetime
    from tools import results_table as rt
    source=subprocess.check_output(['git','show','7b3ad6c:tools/results_table.py'])
    old=types.ModuleType('review_old_results_table')
    old.__file__=rt.__file__
    exec(compile(source,'7b3ad6c:tools/results_table.py','exec'),old.__dict__)
    result,admitted=rt.build_table(table_fixture.directories)
    class FixedDateTime(datetime.datetime):
        @classmethod
        def now(cls,*args,**kwargs):
            return datetime.datetime(2026,9,15,12,0,0, tzinfo=datetime.timezone.utc)
    monkeypatch.setattr(datetime,'datetime',FixedDateTime)
    out=tmp_path/'compare'
    out.mkdir()
    json_path,md_path=out/'TABLE_V1.json',out/'model.md'
    old.write_outputs(result,admitted,str(json_path),str(md_path),command=['results_table.py'])
    original={x.name:x.read_bytes() for x in out.iterdir()}
    for x in out.iterdir():x.unlink()
    rt.write_outputs(result,admitted,str(json_path),str(md_path),command=['results_table.py'])
    current={x.name:x.read_bytes() for x in out.iterdir()}
    assert current == original
    print('EXP04_WRITER_BYTE_IDENTICAL',sorted(current))

def test_binding_report_can_be_overwritten_by_generator(record_inputs):
    target=record_inputs['binding']
    before=target.read_bytes()
    load_asset('make_results_md').main(argv(record_inputs,out=target))
    assert target.read_bytes()!=before
    assert target.read_text().startswith('generated by make_results_md.py')
    print('GENERATOR_OVERWROTE_EXP04_BINDING_INPUT')

