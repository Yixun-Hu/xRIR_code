        assert '{} s ± {} ms'.format(format(edt['mean'] / 1000, '.3f'),
                                     md.display(edt['sd'], 'EDT')) in text
        assert '{} ± {} dB'.format(*[md.display(row['metrics']['C50'][key], 'C50')
                                     for key in ('mean', 'sd')]) in text
