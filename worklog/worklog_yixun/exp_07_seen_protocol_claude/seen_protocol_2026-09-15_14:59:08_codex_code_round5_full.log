    68	def note(name, shot, rows):
    69	    """One SD line per table row; EDT in ms, the others in the table's own units."""
    70	    parts = []
    71	    for side, row in zip(('seen', 'unseen'), rows):
    72	        if row is None:
    73	            continue
    74	        metrics = row['metrics']
    75	        parts.append('{} EDT {} ms, C50 {} dB, T60 {} \\%'.format(
    76	            side, format(metrics['EDT']['sd'], '.3f'), format(metrics['C50']['sd'], '.4f'),
    77	            format(metrics['T60']['sd'], '.3f')))
    78	    return '{}: {}.'.format(name, '; '.join(parts))
