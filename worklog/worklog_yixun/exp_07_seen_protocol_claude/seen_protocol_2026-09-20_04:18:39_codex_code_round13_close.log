   298	
   299	def metric_names(cells):
   300	    """The metric names these seeds' cells share, under the TABLE_V1 coverage rules.
   301	
   302	    Named so the released-checkpoint calibration gate can apply exactly this rule: a
   303	    cohort that the publication protocol would later refuse must not pass that gate.
   304	    Nothing here reads an approval pin.
   305	    """
   306	    names = set().union(*(set(cell) for cell in cells))
   307	    if names - set(METRICS):
   308	        raise ValueError('unknown metric names: ' + ', '.join(sorted(names - set(METRICS))))
   309	    if any(set(cell) != names for cell in cells):
   310	        raise ValueError('metric coverage differs across seeds')
   311	    missing = {source for source, item in METRICS.items() if item} - names
   312	    if missing:  # plan section 2: every row reports all five, spectral ones included
   313	        raise ValueError('missing metrics: ' + ', '.join(sorted(missing)))
   314	    return names
   315	
   316	
   317	def seed_finite_means(cells, labels, source, tolerance, scale=1):
   318	    """Each seed's mean over ITS OWN finite queries, with the registered count bound.
   319	
   320	    The other half of what the calibration gate shares with the table: a seed whose
   321	    finite cohort differs from its siblings' by more than ``tolerance`` queries is not a
   322	    comparable row, whichever producer is aggregating it.
   323	    """
   324	    per_seed = {}
   325	    for label, cell in zip(labels, cells):
   326	        values = np.asarray(cell[source], dtype=float)
   327	        finite = values[np.isfinite(values)]
   328	        if not finite.size:
   329	            raise ValueError('zero finite queries: ' + source)
   330	        per_seed[str(label)] = {'mean': float(finite.mean() * scale),
   331	                                'n_finite': int(finite.size)}
   332	    counts = [item['n_finite'] for item in per_seed.values()]
   333	    if max(counts) - min(counts) > tolerance:
   334	        raise ValueError('finite count tolerance exceeded: ' + source)
   335	    return per_seed
   336	
   337	
   338	MARKDOWN = REPO / 'worklog/worklog_yixun/model_comparison_seen.md'
   339	
   340	
   341	def render_markdown(json_path, command=None):
   342	    """The shared table, headed by the admission status the canonical JSON carries.
   343	
   344	    A reader must see the exploratory status and every deviation in the document itself:
   345	    a command-line flag or an output file name is not disclosure.  The banner goes inside
   346	    the generated block, whose stamp is recomputed over the complete body.
   347	    """
   348	    result = json.loads(Path(json_path).read_bytes())
   349	    text = shared_markdown(json_path, command)
   350	    if not result.get('exploratory') and not result.get('deviations'):
   351	        return text
   352	    banner = ['', '> **EXPLORATORY - NOT a confirmatory exp_07 result.**', '>',
   353	              '> Every number below is provisional until these admission deviations are',
   354	              '> cleared and the table is produced again without --exploratory.', '',
   355	              '## Admission deviations', '']
   356	    banner += ['- ' + item for item in result.get('deviations') or ['(none recorded)']]
   357	    marker, newline, rest = text.partition(STAMP)[0].partition('\n')
   358	    body = marker + newline + '\n'.join(banner) + '\n' + rest
   359	    return body + STAMP + hashlib.sha256(body.encode()).hexdigest() + ' -->\n' + END + '\n'
   360	
   361	
   362	def write_outputs(result, admitted, json_path, md_path, force_md=False, command=()):
   363	    """Publish through the record's copy of exp_04's transaction, rendering exp_07's table."""
   364	    return publish_outputs(result, admitted, json_path, md_path, render_markdown,
   365	                           force_md, command)
   366	
   367	
   368	def build_table(directories, profile=None, approved=None, exploratory=False, producer=None):
   369	    """Admit the runs and aggregate them under the TABLE_V1 rules; write no artefacts.
   370	
   371	    Each seed mean uses its own finite queries and the row bounds the count differences;
   372	    EDT is reported in ms.  The released row carries its unknown epoch as such.
   373	    """
   374	    profile = json_value(get_profile('TABLE_SEEN_V1')) if profile is None else profile
   375	    groups, admitted = admit(directories, profile, approved, producer, exploratory)
   376	    rows = []
   377	    for (arm, shot, _), runs in zip(groups, admitted['groups']):
   378	        if not runs:  # exploratory only: admission has already named the missing arm
   379	            continue
   380	        cells = [run['P'][str(profile['grid'][0])] for run in runs]
   381	        names = metric_names(cells)
   382	        labels = [run['meta']['manifest_seed'] for run in runs]
   383	        metrics = {}
   384	        for source, specification in METRICS.items():
   385	            if specification is None or source not in names:
   386	                continue
   387	            name, unit, scale = specification
   388	            per_seed = seed_finite_means(cells, labels, source,
   389	                                         profile['finite_count_tolerance'], scale)
   390	            means = np.asarray([item['mean'] for item in per_seed.values()])
   391	            if not np.isfinite(means).all():
   392	                raise ValueError('nonfinite seed mean: ' + source)
   393	            metrics[name] = dict(source=source, unit=unit, mean=float(means.mean()),
   394	                                 sd=float(means.std(ddof=profile['seed_sd_ddof'])),
   395	                                 per_seed=per_seed)
   396	        protocol = dict(num_shot=shot, split=profile['dataset']['split'],
   397	            n_queries=profile['dataset']['n_queries'], seeds=sorted(profile['seeds'][shot]),
   398	            epoch=arm['epoch'] if arm['epoch'] is not None else 'unknown (external)',
   399	            condition=profile['condition'], k=profile['grid'][0], training=arm['training'],
   400	            batch_size=profile['batch_size'], tf32=profile['tf32'],
   401	            max_samples=profile['max_samples'])
   402	        rows.append(dict(role=arm['role'], label=arm['label'], num_shot=shot, epoch=arm['epoch'],
   403	                         backbone=arm['backbone'], reference=arm['reference'],
   404	                         protocol=protocol, metrics=metrics))
   405	    literal = json.loads(json.dumps(json_value(profile)))
   406	    digest = hashlib.sha256(json.dumps(literal, sort_keys=True, separators=(',', ':'),
   407	                                       allow_nan=False).encode()).hexdigest()
   408	    return dict(schema_version=1, profile_name='TABLE_SEEN_V1', profile=literal,
   409	                profile_digest=digest, exploratory=exploratory, rows=rows,
   410	                deviations=list(admitted['deviations']), contracts=admitted['contracts'],
   411	                inputs=admitted['inputs'],
   412	                producer_closure_sha256=admitted['producer']['sha256']), admitted
   413	
   414	
   415	def main(argv=None):
   416	    parser = argparse.ArgumentParser(description=__doc__)
   417	    parser.add_argument('--profile', choices=('TABLE_SEEN_V1',), required=True)
   418	    parser.add_argument('--runs', nargs='+', required=True)
   419	    parser.add_argument('--json', required=True)
   420	    parser.add_argument('--md', default=str(MARKDOWN))
   421	    parser.add_argument('--force-md', action='store_true',
   422	                        help='Regenerate the Markdown; the JSON is always exclusive')
   423	    parser.add_argument('--exploratory', action='store_true',
   424	                        help='List unapproved pins and deviations instead of refusing')
   425	    argv = sys.argv[1:] if argv is None else argv
   426	    args = parser.parse_args(argv)
   427	    result, admitted = build_table(args.runs, exploratory=args.exploratory)
   428	    command = ['exp07_table.py', '--profile', args.profile, '--runs']
   429	    command += [str(Path(item).resolve()) for item in args.runs]
   430	    command += ['--json', str(Path(args.json).absolute()), '--md', str(Path(args.md).absolute())]
   431	    command += ['--force-md'] if args.force_md else []
   432	    command += ['--exploratory'] if args.exploratory else []
   433	    write_outputs(result, admitted, args.json, args.md, args.force_md, command)
   434	    return result
