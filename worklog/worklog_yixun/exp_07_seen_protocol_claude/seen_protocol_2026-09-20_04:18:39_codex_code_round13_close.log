   127	def rebind_training(built, role, args=None, manifest=None, completion=None):
   128	    """Rewrite an arm's bound training artefacts and repair every digest that binds them."""
   129	    attempt, digests = built.attempts[role], {}
   130	    for name, filename, payload in (('train_args', 'args.json', args),
   131	                                    ('train_manifest', 'train_manifest.json', manifest)):
   132	        if payload is not None:
   133	            digests[name] = built.replace(attempt / filename, payload)
   134	    finished = completion if completion is not None else built.read(attempt / 'completion.json')
   135	    finished['train_manifest_sha256'] = p.sha256_file(attempt / 'train_manifest.json')
   136	    for name in ('args.json', 'train_manifest.json'):
   137	        if name in finished['outputs']:  # the entries this rewrite invalidated
   138	            finished['outputs'][name] = p.sha256_file(attempt / name)
   139	    finished['directory_listing'] = dict(finished['outputs'])
   140	    digests['train_completion'] = built.replace(attempt / 'completion.json', finished)
   141	    for shot in (8, 1):
   142	        for directory in built.paths[(role, shot)]:
   143	            fields = built.read(Path(directory) / 'eval_manifest.json')
   144	            for name, digest in digests.items():
   145	                fields['mutable_inputs'][name]['sha256'] = digest
   146	            built.rebind(Path(directory), manifest=fields)
