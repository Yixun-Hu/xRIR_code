   227	def admit(directories, profile, approved=None, producer=None, exploratory=False,
   228	          producer_key='producer_table'):
   229	    """Route runs to (arm, K) groups, apply the contract, then collect through exp_04.
   230	
   231	    Only differences this module checks independently are waived from the inherited
   232	    admission; nothing on disk and no imported producer's state is modified.
   233	    """
   234	    pins, receipt = load_approved_digests() if approved is None else approved
   235	    approved = (pins, receipt)
   236	    deviations, groups, contracts, waivers, snapshots = [], [], {}, set(), {}
   237	    sidecars = {}  # shared across the runs of one arm; see run_contract
   238	    def check(ok, message):
   239	        if not ok:
   240	            deviations.append(message)
   241	    check(type(pins['schema_version']) is int and pins['schema_version'] == 1,
   242	          'approval schema_version')
   243	    for key in ('evaluator', 'writer', 'training_launcher', 'training', producer_key):
   244	        check(bool(pins['closures'][key]), 'profile not yet approved: ' + key)
   245	    for arm in profile['arms']:
   246	        effective = dict(arm)
   247	        if not arm['reference']:
   248	            checkpoint = pins['checkpoints'][arm['role']]
   249	            check(checkpoint['path'] == arm['checkpoint'] and
   250	                  _equal(checkpoint['epoch'], arm['epoch']),
   251	                  'approved checkpoint path/epoch: ' + arm['role'])
   252	            effective['sha256'] = checkpoint['sha256']
   253	        check(effective['sha256'] is not None,
   254	              'profile not yet approved: ' + arm['role'] + ' checkpoint')
   255	        for shot in sorted(profile['num_shot'], reverse=True):
   256	            groups.append((effective, shot, []))
   257	    if deviations and not exploratory:
   258	        raise ValueError('admission failed: ' + '; '.join(deviations))
   259	    directories = sorted(str(Path(item).resolve()) for item in directories)
   260	    check(len(set(directories)) == len(directories), 'duplicate run directories')
   261	    for directory in directories:
   262	        try:
   263	            fields = json.loads((Path(directory) / 'eval_manifest.json').read_text())
   264	            matches = [(arm, paths) for arm, shot, paths in groups
   265	                       if _equal(fields.get('num_shot'), shot) and
   266	                       (Path(fields['repo']) / fields['checkpoint']).resolve() ==
   267	                       (REPO / arm['checkpoint']).resolve()]
   268	            if len(matches) != 1:
   269	                raise ValueError('unregistered checkpoint/K')
   270	            arm, paths = matches[0]
   271	            paths.append(directory)
   272	            contract = run_contract(directory, arm, profile, pins, sidecars)
   273	            contracts[directory] = {key: value for key, value in contract.items()
   274	                                    if key not in ('waivers', 'inputs')}
   275	            for path, digest in contract['inputs'].items():
   276	                check(snapshots.get(path, digest) == digest, 'contract input changed: ' + path)
   277	                snapshots[path] = digest
   278	            waivers.update(contract['waivers'])
   279	        except (ValueError, TypeError, KeyError, OSError, IndexError) as error:
   280	            check(False, '{}: {}'.format(directory, error))
   281	    trainers = {c['training'] for c in contracts.values() if c['training'] is not None}
   282	    check(len(trainers) <= 1, 'the new arms do not share one training closure')
   283	    entry = 'tools.exp07_' + ('pairs' if producer_key == 'producer_pairs' else 'table')
   284	    producer = producer_identity(entry) if producer is None else producer
   285	    admitted = admit_runs(profile, groups, approved=approved, exploratory=True,
   286	                          producer=producer, producer_key=producer_key)
   287	    for path, digest in snapshots.items():
   288	        # Evidence only this contract reads -- the training inventory sidecar, the probe
   289	        # receipt, the hours ledger -- is bound here; what exp_04 also binds must agree.
   290	        check(admitted['inputs'].setdefault(path, digest) == digest,
   291	              'contract input changed: ' + path)
   292	    deviations.extend(item for item in admitted['deviations'] if item not in waivers)
   293	    if deviations and not exploratory:
   294	        raise ValueError('admission failed: ' + '; '.join(deviations))
   295	    admitted.update(deviations=deviations, contracts=contracts)
   296	    return groups, admitted
