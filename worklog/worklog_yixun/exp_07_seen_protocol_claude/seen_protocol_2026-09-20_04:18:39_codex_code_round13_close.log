   183	        expected = next(a['checkpoint'] for a in ARMS if a['role'] == role)
   184	        checks += [(arm['path'], lambda v, expected=expected: type(v) is str and v == expected),
   185	                   (arm['epoch'], lambda v: type(v) is int and v == 12), (arm['sha256'], digest)]
