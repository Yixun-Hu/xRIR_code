     1	"""Role-aware exp_07 (seen protocol) table producer.
     2	
     3	Admission reuses exp_04's :func:`tools.paired_compare.admit_runs` as the collector for
     4	everything the two experiments share and adds, in :func:`run_contract`, what exp_04
     5	cannot express: the seen split identity in every artefact that records it, the approved
     6	tools.exp07_eval and writer closures, and -- for the three NEW arms only -- the training
     7	provenance (approved checkpoint, completion/manifest/args bindings tied to the
     8	checkpoint's attempt directory, the seen protocol in the training manifest and its
     9	identity, one shared training closure and an admissible launcher closure -- both
    10	recomputed from their complete records -- and an args.json equal to the plan's recipe
    11	with this arm's backbone and yaw flags).  The released
    12	checkpoint is an EXTERNAL reference row: digest-only admission and no training bindings,
    13	with every evaluation check kept.
    14	"""
    15	import argparse
    16	import hashlib
    17	import json
    18	import sys
    19	from pathlib import Path
    20	
    21	import numpy as np
    22	
    23	from tools import exp07_provenance as e7p
    24	from tools import provenance
    25	from tools.exp05_params import TIERS
    26	from tools.exp07_profiles import get_profile, json_value, load_approved_digests
    27	from tools.paired_compare import (REPO, _closure_digest, _equal, admit_runs,
    28	                                  producer_identity)
    29	from tools.exp07_record import write_outputs as publish_outputs
    30	from tools.results_table import END, METRICS, STAMP, render_markdown as shared_markdown
    31	
    32	TRAINING_BINDINGS = ('train_args', 'train_manifest', 'train_completion')
    33	BINDING_FILES = {'train_args': 'args.json', 'train_manifest': 'train_manifest.json',
    34	                 'train_completion': 'completion.json', 'control_args': 'args.json'}
    35	CHECKPOINT_NAME = 'epoch_012.pth'
    36	
    37	
    38	def checkpoint_bytes(root, fields, pinned, cache, inputs, require):
    39	    """Hash the evaluated checkpoint itself when it is present and pin its bytes.
    40	
    41	    ``fields['checkpoint_sha256']`` is what the launcher recorded; this compares the file
    42	    that is on disk NOW with the runtime approval, so a substituted checkpoint is refused
    43	    even though the manifest still quotes the approved digest.  The digest joins
    44	    ``inputs``, so :func:`tools.exp07_record.write_outputs` rechecks it before publishing.
    45	    Absent checkpoints (an archived run) are left to the manifest's recorded digest.
    46	    """
    47	    path = (root / fields['checkpoint']).resolve()
    48	    if not path.is_file():
    49	        return
    50	    key = 'checkpoint:' + str(path)
    51	    if cache.get(key) is None:
    52	        cache[key] = provenance.sha256_file(path)
    53	    inputs[str(path)] = cache[key]
    54	    require(cache[key] == pinned, 'approved checkpoint bytes')
    55	
    56	
    57	def run_contract(directory, arm, profile, pins, cache=None):
    58	    """Validate the exp_07 additions; raise on the first named failure.
    59	
    60	    ``cache`` memoises the training inventory sidecars, which the thirty new-arm runs
    61	    bind to the same three files; the bytes are still bound per run and rehashed by
    62	    :func:`tools.results_table.write_outputs` before anything is published.  The returned
    63	    contract carries the run's identity -- role, K, evaluation seed and the digest of the
    64	    evaluation manifest it validated -- so the published contract map can be checked
    65	    run by run against the record the binder builds independently.
    66	    """
    67	    directory = Path(directory).resolve()
    68	    cache, inputs = {} if cache is None else cache, {}
    69	    def read(path):
    70	        raw = Path(path).read_bytes()
    71	        inputs[str(Path(path).resolve())] = hashlib.sha256(raw).hexdigest()
    72	        return json.loads(raw)
    73	    fields, completion, sample, metrics = [read(directory / name) for name in (
    74	        'eval_manifest.json', 'completion.json', 'per_sample_yaw.json', 'metrics_yaw.json')]
    75	    # What this contract is a contract FOR: the record binder checks these against the
    76	    # run it binds at that path, so a contract cannot be quoted for another evaluation.
    77	    contracted = dict(num_shot=fields.get('num_shot'), seed=fields.get('manifest_seed'),
    78	                      eval_manifest_sha256=inputs[str(directory / 'eval_manifest.json')])
    79	    def require(ok, message):
    80	        if not ok:
    81	            raise ValueError(message)
    82	    require(_equal(fields.get('decomposition_batches'), 0), 'decomposition_batches')
    83	    dataset = profile['dataset']
    84	    identity = dict(split='seen', seen_split_sha256=dataset['seen_split_sha256'])
    85	    # The reviewed run owner writes no split keys into completion.json; it binds the
    86	    # evaluation manifest, which declares the split, and the two outputs that echo it.
    87	    for payload in (fields, sample['meta'], metrics['meta']):
    88	        require(all(_equal(payload.get(key), value) for key, value in identity.items()),
    89	                'split identity')
    90	    require(completion.get('eval_manifest_sha256') == inputs[str(directory / 'eval_manifest.json')],
    91	            'completion binds the evaluation manifest')
    92	    require(_equal(fields.get('split_count'), dataset['n_queries']) and
    93	            _equal(fields.get('n_samples'), dataset['n_queries']) and
    94	            _equal(fields.get('max_samples'), profile['max_samples']), 'seen split coverage')
    95	    bound_split = fields['mutable_inputs'].get('seen_split')
    96	    require(bound_split is not None and bound_split['path'] == e7p.SEEN_SPLIT and
    97	            bound_split['sha256'] == dataset['seen_split_sha256'], 'seen_split binding')
    98	    for pin, recorded in (('evaluator', 'entrypoint'), ('writer', 'writer')):
    99	        digest = fields['source_closures'][recorded]['sha256']
   100	        require(digest is not None and digest == pins['closures'][pin], 'unapproved ' + pin)
   101	    names = set(fields['mutable_inputs'])
   102	    require(names <= set(BINDING_FILES) | {'seen_split', 'probe_receipt'},
   103	            'unknown mutable binding')
   104	    for name in names & set(BINDING_FILES):
   105	        require(Path(fields['mutable_inputs'][name]['path']).name == BINDING_FILES[name],
   106	                name + ' binding filename')
   107	    waivers = [str(directory) + ': mutable_inputs names']
   108	    root = Path(fields['repo'])
   109	    if arm['reference']:  # external checkpoint, exempt from TRAINING provenance only
   110	        require(not names & set(TRAINING_BINDINGS), 'released row has no training provenance')
   111	        require(arm['sha256'] == fields['checkpoint_sha256'], 'released checkpoint digest')
   112	        checkpoint_bytes(root, fields, arm['sha256'], cache, inputs, require)
   113	        return dict(role=arm['role'], reference=True, training=None, waivers=waivers,
   114	                    inputs=inputs, **contracted)
   115	    approved = pins['checkpoints'][arm['role']]
   116	    require(approved['path'] == arm['checkpoint'] and _equal(approved['epoch'], arm['epoch']) and
   117	            _equal(approved['epoch'], 12), 'approved checkpoint path/epoch')
   118	    require(approved['sha256'] == fields['checkpoint_sha256'], 'approved checkpoint digest')
   119	    checkpoint_bytes(root, fields, approved['sha256'], cache, inputs, require)
   120	    attempt = (root / fields['checkpoint']).resolve().parent
   121	    training = {}
   122	    for name in TRAINING_BINDINGS:
   123	        require(name in names, 'missing ' + name + ' binding')
   124	        bound = fields['mutable_inputs'][name]
   125	        path = (root / bound['path']).resolve()
   126	        require(path.parent == attempt, name + ' binding path')
   127	        training[name] = read(path)
   128	        require(inputs[str(path)] == bound['sha256'], name + ' bytes')
   129	    manifest, finished, args = (training[name] for name in
   130	                                ('train_manifest', 'train_completion', 'train_args'))
   131	    require(finished.get('train_manifest_sha256') ==
   132	            fields['mutable_inputs']['train_manifest']['sha256'],
   133	            'train_completion binds train_manifest')
   134	    outputs = finished.get('outputs')
   135	    require(isinstance(outputs, dict), 'train_completion outputs')
   136	    require(outputs.get(CHECKPOINT_NAME) == fields['checkpoint_sha256'],
   137	            'train_completion checkpoint epoch/digest')
   138	    require(outputs.get('args.json') == fields['mutable_inputs']['train_args']['sha256'],
