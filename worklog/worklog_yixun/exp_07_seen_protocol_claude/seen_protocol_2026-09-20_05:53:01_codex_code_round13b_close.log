   662	    monkeypatch.setattr(table, 'get_profile', lambda _: built.profile)
   663	    monkeypatch.setattr(table, 'load_approved_digests', lambda: built.approved)
   664	    monkeypatch.setattr(table, 'producer_identity', lambda _: built.producer)
   665	    expected_digest = canonical_profile_digest(built.profile)
   666	    result = table.main(cli_argv(tmp_path, built))
   667	    assert result['deviations'] == [] and result['exploratory'] is False
   668	    assert result['profile_name'] == 'TABLE_SEEN_V1' and len(result['rows']) == 8
   669	    written = json.loads((tmp_path / 'table.json').read_text())
   670	    assert written['rows'] == result['rows']
   671	    assert result['profile_digest'] == expected_digest
   672	    assert written['profile_digest'] == expected_digest
   673	    assert built.profile['arms'][0]['label'] in (tmp_path / 'seen.md').read_text()
