   644	def canonical_profile_digest(profile):
   645	    """Hash a profile the way the producer does, without reading anything it produced.
   646	
   647	    tools/exp07_table.py:374 detaches the registered profile with this module's own
   648	    ``json_value``; lines 405-407 round-trip that value through JSON and hash the
   649	    canonical text with exactly these ``json.dumps`` keywords.  Recomputing the digest
   650	    from the fixture's profile is what makes a digest the producer invents (an all-zero
   651	    string, say) fail, where comparing the written digest with the returned one lets both
   652	    be wrong together.
   653	    """
   654	    detached = table.json_value(profile)                            # exp07_table.py:374
   655	    literal = json.loads(json.dumps(table.json_value(detached)))    # exp07_table.py:405
   656	    return hashlib.sha256(json.dumps(literal, sort_keys=True, separators=(',', ':'),
   657	                                     allow_nan=False).encode()).hexdigest()  # :406-407
   658	
