+    literal = json.loads(json.dumps(table.json_value(detached)))    # exp07_table.py:405
+    return hashlib.sha256(json.dumps(literal, sort_keys=True, separators=(',', ':'),
+                                     allow_nan=False).encode()).hexdigest()  # :406-407
+
+
