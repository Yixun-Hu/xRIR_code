    30	def freeze(value):
    31	    """Recursively immutable: mappings become proxies and sequences tuples."""
    32	    if isinstance(value, dict):
    33	        return MP({key: freeze(item) for key, item in value.items()})
    34	    if isinstance(value, (list, tuple)):
    35	        return tuple(freeze(item) for item in value)
    36	    return value
