            calls=[('table',lambda:table.build_table(built.directories,built.profile,built.approved,producer=built.producer)),
                   ('producer',lambda:cal.build_calibration(runs,built.producer['commit'],profile=built.profile,producer=built.producer)),
                   ('measure',lambda:cal.measure(runs))]
            values={}
            for route,call in calls:
                if scenario=='boundary':values[route]=call()
                else:
                    with pytest.raises(ValueError,match='finite count tolerance exceeded: '+metric+'|zero finite queries: '+metric):call()
                cases.append([metric,scenario,route,'accepted' if scenario=='boundary' else 'refused'])
            if scenario=='boundary':
                result=values['producer'][0]
                assert result['passed']
                assert values['measure']==result['metrics']
                row=next(row for row in values['table'][0]['rows'] if row['role']=='released_seen' and row['num_shot']==8)
                assert row['metrics']['EDT']['mean']==pytest.approx(result['metrics']['EDT']['mean']*1000)
                assert result['metrics']['EDT']['unit']=='s'
            print('CALIBRATION',metric,scenario,'all three routes',flush=True)
            for run,(sample,metrics) in originals.items():built.rebind(run,sample=copy.deepcopy(sample),metrics=copy.deepcopy(metrics))
    (REVIEW/'calibration-boundaries.json').write_text(json.dumps(cases,indent=2))
    print('CALIBRATION 75 route checks; approval traps untouched; EDT native seconds',flush=True)


