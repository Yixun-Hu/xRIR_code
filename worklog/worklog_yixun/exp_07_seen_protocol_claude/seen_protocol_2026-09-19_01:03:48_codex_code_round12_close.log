        expected = next(raw for path, raw in before.items() if Path(path).suffix == suffix)
        assert output.read_bytes() == expected
        assert str(destination).encode() not in output.read_bytes()
    if moved == 'root':
        # The product bytes live underneath the relocated root, not in a separate directory.
        assert bound.paths['table'].resolve() == destination / 'results' / bound.paths['table'].name
        for module in ('make_results_md', 'make_results_html', 'make_latex'):
            protected = destination / 'results' / bound.paths['table'].name
            original = protected.read_bytes()
            with pytest.raises(ValueError, match='output overlaps canonical input'):
                load_asset(module).main(previous.argv(bound.paths, out=protected))
            assert protected.read_bytes() == original
        checkpoint = attempt / 'epoch_012.pth'
        raw = checkpoint.read_bytes()
        checkpoint.write_bytes(bytes([raw[0] ^ 1]) + raw[1:])
        for check in (lambda: bound.binder.collect(**bound.arguments),
                      lambda: load_asset('check_record').main([str(bound.reports)])):
            with pytest.raises(ValueError, match='digest mismatch'):
                check()


def test_repoint_final_to_byte_identical_copy_is_refused(bound):
    previous.write_report(bound)
    attempt = bound.built.attempts['seen_simple']
    copy = attempt.parent / 'attempt_cloned'
    shutil.copytree(attempt, copy)
    final = attempt.parent / 'final'
    final.unlink()
    final.symlink_to(copy.name, target_is_directory=True)
    for check in (lambda: bound.binder.collect(**bound.arguments),
                  lambda: load_asset('check_record').main([str(bound.reports)])):
        with pytest.raises(ValueError, match='not exactly one approved arm'):
            check()


def test_writer_publishes_under_logical_symlink_parent(record_inputs, tmp_path):
    built = record_inputs['built']
    result, admitted = table.build_table(built.directories, built.profile,
                                        built.approved, producer=built.producer)
    logical = tmp_path / 'new-products'
    physical = tmp_path / 'archive-products'
    physical.mkdir()
    logical.symlink_to(physical, target_is_directory=True)
    product, companion = logical / 'table.json', logical / 'table.md'
    write_outputs(result, admitted, product, companion, lambda path, cmd: str(path))
    side = json.loads(previous.sidecar(product).read_text())
    assert set(side['outputs']) == {str(product), str(companion)}
    assert companion.read_text() == str(product)
    load_asset('make_results_md').load(product, 'TABLE_SEEN_V1')

@pytest.mark.parametrize('form', ['symlink_to_other_attempt', 'plain_final_directory'])
def test_final_directory_identity_must_survive_checkpoint_hardlink(bound, tmp_path, form):
    report = previous.write_report(bound)
    attempt = bound.built.attempts['seen_simple']
    previous.relocate(attempt, tmp_path / 'archive' / attempt.name)
    final = attempt.parent / 'final'
    final.unlink()
    other = attempt.parent / ('attempt_other' if form == 'symlink_to_other_attempt' else 'final')
    other.mkdir()
    os.link(str(attempt / 'epoch_012.pth'), str(other / 'epoch_012.pth'))
    if form == 'symlink_to_other_attempt':
        final.symlink_to(other.name, target_is_directory=True)
    assert not final.samefile(attempt)
    assert (final / 'epoch_012.pth').samefile(attempt / 'epoch_012.pth')
    outcomes = []
    for label, check in [('collect', lambda: bound.binder.collect(**bound.arguments)),
                         ('check_record', lambda: load_asset('check_record').main([str(bound.reports)]))]:
        try:
            result = check()
        except ValueError:
            outcomes.append((label, 'REFUSED'))
        else:
            if label == 'collect':
                assert result == report
            outcomes.append((label, 'ACCEPTED'))
    print('FINAL_DIRECTORY_IDENTITY', form, outcomes, flush=True)
    assert all(state == 'REFUSED' for _, state in outcomes), outcomes
