@pytest.mark.parametrize('metric', ['edt', 'c50', 't60', 'loss', 'log_mse'])
@pytest.mark.parametrize('removed', [5, 12])
def test_calibration_every_metric_finite_count(calibrated, metric, removed):
    built=calibrated.built
    run=Path(calibrated.runs[0]); sample=read(run/'per_sample_yaw.json')
    sample['P']['0'][metric][:removed]=[None]*removed
    metrics=read(run/'metrics_yaw.json'); metrics['P']=built.summaries(sample['P'])
    built.rebind(run,sample=sample,metrics=metrics)
    with pytest.raises(ValueError,match='finite count tolerance exceeded|zero finite'):
        table.build_table(built.directories,built.profile,built.approved,producer=built.producer)
    try:
        result,_=calibrated.build()
    except ValueError as error:
        print('REFUSED calibration finite-count',metric,removed,str(error),flush=True)
        assert metric in ('edt','c50','t60','loss','log_mse')
    else:
        pytest.fail('calibration accepted invalid finite cohort')
        assert cal.measure(calibrated.runs)==result['metrics']
        print('HOLE calibration ACCEPTED; table REFUSED',metric,'missing',removed,flush=True)


