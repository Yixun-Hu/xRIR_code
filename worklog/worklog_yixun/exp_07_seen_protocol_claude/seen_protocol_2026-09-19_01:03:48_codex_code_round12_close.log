    products=list(map(Path,bnd.arguments['results']))
    for index,path in enumerate(products):
        raw=path.read_bytes();side_raw=sidecar(path).read_bytes();data=json.loads(raw)
        other=products[1 if index==0 else 0]
        foreign=binder.producer_declarations(json.loads(sidecar(other).read_text())['producer'])
        absent=set(foreign)-set(data['inputs']);assert absent
        for name in absent:
            change_product(path,lambda d,s:d['inputs'].__setitem__(name,foreign[name]));recite(bnd)
            with pytest.raises(ValueError,match='does not bind as this product'):binder.collect(**bnd.arguments)
            with pytest.raises(ValueError,match='does not bind as this product'):load_asset('check_record').main([str(bnd.reports)])
            path.write_bytes(raw);sidecar(path).write_bytes(side_raw);recite(bnd)
        print('REFUSED other product declared closure',index,sorted(absent),flush=True)

