def read(path):
    return json.loads(Path(path).read_text())


def write(path, data):
    Path(path).write_text(json.dumps(data))


def repair_calibration(bound, data):
    path = bound.evidence['calibration']
    write(path, data)
    side = read(sidecar(path))
    side['outputs'][str(path)] = p.sha256_file(path)
    write(sidecar(path), side)


def test_new_binder_counterexamples_and_refusals(bound):
    binder = bound.binder
    baseline = binder.collect(**bound.arguments)
    root = Path(bound.paths['out']).parent
    originals = {path: path.read_bytes() for path in root.rglob('*')
                 if path.is_file() and '.git' not in path.parts}
    def restore():
        for path, raw in originals.items():
            path.parent.mkdir(parents=True,exist_ok=True)
            path.write_bytes(raw)
    def check(name, mutate, refuses):
        restore(); mutate()
        try:
            result = binder.collect(**bound.arguments)
        except (ValueError, KeyError, OSError) as error:
            print('REFUSED', name, str(error), flush=True)
            assert refuses, name
        else:
            print('ACCEPTED', name, flush=True)
            assert not refuses, name
            json.dumps(result,allow_nan=False)
        restore()

    def self_consistent_calibration():
        data = read(bound.evidence['calibration'])
