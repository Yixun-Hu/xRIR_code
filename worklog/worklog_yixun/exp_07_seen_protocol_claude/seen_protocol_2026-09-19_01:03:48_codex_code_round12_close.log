def test_other_products_actual_declared_producer_closure_is_refused(exp07_fixture,table_fixture,tmp_path,monkeypatch):
    holder={}; original=pairs.build_pairs
    def build():
        built=exp07_fixture();producer=copy.deepcopy(built.producer)
        item=producer['files'][0];item['path']='tools/exp07_pairs.py'
        digest=p.sha256_file(Path(pairs.__file__))
        item['reviewed_blob_sha256']=item['working_tree_sha256']=digest
        producer['sha256']=_closure_digest(producer)
        built.pins['closures']['producer_pairs']=producer['sha256']
        Path(built.approved[1]['path']).write_text(json.dumps(built.pins))
        built.approved[1]['sha256']=p.sha256_file(built.approved[1]['path'])
        holder['producer']=producer
        return built
    def build_pairs(*a,**kw):
        kw['producer']=holder['producer']
        return original(*a,**kw)
    monkeypatch.setattr(pairs,'build_pairs',build_pairs)
    inputs=record_inputs.__wrapped__(build,table_fixture,tmp_path)
    bnd=bound.__wrapped__(inputs,tmp_path,monkeypatch)
