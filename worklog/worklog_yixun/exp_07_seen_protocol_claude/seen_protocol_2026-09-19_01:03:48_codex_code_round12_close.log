def test_every_attempt_file_and_log_remains_bound_and_checked(bound):
    report=bound.binder.collect(**bound.arguments);saved(bound,report)
    checker=load_asset('check_record');checker.main([str(bound.reports)])
    records={}
    def walk(value):
        if isinstance(value,dict):
            if isinstance(value.get('path'),str) and isinstance(value.get('sha256'),str):records[value['path']]=value['sha256']
            for item in value.values():walk(item)
        elif isinstance(value,list):
            for item in value:walk(item)
    walk(report['attempts'])
    required=set()
    for arm in report['attempts']:
        required.update(str(path.resolve()) for path in Path(arm['path']).rglob('*') if path.is_file())
        for other in arm['other_attempts']:
            required.update(str(path.resolve()) for path in Path(other['path']).rglob('*') if path.is_file())
            required.update(item['path'] for item in other['logs'] if item['present'])
