def test_scoped_overrides_restore_on_nested_and_exception():
    from tools import exp04_launcher as base
    before=dict(vars(base))
    from tools import exp07_launcher as launch
    assert all(vars(base).get(k) is v for k,v in before.items())
    try:
        with launch.seen_overrides():
            outer=dict(vars(base))
            try:
                with launch.seen_overrides():raise RuntimeError('inner')
            except RuntimeError:pass
            assert all(vars(base).get(k) is v for k,v in outer.items())
            raise RuntimeError('outer')
    except RuntimeError:pass
    assert set(vars(base))==set(before)
    assert all(vars(base).get(k) is v for k,v in before.items())
    print('RESTORED full exp04 module namespace after import-first, nesting and exceptions')


def test_protocol_seam_preserves_rng_and_restores_bindings(monkeypatch):
    import train_xRIR_backbone as trainer
    original_args,original_class,original_argv=trainer.parse_args,trainer.xRIR_Dataset,sys.argv
    def snapshot():
        return random.getstate(),np.random.get_state(),torch.get_rng_state().clone()
    before=snapshot();seen=[]
    def fake_main():
        args=trainer.parse_args();seen.append((vars(args),trainer.xRIR_Dataset,snapshot()))
        raise RuntimeError('stop before training')
    monkeypatch.setattr(trainer,'main',fake_main)
    arguments=['--backbone','simple','--save-dir','/unused','--protocol','unseen']
    with pytest.raises(RuntimeError,match='stop'):train.run_trainer(arguments)
    after=snapshot()
    assert before[0]==after[0] and before[1][0]==after[1][0]
    assert np.array_equal(before[1][1],after[1][1]) and before[1][2:]==after[1][2:]
    assert torch.equal(before[2],after[2])
    assert seen[0][1] is original_class and seen[0][0]['protocol']=='unseen'
    assert trainer.parse_args is original_args and trainer.xRIR_Dataset is original_class and sys.argv is original_argv
    print('RNG_UNCHANGED Python NumPy Torch; seam restored on exception')


