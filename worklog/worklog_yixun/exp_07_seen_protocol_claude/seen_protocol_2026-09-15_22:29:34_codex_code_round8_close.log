    old=types.ModuleType('round7_table');old.__file__=table.__file__
    exec(compile(source,'round7_table.py','exec'),old.__dict__)
    before,_=old.build_table(built.directories,built.profile,built.approved,producer=built.producer)
    after,_=table.build_table(built.directories,built.profile,built.approved,producer=built.producer)
    encode=lambda obj:json.dumps(obj,sort_keys=True,indent=2,allow_nan=False).encode()+b'\\n'
    (REVIEW/'table-d58c2fd.json').write_bytes(encode(before))
    (REVIEW/'table-fd6e521.json').write_bytes(encode(after))
    assert encode(before['rows'])==encode(after['rows'])
    normalized=copy.deepcopy(after)
    for contract in normalized['contracts'].values():
        for key in ('num_shot','seed','eval_manifest_sha256'):
            contract.pop(key)
    assert encode(before)==encode(normalized)
    # Isolate the helper extraction itself from the separately intended identity additions.
    old.run_contract=table.run_contract
    isolated,_=old.build_table(built.directories,built.profile,built.approved,producer=built.producer)
    assert encode(isolated)==encode(after)
    print('BYTE_IDENTICAL numerical rows',hashlib.sha256(encode(after['rows'])).hexdigest(),
          '; full JSON differs only by three added contract identity fields;',
          'helper-only full JSON byte-identical',flush=True)


