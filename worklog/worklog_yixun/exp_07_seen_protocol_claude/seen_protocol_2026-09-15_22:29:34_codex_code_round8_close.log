def test_product_coverage_matrix(bound):
    b=bound.binder;report=b.collect(**bound.arguments)
    attempts=[b.attempt_record(path,bound.built.pins) for path in bound.arguments['attempt']]
    attempt_bound={item['role']:item.pop('bound') for item in attempts}
    runs=[b.run_record(path,attempts,report['released_checkpoint']) for path in bound.arguments['runs']]
    run_bound={item['path']:item.pop('bound') for item in runs}
    def bind():
        return b.bind_results(bound.arguments['results'],report['git_HEAD'],report['approved_digests'],runs,attempts,run_bound,attempt_bound)
    assert bind()
    unexpected=[];count=0;allowed_additions=[]
    for index,path in enumerate(map(Path,bound.arguments['results'])):
        original=path.read_bytes();original_side=sidecar(path).read_bytes();data=read(path)
        label='TABLE' if index==0 else 'PAIR:'+data['pairing'][0]
        def restore():path.write_bytes(original);sidecar(path).write_bytes(original_side)
        def exercise(name,mutate,refuses=True):
            nonlocal count
            restore();change_product(path,mutate);count+=1
            try:bind()
            except (ValueError,KeyError,OSError) as error:
                if not refuses:unexpected.append((label,name,'refused',str(error)))
            else:
                if refuses:unexpected.append((label,name,'ACCEPTED'))
            finally:restore()
        # Every declared dependency, every run flag, every contract, independently removed.
        for dependency in sorted(data['inputs']):
            exercise('omit input '+dependency,lambda d,s,key=dependency:d['inputs'].pop(key))
        for run_path in sorted(data['contracts']):
            exercise('omit contract '+run_path,lambda d,s,key=run_path:d['contracts'].pop(key))
            exercise('omit flag '+run_path,lambda d,s,key=run_path:s['run_flags'].pop(key))
        first=sorted(data['contracts'])[0]
        for key,value in [('num_shot',99),('seed',999),('role','bad'),('reference','bad'),('eval_manifest_sha256','f'*64)]:
            exercise('contract '+key,lambda d,s,k=key,v=value:d['contracts'][first].update({k:v}))
        exercise('extra contract',lambda d,s:d['contracts'].__setitem__('/not/a/run',copy.deepcopy(d['contracts'][first])))
        exercise('extra run flag',lambda d,s:s['run_flags'].__setitem__('/not/a/run',{}))
        exercise('foreign dependency',lambda d,s:d['inputs'].__setitem__('/not/an/input','f'*64))
        for role in ('seen_simple','seen_cyl','seen_aug','released_seen'):
            if role in (set(b.ROLES) if index==0 else set(data['pairing'])):continue
            outsider=Path(bound.built.paths[(role,8)][0])
            for filename in ('completion.json','metrics_yaw.json','eval_manifest.json'):
                dep=outsider/filename
                exercise('foreign role '+role+' '+filename,lambda d,s,pth=dep:d['inputs'].__setitem__(str(pth),p.sha256_file(pth)))
            if role"'!='"'released_seen':
                dep=bound.built.attempts[role]/'epoch_012.pth'
                exercise('foreign checkpoint '+role,lambda d,s,pth=dep:d['inputs'].__setitem__(str(pth),p.sha256_file(pth)))
        roles=set(b.ROLES) if index==0 else set(data['pairing'])
        expected={r['path'] for r in runs if r['role'] in roles}
        required,allowed=b.product_inputs(expected,roles,{i['role']:i for i in attempts},run_bound,attempt_bound,report['approved_digests'])
        for dep in sorted(set(allowed)-set(data['inputs'])):
            # Characterize the complete extra allowlist; do not assume it is appropriate.
            exercise('allowed addition '+dep,lambda d,s,k=dep:d['inputs'].__setitem__(k,allowed[k]),False)
            allowed_additions.append((label,dep))
        print('COVERAGE',label,'declared inputs',len(data['inputs']),'contracts',len(data['contracts']),
              'extra allowed',len(set(allowed)-set(data['inputs'])),flush=True)
    write(REVIEW/'coverage-matrix.json',dict(cases=count,unexpected=unexpected,allowed_additions=allowed_additions))
    print('COVERAGE CASES',count,'UNEXPECTED',unexpected,flush=True)
    assert not unexpected


