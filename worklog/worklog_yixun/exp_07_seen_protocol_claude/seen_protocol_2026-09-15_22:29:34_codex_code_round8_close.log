@pytest.mark.parametrize('index',range(4))
def test_missing_probe_and_ledger_end_to_end(bound,index):
    path=Path(bound.arguments['results'][index]);data=read(path)
    omitted=[key for key in data['inputs'] if Path(key).name=='cumulative_hours.json' or Path(key).name.startswith('_probe_t_')]
    assert omitted
    change_product(path,lambda d,s:[d['inputs'].pop(key) for key in omitted]);recite(bound)
    report=bound.binder.collect(**bound.arguments)
    write(bound.reports/'binding_report_20260916T010203000000Z.json',report)
    load_asset('check_record').main([str(bound.reports)])
    print('HOLE binder AND checker ACCEPT missing probe/ledger',index,len(omitted),flush=True)


def test_setup_failure_with_stray_internal_log(bound):
    setup_failure(bound)
    root=attempt_root(bound,'seen_cyl');directory=root/'attempt_setup_ABORTED_setup_failed'
    repair_input(bound,root/'cumulative_hours.json');recite(bound)
    before=bound.binder.collect(**bound.arguments)
    (directory/'stray.log').write_text('stray evidence\\n')
    after=bound.binder.collect(**bound.arguments)
    row=next(row for arm in after['attempts'] if arm['role']=='seen_cyl' for row in arm['other_attempts'] if row.get('reason')=='setup_failed')
    assert row['setup_failure'] is True
    assert any(Path(item['path']).name=='stray.log' for item in row['files'])
    check_saved_report(bound,before)
    print('ACCEPTED setup failure with unreferenced internal stray log; bytes are bound and checker detects edit',flush=True)
