    xml.write_bytes(raw.replace(b'tests=\"9\"',b'tests=\"8\"'))
    assert xml.stat().st_size==len(raw)
    os.utime(str(xml),ns=(stat.st_atime_ns,stat.st_mtime_ns))
    with pytest.raises(ValueError,match='digest mismatch'):
        binder.collect(**bound.arguments)
    check_saved_report(bound,before)
    xml.write_bytes(raw)
    original=path.read_bytes()
    for key in ('git_head','reviewed_commit'):
        altered=copy.deepcopy(data)
        altered[key]=subprocess.check_output(['git','rev-parse','HEAD~1'],text=True).strip()
        write(path,altered)
        with pytest.raises(ValueError,match='did not run at the reviewed commit'):
            binder.collect(**bound.arguments)
        path.write_bytes(original)
    print('REFUSED same-size/same-mtime XML edit and both mismatched-commit directions',flush=True)


def test_calibration_sidecar_changes_and_checker(bound):
    binder=bound.binder;before=binder.collect(**bound.arguments)
    path=sidecar(bound.evidence['calibration']);raw=path.read_bytes();data=read(path)
    data['generation_command']=['changed','command'];write(path,data)
    after=binder.collect(**bound.arguments)
    assert after"'!=before
    assert after['"'evidence']['calibration']['sidecar']['sha256']"'!=before['"'evidence']['calibration']['sidecar']['sha256']
    check_saved_report(bound,before)
    path.write_bytes(raw);data=read(path);data['producer']['files']=[];write(path,data)
    with pytest.raises(ValueError,match='producer closure records'):
        binder.collect(**bound.arguments)
    check_saved_report(bound,before)
    print('DETECTED sidecar command edit; REFUSED missing closure; checker refused both',flush=True)


def test_aborted_log_edit_and_checker(bound):
