def recite(bound):
    citations='\n'.join(p.sha256_file(path) for path in bound.arguments['results']+[bound.arguments['unseen_table']])
    for path in bound.arguments['rendered']:
        Path(path).write_text(citations)


def change_product(path, mutate):
    path=Path(path)
    data=json.loads(path.read_text()); side=json.loads(sidecar(path).read_text())
    mutate(data,side)
    side['inputs']=data['inputs']
    if 'run_flags' in data: side['run_flags']=data['run_flags']
    path.write_text(json.dumps(data)); side['outputs'][str(path.resolve())]=p.sha256_file(path)
    sidecar(path).write_text(json.dumps(side))


def test_round5_replay_and_stronger_binder_mutations(bound):
    binder=bound.binder
    products=list(bound.arguments['results'])
    original={path:path.read_bytes() for path in bound.built.root.rglob('*') if path.is_file() and '.git' not in path.parts}
    original.update({path:path.read_bytes() for path in Path(bound.paths['table']).parent.rglob('*') if path.is_file()})
    original.update({Path(path):Path(path).read_bytes() for path in bound.arguments['rendered']})
    original.update({Path(bound.arguments['audit']):Path(bound.arguments['audit']).read_bytes()})
    original.update({path:path.read_bytes() for path in bound.evidence.values()})
    def restore():
        for path,raw in original.items():path.write_bytes(raw)
    def check(name, mutate, refusal):
        restore();mutate();recite(bound)
        try: report=binder.collect(**bound.arguments)
        except (ValueError,KeyError,OSError) as e:
            print('REFUSED',name,str(e)); assert refusal,name
        else:
            print('ACCEPTED',name); assert not refusal,name
        restore()
    # Exact mutations from the last combined review, with all outer hashes repaired.
    def cell_mut(field):
        def mutate():
            def apply(d,s):
                c=d['cells'][0]
                if field=='absolute_reconverge':c['statistics']['absolute']['reconverge_required']=True
                elif field=='relative_failed':c['statistics']['relative']['convergence']['passed']=False
                elif field=='decision':c['decision_driving']=True
                else:c['pairing']=['seen_aug','released_seen']
            change_product(products[1],apply)
            with pytest.raises(ValueError):load_asset('make_results_md').arguments(argv(bound.paths))
        return mutate
    for field in ('absolute_reconverge','relative_failed','decision','pairing'):
        check('round5_'+field,cell_mut(field),True)
    check('round5_nonfinal_pairs',lambda:change_product(products[1],lambda d,s:d.update(final=False,reconverge_required=['EDT K=8'])),True)
    check('round5_empty_table',lambda:change_product(products[0],lambda d,s:d.update(rows=[])),True)
    run=Path(bound.arguments['runs'][0])
    check('round5_missing_one_run_input',lambda:change_product(products[0],lambda d,s:d['inputs'].pop(str(run/'metrics_yaw.json'))),True)
    inventory=str(bound.built.attempts['seen_simple']/'train_inventory.json')
    check('round5_stale_inventory_digest',lambda:change_product(products[0],lambda d,s:d['inputs'].__setitem__(inventory,'f'*64)),True)
    def approval(d,s):
        old=s['approved_digests']['path'];s['approved_digests']['path']='/nonexistent/approved.json'
        d['inputs']['/nonexistent/approved.json']=d['inputs'].pop(old)
    check('round5_false_approval_path',lambda:change_product(products[0],approval),True)
    check('round5_unrelated_audit',lambda:Path(bound.arguments['audit']).write_text('{"protocol":"unseen","passed":false}'),True)
    def drop_run(d,s):
        s['run_flags'].pop(str(run))
        d.get('contracts',{}).pop(str(run),None)
        for key in list(d['inputs']):
            if Path(key).parent==run:d['inputs'].pop(key)
    check('whole_run_removed_from_table_provenance',lambda:change_product(products[0],drop_run),True)
    check('required_training_inventory_removed',lambda:change_product(products[0],lambda d,s:d['inputs'].pop(inventory)),True)
    fields=bound.built.read(run/'eval_manifest.json')
    reference=fields['manifest_path']
    assert reference in json.loads(Path(products[0]).read_text())['inputs']
    check('reference_manifest_input_digest_substituted',lambda:change_product(products[0],lambda d,s:d['inputs'].__setitem__(reference,'f'*64)),True)
    check('nonexistent_dependency_added',lambda:change_product(products[0],lambda d,s:d['inputs'].__setitem__('/nonexistent/exp07_review_dependency.json','f'*64)),True)
    def alter_split():
        sample=bound.built.read(run/'per_sample_yaw.json');metrics=bound.built.read(run/'metrics_yaw.json')
        sample['meta']['split']=metrics['meta']['split']='unseen'
        bound.built.rebind(run,sample=sample,metrics=metrics)
        for path in products:
            def repair(d,s):
                for name in ('per_sample_yaw.json','metrics_yaw.json','completion.json'):
                    key=str(run/name)
                    if key in d['inputs']:d['inputs'][key]=p.sha256_file(key)
            change_product(path,repair)
        with pytest.raises(ValueError,match='split identity'):
            table.build_table(bound.built.directories,bound.built.profile,bound.built.approved,producer=bound.built.producer)
    check('binder_accepts_unseen_output_metas_under_seen_manifest',alter_split,True)
    # Calibration has no relation to fixture evaluations; positive infinite SD admits any finite mean.
    def bad_calibration():
        path=bound.evidence['calibration']; d=json.loads(path.read_text())
        for c in d['metrics'].values():c.update(mean=1000000.,sd=float('inf'))
        path.write_text(json.dumps(d))
    check('calibration_infinite_sd_arbitrary_mean',bad_calibration,True)
    check('failed_gpu_parity_log',lambda:bound.evidence['gpu_parity'].write_text('9 failed, 0 passed\n'),True)


