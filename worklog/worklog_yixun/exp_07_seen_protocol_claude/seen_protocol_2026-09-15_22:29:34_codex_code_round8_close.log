def read(path):
    return json.loads(Path(path).read_text())


def write(path, data):
    Path(path).write_text(json.dumps(data))


def repair_calibration(bound, data):
    path = bound.evidence['calibration']
    write(path, data)
    side = read(sidecar(path))
    side['outputs'][str(path)] = p.sha256_file(path)
    write(sidecar(path), side)


