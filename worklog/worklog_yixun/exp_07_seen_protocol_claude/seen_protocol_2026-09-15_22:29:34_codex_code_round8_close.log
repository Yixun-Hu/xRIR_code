from test_exp07_parity import SUITE, case, passing
from tools import exp07_calibration as cal, exp07_parity as parity, provenance as p
from tools.exp07_record import load_asset


def read(path):
    return json.loads(Path(path).read_text())


def write(path, data):
    Path(path).write_text(json.dumps(data))


def repair_calibration(bound, data):
    path = bound.evidence['calibration']
    write(path, data)
    side = read(sidecar(path))
    side['outputs'][str(path)] = p.sha256_file(path)
    write(sidecar(path), side)


def test_new_binder_counterexamples_and_refusals(bound):
    binder = bound.binder
    baseline = binder.collect(**bound.arguments)
    root = Path(bound.paths['out']).parent
    originals = {path: path.read_bytes() for path in root.rglob('*')
                 if path.is_file() and '.git' not in path.parts}
    def restore():
        for path, raw in originals.items():
            path.parent.mkdir(parents=True,exist_ok=True)
            path.write_bytes(raw)
    def check(name, mutate, refuses):
        restore(); mutate()
        try:
            result = binder.collect(**bound.arguments)
        except (ValueError, KeyError, OSError) as error:
            print('REFUSED', name, str(error), flush=True)
            assert refuses, name
        else:
            print('ACCEPTED', name, flush=True)
            assert not refuses, name
            json.dumps(result,allow_nan=False)
        restore()

    def self_consistent_calibration():
        data = read(bound.evidence['calibration'])
        per = {name:{int(seed): value + .001 for seed,value in cell['per_seed'].items()}
               for name,cell in data['metrics'].items()}
        data['metrics'] = cal.summarise(per)
        assert all(cell['passed'] for cell in data['metrics'].values())
        repair_calibration(bound,data)
    check('calibration internally consistent but different bound runs', self_consistent_calibration, True)

    def parity_xml(kind, update_digest=True):
        path = bound.evidence['gpu_parity']; data=read(path)
        xml=Path(data['junit']['path'])
        outcomes = [(node,'failed' if i == 0 and kind == 'failure' else 'passed')
                    for i,node in enumerate(parity.TESTS)]
        xml.write_text('<garbage/>' if kind=='empty' else SUITE.format(n=9,cases=''.join(case(*v) for v in outcomes)))
        if update_digest:data['junit']['sha256']=p.sha256_file(xml)
        write(path,data)
    check('parity XML has failed case but JSON claims nine passes',lambda:parity_xml('failure'),False)
    check('parity XML has no test cases',lambda:parity_xml('empty'),False)
    def stale_log():
        parity_xml('passed')
        Path(read(bound.evidence['gpu_parity'])['log']['path']).write_text('different log')
    check('nine JUnit ids with stale log digest',stale_log,True)
    def mismatch_commit():
        path=bound.evidence['gpu_parity'];data=read(path)
        data['reviewed_commit']=subprocess.check_output(['git','rev-parse','HEAD~1'],text=True).strip()
        write(path,data)
    check('parity copied with mismatched reviewed commit',mismatch_commit,True)

    def logless_abort():
        directory=attempt_root(bound)/'attempt_first_ABORTED_slow'
        data=read(directory/'abort.json');data.pop('log')
        write(directory/'abort.json',data)
        (directory/'execution.json').unlink()
    check('guard_epoch_one abort without log block or execution classified setup failure',logless_abort,False)
    def missing_probe_log():
        completion=read(attempt_root(bound)/'_probe_t_arm/completion.json')
        Path(completion['log']['path']).unlink()
    check('certified probe external log removed',missing_probe_log,False)
    def orphan():
        path=attempt_root(bound)/'cumulative_hours.json';data=read(path)
        data['attempts'].append(dict(attempt='vanished',mode='smoke',hours=0))
        write(path,data)
    check('ledger attempt directory absent',orphan,True)
    def wrong_probe_completion():
        path=attempt_root(bound)/'_probe_t_seen_simple.json';data=read(path)
        data['probe_attempt']['completion_sha256']='f'*64;write(path,data)
    check('probe receipt linked to wrong completion',wrong_probe_completion,True)
    def split_meta():
        run=Path(bound.arguments['runs'][0]);sample=bound.built.read(run/'per_sample_yaw.json')
        sample['meta']['split']='unseen';bound.built.rebind(run,sample=sample)
    check('one output meta mismatches while the other matches',split_meta,True)

    for module in ('make_results_html','make_latex'):
        original=bound.paths['binding'];before=original.read_bytes()
        alias=original.parent/(module+'.alias');os.link(str(original),str(alias))
        with pytest.raises(ValueError,match='output overlaps canonical input'):
            load_asset(module).main(argv(bound.paths,out=alias))
        assert original.read_bytes()==before
        print('REFUSED hardlink', module, flush=True)
        alias.unlink()


