   113	def analyze(profile, admitted, exploratory=False):
   114	    """Compute all registered arms/cells; convergence and admission precede verdicts."""
   115	    result = dict(schema_version=1, profile=json_value(profile), profile_digest=_digest(profile),
   116	        exploratory=exploratory, deviations=list(admitted['deviations']),
   117	        inputs=admitted['inputs'], run_flags=admitted['run_flags'], cells=[], curves=[])
   118	    if 'verdict_scope' in profile:
   119	        result['verdict_scope'] = profile['verdict_scope']
   120	    def failure(message):
   121	        if not exploratory:
   122	            raise ValueError(message)
   123	        result['deviations'].append(message)
   124	    if result['deviations'] and not exploratory:
   125	        failure('admission failed: ' + '; '.join(result['deviations']))
   126	    groups = admitted['groups']
   127	    flat = [r for group in groups for r in group]
   128	    paired = (len(groups) == len(profile['arms']) and flat and
   129	        all([r['meta']['manifest_seed'] for r in group] == list(profile['eval_seeds']) for group in groups) and
   130	        all(r['query'] == flat[0]['query'] and r['index'] == flat[0]['index'] for r in flat))
   131	    if not paired:
   132	        failure('analysis unavailable: registered seed/query pairing')
   133	        return result
   134	    for arm, runs in zip(profile['arms'], groups):
   135	        for metric in profile['metrics']['primary'] + profile['metrics']['descriptive']:
   136	            for k in profile['grid']:
   137	                try:
   138	                    result['curves'].append(curve_point(profile, runs, arm, metric, k))
   139	                    if profile['mode'] == 'yaw' and k != 0:
   140	                        result['cells'].append(yaw_cell(profile, runs[0], arm, metric, k))
   141	                except (ValueError, KeyError, TypeError, IndexError) as exc:
   142	                    failure('{} {} k={}: {}'.format(arm['role'], metric, k, exc))
   143	    for pairing in profile.get('pairings', ()):
   144	        for metric in profile['metrics']['primary']:
   145	            try:
   146	                cell = comparison(profile, groups, pairing, metric)
   147	            except (ValueError, KeyError, TypeError, IndexError) as exc:
   148	                failure('{} {}: {}'.format(pairing, metric, exc))
   149	                continue
   150	            for name, gate in cell['convergence'].items():
   151	                if not gate['passed']:
   152	                    failure('convergence failed: {} {} {}'.format(pairing, metric, name))
   153	            if exploratory:
   154	                for key in ('superior', 'equivalent', 'reaches_target'):
   155	                    cell.pop(key, None)
   156	            result['cells'].append(cell)
   157	    if exploratory or profile['mode'] == 'yaw':
   158	        return result
   159	    if profile['mode'] == 'curve':
   160	        result['verdicts'] = {}
   161	        for metric in profile['metrics']['primary']:
   162	            supported = sum(c['superior'] for c in result['cells'] if c['metric'] == metric)
   163	            result['verdicts'][metric] = ('dominance supported on {} at the {} tested tiers'.format(metric, len(profile['pairings']))
   164	                if supported == len(profile['pairings']) else 'partial' if supported else 'not supported')
   165	    else:
   166	        result['parameter_ratios'] = []
   167	        arms = {a['role']: a for a in profile['arms']}
   168	        for pairing in profile['pairings']:
   169	            cells = [c for c in result['cells'] if c['pairing'] == list(pairing)]
   170	            if len(cells) == 2 and all(c['reaches_target'] for c in cells):
   171	                a, b = [arms[role]['counts']['encoder'] for role in pairing]
   172	                result['parameter_ratios'].append(dict(pairing=list(pairing), numerator=a, denominator=b,
   173	                    ratio=a/b, reduction_factor=b/a, scope='each metric cell paired cohort',
   174	                    cohorts={c['metric']: c['paired_cohort'] for c in cells}))
   175	    return result
