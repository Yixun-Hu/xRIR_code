   209	def write_completion(path, fields):
   210	    """Publish the complete record with an atomic rename on the same filesystem."""
   211	    payload = json.dumps(fields, sort_keys=True, indent=2, allow_nan=False).encode() + b'\n'
   212	    fd, temporary = tempfile.mkstemp(prefix='.' + Path(path).name, dir=Path(path).parent)
   213	    try:
   214	        with os.fdopen(fd, 'wb') as stream:
   215	            apply_umask(stream.fileno())
   216	            stream.write(payload)
   217	            stream.flush()
   218	            os.fsync(stream.fileno())
   219	        os.replace(temporary, path)
   220	    finally:
   221	        if os.path.exists(temporary):
   222	            os.unlink(temporary)
