    30	def projection(result):
    31	    """Recompute the projection from its raw measurements; all times are seconds."""
    32	    try:
    33	        micro = result['t_micro']
    34	        values = micro['values']
    35	        # Exact sum/50 survives JSON round trips; hand-transcribed summaries are refused.
    36	        valid = (len(values) == 50 and all(type(v) in (int, float) and math.isfinite(v) and v > 0
    37	            for v in [*values, *[micro[k] for k in ('mean', 'median', 'min')], result['t_test'], result['t_save']])
    38	            and (micro['mean'], micro['median'], micro['min']) == (sum(values) / 50, statistics.median(values), min(values))
    39	            and all(type(result[k]) is int and result[k] == v for k, v in dict(warmup_micro_batches=10,
    40	                timed_micro_batches=50, batch_size=32, accum_steps=2, train_batches_per_epoch=9261).items()))
    41	        epoch = 9261 * micro['mean'] + result['t_test'] + result['t_save']
    42	        if not valid or not math.isfinite(epoch * 12):
    43	            raise ValueError('invalid measurement')
    44	    except (KeyError, TypeError, ValueError, OverflowError) as error:
    45	        raise ValueError('invalid tier probe timing or recipe') from error
    46	    return dict(T_epoch=epoch, T_run=12 * epoch, passed=12 * epoch <= 60 * 3600)
    47	
    48	
    49	def run(tier, backbone, save_dir):
    50	    import train_xRIR_backbone as trainer
    51	    original_train, original_test, original_argv = trainer.train_epoch, trainer.test_epoch, sys.argv
    52	    result = dict(tier=tier, backbone=backbone, yaw_aug=0, batch_size=32, accum_steps=2)
    53	    state = {}
    54	    def measured_train(model, loader, optimizer, scheduler, epoch, args, best):
    55	        timed = TimedLoader(loader, trainer.torch.cuda, clock=time.perf_counter)
    56	        loss = original_train(model, timed, optimizer, scheduler, epoch, args, best)
    57	        if not math.isfinite(loss):
    58	            raise ValueError('non-finite probe training loss')
    59	        result.update(timed.result(), train_loss=loss, train_batches_per_epoch=len(loader))
    60	        result['t_micro'] = dict(mean=result['mean_iteration_seconds'], median=result['median_iteration_seconds'],
    61	                                min=result['min_iteration_seconds'], values=result['iteration_seconds'])
    62	        state.update(optimizer=optimizer, scheduler=scheduler)
    63	        return loss
    64	    def measured_test(model, loader, epoch, args):
    65	        trainer.torch.cuda.synchronize()
    66	        started = time.perf_counter()
    67	        loss = original_test(model, loader, epoch, args)
    68	        trainer.torch.cuda.synchronize()
    69	        result.update(t_test=time.perf_counter() - started, test_batches_timed=len(loader),
    70	                      test_batches_total=len(loader), test_timing_protocol='full_test_loader')
    71	        if not math.isfinite(loss):
    72	            raise ValueError('non-finite probe test loss')
    73	        with tempfile.TemporaryDirectory(prefix='_timed_save_', dir=save_dir) as scratch:
    74	            save_args = copy.copy(args)
    75	            save_args.no_save = False
    76	            started = time.perf_counter()
    77	            for name in ('epoch_001.pth', 'best.pth'):
    78	                trainer.torch.save(model.state_dict(), Path(scratch) / name)
    79	            trainer.save_checkpoint(Path(scratch) / 'last.pth', model, state['optimizer'],
    80	                                    state['scheduler'], epoch, 0, loss, save_args)
    81	            for path in Path(scratch).iterdir():
    82	                with path.open('rb') as stream:
    83	                    os.fsync(stream.fileno())
    84	            trainer.torch.cuda.synchronize()
    85	            result['t_save'] = time.perf_counter() - started
    86	        return loss
    87	    sys.argv = trainer_command(tier, backbone, save_dir)
    88	    trainer.train_epoch, trainer.test_epoch = measured_train, measured_test
    89	    try:
    90	        trainer.main()
    91	    finally:
    92	        trainer.train_epoch, trainer.test_epoch, sys.argv = original_train, original_test, original_argv
    93	    result.update(projection(result))
    94	    print('EXP05_PROBE_RESULT ' + json.dumps(result, allow_nan=False), flush=True)
    95	    return result
