   178	def run_contract(directory, arm, profile, pins):
   179	    """Validate exp05 additions before waiving any exact exp04 compatibility message."""
   180	    directory = Path(directory).resolve()
   181	    inputs = {}
   182	    def read(path):
   183	        raw = path.read_bytes()
   184	        inputs[str(path.resolve())] = hashlib.sha256(raw).hexdigest()
   185	        return json.loads(raw)
   186	    fields, completion, sample, metrics = [read(directory / name) for name in
   187	        ('eval_manifest.json', 'completion.json', 'per_sample_yaw.json', 'metrics_yaw.json')]
   188	    def require(ok, message):
   189	        if not ok:
   190	            raise ValueError(message)
   191	    require(_equal(fields.get('decomposition_batches'), 0), 'decomposition_batches')
   192	    digest = fields['source_closures']['entrypoint']['sha256']
   193	    current = digest is not None and digest == pins['closures']['evaluator']
   194	    old = (arm['tier'] == 'M' and digest is not None and
   195	           digest == pins['closures'].get('evaluator_exp04'))
   196	    require(current or old, 'unapproved evaluator')
   197	    names = set(fields['mutable_inputs'])
   198	    require(names <= {'control_args', 'train_args', 'train_manifest', 'train_completion', 'probe_receipt'},
   199	            'unknown mutable binding')
   200	    for name, filename in (('train_manifest', 'train_manifest.json'), ('train_completion', 'completion.json'),
   201	                           ('train_args', 'args.json'), ('control_args', 'args.json')):
   202	        if name in names:
   203	            require(Path(fields['mutable_inputs'][name]['path']).name == filename,
   204	                    name + ' binding filename: expected ' + filename)
   205	    waivers = []
   206	    legacy_evaluator = old and not current
   207	    if legacy_evaluator:
   208	        require('train_args' not in names, 'legacy evaluator has unexpected train_args binding')
   209	    args_name = 'control_args' if legacy_evaluator else 'train_args'
   210	    require(args_name in names, 'missing ' + args_name + ' binding')

