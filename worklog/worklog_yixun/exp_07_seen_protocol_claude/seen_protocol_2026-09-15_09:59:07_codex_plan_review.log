   171	def _publish(path, payload, overwrite=False):
   172	    """Atomic complete-file publication; hard-link creation refuses an existing name."""
   173	    fd, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
   174	    try:
   175	        with os.fdopen(fd, 'wb') as stream:
   176	            apply_umask(stream.fileno())
   177	            stream.write(payload)
   178	            stream.flush()
   179	            os.fsync(stream.fileno())
   180	        if overwrite:
   181	            os.replace(temporary, path)
   182	        else:
   183	            os.link(temporary, path)
   184	    finally:
   185	        if os.path.exists(temporary):
   186	            os.unlink(temporary)
