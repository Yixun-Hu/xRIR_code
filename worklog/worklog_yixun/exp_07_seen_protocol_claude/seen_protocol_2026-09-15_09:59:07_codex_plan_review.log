   136	def rho_bootstrap(err_a, err_b, n_boot=20000, seed=0, clusters=None):
   137	    """rho=(mean(a)-mean(b))/mean(b) on common query/room resamples.
   138	
   139	    The imported public primitive validates inputs and supplies the estimate
   140	    using one validation draw. Actual draws use its shared sampler, avoiding
   141	    its interpolated quantiles and a second full bootstrap computation.
   142	    """
   143	    result = relative_degradation_bootstrap(err_b, err_a, n_boot=1, seed=seed,
   144	                                            clusters=clusters)
   145	    samples = _samples([(err_b, err_a)], n_boot, seed, clusters)[0]
   146	    result["rho"] = result.pop("r")
   147	    return _sample_metadata(result, samples, n_boot, seed)
   148	
