    57	def compute_energy_db(h):
    58	    h = np.array(h)
    59	    power = h ** 2
    60	    energy = np.cumsum(power[::-1])[::-1]
    61	    i_nz = np.max(np.where(energy > 0)[0])
    62	    energy = energy[:i_nz]
    63	    energy_db = 10 * np.log10(energy)
    64	    energy_db -= energy_db[0]
    65	    return  energy_db
