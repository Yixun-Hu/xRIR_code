    63	def json_value(value):
    64	    """Make a detached JSON value; modifying it never modifies the specification."""
    65	    if isinstance(value, MP):
    66	        return {key: json_value(item) for key, item in value.items()}
    67	    if isinstance(value, tuple):
    68	        return [json_value(item) for item in value]
