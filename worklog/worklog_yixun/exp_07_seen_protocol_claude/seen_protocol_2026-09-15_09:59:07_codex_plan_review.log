   199	def build_fields(args, command, repo, module=None):
   200	    """Bind protocol, reviewed code and full referenced data before spawning.
   201	
   202	    Round-4 admission: dirty_outside_worklog is admissible only when the closure
   203	    digests equal the profile's approved digests; per-file bindings cover evaluated
   204	    code. mutable_inputs identifiers are control_args, train_manifest,
   205	    train_completion and probe_receipt; all other identifiers are refused.
   206	    """
   207	    if module is None:
   208	        module = entrypoint(args)
   209	        if module is not evaluator:
   210	            return module.build_fields(args, command, repo)
   211	    commit = subprocess.check_output(['git', 'rev-parse', '--verify', args.reviewed_commit + '^{commit}'],
   212	                                     cwd=repo, text=True).strip()
   213	    reference = evaluator.yaw.load_checked_manifest(args.manifest, args.manifest_hash)
   214	    count = len(reference["entries"])
   215	    n_samples = min(count, args.max_samples) if args.max_samples else count
   216	    state = p.checked_git_state(repo, n_samples == count, args.allow_dirty)
   217	    if args.num_shot != reference["num_shot"]:
   218	        raise ValueError("num_shot differs from reference manifest")
   219	    evaluator.yaw._check_cols(args.yaw_cols, args.acoustic_cols, args.e_acoustic_cols)
   220	    if args.conditions == "P" and args.e_acoustic_cols:
   221	        raise ValueError("e_acoustic_cols must be empty for P")
   222	    closures = {}
   223	    for role, module_name in (("evaluator", "eval_yaw_rotation"), ("entrypoint", module.__name__),
   224	                         ("writer", "tools.exp04_eval_launch")):
   225	        records, digest = p.closure_record(p.source_closure(module_name, repo), commit, repo)
   226	        if not records or any(record["reviewed_blob_sha256"] is None or
   227	                record["reviewed_blob_sha256"] != record["working_tree_sha256"] or
   228	                record["commits_after_reviewed"] for record in records):
   229	            raise ValueError(role + " closure differs from reviewed_commit")
   230	        closures[role] = {"files": records, "sha256": digest}
   231	    fields = vars(module.parse_args(command[2:]))
   232	    fields.pop("eval_manifest")
   233	    fields.pop("out_dir")
   234	    fields["manifest_path"] = fields.pop("manifest")
   235	    fields.update(schema_version=1, repo=str(Path(repo).resolve()), reviewed_commit=commit,
   236	        checkpoint_sha256=p.sha256_file(args.checkpoint),
   237	        manifest_file_sha256=p.sha256_file(args.manifest), manifest_seed=reference["seed"],
   238	        num_shot=args.num_shot, batch_canonical=True, data_root=args.data_root,
   239	        data_identity=p.data_identity(args.manifest, args.data_root),
   240	        evaluator_closure=closures.pop("evaluator"), source_closures=closures,
   241	        environment=_capture_environment(repo, args.data_root, args.gpu), git_state=state,
   242	        allow_dirty_used=bool(args.allow_dirty and state['dirty_outside_worklog']),
   243	        confirmatory=args.max_samples == 0 and n_samples == count and not args.allow_dirty,
   244	        run_label=args.run_label, command=command, split="unseen", split_count=count,
   245	        n_samples=n_samples,
   246	        no_tta=True,
   247	        stft_gl={name: parameter.default for name, parameter in
   248	                 inspect.signature(griffin_lim).parameters.items() if name != "spec"})
   249	    fields['mutable_inputs'] = {}
   250	    for binding in args.bind_input:
   251	        name, separator, path = binding.partition('=')
   252	        if name not in MUTABLE_INPUTS or not separator or not path or name in fields['mutable_inputs']:
   253	            raise ValueError('invalid or duplicate --bind-input: ' + binding)
   254	        path = str(Path(path).resolve())
   255	        fields['mutable_inputs'][name] = {'path': path, 'sha256': p.sha256_file(path)}
   256	    fields["env"] = {key: child_environment(repo, args.data_root, args.gpu).get(key) for key in
   257	                     ("CUDA_VISIBLE_DEVICES", "XRIR_DATA_PATH", "PYTHONPATH", "PYTHONHASHSEED")}
   258	    return fields
