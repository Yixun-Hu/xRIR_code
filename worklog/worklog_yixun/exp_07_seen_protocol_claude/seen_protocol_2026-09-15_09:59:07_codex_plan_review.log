   148	def _preserve_manual(generated, previous):
   149	    if previous is None:
   150	        return generated
   151	    text = previous.decode('utf-8')
   152	    blocks = list(re.finditer(re.escape(BEGIN) + r'.*?' + re.escape(END), text, re.S))
   153	    if len(blocks) > 1 or text.count(BEGIN) != len(blocks) or text.count(END) != len(blocks):
   154	        raise ValueError('ambiguous generated block markers; keep exactly one generated block')
   155	    for block in blocks:
   156	        body, separator, claimed = block.group()[:-len(END)].rpartition(STAMP)
   157	        expected = hashlib.sha256(body.encode()).hexdigest() + ' -->\n'
   158	        if not separator or claimed != expected:
   159	            raise ValueError('generated block was edited by hand; move your notes below the end marker and rerun')
   160	        text = text[:block.start()] + text[block.end():]
   161	    text = text.strip()
   162	    if text.startswith('## Manual\n'):
   163	        text = text[len('## Manual\n'):].strip()
   164	    return generated + ('\n## Manual\n\n' + text + '\n' if text else '')
   165	
