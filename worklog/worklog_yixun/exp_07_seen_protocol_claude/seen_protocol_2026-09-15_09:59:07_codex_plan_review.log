   102	def compute_loss(model, batch, aug=None):
   103	    """Identical loss to train_xRIR_unseen.py: STFT log-mag L1 + Schroeder energy-decay L1."""
   104	    _, src_loc, depth_coord, tgt_wav, ref_irs, ref_locs = batch
   105	    if aug is not None:
   106	        yaw, epoch, batch_idx = aug
   107	        assert yaw.enabled, "aug requires enabled yaw augmentation"
   108	        if yaw.W != depth_coord.shape[-1]:
   109	            raise ValueError("--yaw-aug-width must equal the dataset depth panorama width")
   110	        depth_coord, src_loc, ref_locs = (t.cuda(non_blocking=True) for t in (depth_coord, src_loc, ref_locs))
   111	        ks = yaw.offsets_for(epoch, batch_idx, int(src_loc.shape[0]))
   112	        depth_coord, src_loc, ref_locs = apply_yaw_aug(
   113	            depth_coord, src_loc, ref_locs, ks.to(depth_coord.device), W=yaw.W)
   114	    out_spec, tgt_spec = model(
   115	        depth_coord.cuda(non_blocking=True), ref_irs.cuda(non_blocking=True),
   116	        src_loc.cuda(non_blocking=True), ref_locs.cuda(non_blocking=True),
   117	        tgt_wav.cuda(non_blocking=True))
   118	    gt = tgt_spec.permute(0, 2, 3, 1)
   119	    with contextlib.redirect_stdout(io.StringIO()):  # the decay loss prints tensor shapes on every call
   120	        decay_loss = compute_spect_energy_decay_losses(gts=gt, preds=torch.exp(out_spec) - 1e-8)
   121	    stft_loss = stft_l1_loss(pred_spect=out_spec, gt_spect=gt)
   122	    return stft_loss + decay_loss, stft_loss.detach(), decay_loss.detach()
   123	
