   352	        if key not in manifest:
   353	            continue
   354	        identity = manifest[key]
   355	        inventory = identity.get('inventory')
   356	        if inventory is None:
   357	            try:
   358	                sidecar = identity['inventory_file']
   359	                check(key + '.inventory_file', sidecar['path'], sidecar.get('sha256'))
   360	                inventory = json.loads(Path(sidecar['path']).read_text())['inventory']
   361	            except (OSError, KeyError, ValueError, TypeError):
