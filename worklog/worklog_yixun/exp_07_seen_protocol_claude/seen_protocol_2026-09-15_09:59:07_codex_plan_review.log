    37	def validate_manifest(args):
    38	    """Refuse changed inputs, protocol, or reviewed evaluator bytes before model loading."""
    39	    path = Path(args.eval_manifest)
    40	    digest = provenance.sha256_file(path)
    41	    fields = json.loads(path.read_text())
    42	    out = Path(args.out_dir)
    43	    if not out.is_dir() or path.resolve().parent != out.resolve():
    44	        raise ValueError("out_dir must exist and contain the eval_manifest")
    45	    if any(item.absolute() != path.absolute() for item in out.iterdir()):
    46	        raise ValueError("out_dir contains files other than eval_manifest")
    47	    reference = yaw.load_manifest(args.manifest)
    48	    expected = {key: value for key, value in vars(args).items()
    49	                if key not in ("eval_manifest", "out_dir", "manifest")}
    50	    expected.update(schema_version=1, manifest_path=args.manifest,
    51	                    checkpoint_sha256=provenance.sha256_file(args.checkpoint),
    52	                    manifest_file_sha256=provenance.sha256_file(args.manifest),
    53	                    manifest_hash=yaw.manifest_hash(reference), num_shot=reference["num_shot"],
    54	                    manifest_seed=reference["seed"], batch_canonical=True, data_root=BASE_DATA_PATH)
    55	    mismatches = [key for key, value in expected.items()
    56	                  if json.dumps(fields.get(key), sort_keys=True) != json.dumps(value, sort_keys=True)]
    57	    if args.manifest_hash != expected["manifest_hash"]:
    58	        mismatches.append("manifest_hash")
    59	    if args.conditions == "P" and args.e_acoustic_cols:
    60	        mismatches.append("e_acoustic_cols")
    61	    repo = str(Path(__file__).resolve().parents[1])
    62	    if fields.get("repo") != repo:
    63	        mismatches.append("repo")
    64	    try:
    65	        commit = fields.get("reviewed_commit")
    66	        if not isinstance(commit, str) or re.fullmatch(r"[0-9a-f]{40}", commit) is None:
    67	            raise ValueError("reviewed_commit must be 40 lowercase hex characters")
    68	        files, closure_digest = provenance.closure_record(
    69	            provenance.source_closure("eval_yaw_rotation", repo), fields["reviewed_commit"], repo)
    70	        declared = fields["evaluator_closure"]
    71	        identity_keys = ("path", "reviewed_blob_sha256", "working_tree_sha256", "commits_after_reviewed")
    72	        if (declared["sha256"] != closure_digest or
    73	                [[r[key] for key in identity_keys] for r in declared["files"]] !=
    74	                [[r[key] for key in identity_keys] for r in files] or
    75	                any(r["working_tree_sha256"] != r["reviewed_blob_sha256"] or
    76	                    r["commits_after_reviewed"] for r in files)):
    77	            mismatches.append("evaluator_closure")
    78	    except (KeyError, OSError, ValueError, subprocess.CalledProcessError) as error:
    79	        raise ValueError("reviewed_commit/evaluator_closure: {}".format(error)) from error
    80	    if mismatches:
    81	        raise ValueError("evaluation manifest mismatch: " + ", ".join(sorted(set(mismatches))))
    82	    yaw._check_cols(args.yaw_cols, args.acoustic_cols, args.e_acoustic_cols)
    83	    return fields, digest, reference
