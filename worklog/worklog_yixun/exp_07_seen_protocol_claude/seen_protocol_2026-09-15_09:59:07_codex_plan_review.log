   106	        descriptive=True, verdict_scope=profile['verdict_scope'],
   107	        pairing=['{} k={}'.format(arm['role'], k), arm['role'] + ' k=0'], paired_cohort=retained,
   108	        paired_means={'0': float(base[mask].mean()), str(k): float(angle[mask].mean())},
   109	        companion_interval=list(two_sided_interval(query['samples'], profile['curve_alpha'])),
   110	        room_cluster_interval=list(two_sided_interval(room['samples'], profile['curve_alpha'])))
