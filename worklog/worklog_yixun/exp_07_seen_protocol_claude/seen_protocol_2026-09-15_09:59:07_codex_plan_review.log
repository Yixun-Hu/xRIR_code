   114	def run_exp04(args, model_factory=None, metadata=None, manifest_validator=None):
   115	    """Mirror the frozen run, binding its outputs to preflight-validated inputs."""
   116	    fields, digest, manifest = (manifest_validator or validate_manifest)(args)
   117	    if not yaw.torch.cuda.is_available():
   118	        raise RuntimeError("exp04_eval needs a GPU: xRIR.apply_delay is .cuda()-only")
   119	    started = time.time()
   120	    yaw.torch.set_num_threads(args.threads)
   121	    yaw.set_precision(args.tf32)
   122	    manifest = yaw.load_checked_manifest(args.manifest, args.manifest_hash)
   123	    cols, acoustic, e_acoustic = yaw._check_cols(args.yaw_cols, args.acoustic_cols, args.e_acoustic_cols)
   124	    dataset = yaw.build_manifest_dataset(manifest, max_samples=args.max_samples)
   125	    loader = yaw.DataLoader(dataset, batch_size=args.batch_size, shuffle=False,
   126	                            num_workers=args.num_workers, pin_memory=True)
   127	    model = (model_factory or yaw.build_xrir)(args.backbone, manifest["num_shot"])
   128	    model.load_state_dict(yaw.load_model_state(args.checkpoint), strict=True)
   129	    model.cuda().eval()
   130	    evaluator = yaw.Evaluator()
   131	    n_samples = len(dataset)
   132	    print("backbone: {}  checkpoint: {}  samples: {}  angles: {}  batch: {}".format(
   133	        args.backbone, args.checkpoint, n_samples, cols, args.batch_size), flush=True)
   134	    queries, parts, flips, decompositions = [], {}, {}, []
   135	    evaluate = yaw.evaluate_batch if args.conditions == "PE" else evaluate_p_batch
   136	    for i, batch in enumerate(loader):
   137	        keys, results, batch_flips = evaluate(model, batch, evaluator, cols, acoustic,
   138	                                              e_acoustic, args.gl_seed, batch_size=args.batch_size)
   139	        queries.extend(keys)
   140	        for cell, metrics in results.items():
   141	            for metric, values in metrics.items():
   142	                parts.setdefault(cell, {}).setdefault(metric, []).append(values)
   143	        for k, count in batch_flips.items():
   144	            flips[k] = flips.get(k, 0) + count
   145	        if args.backbone == "cylindrical" and i < args.decomposition_batches:
   146	            # The unchanged diagnostic internally computes P and E forwards.
   147	            decompositions.append(yaw._decomposition_for_batch(model, batch))
   148	        if (i + 1) % args.log_interval == 0 or len(queries) == n_samples:
   149	            rate = len(queries) / (time.time() - started)
   150	            print("[{}/{}] {:.2f} samples/s, eta {:.1f} min".format(
   151	                len(queries), n_samples, rate, (n_samples - len(queries)) / rate / 60), flush=True)
   152	    entries = dataset.entries
   153	    if queries != [entry["query"] for entry in entries]:
   154	        raise ValueError("the loader did not return the manifest's canonical order")
   155	    merged = {cell: {metric: yaw.np.concatenate(chunks) for metric, chunks in metrics.items()}
   156	              for cell, metrics in parts.items()}
   157	    decomposition = None
   158	    if decompositions:
   159	        names = ("tokens_rel_change", "pooled_rel_change", "coord_rel_change", "logspec_rel_change")
   160	        decomposition = {"k": decompositions[0]["k"], "n_batches": len(decompositions)}
   161	        decomposition.update({name: float(yaw.np.mean([d[name] for d in decompositions])) for name in names})
   162	    meta = {key: getattr(args, key) for key in ("backbone", "checkpoint", "manifest_hash",
   163	            "gl_seed", "batch_size", "max_samples", "tf32")}
   164	    meta.update(manifest_path=args.manifest, manifest_seed=manifest["seed"], yaw_cols=cols,
   165	                acoustic_cols=acoustic, e_acoustic_cols=e_acoustic, batch_canonical=True,
   166	                n_samples=n_samples, torch_version=yaw.torch.__version__,
   167	                elapsed_min=(time.time() - started) / 60, eval_manifest_sha256=digest,
   168	                conditions=args.conditions, evaluator_closure_sha256=fields["evaluator_closure"]["sha256"],
   169	                reviewed_commit=fields["reviewed_commit"])
   170	    meta.update(metadata or {})
   171	    per_sample = {"meta": meta, "query": queries, "index": [entry["index"] for entry in entries],
   172	                  "delay_flips": {str(k): int(v) for k, v in sorted(flips.items())},
   173	                  "decomposition": decomposition}
   174	    metrics_out = {"meta": meta, "delay_flips": per_sample["delay_flips"], "decomposition": decomposition}
   175	    for condition in args.conditions:
   176	        per_sample[condition] = {str(k): {name: yaw._json_values(values) for name, values in
   177	                                merged[(condition, k)].items()} for k in cols}
   178	        metrics_out[condition] = {str(k): {name: yaw._summarize(values) for name, values in
   179	                                 merged[(condition, k)].items()} for k in cols}
   180	    Path(args.out_dir).mkdir(parents=True, exist_ok=True)
   181	    for name, payload in (("per_sample_yaw.json", per_sample), ("metrics_yaw.json", metrics_out)):
   182	        path = str(Path(args.out_dir) / name)
   183	        yaw._write_json(payload, path)
