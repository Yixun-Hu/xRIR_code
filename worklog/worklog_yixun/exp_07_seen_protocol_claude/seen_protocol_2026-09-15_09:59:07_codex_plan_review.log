   139	def train_epoch(model, loader, optimizer, scheduler, epoch, args, best_test_loss):
   140	    if type(epoch) is not int:
   141	        raise ValueError("epoch must be a native int")
   142	    model.train()
   143	    aug = YawAug(True, args.yaw_aug_width, args.yaw_aug_seed, args.train_batches_per_epoch) if args.yaw_aug else None
   144	    optimizer.zero_grad(set_to_none=True)
   145	    n_batches = len(loader) if not args.max_train_batches else min(len(loader), args.max_train_batches)
   146	    tot = tot_stft = tot_decay = 0.0
   147	    count = 0
   148	    t_start = time.time()
   149	    t_last = t_start
   150	    for batch_idx, batch in enumerate(loader):
   151	        if type(batch_idx) is not int:
   152	            raise ValueError("batch_idx must be a native int")
   153	        if args.max_train_batches and batch_idx >= args.max_train_batches:
   154	            break
   155	        loss, stft_l, decay_l = compute_loss(
   156	            model, batch, (aug, epoch, batch_idx) if aug is not None else None)
   157	        (loss / args.accum_steps).backward()
   158	        if (batch_idx + 1) % args.accum_steps == 0 or batch_idx + 1 == n_batches:
   159	            optimizer.step()
   160	            optimizer.zero_grad(set_to_none=True)
   161	        tot += loss.item()
   162	        tot_stft += stft_l.item()
   163	        tot_decay += decay_l.item()
   164	        count += 1
   165	        if batch_idx % args.log_interval == 0:
   166	            now = time.time()
   167	            rate = args.log_interval * batch[1].shape[0] / max(now - t_last, 1e-6) if batch_idx else float("nan")
   168	            eta_min = (n_batches - batch_idx - 1) * (now - t_start) / max(batch_idx + 1, 1) / 60.0
   169	            print(f"Train Epoch: {epoch} [{batch_idx}/{n_batches}]  loss {loss.item():.4f} "
   170	                  f"(stft {stft_l.item():.4f}, decay {decay_l.item():.4f})  "
   171	                  f"{rate:.1f} samp/s  eta {eta_min:.1f} min  lr {optimizer.param_groups[0]['lr']:.2e}",
   172	                  flush=True)
   173	            t_last = now
   174	        if args.save_every and batch_idx and batch_idx % args.save_every == 0:
   175	            save_checkpoint(os.path.join(args.save_dir, "last.pth"), model, optimizer, scheduler,
   176	                            epoch, batch_idx, best_test_loss, args)
   177	    scheduler.step()
   178	    avg = tot / max(count, 1)
   179	    print(f"Train Epoch: {epoch}, Avg Train Loss: {avg:.5f} (stft {tot_stft / max(count, 1):.5f}, "
   180	          f"decay {tot_decay / max(count, 1):.5f}), {(time.time() - t_start) / 60:.1f} min", flush=True)
   181	    return avg
   182	
   183	
   184	@torch.no_grad()
   185	def test_epoch(model, loader, epoch, args):
   186	    model.eval()
   187	    tot = 0.0
   188	    count = 0
   189	    for batch_idx, batch in enumerate(loader):
   190	        if args.max_test_batches and batch_idx >= args.max_test_batches:
   191	            break
   192	        loss, _, _ = compute_loss(model, batch)
   193	        tot += loss.item()
   194	        count += 1
   195	    avg = tot / max(count, 1)
   196	    print(f"Test set (epoch {epoch}): Average loss: {avg:.5f} over {count} batches", flush=True)
   197	    return avg
