    23	@contextmanager
    24	def termination_handlers():
    25	    terminating = False
    26	    def terminate(signum, frame):
    27	        nonlocal terminating
    28	        if not terminating:
    29	            terminating = True
    30	            raise LauncherTerminated(signum)
    31	    previous = {s: signal.getsignal(s) for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)}
    32	    mask = signal.pthread_sigmask(signal.SIG_BLOCK, [])
    33	    try:
    34	        for signum in previous:
    35	            if previous[signum] != signal.SIG_IGN:
    36	                signal.signal(signum, terminate)
    37	        yield
    38	    finally:
    39	        try:
    40	            signal.pthread_sigmask(signal.SIG_SETMASK, mask)
    41	        finally:
    42	            for signum, handler in previous.items():
    43	                signal.signal(signum, handler)
