    51	def two_sided_interval(samples, alpha):
    52	    """Exact [Q_(alpha/2), Q_(1-alpha/2)] order-statistic interval."""
    53	    if not np.isfinite(alpha) or not 0 < alpha < 1:
    54	        raise ValueError("alpha must be in (0, 1)")
    55	    tail = Decimal(str(alpha)) / 2
    56	    return (_quantile(samples, tail), _quantile(samples, tail, upper=True))
