    17	def trainer_command(tier, backbone, save_dir):
    18	    if tier not in ('S', 'L') or backbone not in ('simple', 'cylindrical'):
    19	        raise ValueError('tier probe requires S/L and simple/cylindrical')
    20	    cmd = base_command(0, save_dir)
    21	    for flag in ('--yaw-aug', '--yaw-aug-seed', '--yaw-aug-width'):
    22	        index = cmd.index(flag)
    23	        del cmd[index:index + 2]
    24	    cmd[cmd.index('--backbone') + 1] = backbone
    25	    for key, value in TIERS[tier].items():
    26	        cmd.extend(['--vit-' + key.replace('_', '-'), str(value)])
    27	    return cmd + ['--max-test-batches', '0']
