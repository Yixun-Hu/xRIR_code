    77	def compute_energy_db(h):
    78	    h = np.array(h)
    79	    power = h ** 2
    80	    energy = np.cumsum(power[::-1])[::-1]
    81	    i_nz = np.max(np.where(energy > 0)[0])
    82	    energy = energy[:i_nz]
    83	    energy_db = 10 * np.log10(energy)
    84	    energy_db -= energy_db[0]
    85	    return  energy_db
