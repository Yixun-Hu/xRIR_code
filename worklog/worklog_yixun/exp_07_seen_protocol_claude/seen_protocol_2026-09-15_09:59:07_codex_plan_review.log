   148	def git_state(repo):
   149	    """Record untracked names separately; diff_sha256 hashes tracked changes only."""
   150	    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=repo, text=True).strip()
   151	    status = subprocess.check_output(['git', 'status', '--porcelain', '-z', '--untracked-files=all'], cwd=repo, text=True)
   152	    paths, untracked, entries = [], [], iter(status.split('\0'))
   153	    for entry in entries:
   154	        if entry:
   155	            paths.append(entry[3:])
   156	            if entry.startswith('?? '):
   157	                untracked.append(entry[3:])
   158	            if 'R' in entry[:2] or 'C' in entry[:2]:
   159	                paths.append(next(entries))  # Include the source path of a rename/copy.
   160	    dirty = bool(status)
   161	    diff = subprocess.check_output(['git', 'diff', 'HEAD'], cwd=repo) if dirty else None
   162	    return {'HEAD': head, 'dirty': dirty, 'untracked': sorted(untracked),
   163	            'dirty_outside_worklog': any(not path.startswith('worklog/') for path in paths),
   164	            'diff_sha256': hashlib.sha256(diff).hexdigest() if dirty else None}
