   135	    def get_receiver_source_location(self, ir_file_path):
   136	        scene_name = ir_file_path.split("/")[-3]
   137	        scene_id = ir_file_path.split("/")[-2]
   138	        ir_file_name = ir_file_path.split("/")[-1]
