   125	def save_checkpoint(path, model, optimizer, scheduler, epoch, batch_idx, best_test_loss, args):
   126	    if args.no_save:
   127	        return
   128	    torch.save({
   129	        "model": model.state_dict(),
   130	        "optimizer": optimizer.state_dict(),
   131	        "scheduler": scheduler.state_dict(),
   132	        "epoch": epoch,
   133	        "batch_idx": batch_idx,
   134	        "best_test_loss": best_test_loss,
   135	        "args": vars(args),
   136	    }, path)
