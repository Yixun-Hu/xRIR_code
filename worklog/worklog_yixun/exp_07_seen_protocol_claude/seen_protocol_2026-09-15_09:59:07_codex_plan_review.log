    23	def child_environment(repo, data_root, gpu='1'):
    24	    env = dict(os.environ, XRIR_DATA_PATH=str(data_root), CUDA_VISIBLE_DEVICES=str(gpu))
    25	    env["PYTHONPATH"] = os.pathsep.join(dict.fromkeys(
    26	        [str(repo)] + [p for p in env.get('PYTHONPATH', '').split(os.pathsep) if p]))
    27	    return env
