    96	def yaw_cell(profile, run, arm, metric, k):
    97	    """Descriptive seed-42 yaw change, paired with k=0 within one arm."""
    98	    base, angle = (matrix([run], metric, x)[0] for x in (0, k))
    99	    mask = np.isfinite(base) & np.isfinite(angle)
   100	    retained = cohort(run['query'], mask)
   101	    def compute(clusters=None):
   102	        return rho_bootstrap(angle[mask], base[mask], profile['n_boot'], profile['bootstrap_seeds'][0], clusters)
   103	    query = compute()
   104	    room = compute(rooms_from_paths(run['query'])[mask])
