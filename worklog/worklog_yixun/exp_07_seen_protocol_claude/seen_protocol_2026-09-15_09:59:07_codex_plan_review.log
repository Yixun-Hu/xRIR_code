    64	def source_closure(repo):
    65	    """Repo-local files imported by the evaluator, found by importing it in a subprocess (sorted, repo-relative)."""
    66	    code = (
    67	        "import sys, os, importlib; repo = os.getcwd(); sys.path.insert(0, repo); importlib.import_module('%s');"
    68	        "files = sorted({os.path.relpath(os.path.abspath(m.__file__), repo) for m in list(sys.modules.values())"
    69	        " if getattr(m, '__file__', None) and os.path.abspath(m.__file__).startswith(repo + os.sep)"
    70	        " and 'site-packages' not in m.__file__ and os.sep + 'envs' + os.sep not in m.__file__});"
    71	        "print('\\n'.join(files))" % EVALUATOR[:-3])
    72	    out = subprocess.check_output([PYTHON, "-c", code], cwd=repo, env={**os.environ, "PYTHONPATH": repo}).decode().split()
    73	    return [f for f in sorted(set(out) | {EVALUATOR}) if not f.startswith("tests" + os.sep)]
