   143	def _bootstrap_ratios(pairs, n_boot, seed, clusters=None):
   144	    """Bootstrap ``r`` for several paired series over the *same* resamples.
   145	
   146	    Sharing the draws is what makes a difference-in-differences of two models paired:
   147	    both models are recomputed on the identical resampled set of queries.
   148	
   149	    Args:
   150	        pairs: list of ``(e0, ek)`` float64 arrays, all of the same length.
   151	        n_boot: number of resamples.
   152	        seed: ``np.random.default_rng`` seed.
   153	        clusters: ``None`` to resample pairs, or one cluster id per pair to resample
   154	            whole clusters with replacement (multiplicity weights).
   155	
   156	    Returns:
   157	        A list of ``[n_boot]`` arrays of ratios, one per input pair.
   158	
   159	    Raises:
   160	        ValueError: if any resample leaves ``r`` undefined (a resampled ``mean(e0)`` of
   161	            zero).  Dropping such draws would silently shift the percentiles.
   162	    """
   163	    n = pairs[0][0].size
   164	    rng = np.random.default_rng(seed)
   165	    out = [np.empty(n_boot, dtype=np.float64) for _ in pairs]
   166	
   167	    with np.errstate(divide="ignore", invalid="ignore"):
   168	        if clusters is None:
   169	            chunk = max(1, min(n_boot, _CHUNK_CELLS // max(n, 1)))
   170	            done = 0
    60	    mask, exclusions = cell_mask(a, e0_b=b, seeds=profile['eval_seeds'])
    61	    roles_by_key = dict(zip(('a', 'b'), pairing))
    62	    exclusions = {roles_by_key.get(key, key): value for key, value in exclusions.items()}
    63	    queries = groups[ia][0]['query']
    64	    means = [five_seed_mean(v)[mask] for v in (a, b)]
    65	    seeds = profile['bootstrap_seeds']
    66	    draws = {s: rho_bootstrap(*means, n_boot=profile['n_boot'], seed=s) for s in seeds}
    67	    alpha = profile['interval_alpha']
    68	    local = bonferroni_alpha(profile['family'], profile['alpha'])
    69	    def interval(seed, level):
    70	        return two_sided_interval(draws[seed]['samples'], level)
    71	    def gate(level):
    72	        return convergence(lambda s: interval(s, level), *seeds, tol=profile['convergence_tolerance'])
    73	    room = rho_bootstrap(*means, n_boot=profile['n_boot'], seed=seeds[0],
    74	                         clusters=rooms_from_paths(queries)[mask])
    75	    own_mask = np.isfinite(b).all(axis=0)
    76	    cell = dict(pairing=list(pairing), metric=metric, k=0, estimate=draws[seeds[0]]['rho'],
    77	        companion_interval=list(interval(seeds[0], alpha)),
    78	        room_cluster_interval=list(two_sided_interval(room['samples'], alpha)),
    79	        paired_cohort=cohort(queries, mask), exclusions=exclusions,
    80	        baseline_own=dict(**seed_summary(b, own_mask), cohort=cohort(queries, own_mask)),
    81	        paired_means={role: seed_summary(v, mask) for role, v in zip(pairing, (a, b))},
    82	        convergence={'superiority': gate(alpha)},
    83	        superior=bool(one_sided_upper(draws[seeds[0]]['samples'], local/2) < 0))
    84	    if profile['mode'] == 'targets':
    85	        # Import TOST's validation/definition, then replace its interpolated endpoints.
    86	        tost = equivalence_tost(means[1], means[0], profile['margin'], n_boot=1,
    87	                                alpha=profile['tost_alpha'], seed=seeds[0])
    88	        lo, hi = interval(seeds[0], 2*profile['tost_alpha'])
    89	        cell.update(target=float(means[1].mean()), tost_interval=[lo, hi],
    90	                    equivalent=bool(-tost['margin'] < lo and hi < tost['margin']))
    91	        cell['convergence']['tost'] = gate(2*profile['tost_alpha'])
    92	        cell['reaches_target'] = cell['superior'] or cell['equivalent']
    93	    return cell
