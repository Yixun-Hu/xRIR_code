   610	def write_outputs(result, admitted, json_path, summary_path, renderer=None):
   611	    """Exclusive creation; the last sidecar binds inputs and both completed outputs."""
   612	    paths = [Path(json_path), Path(summary_path), Path(str(json_path) + '.provenance.json')]
   613	    if len({p.resolve() for p in paths}) != 3 or any(os.path.lexists(p) for p in paths):
   614	        raise FileExistsError('output paths must be distinct and absent')
   615	    text = (renderer or render_summary)(result).encode()
   616	    data = (json.dumps(_safe_json(result), sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
   617	    sidecar = {'schema_version': 1, 'exploratory': result['exploratory'], 'inputs': admitted['inputs'],
   618	               'profile_digest': result['profile_digest'], 'producer': admitted['producer'],
   619	               'approved_digests': admitted['approved_digests'], 'run_flags': admitted['run_flags'],
   620	               'outputs': {str(paths[0].resolve()): hashlib.sha256(data).hexdigest(),
   621	                           str(paths[1].resolve()): hashlib.sha256(text).hexdigest()}}
   622	    receipt = (json.dumps(sidecar, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
   623	    recheck_inputs(admitted)
   624	    created = []
   625	    try:
   626	        for path, payload in zip(paths, (data, text, receipt)):
   627	            fd, temporary = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
   628	            try:
   629	                with os.fdopen(fd, 'wb') as stream:
   630	                    provenance.apply_umask(stream.fileno())
   631	                    stream.write(payload)
   632	                    stream.flush()
   633	                    os.fsync(stream.fileno())
   634	                os.link(temporary, path)  # Atomic publication, preserving exclusive creation.
   635	                created.append(path)
   636	            finally:
   637	                os.unlink(temporary)
   638	    except BaseException:
   639	        for path in created:
   640	            path.unlink()
   641	        raise
