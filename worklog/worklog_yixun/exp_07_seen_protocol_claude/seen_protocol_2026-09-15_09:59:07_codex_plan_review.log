   162	def tost_cell(e0, ek, margin, alpha_local, n_boot=20000, seed=0, clusters=None):
   163	    """One-arm TOST using exact [Q_alpha_local, Q_(1-alpha_local)]."""
   164	    result = equivalence_tost(e0, ek, margin, n_boot=1, alpha=alpha_local,
   165	                              seed=seed, clusters=clusters)
   166	    samples = _samples([(e0, ek)], n_boot, seed, clusters)[0]
   167	    lo, hi = _quantile(samples, alpha_local), _quantile(samples, alpha_local, upper=True)
   168	    result.update(lo=lo, hi=hi, n_boot=int(n_boot), samples=samples, seed=seed,
   169	                  equivalent=bool(-margin < lo and hi < margin))
   170	    return result
