   108	def spectral_metrics(out_k, out_0, tgt_spec):
   109	    """The five per-sample spectral metrics of one batch at one angle.
   110	
   111	    Args:
   112	        out_k: predicted log-magnitude spectrograms at the angle, ``[B, F, T, 1]``.
   113	        out_0: the same batch's ``k = 0`` prediction, ``[B, F, T, 1]`` -- the paired
   114	            reference for ``consistency``.
   115	        tgt_spec: target magnitude spectrograms ``[B, 1, F, T]``.
   116	
   117	    Returns:
   118	        ``{"loss", "stft", "decay", "log_mse", "consistency"}``, each a detached CPU
   119	        float32 tensor of shape ``[B]``:
   120	
   121	        * ``loss``/``stft``/``decay`` -- ``tools.per_sample_metrics.per_sample_losses``,
   122	          i.e. exp_01's test loss and its two halves, computed on 1-sample slices;
   123	        * ``log_mse`` -- the per-sample form of exp_01's
   124	          ``Evaluator.stft_loss(out_spec.squeeze(-1), log(tgt_spec + 1e-8).squeeze(1))``;
   125	        * ``consistency`` -- ``mean |out_k - out_0|`` over the log-spectrogram, exactly
   126	          ``0`` at ``k = 0``.
   127	    """
   128	    loss, stft, decay = per_sample_losses(out_k, tgt_spec)
   129	    with torch.no_grad():
   130	        log_tgt = torch.log(tgt_spec[:, 0] + 1e-8)
   131	        log_mse = ((out_k[..., 0] - log_tgt) ** 2).flatten(1).mean(dim=1)
   132	        consistency = (out_k - out_0).abs().flatten(1).mean(dim=1)
   133	    return {"loss": loss, "stft": stft, "decay": decay,
   134	            "log_mse": log_mse.detach().cpu().float(),
   135	            "consistency": consistency.detach().cpu().float()}
