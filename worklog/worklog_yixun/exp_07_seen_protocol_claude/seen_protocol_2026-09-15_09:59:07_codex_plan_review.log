    45	    p.add_argument("--lr", type=float, default=1e-3)
    46	    p.add_argument("--weight-decay", type=float, default=1e-4)
    47	    p.add_argument("--decay-epochs", type=int, default=50)
    48	    p.add_argument("--lr-gamma", type=float, default=0.1)
    49	    p.add_argument("--epochs", type=int, default=200)
    50	    p.add_argument("--batch-size", type=int, default=64)
    51	    p.add_argument("--accum-steps", type=int, default=1,
    52	                   help="gradient accumulation; effective batch = batch-size * accum-steps")
    53	    # Runtime.
    54	    p.add_argument("--num-workers", type=int, default=16)
    55	    p.add_argument("--seed", type=int, default=0)
    56	    p.add_argument("--yaw-aug", type=int, choices=(0, 1), default=0)
    57	    p.add_argument("--yaw-aug-seed", type=int, default=None)
    58	    p.add_argument("--yaw-aug-width", type=int, default=512)
    59	    p.add_argument("--no-save", action="store_true", help="write nothing to save-dir (smoke runs)")
    60	    p.add_argument("--tf32", action="store_true", help="allow TF32 matmul/cudnn (faster, slightly different numerics)")
    61	    p.add_argument("--log-interval", type=int, default=20)
    62	    p.add_argument("--save-every", type=int, default=500, help="save last.pth every N train batches (0 = only per epoch)")
    63	    p.add_argument("--epoch-ckpt-every", type=int, default=5,
    64	                   help="also keep a standalone epoch_NNN.pth every N epochs (0 = never); best.pth/last.pth are always written")
    65	    p.add_argument("--resume", default=None, help="path to a last.pth to resume from")
