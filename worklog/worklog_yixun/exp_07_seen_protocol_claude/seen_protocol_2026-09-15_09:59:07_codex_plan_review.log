   282	    if not TRAIN_MINIMUM <= set(files):
   283	        raise ValueError('training closure missing required files')
   284	    closures = {}
   285	    for role, paths in [('training', files), ('launcher',
   286	            p.source_closure('tools.exp04_launcher', REPO) + ['tools/exp04_probe.py', 'tools/exp04_launch.sh'])]:
   287	        records, digest = p.closure_record(paths, reviewed_commit, REPO)
   288	        if not records or any(r['reviewed_blob_sha256'] is None or
   289	                r['reviewed_blob_sha256'] != r['working_tree_sha256'] or
   290	                r['commits_after_reviewed'] for r in records):
   291	            raise ValueError(role + ' closure differs from reviewed commit')
   292	        closures[role] = {'files': records, 'sha256': digest}
   293	    print('Hashing training data identity...', flush=True)
   294	    data = p.train_data_identity(DATA_ROOT, cache_path=REPO / 'ckpt/yaw_aug/train_inventory.json')
   295	    provisional = effective_args(argv, gpu, 1)
   296	    bpe = math.ceil(data['inventory_files'] / provisional['batch_size'])
   297	    effective = effective_args(argv, gpu, bpe)
   298	    check_runtime(effective, effective, mode)
   299	    fields = dict(repo=str(REPO), reviewed_commit=reviewed_commit, mode=mode,
   300	        source_closures=closures, train_data_identity=data, effective_args=effective,
   301	        command=argv, environment=p.environment(), git_state=state, allow_dirty=allow_dirty,
   302	        env={key: child_environment(gpu)[key] for key in ENV_KEYS})
   303	    if mode == 'full':
   304	        label = 'cyl' if effective['backbone'] == 'cylindrical' else 'simple'
   305	        control_path = REPO / ('ckpt/xRIR_' + label + '_8_shot/args.json')
   306	        control_env = dict(XRIR_DATA_PATH=DATA_ROOT, OMP_NUM_THREADS='2', CUDA_VISIBLE_DEVICES='1')
   307	        fields['control_excluded_differences'] = compare_control(effective, json.loads(control_path.read_text()), control_env)
   308	        fields['control_env_reconstructed'] = control_env
   309	        fields['mutable_inputs'] = {'control_args': {'path': str(control_path), 'sha256': p.sha256_file(control_path)}}
   310	    return fields
