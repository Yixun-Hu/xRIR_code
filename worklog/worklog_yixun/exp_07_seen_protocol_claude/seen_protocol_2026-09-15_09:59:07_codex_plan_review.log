    52	def sha(path):
    53	    h = hashlib.sha256()
    54	    with open(path, "rb") as f:
    55	        for chunk in iter(lambda: f.read(1 << 20), b""):
    56	            h.update(chunk)
    57	    return h.hexdigest()
