    61	def candidate_references(ir_path, listdir_cache=None):
    62	    """The candidate reference paths ``xRIR_Dataset`` would consider for one query.
    63	
    64	    Reproduces ``xRIR_Dataset.get_ir_and_location_for_other_sources``: every *other*
    65	    source node that appears in the query's room directory, kept when the file
    66	    ``S00<node>_<receiver token>_hybrid_IR.wav`` (the query's own receiver) exists on
    67	    disk.  The naming logic is re-implemented rather than borrowed so building a
    68	    manifest needs no dataset instance and reads no audio.
    69	
    70	    Args:
    71	        ir_path: path of the query RIR (``.../<Category>/<Room>/S00i_R00j_hybrid_IR.wav``).
    72	        listdir_cache: optional ``dict`` reused across calls to keep one ``os.listdir``
    73	            per room directory (``build_manifest`` passes one); it is filled in place.
    74	
    75	    Returns:
    76	        Sorted list of absolute candidate paths (possibly empty).
    77	    """
    78	    dir_name = os.path.abspath(os.path.dirname(ir_path))
    79	    ir_file_name = os.path.basename(ir_path)
    80	    src_node = int(ir_file_name.split("_")[0][1:])
    81	    rec_token = ir_file_name.split("_")[1]
    82	
    83	    if listdir_cache is None:
    84	        listing = os.listdir(dir_name)
    85	    else:
    86	        if dir_name not in listdir_cache:
    87	            listdir_cache[dir_name] = os.listdir(dir_name)
    88	        listing = listdir_cache[dir_name]
    89	
    90	    all_src_node = set(int(fn.split("_")[0][1:]) for fn in listing)
    91	    paths = []
    92	    for node in all_src_node.difference({src_node}):
    93	        candidate = os.path.join(dir_name, "S00{}_{}_hybrid_IR.wav".format(node, rec_token))
    94	        if os.path.exists(candidate):
    95	            paths.append(candidate)
    96	    return sorted(paths)
