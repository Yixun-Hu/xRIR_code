   240	def producer_identity(entry_module='tools.paired_compare'):
   241	    """Bind imported producer dependencies to committed HEAD and current bytes."""
   242	    commit = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=REPO, text=True).strip()
   243	    records, digest = provenance.closure_record(
   244	        provenance.source_closure(entry_module, REPO), commit, REPO)
   245	    if any(r['reviewed_blob_sha256'] != r['working_tree_sha256'] or
   246	           r['reviewed_blob_sha256'] is None for r in records):
   247	        raise ValueError('producer closure differs from HEAD')
   248	    return {'sha256': digest, 'files': records, 'commit': commit}
