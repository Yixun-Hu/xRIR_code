   104	def source_closure(entry_module, repo):
   105	    """Import hermetically; refuse files outside the repo and interpreter prefixes."""
   106	    repo = Path(repo).resolve()
   107	    code = '''import importlib, json, os, sys
   108	repo = os.path.realpath(sys.argv[1])
   109	sys.path = [repo] + [p for p in sys.path if p]
   110	importlib.import_module(sys.argv[2])
   111	files = {os.path.realpath(m.__file__) for m in list(sys.modules.values())
   112	         if getattr(m, '__file__', None)}
   113	prefixes = [repo, os.path.realpath(sys.prefix), os.path.realpath(sys.base_prefix)]
   114	foreign = sorted(f for f in files if not any(f.startswith(p + os.sep) for p in prefixes))
   115	if foreign:
   116	    raise RuntimeError('FOREIGN dependencies: ' + ', '.join(foreign))
   117	print('CLOSURE_JSON:' + json.dumps(sorted(os.path.relpath(f, repo) for f in files
   118	    if f.startswith(repo + os.sep))))
   119	'''
   120	    try:
   121	        output = subprocess.check_output([sys.executable, '-c', code, str(repo), entry_module],
   122	            cwd=repo, text=True, stderr=subprocess.STDOUT, env=dict(os.environ, PYTHONPATH=str(repo)))
   123	    except subprocess.CalledProcessError as error:
   124	        raise RuntimeError('source_closure failed: ' + error.output) from error
   125	    return json.loads(next(line[len('CLOSURE_JSON:'):] for line in reversed(output.splitlines())
   126	                           if line.startswith('CLOSURE_JSON:')))
