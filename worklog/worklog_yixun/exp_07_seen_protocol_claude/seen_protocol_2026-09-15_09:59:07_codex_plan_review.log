   140	        json_file_name = "S00" + str(src_node) + "_R00" + str(rec_node) + ".json"
   141	        metadata_file_path = os.path.join(self.metadata_path, scene_name, scene_id, json_file_name)
   142	        with open(metadata_file_path, "r") as fin:
   143	            meta_info = json.load(fin)
   144	        src_loc = meta_info["src_loc"]
