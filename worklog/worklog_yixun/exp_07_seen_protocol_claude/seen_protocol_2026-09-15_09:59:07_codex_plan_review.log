    19	def load_approved_digests(path=None):
    20	    """Read committed A9 pins; return a frozen view and sha256/git-blob identity.
    21	
    22	    schema_version=None is the all-null pre-approval template; approved schemas use 1.
    23	    """
    24	    path = Path(path or APPROVED_DIGESTS_PATH).resolve()
    25	    raw = path.read_bytes()
    26	    value = json.loads(raw)
    27	    closures = ('evaluator', 'writer', 'training_launcher',
    28	                'producer_paired_compare', 'producer_results_table', 'producer_descriptive')
    29	    def shape(obj, keys):
    30	        if type(obj) is not dict or set(obj) != set(keys):
    31	            raise ValueError('approved digests schema: expected ' + ', '.join(keys))
    32	    shape(value, ('schema_version', 'closures', 'checkpoints'))
    33	    shape(value['closures'], closures)
    34	    shape(value['checkpoints'], ('aug', 'aug_epoch9'))
    35	    aug = value['checkpoints']['aug']
    36	    shape(aug, ('path', 'epoch', 'sha256'))
    37	    checks = [(value['schema_version'], lambda v: type(v) is int and v == 1),
    38	              (aug['path'], lambda v: type(v) is str and bool(v)),
    39	              (aug['epoch'], lambda v: type(v) is int and v > 0)]
    40	    checks += [(v, lambda s: type(s) is str and re.fullmatch('[0-9a-f]{64}', s))
    41	               for v in [value['closures'][k] for k in closures] + [aug['sha256'], value['checkpoints']['aug_epoch9']]]
    42	    if any(v is not None and not valid(v) for v, valid in checks):
    43	        raise ValueError('approved digests schema: invalid pin type or value')
    44	    if any(v is None for v, _ in checks) and not all(v is None for v, _ in checks):
    45	        raise ValueError('approved digests schema: requires all-null or all-filled pins')
    46	    def git(*args):
    47	        return subprocess.check_output(['git', '-C', str(path.parent)] + list(args),
    48	                                       stderr=subprocess.PIPE)
    49	    try:
    50	        repo = Path(git('rev-parse', '--show-toplevel').decode().strip())
    51	        blob = git('rev-parse', 'HEAD:' + path.relative_to(repo).as_posix()).decode().strip()
    52	        committed = git('cat-file', 'blob', blob)
    53	    except subprocess.CalledProcessError as exc:
    54	        raise ValueError('approved digests must be committed at HEAD') from exc
    55	    if raw != committed:
    56	        raise ValueError('approved digests differ from committed HEAD bytes')
    57	    def freeze(obj):
    58	        return MP({key: freeze(item) for key, item in obj.items()}) if isinstance(obj, dict) else obj
    59	    return freeze(value), {'path': str(path), 'sha256': hashlib.sha256(raw).hexdigest(),
    60	                           'git_blob': blob}
