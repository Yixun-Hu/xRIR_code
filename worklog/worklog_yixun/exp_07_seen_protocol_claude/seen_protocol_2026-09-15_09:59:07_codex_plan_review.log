    68	    p.add_argument("--max-test-batches", type=int, default=0, help="0 = full test split")
    69	    p.add_argument("--test-subset", type=int, default=0,
    70	                   help="evaluate on a fixed seeded subset of N test samples each epoch (0 = all)")
    71	    args = p.parse_args()
    72	    args.yaw_aug_seed = args.seed if args.yaw_aug_seed is None else args.yaw_aug_seed
    73	    if args.yaw_aug and (args.resume is not None or args.save_every != 0):
    74	        p.error("--yaw-aug 1 requires --resume to be None and --save-every exactly 0")
