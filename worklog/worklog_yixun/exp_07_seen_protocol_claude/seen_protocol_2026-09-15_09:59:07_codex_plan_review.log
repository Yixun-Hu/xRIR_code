   413	def admit_runs(profile, groups, approved=None, exploratory=False, producer=None,
   414	               producer_key='producer_paired_compare'):
   415	    """Admit (arm, num_shot, directories) groups before computing statistics.
   416	
   417	    approved is the loader's (pins, identity) pair; only this producer's pin is compared.
   418	    """
   419	    approved, receipt = load_approved_digests() if approved is None else approved
   420	    required = [(key, approved['closures'][key]) for key in ('evaluator', 'writer', producer_key)]
   421	    required += [(a['role'] + ' checkpoint', approved['checkpoints']['aug']['sha256']
   422	                  if a['role'] == 'aug' else a['sha256']) for a, _, _ in groups]
   423	    if any(arm['role'] == 'aug' for arm, _, _ in groups):
   424	        required += [('aug checkpoint ' + key, approved['checkpoints']['aug'][key])
   425	                     for key in ('path', 'epoch')]
   426	    if profile.get('checkpoint_key') == 'aug_epoch9':
   427	        required += [('aug_epoch9 checkpoint', approved['checkpoints']['aug_epoch9'])]
   428	    required += [('dataset inventory', profile['dataset']['inventory_sha256']),
   429	                 ('approval schema_version', approved['schema_version'])]
   430	    deviations, inputs, run_flags, data_stats = [], {}, {}, {}
   431	    def check(ok, name):
   432	        if not ok:
   433	            deviations.append(name)
   434	    for key, value in required:
   435	        check(value is not None, 'profile not yet approved: ' + key)
   436	    producer = producer_identity() if producer is None else producer
   437	    check(producer['sha256'] == approved['closures'][producer_key], producer_key + ' approved closure')
   438	    inputs[receipt['path']] = receipt['sha256']
   439	    for record in producer['files']:
   440	        inputs[str((REPO / record['path']).resolve())] = record['working_tree_sha256']
   441	    admitted_groups = []
   442	    for arm, shot, directories in groups:
   443	        runs = []
   444	        for directory in directories:
   445	            try:
   446	                runs.append(admit_run(directory, arm, shot, profile, approved, check, inputs, data_stats))
   447	                run_flags[str(Path(directory).resolve())] = runs[-1]['admission_flags']
   448	            except (KeyError, TypeError, ValueError, OSError, IndexError) as error:
   449	                check(False, '{}: admission {}'.format(directory, error))
   450	        seeds = [r['meta'].get('manifest_seed') for r in runs]
   451	        check(len(runs) == len(profile['seeds'][shot]) and all(type(s) is int for s in seeds) and
   452	              set(seeds) == set(profile['seeds'][shot]), arm['role'] + ' seed set')
   453	        admitted_groups.append(sorted(runs, key=lambda r: int(r['meta']['manifest_seed'])))
   454	    flat = [r for group in admitted_groups for r in group]
   455	    if flat:
   456	        check(all(r['query'] == flat[0]['query'] and r['index'] == flat[0]['index'] for r in flat),
   457	              'query/index order across runs')
   458	    if deviations and not exploratory:
   459	        raise ValueError('admission failed: ' + '; '.join(deviations))
   460	    return {'groups': admitted_groups, 'approved_digests': dict(receipt, pins=json_value(approved)),
   461	            'deviations': deviations, 'inputs': inputs, 'producer': producer,
   462	            'run_flags': run_flags, 'data_stats': data_stats}
