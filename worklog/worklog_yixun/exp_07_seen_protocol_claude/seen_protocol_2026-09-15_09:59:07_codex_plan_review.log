   647	    parser.add_argument('--runs-a', nargs='+', required=True, help='First profile arm: aug')
   648	    parser.add_argument('--runs-b', nargs='+', help='Second profile arm: control (H1/H2 only)')
   649	    parser.add_argument('--json', required=True)
   650	    parser.add_argument('--summary', required=True)
   651	    parser.add_argument('--exploratory', action='store_true')
   652	    args = parser.parse_args(argv)
   653	    profile = get_profile(args.profile)
   654	    if profile['mode'] == 'one_arm' and args.runs_b is not None:
   655	        raise ValueError('one-arm TOST refuses --runs-b')
   656	    if profile['mode'] == 'two_arm' and not args.runs_b:
   657	        raise ValueError('two-arm profile requires --runs-b')
   658	    groups = [(arm, profile['num_shot'], paths) for arm, paths in
   659	              zip(profile['arms'], (args.runs_a, args.runs_b))]
   660	    admitted = admit_runs(profile, groups, exploratory=args.exploratory)
   661	    result = analyze(profile, admitted, args.exploratory)
   662	    result['profile_name'] = args.profile
   663	    write_outputs(result, admitted, args.json, args.summary)
   664	    return result
