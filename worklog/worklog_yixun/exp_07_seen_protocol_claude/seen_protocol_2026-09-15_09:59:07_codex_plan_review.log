    99	def collect(runs, attempt, probe_receipt, audit, results, approved=None, head=None):
   100	    pins, identity = load_approved_digests(approved)
   101	    require(pins['schema_version'] == 1, 'approval pins are not final')
   102	    approval = dict(identity, blob=json.loads(Path(identity['path']).read_text()))
   103	    require(stamp(identity['path'])['sha256'] == identity['sha256'], 'approval digest mismatch')
   104	    training, fields = snapshot(attempt, 'train')
   105	    receipt, audit_record = stamp(probe_receipt), stamp(audit)
   106	    bound_probe = fields['mutable_inputs']['probe_receipt']
   107	    require(stamp(Path(fields['repo']) / bound_probe['path'], bound_probe['sha256']) == receipt, 'probe receipt linkage')
   108	    checkpoint = pins['checkpoints']['aug']
   109	    selected = stamp(ROOT / checkpoint['path'], checkpoint['sha256'])
   110	    require(Path(selected['path']).parent == Path(training['path'])
   111	            and training['outputs'].get(Path(selected['path']).name) == selected, 'approved training checkpoint')
   112	    paths = sorted(str(Path(run).resolve()) for run in runs)
   113	    require(paths and len(paths) == len(set(paths)), 'empty or duplicate run set')
   114	    records = []
   115	    for path in paths:
   116	        record, manifest = snapshot(path, 'eval')
   117	        bindings = manifest['mutable_inputs']
   118	        if (Path(manifest['repo']) / manifest['checkpoint']).resolve() == Path(selected['path']):
   119	            require({'train_manifest', 'train_completion'} <= set(bindings), 'missing training linkage')
   120	        for key, expected in (('train_manifest', training['manifest']), ('train_completion', training['completion'])):
   121	            if key in bindings:
   122	                value = bindings[key]
   123	                require(stamp(Path(manifest['repo']) / value['path'], value['sha256']) == expected, 'training linkage')
   124	        records.append(record)
   125	    head = head or subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip()
   126	    require(subprocess.run(['git', 'cat-file', '-e', head + '^{commit}'], cwd=ROOT,
   127	                           stdout=subprocess.PIPE, stderr=subprocess.PIPE).returncode == 0, 'invalid binding HEAD')
   128	    return dict(schema_version=1, git_HEAD=head, results=bind_results(results, head, approval, records, training), runs=records, training=training, probe_receipt=receipt,
   129	        audit=audit_record, approved_digests=approval, inputs=dict(runs=paths, attempt=training['path'],
   130	        probe_receipt=receipt['path'], audit=audit_record['path'], approved=identity['path'],
   131	        results=sorted(str(Path(path).resolve()) for path in results)))
