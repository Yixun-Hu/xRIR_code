     1	"""Paired bootstrap statistics for the yaw-rotation degradation experiment (exp_03).
     2	
     3	Every comparison in exp_03 is *paired*: the same query is evaluated at ``k = 0`` and at
     4	a rotated angle ``k``, so the two error series share their sample index.  The reported
     5	quantity is the **relative degradation**
     6	
     7	    r_k = (mean(e_k) - mean(e_0)) / mean(e_0)
     8	
     9	recomputed inside every bootstrap resample (never as a ratio of two independently
    10	bootstrapped means), and the confirmatory decision asks whether its Bonferroni-adjusted
    11	lower bound clears a practical margin.
    12	
    13	Everything here is pure ``numpy`` and deterministic given ``seed``; no state is shared
    14	between calls.  Inputs must already be masked to the valid samples (see
    15	:func:`valid_mask`) -- a non-finite value raises rather than silently propagating.
    16	"""
    17	from __future__ import annotations
    18	
    19	import numbers
    20	
    21	import numpy as np
    22	
    23	# Resamples are drawn in chunks of at most this many cells, so a 10000 x 6337 bootstrap
    24	# never materialises a 500 MB index matrix.
    25	_CHUNK_CELLS = 2000000
    26	
    27	
    28	def _check_positive_int(value, name):
    29	    """Reject anything but a positive Python integer (``bool`` and ``float`` included)."""
    30	    if isinstance(value, bool) or not isinstance(value, numbers.Integral):
    31	        raise TypeError("{} must be an integer, got {!r}".format(name, value))
    32	    if int(value) < 1:
    33	        raise ValueError("{} must be >= 1, got {}".format(name, value))
    34	    return int(value)
    35	
    36	
    37	def _as_1d(values, name):
    38	    array = np.asarray(values, dtype=np.float64)
    39	    if array.ndim != 1:
    40	        raise ValueError("{} must be 1-D, got shape {}".format(name, array.shape))
    41	    return array
    42	
    43	
    44	def valid_mask(e0, ek):
    45	    """Boolean mask of the pairs that are finite on *both* sides.
    46	
    47	    This is the pre-registered validity rule: a sample enters the paired analysis only
    48	    if its metric is finite at ``k = 0`` *and* at the compared angle.
    49	
    50	    Args:
    51	        e0: per-sample errors at ``k = 0``.
    52	        ek: per-sample errors at the compared angle.
    53	
    54	    Returns:
    55	        A boolean ``np.ndarray`` of the common length.
    56	
    57	    Raises:
    58	        ValueError: if the two series have different lengths or are not 1-D.
    59	    """
    60	    a, b = _as_1d(e0, "e0"), _as_1d(ek, "ek")
    61	    if a.shape != b.shape:
    62	        raise ValueError("e0 and ek must have the same length, got {} and {}".format(
    63	            a.size, b.size))
    64	    return np.isfinite(a) & np.isfinite(b)
    65	
    66	
    67	def invalid_fraction(ek):
    68	    """Fraction of *all* non-finite entries in one series (0.0 when empty).
    69	
    70	    This is a marginal count: it does not distinguish a sample that was already invalid
    71	    at ``k = 0`` from one the rotation broke.  For the paired split -- which is the
    72	    degradation indicator -- use :func:`paired_validity`.
    73	    """
    74	    a = _as_1d(ek, "ek")
    75	    if a.size == 0:
    76	        return 0.0
    77	    return float(np.count_nonzero(~np.isfinite(a)) / a.size)
    78	
    79	
    80	def paired_validity(e0, ek):
    81	    """Split a paired series into the four validity categories.
    82	
    83	    A rotation can degrade a prediction so far that the metric stops being defined at
    84	    all; that has to be reported, not silently dropped.  Conditioning on a usable
    85	    baseline separates "the rotation broke this sample" from "this sample was never
    86	    measurable".
    87	
    88	    Args:
    89	        e0: per-sample errors at ``k = 0`` (non-finite entries allowed).
    90	        ek: per-sample errors at the compared angle.
    91	
    92	    Returns:
    93	        ``{"n", "baseline_invalid", "newly_invalid", "recovered", "paired_valid",
    94	        "newly_invalid_frac"}``; the first five are ``int`` counts, and
    95	        ``newly_invalid_frac = newly_invalid / (n - baseline_invalid)`` is ``0.0`` when
    96	        no sample had a usable baseline.
    97	
    98	    Raises:
    99	        ValueError: if the two series have different lengths or are not 1-D.
   100	    """
   101	    a, b = _as_1d(e0, "e0"), _as_1d(ek, "ek")
   102	    if a.shape != b.shape:
   103	        raise ValueError("e0 and ek must have the same length, got {} and {}".format(
   104	            a.size, b.size))
   105	    finite0, finitek = np.isfinite(a), np.isfinite(b)
   106	    baseline_invalid = int(np.count_nonzero(~finite0))
   107	    usable = int(a.size) - baseline_invalid
   108	    newly_invalid = int(np.count_nonzero(finite0 & ~finitek))
   109	    return {"n": int(a.size), "baseline_invalid": baseline_invalid,
   110	            "newly_invalid": newly_invalid,
   111	            "recovered": int(np.count_nonzero(~finite0 & finitek)),
   112	            "paired_valid": int(np.count_nonzero(finite0 & finitek)),
   113	            "newly_invalid_frac": (newly_invalid / usable) if usable else 0.0}
   114	
   115	
   116	def _check_pair(e0, ek, name0="e0", namek="ek"):
   117	    """Validate one paired series and return it as float64 arrays."""
   118	    a, b = _as_1d(e0, name0), _as_1d(ek, namek)
   119	    if a.shape != b.shape:
   120	        raise ValueError("{} and {} must have the same length, got {} and {}".format(
   121	            name0, namek, a.size, b.size))
   122	    if a.size == 0:
   123	        raise ValueError("{}/{} are empty".format(name0, namek))
