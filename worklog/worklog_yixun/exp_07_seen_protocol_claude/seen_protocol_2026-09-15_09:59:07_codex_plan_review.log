    55	def get_3d_point_camera_coord(rotation_angle, listener_pos, point_3d):
    56	    camera_matrix = None
    57	    lis_x, lis_y, lis_z = listener_pos[0], listener_pos[1], listener_pos[2]
    58	    # print(lis_x, lis_y, lis_z)
    59	    if rotation_angle == 0:
