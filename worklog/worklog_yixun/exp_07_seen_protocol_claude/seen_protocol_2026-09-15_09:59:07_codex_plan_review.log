   161	class ManifestDataset(torch.utils.data.Dataset):
   162	    """``xRIR_Dataset`` with its reference draw replaced by a manifest.
   163	
   164	    Iteration follows the **manifest's** order (canonical, sorted by query path), not
   165	    ``dataset.file_list``'s, so the sample at index ``i`` is the same query whatever
   166	    order the cache happens to list its files in.
   167	
   168	    Yields the exp_01 six-tuple -- ``(listener_pos[3], src_local[3],
   169	    depth_coord[3, 256, 512], tgt_wav[1, L], ref_irs[K, L], ref_src_local[K, 3])`` --
   170	    built exactly like ``xRIR_Dataset.__getitem__``, plus a seventh element: the query
   171	    path relative to the IR root, which is the key every per-sample metric is stored
   172	    under (and the key the Griffin-Lim phase seed is derived from).
   173	
   174	    Paths are resolved against ``dataset.ir_path``, not against the manifest's recorded
   175	    ``ir_root``, so a manifest stays usable when the cache is mounted elsewhere.
   176	
   177	    Args:
   178	        dataset: the ``xRIR_Dataset`` the manifest was built from.
   179	        manifest: the manifest dict; validated structurally (see :meth:`_validate`).
   180	
   181	    Raises:
   182	        ValueError: if the manifest does not describe this dataset/split, or breaks one
   183	            of the dataset's own reference rules.
   184	    """
   185	
   186	    def __init__(self, dataset, manifest):
   187	        self._validate(dataset, manifest)
   188	        self.dataset = dataset
   189	        self.manifest = manifest
   190	        self.entries = manifest["entries"]
   191	
   192	    @staticmethod
   193	    def _validate(dataset, manifest):
   194	        """Check the manifest against the dataset and against the dataset's own rules.
   195	
   196	        Order-independent by design (the queries are compared as a set), so a cache that
   197	        lists its files differently still validates; everything that would change *which
   198	        audio is served* is rejected.
   199	        """
   200	        entries = manifest["entries"]
   201	        if manifest["num_shot"] != dataset.num_shot:
   202	            raise ValueError("manifest num_shot {} != dataset num_shot {}".format(
   203	                manifest["num_shot"], dataset.num_shot))
   204	
   205	        queries = [entry["query"] for entry in entries]
   206	        expected = [os.path.relpath(path, dataset.ir_path) for path in dataset.file_list]
   207	        if sorted(queries) != sorted(expected):
   208	            missing = sorted(set(expected) - set(queries))[:3]
   209	            extra = sorted(set(queries) - set(expected))[:3]
   210	            raise ValueError(
   211	                "manifest queries do not match dataset.file_list ({} vs {} entries; "
   212	                "missing e.g. {}, unexpected e.g. {})".format(
   213	                    len(queries), len(expected), missing, extra))
   214	
   215	        for position, entry in enumerate(entries):
   216	            query = entry["query"]
   217	            if entry["index"] != position:
   218	                raise ValueError("entry {} carries index {} (the manifest is not in its "
   219	                                 "canonical order)".format(query, entry["index"]))
   220	            if len(entry["refs"]) != manifest["num_shot"]:
   221	                raise ValueError("{} has {} references, expected {}".format(
   222	                    query, len(entry["refs"]), manifest["num_shot"]))
   223	            room = os.path.dirname(query)
   224	            receiver = os.path.basename(query).split("_")[1]
