   230	def _inventory(files, data_root, workers=8):
   231	    root = Path(data_root).resolve()
   232	    def record(name):
   233	        path = root / name
   234	        path.resolve().relative_to(root)
   235	        before = path.stat()
   236	        digest = sha256_file(path)
   237	        after = path.stat()
   238	        if (before.st_size, before.st_mtime_ns) != (after.st_size, after.st_mtime_ns):
   239	            raise ValueError('data changed while hashing: ' + name)
   240	        return {'path': name, 'sha256': digest, 'size': after.st_size,
