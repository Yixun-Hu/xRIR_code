    27	def _quantile(samples, probability, upper=False):
    28	    """Inverse empirical CDF: rank ceil(p*n); upper=True accepts the upper tail."""
    29	    values = np.asarray(samples, dtype=np.float64)
    30	    if values.ndim != 1 or not values.size or not np.isfinite(values).all():
    31	        raise ValueError("quantile samples must be a nonempty finite 1-D array")
    32	    # Decimal ranks avoid a binary rounding step promoting rank 3 to 4
    33	    # for alpha=.7 and n=10. The input decimal is interpreted literally.
    34	    probability = Decimal(str(probability))
    35	    if not probability.is_finite() or not 0 < probability < 1:
    36	        raise ValueError("quantile probability must be in (0, 1)")
    37	    probability = Decimal(1) - probability if upper else probability
    38	    rank = int((probability * values.size).to_integral_value(rounding=ROUND_CEILING)) - 1
    39	    return float(np.partition(values, rank)[rank])
