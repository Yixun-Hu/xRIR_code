    46	@contextmanager
    47	def deferred_termination():
    48	    """Mask stop signals and defer Python handlers even on threaded processes."""
    49	    pending = []
    50	    previous = {s: signal.getsignal(s) for s in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT)}
    51	    mask = signal.pthread_sigmask(signal.SIG_BLOCK, previous)
    52	    try:
    53	        for signum in previous:
    54	            if previous[signum] != signal.SIG_IGN:
    55	                signal.signal(signum, lambda signum, frame: pending.append(signum))
    56	        yield
    57	    finally:
    58	        try:
    59	            signal.pthread_sigmask(signal.SIG_SETMASK, mask)
    60	        finally:
    61	            for signum, handler in previous.items():
    62	                signal.signal(signum, handler)
    63	        if pending:
    64	            os.kill(os.getpid(), pending[0])
