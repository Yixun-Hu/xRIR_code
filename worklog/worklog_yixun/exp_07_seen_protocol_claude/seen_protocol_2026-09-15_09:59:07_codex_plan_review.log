    67	def masked_abort_reason(error, reason):
    68	    """Block repeated stop signals until termination_handlers restores the mask."""
    69	    signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM, signal.SIGHUP, signal.SIGINT})
    70	    return ('terminated_' + signal.Signals(error.signum).name if isinstance(error, LauncherTerminated)
    71	            else 'terminated_SIGINT' if isinstance(error, KeyboardInterrupt) else getattr(error, 'reason', reason))
