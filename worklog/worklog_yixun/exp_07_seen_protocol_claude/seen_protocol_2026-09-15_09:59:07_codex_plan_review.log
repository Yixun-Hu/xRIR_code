    74	def reap_process_groups(*processes):
    75	    mask = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM, signal.SIGHUP, signal.SIGINT})
    76	    try:
    77	        for process in processes:
    78	            if process is not None:
    79	                try:
    80	                    os.killpg(process.pid, signal.SIGTERM)
    81	                except ProcessLookupError:
    82	                    pass
    83	                try:
    84	                    process.wait(timeout=5)
    85	                except subprocess.TimeoutExpired:
    86	                    os.killpg(process.pid, signal.SIGKILL)
    87	                    process.wait()
    88	                try:
    89	                    os.killpg(process.pid, signal.SIGKILL)  # Reap survivors even after their leader exits.
    90	                except ProcessLookupError:
    91	                    pass
    92	    finally:
    93	        signal.pthread_sigmask(signal.SIG_SETMASK, mask)
