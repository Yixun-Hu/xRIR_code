    12	from types import MappingProxyType as MP
    13	
    14	APPROVED_DIGESTS_PATH = Path(__file__).resolve().parents[1] / (
    15	    'worklog/worklog_yixun/exp_04_yaw_aug_xrir_claude/'
    16	    'yaw_aug_xrir_results_assets/approved_digests.json')
