   129	def closure_record(files, reviewed_commit, repo):
   130	    """Return file records and the exp_03-compatible digest of reviewed blobs."""
   131	    records = []
   132	    for name in sorted(set(files)):
   133	        path = Path(repo) / name
   134	        path.resolve().relative_to(Path(repo).resolve())
   135	        blob = subprocess.run(['git', 'show', '{}:{}'.format(reviewed_commit, name)],
   136	                              cwd=repo, capture_output=True)
   137	        later = subprocess.check_output(['git', 'log', '--format=%H',
   138	            '{}..HEAD'.format(reviewed_commit), '--', name], cwd=repo, text=True).split()
   139	        records.append({'path': name, 'reviewed_blob_sha256':
   140	            hashlib.sha256(blob.stdout).hexdigest() if blob.returncode == 0 else None,
   141	            'working_tree_sha256': sha256_file(path), 'commits_after_reviewed': later,
   142	            'mtime': datetime.datetime.fromtimestamp(path.stat().st_mtime).astimezone().isoformat()})
   143	    digest = hashlib.sha256(json.dumps([[r['path'], r['reviewed_blob_sha256']]
   144	        for r in records], sort_keys=True).encode()).hexdigest()
   145	    return records, digest
