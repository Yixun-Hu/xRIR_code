   148	    def get_ir_and_location_for_other_sources(self, ir_file_path, num_ref_sources):
   149	        dir_name = os.path.dirname(ir_file_path)
   150	        ir_file_name = ir_file_path.split("/")[-1]
   151	        src_node, rec_node = int(ir_file_name.split("_")[0][1:]), int(ir_file_name.split("_")[1][1:])
   152	        all_src_node = set([int(fn.split("_")[0][1:]) for fn in os.listdir(dir_name)])
   153	        remain_src_node = list(all_src_node.difference(set([src_node])))
   154	        valid_other_src_ir_paths = []
   155	        for node in remain_src_node:
   156	            rec_n = ir_file_name.split("_")[1]
   157	            src_n = f"S00{node}"
   158	            other_src_ir_path = os.path.join(dir_name, f"{src_n}_{rec_n}_hybrid_IR.wav")
   159	            if os.path.exists(other_src_ir_path):
   160	                valid_other_src_ir_paths.append(other_src_ir_path)
   161	        try:
   162	            select_other_src_ir_paths = np.random.choice(valid_other_src_ir_paths, num_ref_sources, replace=False)
   163	        except Exception as e:
   164	            select_other_src_ir_paths = np.random.choice(valid_other_src_ir_paths, num_ref_sources, replace=True)
   165	        all_ref_irs = []
   166	        all_ref_src_pos = []
   167	      
   168	        for fp in select_other_src_ir_paths:
   169	            ref_wav, rate = torchaudio.load(fp)
   170	            assert rate == 22050, "IR sampling rate must be 22050!"
   171	            if ref_wav.shape[1] < self.max_len:
   172	                ref_wav = torch.cat([ref_wav, torch.zeros(ref_wav.shape[0], self.max_len - ref_wav.shape[1])], dim=1)
   173	            else:
   174	                ref_wav = ref_wav[:, :self.max_len]
   175	            all_ref_irs.append(ref_wav)
   176	
   177	            src_loc, rec_loc = self.get_receiver_source_location(fp)
   178	            
   179	            proj_src_loc = get_3d_point_camera_coord(0, rec_loc, src_loc)
   180	            
   181	            all_ref_src_pos.append(torch.Tensor(proj_src_loc).float())
   182	        all_ref_irs = torch.cat(all_ref_irs, dim=0)
   183	        all_ref_src_pos = torch.vstack(all_ref_src_pos)
   184	        return all_ref_irs, all_ref_src_pos
