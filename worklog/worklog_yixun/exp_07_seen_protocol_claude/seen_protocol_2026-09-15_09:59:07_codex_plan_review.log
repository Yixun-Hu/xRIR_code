   482	def directory_listing(attempt):
   483	    listing = {}
   484	    for path in sorted(attempt.rglob('*')):
   485	        if path.is_symlink() or not (path.is_file() or path.is_dir()):
   486	            raise ValueError('unexpected attempt entry: ' + str(path))
   487	        listing[str(path.relative_to(attempt))] = p.sha256_file(path) if path.is_file() else None
   488	    return listing
