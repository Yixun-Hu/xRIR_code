   185	    for name, path, expected in (("checkpoint", args.checkpoint, fields["checkpoint_sha256"]),
   186	                                 ("manifest", args.manifest, fields["manifest_file_sha256"]),
   187	                                 ("eval_manifest", args.eval_manifest, digest)):
   188	        if provenance.sha256_file(path) != expected:
