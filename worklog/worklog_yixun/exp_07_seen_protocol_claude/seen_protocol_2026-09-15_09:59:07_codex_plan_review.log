   150	def dk_bootstrap(e0_a, ek_a, e0_b, ek_b, n_boot=20000, seed=0, clusters=None):
   151	    """D_k=r_k(a)-r_k(b); exp_03's definition matches §3 exactly.
   152	
   153	    Both arm ratios share the same resample. As for rho, the public primitive
   154	    supplies validation/estimates; exact quantiles are computed by the caller.
   155	    """
   156	    result = diff_in_diff_bootstrap(e0_a, ek_a, e0_b, ek_b, n_boot=1,
   157	                                    seed=seed, clusters=clusters)
   158	    a, b = _samples([(e0_a, ek_a), (e0_b, ek_b)], n_boot, seed, clusters)
   159	    return _sample_metadata(result, a - b, n_boot, seed)
