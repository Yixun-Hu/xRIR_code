   192	def write_manifest(path, fields):
   193	    """Exclusively create strict JSON; return the digest of exactly those bytes."""
   194	    payload = json.dumps(fields, sort_keys=True, indent=2, allow_nan=False).encode() + b'\n'
   195	    with open(path, 'xb') as stream:  # Python's x mode uses O_CREAT | O_EXCL.
   196	        stream.write(payload)
   197	        stream.flush()
   198	        os.fsync(stream.fileno())
   199	    return hashlib.sha256(payload).hexdigest()
