    33	def select_references(candidates, num_shot, seed, query_key):
    34	    """Deterministically pick ``num_shot`` references for one query.
    35	
    36	    The candidates are sorted first, so the result depends only on the *set* of
    37	    candidate paths, never on the order ``os.listdir`` happened to return them in.
    38	    Sampling is without replacement when there are enough candidates and with
    39	    replacement otherwise -- the same fallback ``xRIR_Dataset`` takes.
    40	
    41	    Args:
    42	        candidates: candidate reference paths (any iterable of str); not modified.
    43	        num_shot: number of references to draw.
    44	        seed: manifest seed (an int; combined with ``query_key`` into the rng seed).
    45	        query_key: per-query string, normally the query path relative to the IR root.
    46	
    47	    Returns:
    48	        A ``list`` of ``num_shot`` paths taken from ``candidates`` (repeats only in the
    49	        with-replacement case).
    50	
    51	    Raises:
    52	        ValueError: if ``candidates`` is empty (propagated from ``numpy``).
    53	    """
    54	    ordered = sorted(candidates)
    55	    digest = hashlib.sha256("{}:{}".format(seed, query_key).encode()).digest()[:8]
    56	    rng = np.random.default_rng(int.from_bytes(digest, "little"))
    57	    idx = rng.choice(len(ordered), size=num_shot, replace=len(ordered) < num_shot)
    58	    return [ordered[int(i)] for i in idx]
    59	
