    96	def sha256_file(path):
    97	    digest = hashlib.sha256()
    98	    with open(path, 'rb') as stream:
    99	        for chunk in iter(lambda: stream.read(1 << 20), b''):
   100	            digest.update(chunk)
   101	    return digest.hexdigest()
