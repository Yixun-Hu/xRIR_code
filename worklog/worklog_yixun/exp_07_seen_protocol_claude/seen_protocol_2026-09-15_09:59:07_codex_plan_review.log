   261	def main(argv=None):
   262	    args = parse_args(argv)
   263	    repo = Path(__file__).resolve().parents[1]
   264	    command = child_command(args, repo)
   265	    return execute_run(args, command, lambda: build_fields(args, command, repo), repo)
