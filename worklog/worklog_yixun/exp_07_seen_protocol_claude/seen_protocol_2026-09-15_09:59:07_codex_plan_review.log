    99	def build_manifest(dataset, seed, num_shot=8):
   100	    """Build the reference manifest for every query of ``dataset``.
   101	
   102	    Reads directory listings only (no audio, no metadata, no depth maps), caching one
   103	    ``os.listdir`` per room directory, so the full 6337-query test split takes a couple
   104	    of seconds.
   105	
   106	    Args:
   107	        dataset: an ``xRIR_Dataset`` (only ``file_list`` and ``ir_path`` are used).
   108	        seed: manifest seed; part of every per-query rng seed.
   109	        num_shot: references per query.
   110	
   111	    Returns:
   112	        ``{"seed", "num_shot", "ir_root", "entries"}`` where ``entries`` is one dict per
   113	        query -- ``{"index", "query", "refs"}`` -- sorted by ``query`` with ``index``
   114	        the position in that canonical order, and ``query`` / ``refs`` relative to
   115	        ``ir_root``.  ``query`` is also the key the reference draw is seeded with.
   116	
   117	        Canonical ordering matters: ``dataset.file_list`` comes from ``os.listdir``, so
   118	        a re-copied cache would otherwise reorder the entries and change
   119	        :func:`manifest_hash` for an identical selection.
   120	    """
   121	    ir_root = dataset.ir_path
   122	    listdir_cache = {}
   123	    entries = []
   124	    for ir_path in sorted(dataset.file_list, key=lambda p: os.path.relpath(p, ir_root)):
   125	        query = os.path.relpath(ir_path, ir_root)
   126	        refs = select_references(
   127	            candidate_references(ir_path, listdir_cache=listdir_cache), num_shot, seed, query)
   128	        entries.append({"index": len(entries), "query": query,
   129	                        "refs": [os.path.relpath(ref, ir_root) for ref in refs]})
   130	    return {"seed": seed, "num_shot": num_shot, "ir_root": ir_root, "entries": entries}
   131	
   132	
   133	def manifest_hash(manifest):
   134	    """Hex sha256 of the manifest's *content* -- seed, num_shot and entries.
   135	
   136	    ``ir_root`` is deliberately excluded so the same selection hashes identically no
   137	    matter where the dataset is mounted.
   138	    """
   139	    payload = {"seed": manifest["seed"], "num_shot": manifest["num_shot"],
   140	               "entries": manifest["entries"]}
   141	    return hashlib.sha256(
   142	        json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
