    15	def validate_receipt(path, commit, gpu, tier, backbone):
    16	    from tools.exp04_launcher import arm_root
    17	    def require(ok, cause):
    18	        if not ok:
    19	            raise ValueError(cause)
    20	    context = 'validation'
    21	    try:
    22	        path = Path(path).resolve()
    23	        raw = path.read_bytes()
    24	        digest = hashlib.sha256(raw).hexdigest()
    25	        data = json.loads(raw)
    26	        require(data['reviewed_commit'] == commit, 'commit mismatch')
    27	        require(tier in ('S', 'L') and backbone in ('simple', 'cylindrical')
    28	                and data['tier'] == tier and data['backbone'] == backbone, 'tier/backbone mismatch')
    29	        require(data['gpu'] == gpu, 'GPU mismatch')
    30	        require(data['PROBE_NOT_CLEAN'] is False, 'NOT CLEAN')
    31	        projected = projection(data)
    32	        require(data['passed'] is True and projected['passed']
    33	                and all(data[k] == projected[k] for k in ('T_epoch', 'T_run')), 'T_run or timing mismatch')
    34	        context = 'probe-attempt binding'
    35	        attempt = data['probe_attempt']
    36	        if any(p.sha256_file(Path(attempt['path']) / (name + '.json')) != attempt[name + '_sha256']
    37	               for name in ('train_manifest', 'completion')):
    38	            raise ValueError('probe attempt changed')
    39	        attempt_path = Path(attempt['path']).resolve()
    40	        manifest = json.loads((attempt_path / 'train_manifest.json').read_bytes())
    41	        completion = json.loads((attempt_path / 'completion.json').read_bytes())
    42	        require(manifest['reviewed_commit'] == commit, 'commit mismatch')
    43	        require(manifest['effective_args']['tier'] == tier and manifest['effective_args']['backbone'] == backbone,
    44	                'tier/backbone mismatch')
    45	        if (attempt_path.parent != arm_root(tier, backbone).resolve()
    46	                or manifest['mode'] != 'probe'
    47	                or Path(manifest['attempt_path']).resolve() != attempt_path
    48	                or any(completion['metrics']['probe'][k] != data[k] for k in
    49	                       ('t_micro', 't_test', 't_save', 'iteration_seconds', 'peak_allocated_bytes',
    50	                        'peak_reserved_bytes', 'T_epoch', 'T_run'))):
    51	            raise ValueError('probe attempt arm or measurements differ')
    52	        context = 'validation'
    53	        snapshots = [data['before'], *data['arms_before'], data['after']]
    54	        require(all(s['gpu'] == gpu and s['uuid'] == data['before']['uuid'] for s in snapshots), 'GPU mismatch')
    55	        require(len(data['arms_before']) == 1 and type(data['before']['uuid']) is str and bool(data['before']['uuid'])
    56	                and all(s['compute_apps'] == '' and math.isfinite(s['free_gib']) and s['free_gib'] >= 40
    57	                        for s in snapshots), 'NOT CLEAN')
    58	        valid = (type(data['schema_version']) is int and data['schema_version'] == 1
    59	            and data['test_timing_protocol'] == 'full_test_loader'
    60	            and type(data['test_batches_total']) is int and data['test_batches_total'] > 0
    61	            and type(data['test_batches_timed']) is int and data['test_batches_timed'] == data['test_batches_total']
    62	            and all(type(data[k]) is int and data[k] > 0 for k in ('peak_allocated_bytes', 'peak_reserved_bytes'))
    63	            and data['peak_reserved_bytes'] >= data['peak_allocated_bytes'] and data['yaw_aug'] == 0
    64	            and math.isfinite(data['train_loss']) and data['iteration_seconds'] == data['t_micro']['values']
    65	            and all(data[k + '_iteration_seconds'] == data['t_micro'][k] for k in ('mean', 'median', 'min')))
    66	        require(valid, 'invalid measurements or schema')
    67	        require(p.sha256_file(path) == digest, 'stale receipt: bytes changed during validation')
    68	    except (OSError, KeyError, TypeError, ValueError, OverflowError) as error:
    69	        raise ValueError('full requires a clean passing tier receipt ({}): {}'.format(context, error)) from error
    70	    return dict(path=str(path), sha256=digest)
