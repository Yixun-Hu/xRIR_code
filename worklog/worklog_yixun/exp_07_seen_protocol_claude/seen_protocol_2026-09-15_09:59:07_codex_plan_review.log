   256	def _closure_digest(closure):
   257	    records = closure['files']
   258	    names = [r['path'] for r in records]
   259	    if not records or names != sorted(set(names)) or any(
   260	            r['working_tree_sha256'] != r['reviewed_blob_sha256'] or
   261	            r['reviewed_blob_sha256'] is None or r['commits_after_reviewed'] for r in records):
   262	        raise ValueError('closure records are incomplete or unreviewed')
   263	    # Match tools.provenance.closure_record's deliberately noncompact encoding.
   264	    return hashlib.sha256(json.dumps([[r['path'], r['reviewed_blob_sha256']]
   265	        for r in records], sort_keys=True).encode()).hexdigest()
