    73	def timing_limits(fields, gpu):
    74	    effective = fields['effective_args']
    75	    tier = tier_of(effective)
    76	    if tier == 'M':
    77	        return None
    78	    try:
    79	        bound = fields['mutable_inputs']['probe_receipt']
    80	        actual = validate_receipt(bound['path'], fields['reviewed_commit'], gpu, tier, effective['backbone'])
    81	        raw = Path(actual['path']).read_bytes()
    82	        if bound['sha256'] != actual['sha256'] or hashlib.sha256(raw).hexdigest() != actual['sha256']:
    83	            raise ValueError('changed receipt')
    84	        data = json.loads(raw)
    85	        if 'resource_before' in fields and (fields['resource_before'].get('uuid') != data['before']['uuid']
    86	                or fields['resource_before'].get('gpu') != gpu):
    87	            raise ValueError('launch GPU differs from probe GPU')
    88	    except (OSError, KeyError, TypeError, ValueError) as error:
    89	        raise ValueError('missing or changed tier probe receipt') from error
    90	    return dict(epoch_seconds=1.05 * data['T_epoch'], projection_hours=data['T_run'] / 3600,
    91	                ceiling_hours=1.5 * data['T_run'] / 3600, probe_receipt_sha256=actual['sha256'])
