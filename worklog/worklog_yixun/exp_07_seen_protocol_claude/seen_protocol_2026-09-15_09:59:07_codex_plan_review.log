   132	            .format(len(protocol['seeds']))).format(**protocol, precision='on' if protocol['tf32'] else 'off')
   133	        lines.append('| ' + ' | '.join([row['label'], str(row['num_shot'])] + cells + [description]) + ' |')
   134	    lines += ['', '## Protocol', '',
   135	        'Rows report K, {dataset[split]} split query count, seed count, epoch, condition {condition}, '
   136	        'standalone k = {grid[0]}, canonical batch {batch_size}, and TF32 {precision}. '
