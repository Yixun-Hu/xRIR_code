   600	def recheck_inputs(admitted):
   601	    """Rehash mutable artifacts; data bytes are hashed once with stat checks until publish."""
   602	    for path, digest in admitted['inputs'].items():
   603	        expected = admitted['data_stats'].get(path)
   604	        unchanged = (_file_stamp(path) == expected if expected is not None
   605	                     else provenance.sha256_file(path) == digest)
   606	        if not unchanged:
   607	            raise ValueError('input changed during analysis: ' + path)
