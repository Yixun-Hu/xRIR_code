   175	def child_command(args, repo):
   176	    """Serialize only evaluator arguments, retaining empty grids and bool flags."""
   177	    module = entrypoint(args)
   178	    command = [sys.executable, str(Path(repo) / (module.__name__.replace('.', '/') + '.py'))]
   179	    for action in module.build_parser()._actions:
   180	        if action.dest == "help":
   181	            continue
   182	        value = getattr(args, action.dest)
   183	        if isinstance(value, bool):
   184	            if value:
   185	                command.append(action.option_strings[0])
   186	        else:
   187	            command.append(action.option_strings[0])
   188	            command.extend(str(item) for item in (value if isinstance(value, list) else [value]))
   189	    return command
