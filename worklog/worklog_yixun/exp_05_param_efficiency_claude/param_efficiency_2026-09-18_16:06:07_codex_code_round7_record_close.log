def general(v):
 if v is None:return '—'
 if isinstance(v,bool):return 'yes' if v else 'no'
 if isinstance(v,float):return format(v,'.6g')
 return str(v)
def native(metric,v):return format(v,dict(EDT='.4f',C50='.3f',T60='.2f')[metric])
def pct(v):
 if isinstance(v,list):return ', '.join(pct(x) for x in v)
 return format(100*v,'.2f')
