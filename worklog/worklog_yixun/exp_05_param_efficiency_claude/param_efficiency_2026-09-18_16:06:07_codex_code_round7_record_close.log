                   ('CURVE_K8', 'CURVE_K1', 'TARGETS_K8', 'TARGETS_K1', 'YAW_K8_SEED42')))
CURVES = ('CURVE_K8', 'CURVE_K1')
TARGETS = ('TARGETS_K8', 'TARGETS_K1')
YAW = 'YAW_K8_SEED42'
ACOUSTIC = ('EDT', 'C50', 'T60')
UNITS = dict(EDT='s', C50='dB', T60='%')
ROLES = {arm['role']: arm for arm in ARMS}
