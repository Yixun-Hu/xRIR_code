from pathlib import Path
from functools import lru_cache
import json,numpy as np
r=Path('/home/yixunhu/codespace/xRIR_code/ckpt/exp05')
products={name:json.loads((r/'results'/(name+'.json')).read_text()) for name in ['CURVE_K8','CURVE_K1','TARGETS_K8','TARGETS_K1','YAW_K8_SEED42']}
@lru_cache(None)
def run(arm,k,seed,yaw):
 arm=arm.replace('_cyl','_cylindrical') if arm.endswith('_cyl') else arm
 return json.loads((r/'eval'/f'{arm}_k{k}_seed{seed}_{\"yaw\" if yaw else \"k0\"}'/'per_sample_yaw.json').read_text())
def matrix(arm,k,seeds,yaw,col,metric):
 return np.asarray([run(arm,k,s,yaw)['P'][str(col)][metric.lower()] for s in seeds])
queries=None;npoints=ncells=0
for name,d in products.items():
 yaw=name.startswith('YAW'); k=1 if name.endswith('K1') else 8; seeds=d['profile']['eval_seeds']
 for p in d['curves']:
  data=matrix(p['arm'],k,seeds,yaw,p['k'],p['metric']); assert data.shape==(len(seeds),6337) and np.isfinite(data).all()
  q=run(p['arm'],k,seeds[0],yaw)['query']; ix=run(p['arm'],k,seeds[0],yaw)['index']
  if queries is None:queries=q;indices=ix
  assert q==queries and ix==indices
  np.testing.assert_allclose(data.mean(axis=1),p['per_seed'],rtol=1e-12,atol=1e-13)
  np.testing.assert_allclose(data.mean(),p['mean'],rtol=1e-12,atol=1e-13)
  if len(seeds)>1:np.testing.assert_allclose(data.mean(axis=1).std(ddof=1),p['sd'],rtol=1e-10,atol=1e-13)
  assert p['cohort']['n_queries']==6337 and p['cohort']['n_rooms']==17;npoints+=1
 for c in d['cells']:
  if yaw:
   a=matrix(c['arm'],k,seeds,True,c['k'],c['metric']);b=matrix(c['arm'],k,seeds,True,0,c['metric'])
  else:
   a=matrix(c['pairing'][0],k,seeds,False,0,c['metric']);b=matrix(c['pairing'][1],k,seeds,False,0,c['metric'])
  np.testing.assert_allclose((a.mean()-b.mean())/b.mean(),c['estimate'],rtol=1e-11,atol=1e-13)
  assert c['paired_cohort']['n_queries']==6337 and c['paired_cohort']['n_rooms']==17
  if not yaw:
   assert c['superior']==(c['companion_interval'][1]<0)
   for gate in c['convergence'].values():
    width=gate['seed_a']['hi']-gate['seed_a']['lo']; movement=max(abs(gate['seed_a'][bound]-gate['seed_b'][bound]) for bound in ['lo','hi'])
    assert gate['passed'] and movement/width<=0.1
    np.testing.assert_allclose(movement/width,gate['ratio'])
   if name.startswith('TARGETS'):
    np.testing.assert_allclose(b.mean(),c['target'])
    assert c['equivalent']==(-.03<c['tost_interval'][0] and c['tost_interval'][1]<.03)
    assert c['reaches_target']==(c['superior'] or c['equivalent'])
  ncells+=1
 if name.startswith('CURVE'):
  for metric,verdict in d['verdicts'].items():
   flags=[c['superior'] for c in d['cells'] if c['metric']==metric]
   assert verdict==('partial' if any(flags) and not all(flags) else 'not supported' if not any(flags) else 'dominance')
 if name.startswith('TARGETS'):
  for ratio in d['parameter_ratios']:
   assert all(c['reaches_target'] for c in d['cells'] if c['pairing']==ratio['pairing'])
   np.testing.assert_allclose(ratio['ratio'],ratio['numerator']/ratio['denominator'])
   np.testing.assert_allclose(ratio['reduction_factor'],ratio['denominator']/ratio['numerator'])
print('RECOMPUTED:',npoints,'curve means/SDs;',ncells,'effects/cohorts; all 66 query/index orders; decision flags and convergence calculations PASS')
