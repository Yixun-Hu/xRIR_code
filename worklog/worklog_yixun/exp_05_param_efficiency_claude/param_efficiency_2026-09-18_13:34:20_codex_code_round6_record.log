   128	    parts.append('<line class="axis" x1="{0}" x2="{0}" y1="{1}" y2="{2}"/>'.format(
   129	        LEFT - 15, TOP, BOTTOM))
   130	    for value in (low, high):
   131	        parts.append('<text x="5" y="{}">{}</text>'.format(y_of(value) + 4, esc(md.display(value))))
   132	    for index, (role, history) in enumerate(sorted(rows)):
