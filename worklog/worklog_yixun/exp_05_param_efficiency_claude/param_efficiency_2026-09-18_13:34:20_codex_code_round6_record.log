   155	def probe_linkage(records, receipts):
   156	    """Every COMPLETED probe is named by exactly one receipt, at the bytes it recorded.
   157	
   158	    The launcher writes a receipt only after the probe attempt returns, so a probe whose
   159	    child failed has abort evidence and no receipt at all; demanding one would make the
   160	    arm's real failure history unpublishable.  That attempt is bound through
   161	    :func:`terminal_state` instead, and every receipt that does exist must still name a
   162	    probe attempt of this arm, one each.
   163	    """
   164	    probes = {item['path'] for item in records if item['mode'] == 'probe'}
   165	    completed = {item['path'] for item in records
   166	                 if item['mode'] == 'probe' and item['state'] == 'certified'}
   167	    named = {}
   168	    for receipt in receipts:
   169	        bound = (json.loads(Path(receipt['path']).read_text()).get('probe_attempt') or {})
   170	        path = str(Path(bound.get('path', 'absent')).resolve())
   171	        require(path in probes,
   172	                'a probe receipt names an attempt this arm does not list: ' + receipt['path'])
   173	        require(path not in named, 'two probe receipts name one attempt: ' + path)
   174	        for part in ('train_manifest', 'completion'):
   175	            item = stamp(Path(path) / (part + '.json'))
   176	            require(bound.get(part + '_sha256') == item['sha256'],
   177	                    'probe receipt {} digest: {}'.format(part, receipt['path']))
   178	        named[path] = receipt['path']
   179	    missing = sorted(completed - set(named))
   180	    require(not missing, 'a probe attempt has no receipt: ' + ', '.join(missing))
   181	    return named
