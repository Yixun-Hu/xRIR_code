    71	def external_log(reference, digest=None, mandatory=False):
    72	    """Bind a log an attempt's own records point at, wherever the launcher put it.
    73	
    74	    The launcher deliberately keeps logs OUTSIDE the attempt directory, so hashing the
    75	    directory does not cover them; the path comes from the attempt's own completion or
    76	    abort receipt.  A CERTIFIED attempt's log is the evidence that it ran, so it must be
    77	    on disk at the digest that attempt recorded; only the two paths an abort receipt
    78	    names may be absent, because the abort itself renames one of them away.
    79	    """
    80	    path = Path(reference)
    81	    if mandatory:
    82	        require(path.is_file(),
    83	                'a certified attempt names a log that is not on disk: ' + str(path))
    84	    elif not path.is_file():
    85	        return dict(path=str(path), present=False)
    86	    return dict(stamp(path, digest) if digest else stamp(path), present=True)
