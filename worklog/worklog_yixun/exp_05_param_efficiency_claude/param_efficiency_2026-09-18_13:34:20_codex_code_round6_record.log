   144	    for epoch in range(first, last + 1):
   145	        parts.append('<text x="{}" y="272" text-anchor="middle">{}</text>'.format(x_of(epoch), epoch))
   146	    caption = 'Test loss per epoch, read from each attempt\'s bound history.jsonl.'
