   449	def collect(runs, attempt, results, rendered, figures=(), approved=None, head=None):
   450	    pins, identity = load_approved_digests(approved)
   451	    require(pins['schema_version'] == 1, 'approval pins are not final')
   452	    approval = dict(identity, blob=json.loads(Path(identity['path']).read_text()))
   453	    require(stamp(identity['path'])['sha256'] == identity['sha256'], 'approval digest mismatch')
   454	    attempts = sorted((attempt_record(item, pins) for item in attempt),
   455	                      key=lambda item: item['role'])
   456	    require(sorted(item['role'] for item in attempts) == sorted(pins['checkpoints'])
   457	            and sorted(item['role'] for item in attempts) == list(TRAINED),
   458	            'every trained arm must be bound exactly once')
   459	    require(len({item['training_closure'] for item in attempts}) == 1,
   460	            'the four arms do not share one training closure')
   461	    historical = historical_checkpoints()
   462	    paths = sorted(str(Path(item).resolve()) for item in runs)
   463	    require(len(paths) == len(set(paths)) and len(paths) == len(IDENTITIES),
   464	            'the sixty-six evaluation runs')
   465	    records = [run_record(item, attempts, historical) for item in paths]
   466	    run_bound = {item['path']: item.pop('bound') for item in records}
   467	    require({(item['role'], item['num_shot'], item['seed'], item['kind'])
   468	             for item in records} == IDENTITIES,
   469	            'the sixty-six evaluation runs are the registered arm/K/seed set')
   470	    head = head or binder.subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT,
   471	                                                  text=True).strip()
   472	    require(binder.subprocess.run(['git', 'cat-file', '-e', head + '^{commit}'], cwd=ROOT,
   473	                                  stdout=binder.subprocess.PIPE,
   474	                                  stderr=binder.subprocess.PIPE).returncode == 0,
   475	            'invalid binding HEAD')
   476	    published = bind_results(results, head, approval, records, attempts, run_bound)
   477	    cited = ([item['sha256'] for item in published]
   478	             + [item['completion']['sha256'] for item in attempts])
   479	    documents = []
   480	    for path in sorted(str(Path(item).resolve()) for item in rendered):
   481	        text = Path(path).read_text(errors='replace')
   482	        require(all(digest in text for digest in cited),
   483	                'a rendered document does not cite every canonical digest: ' + path)
   484	        documents.append(stamp(path))
   485	    require(documents, 'no rendered documents')
   486	    return dict(schema_version=1, git_HEAD=head, results=published, runs=records,
   487	                attempts=attempts, historical_checkpoints=historical, documents=documents,
   488	                figures=[stamp(item) for item in sorted(str(Path(name).resolve())
   489	                                                        for name in figures)],
   490	                approved_digests=approval,
   491	                inputs=dict(runs=paths, attempt=[item['path'] for item in attempts],
   492	                            results=sorted(str(Path(item).resolve()) for item in results),
   493	                            rendered=sorted(str(Path(item).resolve()) for item in rendered),
   494	                            figures=sorted(str(Path(item).resolve()) for item in figures),
   495	                            approved=identity['path']))
   496	
