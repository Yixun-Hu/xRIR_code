    44	def scales(curves):
    45	    """One shared frame per panel: log parameters across, metric units up."""
    46	    xs = [math.log10(item['x']) for items in curves.values() for item in items]
    47	    values = [value for items in curves.values() for item in items
    48	              for value in item['interval'] + [item['mean'] - item['sd'], item['mean'] + item['sd']]]
    49	    low, high = min(xs), max(xs)
    50	    bottom, top = min(values), max(values)
