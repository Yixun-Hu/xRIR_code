    89	def setup_failure(directory, record_, logs):
    90	    """The one documented abort with no log to hash, in the exact shape that produces it.
    91	
    92	    ``execute_attempt`` raises before the child is spawned: ``reason`` is still its
    93	    initial ``setup_failed``, ``guard`` is None so ``abort_log`` renames nothing and
    94	    ``log.aborted`` is null, ``abort_attempt`` names the directory after that reason, no
    95	    ``execution.json`` was ever written and neither named log is on disk.  A logless
    96	    abort that is not all of that is an abort with its evidence removed.
    97	    """
    98	    log = record_.get('log') or {}
    99	    return (record_.get('reason') == 'setup_failed'
   100	            and SETUP_FAILURE.match(directory.name) is not None
   101	            and sorted(log) == ['aborted', 'original'] and log['aborted'] is None
   102	            and isinstance(log['original'], str) and bool(log['original'])
   103	            and not (directory / 'execution.json').is_file()
   104	            and not any(item['present'] for item in logs))
