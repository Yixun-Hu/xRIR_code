   438	                            producer_commit=side['producer']['commit'],
   439	                            producer_closure_sha256=side['producer']['sha256'],
   440	                            profile_digest=receipt['profile_digest'],
   441	                            sidecar=stamp(path + '.provenance.json'),
   442	                            outputs=[stamp(item, digest)
   443	                                     for item, digest in sorted(side['outputs'].items())]))
   444	    require(sorted(item['profile'] for item in records) == sorted(record.KEYS),
   445	            'the five registered products, one each')
