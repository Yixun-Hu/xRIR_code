   107	def terminal_state(directory, row):
   108	    """A ledger-listed attempt ended certified or aborted; bind that state's evidence."""
   109	    completion, abort = directory / 'completion.json', directory / 'abort.json'
   110	    if completion.is_file():  # a recovered attempt keeps its abort.json as well
   111	        recorded = json.loads(completion.read_text()).get('log') or {}
   112	        require(recorded.get('path') and recorded.get('sha256'),
   113	                'a certified attempt records no log at a digest: ' + row['attempt'])
   114	        return dict(state='certified', setup_failure=False,
   115	                    logs=[external_log(recorded['path'], recorded['sha256'], mandatory=True)])
   116	    require(abort.is_file(),
   117	            'the attempt has no terminal state (completion.json or abort.json): '
   118	            + row['attempt'])
   119	    recorded = json.loads(abort.read_text())
   120	    reason = recorded.get('reason')
   121	    require(isinstance(reason, str) and reason,
   122	            'an aborted attempt records no reason: ' + row['attempt'])
   123	    log = recorded.get('log') or {}
   124	    logs = [external_log(log[key]) for key in ('original', 'aborted') if log.get(key)]
   125	    failure = setup_failure(directory, recorded, logs)
   126	    require(failure or any(item['present'] for item in logs),
   127	            'an aborted attempt must bind its log unless it is the documented setup '
   128	            'failure: ' + row['attempt'])
   129	    return dict(state='aborted', setup_failure=failure, reason=reason, logs=logs)
