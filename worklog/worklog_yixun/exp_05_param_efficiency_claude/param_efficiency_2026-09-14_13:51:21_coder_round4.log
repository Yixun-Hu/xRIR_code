+@pytest.mark.parametrize('fault', ['slow', 'ceiling', 'reuse', 'historical'])
+def test_ledger_refusal_creates_no_attempt(receipt, tmp_path, monkeypatch, fault):
+    path, data = receipt
+    root = launch.arm_root('S', 'simple')
