def test_decomposition_is_pinned_to_the_preregistered_probe():
    good = {"k": 32, "n_batches": 1, "tokens_rel_change": 1e-7, "pooled_rel_change": 0.01, "coord_rel_change": 0.7, "logspec_rel_change": 0.003}
