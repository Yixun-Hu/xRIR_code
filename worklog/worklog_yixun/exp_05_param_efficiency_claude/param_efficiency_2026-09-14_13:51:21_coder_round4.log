    assert len(set(roots)) == 4 and roots[0] == tmp_path / 'ckpt/exp05/S_simple'
    launch.account_hours(launch.create_attempt(roots[0], 'attempt_test'), 2)
    assert [launch.full_hours(root) for root in roots] == [2, 0, 0, 0]


