    runtime[key] = value
    with pytest.raises(ValueError, match=key):
        launch.compare_control(runtime, *control(runtime))


def test_arm_ledger_isolation(tmp_path, monkeypatch):
    monkeypatch.setattr(launch, 'REPO', tmp_path)
