+    with pytest.raises((ValueError, RuntimeError), match='tier|size mismatch'):
+        subject.load_tier(checkpoint, 8)
+
+
+@pytest.mark.parametrize('tier', ['S', 'M', 'L'])
+def test_legacy_only_m(checkpoint, tier):
