    assert not attempt.exists()
    record = json.loads((tmp_path / 'cumulative_hours.json').read_text())
    assert record['total_hours'] == 2.5 and record['attempts'][0]['hours'] == 2.5
    launch.check_budget(tmp_path, 40.5)
