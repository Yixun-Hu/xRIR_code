   381	def _republish(path, data=None, side=None):
   382	    """Rewrite a product and its sidecar so only the intended change differs."""
   383	    path = Path(path)
   384	    if data is not None:
   385	        path.write_bytes((json.dumps(data, sort_keys=True, indent=2, allow_nan=False) + '\n').encode())
   386	    sidecar = Path(str(path) + '.provenance.json')
   387	    side = json.loads(sidecar.read_text()) if side is None else side
   388	    side['outputs'][str(path.resolve())] = record.sha(path.read_bytes())
   389	    sidecar.write_text(json.dumps(side, sort_keys=True, indent=2) + '\n')
