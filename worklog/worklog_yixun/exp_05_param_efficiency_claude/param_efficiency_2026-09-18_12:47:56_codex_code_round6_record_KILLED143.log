    23	def load_curve(path):
    24	    """Admit one canonical product and refuse anything but a registered curve family."""
    25	    name = json.loads(Path(path).read_bytes()).get('profile_name')
    26	    record.refuse(name in page.CURVES, 'not a registered curve family: ' + str(path))
    27	    data, receipt = record.load(path, name)
