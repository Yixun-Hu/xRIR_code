   420	        # the bound digest, and nothing else -- not even another artefact of this report.
   421	        dependencies = product_dependencies(expected, roles, trained, run_bound, approval)
   422	        dependencies.update(producer_declarations(side['producer']))
   423	        for item, digest in sorted(side['inputs'].items()):
