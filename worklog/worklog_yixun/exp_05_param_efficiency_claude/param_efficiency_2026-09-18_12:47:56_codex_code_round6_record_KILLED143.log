   269	def arguments(argv=None):
   270	    parser = argparse.ArgumentParser(description=__doc__)
   271	    for flag, name in INPUTS:
   272	        parser.add_argument(flag, required=True, help='canonical ' + name + '.json')
   273	    parser.add_argument('--attempt', nargs='+', required=True,
   274	                        help='the four certified exp_05 training attempts')
   275	    parser.add_argument('--out', required=True)
   276	    args = parser.parse_args(argv)
   277	    sources = [getattr(args, flag[2:].replace('-', '_')) for flag, _ in INPUTS]
   278	    if len({Path(item).resolve() for item in sources}) != len(sources):
   279	        raise ValueError('duplicate canonical input')
   280	    products, receipts = {}, []
   281	    for path, (_, name) in zip(sources, INPUTS):
   282	        data, receipt = record.load(path, name)
   283	        record.validate(data, name)
   284	        products[name] = data
   285	        receipts.append(receipt)
   286	    attempts = [record.attempt_evidence(item) for item in sorted(set(args.attempt))]
   287	    roles = sorted(item['role'] for item in attempts)
   288	    if roles != sorted(TRAINED):
   289	        raise ValueError('every trained arm must be bound exactly once: ' + ', '.join(roles))
   290	    protected = {str(Path(item).resolve()) for item in sources}
   291	    protected |= {item + '.provenance.json' for item in protected}
   292	    protected |= {output for receipt in receipts for output in receipt['outputs']}
   293	    protected |= {str(Path(receipt['approved_digests']['path']).resolve()) for receipt in receipts}
   294	    for item in attempts:
   295	        protected |= {item['completion']['path'], item['probe']['path']}
   296	    if str(Path(args.out).resolve()) in protected or same_file(args.out, protected):
   297	        raise ValueError('output overlaps canonical input')
   298	    head = subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=REPO, text=True).strip()
   299	    return args, dict(products=products, receipts=receipts, attempts=attempts), head
