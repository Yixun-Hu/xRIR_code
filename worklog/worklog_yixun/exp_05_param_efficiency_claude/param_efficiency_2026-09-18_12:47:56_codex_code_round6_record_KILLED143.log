   354	def product_dependencies(expected, roles, trained, run_bound, approval):
   355	    """EXACTLY the inputs of a product built over exactly these runs.
   356	
   357	    Everything each of those runs declares for itself -- its manifest, completion, both
   358	    outputs, log, checkpoint, reference manifest, data inventory, evaluator and writer
   359	    closures and mutable bindings -- plus the training evidence every trained arm it used
   360	    makes it consume, and the approval blob.  Nothing else: neither an artefact of a run
   361	    this product did not use nor a file of an arm it did use that no contract reads.  This
   362	    map is working evidence, not report content: one run declares its whole data
   363	    inventory, so it is never serialized.
   364	    """
   365	    dependencies = {approval['path']: approval['sha256']}
   366	    for path in sorted(expected):
   367	        dependencies.update(run_bound[path])
   368	    for role in sorted(roles & set(trained)):
   369	        for item in training_dependencies(trained[role]).values():
   370	            dependencies[item['path']] = item['sha256']
   371	    return dependencies
