    43	                          capsize=4, elinewidth=1, linewidth=1.4, label=backbone + ' (interval)')
    44	            axis.errorbar(x, y, yerr=[item['sd'] for item in items], color=style['colour'],
    45	                          linestyle='none', elinewidth=4, capsize=0, alpha=.55,
    46	                          label=backbone + ' (seed SD)')
    47	            for item in items:
