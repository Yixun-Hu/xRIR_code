   114	def trajectories(attempts):
   115	    """The per-epoch test loss of the four exp_05 trainings, from their bound history."""
   116	    title = 'Per-epoch test loss (four exp_05 trainings)'
   117	    rows = [(item['role'], [(row['epoch'], row['test_loss']) for row in item['history']])
   118	            for item in attempts]
   119	    values = [value for _, history in rows for _, value in history]
   120	    epochs = [epoch for _, history in rows for epoch, _ in history]
   121	    low, high, first, last = min(values), max(values), min(epochs), max(epochs)
   122	    def x_of(epoch):
   123	        return LEFT + (RIGHT - LEFT) * (epoch - first) / float(last - first or 1)
   124	    def y_of(value):
   125	        return BOTTOM - (BOTTOM - TOP) * (value - low) / ((high - low) or 1.)
   126	    parts = ['<figure><svg viewBox="0 0 850 300" role="img" aria-label="{}"><title>{}</title>'
   127	             .format(esc(title), esc(title))]
   128	    parts.append('<line class="axis" x1="{0}" x2="{0}" y1="{1}" y2="{2}"/>'.format(
   129	        LEFT - 15, TOP, BOTTOM))
   130	    for value in (low, high):
   131	        parts.append('<text x="5" y="{}">{}</text>'.format(y_of(value) + 4, esc(md.display(value))))
   132	    for index, (role, history) in enumerate(sorted(rows)):
   133	        colour = COLOUR[ROLES[role]['backbone']]
   134	        dash = ' stroke-dasharray="6 3"' if ROLES[role]['tier'] == 'L' else ''
   135	        points = ' '.join('{},{}'.format(x_of(epoch), y_of(value)) for epoch, value in history)
   136	        parts.append('<polyline fill="none" stroke="{}"{} points="{}"/>'.format(colour, dash, points))
   137	        for epoch, value in history:
   138	            parts.append('<g tabindex="0" class="mark" fill="{}" stroke="none"><title>{}</title>'
   139	                         '<circle cx="{}" cy="{}" r="3"/></g>'.format(
   140	                             colour, esc('{} epoch {}: {}'.format(role, epoch, md.display(value))),
   141	                             x_of(epoch), y_of(value)))
   142	        parts.append('<text x="{}" y="{}" fill="{}">{}</text>'.format(
   143	            RIGHT - 120, TOP + 14 * index, colour, esc(role)))
   144	    for epoch in range(first, last + 1):
   145	        parts.append('<text x="{}" y="272" text-anchor="middle">{}</text>'.format(x_of(epoch), epoch))
   146	    caption = 'Test loss per epoch, read from each attempt\'s bound history.jsonl.'
   147	    return ''.join(parts) + '</svg><figcaption>' + esc(caption) + '</figcaption></figure>'
