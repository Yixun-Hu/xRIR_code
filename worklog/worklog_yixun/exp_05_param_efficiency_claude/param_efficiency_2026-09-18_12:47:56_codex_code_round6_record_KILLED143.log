   308	        lines += ['## ' + title, '', '| ' + ' | '.join(headers) + ' |',
   309	                  '| ' + ' | '.join('---' for _ in headers) + ' |']
   310	        lines += ['| ' + ' | '.join(html.escape(display(value)).replace('|', '&#124;')
   311	                                    for value in row) + ' |' for row in rows]
   312	        lines.append('')
   313	    Path(args.out).write_text('\n'.join(lines), encoding='utf-8')
