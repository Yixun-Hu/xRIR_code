   480	@pytest.mark.parametrize('forgery,message', [
   481	    ('omit_run', 'the sixty-six evaluation runs'),
   482	    ('extra_run', 'the sixty-six evaluation runs'),
   483	    ('substituted_digest', 'digest mismatch'),
   484	    ('unknown_dependency', 'this report does not bind'),
   485	    ('omitted_dependency', 'omits a required input'),
   486	    ('run_flag_subset', 'does not declare exactly its runs'),
   487	    ('contract_subset', 'does not record exactly its run contracts'),
   488	    ('foreign_contract', 'the contract is not this run'),
   489	    ('edited_attempt_log', 'digest mismatch'),
   490	    ('edited_probe_receipt', 'manifest input mismatch'),
   491	    ('foreign_probe_receipt', 'does not list'),
   492	    ('stale_approval', 'approval digest mismatch'),
   493	    ('unpinned_checkpoint', 'approved checkpoint'),
   494	    ('relaxed_profile', 'not computed under the registered profile'),
   495	    ('exploratory_product', 'exploratory JSON refused'),
   496	    ('unconverged_cell', 'did not converge'),
   497	    ('uncited_document', 'does not cite every canonical digest'),
   498	    ('two_retries', 'more than one retry'),
   499	    ('missing_training_linkage', 'training linkage'),
   500	])
   501	def test_the_binder_refuses_a_forged_record(bound, forgery, message):
   502	    f, arguments = bound.f, dict(bound.arguments)
   503	    product = f.results / 'CURVE_K8.json'
   504	    if forgery == 'omit_run':
   505	        arguments['runs'] = arguments['runs'][1:]
   506	    elif forgery == 'extra_run':
   507	        arguments['runs'] = arguments['runs'] + [arguments['runs'][0] + '/.']
   508	    elif forgery == 'substituted_digest':
   509	        run = Path(arguments['runs'][0]) / 'per_sample_yaw.json'
   510	        run.write_bytes(run.read_bytes() + b' ')
   511	    elif forgery in ('unknown_dependency', 'omitted_dependency'):
   512	        data = json.loads(product.read_text())
   513	        planted = str(f.root / 'planted.json')
   514	        Path(planted).write_text('{}\n')
   515	        if forgery == 'unknown_dependency':
   516	            data['inputs'][planted] = record.sha(Path(planted).read_bytes())
   517	        else:
   518	            data['inputs'].pop(sorted(data['inputs'])[-1])
   519	        side = json.loads(Path(str(product) + '.provenance.json').read_text())
   520	        side['inputs'] = data['inputs']
   521	        _republish(product, data, side)
   522	    elif forgery in ('run_flag_subset', 'contract_subset', 'foreign_contract'):
   523	        data = json.loads(product.read_text())
   524	        dropped = sorted(data['run_flags'])[0]
   525	        if forgery == 'run_flag_subset':
   526	            data['run_flags'].pop(dropped)
   527	            side = json.loads(Path(str(product) + '.provenance.json').read_text())
   528	            side['run_flags'] = data['run_flags']
   529	            _republish(product, data, side)
   530	        elif forgery == 'contract_subset':
   531	            data['compatibility'].pop(dropped)
   532	            _republish(product, data)
   533	        else:
   534	            data['compatibility'][dropped]['sha256'] = 'a' * 64
   535	            _republish(product, data)
   536	    elif forgery == 'edited_attempt_log':
   537	        completion = f.read(Path(f.attempts['S_simple']) / 'completion.json')
   538	        log = Path(completion['log']['path'])
   539	        log.write_text(log.read_text() + 'appended\n')
   540	    elif forgery == 'edited_probe_receipt':
   541	        receipt = f.read(f.receipts['S_cyl'])
   542	        receipt['probe_attempt']['completion_sha256'] = 'b' * 64
   543	        f.replace(f.receipts['S_cyl'], receipt)
   544	    elif forgery == 'foreign_probe_receipt':
   545	        receipt = f.read(f.receipts['S_cyl'])
   546	        receipt['probe_attempt']['path'] = str(Path(f.attempts['L_cyl']).parent / '_probe_x_arm')
   547	        f.replace(Path(f.receipts['S_cyl']).with_name('_probe_x_S_cyl.json'), receipt)
   548	    elif forgery == 'stale_approval':
   549	        path = Path(f.approval['path'])
   550	        path.write_text(path.read_text() + '\n')
   551	    elif forgery == 'unpinned_checkpoint':
   552	        f.pins['checkpoints']['S_simple'] = dict(f.pins['checkpoints']['S_simple'], epoch=11)
