   270	def _eval_run(root, role, arm, shot, seed, kind, grid, queries, commit, references, bindings,
   271	              tier, closures, frozen, identity, data_root):
   272	    """One evaluation run directory, exactly as tools/exp05_eval.py's launcher writes it."""
   273	    directory = root / 'eval' / '{}_k{}_seed{}_{}'.format(role, shot, seed, kind)
   274	    directory.mkdir(parents=True)
   275	    reference_path, reference = references[(shot, seed)]
   276	    fields = dict(schema_version=1, repo=str(root), reviewed_commit=commit,
   277	        checkpoint=arm['checkpoint'], checkpoint_sha256=arm['sha256'],
   278	        manifest_path=str(reference_path), manifest_file_sha256=p.sha256_file(reference_path),
   279	        manifest_hash=manifest_hash(reference), manifest_seed=seed, gl_seed=seed, num_shot=shot,
   280	        backbone=arm['backbone'], batch_size=16, batch_canonical=True, max_samples=0, tf32=False,
   281	        conditions='P', yaw_cols=list(grid), acoustic_cols=list(grid), e_acoustic_cols=[],
   282	        decomposition_batches=0, n_samples=len(queries), split_count=len(queries), split='unseen',
   283	        no_tta=True, data_root=str(data_root), mutable_inputs=bindings, confirmatory=True,
   284	        allow_dirty_used=False, evaluator_closure=frozen, source_closures=dict(closures),
   285	        data_identity=dict(identity, manifest_path=str(reference_path),
   286	                           manifest_hash=manifest_hash(reference),
   287	                           manifest_file_sha256=p.sha256_file(reference_path)), **tier)
   288	    digest = p.write_manifest(directory / 'eval_manifest.json', fields)
   289	    meta = {key: fields[key] for key in (
   290	        'backbone', 'checkpoint', 'manifest_hash', 'gl_seed', 'batch_size', 'max_samples', 'tf32',
   291	        'manifest_path', 'manifest_seed', 'yaw_cols', 'acoustic_cols', 'e_acoustic_cols',
   292	        'batch_canonical', 'n_samples', 'conditions', 'reviewed_commit')}
   293	    meta.update(eval_manifest_sha256=digest, evaluator_closure_sha256=frozen['sha256'],
   294	                elapsed_min=.1, **tier)
   295	    cells = {str(angle): {metric: _values(role, seed, angle, len(queries)) for metric in METRICS}
   296	             for angle in grid}
   297	    sample = dict(meta=meta, query=queries, index=list(range(len(queries))), P=cells,
   298	                  delay_flips={str(angle): 0 for angle in grid}, decomposition=None)
   299	    p.write_manifest(directory / 'per_sample_yaw.json', sample)
   300	    p.write_manifest(directory / 'metrics_yaw.json', dict(meta=meta, P=_summaries(cells),
   301	                     delay_flips=sample['delay_flips'], decomposition=None))
   302	    log = root / 'logs' / '{}_k{}_seed{}_{}.log'.format(role, shot, seed, kind)
   303	    log.parent.mkdir(exist_ok=True)
   304	    log.write_text('synthetic evaluation completed\n')
   305	    p.write_completion(directory / 'completion.json', dict(schema_version=1, confirmatory=True,
   306	        allow_dirty_used=False, eval_manifest_sha256=digest, child_exit_status=0,
   307	        directory_listing=['eval_manifest.json', 'metrics_yaw.json', 'per_sample_yaw.json'],
   308	        log=dict(path=str(log), sha256=p.sha256_file(log)),
   309	        outputs={name: p.sha256_file(directory / name)
   310	                 for name in ('per_sample_yaw.json', 'metrics_yaw.json')}, **tier))
   311	    return directory

