    21	def _rewrite(path, data):
    22	    """Republish a canonical JSON and the sidecar digest that binds it."""
    23	    path = Path(path)
    24	    payload = (json.dumps(data, sort_keys=True, indent=2, allow_nan=False) + '\n').encode()
    25	    path.write_bytes(payload)
    26	    sidecar = Path(str(path) + '.provenance.json')
    27	    side = json.loads(sidecar.read_text())
    28	    side['outputs'][str(path.resolve())] = record.sha(payload)
    29	    sidecar.write_text(json.dumps(side, sort_keys=True, indent=2) + '\n')
    30	    return side
