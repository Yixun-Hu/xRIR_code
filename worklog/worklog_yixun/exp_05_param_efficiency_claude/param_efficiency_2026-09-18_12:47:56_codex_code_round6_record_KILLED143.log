   321	def training_dependencies(attempt):
   322	    """Exactly the training evidence a product that used this arm consumes.
   323	
   324	    ``tools.param_curve.run_contract`` reads the bound args.json, train_manifest.json and
   325	    completion.json of a trained arm and nothing else of it; the arm's remaining files
   326	    (the eleven unused epoch checkpoints, best/last, history.jsonl, the inventory sidecar,
   327	    the hours ledger, the probe receipt and every other attempt) are bound in this
   328	    report's attempt history and are inputs of nothing.
   329	    """
   330	    outputs = dict(attempt['outputs'])
   331	    missing = [name for name in TRAINING_DEPENDENCIES if not outputs.get(name)]
   332	    require(not missing, 'the attempt has no ' + ', '.join(missing) + ': ' + attempt['role'])
   333	    items = {name: outputs[name] for name in TRAINING_DEPENDENCIES}
   334	    items['completion.json'] = attempt['completion']
   335	    return items
