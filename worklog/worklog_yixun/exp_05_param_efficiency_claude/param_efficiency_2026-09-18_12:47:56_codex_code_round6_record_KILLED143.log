   150	def main(argv=None):
   151	    args, data, head = md.arguments(argv)
   152	    identity = ('generated by make_results_html.py from ' +
   153	                ', '.join(receipt['sha256'] for receipt in data['receipts']) + ' at ' + head)
   154	    parts = ['<!doctype html><html lang="en"><meta charset="utf-8">'
   155	             '<meta name="viewport" content="width=device-width, initial-scale=1">',
   156	             '<title>' + esc(TITLE) + '</title><style>' + CSS + '</style><body><main>',
   157	             '<p class="identity">' + esc(identity) + '</p>',
   158	             '<h1>' + esc(TITLE) + '</h1>',
   159	             '<p>' + esc(md.ROUNDING) + '</p>', '<p>' + esc(md.SCOPE) + '</p>']
