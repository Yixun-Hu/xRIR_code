   378	    trained = {item['role']: item for item in attempts}
   379	    records = []
   380	    for path in sorted(str(Path(item).resolve()) for item in paths):
   381	        name = json.loads(Path(path).read_bytes()).get('profile_name')
   382	        require(name in record.KEYS, 'unregistered producer output: ' + path)
   383	        data, receipt = record.load(path, name)
   384	        record.validate(data, name)  # the same canonical validation the generators apply
   385	        require(receipt['profile_digest'] == REGISTERED[name],
   386	                'the product was not computed under the registered profile: ' + path)
   387	        side = json.loads(Path(path + '.provenance.json').read_text())
   388	        require(all(side['approved_digests'][key] == approval[key]
   389	                    for key in ('path', 'sha256', 'git_blob'))
   390	                and side['approved_digests']['pins'] == approval['blob'],
   391	                'result approval identity or pins')
   392	        require(side['producer']['sha256'] == approval['blob']['closures'][record.KEYS[name]],
   393	                'result producer closure is not the approved one: ' + path)
   394	        # The expected run set is derived from the bound identities, not from the product.
   395	        shot, kind = PRODUCT_RUNS[name]
   396	        expected = {run['path'] for run in runs
   397	                    if run['num_shot'] == shot and run['kind'] == kind}
   398	        require(len(expected) == (len(ROLES) if kind == 'yaw' else len(ROLES) * len(EVAL_SEEDS)),
   399	                'the registered run set of this product: ' + path)
   400	        require(set(side['run_flags']) == expected,
   401	                'the product does not declare exactly its runs: ' + path)
   402	        contracts = data.get('compatibility') or {}
   403	        require(set(contracts) == expected,
   404	                'the product does not record exactly its run contracts: ' + path)
   405	        for run_path in sorted(expected):  # and each contract is THIS run's contract
   406	            run, contract = by_path[run_path], contracts[run_path]
   407	            current = run['entrypoint'] == approval['blob']['closures']['evaluator']
   408	            evaluator, source = CONTRACTS[current]
   409	            require(contract.get('sha256') == run['entrypoint']
   410	                    and contract.get('evaluator') == evaluator
   411	                    and contract.get('tier_source') == source
   412	                    and (current or ROLES[run['role']]['tier'] == 'M'),
   413	                    'the contract is not this run: {} in {}'.format(run_path, path))
   414	        for run_path in sorted(expected):  # exact coverage: no subset of a used run's files
   415	            for item, digest in sorted(coverage[run_path].items()):
   416	                require(side['inputs'].get(item) == digest,
   417	                        'incomplete run coverage: {} in {}'.format(item, path))
