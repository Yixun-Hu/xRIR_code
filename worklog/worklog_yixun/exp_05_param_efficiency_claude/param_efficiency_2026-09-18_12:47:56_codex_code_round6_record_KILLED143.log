   106	def curve_figure(data, metric):
   107	    """One product and metric: the encoder panel and the full-system panel."""
   108	    caption = ('{} — {}: point = five-seed mean on the arm\'s own cohort, thick bar = seed SD, '
   109	               'thin bar = bootstrap interval; x is logarithmic.'.format(data['profile_name'], metric))
   110	    return ('<figure>' + ''.join(panel(data, metric, axis, label) for axis, label in AXES)
   111	            + '<figcaption>' + esc(caption) + '</figcaption></figure>')
   112	
