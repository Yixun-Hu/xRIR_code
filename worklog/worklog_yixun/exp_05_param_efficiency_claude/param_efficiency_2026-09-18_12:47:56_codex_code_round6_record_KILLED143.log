   249	def same_file(target, published):
   250	    """Filesystem identity: resolve() sees through symlinks but not hardlinks.
   251	
   252	    A destination that is a second name for an input's inode would be truncated open, so
   253	    an existing output is compared with every protected input by device and inode.
   254	    """
   255	    try:
   256	        identity = os.stat(str(target))
   257	    except OSError:
   258	        return False
   259	    for item in published:
   260	        try:
   261	            other = os.stat(item)
   262	        except OSError:
   263	            continue
   264	        if (other.st_dev, other.st_ino) == (identity.st_dev, identity.st_ino):
   265	            return True
   266	    return False
