   426	            require(dependencies[item] == digest,
   427	                    'input differs from the bound artefact: {} in {}'.format(item, path))
   428	        for role in sorted(roles & set(trained)):  # named, before the general omission
   429	            for dependency, item in sorted(training_dependencies(trained[role]).items()):
   430	                require(side['inputs'].get(item['path']) == item['sha256'],
   431	                        'missing training dependency: {} of {} in {}'.format(
   432	                            dependency, role, path))
   433	        for item, digest in sorted(dependencies.items()):
   434	            require(side['inputs'].get(item) == digest,
   435	                    'the product omits a required input: {} in {}'.format(item, path))
