   140	    records = []
   141	    for row in sorted(ledger['attempts'], key=lambda item: item['attempt']):
   142	        directory = (root / row['attempt']).resolve()
   143	        if directory == Path(certified).resolve():
   144	            continue
   145	        require(directory.is_dir(), 'the ledger names a missing attempt: ' + row['attempt'])
   146	        files = sorted(item for item in directory.rglob('*') if item.is_file())
   147	        require(files, 'a bound attempt holds no files: ' + row['attempt'])
   148	        records.append(dict(role=role, attempt=row['attempt'], mode=row['mode'],
   149	                            hours=row['hours'], path=str(directory),
   150	                            files=[stamp(item) for item in files],
   151	                            **terminal_state(directory, row)))
