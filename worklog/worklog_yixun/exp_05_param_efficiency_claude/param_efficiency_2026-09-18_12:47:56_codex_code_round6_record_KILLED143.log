   132	def other_attempts(certified, ledger, role):
   133	    """Bind every OTHER attempt the arm's ledger lists, file by file.
   134	
   135	    Section 3 requires the complete attempt history: each probe attempt, any aborted full
   136	    run with its abort.json, and the external logs all of them reference are bound here at
   137	    their current bytes, so a later change to any of them changes the report.
   138	    """
