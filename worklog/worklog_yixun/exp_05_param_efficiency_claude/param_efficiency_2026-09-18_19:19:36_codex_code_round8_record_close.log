    --json $R/CURVE_K1.json  --summary $R/CURVE_K1.txt
python tools/param_curve.py --profile TARGETS_K8 --runs ckpt/exp05/eval/*_k8_seed*_k0 \
    --json $R/TARGETS_K8.json --summary $R/TARGETS_K8.txt
