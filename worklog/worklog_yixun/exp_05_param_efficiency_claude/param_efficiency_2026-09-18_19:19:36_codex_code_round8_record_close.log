    data = json.loads(f.produce('CURVE_K8').read_text())
    data['cells'][0]['pairing'] = ['S_cyl', 'L_simple']
    with pytest.raises(ValueError, match='cell coverage'):
        record.validate(data, 'CURVE_K8')


