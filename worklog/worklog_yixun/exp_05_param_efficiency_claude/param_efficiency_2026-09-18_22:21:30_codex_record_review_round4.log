+FLAGS="--curve-k8 $R/CURVE_K8.json --curve-k1 $R/CURVE_K1.json --targets-k8 $R/TARGETS_K8.json --targets-k1 $R/TARGETS_K1.json --yaw-k8 $R/YAW_K8_SEED42.json"
+LOG=$W/param_efficiency_$(date +%Y%m%dT%H%M%S)_record_run.log
