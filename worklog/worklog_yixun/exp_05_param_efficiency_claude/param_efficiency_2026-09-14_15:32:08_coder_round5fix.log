"""Temporary CPU-suite guard: forbid signals and reap only exited children."""
import os
import subprocess

import pytest


_PATCHES = []


def _patch(owner, name, replacement):
    _PATCHES.append((owner, name, getattr(owner, name), replacement))
    setattr(owner, name, replacement)


def _forbid_signal(*args, **kwargs):
    pytest.fail("Round 5 CPU-only guard refused process signalling", pytrace=True)


def _reap_exited_only(*processes):
    """The evaluation launcher already waits for child and tee before cleanup."""
    for process in processes:
        if process is None:
            continue
        if process.poll() is None:
            pytest.fail("Round 5 guard refuses cleanup of a running child: {}".format(process.pid))
        process.wait()
        for name in ("stdin", "stdout", "stderr"):
            stream = getattr(process, name, None)
            if stream is not None and not stream.closed:
                stream.close()


def pytest_configure(config):
    if os.environ.get("CUDA_VISIBLE_DEVICES") != "":
        raise pytest.UsageError("Round 5 CPU suite requires CUDA_VISIBLE_DEVICES=''")
    # These baseline guards can still be replaced by an individual test's stubs.
    for owner, name in ((os, "kill"), (os, "killpg"),
                        (subprocess.Popen, "terminate"), (subprocess.Popen, "kill")):
        _patch(owner, name, _forbid_signal)
    from tools import provenance
    _patch(provenance, "reap_process_groups", _reap_exited_only)


def pytest_unconfigure(config):
    for owner, name, original, replacement in reversed(_PATCHES):
        if getattr(owner, name) is replacement:
            setattr(owner, name, original)
    _PATCHES.clear()
