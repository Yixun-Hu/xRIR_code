+++ b//tmp/exp05_round6_filled_approval.py
@@ -0,0 +1,25 @@
+"""Exercise template regressions with a committed, filled default approval."""
+import json
+
+import pytest
+
+
+@pytest.fixture(autouse=True)
+def filled_default_approval(tmp_path, monkeypatch, request):
+    from tools import exp05_profiles as profiles
+    from tests.test_exp04_profiles import approval_repo
+
+    root = tmp_path / 'simulated_fill'
+    root.mkdir()
+    value = dict(schema_version=1, closures=dict.fromkeys((
+        'evaluator', 'writer', 'training', 'producer_param_curve',
+        'evaluator_exp04'), 'a' * 64), checkpoints={
+            arm['role']: dict(path=arm['checkpoint'], epoch=12, sha256='b' * 64)
+            for arm in profiles.ARMS if arm['tier'] != 'M'})
+    value['closures']['training_launcher'] = ['a' * 64, 'b' * 64]
+    path = approval_repo(root, value)
+    pins, _ = profiles.load_approved_digests(path)
+    assert profiles.json_value(pins) == json.loads(path.read_text())
+    monkeypatch.setattr(profiles, 'APPROVED_DIGESTS_PATH', path)
+    if hasattr(request.module, 'APPROVED_DIGESTS_PATH'):
+        monkeypatch.setattr(request.module, 'APPROVED_DIGESTS_PATH', path)
