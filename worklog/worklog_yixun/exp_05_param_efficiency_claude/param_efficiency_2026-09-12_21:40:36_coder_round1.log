            'yaw_aug ENABLED W=512 seed=0 counter=(epoch-1)*74084+batch_idx'] + [
        'Train Epoch: 1 [{}/3]  loss 1.25 (stft 0.5, decay 0.75)'.format(i) for i in range(3)] + [
