+        launch.check_golden(launch.command('full', attempt, 'S'), 'full', attempt)
+
+
+def test_cli_checks_golden_before_creating_directories(tmp_path, monkeypatch):
+    monkeypatch.setattr(launch, 'REPO', tmp_path)
