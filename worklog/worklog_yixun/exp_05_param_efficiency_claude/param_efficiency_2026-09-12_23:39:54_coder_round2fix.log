+    run = Path(args.out_dir)
+    assert 'CERTIFIED ' + str(run) in result.stdout.splitlines()
+    assert (run / 'completion.json').is_file() and not (run / 'abort.json').exists()
+    assert not list(run.parent.glob('*_ABORTED_*'))
+
+
