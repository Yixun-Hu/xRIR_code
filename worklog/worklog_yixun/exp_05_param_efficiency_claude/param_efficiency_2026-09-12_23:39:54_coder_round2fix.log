+    monkeypatch.setattr(launch.tier_gates, 'validate_receipt', lambda *a: {})
+    def refuse(*args):
+        assert not list(tmp_path.iterdir())
+        raise ValueError('golden tier')
+    monkeypatch.setattr(launch, 'check_golden', refuse)
